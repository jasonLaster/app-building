  await page.goto(`/team/${engTeam.id}/issues`);\n    45→  await expect(page.getByTestId('team-issues-page')).toBeVisible({ timeout: 30000 });\n    46→  return { token: data.token, user: data.user, engTeam };\n    47→}\n    48→\n    49→test.describe('TeamIssuesRow', () => {\n    50→  test('Issue row displays all required fields including checkbox and team prefix', async ({ page, baseURL }) => {\n    51→    const { token, engTeam } = await loginAndNavigateToTeamIssues(page, baseURL!);\n    52→\n    53→    // Wait for issues to load\n    54→    await expect(page.getByTestId('team-issues-list')).toBeVisible({ timeout: 30000 });\n    55→\n    56→    // Get the ENG-1 issue (in_progress, high priority, assigned to Alice, Bug label)\n    57→    const issues = await getTeamIssues(baseURL!, token, engTeam.id);\n    58→    const eng1 = issues.find((i: { identifier: string }) => i.identifier === 'ENG-1');\n    59→\n    60→    // Verify issue row exists\n    61→    const row = page.getByTestId(`issue-row-${eng1.id}`);\n    62→    await expect(row).toBeVisible();\n    63→\n    64→    // Verify checkbox is present\n    65→    await expect(page.getByTestId(`issue-checkbox-${eng1.id}`)).toBeVisible();\n    66→\n    67→    // Verify priority icon is present\n    68→    await expect(page.getByTestId(`issue-priority-${eng1.id}`)).toBeVisible();\n    69→\n    70→    // Verify identifier with team prefix\n    71→    await expect(page.getByTestId(`issue-identifier-${eng1.id}`)).toHaveText('ENG-1');\n    72→\n    73→    // Verify title\n    74→    await expect(page.getByTestId(`issue-title-${eng1.id}`)).toContainText('Fix login session expiration bug');\n    75→\n    76→    // Verify status button is present\n    77→    await expect(page.getByTestId(`issue-status-btn-${eng1.id}`)).toBeVisible();\n    78→\n    79→    // Verify label badge (Bug label)\n    80→    await expect(page.getByTestId(`issue-labels-${eng1.id}`)).toBeVisible();\n    81→\n    82→    // Verify assignee avatar (Alice Johnson → AJ)\n    83→    await expect(page.getByTestId(`issue-assignee-${eng1.id}`)).toBeVisible();\n    84→    await expect(page.getByTestId(`issue-assignee-${eng1.id}`)).toContainText('AJ');\n    85→  });\n    86→\n    87→  test('Issue row title is clickable and navigates to issue detail', async ({ page, baseURL }) => {\n    88→    const { token, engTeam } = await loginAndNavigateToTeamIssues(page, baseURL!);\n    89→\n    90→    await expect(page.getByTestId('team-issues-list')).toBeVisible({ timeout: 30000 });\n    91→\n    92→    // Get ENG-1 issue ID\n    93→    const issues = await getTeamIssues(baseURL!, token, engTeam.id);\n    94→    const eng1 = issues.find((i: { identifier: string }) => i.identifier === 'ENG-1');\n    95→\n    96→    // Click the title\n    97→    await page.getByTestId(`issue-title-${eng1.id}`).click();\n    98→\n    99→    // Verify navigation to issue detail page\n   100→    await expect(page).toHaveURL(`/issue/${eng1.id}`, { timeout: 30000 });\n   101→  });\n   102→\n   103→  test('Issue row status icon is clickable to change status', async ({ page, baseURL }) => {\n   104→    const { token, engTeam } = await loginAndNavigateToTeamIssues(page, baseURL!);\n   105→\n   106→    await expect(page.getByTestId('team-issues-list')).toBeVisible({ timeout: 30000 });\n   107→\n   108→    // Find a todo issue (ENG-2)\n   109→    const issues = await getTeamIssues(baseURL!, token, engTeam.id);\n   110→    const eng2 = issues.find((i: { identifier: string }) => i.identifier === 'ENG-2');\n   111→\n   112→    // Click the status icon\n   113→    await page.getByTestId(`issue-status-btn-${eng2.id}`).click();\n   114→\n   115→    // Verify dropdown appears with all status options\n   116→    await expect(page.getByTestId(`issue-status-dropdown-${eng2.id}`)).toBeVisible();\n   117→    await expect(page.getByTestId('issue-status-option-backlog')).toBeVisible();\n   118→    await expect(page.getByTestId('issue-status-option-todo')).toBeVisible();\n   119→    await expect(page.getByTestId('issue-status-option-in_progress')).toBeVisible();\n   120→    await expect(page.getByTestId('issue-status-option-in_review')).toBeVisible();\n   121→    await expect(page.getByTestId('issue-status-option-done')).toBeVisible();\n   122→    await expect(page.getByTestId('issue-status-option-cancelled')).toBeVisible();\n   123→  });\n   124→\n   125→  test('Changing status via issue row status dropdown persists and moves issue between groups', async ({ page, baseURL }) => {\n   126→    const { token, engTeam } = await loginAndNavigateToTeamIssues(page, baseURL!);\n   127→\n   128→    await expect(page.getByTestId('team-issues-list')).toBeVisible({ timeout: 30000 });\n   129→\n   130→    // Find ENG-2 (currently todo)\n   131→    const issues = await getTeamIssues(baseURL!, token, engTeam.id);\n   132→    const eng2 = issues.find((i: { identifier: string }) => i.identifier === 'ENG-2');\n   133→\n   134→    // Verify initial todo group has 2 issues, in_progress has 2\n   135→    await expect(page.getByTestId('team-issue-group-header-todo')).toContainText('(2)');\n   136→    await expect(page.getByTestId('team-issue-group-header-in_progress')).toContainText('(2)');\n   137→\n   138→    // Click status icon on ENG-2\n   139→    await page.getByTestId(`issue-status-btn-${eng2.id}`).click();\n   140→    await expect(page.getByTestId(`issue-status-dropdown-${eng2.id}`)).toBeVisible();\n   141→\n   142→    // Select \"In Progress\"\n   143→    await page.getByTestId('issue-status-option-in_progress').click();\n   144→\n   145→    // Dropdown should close\n   146→    await expect(page.getByTestId(`issue-status-dropdown-${eng2.id}`)).toHaveCount(0);\n   147→\n   148→    // Verify group counts updated: todo should now have 1, in_progress should have 3\n   149→    await expect(page.getByTestId('team-issue-group-header-todo')).toContainText('(1)', { timeout: 30000 });\n   150→    await expect(page.getByTestId('team-issue-group-header-in_progress')).toContainText('(3)');"}]},"parent_tool_use_id":"toolu_01CSKR4mrzp6Gp1zQhuyMY2R","session_id":"7b212afb-79da-42cc-8433-9cf67c998ecd","uuid":"73576222-1397-44f0-bb2c-27cbe65978bd"}
