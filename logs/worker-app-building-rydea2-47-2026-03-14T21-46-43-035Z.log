  await sql`\n   158→    INSERT INTO project_milestones (project_id, name, target_date, completed)\n   159→    VALUES (${projectId}, 'Beta Launch', '2026-05-30', false)\n   160→  `;\n   161→\n   162→  // Create some notifications for Alice\n   163→  const firstEngIssueRows = await sql`SELECT id FROM issues WHERE team_id = ${engId} AND number = 2 LIMIT 1`;\n   164→  const notifIssueId = firstEngIssueRows[0]?.id;\n   165→\n   166→  if (notifIssueId) {\n   167→    await sql`\n   168→      INSERT INTO notifications (member_id, type, message, issue_id, read, archived, created_at)\n   169→      VALUES (${aliceId}, 'assignment', 'You were assigned to this issue', ${notifIssueId}, false, false, NOW() - INTERVAL '5 minutes')\n   170→    `;\n   171→    await sql`\n   172→      INSERT INTO notifications (member_id, type, message, issue_id, read, archived, created_at)\n   173→      VALUES (${aliceId}, 'update', 'Status changed to In Progress', ${notifIssueId}, false, false, NOW() - INTERVAL '1 hour')\n   174→    `;\n   175→    await sql`\n   176→      INSERT INTO notifications (member_id, type, message, issue_id, read, archived, created_at)\n   177→      VALUES (${aliceId}, 'mention', 'Carol mentioned you in a comment', ${notifIssueId}, true, false, NOW() - INTERVAL '1 day')\n   178→    `;\n   179→  }\n   180→\n   181→  console.log('Database seeded successfully');\n   182→}\n   183→\n   184→export async function resetDatabase(databaseUrl: string) {\n   185→  await truncateAndSeed(databaseUrl);\n   186→}\n   187→\n   188→// CLI\n   189→const url = process.argv[2];\n   190→if (url) {\n   191→  truncateAndSeed(url).then(() => {\n   192→    process.exit(0);\n   193→  }).catch((err) => {\n   194→    console.error('Seed failed:', err);\n   195→    process.exit(1);\n   196→  });\n   197→}\n   198→"}]},"parent_tool_use_id":"toolu_01CSKR4mrzp6Gp1zQhuyMY2R","session_id":"7b212afb-79da-42cc-8433-9cf67c998ecd","uuid":"c194857e-476e-4ad0-9fdd-b8434a4c16d9"}
