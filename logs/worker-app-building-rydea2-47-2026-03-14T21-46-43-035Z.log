[2026-03-14T21:44:33.955Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BJ6SRZBY6chZJPpx33hw9A","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test';\n     2→\n     3→// Helper to login via API and get token\n     4→async function loginViaApi(baseURL: string, email: string, password: string) {\n     5→  const response = await fetch(`${baseURL}/api/login`, {\n     6→    method: 'POST',\n     7→    headers: { 'Content-Type': 'application/json' },\n     8→    body: JSON.stringify({ email, password }),\n     9→  });\n    10→  return response.json();\n    11→}\n    12→\n    13→// Helper to get teams via API\n    14→async function getTeams(baseURL: string, token: string) {\n    15→  const response = await fetch(`${baseURL}/api/teams`, {\n    16→    headers: { Authorization: `Bearer ${token}` },\n    17→  });\n    18→  const data = await response.json();\n    19→  return data.teams;\n    20→}\n    21→\n    22→// Helper to login and navigate to team issues page\n    23→async function loginAndNavigateToTeamIssues(\n    24→  page: import('@playwright/test').Page,\n    25→  baseURL: string,\n    26→  email = 'alice@acme.com',\n    27→  password = 'password123'\n    28→) {\n    29→  const data = await loginViaApi(baseURL, email, password);\n    30→  const teams = await getTeams(baseURL, data.token);\n    31→  const engTeam = teams.find((t: { identifier: string }) => t.identifier === 'ENG');\n    32→\n    33→  await page.goto('/login');\n    34→  await page.evaluate((t) => localStorage.setItem('session_token', t), data.token);\n    35→  await page.goto(`/team/${engTeam.id}/issues`);\n    36→  await expect(page.getByTestId('team-issues-page')).toBeVisible({ timeout: 30000 });\n    37→  return { token: data.token, user: data.user, engTeam };\n    38→}\n    39→\n    40→test.describe('TeamIssuesList', () => {\n    41→  test('Team Issues page renders with header showing team name', async ({ page, baseURL }) => {\n    42→