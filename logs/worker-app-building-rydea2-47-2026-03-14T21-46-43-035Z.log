ng): string {\n    41→  return name.split(' ').map((n) => n[0]).join('').toUpperCase().slice(0, 2);\n    42→}\n    43→\n    44→interface TeamIssuesListProps {\n    45→  issues: TeamIssue[];\n    46→  loading: boolean;\n    47→}\n    48→\n    49→export default function TeamIssuesList({ issues, loading }: TeamIssuesListProps) {\n    50→  const dispatch = useDispatch<AppDispatch>();\n    51→  const { selectedIds, groupBy, sortBy, members } = useSelector((state: RootState) => state.teamIssues);\n    52→  const [collapsedGroups, setCollapsedGroups] = useState<Record<string, boolean>>({});\n    53→\n    54→  const groups: IssueGroup[] = useMemo(() => {\n    55→    const sorted = sortIssues(issues, sortBy);\n    56→\n    57→    if (groupBy === 'none') {\n    58→      return [{\n    59→        key: 'all',\n    60→        label: '',\n    61→        icon: null,\n    62→        issues: sorted,\n    63→      }];\n    64→    }\n    65→\n    66→    if (groupBy === 'status') {\n    67→      const result: IssueGroup[] = [];\n    68→      for (const status of STATUS_ORDER) {\n    69→        const cfg = STATUS_CONFIG[status];\n    70→        const groupIssues = sorted.filter((i) => i.status === status);\n    71→        if (groupIssues.length > 0) {\n    72→          result.push({\n    73→            key: status,\n    74→            label: cfg.label,\n    75→            icon: <StatusIcon status={status} color={cfg.color} />,\n    76→            issues: groupIssues,\n    77→          });\n    78→        }\n    79→      }\n    80→      return result;\n    81→    }\n    82→\n    83→    if (groupBy === 'priority') {\n    84→      const result: IssueGroup[] = [];\n    85→      for (const priority of PRIORITY_ORDER) {\n    86→        const cfg = PRIORITY_CONFIG[priority];\n    87→        const groupIssues = sorted.filter((i) => i.priority === priority);\n    88→        if (groupIssues.length > 0) {\n    89→          result.push({\n    90→            key: priority,\n    91→            label: