[2026-03-14T21:44:59.641Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SJQAwLWWNqSBMqdooDwuU6","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test';\n     2→\n     3→// Helper to login via API and get token\n     4→async function loginViaApi(baseURL: string, email: string, password: string) {\n     5→  const response = await fetch(`${baseURL}/api/login`, {\n     6→    method: 'POST',\n     7→    headers: { 'Content-Type': 'application/json' },\n     8→    body: JSON.stringify({ email, password }),\n     9→  });\n    10→  return response.json();\n    11→}\n    12→\n    13→// Helper to get teams via API\n    14→async function getTeams(baseURL: string, token: string) {\n    15→  const response = await fetch(`${baseURL}/api/teams`, {\n    16→    headers: { Authorization: `Bearer ${token}` },\n    17→  });\n    18→  const data = await response.json();\n    19→  return data.teams;\n    20→}\n    21→\n    22→// Helper to get team issues via API\n    23→async function getTeamIssues(baseURL: string, token: string, teamId: string) {\n    24→  const response = await fetch(`${baseURL}/api/team-issues?teamId=${teamId}`, {\n    25→    headers: { Authorization: `Bearer ${token}` },\n    26→  });\n    27→  const data = await response.json();\n    28→  return data.issues;\n    29→}\n    30→\n    31→// Helper to login and navigate to team issues page\n    32→async function loginAndNavigateToTeamIssues(\n    33→  page: import('@playwright/test').Page,\n    34→  baseURL: string,\n    35→  email = 'alice@acme.com',\n    36→  password = 'password123'\n    37→) {\n    38→  const data = await loginViaApi(baseURL, email, password);\n    39→  const teams = await getTeams(baseURL, data.token);\n    40→  const engTeam = teams.find((t: { identifier: string }) => t.identifier === 'ENG');\n    41→\n    42→  await page.goto('/login');\n    43→  await page.evaluate((t) => localStorage.setItem('session_token', t), data.token);\n    44→  await page.goto(`/team/${engTeam.id}/issues`);\n    45→  await expect(page.getByTestId('team-issues-page')).toBeVisible({ timeout: 30000 });\n    46→  return { token: data.token, user: data.user, engTeam };\n    47→}\n    48→\n    49→test.describe('TeamIssuesRow', () => {\n    50→  test('Issue row displays all required fields including checkbox and team prefix', async ({ page, baseURL }) => {\n    51→    const { token, engTeam } = await loginAndNavigateToTeamIssues(page, baseURL!);\n    52→\n    53→    // Wait for issues to load\n    54→    await expect(page.getByTestId('team-issues-list')).toBeVisible({ timeout: 30000 });\n    55→\n    56→    // Get the ENG-1 issue (in_progress, high priority, assigned to Alice, Bug label)\n    57→    const issues = await getTeamIssues(baseURL!, token, engTeam.id);\n    58→    const eng1 = issues.find((i: { identifier: string }) => i.identifier === 'ENG-1');\n    59→\n    60→    // Verify issue row exists\n    61→    const row = page.getByTestId(`issue-row-${eng1.id}`);\n    62→    await expect(row).toBeVisible();\n    63→\n    64→    // Verify checkbox is present\n    65→    await expect(page.getByTestId(`issue-checkbox-${eng1.id}`)).toBeVisible();\n    66→\n    67→    // Verify priority icon is present\n    68→    await expect(page.getByTestId(`issue-priority-${eng1.id}`)).toBeVisible();\n    69→\n    70→    // Verify identifier with team prefix\n    71→    await expect(page.getByTestId(`issue-identifier-${eng1.id}`)).toHaveText('ENG-1');\n    72→\n    73→    // Verify title\n    74→    await expect(page.getByTestId(`issue-title-${eng1.id}`)).toContainText('Fix login session expiration bug');\n    75→\n    76→    // Verify status button is present\n    77→    await expect(page.getByTestId(`issue-status-btn-${eng1.id}`)).toBeVisible();\n    78→\n    79→    // Verify label badge (Bug label)\n    80→    await expect(page.getByTestId(`issue-labels-${eng1.id}`)).toBeVisible();\n    81→\n    82→    // Verify assignee avatar (Alice Jo