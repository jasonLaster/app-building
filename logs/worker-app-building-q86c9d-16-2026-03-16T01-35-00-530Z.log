[2026-03-16T00:35:24.574Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MMYkByv3V2hQhUD8hm2cET","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test'\n     2→import { truncateAndSeed } from '../scripts/seed-db'\n     3→\n     4→test.beforeAll(async () => {\n     5→  const dbUrl = process.env.DATABASE_URL\n     6→  if (dbUrl) {\n     7→    await truncateAndSeed(dbUrl)\n     8→  }\n     9→})\n    10→\n    11→// b1111111: Loft, $150/night, $75 cleaning, 4 max guests, host: Sarah (a1111111)\n    12→const PROPERTY_LOFT = 'b1111111-1111-1111-1111-111111111111'\n    13→// b3333333: Cabin, $200/night, $50 cleaning, 6 max guests, host: Mike (a2222222)\n    14→const PROPERTY_CABIN = 'b3333333-3333-3333-3333-333333333333'\n    15→// Guest user: Emma Wilson (a3333333)\n    16→const GUEST_EMAIL = 'emma@example.com'\n    17→// Host user: Sarah Chen (a1111111) — owns b1111111\n    18→const HOST_EMAIL = 'sarah@example.com'\n    19→const EMMA_ID = 'a3333333-3333-3333-3333-333333333333'\n    20→\n    21→async function loginAs(page: import('@playwright/test').Page, email: string) {\n    22→  await page.goto('/login')\n    23→  await page.getByTestId('login-email-input').fill(email)\n    24→  await page.getByTestId('login-submit-button').click()\n    25→  await expect(page).toHaveURL('/', { timeout: 30000 })\n    26→}\n    27→\n    28→async function deleteAllBookings(page: import('@playwright/test').Page, guestId: string) {\n    29→  const res = await page.request.get(`/api/bookings?guest_id=${guestId}`)\n    30→  const bookings = await res.json()\n    31→  for (const booking of bookings) {\n    32→    await page.request.put(`/api/bookings/${booking.id}`, {\n    33→      data: { status: 'cancelled' },\n    34→    })\n    35→  }\n    36→}\n    37→\n    38→/**\n    39→ * Opens the custom calendar and selects a date by navigating to the correct month\n    40→ * and clicking the day button. Assumes calendar may or may not be open already.\n    41→ */\n    42→async function openCalendarIfNeeded(page: import('@playwright/test').Page) {\n    43→  const selectDatesHeading = page.getByText('Select dates')\n    44→  if (!(await selectDatesHeading.isVisible().catch(() => false))) {\n    45→    await page.getByTestId('booking-checkin').click()\n    46→    await expect(selectDatesHeading).toBeVisible({ timeout: 5000 })\n    47→  }\n    48→}\n    49→\n    50→async function navigateToAndClickDay(page: import('@playwright/test').Page, dateStr: string) {\n    51→  const dayButton = page.getByTestId(`calendar-day-${dateStr}`)\n    52→  // Navigate forward until the day is visible (max 12 months ahead)\n    53→  for (let i = 0; i < 12; i++) {\n    54→    if (await dayButton.isVisible().catch(() => false)) break\n    55→    await page.getByTestId('calendar-next-month').click()\n    56→  }\n    57→  await dayButton.click()\n    58→}\n    59→\n    60→async function selectDatesViaCalendar(\n    61→  page: import('@playwright/test').Page,\n    62→  checkInDate: string,\n    63→  checkOutDate: string\n    64→) {\n    65→  await openCalendarIfNeeded(page)\n    66→  await navigateToAndClickDay(page, checkInDate)\n    67→  await navigateToAndClickDay(page, checkOutDate)\n    68→  // Close calendar\n    69→  await page.getByRole('button', { name: 'Close' }).click()\n    70→}\n    71→\n    72→async function clearCalendarDates(page: import('@playwright/test').Page) {\n    73→  await openCalendarIfNeeded(page)\n    74→  await page.getByRole('button', { name: 'Clear dates' }).click()\n    75→}\n    76→\n    77→test.describe('Property Detail - BookingCard', () => {\n    78→  test.beforeEach(async ({ request }) => {\n    79→    // Clean up any non-seed bookings created by Emma\n    80→    const res = await request.get(`/api/bookings?guest_id=${EMMA_ID}`)\n    81→    if (res.ok()) {\n    82→      const bookings = await res.json()\n    83→      const seedBookingIds = [\n    84→        'e1111111-1111-1111-1111-111111111111',\n    85→        'e2222222-2222-2222-2222-222222222222',\n    86→        'e3333333-3333-3333-3333-333333333333',\n    87→        'e4444444-4444-4444-4444-444444444444',\n    88→        'e5555555-5555-5555-5555-555555555555',\n    89→        'e6666666-6666-6666-6666-666666666666',\n    90→      ]\n    91→      for (const booking of bookings) {\n    92→        if (!seedBookingIds.includes(booking.id)) {\n    93→          await request.put(`/api/bookings/${booking.id}`, {\n    94→            data: { status: 'cancelled' },\n    95→          })\n    96→        }\n    97→      }\n    98→    }\n    99→  })\n   100→\n   101→  test('Booking card displays price per night', async ({ page }) => {\n   102→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   103→\n   104→    const card = page.getByTestId('booking-card')\n   105→    await expect(card).toBeVisible({ timeout: 30000 })\n   106→\n   107→    // $150 / night\n   108→    await expect(card).toContainText('$150')\n   109→    await expect(card).toContainText('night')\n   110→  })\n   111→\n   112→  test('Booking card displays check-in and check-out date pickers', async ({ page }) => {\n   113→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   114→\n   115→    const card = page.getByTestId('booking-card')\n   116→    await expect(card).toBeVisible({ timeout: 30000 })\n   117→\n   118→    const checkin = page.getByTestId('booking-checkin')\n   119→    const checkout = page.getByTestId('booking-checkout')\n   120→\n   121→    await expect(checkin).toBeVisible()\n   122→    await expect(checkout).toBeVisible()\n   123→\n   124→    // Both should show placeholder text when no date is selected\n   125→    await expect(checkin).toContainText('Add date')\n   126→    await expect(checkout).toContainText('Add date')\n   127→\n   128→    // Clicking the date area should open the custom calendar\n   129→    await checkin.click()\n   130→    await expect(page.getByText('Select dates')).toBeVisible()\n   131→  })\n   132→\n   133→  test('Booking card displays guest count selector', async ({ page }) => {\n   134→    // b3333333: max_guests = 6\n   135→    await page.goto(`/properties/${PROPERTY_CABIN}`)\n   136→\n   137→    const card = page.getByTestId('booking-card')\n   138→    await expect(card).toBeVisible({ timeout: 30000 })\n   139→\n   140→    const guestsButton = page.getByTestId('booking-guests')\n   141→    await expect(guestsButton).toBeVisible()\n   142→\n   143→    // Open dropdown to see options\n   144→    await guestsButton.click()\n   145→    const dropdown = page.getByTestId('booking-guests-dropdown')\n   146→    await expect(dropdown).toBeVisible()\n   147→\n   148→    // Should have options from 1 to 6\n   149→    const options = dropdown.locator('button')\n   150→    await expect(options).toHaveCount(6)\n   151→\n   152→    // First option should be \"1 guest\"\n   153→    await expect(options.first()).toHaveText('1 guest')\n   154→    // Last option should be \"6 guests\"\n   155→    await expect(options.last()).toHaveText('6 guests')\n   156→\n   157→    // Close dropdown\n   158→    await guestsButton.click()\n   159→  })\n   160→\n   161→  test('Selecting dates and guests shows price breakdown', async ({ page }) => {\n   162→    // b1111111: $150/night, $75 cleaning fee\n   163→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   164→\n   165→    const card = page.getByTestId('booking-card')\n   166→    await expect(card).toBeVisible({ timeout: 30000 })\n   167→\n   168→    // Select check-in and check-out (3 nights) via custom calendar\n   169→    await selectDatesViaCalendar(page, '2026-05-01', '2026-05-04')\n   170→\n   171→    // Select 2 guests\n   172→    await page.getByTestId('booking-guests').click()\n   173→    await page.getByTestId('guest-option-2').click()\n   174→\n   175→    // Price breakdown should appear\n   176→    const breakdown = page.getByTestId('price-breakdown')\n   177→    await expect(breakdown).toBeVisible()\n   178→\n   179→    // $150 x 3 nights = $450\n   180→    await expect(breakdown).toContainText('$150 x 3 nights')\n   181→    await expect(breakdown).toContainText('$450')\n   182→\n   183→    // Cleaning fee: $75\n   184→    await expect(breakdown).toContainText('Cleaning fee')\n   185→    await expect(breakdown).toContainText('$75')\n   186→\n   187→    // Total: $525\n   188→    await expect(breakdown).toContainText('Total')\n   189→    await expect(breakdown).toContainText('$525')\n   190→  })\n   191→\n   192→  test('Price breakdown updates when dates change', async ({ page }) => {\n   193→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   194→\n   195→    const card = page.getByTestId('booking-card')\n   196→    await expect(card).toBeVisible({ timeout: 30000 })\n   197→\n   198→    // Initial: 3 nights\n   199→    await selectDatesViaCalendar(page, '2026-05-01', '2026-05-04')\n   200→\n   201→    const breakdown = page.getByTestId('price-breakdown')\n   202→    await expect(breakdown).toContainText('$150 x 3 nights')\n   203→    await expect(breakdown).toContainText('$525')\n   204→\n   205→    // Clear dates and select new dates: 5 nights\n   206→    await clearCalendarDates(page)\n   207→    await navigateToAndClickDay(page, '2026-05-01')\n   208→    await navigateToAndClickDay(page, '2026-05-06')\n   209→    await page.getByRole('button', { name: 'Close' }).click()\n   210→\n   211→    // $150 x 5 nights = $750, Total: $825\n   212→    await expect(breakdown).toContainText('$150 x 5 nights')\n   213→    await expect(breakdown).toContainText('$750')\n   214→    await expect(breakdown).toContainText('$825')\n   215→  })\n   216→\n   217→  test('Reserve button creates a booking when logged in', async ({ page }) => {\n   218→    test.slow()\n   219→    await loginAs(page, GUEST_EMAIL)\n   220→\n   221→    // Clean up any existing bookings for this guest\n   222→    await deleteAllBookings(page, 'a3333333-3333-3333-3333-333333333333')\n   223→\n   224→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   225→\n   226→    const card = page.getByTestId('booking-card')\n   227→    await expect(card).toBeVisible({ timeout: 30000 })\n   228→\n   229→    // Select dates and guests via custom calendar\n   230→    await selectDatesViaCalendar(page, '2026-07-01', '2026-07-04')\n   231→    await page.getByTestId('booking-guests').click()\n   232→    await page.getByTestId('guest-option-2').click()\n   233→\n   234→    // Click Reserve\n   235→    const reserveBtn = page.getByTestId('reserve-button')\n   236→    await expect(reserveBtn).toBeEnabled()\n   237→    await reserveBtn.click()\n   238→\n   239→    // Success message should appear\n   240→    await expect(page.getByTestId('booking-success')).toContainText('Booking confirmed', { timeout: 30000 })\n   241→\n   242→    // Should redirect to /trips\n   243→    await expect(page).toHaveURL('/trips', { timeout: 30000 })\n   244→  })\n   245→\n   246→  test('Reserve button is disabled when dates are not selected', async ({ page }) => {\n   247→    test.slow()\n   248→    await loginAs(page, GUEST_EMAIL)\n   249→\n   250→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   251→\n   252→    const card = page.getByTestId('booking-card')\n   253→    await expect(card).toBeVisible({ timeout: 30000 })\n   254→\n   255→    // No dates selected - reserve button should be disabled\n   256→    const reserveBtn = page.getByTestId('reserve-button')\n   257→    await expect(reserveBtn).toBeVisible()\n   258→    await expect(reserveBtn).toBeDisabled()\n   259→\n   260→    // Should show hint text about adding dates\n   261→    await expect(card).toContainText('Add dates for prices')\n   262→  })\n   263→\n   264→  test('Reserve button prompts login when user is not logged in', async ({ page }) => {\n   265→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   266→\n   267→    const card = page.getByTestId('booking-card')\n   268→    await expect(card).toBeVisible({ timeout: 30000 })\n   269→\n   270→    // Not logged in - should show login prompt button\n   271→    const loginPrompt = page.getByTestId('booking-login-prompt')\n   272→    await expect(loginPrompt).toBeVisible()\n   273→    await expect(loginPrompt).toContainText('Log in to reserve')\n   274→\n   275→    // Click login prompt\n   276→    await loginPrompt.click()\n   277→\n   278→    // Should navigate to login page\n   279→    await expect(page).toHaveURL('/login', { timeout: 30000 })\n   280→  })\n   281→\n   282→  test(\"Reserve button is disabled for host's own property\", async ({ page }) => {\n   283→    test.slow()\n   284→    // Login as Sarah (host of b1111111)\n   285→    await loginAs(page, HOST_EMAIL)\n   286→\n   287→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   288→\n   289→    const card = page.getByTestId('booking-card')\n   290→    await expect(card).toBeVisible({ timeout: 30000 })\n   291→\n   292→    // Should show \"You cannot book your own property\" message\n   293→    const ownMessage = page.getByTestId('own-property-message')\n   294→    await expect(ownMessage).toBeVisible()\n   295→    await expect(ownMessage).toContainText('You cannot book your own property')\n   296→\n   297→    // Reserve button should not be visible (replaced by own-property message)\n   298→    await expect(page.getByTestId('reserve-button')).not.toBeVisible()\n   299→  })\n   300→\n   301→  test('Check-in date picker prevents selecting past dates', async ({ page }) => {\n   302→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   303→\n   304→    const card = page.getByTestId('booking-card')\n   305→    await expect(card).toBeVisible({ timeout: 30000 })\n   306→\n   307→    // Open the calendar\n   308→    await page.getByTestId('booking-checkin').click()\n   309→    await expect(page.getByText('Select dates')).toBeVisible()\n   310→\n   311→    // Yesterday's date should be disabled in the calendar\n   312→    const yesterday = new Date()\n   313→    yesterday.setDate(yesterday.getDate() - 1)\n   314→    const yesterdayStr = yesterday.toISOString().split('T')[0]\n   315→    const yesterdayButton = page.getByTestId(`calendar-day-${yesterdayStr}`)\n   316→\n   317→    // Past date button should be disabled (if visible in current month view)\n   318→    if (await yesterdayButton.isVisible().catch(() => false)) {\n   319→      await expect(yesterdayButton).toBeDisabled()\n   320→    }\n   321→\n   322→    // Today's date should be enabled\n   323→    const todayStr = new Date().toISOString().split('T')[0]\n   324→    const todayButton = page.getByTestId(`calendar-day-${todayStr}`)\n   325→    if (await todayButton.isVisible().catch(() => false)) {\n   326→      await expect(todayButton).toBeEnabled()\n   327→    }\n   328→  })\n   329→\n   330→  test('Check-out date must be after check-in date', async ({ page }) => {\n   331→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   332→\n   333→    const card = page.getByTestId('booking-card')\n   334→    await expect(card).toBeVisible({ timeout: 30000 })\n   335→\n   336→    // Open calendar and select check-in date\n   337→    await openCalendarIfNeeded(page)\n   338→    await navigateToAndClickDay(page, '2026-05-01')\n   339→\n   340→    // Check-in should be displayed\n   341→    await expect(page.getByTestId('booking-checkin')).toContainText('May 1, 2026')\n   342→\n   343→    // Selecting a date before check-in should reset check-in (not set as check-out)\n   344→    // Navigate back to April if needed and click April 30\n   345→    const aprilDay = page.getByTestId('calendar-day-2026-04-30')\n   346→    // Need to navigate back to see April\n   347→    for (let i = 0; i < 12; i++) {\n   348→      if (await aprilDay.isVisible().catch(() => false)) break\n   349→      await page.getByTestId('calendar-prev-month').click()\n   350→    }\n   351→    await aprilDay.click()\n   352→\n   353→    // Check-in should now be April 30 (reset), check-out should be empty\n   354→    await expect(page.getByTestId('booking-checkin')).toContainText('Apr 30, 2026')\n   355→    await expect(page.getByTestId('booking-checkout')).toContainText('Add date')\n   356→  })\n   357→\n   358→  test('Guest count cannot exceed property max_guests', async ({ page }) => {\n   359→    // b1111111: max_guests = 4\n   360→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   361→\n   362→    const card = page.getByTestId('booking-card')\n   363→    await expect(card).toBeVisible({ timeout: 30000 })\n   364→\n   365→    const guestsButton = page.getByTestId('booking-guests')\n   366→    await guestsButton.click()\n   367→    const dropdown = page.getByTestId('booking-guests-dropdown')\n   368→    const options = dropdown.locator('button')\n   369→\n   370→    // Should have exactly 4 options (1-4)\n   371→    await expect(options).toHaveCount(4)\n   372→\n   373→    // Last option value should be \"4\"\n   374→    await expect(options.last()).toHaveText('4 guests')\n   375→\n   376→    // Close dropdown\n   377→    await guestsButton.click()\n   378→  })\n   379→\n   380→  test('Guest count minimum is 1', async ({ page }) => {\n   381→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   382→\n   383→    const card = page.getByTestId('booking-card')\n   384→    await expect(card).toBeVisible({ timeout: 30000 })\n   385→\n   386→    const guestsButton = page.getByTestId('booking-guests')\n   387→\n   388→    // Default display should show \"1 guest\"\n   389→    await expect(guestsButton).toContainText('1 guest')\n   390→    await expect(guestsButton).toHaveAttribute('data-value', '1')\n   391→\n   392→    // Open dropdown to verify first option\n   393→    await guestsButton.click()\n   394→    const dropdown = page.getByTestId('booking-guests-dropdown')\n   395→    const options = dropdown.locator('button')\n   396→    await expect(options.first()).toHaveText('1 guest')\n   397→\n   398→    // Close dropdown\n   399→    await guestsButton.click()\n   400→  })\n   401→\n   402→  test('Reserve button shows error for unavailable dates', async ({ page }) => {\n   403→    test.slow()\n   404→    await loginAs(page, GUEST_EMAIL)\n   405→\n   406→    // b2222222 has a confirmed booking for 2026-04-01 to 2026-04-07 (by Alex)\n   407→    await page.goto('/properties/b2222222-2222-2222-2222-222222222222')\n   408→\n   409→    const card = page.getByTestId('booking-card')\n   410→    await expect(card).toBeVisible({ timeout: 30000 })\n   411→\n   412→    // Select overlapping dates via custom calendar\n   413→    await selectDatesViaCalendar(page, '2026-04-02', '2026-04-06')\n   414→    await page.getByTestId('booking-guests').click()\n   415→    await page.getByTestId('guest-option-2').click()\n   416→\n   417→    // Click Reserve\n   418→    const reserveBtn = page.getByTestId('reserve-button')\n   419→    await expect(reserveBtn).toBeEnabled()\n   420→    await reserveBtn.click()\n   421→\n   422→    // Should show error about unavailable dates\n   423→    const errorMsg = page.getByTestId('booking-error')\n   424→    await expect(errorMsg).toBeVisible({ timeout: 30000 })\n   425→    await expect(errorMsg).toContainText('not available')\n   426→  })\n   427→\n   428→  test('Booking card date pickers and guest selector are functional on repeated use', async ({ page }) => {\n   429→    // b1111111: $150/night, $75 cleaning fee, 4 max guests\n   430→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   431→\n   432→    const card = page.getByTestId('booking-card')\n   433→    await expect(card).toBeVisible({ timeout: 30000 })\n   434→\n   435→    const checkin = page.getByTestId('booking-checkin')\n   436→    const checkout = page.getByTestId('booking-checkout')\n   437→    const guestsSelect = page.getByTestId('booking-guests')\n   438→    const breakdown = page.getByTestId('price-breakdown')\n   439→\n   440→    // First selection: 2026-05-01 to 2026-05-04 (3 nights), 2 guests\n   441→    await selectDatesViaCalendar(page, '2026-05-01', '2026-05-04')\n   442→    await guestsSelect.click()\n   443→    await page.getByTestId('guest-option-2').click()\n   444→\n   445→    // $150 x 3 = $450 + $75 = $525\n   446→    await expect(breakdown).toContainText('$150 x 3 nights')\n   447→    await expect(breakdown).toContainText('$525')\n   448→\n   449→    // Change dates: 2026-06-01 to 2026-06-05 (4 nights)\n   450→    await clearCalendarDates(page)\n   451→    await navigateToAndClickDay(page, '2026-06-01')\n   452→    await navigateToAndClickDay(page, '2026-06-05')\n   453→    await page.getByRole('button', { name: 'Close' }).click()\n   454→\n   455→    // $150 x 4 = $600 + $75 = $675\n   456→    await expect(breakdown).toContainText('$150 x 4 nights')\n   457→    await expect(breakdown).toContainText('$675')\n   458→\n   459→    // Change guests: 2 -> 4 -> 2\n   460→    await guestsSelect.click()\n   461→    await page.getByTestId('guest-option-4').click()\n   462→    await expect(guestsSelect).toHaveAttribute('data-value', '4')\n   463→    await guestsSelect.click()\n   464→    await page.getByTestId('guest-option-2').click()\n   465→    await expect(guestsSelect).toHaveAttribute('data-value', '2')\n   466→\n   467→    // Price breakdown should still be correct after guest changes\n   468→    await expect(breakdown).toContainText('$150 x 4 nights')\n   469→    await expect(breakdown).toContainText('$675')\n   470→\n   471→    // Final state verification\n   472→    await expect(checkin).toContainText('Jun 1, 2026')\n   473→    await expect(checkout).toContainText('Jun 5, 2026')\n   474→    await expect(guestsSelect).toHaveAttribute('data-value', '2')\n   475→  })\n   476→\n   477→  test('Booking card is sticky on desktop viewport', async ({ page }) => {\n   478→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   479→\n   480→    const card = page.getByTestId('booking-card')\n   481→    await expect(card).toBeVisible({ timeout: 30000 })\n   482→\n   483→    // Verify the card has sticky positioning\n   484→    const posit