[2026-03-16T00:26:10.484Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MRybDvqj8nDkYPZet1bqc9","type":"tool_result","content":"     1→import { useState, useEffect, useCallback, useRef } from 'react'\n     2→import { useSelector, useDispatch } from 'react-redux'\n     3→import { useNavigate } from 'react-router-dom'\n     4→import { ChevronLeft, ChevronRight, ChevronDown } from 'lucide-react'\n     5→import type { RootState, AppDispatch } from '../store'\n     6→import type { Property } from '../slices/propertiesSlice'\n     7→import { createBooking, clearBookingError } from '../slices/bookingsSlice'\n     8→\n     9→interface BookingCardProps {\n    10→  property: Property\n    11→}\n    12→\n    13→interface BookedRange {\n    14→  check_in: string\n    15→  check_out: string\n    16→}\n    17→\n    18→function getDaysInMonth(year: number, month: number): number {\n    19→  return new Date(year, month + 1, 0).getDate()\n    20→}\n    21→\n    22→function getFirstDayOfWeek(year: number, month: number): number {\n    23→  return new Date(year, month, 1).getDay()\n    24→}\n    25→\n    26→function formatDateStr(year: number, month: number, day: number): string {\n    27→  return `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`\n    28→}\n    29→\n    30→function isDateBooked(dateStr: string, bookedRanges: BookedRange[]): boolean {\n    31→  for (const range of bookedRanges) {\n    32→    if (dateStr >= range.check_in && dateStr < range.check_out) {\n    33→      return true\n    34→    }\n    35→  }\n    36→  return false\n    37→}\n    38→\n    39→function isDateInPast(dateStr: string, todayStr: string): boolean {\n    40→  return dateStr < todayStr\n    41→}\n    42→\n    43→const MONTH_NAMES = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']\n    44→const DAY_NAMES = ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa']\n    45→\n    46→function CalendarMonth({\n    47→  year,\n    48→  month,\n    49→  todayStr,\n    50→  bookedRanges,\n    51→  checkIn,\n    52→  checkOut,\n    53→  onSelectDate,\n    54→}: {\n    55→  year: number\n    56→  month: number\n    57→  todayStr: string\n    58→  bookedRanges: BookedRange[]\n    59→  checkIn: string\n    60→  checkOut: string\n    61→  onSelectDate: (dateStr: string) => void\n    62→}) {\n    63→  const daysInMonth = getDaysInMonth(year, month)\n    64→  const firstDay = getFirstDayOfWeek(year, month)\n    65→\n    66→  const cells: (number | null)[] = []\n    67→  for (let i = 0; i < firstDay; i++) cells.push(null)\n    68→  for (let d = 1; d <= daysInMonth; d++) cells.push(d)\n    69→\n    70→  return (\n    71→    <div>\n    72→      <div className=\"text-center text-sm font-semibold text-text mb-3\">\n    73→        {MONTH_NAMES[month]} {year}\n    74→      </div>\n    75→      <div className=\"grid grid-cols-7 gap-0\">\n    76→        {DAY_NAMES.map((d) => (\n    77→          <div key={d} className=\"text-center text-xs font-semibold text-text-secondary py-1\">\n    78→            {d}\n    79→          </div>\n    80→        ))}\n    81→        {cells.map((day, idx) => {\n    82→          if (day === null) {\n    83→            return <div key={`empty-${idx}`} className=\"h-10\" />\n    84→          }\n    85→          const dateStr = formatDateStr(year, month, day)\n    86→          const isPast = isDateInPast(dateStr, todayStr)\n    87→          const booked = isDateBooked(dateStr, bookedRanges)\n    88→          const disabled = isPast || booked\n    89→          const isCheckIn = dateStr === checkIn\n    90→          const isCheckOut = dateStr === checkOut\n    91→          const isSelected = isCheckIn || isCheckOut\n    92→          const inRange = checkIn && checkOut && dateStr > checkIn && dateStr < checkOut\n    93→\n    94→          return (\n    95→            <button\n    96→              key={dateStr}\n    97→              data-testid={`calendar-day-${dateStr}`}\n    98→              disabled={disabled}\n    99→              onClick={() => !disabled && onSelectDate(dateStr)}\n   100→              className={`h-10 w-full text-sm rounded-full transition-colors cursor-pointer\n   101→                ${disabled ? 'text-border line-through cursor-not-allowed' : 'hover:bg-bg-secondary text-text'}\n   102→                ${isSelected ? 'bg-text text-white hover:bg-text' : ''}\n   103→                ${inRange ? 'bg-bg-secondary' : ''}\n   104→                ${booked ? 'bg-bg-secondary' : ''}\n   105→              `}\n   106→            >\n   107→              {day}\n   108→            </button>\n   109→          )\n   110→        })}\n   111→      </div>\n   112→    </div>\n   113→  )\n   114→}\n   115→\n   116→export default function BookingCard({ property }: BookingCardProps) {\n   117→  const dispatch = useDispatch<AppDispatch>()\n   118→  const navigate = useNavigate()\n   119→  const currentUser = useSelector((state: RootState) => state.auth.currentUser)\n   120→  const { loading, error } = useSelector((state: RootState) => state.bookings)\n   121→\n   122→  const [checkIn, setCheckIn] = useState('')\n   123→  const [checkOut, setCheckOut] = useState('')\n   124→  const [guests, setGuests] = useState(1)\n   125→  const [success, setSuccess] = useState(false)\n   126→  const [calendarOpen, setCalendarOpen] = useState(false)\n   127→  const [bookedRanges, setBookedRanges] = useState<BookedRange[]>([])\n   128→\n   129→  const now = new Date()\n   130→  const todayStr = formatDateStr(now.getFullYear(), now.getMonth(), now.getDate())\n   131→  const [calMonth, setCalMonth] = useState(now.getMonth())\n   132→  const [calYear, setCalYear] = useState(now.getFullYear())\n   133→  const [guestDropdownOpen, setGuestDropdownOpen] = useState(false)\n   134→  const guestDropdownRef = useRef<HTMLDivElement>(null)\n   135→\n   136→  useEffect(() => {\n   137→    function handleClickOutside(e: MouseEvent) {\n   138→      if (guestDropdownRef.current && !guestDropdownRef.current.contains(e.target as Node)) {\n   139→        setGuestDropdownOpen(false)\n   140→      }\n   141→    }\n   142→    document.addEventListener('mousedown', handleClickOutside)\n   143→    return () => document.removeEventListener('mousedown', handleClickOutside)\n   144→  }, [])\n   145→\n   146→  const isOwnProperty = currentUser?.id === property.host_id\n   147→\n   148→  useEffect(() => {\n   149→    fetch(`/api/bookings?property_id=${property.id}`)\n   150→      .then((r) => r.json())\n   151→      .then((data) => {\n   152→        if (Array.isArray(data)) {\n   153→          setBookedRanges(data as BookedRange[])\n   154→        }\n   155→      })\n   156→      .catch(() => {})\n   157→  }, [property.id])\n   158→\n   159→  const handleSelectDate = useCallback((dateStr: string) => {\n   160→    if (!checkIn || (checkIn && checkOut)) {\n   161→      setCheckIn(dateStr)\n   162→      setCheckOut('')\n   163→    } else {\n   164→      if (dateStr <= checkIn) {\n   165→        setCheckIn(dateStr)\n   166→        setCheckOut('')\n   167→      } else {\n   168→        // Check if any booked date is between checkIn and this date\n   169→        const hasBlockedInRange = bookedRanges.some(\n   170→          (r) => r.check_in < dateStr && r.check_out > checkIn\n   171→        )\n   172→        if (hasBlockedInRange) {\n   173→          setCheckIn(dateStr)\n   174→          setCheckOut('')\n   175→        } else {\n   176→          setCheckOut(dateStr)\n   177→        }\n   178→      }\n   179→    }\n   180→  }, [checkIn, checkOut, bookedRanges])\n   181→\n   182→  const handlePrevMonth = () => {\n   183→    if (calMonth === 0) {\n   184→      setCalMonth(11)\n   185→      setCalYear(calYear - 1)\n   186→    } else {\n   187→      setCalMonth(calMonth - 1)\n   188→    }\n   189→  }\n   190→\n   191→  const handleNextMonth = () => {\n   192→    if (calMonth === 11) {\n   193→      setCalMonth(0)\n   194→      setCalYear(calYear + 1)\n   195→    } else {\n   196→      setCalMonth(calMonth + 1)\n   197→    }\n   198→  }\n   199→\n   200→  const nextMonth = calMonth === 11 ? 0 : calMonth + 1\n   201→  const nextYear = calMonth === 11 ? calYear + 1 : calYear\n   202→\n   203→  const nights =\n   204→    checkIn && checkOut\n   205→      ? Math.max(0, Math.round((new Date(checkOut).getTime() - new Date(checkIn).getTime()) / (1000 * 60 * 60 * 24)))\n   206→      : 0\n   207→\n   208→  const nightlyTotal = nights * Number(property.price_per_night)\n   209→  const cleaningFee = Number(property.cleaning_fee)\n   210→  const total = nightlyTotal + cleaningFee\n   211→\n   212→  const canReserve = checkIn && checkOut && nights > 0 && !isOwnProperty && currentUser && !loading\n   213→\n   214→  const handleReserve = async () => {\n   215→    if (!currentUser) {\n   216→      navigate('/login')\n   217→      return\n   218→    }\n   219→    if (!checkIn || !checkOut || isOwnProperty) return\n   220→\n   221→    dispatch(clearBookingError())\n   222→    const result = await dispatch(\n   223→      createBooking({\n   224→        property_id: property.id,\n   225→        guest_id: currentUser.id,\n   226→        check_in: checkIn,\n   227→        check_out: checkOut,\n   228→        num_guests: guests,\n   229→        total_price: total,\n   230→      })\n   231→    )\n   232→    if (createBooking.fulfilled.match(result)) {\n   233→      setSuccess(true)\n   234→      setTimeout(() => navigate('/trips'), 1500)\n   235→    }\n   236→  }\n   237→\n   238→  const formatDisplayDate = (d: string) => {\n   239→    if (!d) return ''\n   240→    const date = new Date(d + 'T00:00:00')\n   241→    return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })\n   242→  }\n   243→\n   244→  return (\n   245→    <div data-testid=\"booking-card\" className=\"border border-border rounded-xl p-6 shadow-lg sticky top-[96px]\">\n   246→      {nights > 0 ? (\n   247→        <div className=\"flex items-baseline gap-1 mb-5\">\n   248→          <span className=\"text-[22px] font-semibold text-text\">${Number(property.price_per_night).toFixed(0)}</span>\n   249→          <span className=\"text-text-secondary\">night</span>\n   250→        </div>\n   251→      ) : (\n   252→        <p className=\"text-[22px] font-semibold text-text mb-5\">Add dates for prices</p>\n   253→      )}\n   254→\n   255→      <div className=\"border border-border rounded-lg overflow-hidden mb-4\">\n   256→        <div className=\"grid grid-cols-2 cursor-pointer\" onClick={() => setCalendarOpen(!calendarOpen)}>\n   257→          <div className=\"p-3 border-r border-border\">\n   258→            <label className=\"block text-[10px] font-bold text-text uppercase tracking-wide\">Check-in</label>\n   259→            <p data-testid=\"booking-checkin\" className=\"text-sm text-text-secondary mt-0.5\">\n   260→              {checkIn ? formatDisplayDate(checkIn) : 'Add date'}\n   261→            </p>\n   262→          </div>\n   263→          <div className=\"p-3\">\n   264→            <label className=\"block text-[10px] font-bold text-text uppercase tracking-wide\">Checkout</label>\n   265→            <p data-testid=\"booking-checkout\" className=\"text-sm text-text-secondary mt-0.5\">\n   266→              {checkOut ? formatDisplayDate(checkOut) : 'Add date'}\n   267→            </p>\n   268→          </div>\n   269→        </div>\n   270→        <div className=\"border-t border-border p-3 relative\" ref={guestDropdownRef}>\n   271→          <label className=\"block text-[10px] font-bold text-text uppercase tracking-wide\">Guests</label>\n   272→          <button\n   273→            data-testid=\"booking-guests\"\n   274→            data-value={String(guests)}\n   275→            type=\"button\"\n   276→            onClick={() => setGuestDropdownOpen(!guestDropdownOpen)}\n   277→            className=\"w-full flex items-center justify-between text-sm text-text bg-transparent outline-none mt-0.5 cursor-pointer\"\n   278→          >\n   279→            <span>{guests} {guests === 1 ? 'guest' : 'guests'}</span>\n   280→            <ChevronDown size={16} className={`transition-transform ${guestDropdownOpen ? 'rotate-180' : ''}`} />\n   281→          </button>\n   282→          {guestDropdownOpen && (\n   283→            <div data-testid=\"booking-guests-dropdown\" className=\"absolute left-0 right-0 top-full mt-1 bg-bg border border-border rounded-lg shadow-lg z-50 max-h-48 overflow-y-auto\">\n   284→              {Array.from({ length: property.max_guests }, (_, i) => i + 1).map((n) => (\n   285→                <button\n   286→                  key={n}\n   287→                  data-testid={`guest-option-${n}`}\n   288→                  type=\"button\"\n   289→                  onClick={() => { setGuests(n); setGuestDropdownOpen(false) }}\n   290→                  className={`w-full text-left px-3 py-2 text-sm cursor-pointer transition-colors\n   291→                    ${guests === n ? 'bg-bg-secondary font-semibold text-text' : 'text-text hover:bg-bg-secondary'}\n   292→                  `}\n   293→                >\n   294→                  {n} {n === 1 ? 'guest' : 'guests'}\n   295→                </button>\n   296→              ))}\n   297→            </div>\n   298→          )}\n   299→        </div>\n   300→      </div>\n   301→\n   302→      {calendarOpen && (\n   303→        <div className=\"mb-4 border border-border rounded-xl p-4 bg-bg shadow-sm\">\n   304→          <div className=\"mb-3\">\n   305→            <h3 className=\"text-base font-semibold text-text\">Select dates</h3>\n   306→            <p className=\"text-xs text-text-secondary\">Add your travel dates for exact pricing</p>\n   307→          </div>\n   308→          <div className=\"flex items-center justify-between mb-2\">\n   309→            <button\n   310→              onClick={handlePrevMonth}\n   311→              className=\"p-1 rounded-full hover:bg-bg-secondary cursor-pointer\"\n   312→            >\n   313→              <ChevronLeft size={20} />\n   314→            </button>\n   315→            <div />\n   316→            <button\n   317→              onClick={handleNextMonth}\n   318→              className=\"p-1 rounded-full hover:bg-bg-secondary cursor-pointer\"\n   319→            >\n   320→              <ChevronRight size={20} />\n   321→            </button>\n   322→          </div>\n   323→          <div className=\"grid grid-cols-2 gap-6\">\n   324→            <CalendarMonth\n   325→              year={calYear}\n   326→              month={calMonth}\n   327→              todayStr={todayStr}\n   328→              bookedRanges={bookedRanges}\n   329→              checkIn={checkIn}\n   330→              checkOut={checkOut}\n   331→              onSelectDate={handleSelectDate}\n   332→            />\n   333→            <CalendarMonth\n   334→              year={nextYear}\n   335→              month={nextMonth}\n   336→              todayStr={todayStr}\n   337→              bookedRanges={bookedRanges}\n   338→              checkIn={checkIn}\n   339→              checkOut={checkOut}\n   340→              onSelectDate={handleSelectDate}\n   341→            />\n   342→          </div>\n   343→          <div className=\"flex items-center justify-end gap-3 mt-4 pt-3 border-t border-border\">\n   344→            <button\n   345→              onClick={() => { setCheckIn(''); setCheckOut('') }}\n   346→              className=\"text-sm font-semibold text-text underline hover:no-underline cursor-pointer\"\n   347→            >\n   348→              Clear dates\n   349→            </button>\n   350→            <button\n   351→              onClick={() => setCalendarOpen(false)}\n   352→              className=\"text-sm font-semibold text-white bg-text rounded-lg px-4 py-2 hover:opacity-90 cursor-pointer\"\n   353→            >\n   354→              Close\n   355→            </button>\n   356→          </div>\n   357→        </div>\n   358→      )}\n   359→\n   360→      {nights > 0 && (\n   361→        <div data-testid=\"price-breakdown\" className=\"mb-4 space-y-2 text-sm\">\n   362→          <div className=\"flex justify-between text-text-secondary\">\n   363→            <span className=\"underline\">${Number(property.price_per_night).toFixed(0)} x {nights} {nights === 1 ? 'night' : 'nights'}</span>\n   364→            <span>${nightlyTotal.toFixed(0)}</span>\n   365→          </div>\n   366→          <div className=\"flex justify-between text-text-secondary\">\n   367→            <span className=\"underline\">Cleaning fee</span>\n   368→            <span>${cleaningFee.toFixed(0)}</span>\n   369→          </div>\n   370→          <div className=\"flex justify-between font-semibold text-text pt-3 border-t border-border\">\n   371→            <span>Total</span>\n   372→            <span>${total.toFixed(0)}</span>\n   373→          </div>\n   374→        </div>\n   375→      )}\n   376→\n   377→      {isOwnProperty ? (\n   378→        <p data-testid=\"own-property-message\" className=\"text-center text-text-secondary text-sm mb-2\">\n   379→          You cannot book your own property\n   380→        </p>\n   381→      ) : !currentUser ? (\n   382→        <button\n   383→          data-testid=\"booking-login-prompt\"\n   384→          className=\"w-full py-3 rounded-lg bg-gradient-to-r from-primary to-[#E61E4D] text-white font-semibold hover:opacity-95 transition-opacity cursor-pointer text-base\"\n   385→          onClick={() => navigate('/login')}\n   386→        >\n   387→          Log in to reserve\n   388→        </button>\n   389→      ) : (\n   390→        <button\n   391→          data-testid=\"reserve-button\"\n   392→          className=\"w-full py-3 rounded-lg bg-gradient-to-r from-primary to-[#E61E4D] text-white font-semibold hover:opacity-95 transition-opacity disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer text-base\"\n   393→          disabled={!canReserve}\n   394→          onClick={handleReserve}\n   395→        >\n   396→          {loading ? 'Reserving...' : 'Reserve'}\n   397→        </button>\n   398→      )}\n   399→\n   400→      {!checkIn && !checkOut && currentUser && !isOwnProperty && (\n   401→        <p className=\"text-center text-text-secondary text-xs mt-3\">You won't be charged yet</p>\n   402→      )}\n   403→\n   404→      {error && (\n   405→        <p data-testid=\"booking-error\" className=\"text-error text-sm mt-2 text-center\">{error}</p>\n   406→      )}\n   407→\n   408→      {success && (\n   409→        <p data-testid=\"booking-success\" className=\"text-success text-sm mt-2 text-center font-semibold\">\n   410→          Booking confirmed! Redirecting...\n   411→        </p>\n   412→      )}\n   413→    </div>\n   414→  )\n   415→}\n   416→"}]},"parent_tool_use_id":null,"session_id":"bd78e25b-7fce-4bae-a91a-1f392b40d970","uuid":"8a5c41d1-1da9-4c10-a46b-984bbb3a6b29","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/components/BookingCard.tsx","content":"import { useState, useEffect, useCallback, useRef } from 'react'\nimport { useSelector, useDispatch } from 'react-redux'\nimport { useNavigate } from 'react-router-dom'\nimport { ChevronLeft, ChevronRight, ChevronDown } from 'lucide-react'\nimport type { RootState, AppDispatch } from '../store'\nimport type { Property } from '../slices/propertiesSlice'\nimport { createBooking, clearBookingError } from '../slices/bookingsSlice'\n\ninterface BookingCardProps {\n  property: Property\n}\n\ninterface BookedRange {\n  check_in: string\n  check_out: string\n}\n\nfunction getDaysInMonth(year: number, month: number): number {\n  return new Date(year, month + 1, 0).getDate()\n}\n\nfunction getFirstDayOfWeek(year: number, month: number): number {\n  return new Date(year, month, 1).getDay()\n}\n\nfunction formatDateStr(year: number, month: number, day: number): string {\n  return `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`\n}\n\nfunction isDateBooked(dateStr: string, bookedRanges: BookedRange[]): boolean {\n  for (const range of bookedRanges) {\n    if (dateStr >= range.check_in && dateStr < range.check_out) {\n      return true\n    }\n  }\n  return false\n}\n\nfunction isDateInPast(dateStr: string, todayStr: string): boolean {\n  return dateStr < todayStr\n}\n\nconst MONTH_NAMES = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']\nconst DAY_NAMES = ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa']\n\nfunction CalendarMonth({\n  year,\n  month,\n  todayStr,\n  bookedRanges,\n  checkIn,\n  checkOut,\n  onSelectDate,\n}: {\n  year: number\n  month: number\n  todayStr: string\n  bookedRanges: BookedRange[]\n  checkIn: string\n  checkOut: string\n  onSelectDate: (dateStr: string) => void\n}) {\n  const daysInMonth = getDaysInMonth(year, month)\n  const firstDay = getFirstDayOfWeek(year, month)\n\n  const cells: (number | null)[] = []\n  for (let i = 0; i < firstDay; i++) cells.push(null)\n  for (let d = 1; d <= daysInMonth; d++) cells.push(d)\n\n  return (\n    <div>\n      <div className=\"text-center text-sm font-semibold text-text mb-3\">\n        {MONTH_NAMES[month]} {year}\n      </div>\n      <div className=\"grid grid-cols-7 gap-0\">\n        {DAY_NAMES.map((d) => (\n          <div key={d} className=\"text-center text-xs font-semibold text-text-secondary py-1\">\n            {d}\n          </div>\n        ))}\n        {cells.map((day, idx) => {\n          if (day === null) {\n            return <div key={`empty-${idx}`} className=\"h-10\" />\n          }\n          const dateStr = formatDateStr(year, month, day)\n          const isPast = isDateInPast(dateStr, todayStr)\n          const booked = isDateBooked(dateStr, bookedRanges)\n          const disabled = isPast || booked\n          const isCheckIn = dateStr === checkIn\n          const isCheckOut = dateStr === checkOut\n          const isSelected = isCheckIn || isCheckOut\n          const inRange = checkIn && checkOut && dateStr > checkIn && dateStr < checkOut\n\n          return (\n            <button\n              key={dateStr}\n              data-testid={`calendar-day-${dateStr}`}\n              disabled={disabled}\n              onClick={() => !disabled && onSelectDate(dateStr)}\n              className={`h-10 w-full text-sm rounded-full transition-colors cursor-pointer\n                ${disabled ? 'text-border line-through cursor-not-allowed' : 'hover:bg-bg-secondary text-text'}\n                ${isSelected ? 'bg-text text-white hover:bg-text' : ''}\n                ${inRange ? 'bg-bg-secondary' : ''}\n                ${booked ? 'bg-bg-secondary' : ''}\n              `}\n            >\n              {day}\n            </button>\n          )\n        })}\n      </div>\n    </div>\n  )\n}\n\nexport default function BookingCard({ property }: BookingCardProps) {\n  const dispatch = useDispatch<AppDispatch>()\n  const navigate = useNavigate()\n  const currentUser = useSelector((state: RootState) => state.auth.currentUser)\n  const { loading, error } = useSelector((state: RootState) => state.bookings)\n\n  const [checkIn, setCheckIn] = useState('')\n  const [checkOut, setCheckOut] = useState('')\n  const [guests, setGuests] = useState(1)\n  const [success, setSuccess] = useState(false)\n  const [calendarOpen, setCalendarOpen] = useState(false)\n  const [bookedRanges, setBookedRanges] = useState<BookedRange[]>([])\n\n  const now = new Date()\n  const todayStr = formatDateStr(now.getFullYear(), now.getMonth(), now.getDate())\n  const [calMonth, setCalMonth] = useState(now.getMonth())\n  const [calYear, setCalYear] = useState(now.getFullYear())\n  const [guestDropdownOpen, setGuestDropdownOpen] = useState(false)\n  const guestDropdownRef = useRef<HTMLDivElement>(null)\n\n  useEffect(() => {\n    function handleClickOutside(e: MouseEvent) {\n      if (guestDropdownRef.current && !guestDropdownRef.current.contains(e.target as Node)) {\n        setGuestDropdownOpen(false)\n      }\n    }\n    document.addEventListener('mousedown', handleClickOutside)\n    return () => document.removeEventListener('mousedown', handleClickOutside)\n  }, [])\n\n  const isOwnProperty = currentUser?.id === property.host_id\n\n  useEffect(() => {\n    fetch(`/api/bookings?property_id=${property.id}`)\n      .then((r) => r.json())\n      .then((data) => {\n        if (Array.isArray(data)) {\n          setBookedRanges(data as BookedRange[])\n        }\n      })\n      .catch(() => {})\n  }, [property.id])\n\n  const handleSelectDate = useCallback((dateStr: string) => {\n    if (!checkIn || (checkIn && checkOut)) {\n      setCheckIn(dateStr)\n      setCheckOut('')\n    } else {\n      if (dateStr <= checkIn) {\n        setCheckIn(dateStr)\n        setCheckOut('')\n      } else {\n        // Check if any booked date is between checkIn and this date\n        const hasBlockedInRange = bookedRanges.some(\n          (r) => r.check_in < dateStr && r.check_out > checkIn\n        )\n        if (hasBlockedInRange) {\n          setCheckIn(dateStr)\n          setCheckOut('')\n        } else {\n          setCheckOut(dateStr)\n        }\n      }\n    }\n  }, [checkIn, checkOut, bookedRanges])\n\n  const handlePrevMonth = () => {\n    if (calMonth === 0) {\n      setCalMonth(11)\n      setCalYear(calYear - 1)\n    } else {\n      setCalMonth(calMonth - 1)\n    }\n  }\n\n  const handleNextMonth = () => {\n    if (calMonth === 11) {\n      setCalMonth(0)\n      setCalYear(calYear + 1)\n    } else {\n      setCalMonth(calMonth + 1)\n    }\n  }\n\n  const nextMonth = calMonth === 11 ? 0 : calMonth + 1\n  const nextYear = calMonth === 11 ? calYear + 1 : calYear\n\n  const nights =\n    checkIn && checkOut\n      ? Math.max(0, Math.round((new Date(checkOut).getTime() - new Date(checkIn).getTime()) / (1000 * 60 * 60 * 24)))\n      : 0\n\n  const nightlyTotal = nights * Number(property.price_per_night)\n  const cleaningFee = Number(property.cleaning_fee)\n  const total = nightlyTotal + cleaningFee\n\n  const canReserve = checkIn && checkOut && nights > 0 && !isOwnProperty && currentUser && !loading\n\n  const handleReserve = async () => {\n    if (!currentUser) {\n      navigate('/login')\n      return\n    }\n    if (!checkIn || !checkOut || isOwnProperty) return\n\n    dispatch(clearBookingError())\n    const result = await dispatch(\n      createBooking({\n        property_id: property.id,\n        guest_id: currentUser.id,\n        check_in: checkIn,\n        check_out: checkOut,\n        num_guests: guests,\n        total_price: total,\n      })\n    )\n    if (createBooking.fulfilled.match(result)) {\n      setSuccess(true)\n      setTimeout(() => navigate('/trips'), 1500)\n    }\n  }\n\n  const formatDisplayDate = (d: string) => {\n    if (!d) return ''\n    const date = new Date(d + 'T00:00:00')\n    return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })\n  }\n\n  return (\n    <div data-testid=\"booking-card\" className=\"border border-border rounded-xl p-6 shadow-lg sticky top-[96px]\">\n      {nights > 0 ? (\n        <div className=\"flex items-baseline gap-1 mb-5\">\n          <span className=\"text-[22px] font-semibold text-text\">${Number(property.price_per_night).toFixed(0)}</span>\n          <span className=\"text-text-secondary\">night</span>\n        </div>\n      ) : (\n        <p className=\"text-[22px] font-semibold text-text mb-5\">Add dates for prices</p>\n      )}\n\n      <div className=\"border border-border rounded-lg overflow-hidden mb-4\">\n        <div className=\"grid grid-cols-2 cursor-pointer\" onClick={() => setCalendarOpen(!calendarOpen)}>\n          <div className=\"p-3 border-r border-border\">\n            <label className=\"block text-[10px] font-bold text-text uppercase tracking-wide\">Check-in</label>\n            <p data-testid=\"booking-checkin\" className=\"text-sm text-text-secondary mt-0.5\">\n              {checkIn ? formatDisplayDate(checkIn) : 'Add date'}\n            </p>\n          </div>\n          <div className=\"p-3\">\n            <label className=\"block text-[10px] font-bold text-text uppercase tracking-wide\">Checkout</label>\n            <p data-testid=\"booking-checkout\" className=\"text-sm text-text-secondary mt-0.5\">\n              {checkOut ? formatDisplayDate(checkOut) : 'Add date'}\n            </p>\n          </div>\n        </div>\n        <div className=\"border-t border-border p-3 relative\" ref={guestDropdownRef}>\n          <label className=\"block text-[10px] font-bold text-text uppercase tracking-wide\">Guests</label>\n          <button\n            data-testid=\"booking-guests\"\n            data-value={String(guests)}\n            type=\"button\"\n            onClick={() => setGuestDropdownOpen(!guestDropdownOpen)}\n            className=\"w-full flex items-center justify-between text-sm text-text bg-transparent outline-none mt-0.5 cursor-pointer\"\n          >\n            <span>{guests} {guests === 1 ? 'guest' : 'guests'}</span>\n            <ChevronDown size={16} className={`transition-transform ${guestDropdownOpen ? 'rotate-180' : ''}`} />\n          </button>\n          {guestDropdownOpen && (\n            <div data-testid=\"booking-guests-dropdown\" className=\"absolute left-0 right-0 top-full mt-1 bg-bg border border-border rounded-lg shadow-lg z-50 max-h-48 overflow-y-auto\">\n              {Array.from({ length: property.max_guests }, (_, i) => i + 1).map((n) => (\n                <button\n                  key={n}\n                  data-testid={`guest-option-${n}`}\n                  type=\"button\"\n                  onClick={() => { setGuests(n); setGuestDropdownOpen(false) }}\n                  className={`w-full text-left px-3 py-2 text-sm cursor-pointer transition-colors\n                    ${guests === n ? 'bg-bg-secondary font-semibold text-text' : 'text-text hover:bg-bg-secondary'}\n                  `}\n                >\n                  {n} {n === 1 ? 'guest' : 'guests'}\n                </button>\n              ))}\n            </div>\n          )}\n        </div>\n      </div>\n\n      {calendarOpen && (\n        <div className=\"mb-4 border border-border rounded-xl p-4 bg-bg shadow-sm\">\n          <div className=\"mb-3\">\n            <h3 className=\"text-base font-semibold text-text\">Select dates</h3>\n            <p className=\"text-xs text-text-secondary\">Add your travel dates for exact pricing</p>\n          </div>\n          <div className=\"flex items-center justify-between mb-2\">\n            <button\n              onClick={handlePrevMonth}\n              className=\"p-1 rounded-full hover:bg-bg-secondary cursor-pointer\"\n            >\n              <ChevronLeft size={20} />\n            </button>\n            <div />\n            <button\n              onClick={handleNextMonth}\n              className=\"p-1 rounded-full hover:bg-bg-secondary cursor-pointer\"\n            >\n              <ChevronRight size={20} />\n            </button>\n          </div>\n          <div className=\"grid grid-cols-2 gap-6\">\n            <CalendarMonth\n              year={calYear}\n              month={calMonth}\n              todayStr={todayStr}\n              bookedRanges={bookedRanges}\n              checkIn={checkIn}\n              checkOut={checkOut}\n              onSelectDate={handleSelectDate}\n            />\n            <CalendarMonth\n              year={nextYear}\n              month={nextMonth}\n              todayStr={todayStr}\n              bookedRanges={bookedRanges}\n              checkIn={checkIn}\n              checkOut={checkOut}\n              onSelectDate={handleSelectDate}\n            />\n          </div>\n          <div className=\"flex items-center justify-end gap-3 mt-4 pt-3 border-t border-border\">\n            <button\n              onClick={() => { setCheckIn(''); setCheckOut('') }}\n              className=\"text-sm font-semibold text-text underline hover:no-underline cursor-pointer\"\n            >\n              Clear dates\n            </button>\n            <button\n              onClick={() => setCalendarOpen(false)}\n              className=\"text-sm font-semibold text-white bg-text rounded-lg px-4 py-2 hover:opacity-90 cursor-pointer\"\n            >\n              Close\n            </button>\n          </div>\n        </div>\n      )}\n\n      {nights > 0 && (\n        <div data-testid=\"price-breakdown\" className=\"mb-4 space-y-2 text-sm\">\n          <div className=\"flex justify-between text-text-secondary\">\n            <span className=\"underline\">${Number(property.price_per_night).toFixed(0)} x {nights} {nights === 1 ? 'night' : 'nights'}</span>\n            <span>${nightlyTotal.toFixed(0)}</span>\n          </div>\n          <div className=\"flex justify-between text-text-secondary\">\n            <span className=\"underline\">Cleaning fee</span>\n            <span>${cleaningFee.toFixed(0)}</span>\n          </div>\n          <div className=\"flex justify-between font-semibold text-text pt-3 border-t border-border\">\n            <span>Total</span>\n            <span>${total.toFixed(0)}</span>\n          </div>\n        </div>\n      )}\n\n      {isOwnProperty ? (\n        <p data-testid=\"own-property-message\" className=\"text-center text-text-secondary text-sm mb-2\">\n          You cannot book your own property\n        </p>\n      ) : !currentUser ? (\n        <button\n          data-testid=\"booking-login-prompt\"\n          className=\"w-full py-3 rounded-lg bg-gradient-to-r from-primary to-[#E61E4D] text-white font-semibold hover:opacity-95 transition-opacity cursor-pointer text-base\"\n          onClick={() => navigate('/login')}\n        >\n          Log in to reserve\n        </button>\n      ) : (\n        <button\n          data-testid=\"reserve-button\"\n          className=\"w-full py-3 rounded-lg bg-gradient-to-r from-primary to-[#E61E4D] text-white font-semibold hover:opacity-95 transition-opacity disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer text-base\"\n          disabled={!canReserve}\n          onClick={handleReserve}\n        >\n          {loading ? 'Reserving...' : 'Reserve'}\n        </button>\n      )}\n\n      {!checkIn && !checkOut && currentUser && !isOwnProperty && (\n        <p className=\"text-center text-text-secondary text-xs mt-3\">You won't be charged yet</p>\n      )}\n\n      {error && (\n        <p data-testid=\"booking-error\" className=\"text-error text-sm mt-2 text-center\">{error}</p>\n      )}\n\n      {success && (\n        <p data-testid=\"booking-success\" className=\"text-success text-sm mt-2 text-center font-semibold\">\n          Booking confirmed! Redirecting...\n        </p>\n      )}\n    </div>\n  )\n}\n","numLines":416,"startLine":1,"totalLines":416}}}
