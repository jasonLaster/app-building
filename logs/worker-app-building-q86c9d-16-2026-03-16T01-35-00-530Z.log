[2026-03-16T00:26:06.366Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K1TumSMerWAmnnu2DFbnKa","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test'\n     2→import { truncateAndSeed } from '../scripts/seed-db'\n     3→\n     4→test.beforeAll(async () => {\n     5→  const dbUrl = process.env.DATABASE_URL\n     6→  if (dbUrl) {\n     7→    await truncateAndSeed(dbUrl)\n     8→  }\n     9→})\n    10→\n    11→// b1111111: Loft, $150/night, $75 cleaning, 4 max guests, host: Sarah (a1111111)\n    12→const PROPERTY_LOFT = 'b1111111-1111-1111-1111-111111111111'\n    13→// b3333333: Cabin, $200/night, $50 cleaning, 6 max guests, host: Mike (a2222222)\n    14→const PROPERTY_CABIN = 'b3333333-3333-3333-3333-333333333333'\n    15→// Guest user: Emma Wilson (a3333333)\n    16→const GUEST_EMAIL = 'emma@example.com'\n    17→// Host user: Sarah Chen (a1111111) — owns b1111111\n    18→const HOST_EMAIL = 'sarah@example.com'\n    19→const EMMA_ID = 'a3333333-3333-3333-3333-333333333333'\n    20→\n    21→async function loginAs(page: import('@playwright/test').Page, email: string) {\n    22→  await page.goto('/login')\n    23→  await page.getByTestId('login-email-input').fill(email)\n    24→  await page.getByTestId('login-submit-button').click()\n    25→  await expect(page).toHaveURL('/', { timeout: 30000 })\n    26→}\n    27→\n    28→async function deleteAllBookings(page: import('@playwright/test').Page, guestId: string) {\n    29→  const res = await page.request.get(`/api/bookings?guest_id=${guestId}`)\n    30→  const bookings = await res.json()\n    31→  for (const booking of bookings) {\n    32→    await page.request.put(`/api/bookings/${booking.id}`, {\n    33→      data: { status: 'cancelled' },\n    34→    })\n    35→  }\n    36→}\n    37→\n    38→test.describe('Property Detail - BookingCard', () => {\n    39→  test.beforeEach(async ({ request }) => {\n    40→    // Clean up any non-seed bookings created by Emma\n    41→    const res = await request.get(`/api/bookings?guest_id=${EMMA_ID}`)\n    42→    if (res.ok()) {\n    43→      const bookings = await res.json()\n    44→      const seedBookingIds = [\n    45→        'e1111111-1111-1111-1111-111111111111',\n    46→        'e2222222-2222-2222-2222-222222222222',\n    47→        'e3333333-3333-3333-3333-333333333333',\n    48→        'e4444444-4444-4444-4444-444444444444',\n    49→        'e5555555-5555-5555-5555-555555555555',\n    50→        'e6666666-6666-6666-6666-666666666666',\n    51→      ]\n    52→      for (const booking of bookings) {\n    53→        if (!seedBookingIds.includes(booking.id)) {\n    54→          await request.put(`/api/bookings/${booking.id}`, {\n    55→            data: { status: 'cancelled' },\n    56→          })\n    57→        }\n    58→      }\n    59→    }\n    60→  })\n    61→\n    62→  test('Booking card displays price per night', async ({ page }) => {\n    63→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n    64→\n    65→    const card = page.getByTestId('booking-card')\n    66→    await expect(card).toBeVisible({ timeout: 30000 })\n    67→\n    68→    // $150 / night\n    69→    await expect(card).toContainText('$150')\n    70→    await expect(card).toContainText('/ night')\n    71→  })\n    72→\n    73→  test('Booking card displays check-in and check-out date pickers', async ({ page }) => {\n    74→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n    75→\n    76→    const card = page.getByTestId('booking-card')\n    77→    await expect(card).toBeVisible({ timeout: 30000 })\n    78→\n    79→    const checkin = page.getByTestId('booking-checkin')\n    80→    const checkout = page.getByTestId('booking-checkout')\n    81→\n    82→    await expect(checkin).toBeVisible()\n    83→    await expect(checkout).toBeVisible()\n    84→\n    85→    // Both should be date inputs and initially empty\n    86→    await expect(checkin).toHaveAttribute('type', 'date')\n    87→    await expect(checkout).toHaveAttribute('type', 'date')\n    88→    await expect(checkin).toHaveValue('')\n    89→    await expect(checkout).toHaveValue('')\n    90→  })\n    91→\n    92→  test('Booking card displays guest count selector', async ({ page }) => {\n    93→    // b3333333: max_guests = 6\n    94→    await page.goto(`/properties/${PROPERTY_CABIN}`)\n    95→\n    96→    const card = page.getByTestId('booking-card')\n    97→    await expect(card).toBeVisible({ timeout: 30000 })\n    98→\n    99→    const guestsButton = page.getByTestId('booking-guests')\n   100→    await expect(guestsButton).toBeVisible()\n   101→\n   102→    // Open dropdown to see options\n   103→    await guestsButton.click()\n   104→    const dropdown = page.getByTestId('booking-guests-dropdown')\n   105→    await expect(dropdown).toBeVisible()\n   106→\n   107→    // Should have options from 1 to 6\n   108→    const options = dropdown.locator('button')\n   109→    await expect(options).toHaveCount(6)\n   110→\n   111→    // First option should be \"1 guest\"\n   112→    await expect(options.first()).toHaveText('1 guest')\n   113→    // Last option should be \"6 guests\"\n   114→    await expect(options.last()).toHaveText('6 guests')\n   115→\n   116→    // Close dropdown\n   117→    await guestsButton.click()\n   118→  })\n   119→\n   120→  test('Selecting dates and guests shows price breakdown', async ({ page }) => {\n   121→    // b1111111: $150/night, $75 cleaning fee\n   122→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   123→\n   124→    const card = page.getByTestId('booking-card')\n   125→    await expect(card).toBeVisible({ timeout: 30000 })\n   126→\n   127→    // Select check-in and check-out (3 nights)\n   128→    await page.getByTestId('booking-checkin').fill('2026-05-01')\n   129→    await page.getByTestId('booking-checkout').fill('2026-05-04')\n   130→    await page.getByTestId('booking-guests').click()\n   131→    await page.getByTestId('guest-option-2').click()\n   132→\n   133→    // Price breakdown should appear\n   134→    const breakdown = page.getByTestId('price-breakdown')\n   135→    await expect(breakdown).toBeVisible()\n   136→\n   137→    // $150 x 3 nights = $450\n   138→    await expect(breakdown).toContainText('$150 x 3 nights')\n   139→    await expect(breakdown).toContainText('$450')\n   140→\n   141→    // Cleaning fee: $75\n   142→    await expect(breakdown).toContainText('Cleaning fee')\n   143→    await expect(breakdown).toContainText('$75')\n   144→\n   145→    // Total: $525\n   146→    await expect(breakdown).toContainText('Total')\n   147→    await expect(breakdown).toContainText('$525')\n   148→  })\n   149→\n   150→  test('Price breakdown updates when dates change', async ({ page }) => {\n   151→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   152→\n   153→    const card = page.getByTestId('booking-card')\n   154→    await expect(card).toBeVisible({ timeout: 30000 })\n   155→\n   156→    // Initial: 3 nights\n   157→    await page.getByTestId('booking-checkin').fill('2026-05-01')\n   158→    await page.getByTestId('booking-checkout').fill('2026-05-04')\n   159→\n   160→    const breakdown = page.getByTestId('price-breakdown')\n   161→    await expect(breakdown).toContainText('$150 x 3 nights')\n   162→    await expect(breakdown).toContainText('$525')\n   163→\n   164→    // Change to 5 nights\n   165→    await page.getByTestId('booking-checkout').fill('2026-05-06')\n   166→\n   167→    // $150 x 5 nights = $750, Total: $825\n   168→    await expect(breakdown).toContainText('$150 x 5 nights')\n   169→    await expect(breakdown).toContainText('$750')\n   170→    await expect(breakdown).toContainText('$825')\n   171→  })\n   172→\n   173→  test('Reserve button creates a booking when logged in', async ({ page }) => {\n   174→    test.slow()\n   175→    await loginAs(page, GUEST_EMAIL)\n   176→\n   177→    // Clean up any existing bookings for this guest\n   178→    await deleteAllBookings(page, 'a3333333-3333-3333-3333-333333333333')\n   179→\n   180→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   181→\n   182→    const card = page.getByTestId('booking-card')\n   183→    await expect(card).toBeVisible({ timeout: 30000 })\n   184→\n   185→    // Select dates and guests\n   186→    await page.getByTestId('booking-checkin').fill('2026-07-01')\n   187→    await page.getByTestId('booking-checkout').fill('2026-07-04')\n   188→    await page.getByTestId('booking-guests').click()\n   189→    await page.getByTestId('guest-option-2').click()\n   190→\n   191→    // Click Reserve\n   192→    const reserveBtn = page.getByTestId('reserve-button')\n   193→    await expect(reserveBtn).toBeEnabled()\n   194→    await reserveBtn.click()\n   195→\n   196→    // Success message should appear\n   197→    await expect(page.getByTestId('booking-success')).toContainText('Booking confirmed', { timeout: 30000 })\n   198→\n   199→    // Should redirect to /trips\n   200→    await expect(page).toHaveURL('/trips', { timeout: 30000 })\n   201→  })\n   202→\n   203→  test('Reserve button is disabled when dates are not selected', async ({ page }) => {\n   204→    test.slow()\n   205→    await loginAs(page, GUEST_EMAIL)\n   206→\n   207→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   208→\n   209→    const card = page.getByTestId('booking-card')\n   210→    await expect(card).toBeVisible({ timeout: 30000 })\n   211→\n   212→    // No dates selected - reserve button should be disabled\n   213→    const reserveBtn = page.getByTestId('reserve-button')\n   214→    await expect(reserveBtn).toBeVisible()\n   215→    await expect(reserveBtn).toBeDisabled()\n   216→\n   217→    // Should show hint text\n   218→    await expect(card).toContainText('Select dates to book')\n   219→  })\n   220→\n   221→  test('Reserve button prompts login when user is not logged in', async ({ page }) => {\n   222→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   223→\n   224→    const card = page.getByTestId('booking-card')\n   225→    await expect(card).toBeVisible({ timeout: 30000 })\n   226→\n   227→    // Not logged in - should show login prompt button\n   228→    const loginPrompt = page.getByTestId('booking-login-prompt')\n   229→    await expect(loginPrompt).toBeVisible()\n   230→    await expect(loginPrompt).toContainText('Log in to reserve')\n   231→\n   232→    // Click login prompt\n   233→    await loginPrompt.click()\n   234→\n   235→    // Should navigate to login page\n   236→    await expect(page).toHaveURL('/login', { timeout: 30000 })\n   237→  })\n   238→\n   239→  test(\"Reserve button is disabled for host's own property\", async ({ page }) => {\n   240→    test.slow()\n   241→    // Login as Sarah (host of b1111111)\n   242→    await loginAs(page, HOST_EMAIL)\n   243→\n   244→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   245→\n   246→    const card = page.getByTestId('booking-card')\n   247→    await expect(card).toBeVisible({ timeout: 30000 })\n   248→\n   249→    // Should show \"You cannot book your own property\" message\n   250→    const ownMessage = page.getByTestId('own-property-message')\n   251→    await expect(ownMessage).toBeVisible()\n   252→    await expect(ownMessage).toContainText('You cannot book your own property')\n   253→\n   254→    // Reserve button should not be visible (replaced by own-property message)\n   255→    await expect(page.getByTestId('reserve-button')).not.toBeVisible()\n   256→  })\n   257→\n   258→  test('Check-in date picker prevents selecting past dates', async ({ page }) => {\n   259→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   260→\n   261→    const card = page.getByTestId('booking-card')\n   262→    await expect(card).toBeVisible({ timeout: 30000 })\n   263→\n   264→    const checkin = page.getByTestId('booking-checkin')\n   265→\n   266→    // The min attribute should be set to today's date\n   267→    const today = new Date().toISOString().split('T')[0]\n   268→    await expect(checkin).toHaveAttribute('min', today!)\n   269→  })\n   270→\n   271→  test('Check-out date must be after check-in date', async ({ page }) => {\n   272→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   273→\n   274→    const card = page.getByTestId('booking-card')\n   275→    await expect(card).toBeVisible({ timeout: 30000 })\n   276→\n   277→    // Set check-in date\n   278→    await page.getByTestId('booking-checkin').fill('2026-05-01')\n   279→\n   280→    // Check-out min should be set to check-in date or later\n   281→    const checkout = page.getByTestId('booking-checkout')\n   282→    await expect(checkout).toHaveAttribute('min', '2026-05-01')\n   283→  })\n   284→\n   285→  test('Guest count cannot exceed property max_guests', async ({ page }) => {\n   286→    // b1111111: max_guests = 4\n   287→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   288→\n   289→    const card = page.getByTestId('booking-card')\n   290→    await expect(card).toBeVisible({ timeout: 30000 })\n   291→\n   292→    const guestsButton = page.getByTestId('booking-guests')\n   293→    await guestsButton.click()\n   294→    const dropdown = page.getByTestId('booking-guests-dropdown')\n   295→    const options = dropdown.locator('button')\n   296→\n   297→    // Should have exactly 4 options (1-4)\n   298→    await expect(options).toHaveCount(4)\n   299→\n   300→    // Last option value should be \"4\"\n   301→    await expect(options.last()).toHaveText('4 guests')\n   302→\n   303→    // Close dropdown\n   304→    await guestsButton.click()\n   305→  })\n   306→\n   307→  test('Guest count minimum is 1', async ({ page }) => {\n   308→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   309→\n   310→    const card = page.getByTestId('booking-card')\n   311→    await expect(card).toBeVisible({ timeout: 30000 })\n   312→\n   313→    const guestsButton = page.getByTestId('booking-guests')\n   314→\n   315→    // Default display should show \"1 guest\"\n   316→    await expect(guestsButton).toContainText('1 guest')\n   317→    await expect(guestsButton).toHaveAttribute('data-value', '1')\n   318→\n   319→    // Open dropdown to verify first option\n   320→    await guestsButton.click()\n   321→    const dropdown = page.getByTestId('booking-guests-dropdown')\n   322→    const options = dropdown.locator('button')\n   323→    await expect(options.first()).toHaveText('1 guest')\n   324→\n   325→    // Close dropdown\n   326→    await guestsButton.click()\n   327→  })\n   328→\n   329→  test('Reserve button shows error for unavailable dates', async ({ page }) => {\n   330→    test.slow()\n   331→    await loginAs(page, GUEST_EMAIL)\n   332→\n   333→    // b2222222 has a confirmed booking for 2026-04-01 to 2026-04-07 (by Alex)\n   334→    await page.goto('/properties/b2222222-2222-2222-2222-222222222222')\n   335→\n   336→    const card = page.getByTestId('booking-card')\n   337→    await expect(card).toBeVisible({ timeout: 30000 })\n   338→\n   339→    // Select overlapping dates\n   340→    await page.getByTestId('booking-checkin').fill('2026-04-02')\n   341→    await page.getByTestId('booking-checkout').fill('2026-04-06')\n   342→    await page.getByTestId('booking-guests').click()\n   343→    await page.getByTestId('guest-option-2').click()\n   344→\n   345→    // Click Reserve\n   346→    const reserveBtn = page.getByTestId('reserve-button')\n   347→    await expect(reserveBtn).toBeEnabled()\n   348→    await reserveBtn.click()\n   349→\n   350→    // Should show error about unavailable dates\n   351→    const errorMsg = page.getByTestId('booking-error')\n   352→    await expect(errorMsg).toBeVisible({ timeout: 30000 })\n   353→    await expect(errorMsg).toContainText('not available')\n   354→  })\n   355→\n   356→  test('Booking card date pickers and guest selector are functional on repeated use', async ({ page }) => {\n   357→    // b1111111: $150/night, $75 cleaning fee, 4 max guests\n   358→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   359→\n   360→    const card = page.getByTestId('booking-card')\n   361→    await expect(card).toBeVisible({ timeout: 30000 })\n   362→\n   363→    const checkin = page.getByTestId('booking-checkin')\n   364→    const checkout = page.getByTestId('booking-checkout')\n   365→    const guestsSelect = page.getByTestId('booking-guests')\n   366→    const breakdown = page.getByTestId('price-breakdown')\n   367→\n   368→    // First selection: 2026-05-01 to 2026-05-04 (3 nights), 2 guests\n   369→    await checkin.fill('2026-05-01')\n   370→    await checkout.fill('2026-05-04')\n   371→    await guestsSelect.click()\n   372→    await page.getByTestId('guest-option-2').click()\n   373→\n   374→    // $150 x 3 = $450 + $75 = $525\n   375→    await expect(breakdown).toContainText('$150 x 3 nights')\n   376→    await expect(breakdown).toContainText('$525')\n   377→\n   378→    // Change dates: 2026-06-01 to 2026-06-05 (4 nights)\n   379→    await checkin.fill('2026-06-01')\n   380→    await checkout.fill('2026-06-05')\n   381→\n   382→    // $150 x 4 = $600 + $75 = $675\n   383→    await expect(breakdown).toContainText('$150 x 4 nights')\n   384→    await expect(breakdown).toContainText('$675')\n   385→\n   386→    // Change guests: 2 -> 4 -> 2\n   387→    await guestsSelect.click()\n   388→    await page.getByTestId('guest-option-4').click()\n   389→    await expect(guestsSelect).toHaveAttribute('data-value', '4')\n   390→    await guestsSelect.click()\n   391→    await page.getByTestId('guest-option-2').click()\n   392→    await expect(guestsSelect).toHaveAttribute('data-value', '2')\n   393→\n   394→    // Price breakdown should still be correct after guest changes\n   395→    await expect(breakdown).toContainText('$150 x 4 nights')\n   396→    await expect(breakdown).toContainText('$675')\n   397→\n   398→    // Final state verification\n   399→    await expect(checkin).toHaveValue('2026-06-01')\n   400→    await expect(checkout).toHaveValue('2026-06-05')\n   401→    await expect(guestsSelect).toHaveAttribute('data-value', '2')\n   402→  })\n   403→\n   404→  test('Booking card is sticky on desktop viewport', async ({ page }) => {\n   405→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   406→\n   407→    const card = page.getByTestId('booking-card')\n   408→    await expect(card).toBeVisible({ timeout: 30000 })\n   409→\n   410→    // Verify the card has sticky positioning\n   411→    const position = await card.evaluate((el) => {\n   412→      return window.getComputedStyle(el).position\n   413→    })\n   414→    expect(position).toBe('sticky')\n   415→\n   416→    // Scroll down the page\n   417→    await page.evaluate(() => window.scrollTo(0, 1000))\n   418→\n   419→    // Card should still be visible after scrolling\n   420→    await expect(card).toBeVisible()\n   421→    await expect(card).toBeInViewport()\n   422→  })\n   423→})\n   424→"}]},"parent_tool_use_id":null,"session_id":"bd78e25b-7fce-4bae-a91a-1f392b40d970","uuid":"ca8afce5-92e2-4584-9679-4bd62720b8d7","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/tests/booking-card.spec.ts","content":"import { test, expect } from '@playwright/test'\nimport { truncateAndSeed } from '../scripts/seed-db'\n\ntest.beforeAll(async () => {\n  const dbUrl = process.env.DATABASE_URL\n  if (dbUrl) {\n    await truncateAndSeed(dbUrl)\n  }\n})\n\n// b1111111: Loft, $150/night, $75 cleaning, 4 max guests, host: Sarah (a1111111)\nconst PROPERTY_LOFT = 'b1111111-1111-1111-1111-111111111111'\n// b3333333: Cabin, $200/night, $50 cleaning, 6 max guests, host: Mike (a2222222)\nconst PROPERTY_CABIN = 'b3333333-3333-3333-3333-333333333333'\n// Guest user: Emma Wilson (a3333333)\nconst GUEST_EMAIL = 'emma@example.com'\n// Host user: Sarah Chen (a1111111) — owns b1111111\nconst HOST_EMAIL = 'sarah@example.com'\nconst EMMA_ID = 'a3333333-3333-3333-3333-333333333333'\n\nasync function loginAs(page: import('@playwright/test').Page, email: string) {\n  await page.goto('/login')\n  await page.getByTestId('login-email-input').fill(email)\n  await page.getByTestId('login-submit-button').click()\n  await expect(page).toHaveURL('/', { timeout: 30000 })\n}\n\nasync function deleteAllBookings(page: import('@playwright/test').Page, guestId: string) {\n  const res = await page.request.get(`/api/bookings?guest_id=${guestId}`)\n  const bookings = await res.json()\n  for (const booking of bookings) {\n    await page.request.put(`/api/bookings/${booking.id}`, {\n      data: { status: 'cancelled' },\n    })\n  }\n}\n\ntest.describe('Property Detail - BookingCard', () => {\n  test.beforeEach(async ({ request }) => {\n    // Clean up any non-seed bookings created by Emma\n    const res = await request.get(`/api/bookings?guest_id=${EMMA_ID}`)\n    if (res.ok()) {\n      const bookings = await res.json()\n      const seedBookingIds = [\n        'e1111111-1111-1111-1111-111111111111',\n        'e2222222-2222-2222-2222-222222222222',\n        'e3333333-3333-3333-3333-333333333333',\n        'e4444444-4444-4444-4444-444444444444',\n        'e5555555-5555-5555-5555-555555555555',\n        'e6666666-6666-6666-6666-666666666666',\n      ]\n      for (const booking of bookings) {\n        if (!seedBookingIds.includes(booking.id)) {\n          await request.put(`/api/bookings/${booking.id}`, {\n            data: { status: 'cancelled' },\n          })\n        }\n      }\n    }\n  })\n\n  test('Booking card displays price per night', async ({ page }) => {\n    await page.goto(`/properties/${PROPERTY_LOFT}`)\n\n    const card = page.getByTestId('booking-card')\n    await expect(card).toBeVisible({ timeout: 30000 })\n\n    // $150 / night\n    await expect(card).toContainText('$150')\n    await expect(card).toContainText('/ night')\n  })\n\n  test('Booking card displays check-in and check-out date pickers', async ({ page }) => {\n    await page.goto(`/properties/${PROPERTY_LOFT}`)\n\n    const card = page.getByTestId('booking-card')\n    await expect(card).toBeVisible({ timeout: 30000 })\n\n    const checkin = page.getByTestId('booking-checkin')\n    const checkout = page.getByTestId('booking-checkout')\n\n    await expect(checkin).toBeVisible()\n    await expect(checkout).toBeVisible()\n\n    // Both should be date inputs and initially empty\n    await expect(checkin).toHaveAttribute('type', 'date')\n    await expect(checkout).toHaveAttribute('type', 'date')\n    await expect(checkin).toHaveValue('')\n    await expect(checkout).toHaveValue('')\n  })\n\n  test('Booking card displays guest count selector', async ({ page }) => {\n    // b3333333: max_guests = 6\n    await page.goto(`/properties/${PROPERTY_CABIN}`)\n\n    const card = page.getByTestId('booking-card')\n    await expect(card).toBeVisible({ timeout: 30000 })\n\n    const guestsButton = page.getByTestId('booking-guests')\n    await expect(guestsButton).toBeVisible()\n\n    // Open dropdown to see options\n    await guestsButton.click()\n    const dropdown = page.getByTestId('booking-guests-dropdown')\n    await expect(dropdown).toBeVisible()\n\n    // Should have options from 1 to 6\n    const options = dropdown.locator('button')\n    await expect(options).toHaveCount(6)\n\n    // First option should be \"1 guest\"\n    await expect(options.first()).toHaveText('1 guest')\n    // Last option should be \"6 guests\"\n    await expect(options.last()).toHaveText('6 guests')\n\n    // Close dropdown\n    await guestsButton.click()\n  })\n\n  test('Selecting dates and guests shows price breakdown', async ({ page }) => {\n    // b1111111: $150/night, $75 cleaning fee\n    await page.goto(`/properties/${PROPERTY_LOFT}`)\n\n    const card = page.getByTestId('booking-card')\n    await expect(card).toBeVisible({ timeout: 30000 })\n\n    // Select check-in and check-out (3 nights)\n    await page.getByTestId('booking-checkin').fill('2026-05-01')\n    await page.getByTestId('booking-checkout').fill('2026-05-04')\n    await page.getByTestId('booking-guests').click()\n    await page.getByTestId('guest-option-2').click()\n\n    // Price breakdown should appear\n    const breakdown = page.getByTestId('price-breakdown')\n    await expect(breakdown).toBeVisible()\n\n    // $150 x 3 nights = $450\n    await expect(breakdown).toContainText('$150 x 3 nights')\n    await expect(breakdown).toContainText('$450')\n\n    // Cleaning fee: $75\n    await expect(breakdown).toContainText('Cleaning fee')\n    await expect(breakdown).toContainText('$75')\n\n    // Total: $525\n    await expect(breakdown).toContainText('Total')\n    await expect(breakdown).toContainText('$525')\n  })\n\n  test('Price breakdown updates when dates change', async ({ page }) => {\n    await page.goto(`/properties/${PROPERTY_LOFT}`)\n\n    const card = page.getByTestId('booking-card')\n    await expect(card).toBeVisible({ timeout: 30000 })\n\n    // Initial: 3 nights\n    await page.getByTestId('booking-checkin').fill('2026-05-01')\n    await page.getByTestId('booking-checkout').fill('2026-05-04')\n\n    const breakdown = page.getByTestId('price-breakdown')\n    await expect(breakdown).toContainText('$150 x 3 nights')\n    await expect(breakdown).toContainText('$525')\n\n    // Change to 5 nights\n    await page.getByTestId('booking-checkout').fill('2026-05-06')\n\n    // $150 x 5 nights = $750, Total: $825\n    await expect(breakdown).toContainText('$150 x 5 nights')\n    await expect(breakdown).toContainText('$750')\n    await expect(breakdown).toContainText('$825')\n  })\n\n  test('Reserve button creates a booking when logged in', async ({ page }) => {\n    test.slow()\n    await loginAs(page, GUEST_EMAIL)\n\n    // Clean up any existing bookings for this guest\n    await deleteAllBookings(page, 'a3333333-3333-3333-3333-333333333333')\n\n    await page.goto(`/properties/${PROPERTY_LOFT}`)\n\n    const card = page.getByTestId('booking-card')\n    await expect(card).toBeVisible({ timeout: 30000 })\n\n    // Select dates and guests\n    await page.getByTestId('booking-checkin').fill('2026-07-01')\n    await page.getByTestId('booking-checkout').fill('2026-07-04')\n    await page.getByTestId('booking-guests').click()\n    await page.getByTestId('guest-option-2').click()\n\n    // Click Reserve\n    const reserveBtn = page.getByTestId('reserve-button')\n    await expect(reserveBtn).toBeEnabled()\n    await reserveBtn.click()\n\n    // Success message should appear\n    await expect(page.getByTestId('booking-success')).toContainText('Booking confirmed', { timeout: 30000 })\n\n    // Should redirect to /trips\n    await expect(page).toHaveURL('/trips', { timeout: 30000 })\n  })\n\n  test('Reserve button is disabled when dates are not selected', async ({ page }) => {\n    test.slow()\n    await loginAs(page, GUEST_EMAIL)\n\n    await page.goto(`/properties/${PROPERTY_LOFT}`)\n\n    const card = page.getByTestId('booking-card')\n    await expect(card).toBeVisible({ timeout: 30000 })\n\n    // No dates selected - reserve button should be disabled\n    const reserveBtn = page.getByTestId('reserve-button')\n    await expect(reserveBtn).toBeVisible()\n    await expect(reserveBtn).toBeDisabled()\n\n    // Should show hint text\n    await expect(card).toContainText('Select dates to book')\n  })\n\n  test('Reserve button prompts login when user is not logged in', async ({ page }) => {\n    await page.goto(`/properties/${PROPERTY_LOFT}`)\n\n    const card = page.getByTestId('booking-card')\n    await expect(card).toBeVisible({ timeout: 30000 })\n\n    // Not logged in - should show login prompt button\n    const loginPrompt = page.getByTestId('booking-login-prompt')\n    await expect(loginPrompt).toBeVisible()\n    await expect(loginPrompt).toContainText('Log in to reserve')\n\n    // Click login prompt\n    await loginPrompt.click()\n\n    // Should navigate to login page\n    await expect(page).toHaveURL('/login', { timeout: 30000 })\n  })\n\n  test(\"Reserve button is disabled for host's own property\", async ({ page }) => {\n    test.slow()\n    // Login as Sarah (host of b1111111)\n    await loginAs(page, HOST_EMAIL)\n\n    await page.goto(`/properties/${PROPERTY_LOFT}`)\n\n    const card = page.getByTestId('booking-card')\n    await expect(card).toBeVisible({ timeout: 30000 })\n\n    // Should show \"You cannot book your own property\" message\n    const ownMessage = page.getByTestId('own-property-message')\n    await expect(ownMessage).toBeVisible()\n    await expect(ownMessage).toContainText('You cannot book your own property')\n\n    // Reserve button should not be visible (replaced by own-property message)\n    await expect(page.getByTestId('reserve-button')).not.toBeVisible()\n  })\n\n  test('Check-in date picker prevents selecting past dates', async ({ page }) => {\n    await page.goto(`/properties/${PROPERTY_LOFT}`)\n\n    const card = page.getByTestId('booking-card')\n    await expect(card).toBeVisible({ timeout: 30000 })\n\n    const checkin = page.getByTestId('booking-checkin')\n\n    // The min attribute should be set to today's date\n    const today = new Date().toISOString().split('T')[0]\n    await expect(checkin).toHaveAttribute('min', today!)\n  })\n\n  test('Check-out date must be after check-in date', async ({ page }) => {\n    await page.goto(`/properties/${PROPERTY_LOFT}`)\n\n    const card = page.getByTestId('booking-card')\n    await expect(card).toBeVisible({ timeout: 30000 })\n\n    // Set check-in date\n    await page.getByTestId('booking-checkin').fill('2026-05-01')\n\n    // Check-out min should be set to check-in date or later\n    const checkout = page.getByTestId('booking-checkout')\n    await expect(checkout).toHaveAttribute('min', '2026-05-01')\n  })\n\n  test('Guest count cannot exceed property max_guests', async ({ page }) => {\n    // b1111111: max_guests = 4\n    await page.goto(`/properties/${PROPERTY_LOFT}`)\n\n    const card = page.getByTestId('booking-card')\n    await expect(card).toBeVisible({ timeout: 30000 })\n\n    const guestsButton = page.getByTestId('booking-guests')\n    await guestsButton.click()\n    const dropdown = page.getByTestId('booking-guests-dropdown')\n    const options = dropdown.locator('button')\n\n    // Should have exactly 4 options (1-4)\n    await expect(options).toHaveCount(4)\n\n    // Last option value should be \"4\"\n    await expect(options.last()).toHaveText('4 guests')\n\n    // Close dropdown\n    await guestsButton.click()\n  })\n\n  test('Guest count minimum is 1', async ({ page }) => {\n    await page.goto(`/properties/${PROPERTY_LOFT}`)\n\n    const card = page.getByTestId('booking-card')\n    await expect(card).toBeVisible({ timeout: 30000 })\n\n    const guestsButton = page.getByTestId('booking-guests')\n\n    // Default display should show \"1 guest\"\n    await expect(guestsButton).toContainText('1 guest')\n    await expect(guestsButton).toHaveAttribute('data-value', '1')\n\n    // Open dropdown to verify first option\n    await guestsButton.click()\n    const dropdown = page.getByTestId('booking-guests-dropdown')\n    const options = dropdown.locator('button')\n    await expect(options.first()).toHaveText('1 guest')\n\n    // Close dropdown\n    await guestsButton.click()\n  })\n\n  test('Reserve button shows error for unavailable dates', async ({ page }) => {\n    test.slow()\n    await loginAs(page, GUEST_EMAIL)\n\n    // b2222222 has a confirmed booking for 2026-04-01 to 2026-04-07 (by Alex)\n    await page.goto('/properties/b2222222-2222-2222-2222-222222222222')\n\n    const card = page.getByTestId('booking-card')\n    await expect(card).toBeVisible({ timeout: 30000 })\n\n    // Select overlapping dates\n    await page.getByTestId('booking-checkin').fill('2026-04-02')\n    await page.getByTestId('booking-checkout').fill('2026-04-06')\n    await page.getByTestId('booking-guests').click()\n    await page.getByTestId('guest-option-2').click()\n\n    // Click Reserve\n    const reserveBtn = page.getByTestId('reserve-button')\n    await expect(reserveBtn).toBeEnabled()\n    await reserveBtn.click()\n\n    // Should show error about unavailable dates\n    const errorMsg = page.getByTestId('booking-error')\n    await expect(errorMsg).toBeVisible({ timeout: 30000 })\n    await expect(errorMsg).toContainText('not available')\n  })\n\n  test('Booking card date pickers and guest selector are functional on repeated use', async ({ page }) => {\n    // b1111111: $150/night, $75 cleaning fee, 4 max guests\n    await page.goto(`/properties/${PROPERTY_LOFT}`)\n\n    const card = page.getByTestId('booking-card')\n    await expect(card).toBeVisible({ timeout: 30000 })\n\n    const checkin = page.getByTestId('booking-checkin')\n    const checkout = page.getByTestId('booking-checkout')\n    const guestsSelect = page.getByTestId('booking-guests')\n    const breakdown = page.getByTestId('price-breakdown')\n\n    // First selection: 2026-05-01 to 2026-05-04 (3 nights), 2 guests\n    await checkin.fill('2026-05-01')\n    await checkout.fill('2026-05-04')\n    await guestsSelect.click()\n    await page.getByTestId('guest-option-2').click()\n\n    // $150 x 3 = $450 + $75 = $525\n    await expect(breakdown).toContainText('$150 x 3 nights')\n    await expect(breakdown).toContainText('$525')\n\n    // Change dates: 2026-06-01 to 2026-06-05 (4 nights)\n    await checkin.fill('2026-06-01')\n    await checkout.fill('2026-06-05')\n\n    // $150 x 4 = $600 + $75 = $675\n    await expect(breakdown).toContainText('$150 x 4 nights')\n    await expect(breakdown).toContainText('$675')\n\n    // Change guests: 2 -> 4 -> 2\n    await guestsSelect.click()\n    await page.getByTestId('guest-option-4').click()\n    await expect(guestsSelect).toHaveAttribute('data-value', '4')\n    await guestsSelect.click()\n    await page.getByTestId('guest-option-2').click()\n    await expect(guestsSelect).toHaveAttribute('data-value', '2')\n\n    // Price breakdown should still be correct after guest changes\n    await expect(breakdown).toContainText('$150 x 4 nights')\n    await expect(breakdown).toContainText('$675')\n\n    // Final state verification\n    await expect(checkin).toHaveValue('2026-06-01')\n    await expect(checkout).toHaveValue('2026-06-05')\n    await expect(guestsSelect).toHaveAttribute('data-value', '2')\n  })\n\n  test('Booking card is sticky on desktop viewport', async ({ page }) => {\n    await page.goto(`/properties/${PROPERTY_LOFT}`)\n\n    const card = page.getByTestId('booking-card')\n    await expect(card).toBeVisible({ timeout: 30000 })\n\n    // Verify the card has sticky positioning\n    const position = await card.evaluate((el) => {\n      return window.getComputedStyle(el).position\n    })\n    expect(position).toBe('sticky')\n\n    // Scroll down the page\n    await page.evaluate(() => window.scrollTo(0, 1000))\n\n    // Card should still be visible after scrolling\n    await expect(card).toBeVisible()\n    await expect(card).toBeInViewport()\n  })\n})\n","numLines":424,"startLine":1,"totalLines":424}}}
