y properties passed in by the parent.\nfor (const key in environment) {\n  process.env[key] = environment[key]\n}\nconst lambdaFunc = await import(entryFilePath)\nconst invocationResult = /** @type {HandlerResponse} */ (\n  await lambdaLocal.execute({\n    clientContext,\n    event,\n    lambdaFunc,\n    region: 'dev',\n    timeoutMs,\n    verboseLevel: 3,\n  })\n)\n\n/**\n * If the body is a stream, read it fully into a string/buffer.\n * This avoids the TCP streaming approach which has race conditions in dev.\n */\nasync function consumeStreamBody(invocationResult) {\n  if (!invocationResult || !isStream(invocationResult.body)) {\n    return\n  }\n\n  const { body } = invocationResult\n\n  const shouldNotHaveABody = nullBodyStatus.has(invocationResult.statusCode)\n  if (shouldNotHaveABody) {\n    delete invocationResult.body\n    return\n  }\n\n  // Read the entire stream into a buffer\n  const chunks = []\n  await new Promise((resolve, reject) => {\n    body.on('data', (chunk) => chunks.push(chunk))\n    body.on('end', () => resolve(undefined))\n    body.on('error', reject)\n    // Resume the stream in case it's paused\n    body.resume()\n  })\n\n  const buffer = Buffer.concat(chunks)\n  invocationResult.body = buffer.toString('utf-8')\n}\n\nawait consumeStreamBody(invocationResult)\n\nif (parentPort) {\n  /** @type {WorkerResult} */\n  const message = { ...invocationResult }\n\n  parentPort.postMessage(message)\n}\n","structuredPatch":[{"oldStart":26,"oldLines":6,"newStart":26,"newLines":8,"lines":["   throw new Error(`Do not import \"${import.meta.url}\" in the main thread.`)"," }"," ","+console.error('[PATCHED WORKER] Loading patched worker.js')","+"," sourceMapSupport.install()"," "," lambdaLocal.getLogger().level = 'alert'"]}],"userModified":false,"replaceAll":false}}
