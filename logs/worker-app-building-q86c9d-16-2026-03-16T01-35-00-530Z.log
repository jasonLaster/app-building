StreamPortForStreamingResponse(invocationResult)\n   100→\n   101→if (parentPort) {\n   102→  /** @type {WorkerResult} */\n   103→  const message = { ...invocationResult, streamPort }\n   104→\n   105→  parentPort.postMessage(message)\n   106→}\n   107→"}]},"parent_tool_use_id":null,"session_id":"bd78e25b-7fce-4bae-a91a-1f392b40d970","uuid":"dc492562-ddc3-44f7-a52b-98f6ef48805d","tool_use_result":{"type":"text","file":{"filePath":"/usr/local/lib/node_modules/netlify-cli/node_modules/@netlify/functions-dev/dist/worker.js","content":"// @ts-check\n// This is a JavaScript file because we need to locate it at runtime using the\n// `Worker` API and using a `.ts` complicates things. To make it type-safe,\n// we use JSDoc annotations.\nimport { createServer } from 'node:net'\nimport process from 'node:process'\nimport { isMainThread, workerData, parentPort } from 'node:worker_threads'\n\nimport { isStream } from 'is-stream'\nimport lambdaLocal from 'lambda-local'\nimport sourceMapSupport from 'source-map-support'\n\n// https://github.com/nodejs/undici/blob/a36e299d544863c5ade17d4090181be894366024/lib/web/fetch/constants.js#L6\nconst nullBodyStatus = new Set([101, 204, 205, 304])\n\n/**\n * @typedef HandlerResponse\n * @type {import('../../../src/function/handler_response.js').HandlerResponse}\n */\n\n/**\n * @typedef WorkerResult\n * @type {HandlerResponse & { streamPort?: number }}\n */\n\nif (isMainThread) {\n  throw new Error(`Do not import \"${import.meta.url}\" in the main thread.`)\n}\n\nsourceMapSupport.install()\n\nlambdaLocal.getLogger().level = 'alert'\n\nconst { clientContext, entryFilePath, environment = {}, event, timeoutMs } = workerData\n\n// Injecting into the environment any properties passed in by the parent.\nfor (const key in environment) {\n  process.env[key] = environment[key]\n}\nconst lambdaFunc = await import(entryFilePath)\nconst invocationResult = /** @type {HandlerResponse} */ (\n  await lambdaLocal.execute({\n    clientContext,\n    event,\n    lambdaFunc,\n    region: 'dev',\n    timeoutMs,\n    verboseLevel: 3,\n  })\n)\n\n/**\n * When the result body is a stream and result status code allow to have a body,\n * open up a http server that proxies back to the main thread and resolve with server port.\n * Otherwise, resolve with undefined.\n *\n * @param {HandlerResponse} invocationResult\n * @returns {Promise<number | undefined>}\n */\nasync function getStreamPortForStreamingResponse(invocationResult) {\n  // if we don't have result or result's body is not a stream, we do not need a stream port\n  if (!invocationResult || !isStream(invocationResult.body)) {\n    return undefined\n  }\n\n  const { body } = invocationResult\n\n  delete invocationResult.body\n\n  // For streaming responses, lambda-local always returns a result with body stream.\n  // We need to discard it if result's status code does not allow response to have a body.\n  const shouldNotHaveABody = nullBodyStatus.has(invocationResult.statusCode)\n  if (shouldNotHaveABody) {\n    return undefined\n  }\n\n  // create a server that will proxy the body stream back to the main thread\n  return await new Promise((resolve, reject) => {\n    const server = createServer((socket) => {\n      body.pipe(socket).on('end', () => server.close())\n    })\n    server.on('error', (error) => {\n      reject(error)\n    })\n    server.listen({ port: 0, host: 'localhost' }, () => {\n      const address = server.address()\n\n      /** @type {number | undefined} */\n      let streamPort\n      if (address && typeof address !== 'string') {\n        streamPort = address.port\n      }\n\n      resolve(streamPort)\n    })\n  })\n}\n\nconst streamPort = await getStreamPortForStreamingResponse(invocationResult)\n\nif (parentPort) {\n  /** @type {WorkerResult} */\n  const message = { ...invocationResult, streamPort }\n\n  parentPort.postMessage(message)\n}\n","numLines":107,"startLine":1,"totalLines":107}}}
[2026-03-16T00:49:38.066Z] {"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01VjkvD2oNSZuBpXK5M1kna8","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"Now I see the full flow. The worker:1. Imports the function module2. Runs it via `lambdaLocal.execute`\n3. Checks if the result body is a stream4. If stream, opens a local server and passes the port back\n5. Parent connects to that port to read the streamed response\n\nThe issue: `lambdaLocal.execute` returns the result of the handler. For V2 functions returning `new Response(...)`, lambda-local might transform this into something with a stream body. The `isStream()` check then returns true, the worker opens a local server, and passes the port.\n\nBut the parent side tries to connect to this port and gets ECONNREFUSED. \n\nLooking at the parent side, I'm seeing the worker message handler that receives the stream port and attempts to create a connection to localhost on that port. The parent is listening for the streamPort in the result message and then immediately trying to connect, but something's going wrong with that connection attempt.\n\nI think I've found the issue - the worker creates the server and sends the message with the port, but then the worker thread execution completes and the entire thread shuts down, which closes the server before the parent even gets a chance to connect to it. The parent receives the message with the port number, but by that time the server is already gone.\n\nBut this makes me wonder - if all the V2 functions have this same pattern, wouldn't the whole app be broken? The home page itself loads fine from Vite, so the API failures must be isolated to certain endpoints. Let me look more carefully at what's actually failing here.\n\nThe PropertyDetail component is showing \"Property not found\" as a fallback, which suggests the property data never loaded. If the API call rejected with a 500 error, the Redux slice should be catching that and setting an error message. The slice is set up to fetch the property, parse the response, and reject with a descriptive error if the response isn't ok - so if the server connection is failing, that error should bubble up and display instead of the \"Property not found\" message.\n\nThe real issue is that when `response.json()` fails to parse (because the error response isn't valid JSON), the fetch promise rejects without using `rejectWithValue`, leaving `state.error` as undefined. This causes the component to fall back to showing \"Property not found\" instead of the actual error.\n\nThe root cause is a bug in Netlify Dev V2 where the worker thread exits before the response stream can be fully read. The fix would be to either switch the functions back to V1-style responses, or keep the worker alive long enough for the stream to complete.\n\nDowngrading everything to V1 format would be tedious since it requires changing every function. Instead, I should check if there's a way to force V1 mode through configuration—the runtime version is determined during the build process, so maybe I can override that setting.","signature":""}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1533,"cache_read_input_tokens":129602,"cache_creation":{"ephemeral_5m_input_tokens":1533,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"global"},"context_management":null},"parent_tool_use_id":null,"session_id":"bd78e25b-7fce-4bae-a91a-1f392b40d970","uuid":"c18bef1f-e641-47e5-8da5-63449870e5e6"}
