[2026-03-16T00:35:18.922Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014tze3398StsRDe6WCwzvsL","type":"tool_result","content":"     1→import { useEffect } from 'react'\n     2→import { useParams, useNavigate } from 'react-router-dom'\n     3→import { useSelector, useDispatch } from 'react-redux'\n     4→import { Loader2, Share, Heart } from 'lucide-react'\n     5→import type { RootState, AppDispatch } from '../store'\n     6→import { fetchPropertyDetail, clearPropertyDetail } from '../slices/propertyDetailSlice'\n     7→import ImageGallery from '../components/ImageGallery'\n     8→import PropertyHeader from '../components/PropertyHeader'\n     9→import PropertyInfo from '../components/PropertyInfo'\n    10→import PropertyDescription from '../components/PropertyDescription'\n    11→import AmenitiesList from '../components/AmenitiesList'\n    12→import BookingCard from '../components/BookingCard'\n    13→import ReviewsSection from '../components/ReviewsSection'\n    14→import HostInfoCard from '../components/HostInfoCard'\n    15→\n    16→export default function PropertyDetail() {\n    17→  const { id } = useParams<{ id: string }>()\n    18→  const dispatch = useDispatch<AppDispatch>()\n    19→  const navigate = useNavigate()\n    20→  const { property, loading, error } = useSelector((state: RootState) => state.propertyDetail)\n    21→\n    22→  useEffect(() => {\n    23→    if (id) {\n    24→      dispatch(fetchPropertyDetail(id))\n    25→    }\n    26→    return () => {\n    27→      dispatch(clearPropertyDetail())\n    28→    }\n    29→  }, [dispatch, id])\n    30→\n    31→  if (loading) {\n    32→    return (\n    33→      <div data-testid=\"property-detail-page\" className=\"p-6 max-sm:p-3 max-w-6xl mx-auto flex items-center justify-center min-h-[60vh]\">\n    34→        <Loader2 size={32} className=\"animate-spin text-primary\" />\n    35→      </div>\n    36→    )\n    37→  }\n    38→\n    39→  if (error || !property) {\n    40→    return (\n    41→      <div data-testid=\"property-detail-page\" className=\"p-6 max-sm:p-3 max-w-6xl mx-auto flex flex-col items-center justify-center min-h-[60vh] gap-4\">\n    42→        <p className=\"text-text-secondary\">{error || 'Property not found'}</p>\n    43→        <button\n    44→          className=\"text-primary font-semibold hover:underline cursor-pointer\"\n    45→          onClick={() => navigate('/')}\n    46→        >\n    47→          Back to listings\n    48→        </button>\n    49→      </div>\n    50→    )\n    51→  }\n    52→\n    53→  return (\n    54→    <div data-testid=\"property-detail-page\" className=\"px-6 max-sm:px-3 py-6 max-w-6xl mx-auto\">\n    55→      <div className=\"flex items-center justify-end mb-6\">\n    56→        <div className=\"flex items-center gap-4 shrink-0\">\n    57→          <button className=\"flex items-center gap-1.5 text-sm font-semibold text-text underline hover:no-underline cursor-pointer\">\n    58→            <Share size={16} />\n    59→            Share\n    60→          </button>\n    61→          <button className=\"flex items-center gap-1.5 text-sm font-semibold text-text underline hover:no-underline cursor-pointer\">\n    62→            <Heart size={16} />\n    63→            Save\n    64→          </button>\n    65→        </div>\n    66→      </div>\n    67→\n    68→      <ImageGallery images={property.images || []} />\n    69→\n    70→      <div className=\"mt-8 flex flex-col lg:flex-row gap-12\">\n    71→        <div className=\"flex-1 min-w-0\">\n    72→          <PropertyHeader property={property} />\n    73→          <PropertyInfo property={property} />\n    74→          <PropertyDescription description={property.description} />\n    75→          <AmenitiesList amenities={property.amenities || []} />\n    76→          <ReviewsSection reviews={property.reviews || []} />\n    77→          <HostInfoCard property={property} />\n    78→        </div>\n    79→\n    80→        <div className=\"w-full lg:w-[372px] shrink-0\">\n    81→          <BookingCard property={property} />\n    82→        </div>\n    83→      </div>\n    84→    </div>\n    85→  )\n    86→}\n    87→"}]},"parent_tool_use_id":"toolu_01MRSQ2fy7MpoX2AeMdmmrZo","session_id":"bd78e25b-7fce-4bae-a91a-1f392b40d970","uuid":"c64d9310-d8f9-4d8b-b094-431be9a95082"}
