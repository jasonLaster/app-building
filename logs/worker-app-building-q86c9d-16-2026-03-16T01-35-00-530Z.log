vocationResult?.body)\n    46→console.log('[WORKER DEBUG] invocationResult.body constructor:', invocationResult?.body?.constructor?.name)\n    47→console.log('[WORKER DEBUG] isStream(body):', invocationResult?.body ? isStream(invocationResult.body) : 'no body')\n    48→console.log('[WORKER DEBUG] body.pipe?:', typeof invocationResult?.body?.pipe)\n    49→console.log('[WORKER DEBUG] statusCode:', invocationResult?.statusCode)\n    50→\n    51→async function getStreamPortForStreamingResponse(invocationResult) {\n    52→  if (!invocationResult || !isStream(invocationResult.body)) {\n    53→    console.log('[WORKER DEBUG] NOT streaming')\n    54→    return undefined\n    55→  }\n    56→\n    57→  console.log('[WORKER DEBUG] IS streaming - opening server')\n    58→  const { body } = invocationResult\n    59→  delete invocationResult.body\n    60→\n    61→  const shouldNotHaveABody = nullBodyStatus.has(invocationResult.statusCode)\n    62→  if (shouldNotHaveABody) {\n    63→    return undefined\n    64→  }\n    65→\n    66→  return await new Promise((resolve, reject) => {\n    67→    const server = createServer((socket) => {\n    68→      body.pipe(socket).on('end', () => server.close())\n    69→    })\n    70→    server.on('error', (error) => {\n    71→      console.log('[WORKER DEBUG] Server error:', error.message)\n    72→      reject(error)\n    73→    })\n    74→    server.listen({ port: 0, host: 'localhost' }, () => {\n    75→      const address = server.address()\n    76→      let streamPort\n    77→      if (address && typeof address !== 'string') {\n    78→        streamPort = address.port\n    79→      }\n    80→      console.log('[WORKER DEBUG] Stream server on port:', streamPort)\n    81→      resolve(streamPort)\n    82→    })\n    83→  })\n    84→}\n    85→\n    86→const streamPort = await getStreamPortForStreamingResponse(invocationResult)\n    87→\n    88→console.log('[WORKER DEBUG] Final streamPort:', streamPort)\n    89→console.log('[WORKER DEBUG] Spread result:', JSON.stringify({ ...invocationResult, streamPort }).slice(0, 200))\n    90→\n    91→if (parentPort) {\n    92→  const message = { ...invocationResult, streamPort }\n    93→  parentPort.postMessage(message)\n    94→}\n    95→"}]},"parent_tool_use_id":null,"session_id":"bd78e25b-7fce-4bae-a91a-1f392b40d970","uuid":"c769ace1-6df2-4861-ae2b-dfc7f92bfd66","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/node_modules/netlify-cli/node_modules/@netlify/functions-dev/dist/worker.js","content":"// @ts-check\nimport { createServer } from 'node:net'\nimport process from 'node:process'\nimport { isMainThread, workerData, parentPort } from 'node:worker_threads'\n\nimport { isStream } from 'is-stream'\nimport lambdaLocal from 'lambda-local'\nimport sourceMapSupport from 'source-map-support'\n\nconst nullBodyStatus = new Set([101, 204, 205, 304])\n\nif (isMainThread) {\n  throw new Error(`Do not import \"${import.meta.url}\" in the main thread.`)\n}\n\nsourceMapSupport.install()\n\nlambdaLocal.getLogger().level = 'alert'\n\nconst { clientContext, entryFilePath, environment = {}, event, timeoutMs } = workerData\n\nfor (const key in environment) {\n  process.env[key] = environment[key]\n}\nconst lambdaFunc = await import(entryFilePath)\n\nconsole.log('[WORKER DEBUG] lambdaFunc keys:', Object.keys(lambdaFunc))\nconsole.log('[WORKER DEBUG] typeof handler:', typeof lambdaFunc.handler)\nconsole.log('[WORKER DEBUG] typeof default:', typeof lambdaFunc.default)\n\nconst invocationResult = /** @type {any} */ (\n  await lambdaLocal.execute({\n    clientContext,\n    event,\n    lambdaFunc,\n    region: 'dev',\n    timeoutMs,\n    verboseLevel: 3,\n  })\n)\n\nconsole.log('[WORKER DEBUG] invocationResult type:', typeof invocationResult)\nconsole.log('[WORKER DEBUG] invocationResult constructor:', invocationResult?.constructor?.name)\nconsole.log('[WORKER DEBUG] invocationResult keys:', invocationResult ? Object.keys(invocationResult) : 'null')\nconsole.log('[WORKER DEBUG] invocationResult.body type:', typeof invocationResult?.body)\nconsole.log('[WORKER DEBUG] invocationResult.body constructor:', invocationResult?.body?.constructor?.name)\nconsole.log('[WORKER DEBUG] isStream(body):', invocationResult?.body ? isStream(invocationResult.body) : 'no body')\nconsole.log('[WORKER DEBUG] body.pipe?:', typeof invocationResult?.body?.pipe)\nconsole.log('[WORKER DEBUG] statusCode:', invocationResult?.statusCode)\n\nasync function getStreamPortForStreamingResponse(invocationResult) {\n  if (!invocationResult || !isStream(invocationResult.body)) {\n    console.log('[WORKER DEBUG] NOT streaming')\n    return undefined\n  }\n\n  console.log('[WORKER DEBUG] IS streaming - opening server')\n  const { body } = invocationResult\n  delete invocationResult.body\n\n  const shouldNotHaveABody = nullBodyStatus.has(invocationResult.statusCode)\n  if (shouldNotHaveABody) {\n    return undefined\n  }\n\n  return await new Promise((resolve, reject) => {\n    const server = createServer((socket) => {\n      body.pipe(socket).on('end', () => server.close())\n    })\n    server.on('error', (error) => {\n      console.log('[WORKER DEBUG] Server error:', error.message)\n      reject(error)\n    })\n    server.listen({ port: 0, host: 'localhost' }, () => {\n      const address = server.address()\n      let streamPort\n      if (address && typeof address !== 'string') {\n        streamPort = address.port\n      }\n      console.log('[WORKER DEBUG] Stream server on port:', streamPort)\n      resolve(streamPort)\n    })\n  })\n}\n\nconst streamPort = await getStreamPortForStreamingResponse(invocationResult)\n\nconsole.log('[WORKER DEBUG] Final streamPort:', streamPort)\nconsole.log('[WORKER DEBUG] Spread result:', JSON.stringify({ ...invocationResult, streamPort }).slice(0, 200))\n\nif (parentPort) {\n  const message = { ...invocationResult, streamPort }\n  parentPort.postMessage(message)\n}\n","numLines":95,"startLine":1,"totalLines":95}}}
