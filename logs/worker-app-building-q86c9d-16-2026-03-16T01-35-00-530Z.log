ry.kind === 'addMetadata') {\n   231→          const meta = entry.metadata as Record<string, Record<string, string>> | undefined\n   232→          const rec = recordings[entry.id as string]\n   233→          if (rec && meta?.test) {\n   234→            rec.result = meta.test.result || ''\n   235→            rec.title = meta.test.title || ''\n   236→          }\n   237→        }\n   238→        if (entry.kind === 'writeFinished') {\n   239→          const rec = recordings[entry.id as string]\n   240→          if (rec) {\n   241→            rec.duration = (entry.duration as number) || 0\n   242→          }\n   243→        }\n   244→      }\n   245→\n   246→      const metadataBlock = Object.values(recordings)\n   247→        .filter(r => r.result)\n   248→        .map(r => JSON.stringify(r))\n   249→      if (metadataBlock.length) {\n   250→        log('\\n=== REPLAY RECORDINGS METADATA ===')\n   251→        for (const m of metadataBlock) log(m)\n   252→        log('=== END REPLAY RECORDINGS METADATA ===')\n   253→      }\n   254→\n   255→      const failedRecs = Object.values(recordings)\n   256→        .filter(r => r.result === 'failed' || r.result === 'timedOut')\n   257→        .sort((a, b) => b.duration - a.duration)\n   258→\n   259→      if (failedRecs[0]) {\n   260→        try {\n   261→          const uploadOut = execSync(`npx replayio upload ${failedRecs[0].id}`, {\n   262→            encoding: 'utf-8',\n   263→            cwd: appDir,\n   264→            timeout: 60000,\n   265→            env: { ...process.env, RECORD_REPLAY_API_KEY: replayApiKey },\n   266→          })\n   267→          uploadedId = failedRecs[0].id\n   268→          log(`REPLAY UPLOADED: ${uploadedId}`)\n   269→          log(uploadOut)\n   270→        } catch (ue) {\n   271→          log(`Replay upload failed: ${ue}`)\n   272→        }\n   273→      }\n   274→    } catch { log('Could not parse recordings') }\n   275→  }\n   276→\n   277→  // Step 10: Cleanup\n   278→  removeEnvValue('DAT