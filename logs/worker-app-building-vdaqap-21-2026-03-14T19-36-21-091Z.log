, 269)\n   261→  await createFlight('B6', 'B6401', 'LAX', 'JFK', '2026-04-05 06:00', '2026-04-05 14:30', 330, 'Airbus A321', true, true, false, 170, 189)\n   262→\n   263→  // SFO-ORD\n   264→  await createFlight('UA', 'UA600', 'SFO', 'ORD', '2026-04-01 07:00', '2026-04-01 13:00', 270, 'Boeing 737-900', true, true, false, 140, 179)\n   265→  await createFlight('AA', 'AA600', 'SFO', 'ORD', '2026-04-01 11:00', '2026-04-01 17:00', 270, 'Airbus A321', true, true, false, 145, 189)\n   266→\n   267→  // LAX-LHR\n   268→  await createFlight('BA', 'BA500', 'LAX', 'LHR', '2026-04-01 20:00', '2026-04-02 14:30', 630, 'Boeing 777-300ER', true, true, true, 380, 649)\n   269→  await createFlight('AA', 'AA800', 'LAX', 'LHR', '2026-04-01 18:00', '2026-04-02 12:30', 630, 'Boeing 787-9', true, true, true, 370, 599)\n   270→\n   271→  // Create a session for seed data\n   272→  await sql`INSERT INTO sessions (session_token) VALUES ('seed-session-token')`\n   273→  const sessionRows = await sql`SELECT id FROM sessions WHERE session_token = 'seed-session-token'`\n   274→  const sessionRow = sessionRows[0]\n   275→  if (!sessionRow) return\n   276→  const sessionId = sessionRow.id as string\n   277→\n   278→  // Recent searches\n   279→  const laxId = airportMap.get('LAX')!\n   280→  const jfkId = airportMap.get('JFK')!\n   281→  const sfoId = airportMap.get('SFO')!\n   282→  const ordId = airportMap.get('ORD')!\n   283→  const lhrId = airportMap.get('LHR')!\n   284→\n   285→  await sql`INSERT INTO recent_searches (session_id, origin_airport_id, destination_airport_id, departure_date, return_date, passengers_adults, cabin_class, trip_type)\n   286→    VALUES (${sessionId}, ${laxId}, ${jfkId}, '2026-04-01', '2026-04-08', 1, 'economy', 'round_trip')`\n   287→  await sql`INSERT INTO recent_searches (session_id, origin_airport_id, destination_airport_id, departure_date, return_date, passengers_adults, cabin_class, trip_type)\n   288→    VALUES (${sessionId}, ${sfoId}, ${ordId}, '2026-04-05', '2026-04-10', 2, 'business', 'round_trip')`\n   289→\n   290→  // Sample bookings\n   291→  const flightForBooking = await sql`SELECT id FROM flights WHERE flight_number = 'AA100' LIMIT 1`\n   292→  const bookingFlight = flightForBooking[0]\n   293→  if (bookingFlight) {\n   294→    await sql`INSERT INTO bookings (session_id, flight_id, booking_reference, cabin_class, total_price_cents, status)\n   295→      VALUES (${sessionId}, ${bookingFlight.id}, 'GF-ABC123', 'economy', 34385, 'confirmed')`\n   296→    const bookingRows = await sql`SELECT id FROM bookings WHERE booking_reference = 'GF-ABC123'`\n   297→    const booking = bookingRows[0]\n   298→    if (booking) {\n   299→      await sql`INSERT INTO booking_passengers (booking_id, first_name, last_name, date_of_birth, gender, email, phone, passenger_type)\n   300→        VALUES (${booking.id}, 'John', 'Doe', '1990-05-15', 'male', 'john@example.com', '+1234567890', 'adult')`\n   301→    }\n   302→  }\n   303→\n   304→  // Tracked routes\n   305→  await sql`INSERT INTO tracked_routes (session_id, origin_airport_id, destination_airport_id, departure_date_start, departure_date_end, cabin_class)\n   306→    VALUES (${sessionId}, ${laxId}, ${lhrId}, '2026-04-15', '2026-04-30', 'economy')`\n   307→}\n   308→\n   309→// CLI entry point\n   310→const isMain = process.argv[1] && import.meta.url.endsWith(process.argv[1].replace(/\\\\/g, '/'))\n   311→if (isMain) {\n   312→  const dbUrl = process.argv[2]\n   313→  if (!dbUrl) {\n   314→    console.error('Usage: tsx scripts/seed-db.ts <DATABASE_URL>')\n   315→    process.exit(1)\n   316→  }\n   317→  truncateAndSeed(dbUrl).then(() => console.log('Seed complete')).catch(e => { console.error(e); process.exit(1) })\n   318→}\n   319→"}]},"parent_tool_use_id":"toolu_01GDbKVVhHDEVdo96WZANr5c","session_id":"017a600f-8002-4d2b-b132-157c88ddc0ca","uuid":"f641a2e6-7822-4380-be91-b04744804425"}
