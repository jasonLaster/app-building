   });\n    53→    if (!response.ok) {\n    54→      const data = await response.json();\n    55→      return rejectWithValue(data.error || 'Failed to create label');\n    56→    }\n    57→    const data = await response.json();\n    58→    return data.label as Label;\n    59→  }\n    60→);\n    61→\n    62→export const updateLabel = createAsyncThunk(\n    63→  'labels/updateLabel',\n    64→  async (payload: { id: string; name: string; color: string }, { getState, rejectWithValue }) => {\n    65→    const state = getState() as { auth: { token: string | null } };\n    66→    const token = state.auth.token;\n    67→    if (!token) return rejectWithValue('No token');\n    68→    const response = await fetch('/api/labels', {\n    69→      method: 'PUT',\n    70→      headers: {\n    71→        Authorization: `Bearer ${token}`,\n    72→        'Content-Type': 'application/json',\n    73→      },\n    74→      body: JSON.stringify(payload),\n    75→    });\n    76→    if (!response.ok) {\n    77→      const data = await response.json();\n    78→      return rejectWithValue(data.error || 'Failed to update label');\n    79→    }\n    80→    const data = await response.json();\n    81→    return data.label as Label;\n    82→  }\n    83→);\n    84→\n    85→export const deleteLabel = createAsyncThunk(\n    86→  'labels/deleteLabel',\n    87→  async (id: string, { getState, rejectWithValue }) => {\n    88→    const state = getState() as { auth: { token: string | null } };\n    89→    const token = state.auth.token;\n    90→    if (!token) return rejectWithValue('No token');\n    91→    const response = await fetch('/api/labels', {\n    92→      method: 'DELETE',\n    93→      headers: {\n    94→        Authorization: `Bearer ${token}`,\n    95→        'Content-Type': 'application/json',\n    96→      },\n    97→      body: JSON.stringify({ id }),\n    98→    });\n    99→    if (!response.ok) {\n   100→      return rejectWithValue('Failed to delete label');\n   101→    }\n   102→    return id;\n   103→  }\n   104→);\n   105→\n   106→const labelsSlice = createSlice({\n   107→  name: 'labels',\n   108→  initialState,\n   109→  reducers: {},\n   110→  extraReducers: (builder) => {\n   111→    builder\n   112→      .addCase(fetchLabels.pending, (state) => {\n   113→        if (state.items.length === 0) {\n   114→          state.loading = true;\n   115→        }\n   116→        state.error = null;\n   117→      })\n   118→      .addCase(fetchLabels.fulfilled, (state, action) => {\n   119→        state.loading = false;\n   120→        state.items = action.payload;\n   121→      })\n   122→      .addCase(fetchLabels.rejected, (state, action) => {\n   123→        state.loading = false;\n   124→        state.error = action.payload as string;\n   125→      })\n   126→      .addCase(createLabel.fulfilled, (state, action) => {\n   127→        state.items.push(action.payload);\n   128→      })\n   129→      .addCase(updateLabel.fulfilled, (state, action) => {\n   130→        const index = state.items.findIndex((l) => l.id === action.payload.id);\n   131→        if (index !== -1) {\n   132→          state.items[index] = action.payload;\n   133→        }\n   134→      })\n   135→      .addCase(deleteLabel.fulfilled, (state, action) => {\n   136→        state.items = state.items.filter((l) => l.id !== action.payload);\n   137→      });\n   138→  },\n   139→});\n   140→\n   141→export default labelsSlice.reducer;\n   142→"}]},"parent_tool_use_id":"toolu_01MFw3kQWtprMDkmw5F5183q","session_id":"d51efd60-45f2-4a03-8dc3-6999e239a1e2","uuid":"71ea1be8-55f0-403f-9937-145513d1d7fa"}
