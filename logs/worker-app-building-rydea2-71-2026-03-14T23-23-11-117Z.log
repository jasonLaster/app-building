   48→    setColor(hex);\n    49→    setCustomHex('');\n    50→    setColorError(null);\n    51→  }\n    52→\n    53→  function handleCustomHexChange(value: string) {\n    54→    setCustomHex(value);\n    55→    setColorError(null);\n    56→    const normalized = value.startsWith('#') ? value : `#${value}`;\n    57→    if (isValidHex(normalized)) {\n    58→      setColor(normalized);\n    59→    }\n    60→  }\n    61→\n    62→  async function handleSubmit() {\n    63→    let hasError = false;\n    64→    setNameError(null);\n    65→    setColorError(null);\n    66→\n    67→    if (!name.trim()) {\n    68→      setNameError('Label name is required');\n    69→      hasError = true;\n    70→    } else if (existingNames.includes(name.trim().toLowerCase())) {\n    71→      setNameError('A label with this name already exists');\n    72→      hasError = true;\n    73→    }\n    74→\n    75→    if (customHex) {\n    76→      const normalized = customHex.startsWith('#') ? customHex : `#${customHex}`;\n    77→      if (!isValidHex(normalized)) {\n    78→        setColorError('Invalid color format');\n    79→        hasError = true;\n    80→      }\n    81→    }\n    82→\n    83→    if (hasError) return;\n    84→\n    85→    setSubmitting(true);\n    86→    try {\n    87→      const finalColor = customHex\n    88→        ? (customHex.startsWith('#') ? customHex : `#${customHex}`)\n    89→        : color;\n    90→      await onSubmit(name.trim(), finalColor);\n    91→    } catch (err) {\n    92→      if (err instanceof Error) {\n    93→        setNameError(err.message);\n    94→      } else {\n    95→        setNameError('Failed to create label');\n    96→      }\n    97→      setSubmitting(false);\n    98→    }\n    99→  }\n   100→\n   101→  function handleKeyDown(e: React.KeyboardEvent) {\n   102→    if (e.key === 'Enter') {\n   103→      e.preventDefault();\n   104→      handleSubmit();\n   105→    }\n   106→  }\n   107→\n   108→  if (!open) return null;\n   109→\n   110→  c