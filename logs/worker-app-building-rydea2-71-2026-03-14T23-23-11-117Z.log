leteLabel\n    43→          key={label.id}\n    44→          label={label}\n    45→          isEditing={editingLabelId === label.id}\n    46→          onEditStart={() => onEditStart(label.id)}\n    47→          onEditCancel={onEditCancel}\n    48→          onSave={onSave}\n    49→          onDeleteClick={() => onDeleteClick(label)}\n    50→          existingNames={labels.filter((l) => l.id !== label.id).map((l) => l.name.toLowerCase())}\n    51→        />\n    52→      ))}\n    53→    </div>\n    54→  );\n    55→}\n    56→"}]},"parent_tool_use_id":"toolu_01MFw3kQWtprMDkmw5F5183q","session_id":"d51efd60-45f2-4a03-8dc3-6999e239a1e2","uuid":"ddc96af2-674e-4403-8168-e4b7eca2916f"}
