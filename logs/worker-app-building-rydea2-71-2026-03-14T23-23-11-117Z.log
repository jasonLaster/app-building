[2026-03-14T23:19:27.421Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018SwH853DaBKbY5XGtPBUiB","type":"tool_result","content":"     1→import { useState } from 'react';\n     2→import type { Label } from '../slices/labelsSlice';\n     3→import './EditDeleteLabel.css';\n     4→\n     5→const PRESET_COLORS = [\n     6→  { name: 'Red', hex: '#ef4444' },\n     7→  { name: 'Orange', hex: '#f97316' },\n     8→  { name: 'Yellow', hex: '#eab308' },\n     9→  { name: 'Green', hex: '#22c55e' },\n    10→  { name: 'Blue', hex: '#3b82f6' },\n    11→  { name: 'Purple', hex: '#8b5cf6' },\n    12→  { name: 'Pink', hex: '#ec4899' },\n    13→  { name: 'Gray', hex: '#6b7280' },\n    14→];\n    15→\n    16→function isValidHex(value: string): boolean {\n    17→  return /^#[0-9a-fA-F]{6}$/.test(value);\n    18→}\n    19→\n    20→interface EditDeleteLabelProps {\n    21→  label: Label;\n    22→  isEditing: boolean;\n    23→  onEditStart: () => void;\n    24→  onEditCancel: () => void;\n    25→  onSave: (id: string, name: string, color: string) => Promise<void>;\n    26→  onDeleteClick: () => void;\n    27→  existingNames: string[];\n    28→}\n    29→\n    30→export default function EditDeleteLabel({\n    31→  label,\n    32→  isEditing,\n    33→  onEditStart,\n    34→  onEditCancel,\n    35→  onSave,\n    36→  onDeleteClick,\n    37→  existingNames,\n    38→}: EditDeleteLabelProps) {\n    39→  const [editName, setEditName] = useState(label.name);\n    40→  const [editColor, setEditColor] = useState(label.color);\n    41→  const [customHex, setCustomHex] = useState('');\n    42→  const [nameError, setNameError] = useState<string | null>(null);\n    43→  const [colorError, setColorError] = useState<string | null>(null);\n    44→  const [saving, setSaving] = useState(false);\n    45→\n    46→  function handleEditStart() {\n    47→    setEditName(label.name);\n    48→    setEditColor(label.color);\n    49→    setCustomHex('');\n    50→    setNameError(null);\n    51→    setColorError(null);\n    52→    setSaving(false);\n    53→    onEditStart();\n    54→  }\n    55→\n    56→  function handlePresetClick(hex: string) {\n    57→    setEditColor(hex);\n    58→    setCustomHex('');\n    59→    setColorError(null);\n    60→  }\n    61→\n    62→  function handleCustomHexChange(value: string) {\n    63→    setCustomHex(value);\n    64→    setColorError(null);\n    65→    const normalized = value.startsWith('#') ? value : `#${value}`;\n    66→    if (isValidHex(normalized)) {\n    67→      setEditColor(normalized);\n    68→    }\n    69→  }\n    70→\n    71→  async function handleSave() {\n    72→    let hasError = false;\n    73→    setNameError(null);\n    74→    setColorError(null);\n    75→\n    76→    if (!editName.trim()) {\n    77→      setNameError('Label name is required');\n    78→      hasError = true;\n    79→    } else if (existingNames.includes(editName.trim().toLowerCase())) {\n    80→      setNameError('A label with this name already exists');\n    81→      hasError = true;\n    82→    }\n    83→\n    84→    if (customHex) {\n    85→      const normalized = customHex.startsWith('#') ? customHex : `#${customHex}`;\n    86→      if (!isValidHex(normalized)) {\n    87→        setColorError('Invalid color format');\n    88→        hasError = true;\n    89→      }\n    90→    }\n    91→\n    92→    if (hasError) return;\n    93→\n    94→    setSaving(true);\n    95→    try {\n    96→      const finalColor = customHex\n    97→        ? (customHex.startsWith('#') ? customHex : `#${customHex}`)\n    98→        : editColor;\n    99→      await onSave(label.id, editName.trim(), finalColor);\n   100→    } catch (err) {\n   101→      if (err instanceof Error) {\n   102→        setNameError(err.message);\n   103→      } else {\n   104→        setNameError('Failed to update label');\n   105→      }\n   106→      setSaving(false);\n   107→    }\n   108→  }\n   109→\n   110→  function handleKeyDown(e: React.KeyboardEvent) {\n   111→    if (e.key === 'Enter') {\n   112→      e.preventDefault();\n   113→      handleSave();\n   114→    } else if (e.key === 'Escape') {\n   115→      onEditCancel();\n   116→    }\n   117→  }\n   118→\n   119→  function handleDelete() {\n   120→    onEditCancel();\n   121→    onDeleteClick();\n   122→  }\n   123→\n   124→  const activeColor = customHex\n   125→    ? (isValidHex(customHex.startsWith('#') ? customHex : `#${customHex}`) ? (customHex.startsWith('#') ? customHex : `#${customHex}`) : editColor)\n   126→    : editColor;\n   127→\n   128→  if (isEditing) {\n   129→    return (\n   130→      <div\n   131→        className=\"label-row label-row-editing\"\n   132→        data-testid={`label-row-${label.id}`}\n   133→        onKeyDown={handleKeyDown}\n   134→      >\n   135→        <div className=\"label-row-edit-content\">\n   136→          <div className=\"label-row-edit-name-row\">\n   137→            <span\n   138→              className=\"label-dot\"\n   139→              style={{ backgroundColor: activeColor }}\n   140→              data-testid={`label-dot-${label.id}`}\n   141→            />\n   142→            <input\n   143→              type=\"text\"\n   144→              className={`label-edit-input ${nameError ? 'label-edit-input-error' : ''}`}\n   145→              value={editName}\n   146→              onChange={(e) => { setEditName(e.target.value); setNameError(null); }}\n   147→              data-testid={`label-edit-name-input-${label.id}`}\n   148→              autoFocus\n   149→            />\n   150→          </div>\n   151→          {nameError && (\n   152→            <span className=\"label-edit-error\" data-testid={`label-edit-name-error-${label.id}`}>{nameError}</span>\n   153→          )}\n   154→          <div className=\"label-edit-color-section\">\n   155→            <div className=\"label-edit-presets\">\n   156→              {PRESET_COLORS.map((preset) => (\n   157→                <button\n   158→                  key={preset.hex}\n   159→                  className={`label-edit-swatch ${editColor === preset.hex && !customHex ? 'label-edit-swatch-selected' : ''}`}\n   160→                  style={{ backgroundColor: preset.hex }}\n   161→                  onClick={() => handlePresetClick(preset.hex)}\n   162→                  title={preset.name}\n   163→                  data-testid={`label-edit-swatch-${preset.name.toLowerCase()}-${label.id}`}\n   164→                  type=\"button\"\n   165→                />\n   166→              ))}\n   167→            </div>\n   168→            <input\n   169→              type=\"text\"\n   170→              className={`label-edit-hex-input ${colorError ? 'label-edit-input-error' : ''}`}\n   171→              placeholder=\"#hex\"\n   172→              value={customHex}\n   173→              onChange={(e) => handleCustomHexChange(e.target.value)}\n   174→              data-testid={`label-edit-hex-input-${label.id}`}\n   175→            />\n   176→            {colorError && (\n   177→              <span className=\"label-edit-error\" data-testid={`label-edit-color-error-${label.id}`}>{colorError}</span>\n   178→            )}\n   179→          </div>\n   180→        </div>\n   181→        <div className=\"label-row-edit-actions\">\n   182→          <button\n   183→            className=\"label-edit-cancel-btn\"\n   184→            onClick={onEditCancel}\n   185→            data-testid={`label-edit-cancel-btn-${label.id}`}\n   186→            type=\"button\"\n   187→          >\n   188→            Cancel\n   189→          </button>\n   190→          <button\n   191→            className=\"label-edit-save-btn\"\n   192→            onClick={handleSave}\n   193→            disabled={saving}\n   194→            data-testid={`label-edit-save-btn-${label.id}`}\n   195→            type=\"button\"\n   196→          >\n   197→            {saving ? 'Saving...' : 'Save'}\n   198→          </button>\n   199→        </div>\n   200→      </div>\n   201→    );\n   202→  }\n   203→\n   204→  return (\n   205→    <div\n   206→      className=\"label-row\"\n   207→      data-testid={`label-row-${label.id}`}\n   208→    >\n   209→      <div className=\"label-row-name\">\n   210→        <span\n   211→          className=\"label-dot\"\n   212→          style={{ backgroundColor: label.color }}\n   213→          data-testid={`label-dot-${label.id}`}\n   214→        />\n   215→        <span className=\"label-name\" data-testid={`label-name-${label.id}`}>\n   216→          {label.name}\n   217→        </span>\n   218→      </div>\n   219→      <div className=\"label-row-count\" data-testid={`label-count-${label.id}`}>\n   220→        {label.issue_count}\n   221→      </div>\n   222→      <div className=\"label-row-actions\">\n   223→        <button\n   224→          className=\"label-action-btn\"\n   225→          onClick={handleEditStart}\n   226→          title=\"Edit label\"\n   227→          data-testid={`label-edit-btn-${label.id}`}\n   228→          type=\"button\"\n   229→        >\n   230→          <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n   231→            <path d=\"M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7\" />\n   232→            <path d=\"M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z\" />\n   233→          </svg>\n   234→        </button>\n   235→        <button\n   236→          className=\"label-action-btn label-action-btn-delete\"\n   237→          onClick={handleDelete}\n   238→          title=\"Delete label\"\n   239→          data-testid={`label-delete-btn-${label.id}`}\n   240→          type=\"button\"\n   241→        >\n   242→          <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n   243→            <polyline points=\"3 6 5 6 21 6\" />\n   244→            <path d=\"M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2\" />\n   245→          </svg>\n   246→        </button>\n   247→      </div>\n   248→    </div>\n   249→  );\n   250→}\n   251→"}]},"parent_tool_use_id":"toolu_01MFw3kQWtprMDkmw5F5183q","session_id":"d51efd60-45f2-4a03-8dc3-6999e239a1e2","uuid":"5b1ebfba-6b1c-4767-8927-b0174e4b7339"}
