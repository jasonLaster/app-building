t childrenRow = page.getByTestId('passenger-row-children')\n    38→    await expect(childrenRow).toBeVisible()\n    39→    await expect(childrenRow).toContainText('Children')\n    40→    await expect(page.getByTestId('children-count')).toHaveText('0')\n    41→    await expect(page.getByTestId('children-decrement')).toBeVisible()\n    42→    await expect(page.getByTestId('children-increment')).toBeVisible()\n    43→\n    44→    // Verify Infants row\n    45→    const infantsRow = page.getByTestId('passenger-row-infants')\n    46→    await expect(infantsRow).toBeVisible()\n    47→    await expect(infantsRow).toContainText('Infants')\n    48→    await expect(page.getByTestId('infants-count')).toHaveText('0')\n    49→    await expect(page.getByTestId('infants-decrement')).toBeVisible()\n    50→    await expect(page.getByTestId('infants-increment')).toBeVisible()\n    51→  })\n    52→\n    53→  test('PassengerCountSelector increments adult count', async ({ page }) => {\n    54→    // Open dropdown\n    55→    await page.getByTestId('passenger-count-trigger').click()\n    56→    await expect(page.getByTestId('passenger-count-dropdown')).toBeVisible()\n    57→\n    58→    // Verify initial count\n    59→    await expect(page.getByTestId('adults-count')).toHaveText('1')\n    60→\n    61→    // Increment adults\n    62→    await page.getByTestId('adults-increment').click()\n    63→    await expect(page.getByTestId('adults-count')).toHaveText('2')\n    64→\n    65→    // Close dropdown and verify trigger label updates\n    66→    await page.getByTestId('search-page').click({ position: { x: 0, y: 0 } })\n    67→    await expect(page.getByTestId('passenger-count-dropdown')).not.toBeVisible()\n    68→    await expect(page.getByTestId('passenger-count-trigger')).toContainText('2 passengers')\n    69→  })\n    70→\n    71→  test('PassengerCountSelector decrements adult count with minimum of 1', async ({ page }) => {\n    72→    // Open dropdown\n    73→    await page.getByTestId('