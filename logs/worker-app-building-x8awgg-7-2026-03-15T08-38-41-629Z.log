ated))\n    40→  }\n    41→\n    42→  return (\n    43→    <div className=\"passenger-selector\" ref={ref} data-testid=\"passenger-count-selector\">\n    44→      <button\n    45→        className=\"passenger-selector__trigger\"\n    46→        onClick={() => setIsOpen(!isOpen)}\n    47→        data-testid=\"passenger-count-trigger\"\n    48→      >\n    49→        <span className=\"passenger-selector__icon\">👤</span>\n    50→        <span>{label}</span>\n    51→        <span className=\"passenger-selector__arrow\">{isOpen ? '▲' : '▼'}</span>\n    52→      </button>\n    53→      {isOpen && (\n    54→        <div className=\"passenger-selector__dropdown\" data-testid=\"passenger-count-dropdown\">\n    55→          <div className=\"passenger-selector__row\" data-testid=\"passenger-row-adults\">\n    56→            <div className=\"passenger-selector__info\">\n    57→              <span className=\"passenger-selector__category\">Adults</span>\n    58→            </div>\n    59→            <div className=\"passenger-selector__controls\">\n    60→              <button\n    61→                className=\"passenger-selector__btn\"\n    62→                onClick={() => updatePassengers('adults', -1)}\n    63→                disabled={passengers.adults <= 1}\n    64→                data-testid=\"adults-decrement\"\n    65→              >\n    66→                −\n    67→              </button>\n    68→              <span className=\"passenger-selector__count\" data-testid=\"adults-count\">{passengers.adults}</span>\n    69→              <button\n    70→                className=\"passenger-selector__btn\"\n    71→                onClick={() => updatePassengers('adults', 1)}\n    72→                data-testid=\"adults-increment\"\n    73→              >\n    74→                +\n    75→              </button>\n    76→            </div>\n    77→          </div>\n    78→          <div className=\"passenger-selector__row\" data-testid=\"passenger-row-children\">\n    79→            <div className=\"passenger-selector__info\">\n    80→              <span className=\"passenger-selector__category\">Children</span>\n    81→              <span className=\"passenger-selector__age\">2-11</span>\n    82→            </div>\n    83→            <div className=\"passenger-selector__controls\">\n    84→              <button\n    85→                className=\"passenger-selector__btn\"\n    86→                onClick={() => updatePassengers('children', -1)}\n    87→                disabled={passengers.children <= 0}\n    88→                data-testid=\"children-decrement\"\n    89→              >\n    90→                −\n    91→              </button>\n    92→              <span className=\"passenger-selector__count\" data-testid=\"children-count\">{passengers.children}</span>\n    93→              <button\n    94→                className=\"passenger-selector__btn\"\n    95→                onClick={() => updatePassengers('children', 1)}\n    96→                data-testid=\"children-increment\"\n    97→              >\n    98→                +\n    99→              </button>\n   100→            </div>\n   101→          </div>\n   102→          <div className=\"passenger-selector__row\" data-testid=\"passenger-row-infants\">\n   103→            <div className=\"passenger-selector__info\">\n   104→              <span className=\"passenger-selector__category\">Infants</span>\n   105→              <span className=\"passenger-selector__age\">Under 2</span>\n   106→            </div>\n   107→            <div className=\"passenger-selector__controls\">\n   108→              <button\n   109→                className=\"passenger-selector__btn\"\n   110→                onClick={() => updatePassengers('infants', -1)}\n   111→                disabled={passengers.infants <= 0}\n   112→                data-testid=\"infants-decrement\"\n   113→              >\n   114→                −\n   115→              </button>\n   116→              <span className=\"passenger-selector__count\" data-testid=\"infants-count\">{passengers.infants}</span>\n   117→              <button\n   118→                className=\"passenger-selector__btn\"\n   119→                onClick={() => updatePassengers('infants', 1)}\n   120→                disabled={passengers.infants >= passengers.adults}\n   121→                data-testid=\"infants-increment\"\n   122→              >\n   123→                +\n   124→              </button>\n   125→            </div>\n   126→          </div>\n   127→        </div>\n   128→      )}\n   129→    </div>\n   130→  )\n   131→}\n   132→\n   133→export default PassengerCountSelector\n   134→"}]},"parent_tool_use_id":null,"session_id":"c222c428-6363-4d7d-8b35-004fba3c5c4a","uuid":"5574e810-dbd2-4a07-8511-e153962b4467","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/GoogleFlights/src/components/PassengerCountSelector.tsx","content":"import { useState, useRef, useEffect } from 'react'\nimport { useDispatch, useSelector } from 'react-redux'\nimport { setPassengers } from '../slices/searchSlice'\nimport type { RootState } from '../store'\nimport './PassengerCountSelector.css'\n\nfunction PassengerCountSelector() {\n  const dispatch = useDispatch()\n  const passengers = useSelector((state: RootState) => state.search.passengers)\n  const [isOpen, setIsOpen] = useState(false)\n  const ref = useRef<HTMLDivElement>(null)\n\n  useEffect(() => {\n    function handleClickOutside(e: MouseEvent) {\n      if (ref.current && !ref.current.contains(e.target as Node)) {\n        setIsOpen(false)\n      }\n    }\n    if (isOpen) {\n      document.addEventListener('mousedown', handleClickOutside)\n      return () => document.removeEventListener('mousedown', handleClickOutside)\n    }\n  }, [isOpen])\n\n  const total = passengers.adults + passengers.children + passengers.infants\n  const label = total === 1 ? '1 Adult' : `${total} passengers`\n\n  function updatePassengers(field: 'adults' | 'children' | 'infants', delta: number) {\n    const newVal = passengers[field] + delta\n    if (field === 'adults' && newVal < 1) return\n    if (field !== 'adults' && newVal < 0) return\n    if (field === 'infants' && newVal > passengers.adults) return\n\n    const updated = { ...passengers, [field]: newVal }\n    // If adults decrease below infants, cap infants\n    if (field === 'adults' && updated.infants > updated.adults) {\n      updated.infants = updated.adults\n    }\n    dispatch(setPassengers(updated))\n  }\n\n  return (\n    <div className=\"passenger-selector\" ref={ref} data-testid=\"passenger-count-selector\">\n      <button\n        className=\"passenger-selector__trigger\"\n        onClick={() => setIsOpen(!isOpen)}\n        data-testid=\"passenger-count-trigger\"\n      >\n        <span className=\"passenger-selector__icon\">👤</span>\n        <span>{label}</span>\n        <span className=\"passenger-selector__arrow\">{isOpen ? '▲' : '▼'}</span>\n      </button>\n      {isOpen && (\n        <div className=\"passenger-selector__dropdown\" data-testid=\"passenger-count-dropdown\">\n          <div className=\"passenger-selector__row\" data-testid=\"passenger-row-adults\">\n            <div className=\"passenger-selector__info\">\n              <span className=\"passenger-selector__category\">Adults</span>\n            </div>\n            <div className=\"passenger-selector__controls\">\n              <button\n                className=\"passenger-selector__btn\"\n                onClick={() => updatePassengers('adults', -1)}\n                disabled={passengers.adults <= 1}\n                data-testid=\"adults-decrement\"\n              >\n                −\n              </button>\n              <span className=\"passenger-selector__count\" data-testid=\"adults-count\">{passengers.adults}</span>\n              <button\n                className=\"passenger-selector__btn\"\n                onClick={() => updatePassengers('adults', 1)}\n                data-testid=\"adults-increment\"\n              >\n                +\n              </button>\n            </div>\n          </div>\n          <div className=\"passenger-selector__row\" data-testid=\"passenger-row-children\">\n            <div className=\"passenger-selector__info\">\n              <span className=\"passenger-selector__category\">Children</span>\n              <span className=\"passenger-selector__age\">2-11</span>\n            </div>\n            <div className=\"passenger-selector__controls\">\n              <button\n                className=\"passenger-selector__btn\"\n                onClick={() => updatePassengers('children', -1)}\n                disabled={passengers.children <= 0}\n                data-testid=\"children-decrement\"\n              >\n                −\n              </button>\n              <span className=\"passenger-selector__count\" data-testid=\"children-count\">{passengers.children}</span>\n              <button\n                className=\"passenger-selector__btn\"\n                onClick={() => updatePassengers('children', 1)}\n                data-testid=\"children-increment\"\n              >\n                +\n              </button>\n            </div>\n          </div>\n          <div className=\"passenger-selector__row\" data-testid=\"passenger-row-infants\">\n            <div className=\"passenger-selector__info\">\n              <span className=\"passenger-selector__category\">Infants</span>\n              <span className=\"passenger-selector__age\">Under 2</span>\n            </div>\n            <div className=\"passenger-selector__controls\">\n              <button\n                className=\"passenger-selector__btn\"\n                onClick={() => updatePassengers('infants', -1)}\n                disabled={passengers.infants <= 0}\n                data-testid=\"infants-decrement\"\n              >\n                −\n              </button>\n              <span className=\"passenger-selector__count\" data-testid=\"infants-count\">{passengers.infants}</span>\n              <button\n                className=\"passenger-selector__btn\"\n                onClick={() => updatePassengers('infants', 1)}\n                disabled={passengers.infants >= passengers.adults}\n                data-testid=\"infants-increment\"\n              >\n                +\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  )\n}\n\nexport default PassengerCountSelector\n","numLines":134,"startLine":1,"totalLines":134}}}
