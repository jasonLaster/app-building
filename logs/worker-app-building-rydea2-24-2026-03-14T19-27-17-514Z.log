[2026-03-14T19:19:43.458Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CtLd1QC6SAmdyEqHwUXQG8","type":"tool_result","content":"     1→import { useEffect, useRef, useCallback } from 'react';\n     2→import { useSelector, useDispatch } from 'react-redux';\n     3→import { useNavigate } from 'react-router-dom';\n     4→import type { RootState, AppDispatch } from '../store';\n     5→import { openCreateIssueModal } from '../slices/uiSlice';\n     6→\n     7→const CHORD_TIMEOUT_MS = 1000;\n     8→\n     9→export default function KeyboardShortcuts() {\n    10→  const navigate = useNavigate();\n    11→  const dispatch = useDispatch<AppDispatch>();\n    12→  const { createIssueModalOpen } = useSelector((state: RootState) => state.ui);\n    13→\n    14→  const gPressedRef = useRef(false);\n    15→  const chordTimeoutRef = useRef<ReturnType<typeof setTimeout> | null>(null);\n    16→\n    17→  const clearChord = useCallback(() => {\n    18→    gPressedRef.current = false;\n    19→    if (chordTimeoutRef.current) {\n    20→      clearTimeout(chordTimeoutRef.current);\n    21→      chordTimeoutRef.current = null;\n    22→    }\n    23→  }, []);\n    24→\n    25→  useEffect(() => {\n    26→    function handleKeyDown(e: KeyboardEvent) {\n    27→      const target = e.target as HTMLElement;\n    28→      const tagName = target.tagName;\n    29→      if (\n    30→        tagName === 'INPUT' ||\n    31→        tagName === 'TEXTAREA' ||\n    32→        tagName === 'SELECT' ||\n    33→        target.isContentEditable\n    34→      ) {\n    35→        return;\n    36→      }\n    37→\n    38→      if (createIssueModalOpen) {\n    39→        return;\n    40→      }\n    41→\n    42→      const key = e.key.toLowerCase();\n    43→\n    44→      if (gPressedRef.current) {\n    45→        clearChord();\n    46→        if (key === 'i') {\n    47→          e.preventDefault();\n    48→          navigate('/my-issues');\n    49→        } else if (key === 'n') {\n    50→          e.preventDefault();\n    51→          navigate('/inbox');\n    52→        }\n    53→        return;\n    54→      }\n    55→\n    56→      if (key === 'c') {\n    57→        e.preventDefault();\n    58→        dispatch(openCreateIssueModal());\n    59→      } else if (key === 'g') {\n    60→        e.preventDefault();\n    61→        gPressedRef.current = true;\n    62→        chordTimeoutRef.current = setTimeout(() => {\n    63→          gPressedRef.current = false;\n    64→          chordTimeoutRef.current = null;\n    65→        }, CHORD_TIMEOUT_MS);\n    66→      }\n    67→    }\n    68→\n    69→    window.addEventListener('keydown', handleKeyDown);\n    70→    return () => {\n    71→      window.removeEventListener('keydown', handleKeyDown);\n    72→      clearChord();\n    73→    };\n    74→  }, [navigate, dispatch, createIssueModalOpen, clearChord]);\n    75→\n    76→  return null;\n    77→}\n    78→"}]},"parent_tool_use_id":"toolu_01JVD4Ddz6b8w9dHxef59ePQ","session_id":"655b9cf3-b108-4ac5-9b5c-49376f1dea86","uuid":"644b7be1-58ab-41f1-8c13-a31b9b99569b"}
