dCount > 0) {\n   101→        state.unreadCount -= 1;\n   102→      }\n   103→    },\n   104→    setUnreadCount(state, action) {\n   105→      state.unreadCount = action.payload;\n   106→    },\n   107→  },\n   108→  extraReducers: (builder) => {\n   109→    builder\n   110→      .addCase(fetchUnreadCount.fulfilled, (state, action) => {\n   111→        state.unreadCount = action.payload;\n   112→      })\n   113→      .addCase(fetchNotifications.pending, (state) => {\n   114→        if (state.items.length === 0) {\n   115→          state.loading = true;\n   116→        }\n   117→      })\n   118→      .addCase(fetchNotifications.fulfilled, (state, action) => {\n   119→        state.loading = false;\n   120→        state.items = action.payload;\n   121→        state.unreadCount = action.payload.filter((n) => !n.read).length;\n   122→      })\n   123→      .addCase(fetchNotifications.rejected, (state) => {\n   124→        state.loading = false;\n   125→      })\n   126→      .addCase(markNotificationRead.fulfilled, (state, action) => {\n   127→        const notification = state.items.find((n) => n.id === action.payload);\n   128→        if (notification && !notification.read) {\n   129→          notification.read = true;\n   130→          state.unreadCount = Math.max(0, state.unreadCount - 1);\n   131→        }\n   132→      })\n   133→      .addCase(archiveNotification.fulfilled, (state, action) => {\n   134→        const notification = state.items.find((n) => n.id === action.payload);\n   135→        if (notification && !notification.read) {\n   136→          state.unreadCount = Math.max(0, state.unreadCount - 1);\n   137→        }\n   138→        state.items = state.items.filter((n) => n.id !== action.payload);\n   139→      });\n   140→  },\n   141→});\n   142→\n   143→export const { decrementUnreadCount, setUnreadCount } = notificationsSlice.actions;\n   144→export default notificationsSlice.reducer;\n   145→"}]},"parent_tool_use_id":"toolu_01JVD4Ddz6b8w9dHxef59e