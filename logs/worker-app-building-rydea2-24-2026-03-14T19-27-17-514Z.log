w Response(JSON.stringify({ error: 'Invalid status' }), {\n    48→        status: 400,\n    49→        headers: { 'Content-Type': 'application/json' },\n    50→      });\n    51→    }\n    52→\n    53→    const updated = await sql`\n    54→      UPDATE issues SET status = ${status}, updated_at = NOW()\n    55→      WHERE id = ${issueId}\n    56→      RETURNING id, status\n    57→    `;\n    58→\n    59→    const row = updated[0];\n    60→    if (!row) {\n    61→      return new Response(JSON.stringify({ error: 'Issue not found' }), {\n    62→        status: 404,\n    63→        headers: { 'Content-Type': 'application/json' },\n    64→      });\n    65→    }\n    66→\n    67→    return new Response(JSON.stringify({ issue: { id: row.id, status: row.status } }), {\n    68→      status: 200,\n    69→      headers: { 'Content-Type': 'application/json' },\n    70→    });\n    71→  } catch (err) {\n    72→    console.error('Update issue status error:', err);\n    73→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n    74→      status: 500,\n    75→      headers: { 'Content-Type': 'application/json' },\n    76→    });\n    77→  }\n    78→}\n    79→"}]},"parent_tool_use_id":null,"session_id":"655b9cf3-b108-4ac5-9b5c-49376f1dea86","uuid":"f790557b-5bbc-4aa7-9f44-4bd29bec9aca","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/netlify/functions/update-issue-status.ts","content":"import type { Context } from '@netlify/functions';\nimport { getSql } from './db';\n\nexport default async function handler(req: Request, _context: Context) {\n  if (req.method !== 'PUT') {\n    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n      status: 405,\n      headers: { 'Content-Type': 'application/json' },\n    });\n  }\n\n  try {\n    const authHeader = req.headers.get('Authorization');\n    if (!authHeader?.startsWith('Bearer ')) {\n      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n        status: 401,\n        headers: { 'Content-Type': 'application/json' },\n      });\n    }\n\n    const token = authHeader.slice(7);\n    const sql = getSql();\n\n    const sessions = await sql`\n      SELECT s.member_id FROM sessions s\n      WHERE s.token = ${token} AND s.expires_at > NOW()\n    `;\n    const session = sessions[0];\n    if (!session) {\n      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n        status: 401,\n        headers: { 'Content-Type': 'application/json' },\n      });\n    }\n\n    const { issueId, status } = await req.json();\n\n    if (!issueId || !status) {\n      return new Response(JSON.stringify({ error: 'issueId and status are required' }), {\n        status: 400,\n        headers: { 'Content-Type': 'application/json' },\n      });\n    }\n\n    const validStatuses = ['backlog', 'todo', 'in_progress', 'in_review', 'done', 'cancelled'];\n    if (!validStatuses.includes(status)) {\n      return new Response(JSON.stringify({ error: 'Invalid status' }), {\n        status: 400,\n        headers: { 'Content-Type': 'application/json' },\n      });\n    }\n\n    const updated = await sql`\n      UPDATE issues SET status = ${status}, updated_at = NOW()\n      WHERE id = ${issueId}\n      RETURNING id, status\n    `;\n\n    const row = updated[0];\n    if (!row) {\n      return new Response(JSON.stringify({ error: 'Issue not found' }), {\n        status: 404,\n        headers: { 'Content-Type': 'application/json' },\n      });\n    }\n\n    return new Response(JSON.stringify({ issue: { id: row.id, status: row.status } }), {\n      status: 200,\n      headers: { 'Content-Type': 'application/json' },\n    });\n  } catch (err) {\n    console.error('Update issue status error:', err);\n    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n      status: 500,\n      headers: { 'Content-Type': 'application/json' },\n    });\n  }\n}\n","numLines":79,"startLine":1,"totalLines":79}}}
