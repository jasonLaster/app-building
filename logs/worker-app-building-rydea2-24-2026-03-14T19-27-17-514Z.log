\"7\" r=\"6\" stroke={color} strokeWidth=\"1.5\" />\n    74→        </svg>\n    75→      );\n    76→  }\n    77→}\n    78→\n    79→function PriorityIcon({ priority }: { priority: string }) {\n    80→  const config = PRIORITY_CONFIG[priority] || PRIORITY_CONFIG.none;\n    81→  const color = config.color;\n    82→\n    83→  switch (priority) {\n    84→    case 'urgent':\n    85→      return (\n    86→        <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke={color} strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n    87→          <path d=\"M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z\" />\n    88→          <line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\" />\n    89→          <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\" />\n    90→        </svg>\n    91→      );\n    92→    case 'high':\n    93→      return (\n    94→        <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke={color} strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n    95→          <line x1=\"12\" y1=\"19\" x2=\"12\" y2=\"5\" />\n    96→          <polyline points=\"5 12 12 5 19 12\" />\n    97→        </svg>\n    98→      );\n    99→    case 'medium':\n   100→      return (\n   101→        <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke={color} strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n   102→          <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\" />\n   103→        </svg>\n   104→      );\n   105→    case 'low':\n   106→      return (\n   107→        <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke={color} strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n   108→          <line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\" />\n   109→          <polyline points=\"19 12 12 19 5 12\" />\n   110→        </svg>\n   111→      );\n   112→    default:\n   113→      return (\n   114→        