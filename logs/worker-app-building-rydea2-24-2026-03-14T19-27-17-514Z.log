[2026-03-14T19:19:48.603Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GjpnST4i8WKL2bgFRoCNYr","type":"tool_result","content":"     1→import { useEffect, useMemo, useState } from 'react';\n     2→import { useSelector, useDispatch } from 'react-redux';\n     3→import type { RootState, AppDispatch } from '../store';\n     4→import { fetchMyIssues } from '../slices/issuesSlice';\n     5→import { fetchLabels } from '../slices/labelsSlice';\n     6→import FiltersToolbar from '../components/FiltersToolbar';\n     7→import MyIssuesList from '../components/MyIssuesList';\n     8→import './MyIssues.css';\n     9→\n    10→export default function MyIssues() {\n    11→  const dispatch = useDispatch<AppDispatch>();\n    12→  const { token } = useSelector((state: RootState) => state.auth);\n    13→  const { myIssues, loading } = useSelector((state: RootState) => state.issues);\n    14→\n    15→  const [selectedStatuses, setSelectedStatuses] = useState<string[]>([]);\n    16→  const [selectedPriorities, setSelectedPriorities] = useState<string[]>([]);\n    17→  const [selectedLabels, setSelectedLabels] = useState<string[]>([]);\n    18→\n    19→  useEffect(() => {\n    20→    if (token) {\n    21→      dispatch(fetchMyIssues());\n    22→      dispatch(fetchLabels());\n    23→    }\n    24→  }, [dispatch, token]);\n    25→\n    26→  const filteredIssues = useMemo(() => {\n    27→    return myIssues.filter((issue) => {\n    28→      if (selectedStatuses.length > 0 && !selectedStatuses.includes(issue.status)) {\n    29→        return false;\n    30→      }\n    31→      if (selectedPriorities.length > 0 && !selectedPriorities.includes(issue.priority)) {\n    32→        return false;\n    33→      }\n    34→      if (selectedLabels.length > 0) {\n    35→        const issueLabelIds = issue.labels.map((l) => l.id);\n    36→        if (!selectedLabels.some((labelId) => issueLabelIds.includes(labelId))) {\n    37→          return false;\n    38→        }\n  