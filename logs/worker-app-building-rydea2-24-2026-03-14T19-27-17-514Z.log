4px;\n  transition: background-color 150ms ease, color 150ms ease;\n}\n\n.bulk-actions-option:hover {\n  background-color: var(--color-bg-hover);\n  color: var(--color-text-primary);\n}\n\n.bulk-actions-avatar {\n  width: 20px;\n  height: 20px;\n  border-radius: 50%;\n  background-color: var(--color-accent);\n  color: #fff;\n  font-size: 9px;\n  font-weight: 600;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n\n.bulk-actions-avatar-empty {\n  background-color: var(--color-border);\n  color: var(--color-text-tertiary);\n}\n\n.bulk-actions-label-dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  flex-shrink: 0;\n}\n\n.bulk-actions-empty {\n  padding: 8px 12px;\n  color: var(--color-text-tertiary);\n  font-size: 12px;\n}\n\n.bulk-actions-cancel {\n  padding: 4px 10px;\n  border: none;\n  border-radius: 6px;\n  background: none;\n  color: var(--color-text-tertiary);\n  font-size: 12px;\n  font-weight: 500;\n  cursor: pointer;\n  margin-left: auto;\n  transition: color 150ms ease;\n}\n\n.bulk-actions-cancel:hover {\n  color: var(--color-text-primary);\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":373,"cache_read_input_tokens":77019,"cache_creation":{"ephemeral_5m_input_tokens":373,"ephemeral_1h_input_tokens":0},"output_tokens":6,"service_tier":"standard","inference_geo":"global"},"context_management":null},"parent_tool_use_id":null,"session_id":"655b9cf3-b108-4ac5-9b5c-49376f1dea86","uuid":"41c12b23-3f13-4366-87a4-d67e7392705f"}
