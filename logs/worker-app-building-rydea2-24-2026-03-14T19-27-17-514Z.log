usDropdownOpen(!statusDropdownOpen);\n   166→  }\n   167→\n   168→  function handleStatusChange(newStatus: string) {\n   169→    dispatch(updateIssueStatus({ issueId: issue.id, status: newStatus }));\n   170→    setStatusDropdownOpen(false);\n   171→  }\n   172→\n   173→  const statusConfig = STATUS_CONFIG[issue.status] || STATUS_CONFIG.todo;\n   174→  const priorityConfig = PRIORITY_CONFIG[issue.priority] || PRIORITY_CONFIG.none;\n   175→\n   176→  return (\n   177→    <div className=\"issue-row\" data-testid={`issue-row-${issue.id}`}>\n   178→      <div className=\"issue-row-left\">\n   179→        <span className=\"issue-row-priority\" title={priorityConfig.label} data-testid={`issue-priority-${issue.id}`}>\n   180→          <PriorityIcon priority={issue.priority} />\n   181→        </span>\n   182→        <span className=\"issue-row-identifier\" data-testid={`issue-identifier-${issue.id}`}>\n   183→          {issue.identifier}\n   184→        </span>\n   185→        <button\n   186→          className=\"issue-row-title\"\n   187→          onClick={handleTitleClick}\n   188→          data-testid={`issue-title-${issue.id}`}\n   189→        >\n   190→          {issue.title}\n   191→        </button>\n   192→      </div>\n   193→      <div className=\"issue-row-right\">\n   194→        {issue.labels.length > 0 && (\n   195→          <div className=\"issue-row-labels\" data-testid={`issue-labels-${issue.id}`}>\n   196→            {issue.labels.map((label) => (\n   197→              <span\n   198→                key={label.id}\n   199→                className=\"issue-row-label-badge\"\n   200→                style={{ borderColor: label.color }}\n   201→                data-testid={`issue-label-${issue.id}-${label.id}`}\n   202→              >\n   203→                <span className=\"issue-row-label-dot\" style={{ backgroundColor: label.color }} />\n   204→                {label.name}\n   205→              </span>\n   206→            ))}\n   207→          </div>\n   