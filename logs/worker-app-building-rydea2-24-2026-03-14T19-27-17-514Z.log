login-form-title\">Sign in to LinearClone</h1>\n    49→        <p className=\"login-form-subtitle\">Enter your credentials to continue</p>\n    50→      </div>\n    51→\n    52→      {error && (\n    53→        <div className=\"login-form-error\" data-testid=\"login-error\">\n    54→          {error}\n    55→        </div>\n    56→      )}\n    57→\n    58→      <div className=\"login-form-field\">\n    59→        <label htmlFor=\"login-email\" className=\"login-form-label\">Email</label>\n    60→        <input\n    61→          id=\"login-email\"\n    62→          type=\"email\"\n    63→          className={`login-form-input ${validationErrors.email ? 'login-form-input-error' : ''}`}\n    64→          placeholder=\"you@example.com\"\n    65→          value={email}\n    66→          onChange={(e) => {\n    67→            setEmail(e.target.value);\n    68→            if (validationErrors.email) {\n    69→              setValidationErrors((prev) => ({ ...prev, email: undefined }));\n    70→            }\n    71→          }}\n    72→          data-testid=\"login-email-input\"\n    73→          autoComplete=\"email\"\n    74→        />\n    75→        {validationErrors.email && (\n    76→          <span className=\"login-form-field-error\" data-testid=\"login-email-error\">\n    77→            {validationErrors.email}\n    78→          </span>\n    79→        )}\n    80→      </div>\n    81→\n    82→      <div className=\"login-form-field\">\n    83→        <label htmlFor=\"login-password\" className=\"login-form-label\">Password</label>\n    84→        <input\n    85→          id=\"login-password\"\n    86→          type=\"password\"\n    87→          className={`login-form-input ${validationErrors.password ? 'login-form-input-error' : ''}`}\n    88→          placeholder=\"Enter your password\"\n    89→          value={password}\n    90→          onChange={(e) => {\n    91→            setPassword(e.target.value);\n    92→            if (validationErrors.password) {\n    93→              setValidationErrors((prev) => ({ ...prev, password: undefined }));\n    94→            }\n    95→          }}\n    96→          data-testid=\"login-password-input\"\n    97→          autoComplete=\"current-password\"\n    98→        />\n    99→        {validationErrors.password && (\n   100→          <span className=\"login-form-field-error\" data-testid=\"login-password-error\">\n   101→            {validationErrors.password}\n   102→          </span>\n   103→        )}\n   104→      </div>\n   105→\n   106→      <button\n   107→        type=\"submit\"\n   108→        className=\"login-form-button\"\n   109→        disabled={loading}\n   110→        data-testid=\"login-submit-button\"\n   111→      >\n   112→        {loading ? 'Signing in...' : 'Sign in'}\n   113→      </button>\n   114→\n   115→      <p className=\"login-form-footer\">\n   116→        Don&apos;t have an account?{' '}\n   117→        <Link to=\"/signup\" className=\"login-form-link\" data-testid=\"login-signup-link\">\n   118→          Sign up\n   119→        </Link>\n   120→      </p>\n   121→    </form>\n   122→  );\n   123→}\n   124→"}]},"parent_tool_use_id":"toolu_01JVD4Ddz6b8w9dHxef59ePQ","session_id":"655b9cf3-b108-4ac5-9b5c-49376f1dea86","uuid":"c9d78bf3-a57f-43c7-bb40-f15f7b7cbd44"}
