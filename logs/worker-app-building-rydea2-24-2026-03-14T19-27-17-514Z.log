arClone/src/pages/Login.css\n/repo/apps/LinearClone/src/pages/Login.tsx\n/repo/apps/LinearClone/src/pages/MyIssues.css\n/repo/apps/LinearClone/src/pages/MyIssues.tsx\n/repo/apps/LinearClone/src/pages/SignUp.css\n/repo/apps/LinearClone/src/pages/SignUp.tsx\n/repo/apps/LinearClone/src/slices/authSlice.ts\n/repo/apps/LinearClone/src/slices/issuesSlice.ts\n/repo/apps/LinearClone/src/slices/labelsSlice.ts\n/repo/apps/LinearClone/src/slices/notificationsSlice.ts\n/repo/apps/LinearClone/src/slices/teamsSlice.ts\n/repo/apps/LinearClone/src/slices/uiSlice.ts\n/repo/apps/LinearClone/src/slices/workspaceSlice.ts\n/repo/apps/LinearClone/src/store.ts","is_error":false}]},"parent_tool_use_id":"toolu_01JVD4Ddz6b8w9dHxef59ePQ","session_id":"655b9cf3-b108-4ac5-9b5c-49376f1dea86","uuid":"44ccdbc6-6559-4f8a-8a62-a8d5cd72b671"}
