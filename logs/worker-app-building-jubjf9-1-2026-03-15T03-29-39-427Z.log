UserBookings',\n    61→  async (guestId: string, { rejectWithValue }) => {\n    62→    const response = await fetch(`/api/bookings?guest_id=${encodeURIComponent(guestId)}`)\n    63→    const result = await response.json()\n    64→    if (!response.ok) {\n    65→      return rejectWithValue(result.error || 'Failed to fetch bookings')\n    66→    }\n    67→    return result as Booking[]\n    68→  }\n    69→)\n    70→\n    71→export const cancelBooking = createAsyncThunk(\n    72→  'bookings/cancelBooking',\n    73→  async (bookingId: string, { rejectWithValue }) => {\n    74→    const response = await fetch(`/api/bookings/${bookingId}`, {\n    75→      method: 'PUT',\n    76→      headers: { 'Content-Type': 'application/json' },\n    77→      body: JSON.stringify({ status: 'cancelled' }),\n    78→    })\n    79→    const result = await response.json()\n    80→    if (!response.ok) {\n    81→      return rejectWithValue(result.error || 'Failed to cancel booking')\n    82→    }\n    83→    return result as Booking\n    84→  }\n    85→)\n    86→\n    87→const bookingsSlice = createSlice({\n    88→  name: 'bookings',\n    89→  initialState,\n    90→  reducers: {\n    91→    clearBookingError(state) {\n    92→      state.error = null\n    93→    },\n    94→  },\n    95→  extraReducers: (builder) => {\n    96→    builder\n    97→      .addCase(createBooking.pending, (state) => {\n    98→        state.loading = true\n    99→        state.error = null\n   100→      })\n   101→      .addCase(createBooking.fulfilled, (state, action) => {\n   102→        state.loading = false\n   103→        state.items.push(action.payload)\n   104→      })\n   105→      .addCase(createBooking.rejected, (state, action) => {\n   106→        state.loading = false\n   107→        state.error = action.payload as string\n   108→      })\n   109→      .addCase(fetchUserBookings.pending, (state) => {\n   110→        if (state.items.length === 0) {\n   111→          state.loading = true\n   112→        }\n   113→        state.error = null\n   114→      })\n   115→      .addCase(fetchUserBookings.fulfilled, (state, action) => {\n   116→        state.loading = false\n   117→        state.items = action.payload\n   118→      })\n   119→      .addCase(fetchUserBookings.rejected, (state, action) => {\n   120→        state.loading = false\n   121→        state.error = action.payload as string\n   122→      })\n   123→      .addCase(cancelBooking.fulfilled, (state, action) => {\n   124→        const index = state.items.findIndex((b) => b.id === action.payload.id)\n   125→        if (index !== -1) {\n   126→          const existing = state.items[index]\n   127→          if (existing) {\n   128→            state.items[index] = { ...existing, ...action.payload }\n   129→          }\n   130→        }\n   131→      })\n   132→      .addCase(cancelBooking.rejected, (state, action) => {\n   133→        state.error = action.payload as string\n   134→      })\n   135→  },\n   136→})\n   137→\n   138→export const { clearBookingError } = bookingsSlice.actions\n   139→export default bookingsSlice.reducer\n   140→"}]},"parent_tool_use_id":"toolu_01X2o7nwDQNvcXVsnhjaTZuD","session_id":"2d3ea4c5-1166-4389-879f-ac502e987c77","uuid":"8c410a91-8a3b-441b-95ea-8e8a67b132e5"}
