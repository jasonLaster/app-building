*\n    42→    `\n    43→    const user = result[0]\n    44→    if (!user) {\n    45→      return new Response(JSON.stringify({ error: 'User not found' }), { status: 404, headers })\n    46→    }\n    47→    return new Response(JSON.stringify(user), { status: 200, headers })\n    48→  }\n    49→\n    50→  if (request.method === 'PUT') {\n    51→    const body = await request.json() as {\n    52→      name?: string\n    53→      bio?: string | null\n    54→      phone?: string | null\n    55→      avatar_url?: string | null\n    56→    }\n    57→\n    58→    const existing = await sql`SELECT * FROM users WHERE id = ${userId}`\n    59→    const existingUser = existing[0]\n    60→    if (!existingUser) {\n    61→      return new Response(JSON.stringify({ error: 'User not found' }), { status: 404, headers })\n    62→    }\n    63→\n    64→    const eu = existingUser as Record<string, unknown>\n    65→    const result = await sql`\n    66→      UPDATE users SET\n    67→        name = ${body.name !== undefined ? body.name : eu.name as string},\n    68→        bio = ${body.bio !== undefined ? (body.bio || null) : eu.bio as string | null},\n    69→        phone = ${body.phone !== undefined ? (body.phone || null) : eu.phone as string | null},\n    70→        avatar_url = ${body.avatar_url !== undefined ? (body.avatar_url || null) : eu.avatar_url as string | null}\n    71→      WHERE id = ${userId}\n    72→      RETURNING *\n    73→    `\n    74→    const user = result[0]\n    75→    return new Response(JSON.stringify(user), { status: 200, headers })\n    76→  }\n    77→\n    78→  return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers })\n    79→  } catch {\n    80→    return new Response(JSON.stringify({ error: 'Internal server error' }), { status: 500, headers })\n    81→  }\n    82→}\n    83→"}]},"parent_tool_use_id":"toolu_01X2o7nwDQNvcXVsnhjaTZuD","session_id":"2d3ea4c5-1166-4389-879f-ac502e987c77","uuid":"6e607d59-58e4-4409-b0a2-36909