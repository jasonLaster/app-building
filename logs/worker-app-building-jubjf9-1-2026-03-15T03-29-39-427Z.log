?: number\n    67→  images?: PropertyImage[]\n    68→  amenities?: Amenity[]\n    69→  reviews?: Review[]\n    70→}\n    71→\n    72→export interface SearchFilters {\n    73→  city: string\n    74→  checkIn: string\n    75→  checkOut: string\n    76→  guests: number\n    77→  propertyType: string\n    78→  minPrice: number\n    79→  maxPrice: number\n    80→  minBedrooms: number\n    81→  minBeds: number\n    82→  minBathrooms: number\n    83→  amenityIds: string[]\n    84→  page: number\n    85→}\n    86→\n    87→interface PropertiesState {\n    88→  items: Property[]\n    89→  total: number\n    90→  totalPages: number\n    91→  page: number\n    92→  loading: boolean\n    93→  error: string | null\n    94→  filters: SearchFilters\n    95→}\n    96→\n    97→const initialFilters: SearchFilters = {\n    98→  city: '',\n    99→  checkIn: '',\n   100→  checkOut: '',\n   101→  guests: 0,\n   102→  propertyType: '',\n   103→  minPrice: 0,\n   104→  maxPrice: 0,\n   105→  minBedrooms: 0,\n   106→  minBeds: 0,\n   107→  minBathrooms: 0,\n   108→  amenityIds: [],\n   109→  page: 1,\n   110→}\n   111→\n   112→const initialState: PropertiesState = {\n   113→  items: [],\n   114→  total: 0,\n   115→  totalPages: 0,\n   116→  page: 1,\n   117→  loading: false,\n   118→  error: null,\n   119→  filters: initialFilters,\n   120→}\n   121→\n   122→export const fetchProperties = createAsyncThunk(\n   123→  'properties/fetchProperties',\n   124→  async (filters: SearchFilters, { rejectWithValue }) => {\n   125→    const params = new URLSearchParams()\n   126→    if (filters.city) params.set('city', filters.city)\n   127→    if (filters.checkIn) params.set('check_in', filters.checkIn)\n   128→    if (filters.checkOut) params.set('check_out', filters.checkOut)\n   129→    if (filters.guests > 0) params.set('guests', String(filters.guests))\n   130→    if (filters.propertyType) params.set('property_type', filters.propertyType)\n   131→    if (filters.minPrice > 0) params.set('min_price', String(filters.minPrice))\n   132→    if (filters.maxPrice > 0) params.set('max_price', String(filters.maxPrice))\n   133→    if (filters.minBedrooms > 0) params.set('min_bedrooms', String(filters.minBedrooms))\n   134→    if (filters.minBeds > 0) params.set('min_beds', String(filters.minBeds))\n   135→    if (filters.minBathrooms > 0) params.set('min_bathrooms', String(filters.minBathrooms))\n   136→    if (filters.amenityIds.length > 0) params.set('amenities', filters.amenityIds.join(','))\n   137→    params.set('page', String(filters.page))\n   138→    params.set('limit', '12')\n   139→\n   140→    const response = await fetch(`/api/properties?${params.toString()}`)\n   141→    const data = await response.json()\n   142→    if (!response.ok) {\n   143→      return rejectWithValue(data.error || 'Failed to fetch properties')\n   144→    }\n   145→    return data as { properties: Property[]; total: number; page: number; totalPages: number }\n   146→  }\n   147→)\n   148→\n   149→const propertiesSlice = createSlice({\n   150→  name: 'properties',\n   151→  initialState,\n   152→  reducers: {\n   153→    setFilters(state, action: { payload: Partial<SearchFilters> }) {\n   154→      state.filters = { ...state.filters, ...action.payload }\n   155→    },\n   156→    resetFilters(state) {\n   157→      state.filters = initialFilters\n   158→    },\n   159→    setPage(state, action: { payload: number }) {\n   160→      state.filters.page = action.payload\n   161→    },\n   162→  },\n   163→  extraReducers: (builder) => {\n   164→    builder\n   165→      .addCase(fetchProperties.pending, (state) => {\n   166→        if (state.items.length === 0) {\n   167→          state.loading = true\n   168→        }\n   169→        state.error = null\n   170→      })\n   171→      .addCase(fetchProperties.fulfilled, (state, action) => {\n   172→        state.loading = false\n   173→        state.items = action.payload.properties\n   174→        state.total = action.payload.total\n   175→        state.totalPages = action.payload.totalPages\n   176→        state.page = action.payload.page\n   177→      })\n   178→      .addCase(fetchProperties.rejected, (state, action) => {\n   179→        state.loading = false\n   180→        state.error = action.payload as string\n   181→      })\n   182→  },\n   183→})\n   184→\n   185→export const { setFilters, resetFilters, setPage } = propertiesSlice.actions\n   186→export default propertiesSlice.reducer\n   187→"}]},"parent_tool_use_id":"toolu_01X2o7nwDQNvcXVsnhjaTZuD","session_id":"2d3ea4c5-1166-4389-879f-ac502e987c77","uuid":"729c53b0-7fcc-486b-86d8-eb9db202cfda"}
