[2026-03-15T03:20:45.775Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AEbjX5mcYFy8gDzbKhUJcf","type":"tool_result","content":"     1→import { createSlice, createAsyncThunk } from '@reduxjs/toolkit'\n     2→\n     3→interface FavoritesState {\n     4→  propertyIds: string[]\n     5→  loading: boolean\n     6→}\n     7→\n     8→const initialState: FavoritesState = {\n     9→  propertyIds: [],\n    10→  loading: false,\n    11→}\n    12→\n    13→export const fetchFavorites = createAsyncThunk(\n    14→  'favorites/fetchFavorites',\n    15→  async (userId: string, { rejectWithValue }) => {\n    16→    const response = await fetch(`/api/favorites?user_id=${userId}`)\n    17→    const data = await response.json()\n    18→    if (!response.ok) {\n    19→      return rejectWithValue(data.error || 'Failed to fetch favorites')\n    20→    }\n    21→    return (data as { property_id: string }[]).map((f) => f.property_id)\n    22→  }\n    23→)\n    24→\n    25→export const addFavorite = createAsyncThunk(\n    26→  'favorites/addFavorite',\n    27→  async ({ userId, propertyId }: { userId: string; propertyId: string }, { rejectWithValue }) => {\n    28→    const response = await fetch('/api/favorites', {\n    29→      method: 'POST',\n    30→      headers: { 'Content-Type': 'application/json' },\n    31→      body: JSON.stringify({ user_id: userId, property_id: propertyId }),\n    32→    })\n    33→    if (!response.ok) {\n    34→      const data = await response.json()\n    35→      return rejectWithValue(data.error || 'Failed to add favorite')\n    36→    }\n    37→    return propertyId\n    38→  }\n    39→)\n    40→\n    41→export const removeFavorite = createAsyncThunk(\n    42→  'favorites/removeFavorite',\n    43→  async ({ userId, propertyId }: { userId: string; propertyId: string }, { rejectWithValue }) => {\n    44→    const response = await fetch(`/api/favorites/${propertyId}?user_id=${userId}`, {\n    45→      method: 'DELETE',\n    46→    })\n    47→    if (!response.ok) {\n    48→      const data = await response.json()\n    49→      return rejectWithValue(data.error || 'Failed to remove favorite')\n    50→    }\n    51→    return propertyId\n    52→  }\n    53→)\n    54→\n    55→const favoritesSlice = createSlice({\n    56→  name: 'favorites',\n    57→  initialState,\n    58→  reducers: {},\n    59→  extraReducers: (builder) => {\n    60→    builder\n    61→      .addCase(fetchFavorites.pending, (state) => {\n    62→        state.loading = true\n    63→      })\n    64→      .addCase(fetchFavorites.fulfilled, (state, action) => {\n    65→        state.loading = false\n    66→        state.propertyIds = action.payload\n    67→      })\n    68→      .addCase(fetchFavorites.rejected, (state) => {\n    69→        state.loading = false\n    70→      })\n    71→      .addCase(addFavorite.fulfilled, (state, action) => {\n    72→        if (!state.propertyIds.includes(action.payload)) {\n    73→          state.propertyIds.push(action.payload)\n    74→        }\n    75→      })\n    76→      .addCase(removeFavorite.fulfilled, (state, action) => {\n    77→        state.propertyIds = state.propertyIds.filter((id) => id !== action.payload)\n    78→      })\n    79→  },\n    80→})\n    81→\n    82→export default favoritesSlice.reducer\n    83→"}]},"parent_tool_use_id":"toolu_01X2o7nwDQNvcXVsnhjaTZuD","session_id":"2d3ea4c5-1166-4389-879f-ac502e987c77","uuid":"c6c4ac5b-a284-4702-91a0-a5b0b721011e"}
