  alt={mainImage!.caption || 'Property image'}\n    49→            className=\"w-full h-full object-cover\"\n    50→          />\n    51→          {mainImage!.caption && (\n    52→            <p className=\"absolute bottom-0 left-0 right-0 bg-black/50 text-white text-sm px-3 py-1.5\">\n    53→              {mainImage!.caption}\n    54→            </p>\n    55→          )}\n    56→        </div>\n    57→        <div className=\"grid grid-cols-2 gap-2 h-[400px]\">\n    58→          {thumbnails.slice(0, 4).map((img) => {\n    59→            const originalIndex = images.indexOf(img)\n    60→            return (\n    61→              <div\n    62→                key={img.id}\n    63→                data-testid={`thumbnail-${img.id}`}\n    64→                className=\"relative cursor-pointer overflow-hidden hover:opacity-90 transition-opacity\"\n    65→                onClick={() => setMainIndex(originalIndex)}\n    66→              >\n    67→                <img\n    68→                  src={img.url}\n    69→                  alt={img.caption || 'Property image'}\n    70→                  className=\"w-full h-full object-cover\"\n    71→                />\n    72→                {img.caption && (\n    73→                  <p className=\"absolute bottom-0 left-0 right-0 bg-black/50 text-white text-xs px-2 py-1\">\n    74→                    {img.caption}\n    75→                  </p>\n    76→                )}\n    77→              </div>\n    78→            )\n    79→          })}\n    80→        </div>\n    81→      </div>\n    82→    </div>\n    83→  )\n    84→}\n    85→"}]},"parent_tool_use_id":null,"session_id":"2d3ea4c5-1166-4389-879f-ac502e987c77","uuid":"c9ec383f-a6c9-4b35-b172-c1f93eb4bf18","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/components/ImageGallery.tsx","content":"import { useState } from 'react'\nimport type { PropertyImage } from '../slices/propertiesSlice'\n\ninterface ImageGalleryProps {\n  images: PropertyImage[]\n}\n\nexport default function ImageGallery({ images }: ImageGalleryProps) {\n  const [mainIndex, setMainIndex] = useState(0)\n\n  if (images.length === 0) {\n    return (\n      <div data-testid=\"image-gallery\" className=\"rounded-xl bg-bg-secondary flex items-center justify-center h-[400px]\">\n        <p className=\"text-text-secondary\">No images available</p>\n      </div>\n    )\n  }\n\n  const mainImage = images[mainIndex]\n\n  if (images.length === 1) {\n    return (\n      <div data-testid=\"image-gallery\">\n        <div className=\"relative rounded-xl overflow-hidden h-[400px]\">\n          <img\n            src={mainImage!.url}\n            alt={mainImage!.caption || 'Property image'}\n            className=\"w-full h-full object-cover\"\n          />\n          {mainImage!.caption && (\n            <p className=\"absolute bottom-0 left-0 right-0 bg-black/50 text-white text-sm px-3 py-1.5\">\n              {mainImage!.caption}\n            </p>\n          )}\n        </div>\n      </div>\n    )\n  }\n\n  const thumbnails = images.filter((_, i) => i !== mainIndex)\n\n  return (\n    <div data-testid=\"image-gallery\">\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-2 rounded-xl overflow-hidden\">\n        <div className=\"relative h-[400px]\">\n          <img\n            src={mainImage!.url}\n            alt={mainImage!.caption || 'Property image'}\n            className=\"w-full h-full object-cover\"\n          />\n          {mainImage!.caption && (\n            <p className=\"absolute bottom-0 left-0 right-0 bg-black/50 text-white text-sm px-3 py-1.5\">\n              {mainImage!.caption}\n            </p>\n          )}\n        </div>\n        <div className=\"grid grid-cols-2 gap-2 h-[400px]\">\n          {thumbnails.slice(0, 4).map((img) => {\n            const originalIndex = images.indexOf(img)\n            return (\n              <div\n                key={img.id}\n                data-testid={`thumbnail-${img.id}`}\n                className=\"relative cursor-pointer overflow-hidden hover:opacity-90 transition-opacity\"\n                onClick={() => setMainIndex(originalIndex)}\n              >\n                <img\n                  src={img.url}\n                  alt={img.caption || 'Property image'}\n                  className=\"w-full h-full object-cover\"\n                />\n                {img.caption && (\n                  <p className=\"absolute bottom-0 left-0 right-0 bg-black/50 text-white text-xs px-2 py-1\">\n                    {img.caption}\n                  </p>\n                )}\n              </div>\n            )\n          })}\n        </div>\n      </div>\n    </div>\n  )\n}\n","numLines":85,"startLine":1,"totalLines":85}}}
