[2026-03-15T03:20:56.749Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012zTSydMSX7gbNn6m4fKVPC","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions'\n     2→import { getSql } from './db.js'\n     3→\n     4→export default async (request: Request, _context: Context) => {\n     5→  const sql = getSql()\n     6→  const url = new URL(request.url)\n     7→  const headers = { 'Content-Type': 'application/json' }\n     8→\n     9→  if (request.method === 'GET') {\n    10→    const hostId = url.searchParams.get('host_id')\n    11→    if (!hostId) {\n    12→      return new Response(JSON.stringify({ error: 'host_id is required' }), { status: 400, headers })\n    13→    }\n    14→\n    15→    const listingsResult = await sql`\n    16→      SELECT count(*)::int as total_listings\n    17→      FROM properties WHERE host_id = ${hostId} AND is_active = true\n    18→    `\n    19→    const listingsRow = listingsResult[0]\n    20→    const totalListings = listingsRow ? (listingsRow as Record<string, unknown>).total_listings as number : 0\n    21→\n    22→    const bookingsResult = await sql`\n    23→      SELECT count(*)::int as active_bookings\n    24→      FROM bookings b\n    25→      JOIN properties p ON p.id = b.property_id\n    26→      WHERE p.host_id = ${hostId} AND b.status IN ('pending', 'confirmed')\n    27→    `\n    28→    const bookingsRow = bookingsResult[0]\n    29→    const activeBookings = bookingsRow ? (bookingsRow as Record<string, unknown>).active_bookings as number : 0\n    30→\n    31→    const earningsResult = await sql`\n    32→      SELECT COALESCE(sum(b.total_price), 0)::numeric as total_earnings\n    33→      FROM bookings b\n    34→      JOIN properties p ON p.id = b.property_id\n    35→      WHERE p.host_id = ${hostId} AND b.status = 'completed'\n    36→    `\n    37→    const earningsRow = earningsResult[0]\n    38→    const totalEarnings = earningsRow ? Number((earningsRow as Record<string, unknown>).total_earnings) : 0\n    39→\n    40→    const ratingResult = await sql`\n    41→      SELECT COALESCE(AVG(r.rating)::numeric(10,1), 0) as avg_rating,\n    42→        count(*)::int as review_count\n    43→      FROM reviews r\n    44→      JOIN properties p ON p.id = r.property_id\n    45→      WHERE p.host_id = ${hostId}\n    46→    `\n    47→    const ratingRow = ratingResult[0]\n    48→    const avgRating = ratingRow ? Number((ratingRow as Record<string, unknown>).avg_rating) : 0\n    49→    const reviewCount = ratingRow ? (ratingRow as Record<string, unknown>).review_count as number : 0\n    50→\n    51→    return new Response(JSON.stringify({\n    52→      totalListings,\n    53→      activeBookings,\n    54→      totalEarnings,\n    55→      avgRating,\n    56→      reviewCount,\n    57→    }), { status: 200, headers })\n    58→  }\n    59→\n    60→  return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers })\n    61→}\n    62→"}]},"parent_tool_use_id":"toolu_01X2o7nwDQNvcXVsnhjaTZuD","session_id":"2d3ea4c5-1166-4389-879f-ac502e987c77","uuid":"a95d37dc-d73c-40e7-9b78-49904ba64dcd"}
