[2026-03-15T03:20:42.963Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017Xs4vz851LpMhwCBtp8y6m","type":"tool_result","content":"     1→import { useState } from 'react'\n     2→import { NavLink, useLocation } from 'react-router-dom'\n     3→import { useSelector, useDispatch } from 'react-redux'\n     4→import type { RootState, AppDispatch } from '../store'\n     5→import { logout } from '../slices/authSlice'\n     6→\n     7→function Sidebar() {\n     8→  const [collapsed, setCollapsed] = useState(false)\n     9→  const currentUser = useSelector((state: RootState) => state.auth.currentUser)\n    10→  const dispatch = useDispatch<AppDispatch>()\n    11→  const location = useLocation()\n    12→\n    13→  if (!currentUser || location.pathname === '/login') {\n    14→    return null\n    15→  }\n    16→\n    17→  const navItems = [\n    18→    { to: '/', label: 'Home', icon: HomeIcon },\n    19→    { to: '/trips', label: 'My Trips', icon: TripsIcon },\n    20→    ...(currentUser.is_host\n    21→      ? [{ to: '/hosting', label: 'Hosting', icon: HostingIcon }]\n    22→      : []),\n    23→    { to: '/profile', label: 'Profile', icon: ProfileIcon },\n    24→  ]\n    25→\n    26→  return (\n    27→    <aside\n    28→      data-testid=\"sidebar\"\n    29→      className={`sidebar ${collapsed ? 'sidebar--collapsed' : ''}`}\n    30→    >\n    31→      <div className=\"sidebar__header\">\n    32→        {!collapsed && <span className=\"sidebar__logo\">airbnb</span>}\n    33→        <button\n    34→          data-testid=\"sidebar-toggle\"\n    35→          className=\"sidebar__toggle\"\n    36→          onClick={() => setCollapsed(!collapsed)}\n    37→          title={collapsed ? 'Expand sidebar' : 'Collapse sidebar'}\n    38→        >\n    39→          {collapsed ? <ChevronRightIcon /> : <ChevronLeftIcon />}\n    40→        </button>\n    41→      </div>\n    42→\n    43→      <nav className=\"sidebar__nav\">\n    44→        {navItems.map((item) => (\n    45→          <NavLink\n    46→            key={item.to}\n    47→            to={item.to}\n    48→            end={item.to === '/'}\n    49→            data-testid={`sidebar-link-${item.label.toLowerCase().replace(/\\s+/g, '-')}`}\n    50→            className={({ isActive }) =>\n    51→              `sidebar__link ${isActive ? 'sidebar__link--active' : ''}`\n    52→            }\n    53→            title={collapsed ? item.label : undefined}\n    54→          >\n    55→            <item.icon />\n    56→            {!collapsed && <span>{item.label}</span>}\n    57→          </NavLink>\n    58→        ))}\n    59→      </nav>\n    60→\n    61→      <div className=\"sidebar__footer\">\n    62→        <button\n    63→          data-testid=\"sidebar-logout\"\n    64→          className=\"sidebar__link sidebar__logout\"\n    65→          onClick={() => dispatch(logout())}\n    66→          title={collapsed ? 'Log Out' : undefined}\n    67→        >\n    68→          <LogoutIcon />\n    69→          {!collapsed && <span>Log Out</span>}\n    70→        </button>\n    71→      </div>\n    72→    </aside>\n    73→  )\n    74→}\n    75→\n    76→function HomeIcon() {\n    77→  return (\n    78→    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n    79→      <path d=\"M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\" />\n    80→      <polyline points=\"9 22 9 12 15 12 15 22\" />\n    81→    </svg>\n    82→  )\n    83→}\n    84→\n    85→function TripsIcon() {\n    86→  return (\n    87→    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n    88→      <rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\" />\n    89→      <line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\" />\n    90→      <line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\" />\n    91→      <line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\" />\n    92→    </svg>\n    93→  )\n    94→}\n    95→\n    96→function HostingIcon() {\n    97→  return (\n    98→    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n    99→      <path d=\"M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\" />\n   100→      <path d=\"M9 22V12h6v10\" />\n   101→      <line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"8.01\" />\n   102→    </svg>\n   103→  )\n   104→}\n   105→\n   106→function ProfileIcon() {\n   107→  return (\n   108→    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n   109→      <path d=\"M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2\" />\n   110→      <circle cx=\"12\" cy=\"7\" r=\"4\" />\n   111→    </svg>\n   112→  )\n   113→}\n   114→\n   115→function LogoutIcon() {\n   116→  return (\n   117→    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n   118→      <path d=\"M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4\" />\n   119→      <polyline points=\"16 17 21 12 16 7\" />\n   120→      <line x1=\"21\" y1=\"12\" x2=\"9\" y2=\"12\" />\n   121→    </svg>\n   122→  )\n   123→}\n   124→\n   125→function ChevronLeftIcon() {\n   126→  return (\n   127→    <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n   128→      <polyline points=\"15 18 9 12 15 6\" />\n   129→    </svg>\n   130→  )\n   131→}\n   132→\n   133→function ChevronRightIcon() {\n   134→  return (\n   135→    <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n   136→      <polyline points=\"9 18 15 12 9 6\" />\n   137→    </svg>\n   138→  )\n   139→}\n   140→\n   141→export default Sidebar\n   142→"}]},"parent_tool_use_id":"toolu_01X2o7nwDQNvcXVsnhjaTZuD","session_id":"2d3ea4c5-1166-4389-879f-ac502e987c77","uuid":"29620c2f-2600-429d-95ef-302b66c8da48"}
