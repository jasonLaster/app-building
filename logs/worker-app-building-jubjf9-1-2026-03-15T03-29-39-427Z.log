[2026-03-15T03:20:47.707Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XuPk3JAokjXMGiTzwK4AXC","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions'\n     2→import { getSql } from './db.js'\n     3→\n     4→export default async (request: Request, _context: Context) => {\n     5→  const sql = getSql()\n     6→  const url = new URL(request.url)\n     7→  const segments = url.pathname.split('/').filter(Boolean)\n     8→  const funcIdx = segments.indexOf('bookings')\n     9→  const bookingId = funcIdx >= 0 ? segments[funcIdx + 1] : undefined\n    10→\n    11→  const headers = { 'Content-Type': 'application/json' }\n    12→\n    13→  try {\n    14→  if (request.method === 'POST') {\n    15→    const body = await request.json() as {\n    16→      property_id: string\n    17→      guest_id: string\n    18→      check_in: string\n    19→      check_out: string\n    20→      num_guests: number\n    21→      total_price: number\n    22→      special_requests?: string\n    23→    }\n    24→\n    25→    const { property_id, guest_id, check_in, check_out, num_guests, total_price, special_requests } = body\n    26→\n    27→    if (!property_id || !guest_id || !check_in || !check_out || !num_guests || !total_price) {\n    28→      return new Response(JSON.stringify({ error: 'Missing required fields' }), { status: 400, headers })\n    29→    }\n    30→\n    31→    const overlap = await sql`\n    32→      SELECT id FROM bookings\n    33→      WHERE property_id = ${property_id}\n    34→      AND status IN ('confirmed', 'pending')\n    35→      AND check_in < ${check_out}\n    36→      AND check_out > ${check_in}\n    37→    `\n    38→    if (overlap.length > 0) {\n    39→      return new Response(JSON.stringify({ error: 'Property is not available for the selected dates' }), { status: 409, headers })\n    40→    }\n    41→\n    42→    const result = await sql`\n    43→      INSERT INTO bookings (id, property_id, guest_id, check_in, check_out, num_guests, total_price, status, special_requests, created_at)\n    44→      VALUES (gen_random_uuid(), ${property_id}, ${guest_id}, ${check_in}, ${check_out}, ${num_guests}, ${total_price}, 'pending', ${special_requests || null}, now())\n    45→      RETURNING *\n    46→    `\n    47→    const booking = result[0]\n    48→    return new Response(JSON.stringify(booking), { status: 201, headers })\n    49→  }\n    50→\n    51→  if (request.method === 'PUT' && bookingId) {\n    52→    const body = await request.json() as { status: string }\n    53→    const { status } = body\n    54→\n    55→    if (!['confirmed', 'cancelled'].includes(status)) {\n    56→      return new Response(JSON.stringify({ error: 'Invalid status' }), { status: 400, headers })\n    57→    }\n    58→\n    59→    const result = await sql`\n    60→      UPDATE bookings SET status = ${status} WHERE id = ${bookingId} RETURNING *\n    61→    `\n    62→    const booking = result[0]\n    63→    if (!booking) {\n    64→      return new Response(JSON.stringify({ error: 'Booking not found' }), { status: 404, headers })\n    65→    }\n    66→    return new Response(JSON.stringify(booking), { status: 200, headers })\n    67→  }\n    68→\n    69→  if (request.method === 'DELETE' && bookingId) {\n    70→    const result = await sql`\n    71→      DELETE FROM bookings WHERE id = ${bookingId} RETURNING *\n    72→    `\n    73→    const booking = result[0]\n    74→    if (!booking) {\n    75→      return new Response(JSON.stringify({ error: 'Booking not found' }), { status: 404, headers })\n    76→    }\n    77→    return new Response(JSON.stringify(booking), { status: 200, headers })\n    78→  }\n    79→\n    80→  if (request.method === 'DELETE' && !bookingId) {\n    81→    // Delete all non-seed bookings (seed IDs follow pattern e*-*-*-*-*)\n    82→    const seedIds = [\n    83→      'e1111111-1111-1111-1111-111111111111',\n    84→      'e2222222-2222-2222-2222-222222222222',\n    85→      'e3333333-3333-3333-3333-333333333333',\n    86→      'e4444444-4444-4444-4444-444444444444',\n    87→      'e5555555-5555-5555-5555-555555555555',\n    88→      'e6666666-6666-6666-6666-666666666666',\n    89→    ]\n    90→    await sql`DELETE FROM bookings WHERE id != ALL(${seedIds})`\n    91→    // Reset seed bookings to original statuses\n    92→    await sql`UPDATE bookings SET status = 'completed' WHERE id = 'e1111111-1111-1111-1111-111111111111'`\n    93→    await sql`UPDATE bookings SET status = 'confirmed' WHERE id = 'e2222222-2222-2222-2222-222222222222'`\n    94→    await sql`UPDATE bookings SET status = 'pending' WHERE id = 'e3333333-3333-3333-3333-333333333333'`\n    95→    await sql`UPDATE bookings SET status = 'completed' WHERE id = 'e4444444-4444-4444-4444-444444444444'`\n    96→    await sql`UPDATE bookings SET status = 'cancelled' WHERE id = 'e5555555-5555-5555-5555-555555555555'`\n    97→    await sql`UPDATE bookings SET status = 'confirmed' WHERE id = 'e6666666-6666-6666-6666-666666666666'`\n    98→    return new Response(JSON.stringify({ success: true }), { status: 200, headers })\n    99→  }\n   100→\n   101→  if (request.method === 'GET') {\n   102→    const guestId = url.searchParams.get('guest_id')\n   103→    if (!guestId) {\n   104→      return new Response(JSON.stringify({ error: 'guest_id is required' }), { status: 400, headers })\n   105→    }\n   106→\n   107→    const bookings = await sql`\n   108→      SELECT b.*,\n   109→        p.title as property_title, p.city as property_city, p.country as property_country,\n   110→        (SELECT url FROM property_images pi WHERE pi.property_id = p.id ORDER BY pi.display_order ASC LIMIT 1) as property_image,\n   111→        CASE WHEN EXISTS (SELECT 1 FROM reviews r WHERE r.booking_id = b.id) THEN true ELSE false END as has_review\n   112→      FROM bookings b\n   113→      JOIN properties p ON p.id = b.property_id\n   114→      WHERE b.guest_id = ${guestId}\n   115→      ORDER BY b.check_in ASC\n   116→    `\n   117→    return new Response(JSON.stringify(bookings), { status: 200, headers })\n   118→  }\n   119→\n   120→  return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers })\n   121→  } catch {\n   122→    return new Response(JSON.stringify({ error: 'Internal server error' }), { status: 500, headers })\n   123→  }\n   124→}\n   125→"}]},"parent_tool_use_id":"toolu_01X2o7nwDQNvcXVsnhjaTZuD","session_id":"2d3ea4c5-1166-4389-879f-ac502e987c77","uuid":"ebfbc445-e37b-42b7-8c11-8a7cabec4d03"}
