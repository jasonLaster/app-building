[2026-03-15T03:20:43.130Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01J5hs6LpZs6KzFFX2ZTF7nd","type":"tool_result","content":"     1→import { useState, useEffect } from 'react'\n     2→import { SlidersHorizontal, X } from 'lucide-react'\n     3→import { useSelector, useDispatch } from 'react-redux'\n     4→import type { RootState, AppDispatch } from '../store'\n     5→import { fetchAmenities } from '../slices/amenitiesSlice'\n     6→import type { Amenity } from '../slices/propertiesSlice'\n     7→\n     8→interface FiltersPanelProps {\n     9→  minPrice: number\n    10→  maxPrice: number\n    11→  minBedrooms: number\n    12→  minBeds: number\n    13→  minBathrooms: number\n    14→  selectedAmenityIds: string[]\n    15→  onApplyFilters: (filters: {\n    16→    minPrice: number\n    17→    maxPrice: number\n    18→    minBedrooms: number\n    19→    minBeds: number\n    20→    minBathrooms: number\n    21→    amenityIds: string[]\n    22→  }) => void\n    23→  onReset: () => void\n    24→}\n    25→\n    26→export default function FiltersPanel({\n    27→  minPrice,\n    28→  maxPrice,\n    29→  minBedrooms,\n    30→  minBeds,\n    31→  minBathrooms,\n    32→  selectedAmenityIds,\n    33→  onApplyFilters,\n    34→  onReset,\n    35→}: FiltersPanelProps) {\n    36→  const dispatch = useDispatch<AppDispatch>()\n    37→  const amenities = useSelector((state: RootState) => state.amenities.items)\n    38→  const [isOpen, setIsOpen] = useState(false)\n    39→\n    40→  const [localMinPrice, setLocalMinPrice] = useState(minPrice)\n    41→  const [localMaxPrice, setLocalMaxPrice] = useState(maxPrice)\n    42→  const [localMinBedrooms, setLocalMinBedrooms] = useState(minBedrooms)\n    43→  const [localMinBeds, setLocalMinBeds] = useState(minBeds)\n    44→  const [localMinBathrooms, setLocalMinBathrooms] = useState(minBathrooms)\n    45→  const [localAmenityIds, setLocalAmenityIds] = useState<string[]>(selectedAmenityIds)\n    46→\n    47→  useEffect(() => {\n    48→    if (isOpen && amenities.length === 0) {\n    49→      dispatch(fetchAmenities())\n    50→    }\n    51→  }, [isOpen, amenities.length, dispatch])\n    52→\n    53→  useEffect(() => {\n    54→    setLocalMinPrice(minPrice)\n    55→    setLocalMaxPrice(maxPrice)\n    56→    setLocalMinBedrooms(minBedrooms)\n    57→    setLocalMinBeds(minBeds)\n    58→    setLocalMinBathrooms(minBathrooms)\n    59→    setLocalAmenityIds(selectedAmenityIds)\n    60→  }, [minPrice, maxPrice, minBedrooms, minBeds, minBathrooms, selectedAmenityIds])\n    61→\n    62→  const toggleAmenity = (id: string) => {\n    63→    setLocalAmenityIds((prev) =>\n    64→      prev.includes(id) ? prev.filter((a) => a !== id) : [...prev, id]\n    65→    )\n    66→  }\n    67→\n    68→  const handleApply = () => {\n    69→    onApplyFilters({\n    70→      minPrice: localMinPrice,\n    71→      maxPrice: localMaxPrice,\n    72→      minBedrooms: localMinBedrooms,\n    73→      minBeds: localMinBeds,\n    74→      minBathrooms: localMinBathrooms,\n    75→      amenityIds: localAmenityIds,\n    76→    })\n    77→  }\n    78→\n    79→  const handleReset = () => {\n    80→    setLocalMinPrice(0)\n    81→    setLocalMaxPrice(0)\n    82→    setLocalMinBedrooms(0)\n    83→    setLocalMinBeds(0)\n    84→    setLocalMinBathrooms(0)\n    85→    setLocalAmenityIds([])\n    86→    onReset()\n    87→  }\n    88→\n    89→  // Group amenities by category\n    90→  const grouped = amenities.reduce<Record<string, Amenity[]>>((acc, a) => {\n    91→    const list = acc[a.category]\n    92→    if (!list) {\n    93→      acc[a.category] = [a]\n    94→    } else {\n    95→      list.push(a)\n    96→    }\n    97→    return acc\n    98→  }, {})\n    99→\n   100→  return (\n   101→    <div data-testid=\"filters-panel-container\">\n   102→      <button\n   103→        data-testid=\"filters-toggle\"\n   104→        onClick={() => setIsOpen(!isOpen)}\n   105→        className=\"flex items-center gap-2 rounded-full border border-border px-4 py-2 text-sm font-medium text-text hover:border-text transition-colors\"\n   106→      >\n   107→        <SlidersHorizontal size={16} />\n   108→        Filters\n   109→      </button>\n   110→\n   111→      {isOpen && (\n   112→        <div\n   113→          data-testid=\"filters-panel\"\n   114→          className=\"mt-3 rounded-xl border border-border bg-bg p-5 shadow-lg\"\n   115→        >\n   116→          <div className=\"flex items-center justify-between mb-4\">\n   117→            <h3 className=\"font-semibold text-text text-lg\">Filters</h3>\n   118→            <button onClick={() => setIsOpen(false)} className=\"text-text-secondary hover:text-text\">\n   119→              <X size={20} />\n   120→            </button>\n   121→          </div>\n   122→\n   123→          {/* Price Range */}\n   124→          <div className=\"mb-5\">\n   125→            <h4 className=\"font-medium text-text text-sm mb-2\">Price range</h4>\n   126→            <div className=\"flex items-center gap-3\">\n   127→              <div className=\"flex-1\">\n   128→                <label className=\"text-xs text-text-secondary\">Min price</label>\n   129→                <input\n   130→                  data-testid=\"filter-min-price\"\n   131→                  type=\"text\"\n   132→                  inputMode=\"decimal\"\n   133→                  value={localMinPrice || ''}\n   134→                  onChange={(e) => setLocalMinPrice(parseFloat(e.target.value) || 0)}\n   135→                  placeholder=\"$0\"\n   136→                  className=\"w-full mt-1 rounded-lg border border-border px-3 py-2 text-sm outline-none focus:border-text\"\n   137→                />\n   138→              </div>\n   139→              <span className=\"text-text-secondary mt-4\">–</span>\n   140→              <div className=\"flex-1\">\n   141→                <label className=\"text-xs text-text-secondary\">Max price</label>\n   142→                <input\n   143→                  data-testid=\"filter-max-price\"\n   144→                  type=\"text\"\n   145→                  inputMode=\"decimal\"\n   146→                  value={localMaxPrice || ''}\n   147→                  onChange={(e) => setLocalMaxPrice(parseFloat(e.target.value) || 0)}\n   148→                  placeholder=\"Any\"\n   149→                  className=\"w-full mt-1 rounded-lg border border-border px-3 py-2 text-sm outline-none focus:border-text\"\n   150→                />\n   151→              </div>\n   152→            </div>\n   153→          </div>\n   154→\n   155→          {/* Rooms */}\n   156→          <div className=\"mb-5\">\n   157→            <h4 className=\"font-medium text-text text-sm mb-2\">Rooms and beds</h4>\n   158→            <div className=\"grid grid-cols-3 gap-3\">\n   159→              <div>\n   160→                <label className=\"text-xs text-text-secondary\">Bedrooms</label>\n   161→                <select\n   162→                  data-testid=\"filter-min-bedrooms\"\n   163→                  value={localMinBedrooms}\n   164→                  onChange={(e) => setLocalMinBedrooms(parseInt(e.target.value, 10))}\n   165→                  className=\"w-full mt-1 rounded-lg border border-border px-3 py-2 text-sm outline-none focus:border-text bg-bg\"\n   166→                >\n   167→                  <option value={0}>Any</option>\n   168→                  {[1, 2, 3, 4, 5, 6, 7, 8].map((n) => (\n   169→                    <option key={n} value={n}>{n}+</option>\n   170→                  ))}\n   171→                </select>\n   172→              </div>\n   173→              <div>\n   174→                <label className=\"text-xs text-text-secondary\">Beds</label>\n   175→                <select\n   176→                  data-testid=\"filter-min-beds\"\n   177→                  value={localMinBeds}\n   178→                  onChange={(e) => setLocalMinBeds(parseInt(e.target.value, 10))}\n   179→                  className=\"w-full mt-1 rounded-lg border border-border px-3 py-2 text-sm outline-none focus:border-text bg-bg\"\n   180→                >\n   181→                  <option value={0}>Any</option>\n   182→                  {[1, 2, 3, 4, 5, 6, 7, 8].map((n) => (\n   183→                    <option key={n} value={n}>{n}+</option>\n   184→                  ))}\n   185→                </select>\n   186→              </div>\n   187→              <div>\n   188→                <label className=\"text-xs text-text-secondary\">Bathrooms</label>\n   189→                <select\n   190→                  data-testid=\"filter-min-bathrooms\"\n   191→                  value={localMinBathrooms}\n   192→                  onChange={(e) => setLocalMinBathrooms(parseInt(e.target.value, 10))}\n   193→                  className=\"w-full mt-1 rounded-lg border border-border px-3 py-2 text-sm outline-none focus:border-text bg-bg\"\n   194→                >\n   195→                  <option value={0}>Any</option>\n   196→                  {[1, 2, 3, 4, 5, 6, 7, 8].map((n) => (\n   197→                    <option key={n} value={n}>{n}+</option>\n   198→                  ))}\n   199→                </select>\n   200→              </div>\n   201→            </div>\n   202→          </div>\n   203→\n   204→          {/* Amenities */}\n   205→          {Object.keys(grouped).length > 0 && (\n   206→            <div className=\"mb-5\">\n   207→              <h4 className=\"font-medium text-text text-sm mb-2\">Amenities</h4>\n   208→              {Object.entries(grouped).map(([category, items]) => (\n   209→                <div key={category} className=\"mb-3\">\n   210→                  <p className=\"text-xs text-text-secondary font-medium mb-1.5\">{category}</p>\n   211→                  <div className=\"flex flex-wrap gap-2\">\n   212→                    {items.map((amenity) => (\n   213→                      <label\n   214→                        key={amenity.id}\n   215→                        data-testid={`amenity-checkbox-${amenity.id}`}\n   216→                        className=\"flex items-center gap-1.5 cursor-pointer\"\n   217→                      >\n   218→                        <input\n   219→                          type=\"checkbox\"\n   220→                          checked={localAmenityIds.includes(amenity.id)}\n   221→                          onChange={() => toggleAmenity(amenity.id)}\n   222→                          className=\"rounded accent-primary\"\n   223→                        />\n   224→                        <span className=\"text-sm text-text\">{amenity.name}</span>\n   225→                      </label>\n   226→                    ))}\n   227→                  </div>\n   228→                </div>\n   229→              ))}\n   230→            </div>\n   231→          )}\n   232→\n   233→          {/* Action buttons */}\n   234→          <div className=\"flex items-center justify-between pt-3 border-t border-border\">\n   235→            <button\n   236→              data-testid=\"filters-reset\"\n   237→              onClick={handleReset}\n   238→              className=\"text-sm font-medium text-text-secondary underline hover:text-text\"\n   239→            >\n   240→              Clear all\n   241→            </button>\n   242→            <button\n   243→              data-testid=\"filters-apply\"\n   244→              onClick={handleApply}\n   245→              className=\"rounded-lg bg-text text-bg px-5 py-2.5 text-sm font-medium hover:opacity-90 transition-opacity\"\n   246→            >\n   247→              Show results\n   248→            </button>\n   249→          </div>\n   250→        </div>\n   251→      )}\n   252→    </div>\n   253→  )\n   254→}\n   255→"}]},"parent_tool_use_id":"toolu_01X2o7nwDQNvcXVsnhjaTZuD","session_id":"2d3ea4c5-1166-4389-879f-ac502e987c77","uuid":"035ff25b-331f-4b04-8a80-351625f19c3e"}
