?: number\n    67→  images?: PropertyImage[]\n    68→  amenities?: Amenity[]\n    69→  reviews?: Review[]\n    70→}\n    71→\n    72→export interface SearchFilters {\n    73→  city: string\n    74→  checkIn: string\n    75→  checkOut: string\n    76→  guests: number\n    77→  propertyType: string\n    78→  minPrice: number\n    79→  maxPrice: number\n    80→  minBedrooms: number\n    81→  minBeds: number\n    82→  minBathrooms: number\n    83→  amenityIds: string[]\n    84→  page: number\n    85→}\n    86→\n    87→interface PropertiesState {\n    88→  items: Property[]\n    89→  total: number\n    90→  totalPages: number\n    91→  page: number\n    92→  loading: boolean\n    93→  error: string | null\n    94→  filters: SearchFilters\n    95→}\n    96→\n    97→const initialFilters: SearchFilters = {\n    98→  city: '',\n    99→  checkIn: '',\n   100→  checkOut: '',\n   101→  guests: 0,\n   102→  propertyType: '',\n   103→  minPrice: 0,\n   104→  maxPrice: 0,\n   105→  minBedrooms: 0,\n   106→  minBeds: 0,\n   107→  minBathrooms: 0,\n   108→  amenityIds: [],\n   109→  page: 1,\n   110→}\n   111→\n   112→const initialState: PropertiesState = {\n   113→  items: [],\n   114→  total: 0,\n   115→  totalPages: 0,\n   116→  page: 1,\n   117→  loading: false,\n   118→  error: null,\n   119→  filters: initialFilters,\n   120→}\n   121→\n   122→export const fetchProperties = createAsyncThunk(\n   123→  'properties/fetchProperties',\n   124→  async (filters: SearchFilters, { rejectWithValue }) => {\n   125→    const params = new URLSearchParams()\n   126→    if (filters.city) params.set('city', filters.city)\n   127→    if (filters.checkIn) params.set('check_in', filters.checkIn)\n   128→    if (filters.checkOut) params.set('check_out', filters.checkOut)\n   129→    if (filters.guests > 0) params.set('guests', String(filters.guests))\n   130→    if (filters.propertyType) params.set('property_type', filters.propertyType)\n   131→    if (filters.minPrice > 0) params.set('min_price', String(filters.minPrice))\n   132→    if (filters.maxPrice > 0) params.set('max_price', String(filters.maxPrice))\n   133→    if (filters.minBedrooms > 0) params.set('min_bedrooms', String(filters.minBedrooms))\n   134→    if (filters.minBeds > 0) params.set('min_beds', String(filters.minBeds))\n   135→    if (filters.minBathrooms > 0) params.set('min_bathrooms', String(filters.minBathrooms))\n   136→    if (filters.amenityIds.length > 0) params.set('amenities', filters.amenityIds.join(','))\n   137→    params.set('page', String(filters.page))\n   138→    params.set('limit', '12')\n   139→\n   140→    const response = await fetch(`/api/properties?${params.toString()}`)\n   141→    const data = await response.json()\n   142→    if (!response.ok) {\n   143→      return rejectWithValue(data.error || 'Failed to fetch properties')\n   144→    }\n   145→    return data as { properties: Property[]; total: number; page: number; totalPages: number }\n   146→  }\n   147→)\n   148→\n   149→const propertiesSlice = createSlice({\n   150→  name: 'properties',\n   151→  initialState,\n   152→  reducers: {\n   153→    setFilters(state, action: { payload: Partial<SearchFilters> }) {\n   154→      state.filters = { ...state.filters, ...action.payload }\n   155→    },\n   156→    resetFilters(state) {\n   157→      state.filters = initialFilters\n   158→    },\n   159→    setPage(state, action: { payload: number }) {\n   160→      state.filters.page = action.payload\n   161→    },\n   162→  },\n   163→  extraReducers: (builder) => {\n   164→    builder\n   165→      .addCase(fetchProperties.pending, (state) => {\n   166→        if (state.items.length === 0) {\n   167→          state.loading = true\n   168→        }\n   169→        state.error = null\n   170→      })\n   171→      .addCase(fetchProperties.fulfilled, (state, action) => {\n   172→        state.loading = false\n   173→        state.items = action.payload.properties\n   174→        state.total = action.payload.total\n   175→        state.totalPages = action.payload.totalPages\n   176→        state.page = action.payload.page\n   177→      })\n   178→      .addCase(fetchProperties.rejected, (state, action) => {\n   179→        state.loading = false\n   180→        state.error = action.payload as string\n   181→      })\n   182→  },\n   183→})\n   184→\n   185→export const { setFilters, resetFilters, setPage } = propertiesSlice.actions\n   186→export default propertiesSlice.reducer\n   187→"}]},"parent_tool_use_id":null,"session_id":"2d3ea4c5-1166-4389-879f-ac502e987c77","uuid":"71b8dca3-ea40-4f51-ae81-f8e659fdb996","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/slices/propertiesSlice.ts","content":"import { createSlice, createAsyncThunk } from '@reduxjs/toolkit'\n\nexport interface PropertyImage {\n  id: string\n  property_id: string\n  url: string\n  caption: string | null\n  display_order: number\n}\n\nexport interface Amenity {\n  id: string\n  name: string\n  icon: string | null\n  category: string\n}\n\nexport interface Review {\n  id: string\n  booking_id: string\n  property_id: string\n  guest_id: string\n  rating: number\n  cleanliness: number\n  accuracy: number\n  communication: number\n  location: number\n  value: number\n  comment: string | null\n  created_at: string\n  guest_name: string\n  guest_avatar: string | null\n}\n\nexport interface Property {\n  id: string\n  host_id: string\n  title: string\n  description: string\n  property_type: string\n  price_per_night: number\n  cleaning_fee: number\n  max_guests: number\n  bedrooms: number\n  beds: number\n  bathrooms: number\n  address: string\n  city: string\n  state: string | null\n  country: string\n  latitude: number | null\n  longitude: number | null\n  check_in_time: string\n  check_out_time: string\n  is_active: boolean\n  created_at: string\n  updated_at: string\n  main_image?: string | null\n  avg_rating?: number\n  review_count?: number\n  // Detail fields\n  host_name?: string\n  host_avatar?: string | null\n  host_bio?: string | null\n  host_since?: string\n  host_listing_count?: number\n  images?: PropertyImage[]\n  amenities?: Amenity[]\n  reviews?: Review[]\n}\n\nexport interface SearchFilters {\n  city: string\n  checkIn: string\n  checkOut: string\n  guests: number\n  propertyType: string\n  minPrice: number\n  maxPrice: number\n  minBedrooms: number\n  minBeds: number\n  minBathrooms: number\n  amenityIds: string[]\n  page: number\n}\n\ninterface PropertiesState {\n  items: Property[]\n  total: number\n  totalPages: number\n  page: number\n  loading: boolean\n  error: string | null\n  filters: SearchFilters\n}\n\nconst initialFilters: SearchFilters = {\n  city: '',\n  checkIn: '',\n  checkOut: '',\n  guests: 0,\n  propertyType: '',\n  minPrice: 0,\n  maxPrice: 0,\n  minBedrooms: 0,\n  minBeds: 0,\n  minBathrooms: 0,\n  amenityIds: [],\n  page: 1,\n}\n\nconst initialState: PropertiesState = {\n  items: [],\n  total: 0,\n  totalPages: 0,\n  page: 1,\n  loading: false,\n  error: null,\n  filters: initialFilters,\n}\n\nexport const fetchProperties = createAsyncThunk(\n  'properties/fetchProperties',\n  async (filters: SearchFilters, { rejectWithValue }) => {\n    const params = new URLSearchParams()\n    if (filters.city) params.set('city', filters.city)\n    if (filters.checkIn) params.set('check_in', filters.checkIn)\n    if (filters.checkOut) params.set('check_out', filters.checkOut)\n    if (filters.guests > 0) params.set('guests', String(filters.guests))\n    if (filters.propertyType) params.set('property_type', filters.propertyType)\n    if (filters.minPrice > 0) params.set('min_price', String(filters.minPrice))\n    if (filters.maxPrice > 0) params.set('max_price', String(filters.maxPrice))\n    if (filters.minBedrooms > 0) params.set('min_bedrooms', String(filters.minBedrooms))\n    if (filters.minBeds > 0) params.set('min_beds', String(filters.minBeds))\n    if (filters.minBathrooms > 0) params.set('min_bathrooms', String(filters.minBathrooms))\n    if (filters.amenityIds.length > 0) params.set('amenities', filters.amenityIds.join(','))\n    params.set('page', String(filters.page))\n    params.set('limit', '12')\n\n    const response = await fetch(`/api/properties?${params.toString()}`)\n    const data = await response.json()\n    if (!response.ok) {\n      return rejectWithValue(data.error || 'Failed to fetch properties')\n    }\n    return data as { properties: Property[]; total: number; page: number; totalPages: number }\n  }\n)\n\nconst propertiesSlice = createSlice({\n  name: 'properties',\n  initialState,\n  reducers: {\n    setFilters(state, action: { payload: Partial<SearchFilters> }) {\n      state.filters = { ...state.filters, ...action.payload }\n    },\n    resetFilters(state) {\n      state.filters = initialFilters\n    },\n    setPage(state, action: { payload: number }) {\n      state.filters.page = action.payload\n    },\n  },\n  extraReducers: (builder) => {\n    builder\n      .addCase(fetchProperties.pending, (state) => {\n        if (state.items.length === 0) {\n          state.loading = true\n        }\n        state.error = null\n      })\n      .addCase(fetchProperties.fulfilled, (state, action) => {\n        state.loading = false\n        state.items = action.payload.properties\n        state.total = action.payload.total\n        state.totalPages = action.payload.totalPages\n        state.page = action.payload.page\n      })\n      .addCase(fetchProperties.rejected, (state, action) => {\n        state.loading = false\n        state.error = action.payload as string\n      })\n  },\n})\n\nexport const { setFilters, resetFilters, setPage } = propertiesSlice.actions\nexport default propertiesSlice.reducer\n","numLines":187,"startLine":1,"totalLines":187}}}
