[2026-03-15T03:20:47.469Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JZArnQdV7m8ppfNEBo8fji","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions'\n     2→import { getSql } from './db.js'\n     3→\n     4→export default async (request: Request, _context: Context) => {\n     5→  const sql = getSql()\n     6→  const url = new URL(request.url)\n     7→  const segments = url.pathname.split('/').filter(Boolean)\n     8→  const propIdx = segments.indexOf('properties')\n     9→  const propertyId = propIdx >= 0 ? segments[propIdx + 1] : undefined\n    10→\n    11→  const headers = { 'Content-Type': 'application/json' }\n    12→\n    13→  if (request.method === 'GET' && propertyId) {\n    14→    const result = await sql`\n    15→      SELECT p.*,\n    16→        u.name as host_name, u.avatar_url as host_avatar, u.bio as host_bio, u.created_at as host_since,\n    17→        (SELECT count(*)::int FROM properties WHERE host_id = p.host_id AND is_active = true) as host_listing_count,\n    18→        (SELECT COALESCE(AVG(r.rating)::numeric(10,1), 0) FROM reviews r WHERE r.property_id = p.id) as avg_rating,\n    19→        (SELECT count(*)::int FROM reviews r WHERE r.property_id = p.id) as review_count\n    20→      FROM properties p\n    21→      JOIN users u ON u.id = p.host_id\n    22→      WHERE p.id = ${propertyId}\n    23→    `\n    24→    const property = result[0]\n    25→    if (!property) {\n    26→      return new Response(JSON.stringify({ error: 'Property not found' }), { status: 404, headers })\n    27→    }\n    28→\n    29→    const images = await sql`\n    30→      SELECT * FROM property_images WHERE property_id = ${propertyId} ORDER BY display_order ASC\n    31→    `\n    32→\n    33→    const amenities = await sql`\n    34→      SELECT a.* FROM amenities a\n    35→      JOIN property_amenities pa ON pa.amenity_id = a.id\n    36→      WHERE pa.property_id = ${propertyId}\n    37→      ORDER BY a.category, a.name\n    38→    `\n    39→\n    40→    const reviews = await sql`\n    41→      SELECT r.*, u.name as guest_name, u.avatar_url as guest_avatar\n    42→      FROM reviews r\n    43→      JOIN users u ON u.id = r.guest_id\n    44→      WHERE r.property_id = ${propertyId}\n    45→      ORDER BY r.created_at DESC\n    46→    `\n    47→\n    48→    return new Response(JSON.stringify({ ...property, images, amenities, reviews }), { status: 200, headers })\n    49→  }\n    50→\n    51→  if (request.method === 'GET') {\n    52→    const city = url.searchParams.get('city') || ''\n    53→    const checkIn = url.searchParams.get('check_in') || ''\n    54→    const checkOut = url.searchParams.get('check_out') || ''\n    55→    const guestsStr = url.searchParams.get('guests') || '0'\n    56→    const propertyType = url.searchParams.get('property_type') || ''\n    57→    const minPriceStr = url.searchParams.get('min_price') || '0'\n    58→    const maxPriceStr = url.searchParams.get('max_price') || '0'\n    59→    const minBedroomsStr = url.searchParams.get('min_bedrooms') || '0'\n    60→    const minBedsStr = url.searchParams.get('min_beds') || '0'\n    61→    const minBathroomsStr = url.searchParams.get('min_bathrooms') || '0'\n    62→    const amenitiesParam = url.searchParams.get('amenities') || ''\n    63→    const page = parseInt(url.searchParams.get('page') || '1', 10)\n    64→    const limit = parseInt(url.searchParams.get('limit') || '12', 10)\n    65→    const offset = (page - 1) * limit\n    66→\n    67→    const guestsNum = parseInt(guestsStr, 10) || 0\n    68→    const minPrice = parseFloat(minPriceStr) || 0\n    69→    const maxPrice = parseFloat(maxPriceStr) || 0\n    70→    const minBedrooms = parseInt(minBedroomsStr, 10) || 0\n    71→    const minBeds = parseInt(minBedsStr, 10) || 0\n    72→    const minBathrooms = parseInt(minBathroomsStr, 10) || 0\n    73→    const amenityIds = amenitiesParam ? amenitiesParam.split(',').filter(Boolean) : []\n    74→    const amenityCount = amenityIds.length\n    75→    const hasDateFilter = checkIn !== '' && checkOut !== ''\n    76→    const hasAmenityFilter = amenityCount > 0\n    77→\n    78→    const countResult = await sql`\n    79→      SELECT count(*)::int as total\n    80→      FROM properties p\n    81→      WHERE p.is_active = true\n    82→        AND (${city} = '' OR LOWER(p.city) LIKE LOWER('%' || ${city} || '%'))\n    83→        AND (${guestsNum} = 0 OR p.max_guests >= ${guestsNum})\n    84→        AND (${propertyType} = '' OR p.property_type = ${propertyType})\n    85→        AND (${minPrice} = 0 OR p.price_per_night >= ${minPrice})\n    86→        AND (${maxPrice} = 0 OR p.price_per_night <= ${maxPrice})\n    87→        AND (${minBedrooms} = 0 OR p.bedrooms >= ${minBedrooms})\n    88→        AND (${minBeds} = 0 OR p.beds >= ${minBeds})\n    89→        AND (${minBathrooms} = 0 OR p.bathrooms >= ${minBathrooms})\n    90→        AND (${!hasDateFilter} OR NOT EXISTS (\n    91→          SELECT 1 FROM bookings b\n    92→          WHERE b.property_id = p.id\n    93→          AND b.status IN ('confirmed', 'pending')\n    94→          AND b.check_in < ${checkOut || '9999-12-31'}\n    95→          AND b.check_out > ${checkIn || '1970-01-01'}\n    96→        ))\n    97→        AND (${!hasAmenityFilter} OR (\n    98→          SELECT count(*) FROM property_amenities pa\n    99→          WHERE pa.property_id = p.id AND pa.amenity_id::text = ANY(${amenityIds})\n   100→        ) >= ${amenityCount})\n   101→    `\n   102→    const countRow = countResult[0]\n   103→    const total = countRow ? (countRow as Record<string, unknown>).total as number : 0\n   104→\n   105→    const properties = await sql`\n   106→      SELECT p.*,\n   107→        (SELECT url FROM property_images pi WHERE pi.property_id = p.id ORDER BY pi.display_order ASC LIMIT 1) as main_image,\n   108→        (SELECT COALESCE(AVG(r.rating)::numeric(10,1), 0) FROM reviews r WHERE r.property_id = p.id) as avg_rating,\n   109→        (SELECT count(*)::int FROM reviews r WHERE r.property_id = p.id) as review_count\n   110→      FROM properties p\n   111→      WHERE p.is_active = true\n   112→        AND (${city} = '' OR LOWER(p.city) LIKE LOWER('%' || ${city} || '%'))\n   113→        AND (${guestsNum} = 0 OR p.max_guests >= ${guestsNum})\n   114→        AND (${propertyType} = '' OR p.property_type = ${propertyType})\n   115→        AND (${minPrice} = 0 OR p.price_per_night >= ${minPrice})\n   116→        AND (${maxPrice} = 0 OR p.price_per_night <= ${maxPrice})\n   117→        AND (${minBedrooms} = 0 OR p.bedrooms >= ${minBedrooms})\n   118→        AND (${minBeds} = 0 OR p.beds >= ${minBeds})\n   119→        AND (${minBathrooms} = 0 OR p.bathrooms >= ${minBathrooms})\n   120→        AND (${!hasDateFilter} OR NOT EXISTS (\n   121→          SELECT 1 FROM bookings b\n   122→          WHERE b.property_id = p.id\n   123→          AND b.status IN ('confirmed', 'pending')\n   124→          AND b.check_in < ${checkOut || '9999-12-31'}\n   125→          AND b.check_out > ${checkIn || '1970-01-01'}\n   126→        ))\n   127→        AND (${!hasAmenityFilter} OR (\n   128→          SELECT count(*) FROM property_amenities pa\n   129→          WHERE pa.property_id = p.id AND pa.amenity_id::text = ANY(${amenityIds})\n   130→        ) >= ${amenityCount})\n   131→      ORDER BY p.created_at DESC\n   132→      LIMIT ${limit} OFFSET ${offset}\n   133→    `\n   134→\n   135→    return new Response(JSON.stringify({\n   136→      properties,\n   137→      total,\n   138→      page,\n   139→      limit,\n   140→      totalPages: Math.ceil(total / limit),\n   141→    }), { status: 200, headers })\n   142→  }\n   143→\n   144→  if (request.method === 'POST') {\n   145→    const body = await request.json() as {\n   146→      host_id: string\n   147→      title: string\n   148→      description: string\n   149→      property_type: string\n   150→      price_per_night: number\n   151→      cleaning_fee: numbe