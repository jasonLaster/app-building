"my-issues-empty\">\n    54→        <svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--color-text-tertiary)\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n    55→          <circle cx=\"12\" cy=\"12\" r=\"10\" />\n    56→          <line x1=\"8\" y1=\"12\" x2=\"16\" y2=\"12\" />\n    57→        </svg>\n    58→        <p>No issues assigned to you yet</p>\n    59→      </div>\n    60→    );\n    61→  }\n    62→\n    63→  return (\n    64→    <div className=\"my-issues-list\" data-testid=\"my-issues-list\">\n    65→      {groups.map((group) => {\n    66→        const isCollapsed = !!collapsedGroups[group.status];\n    67→        return (\n    68→          <div key={group.status} className=\"my-issues-group\" data-testid={`issue-group-${group.status}`}>\n    69→            <button\n    70→              className=\"my-issues-group-header\"\n    71→              onClick={() => toggleGroup(group.status)}\n    72→              data-testid={`issue-group-header-${group.status}`}\n    73→            >\n    74→              <svg\n    75→                className={`my-issues-group-chevron ${isCollapsed ? '' : 'my-issues-group-chevron-expanded'}`}\n    76→                width=\"12\"\n    77→                height=\"12\"\n    78→                viewBox=\"0 0 24 24\"\n    79→                fill=\"none\"\n    80→                stroke=\"currentColor\"\n    81→                strokeWidth=\"2\"\n    82→                strokeLinecap=\"round\"\n    83→                strokeLinejoin=\"round\"\n    84→              >\n    85→                <polyline points=\"9 18 15 12 9 6\" />\n    86→              </svg>\n    87→              <StatusIcon status={group.status} color={group.color} />\n    88→              <span className=\"my-issues-group-label\">{group.label}</span>\n    89→              <span className=\"my-issues-group-count\">({group.issues.length})</span>\n    90→            </button>\n    91→            {!isCollapsed && (\n    92→              <div className=\"my-issues-group-items\" data-testid={`issue-group-items-${group.status}`}>\n    93→                {group.issues.map((issue) => (\n    94→                  <IssueRow key={issue.id} issue={issue} />\n    95→                ))}\n    96→              </div>\n    97→            )}\n    98→          </div>\n    99→        );\n   100→      })}\n   101→    </div>\n   102→  );\n   103→}\n   104→"}]},"parent_tool_use_id":null,"session_id":"3553acc8-e37d-492f-a872-c9b8ee782554","uuid":"4ae610fa-f297-4eae-8e14-4156bab30473","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/src/components/MyIssuesList.tsx","content":"import { useState, useMemo } from 'react';\nimport type { Issue } from '../slices/issuesSlice';\nimport { STATUS_ORDER, STATUS_CONFIG, StatusIcon } from './IssueRow';\nimport IssueRow from './IssueRow';\nimport './MyIssuesList.css';\n\ninterface MyIssuesListProps {\n  issues: Issue[];\n  loading: boolean;\n}\n\ninterface StatusGroup {\n  status: string;\n  label: string;\n  color: string;\n  issues: Issue[];\n}\n\nexport default function MyIssuesList({ issues, loading }: MyIssuesListProps) {\n  const [collapsedGroups, setCollapsedGroups] = useState<Record<string, boolean>>({});\n\n  const groups: StatusGroup[] = useMemo(() => {\n    const grouped: StatusGroup[] = [];\n    for (const status of STATUS_ORDER) {\n      const config = STATUS_CONFIG[status];\n      const groupIssues = issues.filter((i) => i.status === status);\n      if (groupIssues.length > 0) {\n        grouped.push({\n          status,\n          label: config.label,\n          color: config.color,\n          issues: groupIssues,\n        });\n      }\n    }\n    return grouped;\n  }, [issues]);\n\n  function toggleGroup(status: string) {\n    setCollapsedGroups((prev) => ({ ...prev, [status]: !prev[status] }));\n  }\n\n  if (loading) {\n    return (\n      <div className=\"my-issues-list-loading\" data-testid=\"my-issues-loading\">\n        Loading...\n      </div>\n    );\n  }\n\n  if (issues.length === 0) {\n    return (\n      <div className=\"my-issues-list-empty\" data-testid=\"my-issues-empty\">\n        <svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--color-text-tertiary)\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n          <circle cx=\"12\" cy=\"12\" r=\"10\" />\n          <line x1=\"8\" y1=\"12\" x2=\"16\" y2=\"12\" />\n        </svg>\n        <p>No issues assigned to you yet</p>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"my-issues-list\" data-testid=\"my-issues-list\">\n      {groups.map((group) => {\n        const isCollapsed = !!collapsedGroups[group.status];\n        return (\n          <div key={group.status} className=\"my-issues-group\" data-testid={`issue-group-${group.status}`}>\n            <button\n              className=\"my-issues-group-header\"\n              onClick={() => toggleGroup(group.status)}\n              data-testid={`issue-group-header-${group.status}`}\n            >\n              <svg\n                className={`my-issues-group-chevron ${isCollapsed ? '' : 'my-issues-group-chevron-expanded'}`}\n                width=\"12\"\n                height=\"12\"\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                stroke=\"currentColor\"\n                strokeWidth=\"2\"\n                strokeLinecap=\"round\"\n                strokeLinejoin=\"round\"\n              >\n                <polyline points=\"9 18 15 12 9 6\" />\n              </svg>\n              <StatusIcon status={group.status} color={group.color} />\n              <span className=\"my-issues-group-label\">{group.label}</span>\n              <span className=\"my-issues-group-count\">({group.issues.length})</span>\n            </button>\n            {!isCollapsed && (\n              <div className=\"my-issues-group-items\" data-testid={`issue-group-items-${group.status}`}>\n                {group.issues.map((issue) => (\n                  <IssueRow key={issue.id} issue={issue} />\n                ))}\n              </div>\n            )}\n          </div>\n        );\n      })}\n    </div>\n  );\n}\n","numLines":104,"startLine":1,"totalLines":104}}}
