[2026-03-14T21:29:38.852Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PubHHJrGLV3uTMup8zuNmX","type":"tool_result","content":"     1→import { useEffect, useMemo, useCallback } from 'react';\n     2→import { useSelector, useDispatch } from 'react-redux';\n     3→import { useSearchParams } from 'react-router-dom';\n     4→import type { RootState, AppDispatch } from '../store';\n     5→import { fetchMyIssues } from '../slices/issuesSlice';\n     6→import { fetchLabels } from '../slices/labelsSlice';\n     7→import FiltersToolbar from '../components/FiltersToolbar';\n     8→import MyIssuesList from '../components/MyIssuesList';\n     9→import './MyIssues.css';\n    10→\n    11→function parseParam(params: URLSearchParams, key: string): string[] {\n    12→  const val = params.get(key);\n    13→  return val ? val.split(',').filter(Boolean) : [];\n    14→}\n    15→\n    16→export default function MyIssues() {\n    17→  const dispatch = useDispatch<AppDispatch>();\n    18→  const { token } = useSelector((state: RootState) => state.auth);\n    19→  const { myIssues, loading } = useSelector((state: RootState) => state.issues);\n    20→\n    21→  const [searchParams, setSearchParams] = useSearchParams();\n    22→  const selectedStatuses = useMemo(() => parseParam(searchParams, 'status'), [searchParams]);\n    23→  const selectedPriorities = useMemo(() => parseParam(searchParams, 'priority'), [searchParams]);\n    24→  const selectedLabels = useMemo(() => parseParam(searchParams, 'label'), [searchParams]);\n    25→\n    26→  const updateParam = useCallback((key: string, values: string[]) => {\n    27→    setSearchParams((prev) => {\n    28→      const next = new URLSearchParams(prev);\n    29→      if (values.length > 0) {\n    30→        next.set(key, values.join(','));\n    31→      } else {\n    32→        next.delete(key);\n    33→      }\n    34→      return next;\n    35→    });\n    36→  }, [setSearchParams]);\n    37→\n    38→  const setSelectedStatuses = useCallback((v: string[]) => updateParam('status', v), [updateParam]);\n    39→  const setSelectedPriorities = useCallback((v: string[]) => updateParam('priority', v), [updateParam]);\n    40→  const setSelectedLabels = useCallback((v: string[]) => updateParam('label', v), [updateParam]);\n    41→\n    42→  useEffect(() => {\n    43→    if (token) {\n    44→      dispatch(fetchMyIssues());\n    45→      dispatch(fetchLabels());\n    46→    }\n    47→  }, [dispatch, token]);\n    48→\n    49→  const filteredIssues = useMemo(() => {\n    50→    return myIssues.filter((issue) => {\n    51→      if (selectedStatuses.length > 0 && !selectedStatuses.includes(issue.status)) {\n    52→        return false;\n    53→      }\n    54→      if (selectedPriorities.length > 0 && !selectedPriorities.includes(issue.priority)) {\n    55→        return false;\n    56→      }\n    57→      if (selectedLabels.length > 0) {\n    58→        const issueLabelIds = issue.labels.map((l) => l.id);\n    59→        if (!selectedLabels.some((labelId) => issueLabelIds.includes(labelId))) {\n    60→          return false;\n    61→        }\n    62→      }\n    63→      return true;\n    64→    });\n    65→  }, [myIssues, selectedStatuses, selectedPriorities, selectedLabels]);\n    66→\n    67→  return (\n    68→    <div className=\"my-issues-page\" data-testid=\"my-issues-page\">\n    69→      <div className=\"my-issues-header\">\n    70→        <h1 className=\"my-issues-title\" data-testid=\"my-issues-title\">My Issues</h1>\n    71→      </div>\n    72→      <FiltersToolbar\n    73→        selectedStatuses={selectedStatuses}\n    74→        selectedPriorities={selectedPriorities}\n    75→        selectedLabels={selectedLabels}\n    76→        onStatusChange={setSelectedStatuses}\n    77→        onPriorityChange={setSelectedPriorities}\n    78→        onLabelChange={setSelectedLabels}\n    79→      />\n    80→      <MyIssuesList issues={filteredIssues} loading={loading} />\n    81→    </div>\n    82→  );\n    83→}\n    84→"}]},"parent_tool_use_id":null,"session_id":"3553acc8-e37d-492f-a872-c9b8ee782554","uuid":"e091fb13-fbe6-4b11-a289-17cd5a53867f","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/src/pages/MyIssues.tsx","content":"import { useEffect, useMemo, useCallback } from 'react';\nimport { useSelector, useDispatch } from 'react-redux';\nimport { useSearchParams } from 'react-router-dom';\nimport type { RootState, AppDispatch } from '../store';\nimport { fetchMyIssues } from '../slices/issuesSlice';\nimport { fetchLabels } from '../slices/labelsSlice';\nimport FiltersToolbar from '../components/FiltersToolbar';\nimport MyIssuesList from '../components/MyIssuesList';\nimport './MyIssues.css';\n\nfunction parseParam(params: URLSearchParams, key: string): string[] {\n  const val = params.get(key);\n  return val ? val.split(',').filter(Boolean) : [];\n}\n\nexport default function MyIssues() {\n  const dispatch = useDispatch<AppDispatch>();\n  const { token } = useSelector((state: RootState) => state.auth);\n  const { myIssues, loading } = useSelector((state: RootState) => state.issues);\n\n  const [searchParams, setSearchParams] = useSearchParams();\n  const selectedStatuses = useMemo(() => parseParam(searchParams, 'status'), [searchParams]);\n  const selectedPriorities = useMemo(() => parseParam(searchParams, 'priority'), [searchParams]);\n  const selectedLabels = useMemo(() => parseParam(searchParams, 'label'), [searchParams]);\n\n  const updateParam = useCallback((key: string, values: string[]) => {\n    setSearchParams((prev) => {\n      const next = new URLSearchParams(prev);\n      if (values.length > 0) {\n        next.set(key, values.join(','));\n      } else {\n        next.delete(key);\n      }\n      return next;\n    });\n  }, [setSearchParams]);\n\n  const setSelectedStatuses = useCallback((v: string[]) => updateParam('status', v), [updateParam]);\n  const setSelectedPriorities = useCallback((v: string[]) => updateParam('priority', v), [updateParam]);\n  const setSelectedLabels = useCallback((v: string[]) => updateParam('label', v), [updateParam]);\n\n  useEffect(() => {\n    if (token) {\n      dispatch(fetchMyIssues());\n      dispatch(fetchLabels());\n    }\n  }, [dispatch, token]);\n\n  const filteredIssues = useMemo(() => {\n    return myIssues.filter((issue) => {\n      if (selectedStatuses.length > 0 && !selectedStatuses.includes(issue.status)) {\n        return false;\n      }\n      if (selectedPriorities.length > 0 && !selectedPriorities.includes(issue.priority)) {\n        return false;\n      }\n      if (selectedLabels.length > 0) {\n        const issueLabelIds = issue.labels.map((l) => l.id);\n        if (!selectedLabels.some((labelId) => issueLabelIds.includes(labelId))) {\n          return false;\n        }\n      }\n      return true;\n    });\n  }, [myIssues, selectedStatuses, selectedPriorities, selectedLabels]);\n\n  return (\n    <div className=\"my-issues-page\" data-testid=\"my-issues-page\">\n      <div className=\"my-issues-header\">\n        <h1 className=\"my-issues-title\" data-testid=\"my-issues-title\">My Issues</h1>\n      </div>\n      <FiltersToolbar\n        selectedStatuses={selectedStatuses}\n        selectedPriorities={selectedPriorities}\n        selectedLabels={selectedLabels}\n        onStatusChange={setSelectedStatuses}\n        onPriorityChange={setSelectedPriorities}\n        onLabelChange={setSelectedLabels}\n      />\n      <MyIssuesList issues={filteredIssues} loading={loading} />\n    </div>\n  );\n}\n","numLines":84,"startLine":1,"totalLines":84}}}
