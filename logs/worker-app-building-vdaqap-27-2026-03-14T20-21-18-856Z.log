il?: string\n   115→      phone?: string\n   116→      passengerType: string\n   117→    }>\n   118→  }) => {\n   119→    const res = await fetch('/api/bookings', {\n   120→      method: 'POST',\n   121→      headers: { 'Content-Type': 'application/json' },\n   122→      body: JSON.stringify(params),\n   123→    })\n   124→    if (!res.ok) {\n   125→      throw new Error('Booking failed. Please try again.')\n   126→    }\n   127→    return res.json() as Promise<{\n   128→      id: string\n   129→      bookingReference: string\n   130→      status: string\n   131→      createdAt: string\n   132→    }>\n   133→  }\n   134→)\n   135→\n   136→const bookingSlice = createSlice({\n   137→  name: 'booking',\n   138→  initialState,\n   139→  reducers: {\n   140→    initializePassengers(state, action: PayloadAction<{ adults: number; children: number; infants: number }>) {\n   141→      const passengers: PassengerInfo[] = []\n   142→      for (let i = 0; i < action.payload.adults; i++) {\n   143→        passengers.push({\n   144→          firstName: '', lastName: '', dateOfBirth: '', gender: '',\n   145→          email: '', phone: '', passengerType: 'adult',\n   146→        })\n   147→      }\n   148→      for (let i = 0; i < action.payload.children; i++) {\n   149→        passengers.push({\n   150→          firstName: '', lastName: '', dateOfBirth: '', gender: '',\n   151→          email: '', phone: '', passengerType: 'child',\n   152→        })\n   153→      }\n   154→      for (let i = 0; i < action.payload.infants; i++) {\n   155→        passengers.push({\n   156→          firstName: '', lastName: '', dateOfBirth: '', gender: '',\n   157→          email: '', phone: '', passengerType: 'infant',\n   158→        })\n   159→      }\n   160→      state.passengers = passengers\n   161→      state.validationErrors = {}\n   162→      state.bookingComplete = false\n   163→      state.bookingReference = null\n   164→      state.bookingError = null\n   165→    },\n   166→    updatePassenger(state, action: PayloadAction<{ index: number; field: keyof PassengerInfo; value: string }>) {\n   167→      const p = state.passengers[action.payload.index]\n   168→      if (p) {\n   169→        ;(p[action.payload.field] as string) = action.payload.value\n   170→      }\n   171→      // Clear validation error for this field\n   172→      delete state.validationErrors[`${action.payload.index}-${action.payload.field}`]\n   173→    },\n   174→    setValidationErrors(state, action: PayloadAction<Record<string, string>>) {\n   175→      state.validationErrors = action.payload\n   176→    },\n   177→    resetBooking(state) {\n   178→      state.flight = null\n   179→      state.legs = []\n   180→      state.returnFlight = null\n   181→      state.returnLegs = []\n   182→      state.loading = false\n   183→      state.error = null\n   184→      state.passengers = []\n   185→      state.validationErrors = {}\n   186→      state.bookingInProgress = false\n   187→      state.bookingComplete = false\n   188→      state.bookingReference = null\n   189→      state.bookingError = null\n   190→    },\n   191→  },\n   192→  extraReducers: (builder) => {\n   193→    builder\n   194→      .addCase(fetchFlightForBooking.pending, (state) => {\n   195→        state.loading = true\n   196→        state.error = null\n   197→      })\n   198→      .addCase(fetchFlightForBooking.fulfilled, (state, action) => {\n   199→        state.flight = action.payload.flight\n   200→        state.legs = action.payload.legs\n   201→        state.loading = false\n   202→      })\n   203→      .addCase(fetchFlightForBooking.rejected, (state, action) => {\n   204→        state.loading = false\n   205→        state.error = action.error.message || 'Failed to load flight details'\n   206→      })\n   207→      .addCase(fetchReturnFlightForBooking.fulfilled, (state, action) => {\n   208→        state.returnFlight = action.payload.flight\n   209→        state.returnLegs = action.payload.legs\n   210→      })\n   211→      .addCase(fetchReturnFlightForBooking.rejected, (state) => {\n   212→        state.returnFlight = null\n   213→        state.returnLegs = []\n   214→      })\n   215→      .addCase(createBooking.pending, (state) => {\n   216→        state.bookingInProgress = true\n   217→        state.bookingError = null\n   218→      })\n   219→      .addCase(createBooking.fulfilled, (state, action) => {\n   220→        state.bookingInProgress = false\n   221→        state.bookingComplete = true\n   222→        state.bookingReference = action.payload.bookingReference\n   223→      })\n   224→      .addCase(createBooking.rejected, (state, action) => {\n   225→        state.bookingInProgress = false\n   226→        state.bookingError = action.error.message || 'Booking failed. Please try again.'\n   227→      })\n   228→  },\n   229→})\n   230→\n   231→export const {\n   232→  initializePassengers,\n   233→  updatePassenger,\n   234→  setValidationErrors,\n   235→  resetBooking,\n   236→} = bookingSlice.actions\n   237→\n   238→export default bookingSlice.reducer\n   239→"}]},"parent_tool_use_id":null,"session_id":"19b0156b-6b8d-4bf8-87d9-d30f04f0aedb","uuid":"a784d769-da0a-42d6-a51c-12b46470c839","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/GoogleFlights/src/slices/bookingSlice.ts","content":"import { createSlice, createAsyncThunk, type PayloadAction } from '@reduxjs/toolkit'\nimport type { FlightLeg } from './flightsSlice'\n\nexport interface PassengerInfo {\n  firstName: string\n  lastName: string\n  dateOfBirth: string\n  gender: string\n  email: string\n  phone: string\n  passengerType: 'adult' | 'child' | 'infant'\n}\n\nexport interface BookingFlightDetail {\n  id: string\n  flight_number: string\n  departure_time: string\n  arrival_time: string\n  duration_minutes: number\n  aircraft_type: string\n  has_wifi: boolean\n  has_power: boolean\n  has_entertainment: boolean\n  co2_kg: number\n  airline_name: string\n  airline_code: string\n  logo_color: string\n  origin_code: string\n  origin_name: string\n  origin_city: string\n  dest_code: string\n  dest_name: string\n  dest_city: string\n  base_price_cents: number\n  taxes_cents: number\n  total_price_cents: number\n  cabin_class: string\n  available_seats: number\n}\n\ninterface BookingState {\n  flight: BookingFlightDetail | null\n  legs: FlightLeg[]\n  returnFlight: BookingFlightDetail | null\n  returnLegs: FlightLeg[]\n  loading: boolean\n  error: string | null\n  passengers: PassengerInfo[]\n  validationErrors: Record<string, string>\n  bookingInProgress: boolean\n  bookingComplete: boolean\n  bookingReference: string | null\n  bookingError: string | null\n}\n\nconst initialState: BookingState = {\n  flight: null,\n  legs: [],\n  returnFlight: null,\n  returnLegs: [],\n  loading: false,\n  error: null,\n  passengers: [],\n  validationErrors: {},\n  bookingInProgress: false,\n  bookingComplete: false,\n  bookingReference: null,\n  bookingError: null,\n}\n\nexport const fetchFlightForBooking = createAsyncThunk(\n  'booking/fetchFlightForBooking',\n  async (params: { flightId: string; cabinClass: string }) => {\n    const qs = new URLSearchParams({\n      flightId: params.flightId,\n      cabinClass: params.cabinClass,\n    })\n    const res = await fetch(`/api/bookings?${qs}`)\n    if (!res.ok) {\n      throw new Error('Failed to fetch flight details')\n    }\n    return res.json() as Promise<{ flight: BookingFlightDetail; legs: FlightLeg[] }>\n  }\n)\n\nexport const fetchReturnFlightForBooking = createAsyncThunk(\n  'booking/fetchReturnFlightForBooking',\n  async (params: { flightId: string; cabinClass: string }) => {\n    const qs = new URLSearchParams({\n      flightId: params.flightId,\n      cabinClass: params.cabinClass,\n    })\n    const res = await fetch(`/api/bookings?${qs}`)\n    if (!res.ok) {\n      throw new Error('Failed to fetch return flight details')\n    }\n    return res.json() as Promise<{ flight: BookingFlightDetail; legs: FlightLeg[] }>\n  }\n)\n\nexport const createBooking = createAsyncThunk(\n  'booking/createBooking',\n  async (params: {\n    sessionToken: string\n    flightId: string\n    returnFlightId?: string\n    cabinClass: string\n    totalPriceCents: number\n    passengers: Array<{\n      firstName: string\n      lastName: string\n      dateOfBirth: string\n      gender: string\n      email?: string\n      phone?: string\n      passengerType: string\n    }>\n  }) => {\n    const res = await fetch('/api/bookings', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify(params),\n    })\n    if (!res.ok) {\n      throw new Error('Booking failed. Please try again.')\n    }\n    return res.json() as Promise<{\n      id: string\n      bookingReference: string\n      status: string\n      createdAt: string\n    }>\n  }\n)\n\nconst bookingSlice = createSlice({\n  name: 'booking',\n  initialState,\n  reducers: {\n    initializePassengers(state, action: PayloadAction<{ adults: number; children: number; infants: number }>) {\n      const passengers: PassengerInfo[] = []\n      for (let i = 0; i < action.payload.adults; i++) {\n        passengers.push({\n          firstName: '', lastName: '', dateOfBirth: '', gender: '',\n          email: '', phone: '', passengerType: 'adult',\n        })\n      }\n      for (let i = 0; i < action.payload.children; i++) {\n        passengers.push({\n          firstName: '', lastName: '', dateOfBirth: '', gender: '',\n          email: '', phone: '', passengerType: 'child',\n        })\n      }\n      for (let i = 0; i < action.payload.infants; i++) {\n        passengers.push({\n          firstName: '', lastName: '', dateOfBirth: '', gender: '',\n          email: '', phone: '', passengerType: 'infant',\n        })\n      }\n      state.passengers = passengers\n      state.validationErrors = {}\n      state.bookingComplete = false\n      state.bookingReference = null\n      state.bookingError = null\n    },\n    updatePassenger(state, action: PayloadAction<{ index: number; field: keyof PassengerInfo; value: string }>) {\n      const p = state.passengers[action.payload.index]\n      if (p) {\n        ;(p[action.payload.field] as string) = action.payload.value\n      }\n      // Clear validation error for this field\n      delete state.validationErrors[`${action.payload.index}-${action.payload.field}`]\n    },\n    setValidationErrors(state, action: PayloadAction<Record<string, string>>) {\n      state.validationErrors = action.payload\n    },\n    resetBooking(state) {\n      state.flight = null\n      state.legs = []\n      state.returnFlight = null\n      state.returnLegs = []\n      state.loading = false\n      state.error = null\n      state.passengers = []\n      state.validationErrors = {}\n      state.bookingInProgress = false\n      state.bookingComplete = false\n      state.bookingReference = null\n      state.bookingError = null\n    },\n  },\n  extraReducers: (builder) => {\n    builder\n      .addCase(fetchFlightForBooking.pending, (state) => {\n        state.loading = true\n        state.error = null\n      })\n      .addCase(fetchFlightForBooking.fulfilled, (state, action) => {\n        state.flight = action.payload.flight\n        state.legs = action.payload.legs\n        state.loading = false\n      })\n      .addCase(fetchFlightForBooking.rejected, (state, action) => {\n        state.loading = false\n        state.error = action.error.message || 'Failed to load flight details'\n      })\n      .addCase(fetchReturnFlightForBooking.fulfilled, (state, action) => {\n        state.returnFlight = action.payload.flight\n        state.returnLegs = action.payload.legs\n      })\n      .addCase(fetchReturnFlightForBooking.rejected, (state) => {\n        state.returnFlight = null\n        state.returnLegs = []\n      })\n      .addCase(createBooking.pending, (state) => {\n        state.bookingInProgress = true\n        state.bookingError = null\n      })\n      .addCase(createBooking.fulfilled, (state, action) => {\n        state.bookingInProgress = false\n        state.bookingComplete = true\n        state.bookingReference = action.payload.bookingReference\n      })\n      .addCase(createBooking.rejected, (state, action) => {\n        state.bookingInProgress = false\n        state.bookingError = action.error.message || 'Booking failed. Please try again.'\n      })\n  },\n})\n\nexport const {\n  initializePassengers,\n  updatePassenger,\n  setValidationErrors,\n  resetBooking,\n} = bookingSlice.actions\n\nexport default bookingSlice.reducer\n","numLines":239,"startLine":1,"totalLines":239}}}
