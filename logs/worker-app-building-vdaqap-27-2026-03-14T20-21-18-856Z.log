urnFlight.taxes_cents * (adults + children) : 0)\n    77→  const totalPriceCents =\n    78→    (adultBaseFare + returnAdultBase) * adults +\n    79→    (childBaseFare + returnChildBase) * children +\n    80→    (infantBaseFare + returnInfantBase) * infants +\n    81→    totalTaxes\n    82→\n    83→  return (\n    84→    <div className=\"flight-details-page p-6 max-sm:p-3\" data-testid=\"flight-details-page\">\n    85→      <div className=\"flight-details-page__header\">\n    86→        <button\n    87→          className=\"flight-details-page__back-link\"\n    88→          onClick={() => navigate(-1)}\n    89→          data-testid=\"flight-details-back\"\n    90→        >\n    91→          ← Back to results\n    92→        </button>\n    93→        <h1 className=\"flight-details-page__title\">Flight Details & Booking</h1>\n    94→      </div>\n    95→\n    96→      <div className=\"flight-details-page__content\">\n    97→        <div className=\"flight-details-page__main\">\n    98→          <div className=\"flight-details-page__section\">\n    99→            <FlightSummary\n   100→              flight={flight}\n   101→              legs={legs}\n   102→              label={`Outbound · ${flight.origin_code} → ${flight.dest_code}`}\n   103→            />\n   104→          </div>\n   105→\n   106→          {returnFlight && (\n   107→            <div className=\"flight-details-page__section\" data-testid=\"return-flight-section\">\n   108→              <FlightSummary\n   109→                flight={returnFlight}\n   110→                legs={returnLegs}\n   111→                label={`Return · ${returnFlight.origin_code} → ${returnFlight.dest_code}`}\n   112→              />\n   113→            </div>\n   114→          )}\n   115→\n   116→          <div className=\"flight-details-page__section\">\n   117→            <PassengerForm />\n   118→          </div>\n   119→        </div>\n   120→\n   121→        <div className=\"flight-details-page__sidebar\">\n   122→          <div className=\"flight-details-page__section\">\n   123→            <PriceBreakdown\n   124→              flight={flight}\n   125→              passengers={{ adults, children, infants }}\n   126→              returnFlight={returnFlight}\n   127→            />\n   128→          </div>\n   129→\n   130→          <div className=\"flight-details-page__section\">\n   131→            <BookingAction\n   132→              flightId={flight.id}\n   133→              returnFlightId={returnFlightId || undefined}\n   134→              cabinClass={cabinClass}\n   135→              totalPriceCents={totalPriceCents}\n   136→            />\n   137→          </div>\n   138→\n   139→          {bookingComplete && (\n   140→            <button\n   141→              className=\"flight-details-page__trips-link\"\n   142→              onClick={() => navigate('/trips')}\n   143→              data-testid=\"view-trips-button\"\n   144→            >\n   145→              View My Trips\n   146→            </button>\n   147→          )}\n   148→        </div>\n   149→      </div>\n   150→    </div>\n   151→  )\n   152→}\n   153→\n   154→export default FlightDetailsPage\n   155→"}]},"parent_tool_use_id":null,"session_id":"19b0156b-6b8d-4bf8-87d9-d30f04f0aedb","uuid":"6ca6f1b3-143d-47c2-bd0b-895f272ee60b","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/GoogleFlights/src/pages/FlightDetailsPage.tsx","content":"import { useEffect } from 'react'\nimport { useParams, useSearchParams, useNavigate } from 'react-router-dom'\nimport { useSelector, useDispatch } from 'react-redux'\nimport type { RootState, AppDispatch } from '../store'\nimport { fetchFlightForBooking, fetchReturnFlightForBooking, initializePassengers, resetBooking } from '../slices/bookingSlice'\nimport FlightSummary from '../components/FlightSummary'\nimport PriceBreakdown from '../components/PriceBreakdown'\nimport PassengerForm from '../components/PassengerForm'\nimport BookingAction from '../components/BookingAction'\nimport './FlightDetailsPage.css'\n\nfunction FlightDetailsPage() {\n  const { id } = useParams<{ id: string }>()\n  const [searchParams] = useSearchParams()\n  const navigate = useNavigate()\n  const dispatch = useDispatch<AppDispatch>()\n\n  const cabinClass = searchParams.get('cabin') || 'economy'\n  const adults = parseInt(searchParams.get('adults') || '1', 10)\n  const children = parseInt(searchParams.get('children') || '0', 10)\n  const infants = parseInt(searchParams.get('infants') || '0', 10)\n  const returnFlightId = searchParams.get('returnFlight') || null\n\n  const { flight, legs, returnFlight, returnLegs, loading, error, bookingComplete } = useSelector(\n    (state: RootState) => state.booking\n  )\n\n  useEffect(() => {\n    if (id) {\n      dispatch(resetBooking())\n      dispatch(fetchFlightForBooking({ flightId: id, cabinClass }))\n      if (returnFlightId) {\n        dispatch(fetchReturnFlightForBooking({ flightId: returnFlightId, cabinClass }))\n      }\n      dispatch(initializePassengers({ adults, children, infants }))\n    }\n  }, [id, returnFlightId, cabinClass, adults, children, infants, dispatch])\n\n  if (loading) {\n    return (\n      <div className=\"flight-details-page p-6 max-sm:p-3\" data-testid=\"flight-details-page\">\n        <div className=\"flight-details-page__loading\" data-testid=\"flight-details-loading\">\n          <div className=\"flight-details-page__loading-spinner\" />\n          <span>Loading flight details...</span>\n        </div>\n      </div>\n    )\n  }\n\n  if (error || !flight) {\n    return (\n      <div className=\"flight-details-page p-6 max-sm:p-3\" data-testid=\"flight-details-page\">\n        <div className=\"flight-details-page__error\" data-testid=\"flight-details-error\">\n          <h2>Flight not found</h2>\n          <p>{error || 'Unable to load flight details.'}</p>\n          <button\n            className=\"flight-details-page__back-button\"\n            onClick={() => navigate(-1)}\n            data-testid=\"flight-details-back\"\n          >\n            ← Back to results\n          </button>\n        </div>\n      </div>\n    )\n  }\n\n  // Calculate total price for BookingAction\n  const adultBaseFare = flight.base_price_cents\n  const childBaseFare = Math.round(flight.base_price_cents * 0.75)\n  const infantBaseFare = Math.round(flight.base_price_cents * 0.1)\n  const returnAdultBase = returnFlight ? returnFlight.base_price_cents : 0\n  const returnChildBase = returnFlight ? Math.round(returnFlight.base_price_cents * 0.75) : 0\n  const returnInfantBase = returnFlight ? Math.round(returnFlight.base_price_cents * 0.1) : 0\n  const totalTaxes = flight.taxes_cents * (adults + children)\n    + (returnFlight ? returnFlight.taxes_cents * (adults + children) : 0)\n  const totalPriceCents =\n    (adultBaseFare + returnAdultBase) * adults +\n    (childBaseFare + returnChildBase) * children +\n    (infantBaseFare + returnInfantBase) * infants +\n    totalTaxes\n\n  return (\n    <div className=\"flight-details-page p-6 max-sm:p-3\" data-testid=\"flight-details-page\">\n      <div className=\"flight-details-page__header\">\n        <button\n          className=\"flight-details-page__back-link\"\n          onClick={() => navigate(-1)}\n          data-testid=\"flight-details-back\"\n        >\n          ← Back to results\n        </button>\n        <h1 className=\"flight-details-page__title\">Flight Details & Booking</h1>\n      </div>\n\n      <div className=\"flight-details-page__content\">\n        <div className=\"flight-details-page__main\">\n          <div className=\"flight-details-page__section\">\n            <FlightSummary\n              flight={flight}\n              legs={legs}\n              label={`Outbound · ${flight.origin_code} → ${flight.dest_code}`}\n            />\n          </div>\n\n          {returnFlight && (\n            <div className=\"flight-details-page__section\" data-testid=\"return-flight-section\">\n              <FlightSummary\n                flight={returnFlight}\n                legs={returnLegs}\n                label={`Return · ${returnFlight.origin_code} → ${returnFlight.dest_code}`}\n              />\n            </div>\n          )}\n\n          <div className=\"flight-details-page__section\">\n            <PassengerForm />\n          </div>\n        </div>\n\n        <div className=\"flight-details-page__sidebar\">\n          <div className=\"flight-details-page__section\">\n            <PriceBreakdown\n              flight={flight}\n              passengers={{ adults, children, infants }}\n              returnFlight={returnFlight}\n            />\n          </div>\n\n          <div className=\"flight-details-page__section\">\n            <BookingAction\n              flightId={flight.id}\n              returnFlightId={returnFlightId || undefined}\n              cabinClass={cabinClass}\n              totalPriceCents={totalPriceCents}\n            />\n          </div>\n\n          {bookingComplete && (\n            <button\n              className=\"flight-details-page__trips-link\"\n              onClick={() => navigate('/trips')}\n              data-testid=\"view-trips-button\"\n            >\n              View My Trips\n            </button>\n          )}\n        </div>\n      </div>\n    </div>\n  )\n}\n\nexport default FlightDetailsPage\n","numLines":155,"startLine":1,"totalLines":155}}}
