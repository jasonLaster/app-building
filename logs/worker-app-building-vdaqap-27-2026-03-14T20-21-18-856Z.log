ct(overnightNote).toContainText('+1')\n   251→\n   252→    // The +1 day indicator should also show on the leg arrival time\n   253→    const dayIndicator = page.getByTestId('flight-summary-day-1')\n   254→    await expect(dayIndicator).toBeVisible()\n   255→    await expect(dayIndicator).toContainText('+1')\n   256→  })\n   257→\n   258→  test('FlightSummary shows aircraft type and amenities', async ({ page }) => {\n   259→    // B6400: LAX→JFK, Airbus A321, wifi=true, power=true, entertainment=false\n   260→    await navigateToBookingPage(page, { flightNumber: 'B6400' })\n   261→\n   262→    // Aircraft type should be displayed\n   263→    await expect(page.getByTestId('flight-summary-aircraft-1')).toContainText('Airbus A321')\n   264→\n   265→    // Amenities section\n   266→    const amenities = page.getByTestId('flight-summary-amenities')\n   267→    await expect(amenities).toBeVisible()\n   268→\n   269→    // Wi-Fi should be shown\n   270→    await expect(page.getByTestId('flight-summary-wifi')).toBeVisible()\n   271→    await expect(page.getByTestId('flight-summary-wifi')).toContainText('Wi-Fi')\n   272→\n   273→    // Power should be shown\n   274→    await expect(page.getByTestId('flight-summary-power')).toBeVisible()\n   275→    await expect(page.getByTestId('flight-summary-power')).toContainText('Power')\n   276→\n   277→    // Entertainment should NOT be shown (has_entertainment=false)\n   278→    await expect(page.getByTestId('flight-summary-entertainment')).not.toBeVisible()\n   279→  })\n   280→\n   281→  test('FlightSummary shows baggage allowance', async ({ page }) => {\n   282→    // Economy flight: \"1 carry-on bag, 1 personal item\"\n   283→    await navigateToBookingPage(page, { cabinClass: 'economy' })\n   284→\n   285→    const baggage = page.getByTestId('flight-summary-baggage')\n   286→    await expect(baggage).toBeVisible()\n   287→    await expect(baggage).toContainText('1 carry-on bag, 1 personal item')\n   288→\n   289→    // Premium economy: \"1 carry-on bag, 1 checked bag included\"\n   290→    await navigateToBookingPage(page, { cabinClass: 'premium_economy' })\n   291→    await expect(page.getByTestId('flight-summary-baggage')).toContainText('1 carry-on bag, 1 checked bag included')\n   292→\n   293→    // Business: \"2 carry-on bags, 2 checked bags included\"\n   294→    await navigateToBookingPage(page, { cabinClass: 'business' })\n   295→    await expect(page.getByTestId('flight-summary-baggage')).toContainText('2 carry-on bags, 2 checked bags included')\n   296→  })\n   297→})\n   298→"}]},"parent_tool_use_id":"toolu_01LNVNgAgCQ7h9PXsinS51jT","session_id":"19b0156b-6b8d-4bf8-87d9-d30f04f0aedb","uuid":"2ff7489d-b586-4364-809d-113521f70c24"}
