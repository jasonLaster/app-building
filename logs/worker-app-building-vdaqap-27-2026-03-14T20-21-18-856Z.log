[2026-03-14T20:17:51.598Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HY4zckqwy5YJ6pv2fSyXJv","type":"tool_result","content":"     1→import { useEffect } from 'react'\n     2→import { useParams, useSearchParams, useNavigate } from 'react-router-dom'\n     3→import { useSelector, useDispatch } from 'react-redux'\n     4→import type { RootState, AppDispatch } from '../store'\n     5→import { fetchFlightForBooking, fetchReturnFlightForBooking, initializePassengers, resetBooking } from '../slices/bookingSlice'\n     6→import FlightSummary from '../components/FlightSummary'\n     7→import PriceBreakdown from '../components/PriceBreakdown'\n     8→import PassengerForm from '../components/PassengerForm'\n     9→import BookingAction from '../components/BookingAction'\n    10→import './FlightDetailsPage.css'\n    11→\n    12→function FlightDetailsPage() {\n    13→  const { id } = useParams<{ id: string }>()\n    14→  const [searchParams] = useSearchParams()\n    15→  const navigate = useNavigate()\n    16→  const dispatch = useDispatch<AppDispatch>()\n    17→\n    18→  const cabinClass = searchParams.get('cabin') || 'economy'\n    19→  const adults = parseInt(searchParams.get('adults') || '1', 10)\n    20→  const children = parseInt(searchParams.get('children') || '0', 10)\n    21→  const infants = parseInt(searchParams.get('infants') || '0', 10)\n    22→  const returnFlightId = searchParams.get('returnFlight') || null\n    23→\n    24→  const { flight, legs, returnFlight, returnLegs, loading, error, bookingComplete } = useSelector(\n    25→    (state: RootState) => state.booking\n    26→  )\n    27→\n    28→  useEffect(() => {\n    29→    if (id) {\n    30→      dispatch(resetBooking())\n    31→      dispatch(fetchFlightForBooking({ flightId: id, cabinClass }))\n    32→      if (returnFlightId) {\n    33→        dispatch(fetchReturnFlightForBooking({ flightId: returnFlightId, cabinClass }))\n    34→      }\n    35→      dispatch(initializePassengers({ adults, children, infants }))\n    36→    }\n    37→  }, [id, returnFlightId, cabinClass, adults, children, infants, dispatch])\n    38→\n    39→  if (loading) {\n    40→    return (\n    41→      <div className=\"flight-details-page p-6 max-sm:p-3\" data-testid=\"flight-details-page\">\n    42→        <div className=\"flight-details-page__loading\" data-testid=\"flight-details-loading\">\n    43→          <div className=\"flight-details-page__loading-spinner\" />\n    44→          <span>Loading flight details...</span>\n    45→        </div>\n    46→      </div>\n    47→    )\n    48→  }\n    49→\n    50→  if (error || !flight) {\n    51→    return (\n    52→      <div className=\"flight-details-page p-6 max-sm:p-3\" data-testid=\"flight-details-page\">\n    53→        <div className=\"flight-details-page__error\" data-testid=\"flight-details-error\">\n    54→          <h2>Flight not found</h2>\n    55→          <p>{error || 'Unable to load flight details.'}</p>\n    56→          <button\n    57→            className=\"flight-details-page__back-button\"\n    58→            onClick={() => navigate(-1)}\n    59→            data-testid=\"flight-details-back\"\n    60→          >\n    61→            ← Back to results\n    62→          </button>\n    63→        </div>\n    64→      </div>\n    65→    )\n    66→  }\n    67→\n    68→  // Calculate total price for BookingAction\n    69→  const adultBaseFare = flight.base_price_cents\n    70→  const childBaseFare = Math.round(flight.base_price_cents * 0.75)\n    71→  const infantBaseFare = Math.round(flight.base_price_cents * 0.1)\n    72→  const returnAdultBase = returnFlight ? returnFlight.base_price_cents : 0\n    73→  const returnChildBase = returnFlight ? Math.round(returnFlight.base_price_cents * 0.75) : 0\n    74→  const returnInfantBase = returnFlight ? Math.round(returnFlight.base_price_cents * 0.1) : 0\n    75→  const totalTaxes = flight.taxes_cents * (adults + children)\n    76→    + (returnFlight ? returnFlight.taxes_cents * (adults + children) : 0)\n    77→  const totalPriceCents =\n    78→    (adultBaseFare + returnAdultBase) * adults +\n    79→    (childBaseFare + returnChildBase) * children +\n    80→    (infantBaseFare + returnInfantBase) * infants +\n    81→    totalTaxes\n    82→\n    83→  return (\n    84→    <div className=\"flight-details-page p-6 max-sm:p-3\" data-testid=\"flight-details-page\">\n    85→      <div className=\"flight-details-page__header\">\n    86→        <button\n    87→          className=\"flight-details-page__back-link\"\n    88→          onClick={() => navigate(-1)}\n    89→          data-testid=\"flight-details-back\"\n    90→        >\n    91→          ← Back to results\n    92→        </button>\n    93→        <h1 className=\"flight-details-page__title\">Flight Details & Booking</h1>\n    94→      </div>\n    95→\n    96→      <div className=\"flight-details-page__content\">\n    97→        <div className=\"flight-details-page__main\">\n    98→          <div className=\"flight-details-page__section\">\n    99→            <FlightSummary\n   100→              flight={flight}\n   101→              legs={legs}\n   102→              label={`Outbound · ${flight.origin_code} → ${flight.dest_code}`}\n   103→            />\n   104→          </div>\n   105→\n   106→          {returnFlight && (\n   107→            <div className=\"flight-details-page__section\" data-testid=\"return-flight-section\">\n   108→              <FlightSummary\n   109→                flight={returnFlight}\n   110→                legs={returnLegs}\n   111→                label={`Return · ${returnFlight.origin_code} → ${returnFlight.dest_code}`}\n   112→              />\n   113→            </div>\n   114→          )}\n   115→\n   116→          <div className=\"flight-details-page__section\">\n   117→            <PassengerForm />\n   118→          </div>\n   119→        </div>\n   120→\n   121→        <div className=\"flight-details-page__sidebar\">\n   122→          <div className=\"flight-details-page__section\">\n   123→            <PriceBreakdown\n   124→              flight={flight}\n   125→              passengers={{ adults, children, infants }}\n   126→              returnFlight={returnFlight}\n   127→            />\n   128→          </div>\n   129→\n   130→          <div className=\"flight-details-page__section\">\n   131→            <BookingAction\n   132→              flightId={flight.id}\n   133→              returnFlightId={returnFlightId || undefined}\n   134→              cabinClass={cabinClass}\n   135→              totalPriceCents={totalPriceCents}\n   136→            />\n   137→          </div>\n   138→\n   139→          {bookingComplete && (\n   140→            <button\n   141→              className=\"flight-details-page__trips-link\"\n   142→              onClick={() => navigate('/trips')}\n   143→              data-testid=\"view-trips-button\"\n   144→            >\n   145→              View My Trips\n   146→            </button>\n   147→          )}\n   148→        </div>\n   149→      </div>\n   150→    </div>\n   151→  )\n   152→}\n   153→\n   154→export default FlightDetailsPage\n   155→"}]},"parent_tool_use_id":"toolu_01LNVNgAgCQ7h9PXsinS51jT","session_id":"19b0156b-6b8d-4bf8-87d9-d30f04f0aedb","uuid":"7e766e18-2569-417d-b3db-d26a668191c3"}
