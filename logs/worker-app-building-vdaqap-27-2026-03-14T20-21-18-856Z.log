of airportRows) {\n    93→    airportMap.set(row.iata_code as string, row.id as string)\n    94→  }\n    95→\n    96→  const airlineRows = await sql`SELECT id, iata_code FROM airlines`\n    97→  const airlineMap = new Map<string, string>()\n    98→  for (const row of airlineRows) {\n    99→    airlineMap.set(row.iata_code as string, row.id as string)\n   100→  }\n   101→\n   102→  // Helper function to create flights with prices\n   103→  async function createFlight(\n   104→    airlineCode: string,\n   105→    flightNum: string,\n   106→    originCode: string,\n   107→    destCode: string,\n   108→    depTime: string,\n   109→    arrTime: string,\n   110→    durationMin: number,\n   111→    aircraft: string,\n   112→    wifi: boolean,\n   113→    power: boolean,\n   114→    entertainment: boolean,\n   115→    co2: number,\n   116→    economyPrice: number,\n   117→    stops: { origin: string; dest: string; dep: string; arr: string; dur: number; terminal_dep?: string; terminal_arr?: string }[] | null = null\n   118→  ) {\n   119→    const airlineId = airlineMap.get(airlineCode)\n   120→    const originId = airportMap.get(originCode)\n   121→    const destId = airportMap.get(destCode)\n   122→    if (!airlineId || !originId || !destId) return\n   123→\n   124→    const flightRows = await sql`\n   125→      INSERT INTO flights (airline_id, flight_number, origin_airport_id, destination_airport_id, departure_time, arrival_time, duration_minutes, aircraft_type, has_wifi, has_power, has_entertainment, co2_kg)\n   126→      VALUES (${airlineId}, ${flightNum}, ${originId}, ${destId}, ${depTime}, ${arrTime}, ${durationMin}, ${aircraft}, ${wifi}, ${power}, ${entertainment}, ${co2})\n   127→      RETURNING id\n   128→    `\n   129→    const flightRow = flightRows[0]\n   130→    if (!flightRow) return\n   131→    const flightId = flightRow.id as string\n   132→\n   133→    // Add legs\n   134→    if (stops && stops.length > 0) {\n   135→      for (let i = 0; i < stops.length; i++) {\n   136→        const stop = stops[i]!\n   137→        const legOriginId = airportMap.get(stop.origin)\n   138→        const legDestId = airportMap.get(stop.dest)\n   139→        if (!legOriginId || !legDestId) continue\n   140→        await sql`\n   141→          INSERT INTO flight_legs (flight_id, leg_order, origin_airport_id, destination_airport_id, departure_time, arrival_time, duration_minutes, airline_id, flight_number, aircraft_type, terminal_departure, terminal_arrival)\n   142→          VALUES (${flightId}, ${i + 1}, ${legOriginId}, ${legDestId}, ${stop.dep}, ${stop.arr}, ${stop.dur}, ${airlineId}, ${flightNum}, ${aircraft}, ${stop.terminal_dep || null}, ${stop.terminal_arr || null})\n   143→        `\n   144→      }\n   145→    } else {\n   146→      await sql`\n   147→        INSERT INTO flight_legs (flight_id, leg_order, origin_airport_id, destination_airport_id, departure_time, arrival_time, duration_minutes, airline_id, flight_number, aircraft_type, terminal_departure, terminal_arrival)\n   148→        VALUES (${flightId}, ${1}, ${originId}, ${destId}, ${depTime}, ${arrTime}, ${durationMin}, ${airlineId}, ${flightNum}, ${aircraft}, ${'T1'}, ${'T2'})\n   149→      `\n   150→    }\n   151→\n   152→    // Add prices for all cabin classes\n   153→    const premiumMult = 1.8\n   154→    const businessMult = 3.5\n   155→    const firstMult = 6.0\n   156→    const taxRate = 0.15\n   157→\n   158→    for (const [cabinClass, mult] of [['economy', 1], ['premium_economy', premiumMult], ['business', businessMult], ['first', firstMult]] as [string, number][]) {\n   159→      const basePrice = Math.round(economyPrice * mult * 100)\n   160→      const taxes = Math.round(basePrice * taxRate)\n   161→      const total = basePrice + taxes\n   162→      const seats = Math.floor(Math.random() * 30) + 5\n   163→      await sql`\n   164→        INSERT INTO prices (flight_id, cabin_class, base_price_cents, taxes_cents, total_price_cents, available_seats)\n   165→       