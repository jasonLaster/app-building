[2026-03-14T20:17:53.118Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016xsEPJBUzgELxN4hZhoH5d","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test'\n     2→\n     3→test.describe('DatePicker', () => {\n     4→  test.beforeEach(async ({ page }) => {\n     5→    await page.goto('/')\n     6→    await expect(page.getByTestId('search-page')).toBeVisible({ timeout: 10000 })\n     7→  })\n     8→\n     9→  test('DatePicker departure field shows placeholder', async ({ page }) => {\n    10→    const departureTrigger = page.getByTestId('departure-date-trigger')\n    11→    await expect(departureTrigger).toBeVisible()\n    12→    await expect(departureTrigger).toContainText('Departure')\n    13→  })\n    14→\n    15→  test('DatePicker return field shows placeholder when Round trip', async ({ page }) => {\n    16→    // Default trip type is Round trip\n    17→    await expect(page.getByTestId('trip-type-selector-trigger')).toContainText('Round trip')\n    18→\n    19→    const returnTrigger = page.getByTestId('return-date-trigger')\n    20→    await expect(returnTrigger).toBeVisible()\n    21→    await expect(returnTrigger).toContainText('Return')\n    22→  })\n    23→\n    24→  test('DatePicker opens calendar on departure field click', async ({ page }) => {\n    25→    // Calendar should not be visible initially\n    26→    await expect(page.getByTestId('departure-date-calendar')).not.toBeVisible()\n    27→\n    28→    // Click the departure date trigger\n    29→    await page.getByTestId('departure-date-trigger').click()\n    30→\n    31→    // Calendar should now be visible\n    32→    await expect(page.getByTestId('departure-date-calendar')).toBeVisible()\n    33→\n    34→    // Should show the current month label\n    35→    const now = new Date()\n    36→    const expectedMonth = now.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })\n    37→    await expect(page.getByTestId('departure-date-month-label')).toHaveText(expectedMonth)\n    38→\n    39→    // Navigation buttons should be present\n    40→    await expect(page.getByTestId('departure-date-prev-month')).toBeVisible()\n    41→    await expect(page.getByTestId('departure-date-next-month')).toBeVisible()\n    42→\n    43→    // Previous month button should be disabled for current month\n    44→    await expect(page.getByTestId('departure-date-prev-month')).toBeDisabled()\n    45→  })\n    46→\n    47→  test('DatePicker selects a departure date', async ({ page }) => {\n    48→    // Open departure calendar\n    49→    await page.getByTestId('departure-date-trigger').click()\n    50→    await expect(page.getByTestId('departure-date-calendar')).toBeVisible()\n    51→\n    52→    // Navigate to next month to pick a future date\n    53→    await page.getByTestId('departure-date-next-month').click()\n    54→\n    55→    const nextMonth = new Date()\n    56→    nextMonth.setMonth(nextMonth.getMonth() + 1)\n    57→    const year = nextMonth.getFullYear()\n    58→    const month = String(nextMonth.getMonth() + 1).padStart(2, '0')\n    59→    const dateStr = `${year}-${month}-25`\n    60→\n    61→    // Click the 25th\n    62→    await page.getByTestId(`departure-date-day-${dateStr}`).click()\n    63→\n    64→    // Calendar should close\n    65→    await expect(page.getByTestId('departure-date-calendar')).not.toBeVisible()\n    66→\n    67→    // Departure trigger should show the selected date\n    68→    const expectedDisplay = new Date(dateStr + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })\n    69→    await expect(page.getByTestId('departure-date-trigger')).toContainText(expectedDisplay)\n    70→  })\n    71→\n    72→  test('DatePicker selects a return date after departure', async ({ page }) => {\n    73→    // First set departure date to next month 25th\n    74→    await page.getByTestId('departure-date-trigger').click()\n    75→    await expect(page.getByTestId('departure-date-calendar')).toBeVisible()\n    76→    await page.getByTestId('departure-date-next-month').click()\n    77→\n    78→    const nextMonth = new Date()\n    79→    nextMonth.setMonth(nextMonth.getMonth() + 1)\n    80→    const year = nextMonth.getFullYear()\n    81→    const month = String(nextMonth.getMonth() + 1).padStart(2, '0')\n    82→    const depDateStr = `${year}-${month}-25`\n    83→    await page.getByTestId(`departure-date-day-${depDateStr}`).click()\n    84→    await expect(page.getByTestId('departure-date-calendar')).not.toBeVisible()\n    85→\n    86→    // Now open return calendar\n    87→    await page.getByTestId('return-date-trigger').click()\n    88→    await expect(page.getByTestId('return-date-calendar')).toBeVisible()\n    89→\n    90→    // Navigate to the month after next to pick April 1\n    91→    const returnMonth = new Date()\n    92→    returnMonth.setMonth(returnMonth.getMonth() + 2)\n    93→    const retYear = returnMonth.getFullYear()\n    94→    const retMonth = String(returnMonth.getMonth() + 1).padStart(2, '0')\n    95→\n    96→    // The return calendar opens at current month, navigate to the right month\n    97→    // We need to navigate forward twice (once past current, once past next)\n    98→    await page.getByTestId('return-date-next-month').click()\n    99→    await page.getByTestId('return-date-next-month').click()\n   100→\n   101→    const retDateStr = `${retYear}-${retMonth}-01`\n   102→    await page.getByTestId(`return-date-day-${retDateStr}`).click()\n   103→    await expect(page.getByTestId('return-date-calendar')).not.toBeVisible()\n   104→\n   105→    // Return trigger should show the selected date\n   106→    const expectedDisplay = new Date(retDateStr + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })\n   107→    await expect(page.getByTestId('return-date-trigger')).toContainText(expectedDisplay)\n   108→  })\n   109→\n   110→  test('DatePicker prevents selecting return date before departure', async ({ page }) => {\n   111→    // Set departure date to next month 25th\n   112→    await page.getByTestId('departure-date-trigger').click()\n   113→    await expect(page.getByTestId('departure-date-calendar')).toBeVisible()\n   114→    await page.getByTestId('departure-date-next-month').click()\n   115→\n   116→    const nextMonth = new Date()\n   117→    nextMonth.setMonth(nextMonth.getMonth() + 1)\n   118→    const year = nextMonth.getFullYear()\n   119→    const month = String(nextMonth.getMonth() + 1).padStart(2, '0')\n   120→    const depDateStr = `${year}-${month}-25`\n   121→    await page.getByTestId(`departure-date-day-${depDateStr}`).click()\n   122→    await expect(page.getByTestId('departure-date-calendar')).not.toBeVisible()\n   123→\n   124→    // Open return calendar\n   125→    await page.getByTestId('return-date-trigger').click()\n   126→    await expect(page.getByTestId('return-date-calendar')).toBeVisible()\n   127→\n   128→    // Navigate to the same month as departure\n   129→    await page.getByTestId('return-date-next-month').click()\n   130→\n   131→    // The 20th should be before departure (25th), so it should be disabled\n   132→    const beforeDateStr = `${year}-${month}-20`\n   133→    await expect(page.getByTestId(`return-date-day-${beforeDateStr}`)).toBeDisabled()\n   134→  })\n   135→\n   136→  test('DatePicker navigates to next month', async ({ page }) => {\n   137→    await page.getByTestId('departure-date-trigger').click()\n   138→    await expect(page.getByTestId('departure-date-calendar')).toBeVisible()\n   139→\n   140→    const now = new Date()\n   141→    const currentMonthLabel = now.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })\n   142→    await expect(page.getByTestId('departure-date-month-label')).toHaveText(currentMonthLabel)\n   143→\n   144→    // Click next month\n   145→    await page.getByTestId('departure-date-next-month').click()\n   146→\n   147→    const nextMonth = new Date()\n   148→    nextMonth.setMonth(nextMonth.getMonth() + 1)\n   149→    const nextMonthLabel = nextMonth.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })\n   150→    await expect(page.getByTestId('departure-date-month-label')).toHaveText(nextMonthLabel)\n   151→  })\n   152→\n   153→  test('DatePicker navigates to previous month not before current', async ({ page }) => {\n   154→    await page.getByTestId('departure-date-trigger').click()\n   155→    await expect(page.getByTestId('departure-date-calendar')).toBeVisible()\n   156→\n   157→    // On current month, prev button should be disabled\n   158→    await expect(page.getByTestId('departure-date-prev-month')).toBeDisabled()\n   159→\n   160→    // Navigate to next month first\n   161→    await page.getByTestId('departure-date-next-month').click()\n   162→\n   163→    const nextMonth = new Date()\n   164→    nextMonth.setMonth(nextMonth.getMonth() + 1)\n   165→    const nextMonthLabel = nextMonth.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })\n   166→    await expect(page.getByTestId('departure-date-month-label')).toHaveText(nextMonthLabel)\n   167→\n   168→    // Now prev button should be enabled\n   169→    await expect(page.getByTestId('departure-date-prev-month')).not.toBeDisabled()\n   170→\n   171→    // Click prev to go back to current month\n   172→    await page.getByTestId('departure-date-prev-month').click()\n   173→\n   174→    const currentMonthLabel = new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' })\n   175→    await expect(page.getByTestId('departure-date-month-label')).toHaveText(currentMonthLabel)\n   176→\n   177→    // Prev button should be disabled again\n   178→    await expect(page.getByTestId('departure-date-prev-month')).toBeDisabled()\n   179→  })\n   180→\n   181→  test('DatePicker return field hidden when One way selected', async ({ page }) => {\n   182→    // Return field should be visible by default (Round trip)\n   183→    await expect(page.getByTestId('return-date-container')).toBeVisible()\n   184→\n   185→    // Switch to One way\n   186→    await page.getByTestId('trip-type-selector-trigger').click()\n   187→    await page.getByTestId('trip-type-option-one_way').click()\n   188→\n   189→    // Return date field should be hidden\n   190→    await expect(page.getByTestId('return-date-container')).not.toBeVisible()\n   191→\n   192→    // Departure date should still be visible\n   193→    await expect(page.getByTestId('departure-date-container')).toBeVisible()\n   194→  })\n   195→\n   196→  test('DatePicker retains departure date when switching trip types', async ({ page }) => {\n   197→    // Set departure date\n   198→    await page.getByTestId('departure-date-trigger').click()\n   199→    await expect(page.getByTestId('departure-date-calendar')).toBeVisible()\n   200→    await page.getByTestId('departure-date-next-month').click()\n   201→\n   202→    const nextMonth = new Date()\n   203→    nextMonth.setMonth(nextMonth.getMonth() + 1)\n   204→    const year = nextMonth.getFullYear()\n   205→    const month = String(nextMonth.getMonth() + 1).padStart(2, '0')\n   206→    const depDateStr = `${year}-${month}-25`\n   207→    await page.getByTestId(`departure-date-day-${depDateStr}`).click()\n   208→    await expect(page.getByTestId('departure-date-calendar')).not.toBeVisible()\n   209→\n   210→    const expectedDisplay = new Date(depDateStr + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })\n   211→    await expect(page.getByTestId('departure-date-trigger')).toContainText(expectedDisplay)\n   212→\n   213→    // Switch to One way\n   214→    await page.getByTestId('trip-type-selector-trigger').click()\n   215→    await page.getByTestId('trip-type-option-one_way').click()\n   216→\n   217→    // Departure date should still be shown\n   218→    await expect(page.getByTestId('departure-date-trigger')).toContainText(exp