[2026-03-14T20:16:56.288Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ArpTqxSTVTjGANksjuo3SG","type":"tool_result","content":"     1→import { createSlice, createAsyncThunk, type PayloadAction } from '@reduxjs/toolkit'\n     2→import type { FlightLeg } from './flightsSlice'\n     3→\n     4→export interface PassengerInfo {\n     5→  firstName: string\n     6→  lastName: string\n     7→  dateOfBirth: string\n     8→  gender: string\n     9→  email: string\n    10→  phone: string\n    11→  passengerType: 'adult' | 'child' | 'infant'\n    12→}\n    13→\n    14→export interface BookingFlightDetail {\n    15→  id: string\n    16→  flight_number: string\n    17→  departure_time: string\n    18→  arrival_time: string\n    19→  duration_minutes: number\n    20→  aircraft_type: string\n    21→  has_wifi: boolean\n    22→  has_power: boolean\n    23→  has_entertainment: boolean\n    24→  co2_kg: number\n    25→  airline_name: string\n    26→  airline_code: string\n    27→  logo_color: string\n    28→  origin_code: string\n    29→  origin_name: string\n    30→  origin_city: string\n    31→  dest_code: string\n    32→  dest_name: string\n    33→  dest_city: string\n    34→  base_price_cents: number\n    35→  taxes_cents: number\n    36→  total_price_cents: number\n    37→  cabin_class: string\n    38→  available_seats: number\n    39→}\n    40→\n    41→interface BookingState {\n    42→  flight: BookingFlightDetail | null\n    43→  legs: FlightLeg[]\n    44→  returnFlight: BookingFlightDetail | null\n    45→  returnLegs: FlightLeg[]\n    46→  loading: boolean\n    47→  error: string | null\n    48→  passengers: PassengerInfo[]\n    49→  validationErrors: Record<string, string>\n    50→  bookingInProgress: boolean\n    51→  bookingComplete: boolean\n    52→  bookingReference: string | null\n    53→  bookingError: string | null\n    54→}\n    55→\n    56→const initialState: BookingState = {\n    57→  flight: null,\n    58→  legs: [],\n    59→  returnFlight: null,\n    60→  returnLegs: [],\n    61→  loading: false,\n    62→  error: null,\n    63→  passengers: [],\n    64→  validationErrors: {},\n    65→  bookingInProgress: false,\n    66→  bookingComplete: false,\n    67→  bookingReference: null,\n    68→  bookingError: null,\n    69→}\n    70→\n    71→export const fetchFlightForBooking = createAsyncThunk(\n    72→  'booking/fetchFlightForBooking',\n    73→  async (params: { flightId: string; cabinClass: string }) => {\n    74→    const qs = new URLSearchParams({\n    75→      flightId: params.flightId,\n    76→      cabinClass: params.cabinClass,\n    77→    })\n    78→    const res = await fetch(`/api/bookings?${qs}`)\n    79→    if (!res.ok) {\n    80→      throw new Error('Failed to fetch flight details')\n    81→    }\n    82→    return res.json() as Promise<{ flight: BookingFlightDetail; legs: FlightLeg[] }>\n    83→  }\n    84→)\n    85→\n    86→export const fetchReturnFlightForBooking = createAsyncThunk(\n    87→  'booking/fetchReturnFlightForBooking',\n    88→  async (params: { flightId: string; cabinClass: string }) => {\n    89→    const qs = new URLSearchParams({\n    90→      flightId: params.flightId,\n    91→      cabinClass: params.cabinClass,\n    92→    })\n    93→    const res = await fetch(`/api/bookings?${qs}`)\n    94→    if (!res.ok) {\n    95→      throw new Error('Failed to fetch return flight details')\n    96→    }\n    97→    return res.json() as Promise<{ flight: BookingFlightDetail; legs: FlightLeg[] }>\n    98→  }\n    99→)\n   100→\n   101→export const createBooking = createAsyncThunk(\n   102→  'booking/createBooking',\n   103→  async (params: {\n   104→    sessionToken: string\n   105→    flightId: string\n   106→    returnFlightId?: string\n   107→    cabinClass: string\n   108→    totalPriceCents: number\n   109→    passengers: Array<{\n   110→      firstName: string\n   111→      lastName: string\n   112→      dateOfBirth: string\n   113→      gender: string\n   114→      email?: string\n   115→      phone?: string\n   116→      passengerType: string\n   117→    }>\n   118→  }) => {\n   119→    const res = await fetch('/api/bookings', {\n   120→      method: 'POST',\n   121→      headers: { 'Content-Type': 'application/json' },\n   122→      body: JSON.stringify(params),\n   123→    })\n   124→    if (!res.ok) {\n   125→      throw new Error('Booking failed. Please try again.')\n   126→    }\n   127→    return res.json() as Promise<{\n   128→      id: string\n   129→      bookingReference: string\n   130→      status: string\n   131→      createdAt: string\n   132→    }>\n   133→  }\n   134→)\n   135→\n   136→const bookingSlice = createSlice({\n   137→  name: 'booking',\n   138→  initialState,\n   139→  reducers: {\n   140→    initializePassengers(state, action: PayloadAction<{ adults: number; children: number; infants: number }>) {\n   141→      const passengers: PassengerInfo[] = []\n   142→      for (let i = 0; i < action.payload.adults; i++) {\n   143→        passengers.push({\n   144→          firstName: '', lastName: '', dateOfBirth: '', gender: '',\n   145→          email: '', phone: '', passengerType: 'adult',\n   146→        })\n   147→      }\n   148→      for (let i = 0; i < action.payload.children; i++) {\n   149→        passengers.push({\n   150→          firstName: '', lastName: '', dateOfBirth: '', gender: '',\n   151→          email: '', phone: '', passengerType: 'child',\n   152→        })\n   153→      }\n   154→      for (let i = 0; i < action.payload.infants; i++) {\n   155→        passengers.push({\n   156→          firstName: '', lastName: '', dateOfBirth: '', gender: '',\n   157→          email: '', phone: '', passengerType: 'infant',\n   158→        })\n   159→      }\n   160→      state.passengers = passengers\n   161→      state.validationErrors = {}\n   162→      state.bookingComplete = false\n   163→      state.bookingReference = null\n   164→      state.bookingError = null\n   165→    },\n   166→    updatePassenger(state, action: PayloadAction<{ index: number; field: keyof PassengerInfo; value: string }>) {\n   167→      const p = state.passengers[action.payload.index]\n   168→      if (p) {\n   169→        ;(p[action.payload.field] as string) = action.payload.value\n   170→      }\n   171→      // Clear validation error for this field\n   172→      delete state.validationErrors[`${action.payload.index}-${action.payload.field}`]\n   173→    },\n   174→    setValidationErrors(state, action: PayloadAction<Record<string, string>>) {\n   175→      state.validationErrors = action.payload\n   176→    },\n   177→    resetBooking(state) {\n   178→      state.flight = null\n   179→      state.legs = []\n   180→      state.returnFlight = null\n   181→      state.returnLegs = []\n   182→      state.loading = false\n   183→      state.error = null\n   184→      state.passengers = []\n   185→      state.validationErrors = {}\n   186→      state.bookingInProgress = false\n   187→      state.bookingComplete = false\n   188→      state.bookingReference = null\n   189→      state.bookingError = null\n   190→    },\n   191→  },\n   192→  extraReducers: (builder) => {\n   193→    builder\n   194→      .addCase(fetchFlightForBooking.pending, (state) => {\n   195→        state.loading = true\n   196→        state.error = null\n   197→      })\n   198→      .addCase(fetchFlightForBooking.fulfilled, (state, action) => {\n   199→        state.flight = action.payload.flight\n   200→        state.legs = action.payload.legs\n   201→        state.loading = false\n   202→      })\n   203→      .addCase(fetchFlightForBooking.rejected, (state, action) => {\n   204→        state.loading = false\n   205→        state.error = action.error.message || 'Failed to load flight details'\n   206→      })\n   207→      .addCase(fetchReturnFlightForBooking.fulfilled, (state, action) => {\n   208→        state.returnFlight = action.payload.flight\n   209→        state.returnLegs = action.payload.legs\n   210→      })\n   211→      .addCase(fetchReturnFlightForBooking.rejected, (state) => {\n   212→        state.returnFlight = null\n   213→        state.returnLegs = []\n   214→      })\n   215→      .addCase(createBooking.pending, (state) => {\n   216→        state.bookingInProgress = true\n   217→        state.bookingError = null\n   218→      })\n   219→      .addCase(createBooking.fulfilled, (state, action) => {\n   220→        state.bookingInProgress = false\n   221→        state.bookingComplete = true\n   222→        state.bookingReference = action.payload.bookingReference\n   223→      })\n   224→      .addCase(createBooking.rejected, (state, action) => {\n   225→        state.bookingInProgress = false\n   226→        state.bookingError = action.error.message || 'Booking failed. Please try again.'\n   227→      })\n   228→  },\n   229→})\n   230→\n   231→export const {\n   232→  initializePassengers,\n   233→  updatePassenger,\n   234→  setValidationErrors,\n   235→  resetBooking,\n   236→} = bookingSlice.actions\n   237→\n   238→export default bookingSlice.reducer\n   239→"}]},"parent_tool_use_id":"toolu_01YD8nTGH9xsxmaLFTLdWSY8","session_id":"19b0156b-6b8d-4bf8-87d9-d30f04f0aedb","uuid":"d790307f-7435-4280-b429-db2ff68b4ae4"}
