[2026-03-14T20:17:45.662Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NY9Pjb3twQm4YCwFdwsuJZ","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions'\n     2→import { getSql } from './db.js'\n     3→\n     4→export default async function handler(req: Request, _context: Context) {\n     5→  const sql = getSql()\n     6→  const url = new URL(req.url)\n     7→\n     8→  if (req.method === 'GET') {\n     9→    const session = url.searchParams.get('session') || ''\n    10→    if (!session) {\n    11→      return new Response(JSON.stringify({ error: 'Missing session' }), {\n    12→        status: 400,\n    13→        headers: { 'Content-Type': 'application/json' },\n    14→      })\n    15→    }\n    16→\n    17→    try {\n    18→      const bookings = await sql`\n    19→        SELECT\n    20→          b.id, b.booking_reference, b.cabin_class, b.total_price_cents, b.status, b.created_at,\n    21→          b.return_flight_id,\n    22→          f.flight_number, f.departure_time, f.arrival_time, f.duration_minutes,\n    23→          al.name AS airline_name, al.iata_code AS airline_code, al.logo_color,\n    24→          oa.iata_code AS origin_code, oa.name AS origin_name, oa.city AS origin_city,\n    25→          da.iata_code AS dest_code, da.name AS dest_name, da.city AS dest_city,\n    26→          rf.departure_time AS return_departure_time, rf.arrival_time AS return_arrival_time\n    27→        FROM bookings b\n    28→        JOIN sessions s ON b.session_id = s.id\n    29→        JOIN flights f ON b.flight_id = f.id\n    30→        JOIN airlines al ON f.airline_id = al.id\n    31→        JOIN airports oa ON f.origin_airport_id = oa.id\n    32→        JOIN airports da ON f.destination_airport_id = da.id\n    33→        LEFT JOIN flights rf ON b.return_flight_id = rf.id\n    34→        WHERE s.session_token = ${session}\n    35→        ORDER BY f.departure_time ASC\n    36→      `\n    37→\n    38→      return new Response(JSON.stringify(bookings), {\n    39→        status: 200,\n    40→        headers: { 'Content-Type': 'application/json' },\n    41→      })\n    42→    } catch (err) {\n    43→      console.error('Fetch bookings error:', err)\n    44→      return new Response(JSON.stringify({ error: 'Failed to fetch bookings' }), {\n    45→        status: 500,\n    46→        headers: { 'Content-Type': 'application/json' },\n    47→      })\n    48→    }\n    49→  }\n    50→\n    51→  if (req.method === 'PATCH') {\n    52→    try {\n    53→      const body = await req.json() as {\n    54→        bookingId: string\n    55→        sessionToken: string\n    56→        status: string\n    57→      }\n    58→\n    59→      if (body.status !== 'cancelled') {\n    60→        return new Response(JSON.stringify({ error: 'Invalid status' }), {\n    61→          status: 400,\n    62→          headers: { 'Content-Type': 'application/json' },\n    63→        })\n    64→      }\n    65→\n    66→      const result = await sql`\n    67→        UPDATE bookings\n    68→        SET status = ${body.status}\n    69→        WHERE id = ${body.bookingId}\n    70→          AND session_id IN (SELECT id FROM sessions WHERE session_token = ${body.sessionToken})\n    71→          AND status = 'confirmed'\n    72→        RETURNING id, status\n    73→      `\n    74→\n    75→      const updated = result[0]\n    76→      if (!updated) {\n    77→        return new Response(JSON.stringify({ error: 'Booking not found or already cancelled' }), {\n    78→          status: 404,\n    79→          headers: { 'Content-Type': 'application/json' },\n    80→        })\n    81→      }\n    82→\n    83→      return new Response(JSON.stringify({ id: updated.id, status: updated.status }), {\n    84→        status: 200,\n    85→        headers: { 'Content-Type': 'application/json' },\n    86→      })\n    87→    } catch (err) {\n    88→      console.error('Cancel booking error:', err)\n    89→      return new Response(JSON.stringify({ error: 'Failed to cancel booking' }), {\n    90→        status: 500,\n    91→        headers: { 'Content-Type': 'application/json' },\n    92→      })\n    93→    }\n    94→  }\n    95→\n    96→  return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n    97→    status: 405,\n    98→    headers: { 'Content-Type': 'application/json' },\n    99→  })\n   100→}\n   101→"}]},"parent_tool_use_id":"toolu_01LNVNgAgCQ7h9PXsinS51jT","session_id":"19b0156b-6b8d-4bf8-87d9-d30f04f0aedb","uuid":"c033ad4e-28dd-4f4e-9b49-4db5ddd8c745"}
