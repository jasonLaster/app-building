[2026-03-14T20:16:51.590Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VbK1ndVDwDwqC7FVrxef1G","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions'\n     2→import { getSql } from './db.js'\n     3→\n     4→export default async function handler(req: Request, _context: Context) {\n     5→  const sql = getSql()\n     6→  const url = new URL(req.url)\n     7→\n     8→  if (req.method === 'POST') {\n     9→    try {\n    10→      const body = await req.json() as {\n    11→        sessionToken: string\n    12→        flightId: string\n    13→        returnFlightId?: string\n    14→        cabinClass: string\n    15→        totalPriceCents: number\n    16→        passengers: Array<{\n    17→          firstName: string\n    18→          lastName: string\n    19→          dateOfBirth: string\n    20→          gender: string\n    21→          email?: string\n    22→          phone?: string\n    23→          passengerType: string\n    24→        }>\n    25→      }\n    26→\n    27→      // Ensure session exists\n    28→      const existingSessions = await sql`\n    29→        SELECT id FROM sessions WHERE session_token = ${body.sessionToken}\n    30→      `\n    31→      let sessionId: string\n    32→      const existingSession = existingSessions[0]\n    33→      if (existingSession) {\n    34→        sessionId = existingSession.id as string\n    35→      } else {\n    36→        const newSessions = await sql`\n    37→          INSERT INTO sessions (session_token) VALUES (${body.sessionToken})\n    38→          RETURNING id\n    39→        `\n    40→        const newSession = newSessions[0]\n    41→        if (!newSession) {\n    42→          return new Response(JSON.stringify({ error: 'Failed to create session' }), {\n    43→            status: 500,\n    44→            headers: { 'Content-Type': 'application/json' },\n    45→          })\n    46→        }\n    47→        sessionId = newSession.id as string\n    48→      }\n    49→\n    50→      // Generate booking reference\n    51→      const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789'\n    52→      let ref = 'GF-'\n    53→      for (let i = 0; i < 6; i++) {\n    54→        ref += chars[Math.floor(Math.random() * chars.length)]\n    55→      }\n    56→\n    57→      const returnFlightId = body.returnFlightId || null\n    58→\n    59→      const bookingRows = await sql`\n    60→        INSERT INTO bookings (session_id, flight_id, return_flight_id, booking_reference, cabin_class, total_price_cents, status)\n    61→        VALUES (${sessionId}, ${body.flightId}, ${returnFlightId}, ${ref}, ${body.cabinClass}, ${body.totalPriceCents}, 'confirmed')\n    62→        RETURNING id, booking_reference, status, created_at\n    63→      `\n    64→\n    65→      const booking = bookingRows[0]\n    66→      if (!booking) {\n    67→        return new Response(JSON.stringify({ error: 'Failed to create booking' }), {\n    68→          status: 500,\n    69→          headers: { 'Content-Type': 'application/json' },\n    70→        })\n    71→      }\n    72→\n    73→      // Insert passengers\n    74→      for (const p of body.passengers) {\n    75→        const dob = p.dateOfBirth || null\n    76→        const gender = p.gender || null\n    77→        const email = p.email || null\n    78→        const phone = p.phone || null\n    79→        await sql`\n    80→          INSERT INTO booking_passengers (booking_id, first_name, last_name, date_of_birth, gender, email, phone, passenger_type)\n    81→          VALUES (${booking.id}, ${p.firstName}, ${p.lastName}, ${dob}, ${gender}, ${email}, ${phone}, ${p.passengerType})\n    82→        `\n    83→      }\n    84→\n    85→      return new Response(JSON.stringify({\n    86→        id: booking.id,\n    87→        bookingReference: booking.booking_reference,\n    88→        status: booking.status,\n    89→        createdAt: booking.created_at,\n    90→      }), {\n    91→        status: 201,\n    92→        headers: { 'Content-Type': 'application/json' },\n    93→      })\n    94→    } catch (err) {\n    95→      console.error('Booking error:', err)\n    96→      return new Response(JSON.stringify({ error: 'Failed to create booking' }), {\n    97→        status: 500,\n    98→        headers: { 'Content-Type': 'application/json' },\n    99→      })\n   100→    }\n   101→  }\n   102→\n   103→  // GET - fetch flight details for booking page\n   104→  if (req.method === 'GET') {\n   105→    const flightId = url.searchParams.get('flightId')\n   106→    const cabinClass = url.searchParams.get('cabinClass') || 'economy'\n   107→\n   108→    if (!flightId) {\n   109→      return new Response(JSON.stringify({ error: 'flightId is required' }), {\n   110→        status: 400,\n   111→        headers: { 'Content-Type': 'application/json' },\n   112→      })\n   113→    }\n   114→\n   115→    try {\n   116→      const flights = await sql`\n   117→        SELECT\n   118→          f.id, f.flight_number, f.departure_time, f.arrival_time, f.duration_minutes,\n   119→          f.aircraft_type, f.has_wifi, f.has_power, f.has_entertainment, f.co2_kg,\n   120→          al.name AS airline_name, al.iata_code AS airline_code, al.logo_color,\n   121→          oa.iata_code AS origin_code, oa.name AS origin_name, oa.city AS origin_city,\n   122→          da.iata_code AS dest_code, da.name AS dest_name, da.city AS dest_city,\n   123→          p.base_price_cents, p.taxes_cents, p.total_price_cents, p.cabin_class,\n   124→          p.available_seats\n   125→        FROM flights f\n   126→        JOIN airlines al ON f.airline_id = al.id\n   127→        JOIN airports oa ON f.origin_airport_id = oa.id\n   128→        JOIN airports da ON f.destination_airport_id = da.id\n   129→        LEFT JOIN prices p ON p.flight_id = f.id AND p.cabin_class = ${cabinClass}\n   130→        WHERE f.id = ${flightId}\n   131→      `\n   132→\n   133→      const flight = flights[0]\n   134→      if (!flight) {\n   135→        return new Response(JSON.stringify({ error: 'Flight not found' }), {\n   136→          status: 404,\n   137→          headers: { 'Content-Type': 'application/json' },\n   138→        })\n   139→      }\n   140→\n   141→      // Get legs\n   142→      const legs = await sql`\n   143→        SELECT\n   144→          fl.id, fl.leg_order, fl.departure_time, fl.arrival_time, fl.duration_minutes,\n   145→          fl.flight_number, fl.aircraft_type, fl.terminal_departure, fl.terminal_arrival,\n   146→          oa.iata_code AS origin_code, oa.name AS origin_name, oa.city AS origin_city,\n   147→          da.iata_code AS dest_code, da.name AS dest_name, da.city AS dest_city,\n   148→          al.name AS airline_name, al.iata_code AS airline_code\n   149→        FROM flight_legs fl\n   150→        JOIN airports oa ON fl.origin_airport_id = oa.id\n   151→        JOIN airports da ON fl.destination_airport_id = da.id\n   152→        LEFT JOIN airlines al ON fl.airline_id = al.id\n   153→        WHERE fl.flight_id = ${flightId}\n   154→        ORDER BY fl.leg_order\n   155→      `\n   156→\n   157→      return new Response(JSON.stringify({ flight, legs }), {\n   158→        status: 200,\n   159→        headers: { 'Content-Type': 'application/json' },\n   160→      })\n   161→    } catch (err) {\n   162→      console.error('Fetch flight error:', err)\n   163→      return new Response(JSON.stringify({ error: 'Failed to fetch flight details' }), {\n   164→        status: 500,\n   165→        headers: { 'Content-Type': 'application/json' },\n   166→      })\n   167→    }\n   168→  }\n   169→\n   170→  return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n   171→    status: 405,\n   172→    headers: { 'Content-Type': 'application/json' },\n   173→  })\n   174→}\n   175→"}]},"parent_tool_use_id":"toolu_01YD8nTGH9xsxmaLFTLdWSY8","session_id":"19b0156b-6b8d-4bf8-87d9-d30f04f0aedb","uuid":"ddc67a4f-e233-45f9-9e19-17414f161a93"}
