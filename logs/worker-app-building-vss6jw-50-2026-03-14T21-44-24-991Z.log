[2026-03-14T21:31:06.767Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UoEFEZmxfMcXtY9MJ4jP7F","type":"tool_result","content":"     1→import { execSync } from 'child_process'\n     2→import { readFileSync, writeFileSync, existsSync, mkdirSync } from 'fs'\n     3→import { join } from 'path'\n     4→import { initSchema } from './schema'\n     5→import { seedDatabase } from './seed-db'\n     6→\n     7→const appDir = join(import.meta.dirname, '..')\n     8→const logDir = join(appDir, 'logs')\n     9→mkdirSync(logDir, { recursive: true })\n    10→const logFile = join(logDir, 'deploy.log')\n    11→let logContent = ''\n    12→\n    13→function log(msg: string) {\n    14→  logContent += msg + '\\n'\n    15→}\n    16→\n    17→function writeLog() {\n    18→  writeFileSync(logFile, logContent)\n    19→}\n    20→\n    21→function readEnv(): Record<string, string> {\n    22→  const envPath = join(appDir, '.env')\n    23→  if (!existsSync(envPath)) return {}\n    24→  const lines = readFileSync(envPath, 'utf-8').split('\\n')\n    25→  const env: Record<string, string> = {}\n    26→  for (const line of lines) {\n    27→    const trimmed = line.trim()\n    28→    if (!trimmed || trimmed.startsWith('#')) continue\n    29→    const eqIdx = trimmed.indexOf('=')\n    30→    if (eqIdx > 0) {\n    31→      env[trimmed.slice(0, eqIdx)] = trimmed.slice(eqIdx + 1)\n    32→    }\n    33→  }\n    34→  return env\n    35→}\n    36→\n    37→function writeEnvValue(key: string, value: string) {\n    38→  const envPath = join(appDir, '.env')\n    39→  let content = ''\n    40→  if (existsSync(envPath)) {\n    41→    content = readFileSync(envPath, 'utf-8')\n    42→    const lines = content.split('\\n')\n    43→    const idx = lines.findIndex(l => l.startsWith(key + '='))\n    44→    if (idx >= 0) {\n    45→      lines[idx] = `${key}=${value}`\n    46→      content = lines.join('\\n')\n    47→    } else {\n    48→      content = content.trimEnd() + `\\n${key}=${value}\\n`\n    49→    }\n    50→  } else {\n    51→    content = `${key}=${value}\\n`\n    52→  }\n    53→  writeFileSync(envPath, content)\n    54→}\n    55→\n    56→async function deploy() {\n    57→  const neonApiKey = process.env['NEON_API_KEY'] || ''\n    58→  const netlifyToken = process.env['NETLIFY_AUTH_TOKEN'] || ''\n    59→  const netlifySlug = process.env['NETLIFY_ACCOUNT_SLUG'] || ''\n    60→  const env = readEnv()\n    61→  let isFirstDeploy = false\n    62→\n    63→  // Step 1: Database setup\n    64→  let databaseUrl = env['DATABASE_URL'] || ''\n    65→  let neonProjectId = env['NEON_PROJECT_ID'] || ''\n    66→\n    67→  if (!neonProjectId && neonApiKey) {\n    68→    try {\n    69→      const resp = execSync(\n    70→        `curl -s -X POST \"https://console.neon.tech/api/v2/projects\" -H \"Authorization: Bearer ${neonApiKey}\" -H \"Content-Type: application/json\" -d '{\"project\": {\"name\": \"airbnb-clone\"}}'`,\n    71→        { encoding: 'utf-8', timeout: 30000 }\n    72→      )\n    73→      const data = JSON.parse(resp)\n    74→      neonProjectId = data.project?.id || ''\n    75→      databaseUrl = data.connection_uris?.[0]?.connection_uri || ''\n    76→      if (neonProjectId) writeEnvValue('NEON_PROJECT_ID', neonProjectId)\n    77→      if (databaseUrl) writeEnvValue('DATABASE_URL', databaseUrl)\n    78→      log(`Created Neon project: ${neonProjectId}`)\n    79→      isFirstDeploy = true\n    80→    } catch (e) {\n    81→      log(`Neon project creation failed: ${e}`)\n    82→    }\n    83→  }\n    84→\n    85→  // Step 2: Schema sync\n    86→  if (databaseUrl) {\n    87→    try {\n    88→      await initSchema(databaseUrl)\n    89→      log('Schema synced')\n    90→    } catch (e) {\n    91→      log(`Schema sync failed: ${e}`)\n    92→      writeLog()\n    93→      console.log('Deploy failed (schema) — see logs/deploy.log')\n    94→      process.exit(1)\n    95→    }\n    96→\n    97→    // Step 4: Seed on first deploy\n    98→    if (isFirstDeploy) {\n    99→      try {\n   100→        await seedDatabase(databaseUrl)\n   101→        log('Database seeded')\n   102→      } catch (e) {\n   103→        log(`Seeding failed: ${e}`)\n   104→      }\n   105→    }\n   106→  }\n   107→\n   108→  // Step 5: Netlify site setup\n   109→  let siteId = env['NETLIFY_SITE_ID'] || ''\n   110→  if (!siteId && netlifyToken && netlifySlug) {\n   111→    try {\n   112→      const siteResp = execSync(\n   113→        `LC_ALL=C npx netlify sites:create --account-slug ${netlifySlug} --name airbnb-clone-${Date.now()}`,\n   114→        {\n   115→          encoding: 'utf-8',\n   116→          cwd: appDir,\n   117→          timeout: 30000,\n   118→          env: { ...process.env, NETLIFY_AUTH_TOKEN: netlifyToken, LC_ALL: 'C' },\n   119→          stdio: ['ignore', 'pipe', 'pipe'],\n   120→        }\n   121→      )\n   122→      log('Netlify site creation:\\n' + siteResp)\n   123→      const siteIdMatch = siteResp.match(/Site ID:\\s+([a-f0-9-]+)/i) || siteResp.match(/([a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12})/)\n   124→      if (siteIdMatch?.[1]) {\n   125→        siteId = siteIdMatch[1]\n   126→        writeEnvValue('NETLIFY_SITE_ID', siteId)\n   127→      }\n   128→    } catch (e: unknown) {\n   129→      const err = e as { stdout?: string; stderr?: string }\n   130→      log(`Netlify site creation failed: ${err.stdout || ''} ${err.stderr || ''}`)\n   131→    }\n   132→  }\n   133→\n   134→  // Link site\n   135→  if (siteId) {\n   136→    try {\n   137→      execSync(`LC_ALL=C npx netlify link --id ${siteId}`, {\n   138→        cwd: appDir,\n   139→        stdio: 'ignore',\n   140→        timeout: 15000,\n   141→        env: { ...process.env, NETLIFY_AUTH_TOKEN: netlifyToken, LC_ALL: 'C' },\n   142→      })\n   143→    } catch { /* ok */ }\n   144→  }\n   145→\n   146→  // Step 6: Build\n   147→  try {\n   148→    const buildOut = execSync('npx vite build', {\n   149→      cwd: appDir,\n   150→      encoding: 'utf-8',\n   151→      stdio: ['ignore', 'pipe', 'pipe'],\n   152→      timeout: 120000,\n   153→    })\n   154→    log('=== Build ===\\n' + buildOut)\n   155→  } catch (e: unknown) {\n   156→    const err = e as { stdout?: string; stderr?: string }\n   157→    log('=== Build ===\\n' + (err.stdout || '') + '\\n' + (err.stderr || ''))\n   158→    writeLog()\n   159→    console.log('Deploy failed (build) — see logs/deploy.log')\n   160→    process.exit(1)\n   161→  }\n   162→\n   163→  // Step 7: Deploy\n   164→  if (siteId) {\n   165→    try {\n   166→      const deployOut = execSync(\n   167→        `LC_ALL=C npx netlify deploy --prod --dir dist --functions ./netlify/functions --site ${siteId}`,\n   168→        {\n   169→          cwd: appDir,\n   170→          encoding: 'utf-8',\n   171→          stdio: ['ignore', 'pipe', 'pipe'],\n   172→          timeout: 120000,\n   173→          env: { ...process.env, NETLIFY_AUTH_TOKEN: netlifyToken, LC_ALL: 'C' },\n   174→        }\n   175→      )\n   176→      log('=== Deploy ===\\n' + deployOut)\n   177→\n   178→      // Extract URL\n   179→      const urlMatch = deployOut.match(/https:\\/\\/[^\\s]+\\.netlify\\.app/)\n   180→      const deployedUrl = urlMatch?.[0] || 'unknown'\n   181→\n   182→      // Step 8: Write deployment.txt\n   183→      const deploymentPath = join(appDir, 'deployment.txt')\n   184→      let existingHistory = ''\n   185→      if (existsSync(deploymentPath)) {\n   186→        const content = readFileSync(deploymentPath, 'utf-8')\n   187→        const historyIdx = content.indexOf('\\n## Deployment History')\n   188→        if (historyIdx >= 0) {\n   189→          existingHistory = content.slice(historyIdx)\n   190→        }\n   191→      }\n   192→      const resourceBlock = `url=${deployedUrl}\\nsite_id=${siteId}\\nneon_project_id=${neonProjectId}\\ndatabase_url=${databaseUrl}\\n`\n   193→      writeFileSync(deploymentPath, resourceBlock + existingHistory)\n   194→\n   195→      console.log(`Deployed to ${deployedUrl}`)\n   196→    } catch (e: unknown) {\n   197→      const err = e as { stdout?: string; stderr?: string }\n   198→      log('=== Deploy ===\\n' + (err.stdout || '') + '\\n' + (err.stderr || ''))\n   199→      writeLog()\n   200→      console.log('Deploy failed (netlify) — see logs/deploy.log')\n   201→      process.exit(1)\n   202→    }\n   203→  } else {\n   204→    log('No NETLIFY_SITE_ID — skipping deploy')\n   205→    console.log('Build succeeded but no Netlify site configured')\n   206→  }\n   207→\n   208→  writeLog()\n   209→}\n   210→\n   211→deploy()\n   212→"}]},"parent_tool_use_id":null,"session_id":"c9de3f4b-08be-4be3-914c-363c5ef7580e","uuid":"fea72f54-5f52-474f-8e73-f6462e5e968f","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/scripts/deploy.ts","content":"import { execSync } from 'child_process'\nimport { readFileSync, writeFileSync, existsSync, mkdirSync } from 'fs'\nimport { join } from 'path'\nimport { initSchema } from './schema'\nimport { seedDatabase } from './seed-db'\n\nconst appDir = join(import.meta.dirname, '..')\nconst logDir = join(appDir, 'logs')\nmkdirSync(logDir, { recursive: true })\nconst logFile = join(logDir, 'deploy.log')\nlet logContent = ''\n\nfunction log(msg: string) {\n  logContent += msg + '\\n'\n}\n\nfunction writeLog() {\n  writeFileSync(logFile, logContent)\n}\n\nfunction readEnv(): Record<string, string> {\n  const envPath = join(appDir, '.env')\n  if (!existsSync(envPath)) return {}\n  const lines = readFileSync(envPath, 'utf-8').split('\\n')\n  const env: Record<string, string> = {}\n  for (const line of lines) {\n    const trimmed = line.trim()\n    if (!trimmed || trimmed.startsWith('#')) continue\n    const eqIdx = trimmed.indexOf('=')\n    if (eqIdx > 0) {\n      env[trimmed.slice(0, eqIdx)] = trimmed.slice(eqIdx + 1)\n    }\n  }\n  return env\n}\n\nfunction writeEnvValue(key: string, value: string) {\n  const envPath = join(appDir, '.env')\n  let content = ''\n  if (existsSync(envPath)) {\n    content = readFileSync(envPath, 'utf-8')\n    const lines = content.split('\\n')\n    const idx = lines.findIndex(l => l.startsWith(key + '='))\n    if (idx >= 0) {\n      lines[idx] = `${key}=${value}`\n      content = lines.join('\\n')\n    } else {\n      content = content.trimEnd() + `\\n${key}=${value}\\n`\n    }\n  } else {\n    content = `${key}=${value}\\n`\n  }\n  writeFileSync(envPath, content)\n}\n\nasync function deploy() {\n  const neonApiKey = process.env['NEON_API_KEY'] || ''\n  const netlifyToken = process.env['NETLIFY_AUTH_TOKEN'] || ''\n  const netlifySlug = process.env['NETLIFY_ACCOUNT_SLUG'] || ''\n  const env = readEnv()\n  let isFirstDeploy = false\n\n  // Step 1: Database setup\n  let databaseUrl = env['DATABASE_URL'] || ''\n  let neonProjectId = env['NEON_PROJECT_ID'] || ''\n\n  if (!neonProjectId && neonApiKey) {\n    try {\n      const resp = execSync(\n        `curl -s -X POST \"https://console.neon.tech/api/v2/projects\" -H \"Authorization: Bearer ${neonApiKey}\" -H \"Content-Type: application/json\" -d '{\"project\": {\"name\": \"airbnb-clone\"}}'`,\n        { encoding: 'utf-8', timeout: 30000 }\n      )\n      const data = JSON.parse(resp)\n      neonProjectId = data.project?.id || ''\n      databaseUrl = data.connection_uris?.[0]?.connection_uri || ''\n      if (neonProjectId) writeEnvValue('NEON_PROJECT_ID', neonProjectId)\n      if (databaseUrl) writeEnvValue('DATABASE_URL', databaseUrl)\n      log(`Created Neon project: ${neonProjectId}`)\n      isFirstDeploy = true\n    } catch (e) {\n      log(`Neon project creation failed: ${e}`)\n    }\n  }\n\n  // Step 2: Schema sync\n  if (databaseUrl) {\n    try {\n      await initSchema(databaseUrl)\n      log('Schema synced')\n    } catch (e) {\n      log(`Schema sync failed: ${e}`)\n      writeLog()\n      console.log('Deploy failed (schema) — see logs/deploy.log')\n      process.exit(1)\n    }\n\n    // Step 4: Seed on first deploy\n    if (isFirstDeploy) {\n      try {\n        await seedDatabase(databaseUrl)\n        log('Database seeded')\n      } catch (e) {\n        log(`Seeding failed: ${e}`)\n      }\n    }\n  }\n\n  // Step 5: Netlify site setup\n  let siteId = env['NETLIFY_SITE_ID'] || ''\n  if (!siteId && netlifyToken && netlifySlug) {\n    try {\n      const siteResp = execSync(\n        `LC_ALL=C npx netlify sites:create --account-slug ${netlifySlug} --name airbnb-clone-${Date.now()}`,\n        {\n          encoding: 'utf-8',\n          cwd: appDir,\n          timeout: 30000,\n          env: { ...process.env, NETLIFY_AUTH_TOKEN: netlifyToken, LC_ALL: 'C' },\n          stdio: ['ignore', 'pipe', 'pipe'],\n        }\n      )\n      log('Netlify site creation:\\n' + siteResp)\n      const siteIdMatch = siteResp.match(/Site ID:\\s+([a-f0-9-]+)/i) || siteResp.match(/([a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12})/)\n      if (siteIdMatch?.[1]) {\n        siteId = siteIdMatch[1]\n        writeEnvValue('NETLIFY_SITE_ID', siteId)\n      }\n    } catch (e: unknown) {\n      const err = e as { stdout?: string; stderr?: string }\n      log(`Netlify site creation failed: ${err.stdout || ''} ${err.stderr || ''}`)\n    }\n  }\n\n  // Link site\n  if (siteId) {\n    try {\n      execSync(`LC_ALL=C npx netlify link --id ${siteId}`, {\n        cwd: appDir,\n        stdio: 'ignore',\n        timeout: 15000,\n        env: { ...process.env, NETLIFY_AUTH_TOKEN: netlifyToken, LC_ALL: 'C' },\n      })\n    } catch { /* ok */ }\n  }\n\n  // Step 6: Build\n  try {\n    const buildOut = execSync('npx vite build', {\n      cwd: appDir,\n      encoding: 'utf-8',\n      stdio: ['ignore', 'pipe', 'pipe'],\n      timeout: 120000,\n    })\n    log('=== Build ===\\n' + buildOut)\n  } catch (e: unknown) {\n    const err = e as { stdout?: string; stderr?: string }\n    log('=== Build ===\\n' + (err.stdout || '') + '\\n' + (err.stderr || ''))\n    writeLog()\n    console.log('Deploy failed (build) — see logs/deploy.log')\n    process.exit(1)\n  }\n\n  // Step 7: Deploy\n  if (siteId) {\n    try {\n      const deployOut = execSync(\n        `LC_ALL=C npx netlify deploy --prod --dir dist --functions ./netlify/functions --site ${siteId}`,\n        {\n          cwd: appDir,\n          encoding: 'utf-8',\n          stdio: ['ignore', 'pipe', 'pipe'],\n          timeout: 120000,\n          env: { ...process.env, NETLIFY_AUTH_TOKEN: netlifyToken, LC_ALL: 'C' },\n        }\n      )\n      log('=== Deploy ===\\n' + deployOut)\n\n      // Extract URL\n      const urlMatch = deployOut.match(/https:\\/\\/[^\\s]+\\.netlify\\.app/)\n      const deployedUrl = urlMatch?.[0] || 'unknown'\n\n      // Step 8: Write deployment.txt\n      const deploymentPath = join(appDir, 'deployment.txt')\n      let existingHistory = ''\n      if (existsSync(deploymentPath)) {\n        const content = readFileSync(deploymentPath, 'utf-8')\n        const historyIdx = content.indexOf('\\n## Deployment History')\n        if (historyIdx >= 0) {\n          existingHistory = content.slice(historyIdx)\n        }\n      }\n      const resourceBlock = `url=${deployedUrl}\\nsite_id=${siteId}\\nneon_project_id=${neonProjectId}\\ndatabase_url=${databaseUrl}\\n`\n      writeFileSync(deploymentPath, resourceBlock + existingHistory)\n\n      console.log(`Deployed to ${deployedUrl}`)\n    } catch (e: unknown) {\n      const err = e as { stdout?: string; stderr?: string }\n      log('=== Deploy ===\\n' + (err.stdout || '') + '\\n' + (err.stderr || ''))\n      writeLog()\n      console.log('Deploy failed (netlify) — see logs/deploy.log')\n      process.exit(1)\n    }\n  } else {\n    log('No NETLIFY_SITE_ID — skipping deploy')\n    console.log('Build succeeded but no Netlify site configured')\n  }\n\n  writeLog()\n}\n\ndeploy()\n","numLines":212,"startLine":1,"totalLines":212}}}
