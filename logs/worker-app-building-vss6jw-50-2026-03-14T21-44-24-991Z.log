[2026-03-14T21:39:31.846Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XRoeWeLXhtjPf1W7xgVZof","type":"tool_result","content":"     1→import { Heart } from 'lucide-react'\n     2→import { useSelector, useDispatch } from 'react-redux'\n     3→import type { RootState, AppDispatch } from '../store'\n     4→import { addFavorite, removeFavorite } from '../slices/favoritesSlice'\n     5→\n     6→interface FavoriteButtonProps {\n     7→  propertyId: string\n     8→}\n     9→\n    10→export default function FavoriteButton({ propertyId }: FavoriteButtonProps) {\n    11→  const dispatch = useDispatch<AppDispatch>()\n    12→  const currentUser = useSelector((state: RootState) => state.auth.currentUser)\n    13→  const favoriteIds = useSelector((state: RootState) => state.favorites.propertyIds)\n    14→  const isFavorited = favoriteIds.includes(propertyId)\n    15→\n    16→  if (!currentUser) return null\n    17→\n    18→  const handleClick = (e: React.MouseEvent) => {\n    19→    e.preventDefault()\n    20→    e.stopPropagation()\n    21→    if (isFavorited) {\n    22→      dispatch(removeFavorite({ userId: currentUser.id, propertyId }))\n    23→    } else {\n    24→      dispatch(addFavorite({ userId: currentUser.id, propertyId }))\n    25→    }\n    26→  }\n    27→\n    28→  return (\n    29→    <button\n    30→      data-testid={`favorite-button-${propertyId}`}\n    31→      onClick={handleClick}\n    32→      className=\"absolute top-3 right-3 z-10 p-1.5 rounded-full bg-white/70 hover:bg-white/90 transition-colors\"\n    33→      aria-label={isFavorited ? 'Remove from favorites' : 'Add to favorites'}\n    34→    >\n    35→      <Heart\n    36→        size={20}\n    37→        className={isFavorited ? 'fill-primary text-primary' : 'text-text-secondary'}\n    38→      />\n    39→    </button>\n    40→  )\n    41→}\n    42→"}]},"parent_tool_use_id":"toolu_01UVzJXLZVfzTSr5V3jy3JqB","session_id":"c9de3f4b-08be-4be3-914c-363c5ef7580e","uuid":"6ad1cf21-268e-4e9d-9727-829a16faedaa"}
