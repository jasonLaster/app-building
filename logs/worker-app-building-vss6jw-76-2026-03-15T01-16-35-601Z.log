[2026-03-15T01:14:37.727Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0198uRwG8UdF3PSNHNWysuqK","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions'\n     2→import { getSql } from './db.js'\n     3→\n     4→export default async (request: Request, _context: Context) => {\n     5→  const sql = getSql()\n     6→  const url = new URL(request.url)\n     7→  const segments = url.pathname.split('/').filter(Boolean)\n     8→  const propIdx = segments.indexOf('properties')\n     9→  const propertyId = propIdx >= 0 ? segments[propIdx + 1] : undefined\n    10→\n    11→  const headers = { 'Content-Type': 'application/json' }\n    12→\n    13→  if (request.method === 'GET' && propertyId) {\n    14→    const result = await sql`\n    15→      SELECT p.*,\n    16→        u.name as host_name, u.avatar_url as host_avatar, u.bio as host_bio, u.created_at as host_since,\n    17→        (SELECT count(*)::int FROM properties WHERE host_id = p.host_id AND is_active = true) as host_listing_count,\n    18→        (SELECT COALESCE(AVG(r.rating)::numeric(10,1), 0) FROM reviews r WHERE r.property_id = p.id) as avg_rating,\n    19→        (SELECT count(*)::int FROM reviews r WHERE r.property_id = p.id) as review_count\n    20→      FROM properties p\n    21→      JOIN users u ON u.id = p.host_id\n    22→      WHERE p.id = ${propertyId}\n    23→    `\n    24→    const property = result[0]\n    25→    if (!property) {\n    26→      return new Response(JSON.stringify({ error: 'Property not found' }), { status: 404, headers })\n    27→    }\n    28→\n    29→    const images = await sql`\n    30→      SELECT * FROM property_images WHERE property_id = ${propertyId} ORDER BY display_order ASC\n    31→    `\n    32→\n    33→    const amenities = await sql`\n    34→      SELECT a.* FROM amenities a\n    35→      JOIN property_amenities pa ON pa.amenity_id = a.id\n    36→      WHERE pa.property_id = ${propertyId}\n    37→      ORDER BY a.category, a.name\n    38→    `\n    39→\n    40→    const reviews = await sql`\n    41→      SELECT r.*, u.name as guest_name, u.avatar_url as guest_avatar\n    42→      FROM reviews r\n    43→      JOIN users u ON u.id = r.guest_id\n    44→      WHERE r.property_id = ${propertyId}\n    45→      ORDER BY r.created_at DESC\n    46→    `\n    47→\n    48→    return new Response(JSON.stringify({ ...property, images, amenities, reviews }), { status: 200, headers })\n    49→  }\n    50→\n    51→  if (request.method === 'GET') {\n    52→    const city = url.searchParams.get('city') || ''\n    53→    const checkIn = url.searchParams.get('check_in') || ''\n    54→    const checkOut = url.searchParams.get('check_out') || ''\n    55→    const guestsStr = url.searchParams.get('guests') || '0'\n    56→    const propertyType = url.searchParams.get('property_type') || ''\n    57→    const minPriceStr = url.searchParams.get('min_price') || '0'\n    58→    const maxPriceStr = url.searchParams.get('max_price') || '0'\n    59→    const minBedroomsStr = url.searchParams.get('min_bedrooms') || '0'\n    60→    const minBedsStr = url.searchParams.get('min_beds') || '0'\n    61→    const minBathroomsStr = url.searchParams.get('min_bathrooms') || '0'\n    62→    const amenitiesParam = url.searchParams.get('amenities') || ''\n    63→    const page = parseInt(url.searchParams.get('page') || '1', 10)\n    64→    const limit = parseInt(url.searchParams.get('limit') || '12', 10)\n    65→    const offset = (page - 1) * limit\n    66→\n    67→    const guestsNum = parseInt(guestsStr, 10) || 0\n    68→    const minPrice = parseFloat(minPriceStr) || 0\n    69→    const maxPrice = parseFloat(maxPriceStr) || 0\n    70→    const minBedrooms = parseInt(minBedroomsStr, 10) || 0\n    71→    const minBeds = parseInt(minBedsStr, 10) || 0\n    72→    const minBathrooms = parseInt(minBathroomsStr, 10) || 0\n    73→    const amenityIds = amenitiesParam ? amenitiesParam.split(',').filter(Boolean) : []\n    74→    const amenityCount = amenityIds.length\n    75→    const hasDateFilter = checkIn !== '' && checkOut !== ''\n    76→    const hasAmenityFilter = amenityCount > 0\n    77→\n    78→    const countResult = await sql`\n    79→      SELECT count(*)::int as total\n    80→      FROM properties p\n    81→      WHERE p.is_active = true\n    82→        AND (${city} = '' OR LOWER(p.city) LIKE LOWER('%' || ${city} || '%'))\n    83→        AND (${guestsNum} = 0 OR p.max_guests >= ${guestsNum})\n    84→        AND (${propertyType} = '' OR p.property_type = ${propertyType})\n    85→        AND (${minPrice} = 0 OR p.price_per_night >= ${minPrice})\n    86→        AND (${maxPrice} = 0 OR p.price_per_night <= ${maxPrice})\n    87→        AND (${minBedrooms} = 0 OR p.bedrooms >= ${minBedrooms})\n    88→        AND (${minBeds} = 0 OR p.beds >= ${minBeds})\n    89→        AND (${minBathrooms} = 0 OR p.bathrooms >= ${minBathrooms})\n    90→        AND (${!hasDateFilter} OR NOT EXISTS (\n    91→          SELECT 1 FROM bookings b\n    92→          WHERE b.property_id = p.id\n    93→          AND b.status IN ('confirmed', 'pending')\n    94→          AND b.check_in < ${checkOut || '9999-12-31'}\n    95→          AND b.check_out > ${checkIn || '1970-01-01'}\n    96→        ))\n    97→        AND (${!hasAmenityFilter} OR (\n    98→          SELECT count(*) FROM property_amenities pa\n    99→          WHERE pa.property_id = p.id AND pa.amenity_id::text = ANY(${amenityIds})\n   100→        ) >= ${amenityCount})\n   101→    `\n   102→    const countRow = countResult[0]\n   103→    const total = countRow ? (countRow as Record<string, unknown>).total as number : 0\n   104→\n   105→    const properties = await sql`\n   106→      SELECT p.*,\n   107→        (SELECT url FROM property_images pi WHERE pi.property_id = p.id ORDER BY pi.display_order ASC LIMIT 1) as main_image,\n   108→        (SELECT COALESCE(AVG(r.rating)::numeric(10,1), 0) FROM reviews r WHERE r.property_id = p.id) as avg_rating,\n   109→        (SELECT count(*)::int FROM reviews r WHERE r.property_id = p.id) as review_count\n   110→      FROM properties p\n   111→      WHERE p.is_active = true\n   112→        AND (${city} = '' OR LOWER(p.city) LIKE LOWER('%' || ${city} || '%'))\n   113→        AND (${guestsNum} = 0 OR p.max_guests >= ${guestsNum})\n   114→        AND (${propertyType} = '' OR p.property_type = ${propertyType})\n   115→        AND (${minPrice} = 0 OR p.price_per_night >= ${minPrice})\n   116→        AND (${maxPrice} = 0 OR p.price_per_night <= ${maxPrice})\n   117→        AND (${minBedrooms} = 0 OR p.bedrooms >= ${minBedrooms})\n   118→        AND (${minBeds} = 0 OR p.beds >= ${minBeds})\n   119→        AND (${minBathrooms} = 0 OR p.bathrooms >= ${minBathrooms})\n   120→        AND (${!hasDateFilter} OR NOT EXISTS (\n   121→          SELECT 1 FROM bookings b\n   122→          WHERE b.property_id = p.id\n   123→          AND b.status IN ('confirmed', 'pending')\n   124→          AND b.check_in < ${checkOut || '9999-12-31'}\n   125→          AND b.check_out > ${checkIn || '1970-01-01'}\n   126→        ))\n   127→        AND (${!hasAmenityFilter} OR (\n   128→          SELECT count(*) FROM property_amenities pa\n   129→          WHERE pa.property_id = p.id AND pa.amenity_id::text = ANY(${amenityIds})\n   130→        ) >= ${amenityCount})\n   131→      ORDER BY p.created_at DESC\n   132→      LIMIT ${limit} OFFSET ${offset}\n   133→    `\n   134→\n   135→    return new Response(JSON.stringify({\n   136→      properties,\n   137→      total,\n   138→      page,\n   139→      limit,\n   140→      totalPages: Math.ceil(total / limit),\n   141→    }), { status: 200, headers })\n   142→  }\n   143→\n   144→  if (request.method === 'POST') {\n   145→    const body = await request.json() as {\n   146→      host_id: string\n   147→      title: string\n   148→      description: string\n   149→      property_type: string\n   150→      price_per_night: number\n   151→      cleaning_fee: number\n   152→      max_guests: number\n   153→      bedrooms: number\n   154→      beds: number\n   155→      bathrooms: number\n   156→      address: string\n   157→      city: string\n   158→      state: string | null\n   159→      country: string\n   160→      latitude: number | null\n   161→      longitude: number | null\n   162→      amenity_ids?: string[]\n   163→    }\n   164→\n   165→    const {\n   166→      host_id, title, description, property_type, price_per_night, cleaning_fee,\n   167→      max_guests, bedrooms, beds, bathrooms, address, city, state, country,\n   168→      latitude, longitude, amenity_ids,\n   169→    } = body\n   170→\n   171→    if (!host_id || !title || !property_type || !price_per_night || !max_guests || !city || !country) {\n   172→      return new Response(JSON.stringify({ error: 'Missing required fields' }), { status: 400, headers })\n   173→    }\n   174→\n   175→    const result = await sql`\n   176→      INSERT INTO properties (id, host_id, title, description, property_type, price_per_night, cleaning_fee,\n   177→        max_guests, bedrooms, beds, bathrooms, address, city, state, country, latitude, longitude,\n   178→        is_active, created_at, updated_at)\n   179→      VALUES (gen_random_uuid(), ${host_id}, ${title}, ${description || ''}, ${property_type},\n   180→        ${price_per_night}, ${cleaning_fee || 0}, ${max_guests}, ${bedrooms || 0}, ${beds || 0},\n   181→        ${bathrooms || 0}, ${address || ''}, ${city}, ${state || null}, ${country},\n   182→        ${latitude || null}, ${longitude || null}, true, now(), now())\n   183→      RETURNING *\n   184→    `\n   185→    const property = result[0]\n   186→\n   187→    if (amenity_ids && amenity_ids.length > 0) {\n   188→      for (const amenityId of amenity_ids) {\n   189→        await sql`\n   190→          INSERT INTO property_amenities (property_id, amenity_id)\n   191→          VALUES (${(property as Record<string, unknown>).id as string}, ${amenityId})\n   192→          ON CONFLICT DO NOTHING\n   193→        `\n   194→      }\n   195→    }\n   196→\n   197→    return new Response(JSON.stringify(property), { status: 201, headers })\n   198→  }\n   199→\n   200→  if (request.method === 'PUT' && propertyId) {\n   201→    const body = await request.json() as {\n   202→      is_active?: boolean\n   203→      title?: string\n   204→      description?: string\n   205→      price_per_night?: number\n   206→      cleaning_fee?: number\n   207→    }\n   208→\n   209→    const existing = await sql`SELECT * FROM properties WHERE id = ${propertyId}`\n   210→    const existingProp = existing[0]\n   211→    if (!existingProp) {\n   212→      return new Response(JSON.stringify({ error: 'Property not found' }), { status: 404, headers })\n   213→    }\n   214→\n   215→    const ep = existingProp as Record<string, unknown>\n   216→    const result = await sql`\n   217→      UPDATE properties SET\n   218→        is_active = ${body.is_active !== undefined ? body.is_active : ep.is_active as boolean},\n   219→        title = ${body.title !== undefined ? body.title : ep.title as string},\n   220→        description = ${body.description !== undefined ? body.description : ep.description as string},\n   221→        price_per_night = ${body.price_per_night !== undefined ? body.price_per_night : ep.price_per_night as number},\n   222→        cleaning_fee = ${body.cleaning_fee !== undefined ? body.cleaning_fee : ep.cleaning_fee as number},\n   223→        updated_at = now()\n   224→      WHERE id = ${propertyId}\n   225→      RETURNING *\n   226→    `\n   227→    const property = result[0]\n   228→    return new Response(JSON.stringify(property), { status: 200, headers })\n   229→  }\n   230→\n   231→  if (request.method === 'DELETE' && propertyId) {\n   232→    const result = await sql`\n   233→      UPDATE properties SET is_active = false, updated_at = now()\n   234→      WHERE id = ${propertyId}\n   235→      RETURNING *\n   236→    `\n   237→    const property = result[0]\n   238→    if (!property) {\n   239→      return new Response(JSON.stringify({ error: 'Property not found' }), { status: 404, headers })\n   240→    }\n   241→    return new Response(JSON.stringify(property), { status: 200, headers })\n   242→  }\n   243→\n   244→  return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers })\n   245→}\n   246→"}]},"parent_tool_use_id":"toolu_012Xv6sn42QoxDYftHDcYr93","session_id":"d099cb6b-8de3-4b36-ac07-7c19b8c3c6c1","uuid":"aee03d0a-150d-49f4-81f0-9a69e95bef61"}
