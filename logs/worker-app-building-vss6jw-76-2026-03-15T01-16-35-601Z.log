ategory, a.name\n    38→    `\n    39→\n    40→    const reviews = await sql`\n    41→      SELECT r.*, u.name as guest_name, u.avatar_url as guest_avatar\n    42→      FROM reviews r\n    43→      JOIN users u ON u.id = r.guest_id\n    44→      WHERE r.property_id = ${propertyId}\n    45→      ORDER BY r.created_at DESC\n    46→    `\n    47→\n    48→    return new Response(JSON.stringify({ ...property, images, amenities, reviews }), { status: 200, headers })\n    49→  }\n    50→\n    51→  if (request.method === 'GET') {\n    52→    const city = url.searchParams.get('city') || ''\n    53→    const checkIn = url.searchParams.get('check_in') || ''\n    54→    const checkOut = url.searchParams.get('check_out') || ''\n    55→    const guestsStr = url.searchParams.get('guests') || '0'\n    56→    const propertyType = url.searchParams.get('property_type') || ''\n    57→    const minPriceStr = url.searchParams.get('min_price') || '0'\n    58→    const maxPriceStr = url.searchParams.get('max_price') || '0'\n    59→    const minBedroomsStr = url.searchParams.get('min_bedrooms') || '0'\n    60→    const minBedsStr = url.searchParams.get('min_beds') || '0'\n    61→    const minBathroomsStr = url.searchParams.get('min_bathrooms') || '0'\n    62→    const amenitiesParam = url.searchParams.get('amenities') || ''\n    63→    const page = parseInt(url.searchParams.get('page') || '1', 10)\n    64→    const limit = parseInt(url.searchParams.get('limit') || '12', 10)\n    65→    const offset = (page - 1) * limit\n    66→\n    67→    const guestsNum = parseInt(guestsStr, 10) || 0\n    68→    const minPrice = parseFloat(minPriceStr) || 0\n    69→    const maxPrice = parseFloat(maxPriceStr) || 0\n    70→    const minBedrooms = parseInt(minBedroomsStr, 10) || 0\n    71→    const minBeds = parseInt(minBedsStr, 10) || 0\n    72→    const minBathrooms = parseInt(minBathroomsStr, 10) || 0\n    73→    const amenityIds = amenitiesParam ? amenitiesParam.split(',').filter(Boolean) : []\n    74→    const amenityCount = amenityIds.length\n    75→    const hasDateFilter = checkIn !== '' && checkOut !== ''\n    76→    const hasAmenityFilter = amenityCount > 0\n    77→\n    78→    const countResult = await sql`\n    79→      SELECT count(*)::int as total\n    80→      FROM properties p\n    81→      WHERE p.is_active = true\n    82→        AND (${city} = '' OR LOWER(p.city) LIKE LOWER('%' || ${city} || '%'))\n    83→        AND (${guestsNum} = 0 OR p.max_guests >= ${guestsNum})\n    84→        AND (${propertyType} = '' OR p.property_type = ${propertyType})\n    85→        AND (${minPrice} = 0 OR p.price_per_night >= ${minPrice})\n    86→        AND (${maxPrice} = 0 OR p.price_per_night <= ${maxPrice})\n    87→        AND (${minBedrooms} = 0 OR p.bedrooms >= ${minBedrooms})\n    88→        AND (${minBeds} = 0 OR p.beds >= ${minBeds})\n    89→        AND (${minBathrooms} = 0 OR p.bathrooms >= ${minBathrooms})\n    90→        AND (${!hasDateFilter} OR NOT EXISTS (\n    91→          SELECT 1 FROM bookings b\n    92→          WHERE b.property_id = p.id\n    93→          AND b.status IN ('confirmed', 'pending')\n    94→          AND b.check_in < ${checkOut || '9999-12-31'}\n    95→          AND b.check_out > ${checkIn || '1970-01-01'}\n    96→        ))\n    97→        AND (${!hasAmenityFilter} OR (\n    98→          SELECT count(*) FROM property_amenities pa\n    99→          WHERE pa.property_id = p.id AND pa.amenity_id::text = ANY(${amenityIds})\n   100→        ) >= ${amenityCount})\n   101→    `\n   102→    const countRow = countResult[0]\n   103→    const total = countRow ? (countRow as Record<string, unknown>).total as number : 0\n   104→\n   105→    const properties = await sql`\n   106→      SELECT p.*,\n   107→        (SELECT url FROM property_images pi WHERE pi.property_id = p.id ORDER BY pi.display_order ASC LIMIT 1) as main_image,\n   108→        (SELECT COALESCE(AVG(r.rating)::numeric(10,1), 0) FROM reviews r WHERE r.property_id = p.id) as avg_rating,\n 