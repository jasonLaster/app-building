[2]\n    49→if (!testFile) {\n    50→  console.error('Usage: npm run test <test-file>')\n    51→  process.exit(1)\n    52→}\n    53→\n    54→async function run() {\n    55→  const env = readEnv()\n    56→  const neonProjectId = env['NEON_PROJECT_ID'] || process.env['NEON_PROJECT_ID'] || ''\n    57→  const neonApiKey = process.env['NEON_API_KEY'] || ''\n    58→  const replayApiKey = process.env['RECORD_REPLAY_API_KEY'] || ''\n    59→\n    60→  if (!neonProjectId || !neonApiKey) {\n    61→    console.error('Missing NEON_PROJECT_ID or NEON_API_KEY')\n    62→    process.exit(1)\n    63→  }\n    64→\n    65→  // Step 1: Kill stale processes\n    66→  tryExec('pkill -f \"netlify dev\" 2>/dev/null || true', { stdio: 'ignore' })\n    67→  tryExec('pkill -f \"vite\" 2>/dev/null || true', { stdio: 'ignore' })\n    68→\n    69→  // Step 2: Clean up stale test branches\n    70→  try {\n    71→    const branchesResp = execSync(\n    72→      `curl -s \"https://console.neon.tech/api/v2/projects/${neonProjectId}/branches\" -H \"Authorization: Bearer ${neonApiKey}\"`,\n    73→      { encoding: 'utf-8', timeout: 15000 }\n    74→    )\n    75→    const branches = JSON.parse(branchesResp).branches || []\n    76→    for (const b of branches) {\n    77→      if (typeof b.name === 'string' && b.name.startsWith('test-run-')) {\n    78→        tryExec(\n    79→          `curl -s -X DELETE \"https://console.neon.tech/api/v2/projects/${neonProjectId}/branches/${b.id}\" -H \"Authorization: Bearer ${neonApiKey}\"`,\n    80→          { stdio: 'ignore', timeout: 10000 }\n    81→        )\n    82→        log(`Cleaned up stale branch: ${b.name}`)\n    83→      }\n    84→    }\n    85→  } catch { log('Warning: could not clean stale branches') }\n    86→\n    87→  // Step 3: Create ephemeral branch\n    88→  const branchName = `test-run-${Date.now()}`\n    89→  let branchId = ''\n    90→  let testDbUrl = ''\n    91→\n    92→  try {\n    93→    const resp = execSync(\n    94→      `curl -s -X POST \"