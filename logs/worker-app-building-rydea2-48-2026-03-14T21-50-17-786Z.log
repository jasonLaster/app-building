4→  background-color: var(--color-bg-hover);\n    65→  color: var(--color-text-primary);\n    66→}\n    67→\n    68→.group-by-sort-option-active {\n    69→  color: var(--color-text-primary);\n    70→  font-weight: 500;\n    71→}\n    72→"}]},"parent_tool_use_id":"toolu_01EkUfEZ2w5eDBguR1Pyx5fp","session_id":"bfa44b73-8bd5-4621-8202-172b5d211566","uuid":"9c50b65c-c666-4c3f-b500-fc400cb7d000"}
