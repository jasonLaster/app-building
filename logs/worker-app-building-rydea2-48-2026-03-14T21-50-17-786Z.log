[2026-03-14T21:47:20.016Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UuByppZUq6nXt2K1DmVXx2","type":"tool_result","content":"     1→import { createSlice, createAsyncThunk } from '@reduxjs/toolkit';\n     2→import type { Issue } from './issuesSlice';\n     3→import { updateIssueStatus } from './issuesSlice';\n     4→\n     5→export interface CycleSummary {\n     6→  id: string;\n     7→  name: string;\n     8→  startDate: string;\n     9→  endDate: string;\n    10→  teamId: string;\n    11→  issueCount: number;\n    12→  doneCount: number;\n    13→  inProgressCount: number;\n    14→  isActive: boolean;\n    15→}\n    16→\n    17→export interface CycleIssue extends Issue {\n    18→  cycleName: string | null;\n    19→}\n    20→\n    21→export interface BurndownEntry {\n    22→  date: string;\n    23→  count: number;\n    24→}\n    25→\n    26→export interface CycleDetail {\n    27→  id: string;\n    28→  name: string;\n    29→  startDate: string;\n    30→  endDate: string;\n    31→  teamId: string;\n    32→}\n    33→\n    34→interface CycleDetailMember {\n    35→  id: string;\n    36→  name: string;\n    37→  email: string;\n    38→}\n    39→\n    40→interface CyclesState {\n    41→  cycles: CycleSummary[];\n    42→  loading: boolean;\n    43→  error: string | null;\n    44→  selectedCycleId: string | null;\n    45→  cycleDetail: CycleDetail | null;\n    46→  cycleIssues: CycleIssue[];\n    47→  cycleMembers: CycleDetailMember[];\n    48→  burndown: BurndownEntry[];\n    49→  detailLoading: boolean;\n    50→  detailError: string | null;\n    51→  groupBy: 'status' | 'priority' | 'assignee' | 'project' | 'label' | 'none';\n    52→  sortBy: 'priority' | 'created' | 'updated' | 'status';\n    53→  selectedIds: string[];\n    54→}\n    55→\n    56→const initialState: CyclesState = {\n    57→  cycles: [],\n    58→  loading: false,\n    59→  error: null,\n    60→  selectedCycleId: null,\n    61→  cycleDetail: null,\n    62→  cycleIssues: [],\n    63→  cycleMembers: [],\n    64→  burndown: [],\n    65→  detailLoading: false,\n    66→  detailError: null,\n    67→  groupBy: 'status',\n    68→  sortBy: 'priority',\n    69→  selectedIds: [],\n    70→};\n    71→\n    72→export const fetchCycles = createAsyncThunk(\n    73→  'cycles/fetchCycles',\n    74→  async (teamId: string, { getState, rejectWithValue }) => {\n    75→    const state = getState() as { auth: { token: string | null } };\n    76→    const token = state.auth.token;\n    77→    if (!token) return rejectWithValue('No token');\n    78→    const response = await fetch(`/api/cycles?teamId=${teamId}`, {\n    79→      headers: { Authorization: `Bearer ${token}` },\n    80→    });\n    81→    if (!response.ok) {\n    82→      return rejectWithValue('Failed to fetch cycles');\n    83→    }\n    84→    return await response.json() as { cycles: CycleSummary[] };\n    85→  }\n    86→);\n    87→\n    88→export const fetchCycleIssues = createAsyncThunk(\n    89→  'cycles/fetchCycleIssues',\n    90→  async (cycleId: string, { getState, rejectWithValue }) => {\n    91→    const state = getState() as { auth: { token: string | null } };\n    92→    const token = state.auth.token;\n    93→    if (!token) return rejectWithValue('No token');\n    94→    const response = await fetch(`/api/cycle-issues?cycleId=${cycleId}`, {\n    95→      headers: { Authorization: `Bearer ${token}` },\n    96→    });\n    97→    if (!response.ok) {\n    98→      return rejectWithValue('Failed to fetch cycle issues');\n    99→    }\n   100→    return await response.json() as {\n   101→      cycle: CycleDetail;\n   102→      issues: CycleIssue[];\n   103→      members: CycleDetailMember[];\n   104→      burndown: BurndownEntry[];\n   105→    };\n   106→  }\n   107→);\n   108→\n   109→export const createCycle = createAsyncThunk(\n   110→  'cycles/createCycle',\n   111→  async (\n   112→    payload: { teamId: string; name: string; startDate: string; endDate: string },\n   113→    { getState, rejectWithValue }\n   114→  ) => {\n   115→    const state = getState() as { auth: { token: string | null } };\n   116→    const token = state.auth.token;\n   117→    if (!token) return rejectWithValue('No token');\n   118→    const response = await fetch('/api/cycles', {\n   119→      method: 'POST',\n   120→      headers: {\n   121→        'Content-Type': 'application/json',\n   122→        Authorization: `Bearer ${token}`,\n   123→      },\n   124→      body: JSON.stringify(payload),\n   125→    });\n   126→    if (!response.ok) {\n   127→      return rejectWithValue('Failed to create cycle');\n   128→    }\n   129→    return await response.json() as CycleSummary;\n   130→  }\n   131→);\n   132→\n   133→const cyclesSlice = createSlice({\n   134→  name: 'cycles',\n   135→  initialState,\n   136→  reducers: {\n   137→    setSelectedCycleId(state, action: { payload: string | null }) {\n   138→      state.selectedCycleId = action.payload;\n   139→    },\n   140→    setCycleGroupBy(state, action: { payload: CyclesState['groupBy'] }) {\n   141→      state.groupBy = action.payload;\n   142→    },\n   143→    setCycleSortBy(state, action: { payload: CyclesState['sortBy'] }) {\n   144→      state.sortBy = action.payload;\n   145→    },\n   146→    toggleCycleIssueSelection(state, action: { payload: string }) {\n   147→      const id = action.payload;\n   148→      const idx = state.selectedIds.indexOf(id);\n   149→      if (idx >= 0) {\n   150→        state.selectedIds.splice(idx, 1);\n   151→      } else {\n   152→        state.selectedIds.push(id);\n   153→      }\n   154→    },\n   155→    selectCycleGroupIssues(state, action: { payload: string[] }) {\n   156→      const ids = action.payload;\n   157→      const allSelected = ids.every((id) => state.selectedIds.includes(id));\n   158→      if (allSelected) {\n   159→        state.selectedIds = state.selectedIds.filter((id) => !ids.includes(id));\n   160→      } else {\n   161→        const newIds = ids.filter((id) => !state.selectedIds.includes(id));\n   162→        state.selectedIds.push(...newIds);\n   163→      }\n   164→    },\n   165→    clearCycleSelection(state) {\n   166→      state.selectedIds = [];\n   167→    },\n   168→  },\n   169→  extraReducers: (builder) => {\n   170→    builder\n   171→      .addCase(fetchCycles.pending, (state) => {\n   172→        if (state.cycles.length === 0) {\n   173→          state.loading = true;\n   174→        }\n   175→        state.error = null;\n   176→      })\n   177→      .addCase(fetchCycles.fulfilled, (state, action) => {\n   178→        state.loading = false;\n   179→        state.cycles = action.payload.cycles;\n   180→      })\n   181→      .addCase(fetchCycles.rejected, (state, action) => {\n   182→        state.loading = false;\n   183→        state.error = action.payload as string;\n   184→      })\n   185→      .addCase(fetchCycleIssues.pending, (state) => {\n   186→        if (state.cycleIssues.length === 0) {\n   187→          state.detailLoading = true;\n   188→        }\n   189→        state.detailError = null;\n   190→      })\n   191→      .addCase(fetchCycleIssues.fulfilled, (state, action) => {\n   192→        state.detailLoading = false;\n   193→        state.cycleDetail = action.payload.cycle;\n   194→        state.cycleIssues = action.payload.issues;\n   195→        state.cycleMembers = action.payload.members;\n   196→        state.burndown = action.payload.burndown;\n   197→        state.selectedIds = [];\n   198→      })\n   199→      .addCase(fetchCycleIssues.rejected, (state, action) => {\n   200→        state.detailLoading = false;\n   201→        state.detailError = action.payload as string;\n   202→      })\n   203→      .addCase(createCycle.fulfilled, (state, action) => {\n   204→        state.cycles.push(action.payload);\n   205→        state.cycles.sort((a, b) => a.startDate.localeCompare(b.startDate));\n   206→      })\n   207→      .addCase(updateIssueStatus.fulfilled, (state, action) => {\n   208→        const { issueId, status } = action.payload;\n   209→        const issue = state.cycleIssues.find((i) => i.id === issueId);\n   210→        if (issue) {\n   211→          issue.status = status;\n   212→        }\n   213→      });\n   214→  },\n   215→});\n   216→\n   217→export const {\n   218→  setSelectedCycleId,\n   219→  setCycleGroupBy,\n   220→  setCycleSortBy,\n   221→  toggleCycleIssueSelection,\n   222→  selectCycleGroupIssues,\n   223→  clearCycleSelection,\n   224→} = cyclesSlice.actions;\n   225→\n   226→export default cyclesSlice.reducer;\n   227→"}]},"parent_tool_use_id":"toolu_01EkUfEZ2w5eDBguR1Pyx5fp","session_id":"bfa44b73-8bd5-4621-8202-172b5d211566","uuid":"7c563421-91de-4001-a6c1-2fe5927d5a6f"}
