[2026-03-14T21:47:24.543Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015SPa66oH823oyfGdiWpwwF","type":"tool_result","content":"     1→import { useState, useRef, useEffect } from 'react';\n     2→import { useSelector } from 'react-redux';\n     3→import type { RootState } from '../store';\n     4→import { STATUS_ORDER, STATUS_CONFIG, StatusIcon, PriorityIcon } from './IssueRow';\n     5→import './TeamFilters.css';\n     6→\n     7→const PRIORITY_ORDER = ['urgent', 'high', 'medium', 'low', 'none'] as const;\n     8→const PRIORITY_LABELS: Record<string, string> = {\n     9→  urgent: 'Urgent',\n    10→  high: 'High',\n    11→  medium: 'Medium',\n    12→  low: 'Low',\n    13→  none: 'No Priority',\n    14→};\n    15→\n    16→interface TeamFiltersProps {\n    17→  selectedStatuses: string[];\n    18→  selectedPriorities: string[];\n    19→  selectedAssignees: string[];\n    20→  selectedLabels: string[];\n    21→  selectedProjects: string[];\n    22→  selectedCycles: string[];\n    23→  onStatusChange: (v: string[]) => void;\n    24→  onPriorityChange: (v: string[]) => void;\n    25→  onAssigneeChange: (v: string[]) => void;\n    26→  onLabelChange: (v: string[]) => void;\n    27→  onProjectChange: (v: string[]) => void;\n    28→  onCycleChange: (v: string[]) => void;\n    29→}\n    30→\n    31→type DropdownType = 'status' | 'priority' | 'assignee' | 'label' | 'project' | 'cycle' | null;\n    32→\n    33→function CheckIcon() {\n    34→  return (\n    35→    <svg width=\"10\" height=\"10\" viewBox=\"0 0 10 10\" fill=\"none\">\n    36→      <path d=\"M2 5l2 2 4-4\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n    37→    </svg>\n    38→  );\n    39→}\n    40→\n    41→export default function TeamFilters({\n    42→  selectedStatuses,\n    43→  selectedPriorities,\n    44→  selectedAssignees,\n    45→  selectedLabels,\n    46→  selectedProjects,\n    47→  selectedCycles,\n    48→  onStatusChange,