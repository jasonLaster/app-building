ndleClickOutside);\n    40→  }, [openDropdown]);\n    41→\n    42→  if (selectedIds.length === 0) {\n    43→    return null;\n    44→  }\n    45→\n    46→  function toggleDropdown(type: DropdownType) {\n    47→    setOpenDropdown(openDropdown === type ? null : type);\n    48→  }\n    49→\n    50→  function handleStatusChange(status: string) {\n    51→    dispatch(bulkUpdateIssues({ issueIds: selectedIds, status, teamId }));\n    52→    setOpenDropdown(null);\n    53→  }\n    54→\n    55→  function handlePriorityChange(priority: string) {\n    56→    dispatch(bulkUpdateIssues({ issueIds: selectedIds, priority, teamId }));\n    57→    setOpenDropdown(null);\n    58→  }\n    59→\n    60→  function handleAssigneeChange(assigneeId: string | null) {\n    61→    dispatch(bulkUpdateIssues({ issueIds: selectedIds, assigneeId, teamId }));\n    62→    setOpenDropdown(null);\n    63→  }\n    64→\n    65→  function handleLabelChange(labelId: string) {\n    66→    dispatch(bulkUpdateIssues({ issueIds: selectedIds, labelId, teamId }));\n    67→    setOpenDropdown(null);\n    68→  }\n    69→\n    70→  return (\n    71→    <div className=\"bulk-actions\" ref={toolbarRef} data-testid=\"bulk-actions-toolbar\">\n    72→      <span className=\"bulk-actions-count\" data-testid=\"bulk-actions-count\">\n    73→        {selectedIds.length} selected\n    74→      </span>\n    75→\n    76→      <div className=\"bulk-actions-buttons\">\n    77→        <div className=\"bulk-actions-dropdown-wrapper\">\n    78→          <button\n    79→            className=\"bulk-actions-btn\"\n    80→            onClick={() => toggleDropdown('status')}\n    81→            data-testid=\"bulk-action-status\"\n    82→          >\n    83→            Status\n    84→          </button>\n    85→          {openDropdown === 'status' && (\n    86→            <div className=\"bulk-actions-dropdown\" data-testid=\"bulk-action-status-dropdown\">\n    87→              {STATUS_ORDER.map((s) => {\n    88→                const cfg = STATUS_CONFIG[s];\n    89→                return (\n    90→                  <button\n    91→                    key={s}\n    92→                    className=\"bulk-actions-option\"\n    93→                    onClick={() => handleStatusChange(s)}\n    94→                    data-testid={`bulk-status-option-${s}`}\n    95→                  >\n    96→                    <StatusIcon status={s} color={cfg.color} />\n    97→                    <span>{cfg.label}</span>\n    98→                  </button>\n    99→                );\n   100→              })}\n   101→            </div>\n   102→          )}\n   103→        </div>\n   104→\n   105→        <div className=\"bulk-actions-dropdown-wrapper\">\n   106→          <button\n   107→            className=\"bulk-actions-btn\"\n   108→            onClick={() => toggleDropdown('priority')}\n   109→            data-testid=\"bulk-action-priority\"\n   110→          >\n   111→            Priority\n   112→          </button>\n   113→          {openDropdown === 'priority' && (\n   114→            <div className=\"bulk-actions-dropdown\" data-testid=\"bulk-action-priority-dropdown\">\n   115→              {PRIORITY_ORDER.map((p) => (\n   116→                <button\n   117→                  key={p}\n   118→                  className=\"bulk-actions-option\"\n   119→                  onClick={() => handlePriorityChange(p)}\n   120→                  data-testid={`bulk-priority-option-${p}`}\n   121→                >\n   122→                  <PriorityIcon priority={p} />\n   123→                  <span>{PRIORITY_CONFIG_MAP[p].label}</span>\n   124→                </button>\n   125→              ))}\n   126→            </div>\n   127→          )}\n   128→        </div>\n   129→\n   130→        <div className=\"bulk-actions-dropdown-wrapper\">\n   131→          <button\n   132→            className=\"bulk-actions-btn\"\n   133→            onClick={() => toggleDropdown('assignee')}\n   134→            data-testid=\"bulk-action