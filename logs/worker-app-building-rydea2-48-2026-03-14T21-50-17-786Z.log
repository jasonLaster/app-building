160→      assigneeId: user.id,\n   161→    });\n   162→\n   163→    await page.goto('/login');\n   164→    await page.evaluate((t) => localStorage.setItem('session_token', t), token);\n   165→    await page.goto('/my-issues');\n   166→    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n   167→\n   168→    // Verify all three groups are visible\n   169→    await expect(page.getByTestId('issue-group-items-todo')).toBeVisible({ timeout: 30000 });\n   170→    await expect(page.getByTestId('issue-group-items-in_progress')).toBeVisible();\n   171→    await expect(page.getByTestId('issue-group-items-done')).toBeVisible();\n   172→\n   173→    // Collapse todo group\n   174→    await page.getByTestId('issue-group-header-todo').click();\n   175→    await expect(page.getByTestId('issue-group-items-todo')).toHaveCount(0);\n   176→\n   177→    // Collapse done group\n   178→    await page.getByTestId('issue-group-header-done').click();\n   179→    await expect(page.getByTestId('issue-group-items-done')).toHaveCount(0);\n   180→\n   181→    // In Progress should still be expanded\n   182→    await expect(page.getByTestId('issue-group-items-in_progress')).toBeVisible();\n   183→  });\n   184→\n   185→  test('My Issues page only shows issues assigned to current user', async ({ page, baseURL }) => {\n   186→    await loginAndNavigate(page, baseURL!);\n   187→\n   188→    // Alice's issues should be present: ENG-1, ENG-6, DES-3\n   189→    const issueRows = page.locator('[data-testid^=\"issue-row-\"]');\n   190→    await expect(issueRows).toHaveCount(3, { timeout: 30000 });\n   191→\n   192→    // Verify Alice's issue identifiers are present\n   193→    await expect(page.locator('[data-testid^=\"issue-identifier-\"]').filter({ hasText: /^ENG-1$/ })).toHaveCount(1);\n   194→    await expect(page.locator('[data-testid^=\"issue-identifier-\"]').filter({ hasText: /^ENG-6$/ })).toHaveCount(1);\n   195→    await expect(page.locator('[data-testid^=\"issue-identifier-\"]').filter({ hasText: /^DES-3$/ })).toHaveCount(1);\n   196→\n   197→    // Bob's issues should NOT be present\n   198→    await expect(page.locator('[data-testid^=\"issue-identifier-\"]').filter({ hasText: /^ENG-2$/ })).toHaveCount(0);\n   199→    await expect(page.locator('[data-testid^=\"issue-identifier-\"]').filter({ hasText: /^ENG-5$/ })).toHaveCount(0);\n   200→    await expect(page.locator('[data-testid^=\"issue-identifier-\"]').filter({ hasText: /^ENG-8$/ })).toHaveCount(0);\n   201→\n   202→    // Unassigned issues should NOT be present\n   203→    await expect(page.locator('[data-testid^=\"issue-identifier-\"]').filter({ hasText: /^ENG-3$/ })).toHaveCount(0);\n   204→    await expect(page.locator('[data-testid^=\"issue-identifier-\"]').filter({ hasText: /^ENG-7$/ })).toHaveCount(0);\n   205→  });\n   206→\n   207→  test('My Issues page updates when issue is assigned to user', async ({ page, baseURL }) => {\n   208→    const { token, user } = await loginViaApi(baseURL!, 'alice@acme.com', 'password123');\n   209→    const teams = await getTeams(baseURL!, token);\n   210→    const engTeam = teams.find((t: { identifier: string }) => t.identifier === 'ENG');\n   211→\n   212→    await page.goto('/login');\n   213→    await page.evaluate((t) => localStorage.setItem('session_token', t), token);\n   214→    await page.goto('/my-issues');\n   215→    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n   216→\n   217→    // Wait for issues to load and count initial issues\n   218→    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(3, { timeout: 30000 });\n   219→\n   220→    // Create a new issue assigned to Alice via API\n   221→    const issueTitle = `Newly assigned issue ${Date.now()}`;\n   222→    await createIssueViaApi(baseURL!, token, {\n   223→      teamId: engTeam.id,\n   224→      title: issueTitle,\n   225→      status: 'todo',\n   226→      priority: 'medium',\n   227→      assigneeId: user.id,\n   228→    });\n   229→\n   230→    // Reload the page to pick up the new issue\n   231→    await page.reload();\n   232→    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n   233→\n   234→    // Verify the new issue appears in the list (4 total now)\n   235→    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(4, { timeout: 30000 });\n   236→  });\n   237→\n   238→  test('My Issues page title and header are displayed', async ({ page, baseURL }) => {\n   239→    await loginAndNavigate(page, baseURL!);\n   240→\n   241→    // Verify the page title \"My Issues\" is displayed\n   242→    await expect(page.getByTestId('my-issues-title')).toBeVisible({ timeout: 30000 });\n   243→    await expect(page.getByTestId('my-issues-title')).toHaveText('My Issues');\n   244→  });\n   245→});\n   246→"}]},"parent_tool_use_id":"toolu_014kn77MzCnhjhxHh8Qc613G","session_id":"bfa44b73-8bd5-4621-8202-172b5d211566","uuid":"4e013800-d9d8-48ec-889d-9e169771dbfb"}
