[2026-03-14T21:47:51.521Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BYixfc9YpGgt7PKUT6hDLe","type":"tool_result","content":"     1→import { useState, useMemo } from 'react';\n     2→import { useSelector, useDispatch } from 'react-redux';\n     3→import type { RootState, AppDispatch } from '../store';\n     4→import type { TeamIssue } from '../slices/teamIssuesSlice';\n     5→import { toggleIssueSelection, selectGroupIssues } from '../slices/teamIssuesSlice';\n     6→import { STATUS_ORDER, STATUS_CONFIG, StatusIcon, PriorityIcon, PRIORITY_CONFIG } from './IssueRow';\n     7→import IssueRow from './IssueRow';\n     8→import './TeamIssuesList.css';\n     9→\n    10→const PRIORITY_ORDER = ['urgent', 'high', 'medium', 'low', 'none'] as const;\n    11→const STATUS_SORT_MAP: Record<string, number> = {};\n    12→STATUS_ORDER.forEach((s, i) => { STATUS_SORT_MAP[s] = i; });\n    13→const PRIORITY_SORT_MAP: Record<string, number> = {};\n    14→PRIORITY_ORDER.forEach((p, i) => { PRIORITY_SORT_MAP[p] = i; });\n    15→\n    16→interface IssueGroup {\n    17→  key: string;\n    18→  label: string;\n    19→  icon: React.ReactNode;\n    20→  issues: TeamIssue[];\n    21→}\n    22→\n    23→function sortIssues(issues: TeamIssue[], sortBy: string): TeamIssue[] {\n    24→  return [...issues].sort((a, b) => {\n    25→    switch (sortBy) {\n    26→      case 'priority':\n    27→        return (PRIORITY_SORT_MAP[a.priority] ?? 4) - (PRIORITY_SORT_MAP[b.priority] ?? 4);\n    28→      case 'created':\n    29→        return new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();\n    30→      case 'updated':\n    31→        return new Date(b.updatedAt).getTime() - new Date(a.updatedAt).getTime();\n    32→      case 'status':\n    33→        return (STATUS_SORT_MAP[a.status] ?? 0) - (STATUS_SORT_MAP[b.status] ?? 0);\n    34→      default:\n    35→        return 0;\n    36→    }\n    37→  });\n    38→}\n    39→\n    40→function getInitials(name: string): string {\n    41→  return name.split(' ').map((n) => n[0]).join('').toUpperCase().slice(0, 2);\n    42→}\n    43→\n    44→interface TeamIssuesListProps {\n    45→  issues: TeamIssue[];\n    46→  loading: boolean;\n    47→}\n    48→\n    49→export default function TeamIssuesList({ issues, loading }: TeamIssuesListProps) {\n    50→  const dispatch = useDispatch<AppDispatch>();\n    51→  const { selectedIds, groupBy, sortBy, members } = useSelector((state: RootState) => state.teamIssues);\n    52→  const [collapsedGroups, setCollapsedGroups] = useState<Record<string, boolean>>({});\n    53→\n    54→  const groups: IssueGroup[] = useMemo(() => {\n    55→    const sorted = sortIssues(issues, sortBy);\n    56→\n    57→    if (groupBy === 'none') {\n    58→      return [{\n    59→        key: 'all',\n    60→        label: '',\n    61→        icon: null,\n    62→        issues: sorted,\n    63→      }];\n    64→    }\n    65→\n    66→    if (groupBy === 'status') {\n    67→      const result: IssueGroup[] = [];\n    68→      for (const status of STATUS_ORDER) {\n    69→        const cfg = STATUS_CONFIG[status];\n    70→        const groupIssues = sorted.filter((i) => i.status === status);\n    71→        if (groupIssues.length > 0) {\n    72→          result.push({\n    73→            key: status,\n    74→            label: cfg.label,\n    75→            icon: <StatusIcon status={status} color={cfg.color} />,\n    76→            issues: groupIssues,\n    77→          });\n    78→        }\n    79→      }\n    80→      return result;\n    81→    }\n    82→\n    83→    if (groupBy === 'priority') {\n    84→      const result: IssueGroup[] = [];\n    85→      for (const priority of PRIORITY_ORDER) {\n    86→        const cfg = PRIORITY_CONFIG[priority];\n    87→        const groupIssues = sorted.filter((i) => i.priority === priority);\n    88→        if (groupIssues.length > 0) {\n    89→          result.push({\n    90→            key: priority,\n    91→            label: cfg.label,\n    92→            icon: <PriorityIcon priority={priority} />,\n    93→            issues: groupIssues,\n    94→          });\n    95→        }\n    96→      }\n    97→      return result;\n    98→    }\n    99→\n   100→    if (groupBy === 'assignee') {\n   101→      const result: IssueGroup[] = [];\n   102→      const assigneeMap = new Map<string, { name: string; issues: TeamIssue[] }>();\n   103→\n   104→      for (const m of members) {\n   105→        assigneeMap.set(m.id, { name: m.name, issues: [] });\n   106→      }\n   107→      assigneeMap.set('unassigned', { name: 'Unassigned', issues: [] });\n   108→\n   109→      for (const issue of sorted) {\n   110→        const key = issue.assigneeId || 'unassigned';\n   111→        const entry = assigneeMap.get(key);\n   112→        if (entry) {\n   113→          entry.issues.push(issue);\n   114→        } else {\n   115→          assigneeMap.set(key, { name: issue.assigneeName || 'Unknown', issues: [issue] });\n   116→        }\n   117→      }\n   118→\n   119→      for (const [key, entry] of assigneeMap.entries()) {\n   120→        if (entry.issues.length > 0) {\n   121→          result.push({\n   122→            key,\n   123→            label: entry.name,\n   124→            icon: key === 'unassigned' ? (\n   125→              <span className=\"team-issues-list-avatar team-issues-list-avatar-empty\">?</span>\n   126→            ) : (\n   127→              <span className=\"team-issues-list-avatar\">{getInitials(entry.name)}</span>\n   128→            ),\n   129→            issues: entry.issues,\n   130→          });\n   131→        }\n   132→      }\n   133→      return result;\n   134→    }\n   135→\n   136→    if (groupBy === 'project') {\n   137→      const result: IssueGroup[] = [];\n   138→      const projectMap = new Map<string, { name: string; issues: TeamIssue[] }>();\n   139→\n   140→      projectMap.set('none', { name: 'No Project', issues: [] });\n   141→\n   142→      for (const issue of sorted) {\n   143→        const key = issue.projectId || 'none';\n   144→        const entry = projectMap.get(key);\n   145→        if (entry) {\n   146→          entry.issues.push(issue);\n   147→        } else {\n   148→          projectMap.set(key, { name: issue.projectName || 'Unknown', issues: [issue] });\n   149→        }\n   150→      }\n   151→\n   152→      for (const [key, entry] of projectMap.entries()) {\n   153→        if (entry.issues.length > 0) {\n   154→          result.push({\n   155→            key,\n   156→            label: entry.name,\n   157→            icon: (\n   158→              <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--color-text-tertiary)\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n   159→                <path d=\"M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z\" />\n   160→              </svg>\n   161→            ),\n   162→            issues: entry.issues,\n   163→          });\n   164→        }\n   165→      }\n   166→      return result;\n   167→    }\n   168→\n   169→    if (groupBy === 'label') {\n   170→      const result: IssueGroup[] = [];\n   171→      const labelMap = new Map<string, { name: string; color: string; issues: TeamIssue[] }>();\n   172→\n   173→      labelMap.set('none', { name: 'No Label', color: 'var(--color-text-tertiary)', issues: [] });\n   174→\n   175→      for (const issue of sorted) {\n   176→        if (issue.labels.length === 0) {\n   177→          labelMap.get('none')!.issues.push(issue);\n   178→        } else {\n   179→          for (const label of issue.labels) {\n   180→            const entry = labelMap.get(label.id);\n   181→            if (entry) {\n   182→              entry.issues.push(issue);\n   183→            } else {\n   184→              labelMap.set(label.id, { name: label.name, color: label.color, issues: [issue] });\n   185→            }\n   186→          }\n   187→        }\n   188→      }\n   189→\n   190→      for (const [key, entry] of labelMap.entries()) {\n   191→        if (entry.issues.length > 0) {\n   192→          result.push({\n   193→            key,\n   194→            label: entry.name,\n   195→            icon: <span className=\"team-issues-list-label-dot\" style={{ backgroundColor: entry.color }} />,\n   196→            issues: entry.issues,\n   197→          });\n   198→        }\n   199→      }\n   200→      return result;\n   201→    }\n   202→\n   203→    return [];\n   204→  }, [issues, groupBy, sortBy, members]);\n   205→\n   206→  function toggleGroup(key: string) {\n   207→    setCollapsedGroups((prev) => ({ ...prev, [key]: !prev[key] }));\n   208→  }\n   209→\n   210→  function handleCheckChange(issueId: string) {\n   211→    dispatch(toggleIssueSelection(issueId));\n   212→  }\n   213→\n   214→  function handleGroupSelect(groupIssueIds: string[]) {\n   215→    dispatch(selectGroupIssues(groupIssueIds));\n   216→  }\n   217→\n   218→  if (loading) {\n   219→    return (\n   220→      <div className=\"team-issues-list-loading\" data-testid=\"team-issues-loading\">\n   221→        Loading...\n   222→      </div>\n   223→    );\n   224→  }\n   225→\n   226→  if (issues.length === 0) {\n   227→    return (\n   228→      <div className=\"team-issues-list-empty\" data-testid=\"team-issues-empty\">\n   229→        <svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--color-text-tertiary)\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n   230→          <circle cx=\"12\" cy=\"12\" r=\"10\" />\n   231→          <line x1=\"8\" y1=\"12\" x2=\"16\" y2=\"12\" />\n   232→        </svg>\n   233→        <p>No issues yet. Create your first issue to get started.</p>\n   234→      </div>\n   235→    );\n   236→  }\n   237→\n   238→  if (groupBy === 'none') {\n   239→    return (\n   240→      <div className=\"team-issues-list\" data-testid=\"team-issues-list\">\n   241→        {groups[0]?.issues.map((issue) => (\n   242→          <IssueRow\n   243→            key={issue.id}\n   244→            issue={issue}\n   245→            showCheckbox\n   246→            checked={selectedIds.includes(issue.id)}\n   247→            onCheckChange={handleCheckChange}\n   248→          />\n   249→        ))}\n   250→      </div>\n   251→    );\n   252→  }\n   253→\n   254→  return (\n   255→    <div className=\"team-issues-list\" data-testid=\"team-issues-list\">\n   256→      {groups.map((group) => {\n   257→        const isCollapsed = !!collapsedGroups[group.key];\n   258→        const groupIssueIds = group.issues.map((i) => i.id);\n   259→        const allSelected = groupIssueIds.length > 0 && groupIssueIds.every((id) => selectedIds.includes(id));\n   260→\n   261→        return (\n   262→          <div key={group.key} className=\"team-issues-group\" data-testid={`team-issue-group-${group.key}`}>\n   263→            <div className=\"team-issues-group-header\" data-testid={`team-issue-group-header-${group.key}`}>\n   264→              <label\n   265→                className=\"team-issues-group-select\"\n   266→                onClick={(e) => e.stopPropagation()}\n   267→                data-testid={`team-issue-group-select-${group.key}`}\n   268→              >\n   269→                <input\n   270→                  type=\"checkbox\"\n   271→                  className=\"team-issues-group-checkbox\"\n   272→                  checked={allSelected}\n   273→                  onChange={() => handleGroupSelect(groupIssueIds)}\n   274→                />\n   275→              </label>\n   276→              <button\n   277→                className=\"team-issues-group-toggle\"\n   278→                onClick={() => toggleGroup(group.key)}\n   279→                data-testid={`team-issue-group-toggle-${group.key}`}\n   280→              >\n   281→                <svg\n   282→                  className={`team-issues-group-chevron ${isCollapsed ? '' : 'team-issues-group-chevron-expanded'}`}\n   283→                  width=\"12\"\n   284→                  height=\"12\"\n   285→                  viewBox=\"0 0 24 24\"\n   286→                  fill=\"none\"\n   287→                  stroke=\"currentColor\"\n   288→                  strokeWidth=\"2\"\n   289→                  strokeLinecap=\"round\"\n   290→                  strokeLinejoin=\"round\"\n   291→                >\n   292→                  <polyline points=\"9 18 15 12 9 6\" />\n   293→                </svg>\n   294→                {group.icon}\n   295→                <span className=\"team-issues-group-label\">{group.label}</span>\n   296→                <span className=\"team-issues-group-count\">({group.issues.length})</span>\n   297→              </button>\n   298→            </div>\n   299→            {!isCollapsed && (\n   300→              <div className=\"team-issues-group-items\" data-testid={`team-issue-group-items-${group.key}`}>\n   301→                {group.issues.map((issue) => (\n   302→                  <IssueRow\n   303→                    key={issue.id}\n   304→                    issue={issue}\n   305→                    showCheckbox\n   306→                    checked={selectedIds.includes(issue.id)}\n   307→                    onCheckChange={handleCheckChange}\n   308→                  />\n   309→                ))}\n   310→              </div>\n   311→            )}\n   312→          </div>\n   313→        );\n   314→      })}\n   315→    </div>\n   316→  );\n   317→}\n   318→"}]},"parent_tool_use_id":null,"session_id":"bfa44b73-8bd5-4621-8202-172b5d211566","uuid":"fc73c20e-dc80-432f-9422-5953f04b16b0","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/src/components/TeamIssuesList.tsx","content":"import { useState, useMemo } from 'react';\nimport { useSelector, useDispatch } from 'react-redux';\nimport type { RootState, AppDispatch } from '../store';\nimport type { TeamIssue } from '../slices/teamIssuesSlice';\nimport { toggleIssueSelection, selectGroupIssues } from '../slices/teamIssuesSlice';\nimport { STATUS_ORDER, STATUS_CONFIG, StatusIcon, PriorityIcon, PRIORITY_CONFIG } from './IssueRow';\nimport IssueRow from './IssueRow';\nimport './TeamIssuesList.css';\n\nconst PRIORITY_ORDER = ['urgent', 'high', 'medium', 'low', 'none'] as const;\nconst STATUS_SORT_MAP: Record<string, number> = {};\nSTATUS_ORDER.forEach((s, i) => { STATUS_SORT_MAP[s] = i; });\nconst PRIORITY_SORT_MAP: Record<string, number> = {};\nPRIORITY_ORDER.forEach((p, i) => { PRIORITY_SORT_MAP[p] = i; });\n\ninterface IssueGroup {\n  key: string;\n  label: string;\n  icon: React.ReactNode;\n  issues: TeamIssue[];\n}\n\nfunction sortIssues(issues: TeamIssue[], sortBy: string): TeamIssue[] {\n  return [...issues].sort((a, b) => {\n    switch (sortBy) {\n      case 'priority':\n        return (PRIORITY_SORT_MAP[a.priority] ?? 4) - (PRIORITY_SORT_MAP[b.priority] ?? 4);\n      case 'created':\n        return new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();\n      case 'updated':\n        return new Date(b.updatedAt).getTime() - new Date(a.updatedAt).getTime();\n      case 'status':\n        return (STATUS_SORT_MAP[a.status] ?? 0) - (STATUS_SORT_MAP[b.status] ?? 0);\n      default:\n        return 0;\n    }\n  });\n}\n\nfunction getInitials(name: string): string {\n  return name.split(' ').map((n) => n[0]).join('').toUpperCase().slice(0, 2);\n}\n\ninterface TeamIssuesListProps {\n  issues: TeamIssue[];\n  loading: boolean;\n}\n\nexport default function TeamIssuesList({ issues, loading }: TeamIssuesListProps) {\n  const dispatch = useDispatch<AppDispatch>();\n  const { selectedIds, groupBy, sortBy, members } = useSelector((state: RootState) => state.teamIssues);\n  const [collapsedGroups, setCollapsedGroups] = useState<Record<string, boolean>>({});\n\n  const groups: IssueGroup[] = useMemo(() => {\n    const sorted = sortIssues(issues, sortBy);\n\n    if (groupBy === 'none') {\n      return [{\n        key: 'all',\n        label: '',\n        icon: null,\n        issues: sorted,\n      }];\n    }\n\n    if (groupBy === 'status') {\n      const result: IssueGroup[] = [];\n      for (const status of STATUS_ORDER) {\n        const cfg = STATUS_CONFIG[status];\n        const groupIssues = sorted.filter((i) => i.status === status);\n        if (groupIssues.length > 0) {\n          result.push({\n            key: status,\n            label: cfg.label,\n            icon: <StatusIcon status={status} color={cfg.color} />,\n            issues: groupIssues,\n          });\n        }\n      }\n      return result;\n    }\n\n    if (groupBy === 'priority') {\n      const result: IssueGroup[] = [];\n      for (const priority of PRIORITY_ORDER) {\n        const cfg = PRIORITY_CONFIG[priority];\n        const groupIssues = sorted.filter((i) => i.priority === priority);\n        if (groupIssues.length > 0) {\n          result.push({\n            key: priority,\n            label: cfg.label,\n            icon: <PriorityIcon priority={priority} />,\n            issues: groupIssues,\n          });\n        }\n      }\n      return result;\n    }\n\n    if (groupBy === 'assignee') {\n      const result: IssueGroup[] = [];\n      const assigneeMap = new Map<string, { name: string; issues: TeamIssue[] }>();\n\n      for (const m of members) {\n        assigneeMap.set(m.id, { name: m.name, issues: [] });\n      }\n      assigneeMap.set('unassigned', { name: 'Unassigned', issues: [] });\n\n      for (const issue of sorted) {\n        const key = issue.assigneeId || 'unassigned';\n        const entry = assigneeMap.get(key);\n        if (entry) {\n          entry.issues.push(issue);\n        } else {\n          assigneeMap.set(key, { name: issue.assigneeName || 'Unknown', issues: [issue] });\n        }\n      }\n\n      for (const [key, entry] of assigneeMap.entries()) {\n        if (entry.issues.length > 0) {\n          result.push({\n            key,\n            label: entry.name,\n            icon: key === 'unassigned' ? (\n              <span className=\"team-issues-list-avatar team-issues-list-avatar-empty\">?</span>\n            ) : (\n              <span className=\"team-issues-list-avatar\">{getInitials(entry.name)}</span>\n            ),\n            issues: entry.issues,\n          });\n        }\n      }\n      return result;\n    }\n\n    if (groupBy === 'project') {\n      const result: IssueGroup[] = [];\n      const projectMap = new Map<string, { name: string; issues: TeamIssue[] }>();\n\n      projectMap.set('none', { name: 'No Project', issues: [] });\n\n      for (const issue of sorted) {\n        const key = issue.projectId || 'none';\n        const entry = projectMap.get(key);\n        if (entry) {\n          entry.issues.push(issue);\n        } else {\n          projectMap.set(key, { name: issue.projectName || 'Unknown', issues: [issue] });\n        }\n      }\n\n      for (const [key, entry] of projectMap.entries()) {\n        if (entry.issues.length > 0) {\n          result.push({\n            key,\n            label: entry.name,\n            icon: (\n              <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--color-text-tertiary)\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n                <path d=\"M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z\" />\n              </svg>\n            ),\n            issues: entry.issues,\n          });\n        }\n      }\n      return result;\n    }\n\n    if (groupBy === 'label') {\n      const result: IssueGroup[] = [];\n      const labelMap = new Map<string, { name: string; color: string; issues: TeamIssue[] }>();\n\n      labelMap.set('none', { name: 'No Label', color: 'var(--color-text-tertiary)', issues: [] });\n\n      for (const issue of sorted) {\n        if (issue.labels.length === 0) {\n          labelMap.get('none')!.issues.push(issue);\n        } else {\n          for (const label of issue.labels) {\n            const entry = labelMap.get(label.id);\n            if (entry) {\n              entry.issues.push(issue);\n            } else {\n              labelMap.set(label.id, { name: label.name, color: label.color, issues: [issue] });\n            }\n          }\n        }\n      }\n\n      for (const [key, entry] of labelMap.entries()) {\n        if (entry.issues.length > 0) {\n          result.push({\n            key,\n            label: entry.name,\n            icon: <span className=\"team-issues-list-label-dot\" style={{ backgroundColor: entry.color }} />,\n            issues: entry.issues,\n          });\n        }\n      }\n      return result;\n    }\n\n    return [];\n  }, [issues, groupBy, sortBy, members]);\n\n  function toggleGroup(key: string) {\n    setCollapsedGroups((prev) => ({ ...prev, [key]: !prev[key] }));\n  }\n\n  function handleCheckChange(issueId: string) {\n    dispatch(toggleIssueSelection(issueId));\n  }\n\n  function handleGroupSelect(groupIssueIds: string[]) {\n    dispatch(selectGroupIssues(groupIssueIds));\n  }\n\n  if (loading) {\n    return (\n      <div className=\"team-issues-list-loading\" data-testid=\"team-issues-loading\">\n        Loading...\n      </div>\n    );\n  }\n\n  if (issues.length === 0) {\n    return (\n      <div className=\"team-issues-list-empty\" data-testid=\"team-issues-empty\">\n        <svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--color-text-tertiary)\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n          <circle cx=\"12\" cy=\"12\" r=\"10\" />\n          <line x1=\"8\" y1=\"12\" x2=\"16\" y2=\"12\" />\n        </svg>\n        <p>No issues yet. Create your first issue to get started.</p>\n      </div>\n    );\n  }\n\n  if (groupBy === 'none') {\n    return (\n      <div className=\"team-issues-list\" data-testid=\"team-issues-list\">\n        {groups[0]?.issues.map((issue) => (\n          <IssueRow\n            key={issue.id}\n            issue={issue}\n            showCheckbox\n            checked={selectedIds.includes(issue.id)}\n            onCheckChange={handleCheckChange}\n          />\n        ))}\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"team-issues-list\" data-testid=\"team-issues-list\">\n      {groups.map((group) => {\n        const isCollapsed = !!collapsedGroups[group.key];\n        const groupIssueIds = group.issues.map((i) => i.id);\n        const allSelected = groupIssueIds.length > 0 && groupIssueIds.every((id) => selectedIds.includes(id));\n\n        return (\n          <div key={group.key} className=\"team-issues-group\" data-testid={`team-issue-group-${group.key}`}>\n            <div className=\"team-issues-group-header\" data-testid={`team-issue-group-header-${group.key}`}>\n              <label\n                className=\"team-issues-group-select\"\n                onClick={(e) => e.stopPropagation()}\n                data-testid={`team-issue-group-select-${group.key}`}\n              >\n                <input\n                  type=\"checkbox\"\n                  className=\"team-issues-group-checkbox\"\n                  checked={allSelected}\n                  onChange={() => handleGroupSelect(groupIssueIds)}\n                />\n              </label>\n              <button\n                className=\"team-issues-group-toggle\"\n                onClick={() => toggleGroup(group.key)}\n                data-testid={`team-issue-group-toggle-${group.key}`}\n              >\n                <svg\n                  className={`team-issues-group-chevron ${isCollapsed ? '' : 'team-issues-group-chevron-expanded'}`}\n                  width=\"12\"\n                  height=\"12\"\n                  viewBox=\"0 0 24 24\"\n                  fill=\"none\"\n                  stroke=\"currentColor\"\n                  strokeWidth=\"2\"\n                  strokeLinecap=\"round\"\n                  strokeLinejoin=\"round\"\n                >\n                  <polyline points=\"9 18 15 12 9 6\" />\n                </svg>\n                {group.icon}\n                <span className=\"team-issues-group-label\">{group.label}</span>\n                <span className=\"team-issues-group-count\">({group.issues.length})</span>\n              </button>\n            </div>\n            {!isCollapsed && (\n              <div className=\"team-issues-group-items\" data-testid={`team-issue-group-items-${group.key}`}>\n                {group.issues.map((issue) => (\n                  <IssueRow\n                    key={issue.id}\n                    issue={issue}\n                    showCheckbox\n                    checked={selectedIds.includes(issue.id)}\n                    onCheckChange={handleCheckChange}\n                  />\n                ))}\n              </div>\n            )}\n          </div>\n        );\n      })}\n    </div>\n  );\n}\n","numLines":318,"startLine":1,"totalLines":318}}}
