[2026-03-14T21:47:20.140Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HgN7sPL7Hmsc7h2NpN4oya","type":"tool_result","content":"     1→import { useState, useMemo, useRef, useEffect } from 'react';\n     2→import { useSelector, useDispatch } from 'react-redux';\n     3→import type { RootState, AppDispatch } from '../store';\n     4→import type { CycleIssue } from '../slices/cyclesSlice';\n     5→import {\n     6→  setCycleGroupBy,\n     7→  setCycleSortBy,\n     8→  toggleCycleIssueSelection,\n     9→  selectCycleGroupIssues,\n    10→  clearCycleSelection,\n    11→} from '../slices/cyclesSlice';\n    12→import { bulkUpdateIssues } from '../slices/teamIssuesSlice';\n    13→import IssueRow from './IssueRow';\n    14→import { STATUS_ORDER, STATUS_CONFIG, StatusIcon, PriorityIcon, PRIORITY_CONFIG } from './IssueRow';\n    15→import BurndownChart from './BurndownChart';\n    16→import './CycleDetail.css';\n    17→\n    18→const PRIORITY_ORDER = ['urgent', 'high', 'medium', 'low', 'none'] as const;\n    19→const STATUS_SORT_MAP: Record<string, number> = {};\n    20→STATUS_ORDER.forEach((s, i) => { STATUS_SORT_MAP[s] = i; });\n    21→const PRIORITY_SORT_MAP: Record<string, number> = {};\n    22→PRIORITY_ORDER.forEach((p, i) => { PRIORITY_SORT_MAP[p] = i; });\n    23→\n    24→const GROUP_OPTIONS: Array<{ value: 'status' | 'priority' | 'assignee' | 'project' | 'label' | 'none'; label: string }> = [\n    25→  { value: 'status', label: 'Status' },\n    26→  { value: 'priority', label: 'Priority' },\n    27→  { value: 'assignee', label: 'Assignee' },\n    28→  { value: 'project', label: 'Project' },\n    29→  { value: 'label', label: 'Label' },\n    30→  { value: 'none', label: 'None' },\n    31→];\n    32→\n    33→const SORT_OPTIONS: Array<{ value: 'priority' | 'created' | 'updated' | 'status'; label: string }> = [\n    34→  { value: 'priority', label: 'Priority' },\n    35→  { value: 'created', label: 'Created date' },\n    36→  { value: 'updated', label: 'Updated date' },\n    37→  { value: 'status', label: 'Status' },\n    38→];\n    39→\n    40→function formatDateRange(startDate: string, endDate: string): string {\n    41→  const start = new Date(startDate + 'T00:00:00');\n    42→  const end = new Date(endDate + 'T00:00:00');\n    43→  const opts: Intl.DateTimeFormatOptions = { month: 'short', day: 'numeric' };\n    44→  return `${start.toLocaleDateString('en-US', opts)} – ${end.toLocaleDateString('en-US', opts)}`;\n    45→}\n    46→\n    47→function sortIssues(issues: CycleIssue[], sortBy: string): CycleIssue[] {\n    48→  return [...issues].sort((a, b) => {\n    49→    switch (sortBy) {\n    50→      case 'priority':\n    51→        return (PRIORITY_SORT_MAP[a.priority] ?? 4) - (PRIORITY_SORT_MAP[b.priority] ?? 4);\n    52→      case 'created':\n    53→        return new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();\n    54→      case 'updated':\n    55→        return new Date(b.updatedAt).getTime() - new Date(a.updatedAt).getTime();\n    56→      case 'status':\n    57→        return (STATUS_SORT_MAP[a.status] ?? 0) - (STATUS_SORT_MAP[b.status] ?? 0);\n    58→      default:\n    59→        return 0;\n    60→    }\n    61→  });\n    62→}\n    63→\n    64→function getInitials(name: string): string {\n    65→  return name.split(' ').map((n) => n[0]).join('').toUpperCase().slice(0, 2);\n    66→}\n    67→\n    68→interface IssueGroup {\n    69→  key: string;\n    70→  label: string;\n    71→  icon: React.ReactNode;\n    72→  issues: CycleIssue[];\n    73→}\n    74→\n    75→const ALL_STATUSES = ['backlog', 'todo', 'in_progress', 'in_review', 'done', 'cancelled'];\n    76→const STATUS_LABELS: Record<string, string> = {\n    77→  backlog: 'Backlog', todo: 'Todo', in_progress: 'In Progress',\n    78→  in_review: 'In Review', done: 'Done', cancelled: 'Cancelled',\n    79→};\n    80→export default function CycleDetail() {\n    81→  const dispatch = useDispatch<AppDispatch>();\n    82→  const {\n    83→    cycleDetail, cycleIssues, cycleMembers, burndown,\n    84→    detailLoading, groupBy, sortBy, selectedIds,\n    85→  } = useSelector((state: RootState) => state.cycles);\n    86→\n    87→  const [collapsedGroups, setCollapsedGroups] = useState<Record<string, boolean>>({});\n    88→  const [selectedStatuses, setSelectedStatuses] = useState<string[]>([]);\n    89→  const [statusFilterOpen, setStatusFilterOpen] = useState(false);\n    90→  const [groupDropdownOpen, setGroupDropdownOpen] = useState(false);\n    91→  const [sortDropdownOpen, setSortDropdownOpen] = useState(false);\n    92→  const [bulkStatusOpen, setBulkStatusOpen] = useState(false);\n    93→\n    94→  const statusFilterRef = useRef<HTMLDivElement>(null);\n    95→  const groupRef = useRef<HTMLDivElement>(null);\n    96→  const sortRef = useRef<HTMLDivElement>(null);\n    97→  const bulkRef = useRef<HTMLDivElement>(null);\n    98→\n    99→  useEffect(() => {\n   100→    function handleClickOutside(e: MouseEvent) {\n   101→      if (statusFilterRef.current && !statusFilterRef.current.contains(e.target as Node)) {\n   102→        setStatusFilterOpen(false);\n   103→      }\n   104→      if (groupRef.current && !groupRef.current.contains(e.target as Node)) {\n   105→        setGroupDropdownOpen(false);\n   106→      }\n   107→      if (sortRef.current && !sortRef.current.contains(e.target as Node)) {\n   108→        setSortDropdownOpen(false);\n   109→      }\n   110→      if (bulkRef.current && !bulkRef.current.contains(e.target as Node)) {\n   111→        setBulkStatusOpen(false);\n   112→      }\n   113→    }\n   114→    document.addEventListener('mousedown', handleClickOutside);\n   115→    return () => document.removeEventListener('mousedown', handleClickOutside);\n   116→  }, []);\n   117→\n   118→  const filteredIssues = useMemo(() => {\n   119→    if (selectedStatuses.length === 0) return cycleIssues;\n   120→    return cycleIssues.filter((i) => selectedStatuses.includes(i.status));\n   121→  }, [cycleIssues, selectedStatuses]);\n   122→\n   123→  const groups: IssueGroup[] = useMemo(() => {\n   124→    const sorted = sortIssues(filteredIssues, sortBy);\n   125→\n   126→    if (groupBy === 'none') {\n   127→      return [{ key: 'all', label: '', icon: null, issues: sorted }];\n   128→    }\n   129→\n   130→    if (groupBy === 'status') {\n   131→      const result: IssueGroup[] = [];\n   132→      for (const status of STATUS_ORDER) {\n   133→        const cfg = STATUS_CONFIG[status];\n   134→        const groupIssues = sorted.filter((i) => i.status === status);\n   135→        if (groupIssues.length > 0) {\n   136→          result.push({\n   137→            key: status,\n   138→            label: cfg.label,\n   139→            icon: <StatusIcon status={status} color={cfg.color} />,\n   140→            issues: groupIssues,\n   141→          });\n   142→        }\n   143→      }\n   144→      return result;\n   145→    }\n   146→\n   147→    if (groupBy === 'priority') {\n   148→      const result: IssueGroup[] = [];\n   149→      for (const priority of PRIORITY_ORDER) {\n   150→        const cfg = PRIORITY_CONFIG[priority];\n   151→        const groupIssues = sorted.filter((i) => i.priority === priority);\n   152→        if (groupIssues.length > 0) {\n   153→          result.push({\n   154→            key: priority,\n   155→            label: cfg.label,\n   156→            icon: <PriorityIcon priority={priority} />,\n   157→            issues: groupIssues,\n   158→          });\n   159→        }\n   160→      }\n   161→      return result;\n   162→    }\n   163→\n   164→    if (groupBy === 'assignee') {\n   165→      const result: IssueGroup[] = [];\n   166→      const assigneeMap = new Map<string, { name: string; issues: CycleIssue[] }>();\n   167→      for (const m of cycleMembers) {\n   168→        assigneeMap.set(m.id, { name: m.name, issues: [] });\n   169→      }\n   170→      assigneeMap.set('unassigned', { name: 'Unassigned', issues: [] });\n  