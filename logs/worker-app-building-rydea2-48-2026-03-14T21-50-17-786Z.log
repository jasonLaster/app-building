urn data.teams;\n    45→}\n    46→\n    47→// Helper to create issue via API\n    48→async function createIssueViaApi(baseURL: string, token: string, issueData: Record<string, unknown>) {\n    49→  const response = await fetch(`${baseURL}/api/create-issue`, {\n    50→    method: 'POST',\n    51→    headers: {\n    52→      'Content-Type': 'application/json',\n    53→      Authorization: `Bearer ${token}`,\n    54→    },\n    55→    body: JSON.stringify(issueData),\n    56→  });\n    57→  return response.json();\n    58→}\n    59→\n    60→test.describe('MyIssuesList', () => {\n    61→  test('My Issues page renders with issues grouped by status', async ({ page, baseURL }) => {\n    62→    await loginAndNavigate(page, baseURL!);\n    63→\n    64→    // Alice has: todo (2 issues: ENG-6, DES-3) and in_progress (1 issue: ENG-1)\n    65→    // Verify todo group\n    66→    await expect(page.getByTestId('issue-group-todo')).toBeVisible({ timeout: 30000 });\n    67→    await expect(page.getByTestId('issue-group-header-todo')).toContainText('Todo');\n    68→    await expect(page.getByTestId('issue-group-header-todo')).toContainText('(2)');\n    69→\n    70→    // Verify in_progress group\n    71→    await expect(page.getByTestId('issue-group-in_progress')).toBeVisible();\n    72→    await expect(page.getByTestId('issue-group-header-in_progress')).toContainText('In Progress');\n    73→    await expect(page.getByTestId('issue-group-header-in_progress')).toContainText('(1)');\n    74→\n    75→    // Verify empty groups are NOT displayed\n    76→    await expect(page.getByTestId('issue-group-backlog')).toHaveCount(0);\n    77→    await expect(page.getByTestId('issue-group-in_review')).toHaveCount(0);\n    78→    await expect(page.getByTestId('issue-group-done')).toHaveCount(0);\n    79→    await expect(page.getByTestId('issue-group-cancelled')).toHaveCount(0);\n    80→\n    81→    // Verify groups appear in correct status order (todo before in_progress)\n    82→    const todoBox = await page.getByTestId('issue-group-todo').boundingBox();\n    83→    const inProgressBox = await page.getByTestId('issue-group-in_progress').boundingBox();\n    84→    expect(todoBox!.y).toBeLessThan(inProgressBox!.y);\n    85→  });\n    86→\n    87→  test('My Issues page shows empty state when no issues assigned', async ({ page, baseURL }) => {\n    88→    // Create a new user with no issues\n    89→    const email = `empty-user-${Date.now()}@test.com`;\n    90→    const data = await createTestUser(baseURL!, 'Empty User', email, 'password123');\n    91→\n    92→    await page.goto('/login');\n    93→    await page.evaluate((t) => localStorage.setItem('session_token', t), data.token);\n    94→    await page.goto('/my-issues');\n    95→    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n    96→\n    97→    // Verify empty state\n    98→    await expect(page.getByTestId('my-issues-empty')).toBeVisible({ timeout: 30000 });\n    99→    await expect(page.getByTestId('my-issues-empty')).toContainText('No issues assigned to you yet');\n   100→\n   101→    // Verify no issue list is shown\n   102→    await expect(page.getByTestId('my-issues-list')).toHaveCount(0);\n   103→  });\n   104→\n   105→  test('Status group is collapsible', async ({ page, baseURL }) => {\n   106→    await loginAndNavigate(page, baseURL!);\n   107→\n   108→    // Verify in_progress group items are visible\n   109→    await expect(page.getByTestId('issue-group-items-in_progress')).toBeVisible({ timeout: 30000 });\n   110→\n   111→    // Click the in_progress header to collapse\n   112→    await page.getByTestId('issue-group-header-in_progress').click();\n   113→\n   114→    // Verify items are hidden\n   115→    await expect(page.getByTestId('issue-group-items-in_progress')).toHaveCount(0);\n   116→\n   117→    // Header should still be visible\n   118→    await expect(page.getByTestId('issue-group-header-in_progress')).toBeVisible();\n   119→\n   120→    // Click