[2026-03-14T21:47:19.654Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012phG1tSjzid9rU2wrn64Ji","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test';\n     2→\n     3→// Helper to login via API and get token\n     4→async function loginViaApi(baseURL: string, email: string, password: string) {\n     5→  const response = await fetch(`${baseURL}/api/login`, {\n     6→    method: 'POST',\n     7→    headers: { 'Content-Type': 'application/json' },\n     8→    body: JSON.stringify({ email, password }),\n     9→  });\n    10→  return response.json();\n    11→}\n    12→\n    13→// Helper to get teams via API\n    14→async function getTeams(baseURL: string, token: string) {\n    15→  const response = await fetch(`${baseURL}/api/teams`, {\n    16→    headers: { Authorization: `Bearer ${token}` },\n    17→  });\n    18→  const data = await response.json();\n    19→  return data.teams;\n    20→}\n    21→\n    22→// Helper to get team issues via API\n    23→async function getTeamIssues(baseURL: string, token: string, teamId: string) {\n    24→  const response = await fetch(`${baseURL}/api/team-issues?teamId=${teamId}`, {\n    25→    headers: { Authorization: `Bearer ${token}` },\n    26→  });\n    27→  const data = await response.json();\n    28→  return data.issues;\n    29→}\n    30→\n    31→// Helper to login and navigate to team issues page\n    32→async function loginAndNavigateToTeamIssues(\n    33→  page: import('@playwright/test').Page,\n    34→  baseURL: string,\n    35→  email = 'alice@acme.com',\n    36→  password = 'password123'\n    37→) {\n    38→  const data = await loginViaApi(baseURL, email, password);\n    39→  const teams = await getTeams(baseURL, data.token);\n    40→  const engTeam = teams.find((t: { identifier: string }) => t.identifier === 'ENG');\n    41→\n    42→  await page.goto('/login');\n    43→  await page.evaluate((t) => localStorage.setItem('session_token', t), data.token);\n    44→  await page.goto(`/team/${engTeam.id}/issues`);\n    45→  await expect(page.getByTestId('team-issues-page')).toBeVisible({ timeout: 30000 });\n    46→  return { token: data.token, user: data.user, engTeam };\n    47→}\n    48→\n    49→test.describe('TeamIssuesRow', () => {\n    50→  test('Issue row displays all required fields including checkbox and team prefix', async ({ page, baseURL }) => {\n    51→    const { token, engTeam } = await loginAndNavigateToTeamIssues(page, baseURL!);\n    52→\n    53→    // Wait for issues to load\n    54→    await expect(page.getByTestId('team-issues-list')).toBeVisible({ timeout: 30000 });\n    55→\n    56→    // Get the ENG-1 issue (in_progress, high priority, assigned to Alice, Bug label)\n    57→    const issues = await getTeamIssues(baseURL!, token, engTeam.id);\n    58→    const eng1 = issues.find((i: { identifier: string }) => i.identifier === 'ENG-1');\n    59→\n    60→    // Verify issue row exists\n    61→    const row = page.getByTestId(`issue-row-${eng1.id}`);\n    62→    await expect(row).toBeVisible();\n    63→\n    64→    // Verify checkbox is present\n    65→    await expect(page.getByTestId(`issue-checkbox-${eng1.id}`)).toBeVisible();\n    66→\n    67→    // Verify priority icon is present\n    68→    await expect(page.getByTestId(`issue-priority-${eng1.id}`)).toBeVisible();\n    69→\n    70→    // Verify identifier with team prefix\n    71→    await expect(page.getByTestId(`issue-identifier-${eng1.id}`)).toHaveText('ENG-1');\n    72→\n    73→    // Verify title\n    74→    await expect(page.getByTestId(`issue-title-${eng1.id}`)).toContainText('Fix login session expiration bug');\n    75→\n    76→    // Verify status button is present\n    77→    await expect(page.getByTestId(`issue-status-btn-${eng1.id}`)).toBeVisible();\n    78→\n    79→    // Verify label badge (Bug label)\n    80→    await expect(page.getByTestId(`issue-labels-${eng1.id}`)).toBeVisible();\n    81→\n    82→    // Verify assignee avatar (Alice Johnson → AJ)\n    83→    await expect(page.getByTestId(`issue-assignee-${eng1.id}`)).toBeVisible();\n    84→    await expect(page.getByTestId(`issue-assignee-${eng1.id}`)).toContainText('AJ');\n    85→  });\n    86→\n    87→  test('Issue row title is clickable and navigates to issue detail', async ({ page, baseURL }) => {\n    88→    const { token, engTeam } = await loginAndNavigateToTeamIssues(page, baseURL!);\n    89→\n    90→    await expect(page.getByTestId('team-issues-list')).toBeVisible({ timeout: 30000 });\n    91→\n    92→    // Get ENG-1 issue ID\n    93→    const issues = await getTeamIssues(baseURL!, token, engTeam.id);\n    94→    const eng1 = issues.find((i: { identifier: string }) => i.identifier === 'ENG-1');\n    95→\n    96→    // Click the title\n    97→    await page.getByTestId(`issue-title-${eng1.id}`).click();\n    98→\n    99→    // Verify navigation to issue detail page\n   100→    await expect(page).toHaveURL(`/issue/${eng1.id}`, { timeout: 30000 });\n   101→  });\n   102→\n   103→  test('Issue row status icon is clickable to change status', async ({ page, baseURL }) => {\n   104→    const { token, engTeam } = await loginAndNavigateToTeamIssues(page, baseURL!);\n   105→\n   106→    await expect(page.getByTestId('team-issues-list')).toBeVisible({ timeout: 30000 });\n   107→\n   108→    // Find a todo issue (ENG-2)\n   109→    const issues = await getTeamIssues(baseURL!, token, engTeam.id);\n   110→    const eng2 = issues.find((i: { identifier: string }) => i.identifier === 'ENG-2');\n   111→\n   112→    // Click the status icon\n   113→    await page.getByTestId(`issue-status-btn-${eng2.id}`).click();\n   114→\n   115→    // Verify dropdown appears with all status options\n   116→    await expect(page.getByTestId(`issue-status-dropdown-${eng2.id}`)).toBeVisible();\n   117→    await expect(page.getByTestId('issue-status-option-backlog')).toBeVisible();\n   118→    await expect(page.getByTestId('issue-status-option-todo')).toBeVisible();\n   119→    await expect(page.getByTestId('issue-status-option-in_progress')).toBeVisible();\n   120→    await expect(page.getByTestId('issue-status-option-in_review')).toBeVisible();\n   121→    await expect(page.getByTestId('issue-status-option-done')).toBeVisible();\n   122→    await expect(page.getByTestId('issue-status-option-cancelled')).toBeVisible();\n   123→  });\n   124→\n   125→  test('Changing status via issue row status dropdown persists and moves issue between groups', async ({ page, baseURL }) => {\n   126→    const { token, engTeam } = await loginAndNavigateToTeamIssues(page, baseURL!);\n   127→\n   128→    await expect(page.getByTestId('team-issues-list')).toBeVisible({ timeout: 30000 });\n   129→\n   130→    // Find ENG-2 (currently todo)\n   131→    const issues = await getTeamIssues(baseURL!, token, engTeam.id);\n   132→    const eng2 = issues.find((i: { identifier: string }) => i.identifier === 'ENG-2');\n   133→\n   134→    // Verify initial todo group has 2 issues, in_progress has 2\n   135→    await expect(page.getByTestId('team-issue-group-header-todo')).toContainText('(2)');\n   136→    await expect(page.getByTestId('team-issue-group-header-in_progress')).toContainText('(2)');\n   137→\n   138→    // Click status icon on ENG-2\n   139→    await page.getByTestId(`issue-status-btn-${eng2.id}`).click();\n   140→    await expect(page.getByTestId(`issue-status-dropdown-${eng2.id}`)).toBeVisible();\n   141→\n   142→    // Select \"In Progress\"\n   143→    await page.getByTestId('issue-status-option-in_progress').click();\n   144→\n   145→    // Dropdown should close\n   146→    await expect(page.getByTestId(`issue-status-dropdown-${eng2.id}`)).toHaveCount(0);\n   147→\n   148→    // Verify group counts updated: todo should now have 1, in_progress should have 3\n   149→    await expect(page.getByTestId('team-issue-group-header-todo')).toContainText('(1)', { timeout: 30000 });\n   150→    await expect(page.getByTestId('team-issue-group-header-in_progress')).toContainText('(3)');\n   151→\n   152→    // Verify the issue moved to in_progress group\n   153→    const inProgressItems = page.getByTestId('team-issue-group-items-in_progress');\n   154→    await expect(inProgressItems.locator(`[data-testid=\"issue-identifier-${eng2.id}\"]`)).toBeVisible();\n   155→  });\n   156→\n   157→  test('Issue row status dropdown can be used multiple times', async ({ page, baseURL }) => {\n   158→    const { token, engTeam } = await loginAndNavigateToTeamIssues(page, baseURL!);\n   159→\n   160→    await expect(page.getByTestId('team-issues-list')).toBeVisible({ timeout: 30000 });\n   161→\n   162→    // Find ENG-6 (currently todo)\n   163→    const issues = await getTeamIssues(baseURL!, token, engTeam.id);\n   164→    const eng6 = issues.find((i: { identifier: string }) => i.identifier === 'ENG-6');\n   165→\n   166→    // First change: todo → in_progress\n   167→    await page.getByTestId(`issue-status-btn-${eng6.id}`).click();\n   168→    await expect(page.getByTestId(`issue-status-dropdown-${eng6.id}`)).toBeVisible();\n   169→    await page.getByTestId('issue-status-option-in_progress').click();\n   170→    await expect(page.getByTestId(`issue-status-dropdown-${eng6.id}`)).toHaveCount(0);\n   171→\n   172→    // Verify ENG-6 is now in in_progress group\n   173→    await expect(\n   174→      page.getByTestId('team-issue-group-items-in_progress')\n   175→        .locator(`[data-testid=\"issue-identifier-${eng6.id}\"]`)\n   176→    ).toBeVisible({ timeout: 30000 });\n   177→\n   178→    // Second change: in_progress → done\n   179→    await page.getByTestId(`issue-status-btn-${eng6.id}`).click();\n   180→    await expect(page.getByTestId(`issue-status-dropdown-${eng6.id}`)).toBeVisible();\n   181→    await page.getByTestId('issue-status-option-done').click();\n   182→    await expect(page.getByTestId(`issue-status-dropdown-${eng6.id}`)).toHaveCount(0);\n   183→\n   184→    // Verify ENG-6 is now in done group\n   185→    await expect(\n   186→      page.getByTestId('team-issue-group-items-done')\n   187→        .locator(`[data-testid=\"issue-identifier-${eng6.id}\"]`)\n   188→    ).toBeVisible({ timeout: 30000 });\n   189→  });\n   190→\n   191→  test('Issue row displays priority icon with correct color', async ({ page, baseURL }) => {\n   192→    const { token, engTeam } = await loginAndNavigateToTeamIssues(page, baseURL!);\n   193→\n   194→    await expect(page.getByTestId('team-issues-list')).toBeVisible({ timeout: 30000 });\n   195→\n   196→    const issues = await getTeamIssues(baseURL!, token, engTeam.id);\n   197→\n   198→    // ENG-6 is urgent priority\n   199→    const eng6 = issues.find((i: { identifier: string }) => i.identifier === 'ENG-6');\n   200→    const urgentPriority = page.getByTestId(`issue-priority-${eng6.id}`);\n   201→    await expect(urgentPriority).toBeVisible();\n   202→    await expect(urgentPriority).toHaveAttribute('title', 'Urgent');\n   203→\n   204→    // ENG-1 is high priority\n   205→    const eng1 = issues.find((i: { identifier: string }) => i.identifier === 'ENG-1');\n   206→    const highPriority = page.getByTestId(`issue-priority-${eng1.id}`);\n   207→    await expect(highPriority).toBeVisible();\n   208→    await expect(highPriority).toHaveAttribute('title', 'High');\n   209→\n   210→    // ENG-2 is medium priority\n   211→    const eng2 = issues.find((i: { identifier: string }) => i.identifier === 'ENG-2');\n   212→    const mediumPriority = page.getByTestId(`issue-priority-${eng2.id}`);\n   213→    await expect(mediumPriority).toBeVisible();\n   214→    await expect(mediumPriority).toHaveAttribute('title', 'Medium');\n   215→\n   216→    // ENG-3 is low priority\n   217→    const eng3 = issues.find((i: { identifier: string }) => i.identifier === 'ENG-3');\n   218→    const lowPriority = page.getByTestId(`issue-priority-${eng3.id}`);\n   219→    await expect(lowPriority).toBeVisible();\n   220→    await expect(lowPriority).toHaveAttribute('title', 'Low');\n   221→\n   222→    // ENG-7 is no priority\n   223→    const eng7 = issues.find((i: { identifier: string }) => i.identifier === 'ENG-7');\n   224→    const nonePriority = page.getByTestId(`issue-priority-${eng7.id}`);\n   225→    await expect(nonePriority).toBeVisible();\n   226→    await expect(nonePriority).toHaveAttribute('title', 'No Priority');\n   227→  });\n   228→\n   229→  test('Issue row displays labels as colored badges', async ({ page, baseURL }) => {\n   230→    const { token, engTeam } = await loginAndNavigateToTeamIssues(page, baseURL!);\n   231→\n   232→    await expect(page.getByTestId('team-issues-list')).toBeVisible({ timeout: 30000 });\n   233→\n   234→    const issues = await getTeamIssues(baseURL!, token, engTeam.id);\n   235→\n   236→    // ENG-1 has \"Bug\" label (red)\n   237→    const eng1 = issues.find((i: { identifier: string }) => i.identifier === 'ENG-1');\n   238→    const labelsContainer = page.getByTestId(`issue-labels-${eng1.id}`);\n   239→    await expect(labelsContainer).toBeVisible();\n   240→\n   241→    // Find the Bug label badge\n   242→    const bugLabel = eng1.labels.find((l: { name: string }) => l.name === 'Bug');\n   243→    const labelBadge = page.getByTestId(`issue-label-${eng1.id}-${bugLabel.id}`);\n   244→    await expect(labelBadge).toBeVisible();\n   245→    await expect(labelBadge).toContainText('Bug');\n   246→  });\n   247→\n   248→  test('Issue row shows assignee avatar', async ({ page, baseURL }) => {\n   249→    const { token, engTeam } = await loginAndNavigateToTeamIssues(page, baseURL!);\n   250→\n   251→    await expect(page.getByTestId('team-issues-list')).toBeVisible({ timeout: 30000 });\n   252→\n   253→    const issues = await getTeamIssues(baseURL!, token, engTeam.id);\n   254→\n   255→    // ENG-1 is assigned to Alice Johnson → initials AJ\n   256→    const eng1 = issues.find((i: { identifier: string }) => i.identifier === 'ENG-1');\n   257→    const assignee = page.getByTestId(`issue-assignee-