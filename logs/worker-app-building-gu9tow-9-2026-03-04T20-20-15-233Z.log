ingTodo(null)} />\n      )}\n    </div>\n  )\n}\n","structuredPatch":[{"oldStart":22,"oldLines":8,"newStart":22,"newLines":10,"lines":["       <div className=\"flex flex-col gap-5\">","         <Header />","         <AddTodo />","-        <div className=\"flex items-center justify-between\">","-          <FilterBar />","+        <div className=\"flex items-center gap-3\">","+          <div className=\"flex-1\">","+            <FilterBar />","+          </div>","           <SortDropdown />","         </div>","         <TodoList onEditTodo={setEditingTodo} />"]}],"userModified":false,"replaceAll":false}}
