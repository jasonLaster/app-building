[2026-03-14T21:50:47.530Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Bs7gGx5sSEVBDSY1qxP29L","type":"tool_result","content":"     1→import { useState, useRef, useEffect } from 'react';\n     2→import { useSelector } from 'react-redux';\n     3→import type { RootState } from '../store';\n     4→import { STATUS_ORDER, STATUS_CONFIG, PRIORITY_CONFIG, StatusIcon, PriorityIcon } from './IssueRow';\n     5→import './FiltersToolbar.css';\n     6→\n     7→const PRIORITY_ORDER = ['urgent', 'high', 'medium', 'low', 'none'] as const;\n     8→\n     9→interface FiltersToolbarProps {\n    10→  selectedStatuses: string[];\n    11→  selectedPriorities: string[];\n    12→  selectedLabels: string[];\n    13→  onStatusChange: (statuses: string[]) => void;\n    14→  onPriorityChange: (priorities: string[]) => void;\n    15→  onLabelChange: (labels: string[]) => void;\n    16→}\n    17→\n    18→type DropdownType = 'status' | 'priority' | 'label' | null;\n    19→\n    20→export default function FiltersToolbar({\n    21→  selectedStatuses,\n    22→  selectedPriorities,\n    23→  selectedLabels,\n    24→  onStatusChange,\n    25→  onPriorityChange,\n    26→  onLabelChange,\n    27→}: FiltersToolbarProps) {\n    28→  const { items: labels } = useSelector((state: RootState) => state.labels);\n    29→  const [openDropdown, setOpenDropdown] = useState<DropdownType>(null);\n    30→  const toolbarRef = useRef<HTMLDivElement>(null);\n    31→\n    32→  useEffect(() => {\n    33→    function handleClickOutside(e: MouseEvent) {\n    34→      if (toolbarRef.current && !toolbarRef.current.contains(e.target as Node)) {\n    35→        setOpenDropdown(null);\n    36→      }\n    37→    }\n    38→    if (openDropdown) {\n    39→      document.addEventListener('mousedown', handleClickOutside);\n    40→    }\n    41→    return () => document.removeEventListener('mousedown', handleClickOutside);\n    42→  }, [openDropdown]);\n    43→\n    44→  function toggleDropdown(type: DropdownType) {\n    45→    setOpenDropdown(openDropdown === type ? null : type);\n    46→  }\n    47→\n    48→  function toggleStatus(status: string) {\n    49→    if (selectedStatuses.includes(status)) {\n    50→      onStatusChange(selectedStatuses.filter((s) => s !== status));\n    51→    } else {\n    52→      onStatusChange([...selectedStatuses, status]);\n    53→    }\n    54→  }\n    55→\n    56→  function togglePriority(priority: string) {\n    57→    if (selectedPriorities.includes(priority)) {\n    58→      onPriorityChange(selectedPriorities.filter((p) => p !== priority));\n    59→    } else {\n    60→      onPriorityChange([...selectedPriorities, priority]);\n    61→    }\n    62→  }\n    63→\n    64→  function toggleLabel(labelId: string) {\n    65→    if (selectedLabels.includes(labelId)) {\n    66→      onLabelChange(selectedLabels.filter((l) => l !== labelId));\n    67→    } else {\n    68→      onLabelChange([...selectedLabels, labelId]);\n    69→    }\n    70→  }\n    71→\n    72→  return (\n    73→    <div className=\"filters-toolbar\" ref={toolbarRef} data-testid=\"filters-toolbar\">\n    74→      <div className=\"filters-toolbar-filter\">\n    75→        <button\n    76→          className={`filters-toolbar-btn ${selectedStatuses.length > 0 ? 'filters-toolbar-btn-active' : ''}`}\n    77→          onClick={() => toggleDropdown('status')}\n    78→          data-testid=\"filter-btn-status\"\n    79→        >\n    80→          Status\n    81→          {selectedStatuses.length > 0 && (\n    82→            <span className=\"filters-toolbar-badge\" data-testid=\"filter-badge-status\">\n    83→              {selectedStatuses.length}\n    84→            </span>\n    85→          )}\n    86→        </button>\n    87→        {openDropdown === 'status' && (\n    88→          <div className=\"filters-toolbar-dropdown\" data-testid=\"filter-dropdown-status\">\n    89→            {STATUS_ORDER.map((s) => {\n    90→              const cfg = STATUS_CONFIG[s];\n    91→              const checked = selectedStatuses.includes(s);\n    92→              return (\n    93→                <button\n    94→                  key={s}\n    95→                  className={`filters-toolbar-option ${checked ? 'filters-toolbar-option-checked' : ''}`}\n    96→                  onClick={() => toggleStatus(s)}\n    97→                  data-testid={`filter-option-status-${s}`}\n    98→                >\n    99→                  <span className=\"filters-toolbar-checkbox\">\n   100→                    {checked && (\n   101→                      <svg width=\"10\" height=\"10\" viewBox=\"0 0 10 10\" fill=\"none\">\n   102→                        <path d=\"M2 5l2 2 4-4\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n   103→                      </svg>\n   104→                    )}\n   105→                  </span>\n   106→                  <StatusIcon status={s} color={cfg.color} />\n   107→                  <span>{cfg.label}</span>\n   108→                </button>\n   109→              );\n   110→            })}\n   111→          </div>\n   112→        )}\n   113→      </div>\n   114→\n   115→      <div className=\"filters-toolbar-filter\">\n   116→        <button\n   117→          className={`filters-toolbar-btn ${selectedPriorities.length > 0 ? 'filters-toolbar-btn-active' : ''}`}\n   118→          onClick={() => toggleDropdown('priority')}\n   119→          data-testid=\"filter-btn-priority\"\n   120→        >\n   121→          Priority\n   122→          {selectedPriorities.length > 0 && (\n   123→            <span className=\"filters-toolbar-badge\" data-testid=\"filter-badge-priority\">\n   124→              {selectedPriorities.length}\n   125→            </span>\n   126→          )}\n   127→        </button>\n   128→        {openDropdown === 'priority' && (\n   129→          <div className=\"filters-toolbar-dropdown\" data-testid=\"filter-dropdown-priority\">\n   130→            {PRIORITY_ORDER.map((p) => {\n   131→              const cfg = PRIORITY_CONFIG[p];\n   132→              const checked = selectedPriorities.includes(p);\n   133→              return (\n   134→                <button\n   135→                  key={p}\n   136→                  className={`filters-toolbar-option ${checked ? 'filters-toolbar-option-checked' : ''}`}\n   137→                  onClick={() => togglePriority(p)}\n   138→                  data-testid={`filter-option-priority-${p}`}\n   139→                >\n   140→                  <span className=\"filters-toolbar-checkbox\">\n   141→                    {checked && (\n   142→                      <svg width=\"10\" height=\"10\" viewBox=\"0 0 10 10\" fill=\"none\">\n   143→                        <path d=\"M2 5l2 2 4-4\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n   144→                      </svg>\n   145→                    )}\n   146→                  </span>\n   147→                  <PriorityIcon priority={p} />\n   148→                  <span>{cfg.label}</span>\n   149→                </button>\n   150→              );\n   151→            })}\n   152→          </div>\n   153→        )}\n   154→      </div>\n   155→\n   156→      <div className=\"filters-toolbar-filter\">\n   157→        <button\n   158→          className={`filters-toolbar-btn ${selectedLabels.length > 0 ? 'filters-toolbar-btn-active' : ''}`}\n   159→          onClick={() => toggleDropdown('label')}\n   160→          data-testid=\"filter-btn-label\"\n   161→        >\n   162→          Label\n   163→          {selectedLabels.length > 0 && (\n   164→            <span className=\"filters-toolbar-badge\" data-testid=\"filter-badge-label\">\n   165→              {selectedLabels.length}\n   166→            </span>\n   167→          )}\n   168→        </button>\n   169→        {openDropdown === 'label' && (\n   170→          <div className=\"filters-toolbar-dropdown\" data-testid=\"filter-dropdown-label\">\n   171→            {labels.map((label) => {\n   172→              const checked = selectedLabels.includes(label.id);\n   173→              return (\n   174→                <button\n   175→                  key={label.id}\n   176→                  className={`filters-toolbar-option ${checked ? 'filters-toolbar-option-checked' : ''}`}\n   177→                  onClick={() => toggleLabel(label.id)}\n   178→                  data-testid={`filter-option-label-${label.id}`}\n   179→                >\n   180→                  <span className=\"filters-toolbar-checkbox\">\n   181→                    {checked && (\n   182→                      <svg width=\"10\" height=\"10\" viewBox=\"0 0 10 10\" fill=\"none\">\n   183→                        <path d=\"M2 5l2 2 4-4\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n   184→                      </svg>\n   185→                    )}\n   186→                  </span>\n   187→                  <span className=\"filters-toolbar-label-dot\" style={{ backgroundColor: label.color }} />\n   188→                  <span>{label.name}</span>\n   189→                </button>\n   190→              );\n   191→            })}\n   192→            {labels.length === 0 && (\n   193→              <div className=\"filters-toolbar-empty\">No labels available</div>\n   194→            )}\n   195→          </div>\n   196→        )}\n   197→      </div>\n   198→    </div>\n   199→  );\n   200→}\n   201→"}]},"parent_tool_use_id":"toolu_019eLfDsZkowUxn3mthV1TzQ","session_id":"4a000f0f-5f88-4afd-a2db-f037dfcb70b7","uuid":"5aa13ed3-43c0-4190-a2bd-d2e23a055206"}
