[2026-03-14T21:51:34.799Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01V9U4RhheBazCSfgYhyXcSK","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test';\n     2→\n     3→// Helper to login via API and get token\n     4→async function loginViaApi(baseURL: string, email: string, password: string) {\n     5→  const response = await fetch(`${baseURL}/api/login`, {\n     6→    method: 'POST',\n     7→    headers: { 'Content-Type': 'application/json' },\n     8→    body: JSON.stringify({ email, password }),\n     9→  });\n    10→  return response.json();\n    11→}\n    12→\n    13→// Helper to login and navigate to /my-issues\n    14→async function loginAndNavigate(\n    15→  page: import('@playwright/test').Page,\n    16→  baseURL: string,\n    17→  email = 'alice@acme.com',\n    18→  password = 'password123'\n    19→) {\n    20→  const data = await loginViaApi(baseURL, email, password);\n    21→  await page.goto('/login');\n    22→  await page.evaluate((t) => localStorage.setItem('session_token', t), data.token);\n    23→  await page.goto('/my-issues');\n    24→  await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n    25→  return data;\n    26→}\n    27→\n    28→// Alice's seed issues (assigned to her):\n    29→// ENG-1: status=in_progress, priority=high, label=Bug\n    30→// ENG-6: status=todo, priority=urgent, label=Bug\n    31→// DES-3: status=todo, priority=low, label=Improvement\n    32→// Total: 3 issues\n    33→\n    34→test.describe('MyIssues Filters', () => {\n    35→  test('Filters toolbar renders with Status, Priority, and Label filters', async ({ page, baseURL }) => {\n    36→    await loginAndNavigate(page, baseURL!);\n    37→\n    38→    // Verify filters toolbar is visible\n    39→    await expect(page.getByTestId('filters-toolbar')).toBeVisible({ timeout: 30000 });\n    40→\n    41→    // Verify all three filter buttons are present\n    42→    await expect(page.getByTestId('filter-btn-status')).toBeVisible();\n    43→    await expect(page.getByTestId('filter-btn-status')).toContainText('Status');\n    44→\n    45→    await expect(page.getByTestId('filter-btn-priority')).toBeVisible();\n    46→    await expect(page.getByTestId('filter-btn-priority')).toContainText('Priority');\n    47→\n    48→    await expect(page.getByTestId('filter-btn-label')).toBeVisible();\n    49→    await expect(page.getByTestId('filter-btn-label')).toContainText('Label');\n    50→  });\n    51→\n    52→  test('Status filter dropdown shows all statuses with icons', async ({ page, baseURL }) => {\n    53→    await loginAndNavigate(page, baseURL!);\n    54→\n    55→    // Click the Status filter button\n    56→    await page.getByTestId('filter-btn-status').click();\n    57→\n    58→    // Verify dropdown is visible\n    59→    await expect(page.getByTestId('filter-dropdown-status')).toBeVisible();\n    60→\n    61→    // Verify all 6 statuses are shown\n    62→    await expect(page.getByTestId('filter-option-status-backlog')).toBeVisible();\n    63→    await expect(page.getByTestId('filter-option-status-backlog')).toContainText('Backlog');\n    64→\n    65→    await expect(page.getByTestId('filter-option-status-todo')).toBeVisible();\n    66→    await expect(page.getByTestId('filter-option-status-todo')).toContainText('Todo');\n    67→\n    68→    await expect(page.getByTestId('filter-option-status-in_progress')).toBeVisible();\n    69→    await expect(page.getByTestId('filter-option-status-in_progress')).toContainText('In Progress');\n    70→\n    71→    await expect(page.getByTestId('filter-option-status-in_review')).toBeVisible();\n    72→    await expect(page.getByTestId('filter-option-status-in_review')).toContainText('In Review');\n    73→\n    74→    await expect(page.getByTestId('filter-option-status-done')).toBeVisible();\n    75→    await expect(page.getByTestId('filter-option-status-done')).toContainText('Done');\n    76→\n    77→    await expect(page.getByTestId('filter-option-status-cancelled')).toBeVisible();\n    78→    await expect(page.getByTestId('filter-option-status-cancelled')).toContainText('Cancelled');\n    79→\n    80→    // Each option should have an SVG icon (StatusIcon component)\n    81→    for (const status of ['backlog', 'todo', 'in_progress', 'in_review', 'done', 'cancelled']) {\n    82→      await expect(page.getByTestId(`filter-option-status-${status}`).locator('svg')).toHaveCount(1);\n    83→    }\n    84→  });\n    85→\n    86→  test('Status filter filters issues by selected statuses', async ({ page, baseURL }) => {\n    87→    await loginAndNavigate(page, baseURL!);\n    88→\n    89→    // Alice has: todo (2: ENG-6, DES-3), in_progress (1: ENG-1)\n    90→    // Verify initial state - 3 issues total\n    91→    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(3, { timeout: 30000 });\n    92→\n    93→    // Open Status filter and select \"In Progress\"\n    94→    await page.getByTestId('filter-btn-status').click();\n    95→    await page.getByTestId('filter-option-status-in_progress').click();\n    96→\n    97→    // Only in_progress group should be visible with 1 issue\n    98→    await expect(page.getByTestId('issue-group-in_progress')).toBeVisible({ timeout: 15000 });\n    99→    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(1);\n   100→\n   101→    // Todo group should be hidden\n   102→    await expect(page.getByTestId('issue-group-todo')).toHaveCount(0);\n   103→\n   104→    // Status filter button should show badge \"1\"\n   105→    await expect(page.getByTestId('filter-badge-status')).toBeVisible();\n   106→    await expect(page.getByTestId('filter-badge-status')).toHaveText('1');\n   107→  });\n   108→\n   109→  test('Status filter allows multi-select', async ({ page, baseURL }) => {\n   110→    await loginAndNavigate(page, baseURL!);\n   111→\n   112→    // Wait for issues to load\n   113→    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(3, { timeout: 30000 });\n   114→\n   115→    // Open Status filter and select \"Todo\" and \"In Progress\"\n   116→    await page.getByTestId('filter-btn-status').click();\n   117→    await page.getByTestId('filter-option-status-todo').click();\n   118→    await page.getByTestId('filter-option-status-in_progress').click();\n   119→\n   120→    // Both groups should be visible, showing all 3 issues\n   121→    await expect(page.getByTestId('issue-group-todo')).toBeVisible({ timeout: 15000 });\n   122→    await expect(page.getByTestId('issue-group-in_progress')).toBeVisible();\n   123→    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(3);\n   124→\n   125→    // Filter badge should show \"2\"\n   126→    await expect(page.getByTestId('filter-badge-status')).toBeVisible();\n   127→    await expect(page.getByTestId('filter-badge-status')).toHaveText('2');\n   128→  });\n   129→\n   130→  test('Priority filter dropdown shows all priorities with icons', async ({ page, baseURL }) => {\n   131→    await loginAndNavigate(page, baseURL!);\n   132→\n   133→    // Click the Priority filter button\n   134→    await page.getByTestId('filter-btn-priority').click();\n   135→\n   136→    // Verify dropdown is visible\n   137→    await expect(page.getByTestId('filter-dropdown-priority')).toBeVisible();\n   138→\n   139→    // Verify all 5 priorities are shown\n   140→    await expect(page.getByTestId('filter-option-priority-urgent')).toBeVisible();\n   141→    await expect(page.getByTestId('filter-option-priority-urgent')).toContainText('Urgent');\n   142→\n   143→    await expect(page.getByTestId('filter-option-priority-high')).toBeVisible();\n   144→    await expect(page.getByTestId('filter-option-priority-high')).toContainText('High');\n   145→\n   146→    await expect(page.getByTestId('filter-option-priority-medium')).toBeVisible();\n   147→    await expect(page.getByTestId('filter-option-priority-medium')).toContainText('Medium');\n   148→\n   149→    await expect(page.getByTestId('filter-option-priority-low')).toBeVisible();\n   150→    await expect(page.getByTestId('filter-option-priority-low')).toContainText('Low');\n   151→\n   152→    await expect(page.getByTestId('filter-option-priority-none')).toBeVisible();\n   153→    await expect(page.getByTestId('filter-option-priority-none')).toContainText('No Priority');\n   154→\n   155→    // Each option should have an SVG icon (PriorityIcon component)\n   156→    for (const priority of ['urgent', 'high', 'medium', 'low', 'none']) {\n   157→      await expect(page.getByTestId(`filter-option-priority-${priority}`).locator('svg')).toHaveCount(1);\n   158→    }\n   159→  });\n   160→\n   161→  test('Priority filter filters issues by selected priorities', async ({ page, baseURL }) => {\n   162→    await loginAndNavigate(page, baseURL!);\n   163→\n   164→    // Alice has: high (ENG-1), urgent (ENG-6), low (DES-3)\n   165→    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(3, { timeout: 30000 });\n   166→\n   167→    // Open Priority filter and select \"High\"\n   168→    await page.getByTestId('filter-btn-priority').click();\n   169→    await page.getByTestId('filter-option-priority-high').click();\n   170→\n   171→    // Only ENG-1 should be visible (high priority)\n   172→    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(1, { timeout: 15000 });\n   173→    await expect(page.locator('[data-testid^=\"issue-identifier-\"]').filter({ hasText: /^ENG-1$/ })).toHaveCount(1);\n   174→\n   175→    // Other issues should be hidden\n   176→    await expect(page.locator('[data-testid^=\"issue-identifier-\"]').filter({ hasText: /^ENG-6$/ })).toHaveCount(0);\n   177→    await expect(page.locator('[data-testid^=\"issue-identifier-\"]').filter({ hasText: /^DES-3$/ })).toHaveCount(0);\n   178→  });\n   179→\n   180→  test('Label filter dropdown shows all available labels', async ({ page, baseURL }) => {\n   181→    await loginAndNavigate(page, baseURL!);\n   182→\n   183→    // Click the Label filter button\n   184→    await page.getByTestId('filter-btn-label').click();\n   185→\n   186→    // Verify dropdown is visible\n   187→    await expect(page.getByTestId('filter-dropdown-label')).toBeVisible();\n   188→\n   189→    // Seed labels: Bug (red), Documentation (purple), Feature (green), Improvement (blue)\n   190→    // Labels are ordered by name ASC, so: Bug, Documentation, Feature, Improvement\n   191→    // Each label option has a colored dot and the label name\n   192→    const dropdown = page.getByTestId('filter-dropdown-label');\n   193→    await expect(dropdown.locator('button')).toHaveCount(4);\n   194→\n   195→    await expect(dropdown).toContainText('Bug');\n   196→    await expect(dropdown).toContainText('Feature');\n   197→    await expect(dropdown).toContainText('Improvement');\n   198→    await expect(dropdown).toContainText('Documentation');\n   199→  });\n   200→\n   201→  test('Label filter filters issues by selected labels', async ({ page, baseURL }) => {\n   202→    await loginAndNavigate(page, baseURL!);\n   203→\n   204→    // Alice's issues: ENG-1 (Bug), ENG-6 (Bug), DES-3 (Improvement)\n   205→    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(3, { timeout: 30000 });\n   206→\n   207→    // Open Label filter and select \"Bug\"\n   208→    await page.getByTestId('filter-btn-label').click();\n   209→\n   210→    // Find the Bug option in the dropdown\n   211→    const bugOption = page.getByTestId('filter-dropdown-label').locator('button').filter({ hasText: /^Bug$/ });\n   212→    await bugOption.click();\n   213→\n   214→    // Only Bug-labeled issues should show: ENG-1 and ENG-6\n   215→    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(2, { timeout: 15000 });\n   216→    await expect(page.locator('[data-testid^=\"issue-identifier-\"]').filter({ hasText: /^ENG-1$/ })).toHaveCount(1);\n   217→    await expect(page.locator('[data-testid^=\"issue-identifier-\"]').filter({ hasText: /^ENG-6$/ })).toHaveCount(1);\n   218→\n   219→    // DES-3 (Improvement) should be hidden\n   220→    await expect(page.locator('[data-testid^=\"issue-identifier-\"]').filter({ hasText: /^DES-3$/ })).toHaveCount(0);\n   221→  });\n   222→\n   223→  test('Multiple filters combine with AND logic', async ({ page, baseURL }) => {\n   224→    await loginAndNavigate(page, baseURL!);\n   225→\n   226→    // Alice's issues:\n   227→    // ENG-1: priority=high, label=Bug, status=in_progress\n   228→    // ENG-6: priority=urgent, label=Bug, status=todo\n   229→    // DES-3: priority=low, label=Improvement, status=todo\n   230→    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(3, { timeout: 30000 });\n   231→\n   232→    // Select \"High\" in Priority filter\n   233→    await page.getByTestId('filter-btn-priority').click();\n   234→    await page.getByTestId('filter-option-priority-high').click();\n   235→    // Close priority dropdown by clicking elsewhere\n   236→    await page.getByTestId('my-issues-title').click();\n   237→\n   238→    // Select \"Bug\" in Label filter\n   239→    await page.getByTestId('filter-btn-label').click();\n   240→    const bugOption = page.getByTestId('filter-dropdown-label').locator('button').filter({ hasText: /^Bug$/ });\n   241→    await bugOption.click();\n   242→\n   243→    // Only ENG-1 matches both High priority AND Bug label\n   244→    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(1, { timeout: 15000 });\n   245→    await expect(page.locator('[data-testid^=\"issue-identifier-\"]').filter({ hasText: /^ENG-1$/ })).toHaveCount(1);\n   246→\n   247→    // ENG-6 (urgent, Bug) and DES-3 (low, Improvement) should be hidden\n   248→    await expect(page.locator('[data-testid^=\"issue-identifier-\"]').filter({ hasText: /^ENG-6$/ })).toHaveCount(0);\n   249→    await expect(page.locator('[data-testid^=\"issue-identifier-\"]').filter({ hasText: /^DES-3$/ })).toHaveCount(0);\n   250→  });\n   251→\n   252→  test('Clearing a filter restores all issues', async ({ page, baseURL }) => {\n   253→    await loginAndNavigate(page, baseURL!);\n   254→\n   255→    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(3, { timeout: 30000 });\n   256→\n   257→    // Apply Status filter for \"In Progress\"\n   258→    await page.getByTestId('filter-btn-status').click();\n   259→    await page.getByTestId('filter-option-status-in_progress').click();\n   260→\n   261→    // Only 1 issue visible\n   262→    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(1, { timeout: 15000 });\n   263→\n   264→    // Deselect \"In Progress\" to clear the filter\n   265→    await page.getByTestId('filter-option-status-in_progress').click();\n   266→\n   267→    // All 3 issues should be restored\n   268→    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(3, { timeout: 15000 });\n   269→\n   270→    // Badge should be gone\n   271→    await expect(page.getByTestId('filter-badge-status')).toHaveCount(0);\n   272→  });\n   273→\n   274→  test('Filters can be used repeatedly after clearing', async ({ page, baseURL }) => {\n   275→    await loginAndNavigate(page, baseURL!);\n   276→\n   277→    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(3, { timeout: 30000 });\n   278→\n   279→    // Apply Priority filter for \"High\"\n   280→    await page.getByTestId('filter-btn-priority').click();\n   281→    await page.getByTestId('filter-option-priority-high').click();\n   282→    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(1, { timeout: 15000 });\n   283→\n   284→    // Clear it\n   285→    await page.getByTestId('filter-option-priority-high').click();\n   286→    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(3, { timeout: 15000 });\n   287→\n   288→    // Close priority dropdown\n   289→    await page.getByTestId('my-issues-title').click();\n   290→\n   291→    // Apply Priority filter for \"Low\"\n   292→    await page.getByTestId('filter-btn-priority').click();\n   293→    await page.getByTestId('filter-option-priority-low').click();\n   294→    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(1, { timeout: 15000 });\n   295→    await expect(page.locator('[data-testid^=\"issue-identifier-\"]').filter({ hasText: /^DES-3$/ })).toHaveCount(1);\n   296→\n   297→    // Clear it\n   298→    await page.getByTestId('filter-option-priority-low').click();\n   299→    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(3, { timeout: 15000 });\n   300→\n   301→    // Close priority dropdown\n   302→    await page.getByTestId('my-issues-title').click();\n   303→\n   304→    // Apply Status filter for \"In Progress\" (only ENG-1 is done status... actually ENG-1 is in_progress)\n   305→    await page.getByTestId('filter-btn-status').click();\n   306→    await page.getByTestId('filter-option-status-in_progress').click();\n   307→    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(1, { timeout: 15000 });\n   308→    await expect(page.locator('[data-testid^=\"issue-identifier-\"]').filter({ hasText: /^ENG-1$/ })).toHaveCount(1);\n   309→  });\n   310→\n   311→  test('Filter state shows active filter indicators', async ({ page, baseURL }) => {\n   312→    await loginAndNavigate(page, baseURL!);\n   313→\n   314→    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(3, { timeout: 30000 });\n   315→\n   316→    // Initially, no badges should be visible\n   317→    await expect(page.getByTestId('filter-badge-status')).toHaveCount(0);\n   318→    await expect(page.getByTestId('filter-badge-priority')).toHaveCount(0);\n   319→    await expect(page.getByTestId('filter-badge-label')).toHaveCount(0);\n   320→\n   321→    // Select \"High\" in Priority filter\n   322→    await page.getByTestId('filter-btn-priority').click();\n   323→    await page.getByTestId('filter-option-priority-high').click();\n   324→\n   325→    // Priority filter button should show active indicator (badge with \"1\")\n   326→    await expect(page.getByTestId('filter-badge-priority')).toBeVisible();\n   327→    await expect(page.getByTestId('filter-badge-priority')).toHaveText('1');\n   328→\n   329→    // Priority button should have active class\n   330→    await expect(page.getByTestId('filter-btn-priority')).toHaveClass(/filters-toolbar-btn-active/);\n   331→\n   332→    // Status and Label filter buttons should remain inactive\n   333→    await expect(page.getByTestId('filter-badge-status')).toHaveCount(0);\n   334→    await expect(page.getByTestId('filter-badge-label')).toHaveCount(0);\n   335→    await expect(page.getByTestId('filter-btn-status')).not.toHaveClass(/filters-toolbar-btn-active/);\n   336→    await expect(page.getByTestId('filter-btn-label')).not.toHaveClass(/filters-toolbar-btn-active/);\n   337→  });\n   338→\n   339→  test('Filters persist while navigating within the page', async ({ page, baseURL }) => {\n   340→    await loginAndNavigate(page, baseURL!);\n   341→\n   342→    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(3, { timeout: 30000 });\n   343→\n   344→    // Apply Status filter for \"In Progress\"\n   345→    await page.getByTestId('filter-btn-status').click();\n   346→    await page.getByTestId('filter-option-status-in_progress').click();\n   347→\n   348→    // Close dropdown\n   349→    await page.getByTestId('my-issues-title').click();\n   350→\n   351→    // Verify filter is applied - only 1 issue\n   352→    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(1, { timeout: 15000 });\n   353→\n   354→    // Click on the issue title to navigate to detail page\n   355→    const issueTitle = page.locator('[data-testid^=\"issue-title-\"]').first();\n   356→    await issueTitle.click();\n   357→\n   358→    // Wait for issue detail page to load\n   359→    await expect(page.locator('[data-testid=\"issue-detail-page\"]')).toBeVisible({ timeout: 30000 });\n   360→\n   361→    // Navigate back to /my-issues\n   362→    await page.goBack();\n   363→\n   364→    // Verify we're back on my-issues page\n   365→    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n   366→\n   367→    // Verify filter is still applied - still showing only \"In Progress\" issues\n   368→    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(1, { timeout: 15000 });\n   369→\n   370→    // Verify filter badge is still showing\n   371→    await expect(page.getByTestId('filter-badge-status')).toBeVisible();\n   372→    await expect(page.getByTestId('filter-badge-status')).toHaveText('1');\n   373→  });\n   374→});\n   375→"}]},"parent_tool_use_id":null,"session_id":"4a000f0f-5f88-4afd-a2db-f037dfcb70b7","uuid":"aa6f5dc6-6bdf-477b-96b8-2ed6d258a645","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/tests/my-issues-filters.spec.ts","content":"import { test, expect } from '@playwright/test';\n\n// Helper to login via API and get token\nasync function loginViaApi(baseURL: string, email: string, password: string) {\n  const response = await fetch(`${baseURL}/api/login`, {\n    method: 'POST',\n    headers: { 'Content-Type': 'application/json' },\n    body: JSON.stringify({ email, password }),\n  });\n  return response.json();\n}\n\n// Helper to login and navigate to /my-issues\nasync function loginAndNavigate(\n  page: import('@playwright/test').Page,\n  baseURL: string,\n  email = 'alice@acme.com',\n  password = 'password123'\n) {\n  const data = await loginViaApi(baseURL, email, password);\n  await page.goto('/login');\n  await page.evaluate((t) => localStorage.setItem('session_token', t), data.token);\n  await page.goto('/my-issues');\n  await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n  return data;\n}\n\n// Alice's seed issues (assigned to her):\n// ENG-1: status=in_progress, priority=high, label=Bug\n// ENG-6: status=todo, priority=urgent, label=Bug\n// DES-3: status=todo, priority=low, label=Improvement\n// Total: 3 issues\n\ntest.describe('MyIssues Filters', () => {\n  test('Filters toolbar renders with Status, Priority, and Label filters', async ({ page, baseURL }) => {\n    await loginAndNavigate(page, baseURL!);\n\n    // Verify filters toolbar is visible\n    await expect(page.getByTestId('filters-toolbar')).toBeVisible({ timeout: 30000 });\n\n    // Verify all three filter buttons are present\n    await expect(page.getByTestId('filter-btn-status')).toBeVisible();\n    await expect(page.getByTestId('filter-btn-status')).toContainText('Status');\n\n    await expect(page.getByTestId('filter-btn-priority')).toBeVisible();\n    await expect(page.getByTestId('filter-btn-priority')).toContainText('Priority');\n\n    await expect(page.getByTestId('filter-btn-label')).toBeVisible();\n    await expect(page.getByTestId('filter-btn-label')).toContainText('Label');\n  });\n\n  test('Status filter dropdown shows all statuses with icons', async ({ page, baseURL }) => {\n    await loginAndNavigate(page, baseURL!);\n\n    // Click the Status filter button\n    await page.getByTestId('filter-btn-status').click();\n\n    // Verify dropdown is visible\n    await expect(page.getByTestId('filter-dropdown-status')).toBeVisible();\n\n    // Verify all 6 statuses are shown\n    await expect(page.getByTestId('filter-option-status-backlog')).toBeVisible();\n    await expect(page.getByTestId('filter-option-status-backlog')).toContainText('Backlog');\n\n    await expect(page.getByTestId('filter-option-status-todo')).toBeVisible();\n    await expect(page.getByTestId('filter-option-status-todo')).toContainText('Todo');\n\n    await expect(page.getByTestId('filter-option-status-in_progress')).toBeVisible();\n    await expect(page.getByTestId('filter-option-status-in_progress')).toContainText('In Progress');\n\n    await expect(page.getByTestId('filter-option-status-in_review')).toBeVisible();\n    await expect(page.getByTestId('filter-option-status-in_review')).toContainText('In Review');\n\n    await expect(page.getByTestId('filter-option-status-done')).toBeVisible();\n    await expect(page.getByTestId('filter-option-status-done')).toContainText('Done');\n\n    await expect(page.getByTestId('filter-option-status-cancelled')).toBeVisible();\n    await expect(page.getByTestId('filter-option-status-cancelled')).toContainText('Cancelled');\n\n    // Each option should have an SVG icon (StatusIcon component)\n    for (const status of ['backlog', 'todo', 'in_progress', 'in_review', 'done', 'cancelled']) {\n      await expect(page.getByTestId(`filter-option-status-${status}`).locator('svg')).toHaveCount(1);\n    }\n  });\n\n  test('Status filter filters issues by selected statuses', async ({ page, baseURL }) => {\n    await loginAndNavigate(page, baseURL!);\n\n    // Alice has: todo (2: ENG-6, DES-3), in_progress (1: ENG-1)\n    // Verify initial state - 3 issues total\n    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(3, { timeout: 30000 });\n\n    // Open Status filter and select \"In Progress\"\n    await page.getByTestId('filter-btn-status').click();\n    await page.getByTestId('filter-option-status-in_progress').click();\n\n    // Only in_progress group should be visible with 1 issue\n    await expect(page.getByTestId('issue-group-in_progress')).toBeVisible({ timeout: 15000 });\n    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(1);\n\n    // Todo group should be hidden\n    await expect(page.getByTestId('issue-group-todo')).toHaveCount(0);\n\n    // Status filter button should show badge \"1\"\n    await expect(page.getByTestId('filter-badge-status')).toBeVisible();\n    await expect(page.getByTestId('filter-badge-status')).toHaveText('1');\n  });\n\n  test('Status filter allows multi-select', async ({ page, baseURL }) => {\n    await loginAndNavigate(page, baseURL!);\n\n    // Wait for issues to load\n    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(3, { timeout: 30000 });\n\n    // Open Status filter and select \"Todo\" and \"In Progress\"\n    await page.getByTestId('filter-btn-status').click();\n    await page.getByTestId('filter-option-status-todo').click();\n    await page.getByTestId('filter-option-status-in_progress').click();\n\n    // Both groups should be visible, showing all 3 issues\n    await expect(page.getByTestId('issue-group-todo')).toBeVisible({ timeout: 15000 });\n    await expect(page.getByTestId('issue-group-in_progress')).toBeVisible();\n    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(3);\n\n    // Filter badge should show \"2\"\n    await expect(page.getByTestId('filter-badge-status')).toBeVisible();\n    await expect(page.getByTestId('filter-badge-status')).toHaveText('2');\n  });\n\n  test('Priority filter dropdown shows all priorities with icons', async ({ page, baseURL }) => {\n    await loginAndNavigate(page, baseURL!);\n\n    // Click the Priority filter button\n    await page.getByTestId('filter-btn-priority').click();\n\n    // Verify dropdown is visible\n    await expect(page.getByTestId('filter-dropdown-priority')).toBeVisible();\n\n    // Verify all 5 priorities are shown\n    await expect(page.getByTestId('filter-option-priority-urgent')).toBeVisible();\n    await expect(page.getByTestId('filter-option-priority-urgent')).toContainText('Urgent');\n\n    await expect(page.getByTestId('filter-option-priority-high')).toBeVisible();\n    await expect(page.getByTestId('filter-option-priority-high')).toContainText('High');\n\n    await expect(page.getByTestId('filter-option-priority-medium')).toBeVisible();\n    await expect(page.getByTestId('filter-option-priority-medium')).toContainText('Medium');\n\n    await expect(page.getByTestId('filter-option-priority-low')).toBeVisible();\n    await expect(page.getByTestId('filter-option-priority-low')).toContainText('Low');\n\n    await expect(page.getByTestId('filter-option-priority-none')).toBeVisible();\n    await expect(page.getByTestId('filter-option-priority-none')).toContainText('No Priority');\n\n    // Each option should have an SVG icon (PriorityIcon component)\n    for (const priority of ['urgent', 'high', 'medium', 'low', 'none']) {\n      await expect(page.getByTestId(`filter-option-priority-${priority}`).locator('svg')).toHaveCount(1);\n    }\n  });\n\n  test('Priority filter filters issues by selected priorities', async ({ page, baseURL }) => {\n    await loginAndNavigate(page, baseURL!);\n\n    // Alice has: high (ENG-1), urgent (ENG-6), low (DES-3)\n    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(3, { timeout: 30000 });\n\n    // Open Priority filter and select \"High\"\n    await page.getByTestId('filter-btn-priority').click();\n    await page.getByTestId('filter-option-priority-high').click();\n\n    // Only ENG-1 should be visible (high priority)\n    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(1, { timeout: 15000 });\n    await expect(page.locator('[data-testid^=\"issue-identifier-\"]').filter({ hasText: /^ENG-1$/ })).toHaveCount(1);\n\n    // Other issues should be hidden\n    await expect(page.locator('[data-testid^=\"issue-identifier-\"]').filter({ hasText: /^ENG-6$/ })).toHaveCount(0);\n    await expect(page.locator('[data-testid^=\"issue-identifier-\"]').filter({ hasText: /^DES-3$/ })).toHaveCount(0);\n  });\n\n  test('Label filter dropdown shows all available labels', async ({ page, baseURL }) => {\n    await loginAndNavigate(page, baseURL!);\n\n    // Click the Label filter button\n    await page.getByTestId('filter-btn-label').click();\n\n    // Verify dropdown is visible\n    await expect(page.getByTestId('filter-dropdown-label')).toBeVisible();\n\n    // Seed labels: Bug (red), Documentation (purple), Feature (green), Improvement (blue)\n    // Labels are ordered by name ASC, so: Bug, Documentation, Feature, Improvement\n    // Each label option has a colored dot and the label name\n    const dropdown = page.getByTestId('filter-dropdown-label');\n    await expect(dropdown.locator('button')).toHaveCount(4);\n\n    await expect(dropdown).toContainText('Bug');\n    await expect(dropdown).toContainText('Feature');\n    await expect(dropdown).toContainText('Improvement');\n    await expect(dropdown).toContainText('Documentation');\n  });\n\n  test('Label filter filters issues by selected labels', async ({ page, baseURL }) => {\n    await loginAndNavigate(page, baseURL!);\n\n    // Alice's issues: ENG-1 (Bug), ENG-6 (Bug), DES-3 (Improvement)\n    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(3, { timeout: 30000 });\n\n    // Open Label filter and select \"Bug\"\n    await page.getByTestId('filter-btn-label').click();\n\n    // Find the Bug option in the dropdown\n    const bugOption = page.getByTestId('filter-dropdown-label').locator('button').filter({ hasText: /^Bug$/ });\n    await bugOption.click();\n\n    // Only Bug-labeled issues should show: ENG-1 and ENG-6\n    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(2, { timeout: 15000 });\n    await expect(page.locator('[data-testid^=\"issue-identifier-\"]').filter({ hasText: /^ENG-1$/ })).toHaveCount(1);\n    await expect(page.locator('[data-testid^=\"issue-identifier-\"]').filter({ hasText: /^ENG-6$/ })).toHaveCount(1);\n\n    // DES-3 (Improvement) should be hidden\n    await expect(page.locator('[data-testid^=\"issue-identifier-\"]').filter({ hasText: /^DES-3$/ })).toHaveCount(0);\n  });\n\n  test('Multiple filters combine with AND logic', async ({ page, baseURL }) => {\n    await loginAndNavigate(page, baseURL!);\n\n    // Alice's issues:\n    // ENG-1: priority=high, label=Bug, status=in_progress\n    // ENG-6: priority=urgent, label=Bug, status=todo\n    // DES-3: priority=low, label=Improvement, status=todo\n    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(3, { timeout: 30000 });\n\n    // Select \"High\" in Priority filter\n    await page.getByTestId('filter-btn-priority').click();\n    await page.getByTestId('filter-option-priority-high').click();\n    // Close priority dropdown by clicking elsewhere\n    await page.getByTestId('my-issues-title').click();\n\n    // Select \"Bug\" in Label filter\n    await page.getByTestId('filter-btn-label').click();\n    const bugOption = page.getByTestId('filter-dropdown-label').locator('button').filter({ hasText: /^Bug$/ });\n    await bugOption.click();\n\n    // Only ENG-1 matches both High priority AND Bug label\n    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(1, { timeout: 15000 });\n    await expect(page.locator('[data-testid^=\"issue-identifier-\"]').filter({ hasText: /^ENG-1$/ })).toHaveCount(1);\n\n    // ENG-6 (urgent, Bug) and DES-3 (low, Improvement) should be hidden\n    await expect(page.locator('[data-testid^=\"issue-identifier-\"]').filter({ hasText: /^ENG-6$/ })).toHaveCount(0);\n    await expect(page.locator('[data-testid^=\"issue-identifier-\"]').filter({ hasText: /^DES-3$/ })).toHaveCount(0);\n  });\n\n  test('Clearing a filter restores all issues', async ({ page, baseURL }) => {\n    await loginAndNavigate(page, baseURL!);\n\n    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(3, { timeout: 30000 });\n\n    // Apply Status filter for \"In Progress\"\n    await page.getByTestId('filter-btn-status').click();\n    await page.getByTestId('filter-option-status-in_progress').click();\n\n    // Only 1 issue visible\n    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(1, { timeout: 15000 });\n\n    // Deselect \"In Progress\" to clear the filter\n    await page.getByTestId('filter-option-status-in_progress').click();\n\n    // All 3 issues should be restored\n    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(3, { timeout: 15000 });\n\n    // Badge should be gone\n    await expect(page.getByTestId('filter-badge-status')).toHaveCount(0);\n  });\n\n  test('Filters can be used repeatedly after clearing', async ({ page, baseURL }) => {\n    await loginAndNavigate(page, baseURL!);\n\n    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(3, { timeout: 30000 });\n\n    // Apply Priority filter for \"High\"\n    await page.getByTestId('filter-btn-priority').click();\n    await page.getByTestId('filter-option-priority-high').click();\n    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(1, { timeout: 15000 });\n\n    // Clear it\n    await page.getByTestId('filter-option-priority-high').click();\n    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(3, { timeout: 15000 });\n\n    // Close priority dropdown\n    await page.getByTestId('my-issues-title').click();\n\n    // Apply Priority filter for \"Low\"\n    await page.getByTestId('filter-btn-priority').click();\n    await page.getByTestId('filter-option-priority-low').click();\n    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(1, { timeout: 15000 });\n    await expect(page.locator('[data-testid^=\"issue-identifier-\"]').filter({ hasText: /^DES-3$/ })).toHaveCount(1);\n\n    // Clear it\n    await page.getByTestId('filter-option-priority-low').click();\n    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(3, { timeout: 15000 });\n\n    // Close priority dropdown\n    await page.getByTestId('my-issues-title').click();\n\n    // Apply Status filter for \"In Progress\" (only ENG-1 is done status... actually ENG-1 is in_progress)\n    await page.getByTestId('filter-btn-status').click();\n    await page.getByTestId('filter-option-status-in_progress').click();\n    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(1, { timeout: 15000 });\n    await expect(page.locator('[data-testid^=\"issue-identifier-\"]').filter({ hasText: /^ENG-1$/ })).toHaveCount(1);\n  });\n\n  test('Filter state shows active filter indicators', async ({ page, baseURL }) => {\n    await loginAndNavigate(page, baseURL!);\n\n    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(3, { timeout: 30000 });\n\n    // Initially, no badges should be visible\n    await expect(page.getByTestId('filter-badge-status')).toHaveCount(0);\n    await expect(page.getByTestId('filter-badge-priority')).toHaveCount(0);\n    await expect(page.getByTestId('filter-badge-label')).toHaveCount(0);\n\n    // Select \"High\" in Priority filter\n    await page.getByTestId('filter-btn-priority').click();\n    await page.getByTestId('filter-option-priority-high').click();\n\n    // Priority filter button should show active indicator (badge with \"1\")\n    await expect(page.getByTestId('filter-badge-priority')).toBeVisible();\n    await expect(page.getByTestId('filter-badge-priority')).toHaveText('1');\n\n    // Priority button should have active class\n    await expect(page.getByTestId('filter-btn-priority')).toHaveClass(/filters-toolbar-btn-active/);\n\n    // Status and Label filter buttons should remain inactive\n    await expect(page.getByTestId('filter-badge-status')).toHaveCount(0);\n    await expect(page.getByTestId('filter-badge-label')).toHaveCount(0);\n    await expect(page.getByTestId('filter-btn-status')).not.toHaveClass(/filters-toolbar-btn-active/);\n    await expect(page.getByTestId('filter-btn-label')).not.toHaveClass(/filters-toolbar-btn-active/);\n  });\n\n  test('Filters persist while navigating within the page', async ({ page, baseURL }) => {\n    await loginAndNavigate(page, baseURL!);\n\n    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(3, { timeout: 30000 });\n\n    // Apply Status filter for \"In Progress\"\n    await page.getByTestId('filter-btn-status').click();\n    await page.getByTestId('filter-option-status-in_progress').click();\n\n    // Close dropdown\n    await page.getByTestId('my-issues-title').click();\n\n    // Verify filter is applied - only 1 issue\n    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(1, { timeout: 15000 });\n\n    // Click on the issue title to navigate to detail page\n    const issueTitle = page.locator('[data-testid^=\"issue-title-\"]').first();\n    await issueTitle.click();\n\n    // Wait for issue detail page to load\n    await expect(page.locator('[data-testid=\"issue-detail-page\"]')).toBeVisible({ timeout: 30000 });\n\n    // Navigate back to /my-issues\n    await page.goBack();\n\n    // Verify we're back on my-issues page\n    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n\n    // Verify filter is still applied - still showing only \"In Progress\" issues\n    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(1, { timeout: 15000 });\n\n    // Verify filter badge is still showing\n    await expect(page.getByTestId('filter-badge-status')).toBeVisible();\n    await expect(page.getByTestId('filter-badge-status')).toHaveText('1');\n  });\n});\n","numLines":375,"startLine":1,"totalLines":375}}}
