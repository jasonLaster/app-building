[2026-03-14T21:50:54.673Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01H4sMBhB3TDndHbfP1urxbX","type":"tool_result","content":"     1→import { createSlice, createAsyncThunk } from '@reduxjs/toolkit';\n     2→import type { Issue } from './issuesSlice';\n     3→import { updateIssueStatus } from './issuesSlice';\n     4→\n     5→export interface TeamMember {\n     6→  id: string;\n     7→  name: string;\n     8→  email: string;\n     9→}\n    10→\n    11→export interface TeamProject {\n    12→  id: string;\n    13→  name: string;\n    14→}\n    15→\n    16→export interface TeamCycle {\n    17→  id: string;\n    18→  name: string;\n    19→  start_date: string;\n    20→  end_date: string;\n    21→}\n    22→\n    23→export interface TeamIssue extends Issue {\n    24→  cycleName: string | null;\n    25→}\n    26→\n    27→interface TeamIssuesState {\n    28→  items: TeamIssue[];\n    29→  members: TeamMember[];\n    30→  projects: TeamProject[];\n    31→  cycles: TeamCycle[];\n    32→  loading: boolean;\n    33→  error: string | null;\n    34→  selectedIds: string[];\n    35→  groupBy: 'status' | 'priority' | 'assignee' | 'project' | 'label' | 'none';\n    36→  sortBy: 'priority' | 'created' | 'updated' | 'status';\n    37→}\n    38→\n    39→const initialState: TeamIssuesState = {\n    40→  items: [],\n    41→  members: [],\n    42→  projects: [],\n    43→  cycles: [],\n    44→  loading: false,\n    45→  error: null,\n    46→  selectedIds: [],\n    47→  groupBy: 'status',\n    48→  sortBy: 'priority',\n    49→};\n    50→\n    51→export const fetchTeamIssues = createAsyncThunk(\n    52→  'teamIssues/fetchTeamIssues',\n    53→  async (teamId: string, { getState, rejectWithValue }) => {\n    54→    const state = getState() as { auth: { token: string | null } };\n    55→    const token = state.auth.token;\n    56→    if (!token) return rejectWithValue('No token');\n    57→    const response = await fetch(`/api/team-issues?teamId=${teamId}`, {\n    58→      headers: { Authorization: `Bearer ${token}` },\n    59→    });\n    60→    if (!response.ok) {\n    61→      return rejectWithValue('Failed to fetch team issues');\n    62→    }\n    63→    return await response.json() as {\n    64→      issues: TeamIssue[];\n    65→      members: TeamMember[];\n    66→      projects: TeamProject[];\n    67→      cycles: TeamCycle[];\n    68→    };\n    69→  }\n    70→);\n    71→\n    72→export const bulkUpdateIssues = createAsyncThunk(\n    73→  'teamIssues/bulkUpdateIssues',\n    74→  async (\n    75→    payload: {\n    76→      issueIds: string[];\n    77→      status?: string;\n    78→      priority?: string;\n    79→      assigneeId?: string | null;\n    80→      labelId?: string;\n    81→      teamId: string;\n    82→    },\n    83→    { getState, dispatch, rejectWithValue }\n    84→  ) => {\n    85→    const state = getState() as { auth: { token: string | null } };\n    86→    const token = state.auth.token;\n    87→    if (!token) return rejectWithValue('No token');\n    88→    const { teamId, ...body } = payload;\n    89→    const response = await fetch('/api/bulk-update-issues', {\n    90→      method: 'PUT',\n    91→      headers: {\n    92→        'Content-Type': 'application/json',\n    93→        Authorization: `Bearer ${token}`,\n    94→      },\n    95→      body: JSON.stringify(body),\n    96→    });\n    97→    if (!response.ok) {\n    98→      return rejectWithValue('Failed to bulk update issues');\n    99→    }\n   100→    // Refetch team issues to get updated data\n   101→    dispatch(fetchTeamIssues(teamId));\n   102→    return payload;\n   103→  }\n   104→);\n   105→\n   106→const teamIssuesSlice = createSlice({\n   107→  name: 'teamIssues',\n   108→  initialState,\n   109→  reducers: {\n   110→    toggleIssueSelection(state, action: { payload: string }) {\n   111→      const id = action.payload;\n   112→      const idx = state.selectedIds.indexOf(id);\n   113→      if (idx >= 0) {\n   114→        state.selectedIds.splice(idx, 1);\n   115→      } else {\n   116→        state.selectedIds.push(id);\n   117→      }\n   118→    },\n   119→    selectGroupIssues(state, action: { payload: string[] }) {\n   120→      const ids = action.payload;\n   121→      const allSelected = ids.every((id) => state.selectedIds.includes(id));\n   122→      if (allSelected) {\n   123→        state.selectedIds = state.selectedIds.filter((id) => !ids.includes(id));\n   124→      } else {\n   125→        const newIds = ids.filter((id) => !state.selectedIds.includes(id));\n   126→        state.selectedIds.push(...newIds);\n   127→      }\n   128→    },\n   129→    clearSelection(state) {\n   130→      state.selectedIds = [];\n   131→    },\n   132→    setGroupBy(state, action: { payload: TeamIssuesState['groupBy'] }) {\n   133→      state.groupBy = action.payload;\n   134→    },\n   135→    setSortBy(state, action: { payload: TeamIssuesState['sortBy'] }) {\n   136→      state.sortBy = action.payload;\n   137→    },\n   138→  },\n   139→  extraReducers: (builder) => {\n   140→    builder\n   141→      .addCase(fetchTeamIssues.pending, (state) => {\n   142→        if (state.items.length === 0) {\n   143→          state.loading = true;\n   144→        }\n   145→        state.error = null;\n   146→      })\n   147→      .addCase(fetchTeamIssues.fulfilled, (state, action) => {\n   148→        state.loading = false;\n   149→        state.items = action.payload.issues;\n   150→        state.members = action.payload.members;"}]},"parent_tool_use_id":"toolu_019eLfDsZkowUxn3mthV1TzQ","session_id":"4a000f0f-5f88-4afd-a2db-f037dfcb70b7","uuid":"0a52a23a-04fc-4891-b0b9-a73f4273bdd4"}
