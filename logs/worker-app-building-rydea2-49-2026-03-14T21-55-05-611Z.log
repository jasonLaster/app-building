[2026-03-14T21:50:47.512Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011DwmdnyxjTBDsxmiNavFzb","type":"tool_result","content":"     1→import { useState, useRef, useEffect } from 'react';\n     2→import { useSelector } from 'react-redux';\n     3→import type { RootState } from '../store';\n     4→import { STATUS_ORDER, STATUS_CONFIG, StatusIcon, PriorityIcon } from './IssueRow';\n     5→import './TeamFilters.css';\n     6→\n     7→const PRIORITY_ORDER = ['urgent', 'high', 'medium', 'low', 'none'] as const;\n     8→const PRIORITY_LABELS: Record<string, string> = {\n     9→  urgent: 'Urgent',\n    10→  high: 'High',\n    11→  medium: 'Medium',\n    12→  low: 'Low',\n    13→  none: 'No Priority',\n    14→};\n    15→\n    16→interface TeamFiltersProps {\n    17→  selectedStatuses: string[];\n    18→  selectedPriorities: string[];\n    19→  selectedAssignees: string[];\n    20→  selectedLabels: string[];\n    21→  selectedProjects: string[];\n    22→  selectedCycles: string[];\n    23→  onStatusChange: (v: string[]) => void;\n    24→  onPriorityChange: (v: string[]) => void;\n    25→  onAssigneeChange: (v: string[]) => void;\n    26→  onLabelChange: (v: string[]) => void;\n    27→  onProjectChange: (v: string[]) => void;\n    28→  onCycleChange: (v: string[]) => void;\n    29→}\n    30→\n    31→type DropdownType = 'status' | 'priority' | 'assignee' | 'label' | 'project' | 'cycle' | null;\n    32→\n    33→function CheckIcon() {\n    34→  return (\n    35→    <svg width=\"10\" height=\"10\" viewBox=\"0 0 10 10\" fill=\"none\">\n    36→      <path d=\"M2 5l2 2 4-4\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n    37→    </svg>\n    38→  );\n    39→}\n    40→\n    41→export default function TeamFilters({\n    42→  selectedStatuses,\n    43→  selectedPriorities,\n    44→  selectedAssignees,\n    45→  selectedLabels,\n    46→  selectedProjects,\n    47→  selectedCycles,\n    48→  onStatusChange,\n    49→  onPriorityChange,\n    50→  onAssigneeChange,\n    51→  onLabelChange,\n    52→  onProjectChange,\n    53→  onCycleChange,\n    54→}: TeamFiltersProps) {\n    55→  const { members, projects, cycles } = useSelector((state: RootState) => state.teamIssues);\n    56→  const { items: labels } = useSelector((state: RootState) => state.labels);\n    57→  const [openDropdown, setOpenDropdown] = useState<DropdownType>(null);\n    58→  const toolbarRef = useRef<HTMLDivElement>(null);\n    59→\n    60→  useEffect(() => {\n    61→    function handleClickOutside(e: MouseEvent) {\n    62→      if (toolbarRef.current && !toolbarRef.current.contains(e.target as Node)) {\n    63→        setOpenDropdown(null);\n    64→      }\n    65→    }\n    66→    if (openDropdown) {\n    67→      document.addEventListener('mousedown', handleClickOutside);\n    68→    }\n    69→    return () => document.removeEventListener('mousedown', handleClickOutside);\n    70→  }, [openDropdown]);\n    71→\n    72→  function toggleDropdown(type: DropdownType) {\n    73→    setOpenDropdown(openDropdown === type ? null : type);\n    74→  }\n    75→\n    76→  function toggleItem(list: string[], item: string, setter: (v: string[]) => void) {\n    77→    if (list.includes(item)) {\n    78→      setter(list.filter((i) => i !== item));\n    79→    } else {\n    80→      setter([...list, item]);\n    81→    }\n    82→  }\n    83→\n    84→  return (\n    85→    <div className=\"team-filters\" ref={toolbarRef} data-testid=\"team-filters-toolbar\">\n    86→      {/* Status Filter */}\n    87→      <div className=\"team-filters-filter\">\n    88→        <button\n    89→          className={`team-filters-btn ${selectedStatuses.length > 0 ? 'team-filters-btn-active' : ''}`}\n    90→          onClick={() => toggleDropdown('status')}\n    91→          data-testid=\"team-filter-btn-status\"\n    92→        >\n    93→          Status\n    94→          {selectedStatuses.length > 0 && (\n    95→            <span className=\"team-filters-badge\" data-testid=\"team-filter-badge-status\">{selectedStatuses.length}</span>\n    96→          )}\n    97→        </button>\n    98→        {openDropdown === 'status' && (\n    99→          <div className=\"team-filters-dropdown\" data-testid=\"team-filter-dropdown-status\">\n   100→            {STATUS_ORDER.map((s) => {\n   101→              const cfg = STATUS_CONFIG[s];\n   102→              const checked = selectedStatuses.includes(s);\n   103→              return (\n   104→                <button\n   105→                  key={s}\n   106→                  className={`team-filters-option ${checked ? 'team-filters-option-checked' : ''}`}\n   107→                  onClick={() => toggleItem(selectedStatuses, s, onStatusChange)}\n   108→                  data-testid={`team-filter-option-status-${s}`}\n   109→                >\n   110→                  <span className=\"team-filters-checkbox\">{checked && <CheckIcon />}</span>\n   111→                  <StatusIcon status={s} color={cfg.color} />\n   112→                  <span>{cfg.label}</span>\n   113→                </button>\n   114→              );\n   115→            })}\n   116→          </div>\n   117→        )}\n   118→      </div>\n   119→\n   120→      {/* Priority Filter */}\n   121→      <div className=\"team-filters-filter\">\n   122→        <button\n   123→          className={`team-filters-btn ${selectedPriorities.length > 0 ? 'team-filters-btn-active' : ''}`}\n   124→          onClick={() => toggleDropdown('priority')}\n   125→          data-testid=\"team-filter-btn-priority\"\n   126→        >\n   127→          Priority\n   128→          {selectedPriorities.length > 0 && (\n   129→            <span className=\"team-filters-badge\" data-testid=\"team-filter-badge-priority\">{selectedPriorities.length}</span>\n   130→          )}\n   131→        </button>\n   132→        {openDropdown === 'priority' && (\n   133→          <div className=\"team-filters-dropdown\" data-testid=\"