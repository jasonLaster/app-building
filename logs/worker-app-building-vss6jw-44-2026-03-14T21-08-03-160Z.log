   37→  await page.getByTestId('listing-state-input').fill('CO')\n    38→  await page.getByTestId('listing-country-input').fill('USA')\n    39→  await page.getByTestId('add-listing-next').click()\n    40→  await expect(page.getByTestId('add-listing-step-3')).toBeVisible({ timeout: 15000 })\n    41→}\n    42→\n    43→async function completeStep3(page: import('@playwright/test').Page) {\n    44→  // Default values are already 1, increase maxGuests to 4, bedrooms to 2, beds to 3, bathrooms stays 1\n    45→  await page.getByTestId('maxGuests-increment').click()\n    46→  await page.getByTestId('maxGuests-increment').click()\n    47→  await page.getByTestId('maxGuests-increment').click()\n    48→  await page.getByTestId('bedrooms-increment').click()\n    49→  await page.getByTestId('beds-increment').click()\n    50→  await page.getByTestId('beds-increment').click()\n    51→  await page.getByTestId('add-listing-next').click()\n    52→  await expect(page.getByTestId('add-listing-step-4')).toBeVisible({ timeout: 15000 })\n    53→}\n    54→\n    55→async function completeStep4(page: import('@playwright/test').Page) {\n    56→  await page.getByTestId('add-listing-next').click()\n    57→  await expect(page.getByTestId('add-listing-step-5')).toBeVisible({ timeout: 15000 })\n    58→}\n    59→\n    60→async function completeStep5(page: import('@playwright/test').Page) {\n    61→  await page.getByTestId('photo-url-input').fill('https://example.com/photo1.jpg')\n    62→  await page.getByTestId('add-photo-button').click()\n    63→  await expect(page.getByTestId('photo-item-0')).toBeVisible({ timeout: 15000 })\n    64→  await page.getByTestId('add-listing-next').click()\n    65→  await expect(page.getByTestId('add-listing-step-6')).toBeVisible({ timeout: 15000 })\n    66→}\n    67→\n    68→function mockNominatimApi(page: import('@playwright/test').Page) {\n    69→  return page.route('**/nominatim.openstreetmap.org/search**', async (route) => {\n    70→    const url = new URL(route.request().url())\n    71→    const query = url.searchParams.get('q') || ''\n    72→    if (query.includes('123 Main')) {\n    73→      await route.fulfill({\n    74→        status: 200,\n    75→        contentType: 'application/json',\n    76→        body: JSON.stringify([\n    77→          {\n    78→            display_name: '123 Main St, Denver, CO, USA',\n    79→            address: {\n    80→              house_number: '123',\n    81→              road: 'Main St',\n    82→              city: 'Denver',\n    83→              state: 'CO',\n    84→              country: 'USA',\n    85→            },\n    86→            lat: '39.7392',\n    87→            lon: '-104.9903',\n    88→          },\n    89→        ]),\n    90→      })\n    91→    } else {\n    92→      await route.fulfill({\n    93→        status: 200,\n    94→        contentType: 'application/json',\n    95→        body: JSON.stringify([]),\n    96→      })\n    97→    }\n    98→  })\n    99→}\n   100→\n   101→test.describe('Add Listing Form - Steps 1 to 6', () => {\n   102→  test('Clicking Add Listing button opens the multi-step form', async ({ page }) => {\n   103→    await openAddListingForm(page)\n   104→\n   105→    // Step 1 should be displayed\n   106→    await expect(page.getByTestId('add-listing-step-1')).toBeVisible()\n   107→\n   108→    // Step indicator shows step 1 of 7\n   109→    const stepIndicator = page.getByTestId('step-indicator')\n   110→    await expect(stepIndicator).toBeVisible()\n   111→    await expect(stepIndicator).toContainText('Step 1 of 7')\n   112→\n   113→    // Property type select and title input are visible\n   114→    await expect(page.getByTestId('property-type-select')).toBeVisible()\n   115→    await expect(page.getByTestId('listing-title-input')).toBeVisible()\n   116→\n   117→    // Next and Cancel buttons are visible\n   118→    await expect(page.getByTestId('add-listing-next')).toBeVisible()\n   119→    await expect(page.getByTestId('add-listing-cancel')).toBeVisible()\n   120→  })\n   121→\n   122→  test('Step 1 — Property type selection and title input', async ({ page }) => {\n   123→    await openAddListingForm(page)\n   124→\n   125→    // Property type dropdown should list all types\n   126→    await page.getByTestId('property-type-select').click()\n   127→    const types = ['apartment', 'house', 'cabin', 'villa', 'condo', 'loft', 'cottage', 'townhouse']\n   128→    for (const type of types) {\n   129→      await expect(page.getByTestId(`property-type-option-${type}`)).toBeVisible()\n   130→    }\n   131→    // Close the dropdown by clicking outside\n   132→    await page.getByTestId('listing-title-input').click()\n   133→\n   134→    // Title input is visible\n   135→    const titleInput = page.getByTestId('listing-title-input')\n   136→    await expect(titleInput).toBeVisible()\n   137→  })\n   138→\n   139→  test('Step 1 — Selecting property type and entering title', async ({ page }) => {\n   140→    await openAddListingForm(page)\n   141→\n   142→    // Select Cabin\n   143→    await page.getByTestId('property-type-select').click()\n   144→    await page.getByTestId('property-type-option-cabin').click()\n   145→\n   146→    // Verify Cabin is selected\n   147→    await expect(page.getByTestId('property-type-select')).toContainText('Cabin')\n   148→\n   149→    // Enter title\n   150→    await page.getByTestId('listing-title-input').fill('Cozy Mountain Retreat')\n   151→    await expect(page.getByTestId('listing-title-input')).toHaveValue('Cozy Mountain Retreat')\n   152→\n   153→    // Next button should be enabled\n   154→    await expect(page.getByTestId('add-listing-next')).toBeEnabled()\n   155→  })\n   156→\n   157→  test('Step 1 — Validation prevents proceeding without required fields', async ({ page }) => {\n   158→    await openAddListingForm(page)\n   159→\n   160→    // Click Next without filling anything\n   161→    await page.getByTestId('add-listing-next').click()\n   162→\n   163→    // Should still be on step 1\n   164→    await expect(page.getByTestId('add-listing-step-1')).toBeVisible()\n   165→\n   166→    // Validation errors should appear\n   167→    await expect(page.getByTestId('add-listing-step-1')).toContainText('Property type is required')\n   168→    await expect(page.getByTestId('add-listing-step-1')).toContainText('Title is required')\n   169→\n   170→    // Should not advance to step 2\n   171→    await expect(page.getByTestId('add-listing-step-2')).not.toBeVisible()\n   172→  })\n   173→\n   174→  test('Step 2 — Location fields displayed', async ({ page }) => {\n   175→    await openAddListingForm(page)\n   176→    await completeStep1(page)\n   177→\n   178→    // Step 2 should be visible\n   179→    await expect(page.getByTestId('add-listing-step-2')).toBeVisible()\n   180→\n   181→    // Step indicator shows step 2 of 7\n   182→    await expect(page.getByTestId('step-indicator')).toContainText('Step 2 of 7')\n   183→\n   184→    // All location fields are visible\n   185→    await expect(page.getByTestId('listing-address-input')).toBeVisible()\n   186→    await expect(page.getByTestId('listing-city-input')).toBeVisible()\n   187→    await expect(page.getByTestId('listing-state-input')).toBeVisible()\n   188→    await expect(page.getByTestId('listing-country-input')).toBeVisible()\n   189→\n   190→    // Back and Next buttons are visible\n   191→    await expect(page.getByTestId('add-listing-back')).toBeVisible()\n   192→    await expect(page.getByTestId('add-listing-next')).toBeVisible()\n   193→  })\n   194→\n   195→  test('Step 2 — Address field uses autocomplete', async ({ page }) => {\n   196→    await mockNominatimApi(page)\n   197→    await openAddListingForm(page)\n   198→    await completeStep1(page)\n   199→\n   200→    // Type in address field\n   201→    await page.getByTestId('listing-address-input').fill('123 Main')\n   202→\n   203→    // Wait for autocomplete suggestions to appear\n   204→    await expect(page.getByTestId('address-suggestions')).toBeVisible({ timeout: 15000 })\n   205→\n   206→    // Suggestions should contain our mocked result\n   207→    await expect(page.getByTestId('address-suggestions')).toContainText('123 Main St, Denver, CO, USA')\n   208→\n   209→    // Click the suggestion\n   210→    await page.getByTestId('address-suggestions').locator('button').first().click()\n   211→\n   212→    // Suggestions should close\n   213→    await expect(page.getByTestId('address-suggestions')).not.toBeVisible()\n   214→  })\n   215→\n   216→  test('Step 2 — Address autocomplete populates related fields', async ({ page }) => {\n   217→    await mockNominatimApi(page)\n   218→    await openAddListingForm(page)\n   219→    await completeStep1(page)\n   220→\n   221→    // Type in address field\n   222→    await page.getByTestId('listing-address-input').fill('123 Main')\n   223→\n   224→    // Wait for and click autocomplete suggestion\n   225→    await expect(page.getByTestId('address-suggestions')).toBeVisible({ timeout: 15000 })\n   226→    await page.getByTestId('address-suggestions').locator('button').first().click()\n   227→\n   228→    // Verify all fields are auto-populated\n   229→    await expect(page.getByTestId('listing-address-input')).toHaveValue('123 Main St')\n   230→    await expect(page.getByTestId('listing-city-input')).toHaveValue('Denver')\n   231→    await expect(page.getByTestId('listing-state-input')).toHaveValue('CO')\n   232→    await expect(page.getByTestId('listing-country-input')).toHaveValue('USA')\n   233→  })\n   234→\n   235→  test('Step 2 — Validation requires city and country', async ({ page }) => {\n   236→    await openAddListingForm(page)\n   237→    await completeStep1(page)\n   238→\n   239→    // Fill address but leave city and country empty\n   240→    await page.getByTestId('listing-address-input').fill('123 Some Street')\n   241→\n   242→    // Click Next\n   243→    await page.getByTestId('add-listing-next').click()\n   244→\n   245→    // Should still be on step 2\n   246→    await expect(page.getByTestId('add-listing-step-2')).toBeVisible()\n   247→\n   248→    // Validation errors should appear\n   249→    await expect(page.getByTestId('add-listing-step-2')).toContainText('City is required')\n   250→    await expect(page.getByTestId('add-listing-step-2')).toContainText('Country is required')\n   251→  })\n   252→\n   253→  test('Step 3 — Details fields displayed', async ({ page }) => {\n   254→    await openAddListingForm(page)\n   255→    await completeStep1(page)\n   256→    await completeStep2(page)\n   257→\n   258→    // Step 3 should be visible\n   259→    await expect(page.getByTestId('add-listing-step-3')).toBeVisible()\n   260→\n   261→    // Step indicator shows step 3 of 7\n   262→    await expect(page.getByTestId('step-indicator')).toContainText('Step 3 of 7')\n   263→\n   264→    // All detail fields with increment/decrement are visible\n   265→    await expect(page.getByTestId('maxGuests-value')).toBeVisible()\n   266→    await expect(page.getByTestId('maxGuests-increment')).toBeVisible()\n   267→    await expect(page.getByTestId('maxGuests-decrement')).toBeVisible()\n   268→\n   269→    await expect(page.getByTestId('bedrooms-value')).toBeVisible()\n   270→    await expect(page.getByTestId('bedrooms-increment')).toBeVisible()\n   271→    await expect(page.getByTestId('bedrooms-decrement')).toBeVisible()\n   272→\n   273→    await expect(page.getByTestId('beds-value')).toBeVisible()\n   274→    await expect(page.getByTestId('beds-increment')).toBeVisible()\n   275→    await expect(page.getByTestId('beds-decrement')).toBeVisible()\n   276→\n   277→    await expect(page.getByTestId('bathrooms-value')).toBeVisible()\n   278→    await expect(page.getByTestId('bathrooms-increment')).toBeVisible()\n   279→    await expect(page.getByTestId('bathrooms-decrement')).toBeVisible()\n   280→  })\n   281→\n   282→  test('Step 3 — Setting property details', async ({ page }) => {\n   283→    await openAddListingForm(page)\n   284→    await completeStep1(page)\n   285→    await completeStep2(page)\n   286→\n   287→    // Set max guests to 4 (starts at 1, click increment 3 times)\n   288→    await page.getByTestId('maxGuests-increment').click()\n   289→    await page.getByTestId('maxGuests-increment').click()\n   290→    await page.getByTestId('maxGuests-increment').click()\n   291→    await expect(page.getByTestId('maxGuests-value')).toHaveText('4')\n   292→\n   293→    // Set bedrooms to 2 (starts at 1, click increment 1 time)\n   294→    await page.getByTestId('bedrooms-increment').click()\n   295→    await expect(page.getByTestId('bedrooms-value')).toHaveText('2')\n   296→\n   297→    // Set beds to 3 (starts at 1, click increment 2 times)\n   298→    await page.getByTestId('beds-increment').click()\n   299→    await page.getByTestId('beds-increment').click()\n   300→    await expect(page.getByTestId('beds-value')).toHaveText('3')\n   301→\n   302→    // Bathrooms stays at 1\n   303→    await expect(page.getByTestId('bathrooms-value')).toHaveText('1')\n   304→\n   305→    // Next button should be enabled\n   306→    await expect(page.getByTestId('add-listing-next')).toBeEnabled()\n   307→  })\n   308→\n   309→  test('Step 3 — Validation requires all detail fields', async ({ page }) => {\n   310→    await openAddListingForm(page)\n   311→    await completeStep1(page)\n   312→    await completeStep2(page)\n   313→\n   314→    // Decrement all fields to 0\n   315→    await page.getByTestId('maxGuests-decrement').click()\n   316→    await expect(page.getByTestId('maxGuests-value')).toHaveText('0')\n   317→\n   318→    await page.getByTestId('bedrooms-decrement').click()\n   319→    await expect(page.getByTestId('bedrooms-value')).toHaveText('0')\n   320→\n   321→    await page.getByTestId('beds-decrement').click()\n   322→    await expect(page.getByTestId('beds-value')).toHaveText('0')\n   323→\n   324→    await page.getByTestId('bathrooms-decrement').click()\n   325→    await expect(page.getByTestId('bathrooms-value')).toHaveText('0')\n   326→\n   327→    // Click Next\n   328→    await page.getByTestId('add-listing-next').click()\n   329→\n   330→    // Should still be on step 3\n   331→    await expect(page.getByTestId('add-listing-step-3')).toBeVisible()\n   332→\n   333→    // Validation error should appear\n   334→    await expect(page.getByTestId('add-listing-step-3')).toContainText('Max guests must be at least 1')\n   335→  })\n   336→\n   337→  test('Step 4 — Amenities selection displayed', async ({ page }) => {\n   338→    await openAddListingForm(page)\n   339→    await completeStep1(page)\n   340→    await completeStep2(page)\n   341→    await completeStep3(page)\n   342→\n   343→    // Step 4 should be visible\n   344→    await expect(page.getByTestId('add-listing-step-4')).toBeVisible()\n   345→\n   346→    // Step indicator shows step 4 of 7\n   347→    await expect(page.getByTestId('step-indicator')).toContainText('Step 4 of 7')\n   348→\n   349→    // Category headings should be visible\n   350→    await expect(page.getByTestId('add-listing-step-4')).toContainText('Essentials')\n   351→    await expect(page.getByTestId('add-listing-step-4')).toContainText('Features')\n   352→    await expect(page.getByTestId('add-listing-step-4')).toContainText('Safety')\n   353→    await expect(page.getByTestId('add-listing-step-4')).toContainText('Location')\n   354→\n   355→    // Some amenity checkboxes should be visible\n   356→    await expect(page.getByTestId(`amenity-checkbox-${AMENITY_WIFI}`)).toBeVisible()\n   357→    await expect(page.getByTestId(`amenity-checkbox-${AMENITY_KITCHEN}`)).toBeVisible()\n   358→    await expect(page.getByTestId(`amenity-checkbox-${AMENITY_POOL}`)).toBeVisible()\n   359→  })\n   360→\n   361→  test('Step 4 — Selecting amenities', async ({ page }) => {\n   362→    await openAddListingForm(page)\n   363→    await completeStep1(page)\n   364→    await completeStep2(page)\n   365→    await completeStep3(page)\n   366→\n   367→    // Check WiFi\n   368→    await page.getByTestId(`amenity-checkbox-${AMENITY_WIFI}`).click()\n   369→    // Verify checked state via border class\n   370→    await expect(page.getByTestId(`amenity-checkbox-${AMENITY_WIFI}`)).toHaveClass(/border-primary/)\n   371→\n   372→    // Check Kitchen\n   373→    await page.getByTestId(`amenity-checkbox-${AMENITY_KITCHEN}`).click()\n   374→    await expect(page.getByTestId(`amenity-checkbox-${AMENITY_KITCHEN}`)).toHaveClass(/border-primary/)\n   375→\n   376→    // Check Pool\n   377→    await page.getByTestId(`amenity-checkbox-${AMENITY_POOL}`).click()\n   378→    await expect(page.getByTestId(`amenity-checkbox-${AMENITY_POOL}`)).toHaveClass(/border-primary/)\n   379→\n   380→    // Should be able to proceed (amenities are optional)\n   381→    await page.getByTestId('add-listing-next').click()\n   382→    await expect(page.getByTestId('add-listing-step-5')).toBeVisible({ timeout: 15000 })\n   383→  })\n   384→\n   385→  test('Step 4 — Amenities are toggleable', async ({ page }) => {\n   386→    await openAddListingForm(page)\n   387→    await completeStep1(page)\n   388→    await completeStep2(page)\n   389→    await completeStep3(page)\n   390→\n   391→    // Check WiFi\n   392→    await page.getByTestId(`amenity-checkbox-${AMENITY_WIFI}`).click()\n   393→    await expect(page.getByTestId(`amenity-checkbox-${AMENITY_WIFI}`)).toHaveClass(/border-primary/)\n   394→\n   395→    // Uncheck WiFi\n   396→    await page.getByTestId(`amenity-checkbox-${AMENITY_WIFI}`).click()\n   397→    await expect(page.getByTestId(`amenity-checkbox-${AMENITY_WIFI}`)).not.toHaveClass(/border-primary/)\n   398→\n   399→    // Check WiFi again\n   400→    await page.getByTestId(`amenity-checkbox-${AMENITY_WIFI}`).click()\n   401→    await expect(page.getByTestId(`amenity-checkbox-${AMENITY_WIFI}`)).toHaveClass(/border-primary/)\n   402→  })\n   403→\n   404→  test('Step 5 — Photo URL input displayed', async ({ page }) => {\n   405→    await openAddListingForm(page)\n   406→    await completeStep1(page)\n   407→    await completeStep2(page)\n   408→    await completeStep3(page)\n   409→    await completeStep4(page)\n   410→\n   411→    // Step 5 should be visible\n   412→    await expect(page.getByTestId('add-listing-step-5')).toBeVisible()\n   413→\n   414→    // Step indicator shows step 5 of 7\n   415→    await expect(page.getByTestId('step-indicator')).toContainText('Step 5 of 7')\n   416→\n   417→    // Photo URL input and Add Photo button are visible\n   418→    await expect(page.getByTestId('photo-url-input')).toBeVisible()\n   419→    await expect(page.getByTestId('add-photo-button')).toBeVisible()\n   420→\n   421→    // No photos yet\n   422→    await expect(page.locator('[data-testid^=\"photo-item-\"]')).toHaveCount(0)\n   423→  })\n   424→\n   425→  test('Step 5 — Adding a photo URL', async ({ page }) => {\n   426→    await openAddListingForm(page)\n   427→    await completeStep1(page)\n   428→    await completeStep2(page)\n   429→    await completeStep3(page)\n   430→    await completeStep4(page)\n   431→\n   432→    // Enter photo URL and add it\n   433→    await page.getByTestId('photo-url-input').fill('https://example.com/photo1.jpg')\n   434→    await page.getByTestId('add-photo-button').click()\n   435→\n   436→    // Photo should appear in the list\n   437→    await expect(page.getByTestId('photo-item-0')).toBeVisible({ timeout: 15000 })\n   438→\n   439→    // URL input should be cleared\n   440→    await expect(page.getByTestId('photo-url-input')).toHaveValue('')\n   441→  })\n   442→\n   443→  test('Step 5 — Adding multiple photo URLs', async ({ page }) => {\n   444→    await openAddListingForm(page)\n   445→    await completeStep1(page)\n   446→    await completeStep2(page)\n   447→    await completeStep3(page)\n   448→    await completeStep4(page)\n   449→\n   450→    // Add first photo\n   451→    await page.getByTestId('photo-url-input').fill('https://example.com/photo1.jpg')\n   452→    await page.getByTestId('add-photo-button').click()\n   453→    await expect(page.getByTestId('photo-item-0')).toBeVisible({ timeout: 15000 })\n   454→\n   455→    // Add second photo\n   456→    await page.getByTestId('photo-url-input').fill('https://example.com/photo2.jpg')\n   457→    await page.getByTestId('add-photo-button').click()\n   458→    await expect(page.getByTestId('photo-item-1')).toBeVisible({ timeout: 15000 })\n   459→\n   460→    // Add third photo\n   461→    await page.getByTestId('photo-url-input').fill('https://example.com/photo3.jpg')\n   462→    await page.getByTestId('add-photo-button').click()\n   463→    await expect(page.getByTestId('photo-item-2')).toBeVisible({ timeout: 15000 })\n   464→\n   465→    // All three photos should be displayed\n   466→    await expect(page.locator('[data-testid^=\"photo-item-\"]')).toHaveCount(3)\n   467→\n   468→    // Each photo should have a remove button\n   469→    await expect(page.getByTestId('remove-photo-0')).toBeAttached()\n   470→    await expect(page.getByTestId('remove-photo-1')).toBeAttached()\n   471→    await expect(page.getByTestId('remove-photo-2')).toBeAttached()\n   472→  })\n   473→\n   474→  test('Step 5 — Removing a photo', async ({ page }) => {\n   475→    await openAddListingForm(page)\n   476→    await completeStep1(page)\n   477→    await completeStep2(page)\n   478→    await completeStep3(page)\n   479→    await completeStep4(page)\n   480→\n   481→    // Add 3 photos\n   482→    await page.getByTestId('photo-url-input').fill('https://example.com/photo1.jpg')\n   483→    await page.getByTestId('add-photo-button').click()\n   484→    await expect(page.getByTestId('photo-item-0')).toBeVisible({ timeout: 15000 })\n   485→\n   486→    await page.getByTestId('photo-url-input').fill('https://example.com/photo2.jpg')\n   487→    await page.getByTestId('add-photo-button').click()\n   488→    await expect(page.getByTestId('photo-item-1')).toBeVisible({ timeout: 15000 })\n   489→\n   490→    await page.getByTestId('photo-url-input').fill('https://example.com/photo3.jpg')\n   491→    await page.getByTestId('add-photo-button').click()\n   492→    await expect(page.getByTestId('photo-item-2')).toBeVisible({ timeout: 15000 })\n   493→\n   494→    // Verify 3 photos\n   495→    await expect(page.locator('[data-testid^=\"photo-item-\"]')).toHaveCount(3)\n   496→\n   497→    // Remove the second photo (index 1) - need to hover to make button visible\n   498→    await page.getByTestId('photo-item-1').hover()\n   499→    await page.getByTestId('remove-photo-1').click({ force: true })\n   500→\n   501→    // Should now have 2 photos\n   502→    await expect(page.locator('[data-testid^=\"photo-item-\"]')).toHaveCount(2, { timeout: 15000 })\n   503→  })\n   504→\n   505→  test('Step 5 — Validation requires at least one photo', async ({ page }) => {\n   506→    await openAddListingForm(page)\n   507→    await completeStep1(page)\n   508→    await completeStep2(page)\n   509→    await completeStep3(page)\n   510→    await completeStep4(page)\n   511→\n   512→    // Try to proceed without adding any photos\n   513→    await page.getByTestId('add-listing-next').click()\n   514→\n   515→    // Should still be on step 5\n   516→    await expect(page.getByTestId('add-listing-step-5')).toBeVisible()\n   517→\n   518→    // Validation error should appear\n   519→    await expect(page.getByTestId('add-listing-step-5')).toContainText('At least one photo is required')\n   520→  })\n   521→\n   522→  test('Step 6 — Pricing fields displayed', async ({ page }) => {\n   523→    test.slow()\n   524→    await openAddListingForm(page)\n   525→    await completeStep1(page)\n   526→    await completeStep2(page)\n   527→    await completeStep3(page)\n   528→    await completeStep4(page)\n   529→    await completeStep5(page)\n   530→\n   531→    // Step 6 should be visible\n   532→    await expect(page.getByTestId('add-listing-step-6')).toBeVisible()\n   533→\n   534→    // Step indicator shows step 6 of 7\n   535→    await expect(page.getByTestId('step-indicator')).toContainText('Step 6 of 7')\n   536→\n   537→    // Price per night input is visible and required\n   538→    await expect(page.getByTestId('price-per-night-input')).toBeVisible()\n   539→\n   540→    // Cleaning fee input is visible with default value 0\n   541→    await expect(page.getByTestId('cleaning-fee-input')).toBeVisible()\n   542→    await expect(page.getByTestId('cleaning-fee-input')).toHaveValue('0')\n   543→\n   544→    // Currency prefix $ is shown (visible in the container text)\n   545→    await expect(page.getByTestId('add-listing-step-6')).toContainText('$')\n   546→  })\n   547→})\n   548→"}]},"parent_tool_use_id":null,"session_id":"f65fbc7d-7519-48b6-af78-4161af35e017","uuid":"8c183530-9565-4083-88a3-3ddb09a97cf4","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/tests/add-listing-form.spec.ts","content":"import { test, expect } from '@playwright/test'\n\n// Amenity IDs from seed data\nconst AMENITY_WIFI = 'c1111111-1111-1111-1111-111111111111'\nconst AMENITY_KITCHEN = 'c2222222-2222-2222-2222-222222222222'\nconst AMENITY_POOL = 'c7777777-7777-7777-7777-777777777777'\n\nasync function loginAsHost(page: import('@playwright/test').Page) {\n  await page.goto('/login')\n  await page.getByTestId('login-email-input').fill('sarah@example.com')\n  await page.getByTestId('login-submit-button').click()\n  await expect(page).toHaveURL('/', { timeout: 30000 })\n}\n\nasync function goToHostDashboard(page: import('@playwright/test').Page) {\n  await loginAsHost(page)\n  await page.goto('/hosting')\n  await expect(page.getByTestId('listings-tab')).toBeVisible({ timeout: 30000 })\n}\n\nasync function openAddListingForm(page: import('@playwright/test').Page) {\n  await goToHostDashboard(page)\n  await page.getByTestId('add-listing-button').click()\n  await expect(page.getByTestId('add-listing-form')).toBeVisible({ timeout: 15000 })\n}\n\nasync function completeStep1(page: import('@playwright/test').Page) {\n  await page.getByTestId('property-type-select').click()\n  await page.getByTestId('property-type-option-cabin').click()\n  await page.getByTestId('listing-title-input').fill('Cozy Mountain Retreat')\n  await page.getByTestId('add-listing-next').click()\n  await expect(page.getByTestId('add-listing-step-2')).toBeVisible({ timeout: 15000 })\n}\n\nasync function completeStep2(page: import('@playwright/test').Page) {\n  await page.getByTestId('listing-city-input').fill('Denver')\n  await page.getByTestId('listing-state-input').fill('CO')\n  await page.getByTestId('listing-country-input').fill('USA')\n  await page.getByTestId('add-listing-next').click()\n  await expect(page.getByTestId('add-listing-step-3')).toBeVisible({ timeout: 15000 })\n}\n\nasync function completeStep3(page: import('@playwright/test').Page) {\n  // Default values are already 1, increase maxGuests to 4, bedrooms to 2, beds to 3, bathrooms stays 1\n  await page.getByTestId('maxGuests-increment').click()\n  await page.getByTestId('maxGuests-increment').click()\n  await page.getByTestId('maxGuests-increment').click()\n  await page.getByTestId('bedrooms-increment').click()\n  await page.getByTestId('beds-increment').click()\n  await page.getByTestId('beds-increment').click()\n  await page.getByTestId('add-listing-next').click()\n  await expect(page.getByTestId('add-listing-step-4')).toBeVisible({ timeout: 15000 })\n}\n\nasync function completeStep4(page: import('@playwright/test').Page) {\n  await page.getByTestId('add-listing-next').click()\n  await expect(page.getByTestId('add-listing-step-5')).toBeVisible({ timeout: 15000 })\n}\n\nasync function completeStep5(page: import('@playwright/test').Page) {\n  await page.getByTestId('photo-url-input').fill('https://example.com/photo1.jpg')\n  await page.getByTestId('add-photo-button').click()\n  await expect(page.getByTestId('photo-item-0')).toBeVisible({ timeout: 15000 })\n  await page.getByTestId('add-listing-next').click()\n  await expect(page.getByTestId('add-listing-step-6')).toBeVisible({ timeout: 15000 })\n}\n\nfunction mockNominatimApi(page: import('@playwright/test').Page) {\n  return page.route('**/nominatim.openstreetmap.org/search**', async (route) => {\n    const url = new URL(route.request().url())\n    const query = url.searchParams.get('q') || ''\n    if (query.includes('123 Main')) {\n      await route.fulfill({\n        status: 200,\n        contentType: 'application/json',\n        body: JSON.stringify([\n          {\n            display_name: '123 Main St, Denver, CO, USA',\n            address: {\n              house_number: '123',\n              road: 'Main St',\n              city: 'Denver',\n              state: 'CO',\n              country: 'USA',\n            },\n            lat: '39.7392',\n            lon: '-104.9903',\n          },\n        ]),\n      })\n    } else {\n      await route.fulfill({\n        status: 200,\n        contentType: 'application/json',\n        body: JSON.stringify([]),\n      })\n    }\n  })\n}\n\ntest.describe('Add Listing Form - Steps 1 to 6', () => {\n  test('Clicking Add Listing button opens the multi-step form', async ({ page }) => {\n    await openAddListingForm(page)\n\n    // Step 1 should be displayed\n    await expect(page.getByTestId('add-listing-step-1')).toBeVisible()\n\n    // Step indicator shows step 1 of 7\n    const stepIndicator = page.getByTestId('step-indicator')\n    await expect(stepIndicator).toBeVisible()\n    await expect(stepIndicator).toContainText('Step 1 of 7')\n\n    // Property type select and title input are visible\n    await expect(page.getByTestId('property-type-select')).toBeVisible()\n    await expect(page.getByTestId('listing-title-input')).toBeVisible()\n\n    // Next and Cancel buttons are visible\n    await expect(page.getByTestId('add-listing-next')).toBeVisible()\n    await expect(page.getByTestId('add-listing-cancel')).toBeVisible()\n  })\n\n  test('Step 1 — Property type selection and title input', async ({ page }) => {\n    await openAddListingForm(page)\n\n    // Property type dropdown should list all types\n    await page.getByTestId('property-type-select').click()\n    const types = ['apartment', 'house', 'cabin', 'villa', 'condo', 'loft', 'cottage', 'townhouse']\n    for (const type of types) {\n      await expect(page.getByTestId(`property-type-option-${type}`)).toBeVisible()\n    }\n    // Close the dropdown by clicking outside\n    await page.getByTestId('listing-title-input').click()\n\n    // Title input is visible\n    const titleInput = page.getByTestId('listing-title-input')\n    await expect(titleInput).toBeVisible()\n  })\n\n  test('Step 1 — Selecting property type and entering title', async ({ page }) => {\n    await openAddListingForm(page)\n\n    // Select Cabin\n    await page.getByTestId('property-type-select').click()\n    await page.getByTestId('property-type-option-cabin').click()\n\n    // Verify Cabin is selected\n    await expect(page.getByTestId('property-type-select')).toContainText('Cabin')\n\n    // Enter title\n    await page.getByTestId('listing-title-input').fill('Cozy Mountain Retreat')\n    await expect(page.getByTestId('listing-title-input')).toHaveValue('Cozy Mountain Retreat')\n\n    // Next button should be enabled\n    await expect(page.getByTestId('add-listing-next')).toBeEnabled()\n  })\n\n  test('Step 1 — Validation prevents proceeding without required fields', async ({ page }) => {\n    await openAddListingForm(page)\n\n    // Click Next without filling anything\n    await page.getByTestId('add-listing-next').click()\n\n    // Should still be on step 1\n    await expect(page.getByTestId('add-listing-step-1')).toBeVisible()\n\n    // Validation errors should appear\n    await expect(page.getByTestId('add-listing-step-1')).toContainText('Property type is required')\n    await expect(page.getByTestId('add-listing-step-1')).toContainText('Title is required')\n\n    // Should not advance to step 2\n    await expect(page.getByTestId('add-listing-step-2')).not.toBeVisible()\n  })\n\n  test('Step 2 — Location fields displayed', async ({ page }) => {\n    await openAddListingForm(page)\n    await completeStep1(page)\n\n    // Step 2 should be visible\n    await expect(page.getByTestId('add-listing-step-2')).toBeVisible()\n\n    // Step indicator shows step 2 of 7\n    await expect(page.getByTestId('step-indicator')).toContainText('Step 2 of 7')\n\n    // All location fields are visible\n    await expect(page.getByTestId('listing-address-input')).toBeVisible()\n    await expect(page.getByTestId('listing-city-input')).toBeVisible()\n    await expect(page.getByTestId('listing-state-input')).toBeVisible()\n    await expect(page.getByTestId('listing-country-input')).toBeVisible()\n\n    // Back and Next buttons are visible\n    await expect(page.getByTestId('add-listing-back')).toBeVisible()\n    await expect(page.getByTestId('add-listing-next')).toBeVisible()\n  })\n\n  test('Step 2 — Address field uses autocomplete', async ({ page }) => {\n    await mockNominatimApi(page)\n    await openAddListingForm(page)\n    await completeStep1(page)\n\n    // Type in address field\n    await page.getByTestId('listing-address-input').fill('123 Main')\n\n    // Wait for autocomplete suggestions to appear\n    await expect(page.getByTestId('address-suggestions')).toBeVisible({ timeout: 15000 })\n\n    // Suggestions should contain our mocked result\n    await expect(page.getByTestId('address-suggestions')).toContainText('123 Main St, Denver, CO, USA')\n\n    // Click the suggestion\n    await page.getByTestId('address-suggestions').locator('button').first().click()\n\n    // Suggestions should close\n    await expect(page.getByTestId('address-suggestions')).not.toBeVisible()\n  })\n\n  test('Step 2 — Address autocomplete populates related fields', async ({ page }) => {\n    await mockNominatimApi(page)\n    await openAddListingForm(page)\n    await completeStep1(page)\n\n    // Type in address field\n    await page.getByTestId('listing-address-input').fill('123 Main')\n\n    // Wait for and click autocomplete suggestion\n    await expect(page.getByTestId('address-suggestions')).toBeVisible({ timeout: 15000 })\n    await page.getByTestId('address-suggestions').locator('button').first().click()\n\n    // Verify all fields are auto-populated\n    await expect(page.getByTestId('listing-address-input')).toHaveValue('123 Main St')\n    await expect(page.getByTestId('listing-city-input')).toHaveValue('Denver')\n    await expect(page.getByTestId('listing-state-input')).toHaveValue('CO')\n    await expect(page.getByTestId('listing-country-input')).toHaveValue('USA')\n  })\n\n  test('Step 2 — Validation requires city and country', async ({ page }) => {\n    await openAddListingForm(page)\n    await completeStep1(page)\n\n    // Fill address but leave city and country empty\n    await page.getByTestId('listing-address-input').fill('123 Some Street')\n\n    // Click Next\n    await page.getByTestId('add-listing-next').click()\n\n    // Should still be on step 2\n    await expect(page.getByTestId('add-listing-step-2')).toBeVisible()\n\n    // Validation errors should appear\n    await expect(page.getByTestId('add-listing-step-2')).toContainText('City is required')\n    await expect(page.getByTestId('add-listing-step-2')).toContainText('Country is required')\n  })\n\n  test('Step 3 — Details fields displayed', async ({ page }) => {\n    await openAddListingForm(page)\n    await completeStep1(page)\n    await completeStep2(page)\n\n    // Step 3 should be visible\n    await expect(page.getByTestId('add-listing-step-3')).toBeVisible()\n\n    // Step indicator shows step 3 of 7\n    await expect(page.getByTestId('step-indicator')).toContainText('Step 3 of 7')\n\n    // All detail fields with increment/decrement are visible\n    await expect(page.getByTestId('maxGuests-value')).toBeVisible()\n    await expect(page.getByTestId('maxGuests-increment')).toBeVisible()\n    await expect(page.getByTestId('maxGuests-decrement')).toBeVisible()\n\n    await expect(page.getByTestId('bedrooms-value')).toBeVisible()\n    await expect(page.getByTestId('bedrooms-increment')).toBeVisible()\n    await expect(page.getByTestId('bedrooms-decrement')).toBeVisible()\n\n    await expect(page.getByTestId('beds-value')).toBeVisible()\n    await expect(page.getByTestId('beds-increment')).toBeVisible()\n    await expect(page.getByTestId('beds-decrement')).toBeVisible()\n\n    await expect(page.getByTestId('bathrooms-value')).toBeVisible()\n    await expect(page.getByTestId('bathrooms-increment')).toBeVisible()\n    await expect(page.getByTestId('bathrooms-decrement')).toBeVisible()\n  })\n\n  test('Step 3 — Setting property details', async ({ page }) => {\n    await openAddListingForm(page)\n    await completeStep1(page)\n    await completeStep2(page)\n\n    // Set max guests to 4 (starts at 1, click increment 3 times)\n    await page.getByTestId('maxGuests-increment').click()\n    await page.getByTestId('maxGuests-increment').click()\n    await page.getByTestId('maxGuests-increment').click()\n    await expect(page.getByTestId('maxGuests-value')).toHaveText('4')\n\n    // Set bedrooms to 2 (starts at 1, click increment 1 time)\n    await page.getByTestId('bedrooms-increment').click()\n    await expect(page.getByTestId('bedrooms-value')).toHaveText('2')\n\n    // Set beds to 3 (starts at 1, click increment 2 times)\n    await page.getByTestId('beds-increment').click()\n    await page.getByTestId('beds-increment').click()\n    await expect(page.getByTestId('beds-value')).toHaveText('3')\n\n    // Bathrooms stays at 1\n    await expect(page.getByTestId('bathrooms-value')).toHaveText('1')\n\n    // Next button should be enabled\n    await expect(page.getByTestId('add-listing-next')).toBeEnabled()\n  })\n\n  test('Step 3 — Validation requires all detail fields', async ({ page }) => {\n    await openAddListingForm(page)\n    await completeStep1(page)\n    await completeStep2(page)\n\n    // Decrement all fields to 0\n    await page.getByTestId('maxGuests-decrement').click()\n    await expect(page.getByTestId('maxGuests-value')).toHaveText('0')\n\n    await page.getByTestId('bedrooms-decrement').click()\n    await expect(page.getByTestId('bedrooms-value')).toHaveText('0')\n\n    await page.getByTestId('beds-decrement').click()\n    await expect(page.getByTestId('beds-value')).toHaveText('0')\n\n    await page.getByTestId('bathrooms-decrement').click()\n    await expect(page.getByTestId('bathrooms-value')).toHaveText('0')\n\n    // Click Next\n    await page.getByTestId('add-listing-next').click()\n\n    // Should still be on step 3\n    await expect(page.getByTestId('add-listing-step-3')).toBeVisible()\n\n    // Validation error should appear\n    await expect(page.getByTestId('add-listing-step-3')).toContainText('Max guests must be at least 1')\n  })\n\n  test('Step 4 — Amenities selection displayed', async ({ page }) => {\n    await openAddListingForm(page)\n    await completeStep1(page)\n    await completeStep2(page)\n    await completeStep3(page)\n\n    // Step 4 should be visible\n    await expect(page.getByTestId('add-listing-step-4')).toBeVisible()\n\n    // Step indicator shows step 4 of 7\n    await expect(page.getByTestId('step-indicator')).toContainText('Step 4 of 7')\n\n    // Category headings should be visible\n    await expect(page.getByTestId('add-listing-step-4')).toContainText('Essentials')\n    await expect(page.getByTestId('add-listing-step-4')).toContainText('Features')\n    await expect(page.getByTestId('add-listing-step-4')).toContainText('Safety')\n    await expect(page.getByTestId('add-listing-step-4')).toContainText('Location')\n\n    // Some amenity checkboxes should be visible\n    await expect(page.getByTestId(`amenity-checkbox-${AMENITY_WIFI}`)).toBeVisible()\n    await expect(page.getByTestId(`amenity-checkbox-${AMENITY_KITCHEN}`)).toBeVisible()\n    await expect(page.getByTestId(`amenity-checkbox-${AMENITY_POOL}`)).toBeVisible()\n  })\n\n  test('Step 4 — Selecting amenities', async ({ page }) => {\n    await openAddListingForm(page)\n    await completeStep1(page)\n    await completeStep2(page)\n    await completeStep3(page)\n\n    // Check WiFi\n    await page.getByTestId(`amenity-checkbox-${AMENITY_WIFI}`).click()\n    // Verify checked state via border class\n    await expect(page.getByTestId(`amenity-checkbox-${AMENITY_WIFI}`)).toHaveClass(/border-primary/)\n\n    // Check Kitchen\n    await page.getByTestId(`amenity-checkbox-${AMENITY_KITCHEN}`).click()\n    await expect(page.getByTestId(`amenity-checkbox-${AMENITY_KITCHEN}`)).toHaveClass(/border-primary/)\n\n    // Check Pool\n    await page.getByTestId(`amenity-checkbox-${AMENITY_POOL}`).click()\n    await expect(page.getByTestId(`amenity-checkbox-${AMENITY_POOL}`)).toHaveClass(/border-primary/)\n\n    // Should be able to proceed (amenities are optional)\n    await page.getByTestId('add-listing-next').click()\n    await expect(page.getByTestId('add-listing-step-5')).toBeVisible({ timeout: 15000 })\n  })\n\n  test('Step 4 — Amenities are toggleable', async ({ page }) => {\n    await openAddListingForm(page)\n    await completeStep1(page)\n    await completeStep2(page)\n    await completeStep3(page)\n\n    // Check WiFi\n    await page.getByTestId(`amenity-checkbox-${AMENITY_WIFI}`).click()\n    await expect(page.getByTestId(`amenity-checkbox-${AMENITY_WIFI}`)).toHaveClass(/border-primary/)\n\n    // Uncheck WiFi\n    await page.getByTestId(`amenity-checkbox-${AMENITY_WIFI}`).click()\n    await expect(page.getByTestId(`amenity-checkbox-${AMENITY_WIFI}`)).not.toHaveClass(/border-primary/)\n\n    // Check WiFi again\n    await page.getByTestId(`amenity-checkbox-${AMENITY_WIFI}`).click()\n    await expect(page.getByTestId(`amenity-checkbox-${AMENITY_WIFI}`)).toHaveClass(/border-primary/)\n  })\n\n  test('Step 5 — Photo URL input displayed', async ({ page }) => {\n    await openAddListingForm(page)\n    await completeStep1(page)\n    await completeStep2(page)\n    await completeStep3(page)\n    await completeStep4(page)\n\n    // Step 5 should be visible\n    await expect(page.getByTestId('add-listing-step-5')).toBeVisible()\n\n    // Step indicator shows step 5 of 7\n    await expect(page.getByTestId('step-indicator')).toContainText('Step 5 of 7')\n\n    // Photo URL input and Add Photo button are visible\n    await expect(page.getByTestId('photo-url-input')).toBeVisible()\n    await expect(page.getByTestId('add-photo-button')).toBeVisible()\n\n    // No photos yet\n    await expect(page.locator('[data-testid^=\"photo-item-\"]')).toHaveCount(0)\n  })\n\n  test('Step 5 — Adding a photo URL', async ({ page }) => {\n    await openAddListingForm(page)\n    await completeStep1(page)\n    await completeStep2(page)\n    await completeStep3(page)\n    await completeStep4(page)\n\n    // Enter photo URL and add it\n    await page.getByTestId('photo-url-input').fill('https://example.com/photo1.jpg')\n    await page.getByTestId('add-photo-button').click()\n\n    // Photo should appear in the list\n    await expect(page.getByTestId('photo-item-0')).toBeVisible({ timeout: 15000 })\n\n    // URL input should be cleared\n    await expect(page.getByTestId('photo-url-input')).toHaveValue('')\n  })\n\n  test('Step 5 — Adding multiple photo URLs', async ({ page }) => {\n    await openAddListingForm(page)\n    await completeStep1(page)\n    await completeStep2(page)\n    await completeStep3(page)\n    await completeStep4(page)\n\n    // Add first photo\n    await page.getByTestId('photo-url-input').fill('https://example.com/photo1.jpg')\n    await page.getByTestId('add-photo-button').click()\n    await expect(page.getByTestId('photo-item-0')).toBeVisible({ timeout: 15000 })\n\n    // Add second photo\n    await page.getByTestId('photo-url-input').fill('https://example.com/photo2.jpg')\n    await page.getByTestId('add-photo-button').click()\n    await expect(page.getByTestId('photo-item-1')).toBeVisible({ timeout: 15000 })\n\n    // Add third photo\n    await page.getByTestId('photo-url-input').fill('https://example.com/photo3.jpg')\n    await page.getByTestId('add-photo-button').click()\n    await expect(page.getByTestId('photo-item-2')).toBeVisible({ timeout: 15000 })\n\n    // All three photos should be displayed\n    await expect(page.locator('[data-testid^=\"photo-item-\"]')).toHaveCount(3)\n\n    // Each photo should have a remove button\n    await expect(page.getByTestId('remove-photo-0')).toBeAttached()\n    await expect(page.getByTestId('remove-photo-1')).toBeAttached()\n    await expect(page.getByTestId('remove-photo-2')).toBeAttached()\n  })\n\n  test('Step 5 — Removing a photo', async ({ page }) => {\n    await openAddListingForm(page)\n    await completeStep1(page)\n    await completeStep2(page)\n    await completeStep3(page)\n    await completeStep4(page)\n\n    // Add 3 photos\n    await page.getByTestId('photo-url-input').fill('https://example.com/photo1.jpg')\n    await page.getByTestId('add-photo-button').click()\n    await expect(page.getByTestId('photo-item-0')).toBeVisible({ timeout: 15000 })\n\n    await page.getByTestId('photo-url-input').fill('https://example.com/photo2.jpg')\n    await page.getByTestId('add-photo-button').click()\n    await expect(page.getByTestId('photo-item-1')).toBeVisible({ timeout: 15000 })\n\n    await page.getByTestId('photo-url-input').fill('https://example.com/photo3.jpg')\n    await page.getByTestId('add-photo-button').click()\n    await expect(page.getByTestId('photo-item-2')).toBeVisible({ timeout: 15000 })\n\n    // Verify 3 photos\n    await expect(page.locator('[data-testid^=\"photo-item-\"]')).toHaveCount(3)\n\n    // Remove the second photo (index 1) - need to hover to make button visible\n    await page.getByTestId('photo-item-1').hover()\n    await page.getByTestId('remove-photo-1').click({ force: true })\n\n    // Should now have 2 photos\n    await expect(page.locator('[data-testid^=\"photo-item-\"]')).toHaveCount(2, { timeout: 15000 })\n  })\n\n  test('Step 5 — Validation requires at least one photo', async ({ page }) => {\n    await openAddListingForm(page)\n    await completeStep1(page)\n    await completeStep2(page)\n    await completeStep3(page)\n    await completeStep4(page)\n\n    // Try to proceed without adding any photos\n    await page.getByTestId('add-listing-next').click()\n\n    // Should still be on step 5\n    await expect(page.getByTestId('add-listing-step-5')).toBeVisible()\n\n    // Validation error should appear\n    await expect(page.getByTestId('add-listing-step-5')).toContainText('At least one photo is required')\n  })\n\n  test('Step 6 — Pricing fields displayed', async ({ page }) => {\n    test.slow()\n    await openAddListingForm(page)\n    await completeStep1(page)\n    await completeStep2(page)\n    await completeStep3(page)\n    await completeStep4(page)\n    await completeStep5(page)\n\n    // Step 6 should be visible\n    await expect(page.getByTestId('add-listing-step-6')).toBeVisible()\n\n    // Step indicator shows step 6 of 7\n    await expect(page.getByTestId('step-indicator')).toContainText('Step 6 of 7')\n\n    // Price per night input is visible and required\n    await expect(page.getByTestId('price-per-night-input')).toBeVisible()\n\n    // Cleaning fee input is visible with default value 0\n    await expect(page.getByTestId('cleaning-fee-input')).toBeVisible()\n    await expect(page.getByTestId('cleaning-fee-input')).toHaveValue('0')\n\n    // Currency prefix $ is shown (visible in the container text)\n    await expect(page.getByTestId('add-listing-step-6')).toContainText('$')\n  })\n})\n","numLines":548,"startLine":1,"totalLines":548}}}
