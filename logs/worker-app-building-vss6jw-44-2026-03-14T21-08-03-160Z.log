[2026-03-14T21:06:04.034Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RSD1tnZ8N4exXnWPSttAN2","type":"tool_result","content":"     1→import { useState, useEffect, useCallback } from 'react'\n     2→import { useSelector, useDispatch } from 'react-redux'\n     3→import { useNavigate } from 'react-router-dom'\n     4→import type { RootState, AppDispatch } from '../store'\n     5→import {\n     6→  fetchHostStats,\n     7→  fetchHostListings,\n     8→  fetchHostBookings,\n     9→  deactivateProperty,\n    10→  activateProperty,\n    11→  updateHostBookingStatus,\n    12→} from '../slices/hostSlice'\n    13→import type { Property } from '../slices/propertiesSlice'\n    14→import StatsOverview from '../components/StatsOverview'\n    15→import ListingsTab from '../components/ListingsTab'\n    16→import BookingsTab from '../components/BookingsTab'\n    17→import AddListingForm from '../components/AddListingForm'\n    18→\n    19→type Tab = 'listings' | 'bookings'\n    20→\n    21→export default function HostDashboard() {\n    22→  const dispatch = useDispatch<AppDispatch>()\n    23→  const navigate = useNavigate()\n    24→  const currentUser = useSelector((state: RootState) => state.auth.currentUser)\n    25→  const { stats, listings, bookings, statsLoading, listingsLoading, bookingsLoading } = useSelector(\n    26→    (state: RootState) => state.host\n    27→  )\n    28→  const [activeTab, setActiveTab] = useState<Tab>('listings')\n    29→  const [showAddForm, setShowAddForm] = useState(false)\n    30→\n    31→  useEffect(() => {\n    32→    if (!currentUser) {\n    33→      navigate('/login')\n    34→    }\n    35→  }, [currentUser, navigate])\n    36→\n    37→  useEffect(() => {\n    38→    if (currentUser?.is_host) {\n    39→      dispatch(fetchHostStats(currentUser.id))\n    40→      dispatch(fetchHostListings(currentUser.id))\n    41→      dispatch(fetchHostBookings(currentUser.id))\n    42→    }\n    43→  }, [dispatch, currentUser])\n    44→\n    45→  const handleDeactivate = useCallback(async (property: Property) => {\n    46→    await dispatch(deactivateProperty(property.id))\n    47→  }, [dispatch])\n    48→\n    49→  const handleActivate = useCallback(async (property: Property) => {\n    50→    await dispatch(activateProperty(property.id))\n    51→  }, [dispatch])\n    52→\n    53→  const handleConfirmBooking = useCallback(async (bookingId: string) => {\n    54→    await dispatch(updateHostBookingStatus({ bookingId, status: 'confirmed' }))\n    55→  }, [dispatch])\n    56→\n    57→  const handleCancelBooking = useCallback(async (bookingId: string) => {\n    58→    await dispatch(updateHostBookingStatus({ bookingId, status: 'cancelled' }))\n    59→  }, [dispatch])\n    60→\n    61→  const handleAddListingSuccess = useCallback(() => {\n    62→    setShowAddForm(false)\n    63→    if (currentUser) {\n    64→      dispatch(fetchHostStats(currentUser.id))\n    65→      dispatch(fetchHostListings(currentUser.id))\n    66→    }\n    67→  }, [dispatch, currentUser])\n    68→\n    69→  if (!currentUser) {\n    70→    return null\n    71→  }\n    72→\n    73→  if (!currentUser.is_host) {\n    74→    return (\n    75→      <div data-testid=\"host-dashboard\" className=\"p-6 max-sm:p-3\">\n    76→        <div className=\"max-w-lg mx-auto text-center py-16\">\n    77→          <h1 className=\"text-2xl font-bold text-text mb-4\">Become a Host</h1>\n    78→          <p className=\"text-text-secondary mb-6\">\n    79→            You need to become a host to access this page. Visit your profile to get started.\n    80→          </p>\n    81→          <button\n    82→            data-testid=\"become-host-link\"\n    83→            onClick={() => navigate('/profile')}\n    84→            className=\"bg-primary text-white px-6 py-3 rounded-lg font-medium hover:bg-primary-dark transition-colors\"\n    85→          >\n    86→            Go to Profile\n    87→          </button>\n    88→        </div>\n    89→     