[2026-03-14T19:10:19.156Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017Px54FCZKcBykEaRX7whtX","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions';\n     2→import { getSql } from './db';\n     3→import crypto from 'crypto';\n     4→\n     5→function hashPassword(password: string, salt: string): string {\n     6→  return crypto.pbkdf2Sync(password, salt, 10000, 64, 'sha512').toString('hex');\n     7→}\n     8→\n     9→function generateToken(): string {\n    10→  return crypto.randomBytes(48).toString('hex');\n    11→}\n    12→\n    13→export default async function handler(req: Request, _context: Context) {\n    14→  if (req.method !== 'POST') {\n    15→    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n    16→      status: 405,\n    17→      headers: { 'Content-Type': 'application/json' },\n    18→    });\n    19→  }\n    20→\n    21→  try {\n    22→    const { email, password } = await req.json();\n    23→\n    24→    if (!email || !password) {\n    25→      return new Response(JSON.stringify({ error: 'Email and password are required' }), {\n    26→        status: 400,\n    27→        headers: { 'Content-Type': 'application/json' },\n    28→      });\n    29→    }\n    30→\n    31→    const sql = getSql();\n    32→    const users = await sql`SELECT id, name, email, password_hash, password_salt FROM members WHERE email = ${email}`;\n    33→    const user = users[0];\n    34→\n    35→    if (!user) {\n    36→      return new Response(JSON.stringify({ error: 'Invalid email or password' }), {\n    37→        status: 401,\n    38→        headers: { 'Content-Type': 'application/json' },\n    39→      });\n    40→    }\n    41→\n    42→    const hashedAttempt = hashPassword(password, user.password_salt);\n    43→    if (hashedAttempt !== user.password_hash) {\n    44→      return new Response(JSON.stringify({ error: 'Invalid email or password' }), {\n    45→        status: 401,\n    46→        headers: { 'Content-Type': 'application/json' },\n    47→      });\n    48→    }\n    49→\n    50→    const token = generateToken();\n    51→    const expiresAt = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString();\n    52→\n    53→    await sql`INSERT INTO sessions (token, member_id, expires_at) VALUES (${token}, ${user.id}, ${expiresAt})`;\n    54→\n    55→    return new Response(JSON.stringify({\n    56→      user: { id: user.id, name: user.name, email: user.email },\n    57→      token,\n    58→    }), {\n    59→      status: 200,\n    60→      headers: { 'Content-Type': 'application/json' },\n    61→    });\n    62→  } catch (err) {\n    63→    console.error('Login error:', err);\n    64→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n    65→      status: 500,\n    66→      headers: { 'Content-Type': 'application/json' },\n    67→    });\n    68→  }\n    69→}\n    70→"}]},"parent_tool_use_id":null,"session_id":"d368c602-990c-492b-b363-acd731fb4ad3","uuid":"471ddefb-bac7-4db0-a36b-c08abdd39490","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/netlify/functions/login.ts","content":"import type { Context } from '@netlify/functions';\nimport { getSql } from './db';\nimport crypto from 'crypto';\n\nfunction hashPassword(password: string, salt: string): string {\n  return crypto.pbkdf2Sync(password, salt, 10000, 64, 'sha512').toString('hex');\n}\n\nfunction generateToken(): string {\n  return crypto.randomBytes(48).toString('hex');\n}\n\nexport default async function handler(req: Request, _context: Context) {\n  if (req.method !== 'POST') {\n    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n      status: 405,\n      headers: { 'Content-Type': 'application/json' },\n    });\n  }\n\n  try {\n    const { email, password } = await req.json();\n\n    if (!email || !password) {\n      return new Response(JSON.stringify({ error: 'Email and password are required' }), {\n        status: 400,\n        headers: { 'Content-Type': 'application/json' },\n      });\n    }\n\n    const sql = getSql();\n    const users = await sql`SELECT id, name, email, password_hash, password_salt FROM members WHERE email = ${email}`;\n    const user = users[0];\n\n    if (!user) {\n      return new Response(JSON.stringify({ error: 'Invalid email or password' }), {\n        status: 401,\n        headers: { 'Content-Type': 'application/json' },\n      });\n    }\n\n    const hashedAttempt = hashPassword(password, user.password_salt);\n    if (hashedAttempt !== user.password_hash) {\n      return new Response(JSON.stringify({ error: 'Invalid email or password' }), {\n        status: 401,\n        headers: { 'Content-Type': 'application/json' },\n      });\n    }\n\n    const token = generateToken();\n    const expiresAt = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString();\n\n    await sql`INSERT INTO sessions (token, member_id, expires_at) VALUES (${token}, ${user.id}, ${expiresAt})`;\n\n    return new Response(JSON.stringify({\n      user: { id: user.id, name: user.name, email: user.email },\n      token,\n    }), {\n      status: 200,\n      headers: { 'Content-Type': 'application/json' },\n    });\n  } catch (err) {\n    console.error('Login error:', err);\n    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n      status: 500,\n      headers: { 'Content-Type': 'application/json' },\n    });\n  }\n}\n","numLines":70,"startLine":1,"totalLines":70}}}
