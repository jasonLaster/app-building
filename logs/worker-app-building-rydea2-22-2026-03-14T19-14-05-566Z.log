align-items: center;\n  gap: 8px;\n  width: 100%;\n  padding: 6px 8px;\n  border: none;\n  background: none;\n  color: var(--color-text-secondary);\n  font-size: 13px;\n  cursor: pointer;\n  border-radius: 4px;\n  transition: background-color 150ms ease, color 150ms ease;\n}\n\n.filters-toolbar-option:hover {\n  background-color: var(--color-bg-hover);\n  color: var(--color-text-primary);\n}\n\n.filters-toolbar-option-checked {\n  color: var(--color-text-primary);\n}\n\n.filters-toolbar-checkbox {\n  width: 14px;\n  height: 14px;\n  border: 1px solid var(--color-border);\n  border-radius: 3px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n\n.filters-toolbar-option-checked .filters-toolbar-checkbox {\n  background-color: var(--color-accent);\n  border-color: var(--color-accent);\n  color: #fff;\n}\n\n.filters-toolbar-label-dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  flex-shrink: 0;\n}\n\n.filters-toolbar-empty {\n  padding: 8px 12px;\n  color: var(--color-text-tertiary);\n  font-size: 12px;\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":286,"cache_read_input_tokens":72127,"cache_creation":{"ephemeral_5m_input_tokens":286,"ephemeral_1h_input_tokens":0},"output_tokens":24,"service_tier":"standard","inference_geo":"global"},"context_management":null},"parent_tool_use_id":null,"session_id":"d368c602-990c-492b-b363-acd731fb4ad3","uuid":"cc475626-f1d5-4786-b0cf-191b1f74e8da"}
