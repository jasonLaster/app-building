[2026-03-15T00:05:05.754Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01P6fyeUxEYNvKBBAzBaF1LK","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions'\n     2→import { getSql } from './db.js'\n     3→\n     4→export default async (request: Request, _context: Context) => {\n     5→  const sql = getSql()\n     6→  const url = new URL(request.url)\n     7→  const headers = { 'Content-Type': 'application/json' }\n     8→\n     9→  if (request.method === 'GET') {\n    10→    const guestId = url.searchParams.get('guest_id')\n    11→    const propertyId = url.searchParams.get('property_id')\n    12→\n    13→    if (guestId) {\n    14→      const reviews = await sql`\n    15→        SELECT r.*, p.title as property_title\n    16→        FROM reviews r\n    17→        JOIN properties p ON p.id = r.property_id\n    18→        WHERE r.guest_id = ${guestId}\n    19→        ORDER BY r.created_at DESC\n    20→      `\n    21→      return new Response(JSON.stringify(reviews), { status: 200, headers })\n    22→    }\n    23→\n    24→    if (propertyId) {\n    25→      const reviews = await sql`\n    26→        SELECT r.*, u.name as guest_name, u.avatar_url as guest_avatar\n    27→        FROM reviews r\n    28→        JOIN users u ON u.id = r.guest_id\n    29→        WHERE r.property_id = ${propertyId}\n    30→        ORDER BY r.created_at DESC\n    31→      `\n    32→      return new Response(JSON.stringify(reviews), { status: 200, headers })\n    33→    }\n    34→\n    35→    return new Response(JSON.stringify({ error: 'guest_id or property_id is required' }), { status: 400, headers })\n    36→  }\n    37→\n    38→  if (request.method === 'POST') {\n    39→    const body = await request.json() as {\n    40→      booking_id: string\n    41→      property_id: string\n    42→      guest_id: string\n    43→      rating: number\n    44→      cleanliness: number\n    45→      accuracy: number\n    46→      communication: number\n    47→      location: number\n    48→      value: number\n    49→      comment?: string | null\n    50→      created_at?: string | null\n    51→    }\n    52→\n    53→    const { booking_id, property_id, guest_id, rating, cleanliness, accuracy, communication, location, value, comment, created_at } = body\n    54→\n    55→    if (!booking_id || !property_id || !guest_id || !rating) {\n    56→      return new Response(JSON.stringify({ error: 'Missing required fields' }), { status: 400, headers })\n    57→    }\n    58→\n    59→    const existingReview = await sql`SELECT id FROM reviews WHERE booking_id = ${booking_id}`\n    60→    if (existingReview.length > 0) {\n    61→      return new Response(JSON.stringify({ error: 'A review already exists for this booking' }), { status: 409, headers })\n    62→    }\n    63→\n    64→    const result = await sql`\n    65→      INSERT INTO reviews (id, booking_id, property_id, guest_id, rating, cleanliness, accuracy, communication, location, value, comment, created_at)\n    66→      VALUES (gen_random_uuid(), ${booking_id}, ${property_id}, ${guest_id}, ${rating}, ${cleanliness}, ${accuracy}, ${communication}, ${location}, ${value}, ${comment || null}, ${created_at || new Date().toISOString()})\n    67→      RETURNING *\n    68→    `\n    69→    const review = result[0]\n    70→    if (!review) {\n    71→      return new Response(JSON.stringify({ error: 'Failed to create review' }), { status: 500, headers })\n    72→    }\n    73→    return new Response(JSON.stringify(review), { status: 201, headers })\n    74→  }\n    75→\n    76→  if (request.method === 'DELETE') {\n    77→    const segments = url.pathname.split('/').filter(Boolean)\n    78→    const revIdx = segments.indexOf('reviews')\n    79→    const reviewId = revIdx >= 0 ? segments[revIdx + 1] : undefined\n    80→    if (!reviewId) {\n    81→      return new Response(JSON.stringify({ error: 'Review ID is required' }), { status: 400, headers })\n    82→    }\n    83→    const result = await sql`DELETE FROM reviews WHERE id = ${reviewId} RETURNING *`\n    84→    const review = result[0]\n    85→    if (!review) {\n    86→      return new Response(JSON.stringify({ error: 'Review not found' }), { status: 404, headers })\n    87→    }\n    88→    return new Response(JSON.stringify(review), { status: 200, headers })\n    89→  }\n    90→\n    91→  return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers })\n    92→}\n    93→"}]},"parent_tool_use_id":null,"session_id":"1299eb81-ffa0-4f51-a2fd-69fb26f0839e","uuid":"3c5323dd-635e-4277-aadd-4c1d1e5b6406","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/netlify/functions/reviews.ts","content":"import type { Context } from '@netlify/functions'\nimport { getSql } from './db.js'\n\nexport default async (request: Request, _context: Context) => {\n  const sql = getSql()\n  const url = new URL(request.url)\n  const headers = { 'Content-Type': 'application/json' }\n\n  if (request.method === 'GET') {\n    const guestId = url.searchParams.get('guest_id')\n    const propertyId = url.searchParams.get('property_id')\n\n    if (guestId) {\n      const reviews = await sql`\n        SELECT r.*, p.title as property_title\n        FROM reviews r\n        JOIN properties p ON p.id = r.property_id\n        WHERE r.guest_id = ${guestId}\n        ORDER BY r.created_at DESC\n      `\n      return new Response(JSON.stringify(reviews), { status: 200, headers })\n    }\n\n    if (propertyId) {\n      const reviews = await sql`\n        SELECT r.*, u.name as guest_name, u.avatar_url as guest_avatar\n        FROM reviews r\n        JOIN users u ON u.id = r.guest_id\n        WHERE r.property_id = ${propertyId}\n        ORDER BY r.created_at DESC\n      `\n      return new Response(JSON.stringify(reviews), { status: 200, headers })\n    }\n\n    return new Response(JSON.stringify({ error: 'guest_id or property_id is required' }), { status: 400, headers })\n  }\n\n  if (request.method === 'POST') {\n    const body = await request.json() as {\n      booking_id: string\n      property_id: string\n      guest_id: string\n      rating: number\n      cleanliness: number\n      accuracy: number\n      communication: number\n      location: number\n      value: number\n      comment?: string | null\n      created_at?: string | null\n    }\n\n    const { booking_id, property_id, guest_id, rating, cleanliness, accuracy, communication, location, value, comment, created_at } = body\n\n    if (!booking_id || !property_id || !guest_id || !rating) {\n      return new Response(JSON.stringify({ error: 'Missing required fields' }), { status: 400, headers })\n    }\n\n    const existingReview = await sql`SELECT id FROM reviews WHERE booking_id = ${booking_id}`\n    if (existingReview.length > 0) {\n      return new Response(JSON.stringify({ error: 'A review already exists for this booking' }), { status: 409, headers })\n    }\n\n    const result = await sql`\n      INSERT INTO reviews (id, booking_id, property_id, guest_id, rating, cleanliness, accuracy, communication, location, value, comment, created_at)\n      VALUES (gen_random_uuid(), ${booking_id}, ${property_id}, ${guest_id}, ${rating}, ${cleanliness}, ${accuracy}, ${communication}, ${location}, ${value}, ${comment || null}, ${created_at || new Date().toISOString()})\n      RETURNING *\n    `\n    const review = result[0]\n    if (!review) {\n      return new Response(JSON.stringify({ error: 'Failed to create review' }), { status: 500, headers })\n    }\n    return new Response(JSON.stringify(review), { status: 201, headers })\n  }\n\n  if (request.method === 'DELETE') {\n    const segments = url.pathname.split('/').filter(Boolean)\n    const revIdx = segments.indexOf('reviews')\n    const reviewId = revIdx >= 0 ? segments[revIdx + 1] : undefined\n    if (!reviewId) {\n      return new Response(JSON.stringify({ error: 'Review ID is required' }), { status: 400, headers })\n    }\n    const result = await sql`DELETE FROM reviews WHERE id = ${reviewId} RETURNING *`\n    const review = result[0]\n    if (!review) {\n      return new Response(JSON.stringify({ error: 'Review not found' }), { status: 404, headers })\n    }\n    return new Response(JSON.stringify(review), { status: 200, headers })\n  }\n\n  return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers })\n}\n","numLines":93,"startLine":1,"totalLines":93}}}
