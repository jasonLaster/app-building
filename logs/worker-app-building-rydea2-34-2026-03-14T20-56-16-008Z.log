ES (${issueId}, ${session.member_id}, ${content}, NOW())\n    49→      RETURNING id, created_at\n    50→    `;\n    51→    const newComment = insertResult[0];\n    52→    if (!newComment) {\n    53→      return new Response(JSON.stringify({ error: 'Failed to create comment' }), {\n    54→        status: 500,\n    55→        headers: { 'Content-Type': 'application/json' },\n    56→      });\n    57→    }\n    58→\n    59→    // Create activity entry\n    60→    await sql`\n    61→      INSERT INTO activity (issue_id, member_id, action, created_at)\n    62→      VALUES (${issueId}, ${session.member_id}, 'added a comment', NOW())\n    63→    `;\n    64→\n    65→    // Update issue updated_at\n    66→    await sql`UPDATE issues SET updated_at = NOW() WHERE id = ${issueId}`;\n    67→\n    68→    // Get the commenter info\n    69→    const memberRows = await sql`SELECT name, email FROM members WHERE id = ${session.member_id}`;\n    70→    const member = memberRows[0];\n    71→\n    72→    // Create notification for issue assignee (if different from commenter)\n    73→    const issueRows = await sql`\n    74→      SELECT i.assignee_id, i.title, i.number, t.identifier\n    75→      FROM issues i JOIN teams t ON t.id = i.team_id\n    76→      WHERE i.id = ${issueId}\n    77→    `;\n    78→    const issue = issueRows[0];\n    79→    if (issue && issue.assignee_id && issue.assignee_id !== session.member_id) {\n    80→      const commenterName = member ? String(member.name) : 'Someone';\n    81→      const identifier = `${issue.identifier}-${issue.number}`;\n    82→      await sql`\n    83→        INSERT INTO notifications (member_id, type, message, issue_id, created_at)\n    84→        VALUES (${issue.assignee_id}, 'comment', ${`${commenterName} commented on ${identifier}: ${issue.title}`}, ${issueId}, NOW())\n    85→      `;\n    86→    }\n    87→\n    88→    return new Response(JSON.stringify({\n    89→      comment: {\n    90→        id: newComment.id,\n    91→        content,\n    92→        createdAt: newComment.created_at,\n    93→        memberId: session.member_id,\n    94→        memberName: member ? String(member.name) : null,\n    95→        memberEmail: member ? String(member.email) : null,\n    96→      },\n    97→    }), {\n    98→      status: 201,\n    99→      headers: { 'Content-Type': 'application/json' },\n   100→    });\n   101→  } catch (err) {\n   102→    console.error('Add comment error:', err);\n   103→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n   104→      status: 500,\n   105→      headers: { 'Content-Type': 'application/json' },\n   106→    });\n   107→  }\n   108→}\n   109→"}]},"parent_tool_use_id":"toolu_01NxzbEdHvg5HwikJ4Hzmti5","session_id":"fce00bd2-5cbf-4ef5-a5c6-94d6b48a030d","uuid":"15bc5d62-f4a1-4902-ba41-04c40076eedd"}
