[2026-03-14T20:44:32.362Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GP1JEAfjn2fxgE1hnXpLQp","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions';\n     2→import { getSql } from './db';\n     3→\n     4→export default async function handler(req: Request, _context: Context) {\n     5→  try {\n     6→    const authHeader = req.headers.get('Authorization');\n     7→    if (!authHeader?.startsWith('Bearer ')) {\n     8→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n     9→        status: 401,\n    10→        headers: { 'Content-Type': 'application/json' },\n    11→      });\n    12→    }\n    13→\n    14→    const token = authHeader.slice(7);\n    15→    const sql = getSql();\n    16→\n    17→    const sessions = await sql`\n    18→      SELECT s.member_id FROM sessions s\n    19→      WHERE s.token = ${token} AND s.expires_at > NOW()\n    20→    `;\n    21→    const session = sessions[0];\n    22→    if (!session) {\n    23→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    24→        status: 401,\n    25→        headers: { 'Content-Type': 'application/json' },\n    26→      });\n    27→    }\n    28→\n    29→    if (req.method === 'POST') {\n    30→      const body = await req.json();\n    31→      const { projectId, name, targetDate } = body;\n    32→\n    33→      if (!projectId || !name?.trim()) {\n    34→        return new Response(JSON.stringify({ error: 'projectId and name are required' }), {\n    35→          status: 400,\n    36→          headers: { 'Content-Type': 'application/json' },\n    37→        });\n    38→      }\n    39→\n    40→      const dateVal = targetDate || null;\n    41→      const result = await sql`\n    42→        INSERT INTO project_milestones (project_id, name, target_date, completed)\n    43→        VALUES (${projectId}, ${name.trim()}, ${dateVal}, false)\n    44→        RETURNING id, name, target_date, completed\n    45→      `;\n    46→      const milestone = result[0];\n    47→      if (!milestone) {\n    48→        return new Response(JSON.stringify({ error: 'Failed to create milestone' }), {\n    49→          status: 500,\n    50→          headers: { 'Content-Type': 'application/json' },\n    51→        });\n    52→      }\n    53→\n    54→      // Activity\n    55→      await sql`\n    56→        INSERT INTO project_activity (project_id, member_id, action, created_at)\n    57→        VALUES (${projectId}, ${session.member_id}, ${`added milestone \"${name.trim()}\"`}, NOW())\n    58→      `;\n    59→\n    60→      return new Response(JSON.stringify({\n    61→        milestone: {\n    62→          id: String(milestone.id),\n    63→          name: String(milestone.name),\n    64→          targetDate: milestone.target_date ? String(milestone.target_date).split('T')[0] : null,\n    65→          completed: Boolean(milestone.completed),\n    66→        },\n    67→      }), {\n    68→        status: 201,\n    69→        headers: { 'Content-Type': 'application/json' },\n    70→      });\n    71→    }\n    72→\n    73→    if (req.method === 'PUT') {\n    74→      const body = await req.json();\n    75→      const { milestoneId, projectId, name, targetDate, completed } = body;\n    76→\n    77→      if (!milestoneId) {\n    78→        return new Response(JSON.stringify({ error: 'milestoneId is required' }), {\n    79→          status: 400,\n    80→          headers: { 'Content-Type': 'application/json' },\n    81→        });\n    82→      }\n    83→\n    84→      // Fetch current milestone\n    85→      const currentRows = await sql`\n    86→        SELECT id, name, target_date, completed, project_id FROM project_milestones WHERE id = ${milestoneId}\n    87→      `;\n    88→      const current = currentRows[0];\n    89→      if (!current) {\n    90→        return new Response(JSON.stringify({ error: 'Milestone not found' }), {\n    91→          status: 404,\n    92→          headers: { 'Content-Type': 'application/json' },\n    93→        });\n    94→      }\n    95→\n    96→      const pid = projectId || String(current.project_id);\n    97→      let activityAction = '';\n    98→\n    99→      if (name !== undefined) {\n   100→        await sql`UPDATE project_milestones SET name = ${name.trim()} WHERE id = ${milestoneId}`;\n   101→        activityAction = `renamed milestone from \"${current.name}\" to \"${name.trim()}\"`;\n   102→      }\n   103→      if (targetDate !== undefined) {\n   104→        const dateVal = targetDate || null;\n   105→        await sql`UPDATE project_milestones SET target_date = ${dateVal} WHERE id = ${milestoneId}`;\n   106→        if (!activityAction) {\n   107→          activityAction = `updated milestone \"${current.name}\" target date`;\n   108→        }\n   109→      }\n   110→      if (completed !== undefined) {\n   111→        await sql`UPDATE project_milestones SET completed = ${completed} WHERE id = ${milestoneId}`;\n   112→        if (!activityAction) {\n   113→          activityAction = completed\n   114→            ? `marked milestone \"${current.name}\" as completed`\n   115→            : `marked milestone \"${current.name}\" as incomplete`;\n   116→        }\n   117→      }\n   118→\n   119→      if (activityAction) {\n   120→        await sql`\n   121→          INSERT INTO project_activity (project_id, member_id, action, created_at)\n   122→          VALUES (${pid}, ${session.member_id}, ${activityAction}, NOW())\n   123→        `;\n   124→      }\n   125→\n   126→      const updatedRows = await sql`\n   127→        SELECT id, name, target_date, completed FROM project_milestones WHERE id = ${milestoneId}\n   128→      `;\n   129→      const updated = updatedRows[0];\n   130→      if (!updated) {\n   131→        return new Response(JSON.stringify({ error: 'Milestone not found after update' }), {\n   132→          status: 500,\n   133→          headers: { 'Content-Type': 'application/json' },\n   134→        });\n   135→      }\n   136→\n   137→      return new Response(JSON.stringify({\n   138→        milestone: {\n   139→          id: String(updated.id),\n   140→          name: String(updated.name),\n   141→          targetDate: updated.target_date ? String(updated.target_date).split('T')[0] : null,\n   142→          completed: Boolean(updated.completed),\n   143→        },\n   144→      }), {\n   145→        status: 200,\n   146→        headers: { 'Content-Type': 'application/json' },\n   147→      });\n   148→    }\n   149→\n   150→    if (req.method === 'DELETE') {\n   151→      const url = new URL(req.url);\n   152→      const milestoneId = url.searchParams.get('milestoneId');\n   153→      const projectId = url.searchParams.get('projectId');\n   154→\n   155→      if (!milestoneId) {\n   156→        return new Response(JSON.stringify({ error: 'milestoneId is required' }), {\n   157→          status: 400,\n   158→          headers: { 'Content-Type': 'application/json' },\n   159→        });\n   160→      }\n   161→\n   162→      // Fetch milestone name for activity\n   163→      const msRows = await sql`\n   164→        SELECT name, project_id FROM project_milestones WHERE id = ${milestoneId}\n   165→      `;\n   166→      const ms = msRows[0];\n   167→      if (!ms) {\n   168→        return new Response(JSON.stringify({ error: 'Milestone not found' }), {\n   169→          status: 404,\n   170→          headers: { 'Content-Type': 'application/json' },\n   171→        });\n   172→      }\n   173→\n   174→      await sql`DELETE FROM project_milestones WHERE id = ${milestoneId}`;\n   175→\n   176→      const pid = projectId || String(ms.project_id);\n   177→      await sql`\n   178→        INSERT INTO project_activity (project_id, member_id, action, created_at)\n   179→        VALUES (${pid}, ${session.member_id}, ${`deleted milestone \"${ms.name}\"`}, NOW())\n   180→      `;\n   181→\n   182→      return new Response(JSON.stringify({ success: true }), {\n   183→        status: 200,\n   184→        headers: { 'Content-Type': 'application/json' },\n   185→      });\n   186→    }\n   187→\n   188→    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n   189→      status: 405,\n   190→      headers: { 'Content-Type': 'application/json' },\n   191→    });\n   192→  } catch (err) {\n   193→    console.error('Project milestones error:', err);\n   194→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n   195→      status: 500,\n   196→      headers: { 'Content-Type': 'application/json' },\n   197→    });\n   198→  }\n   199→}\n   200→"}]},"parent_tool_use_id":"toolu_01NxzbEdHvg5HwikJ4Hzmti5","session_id":"fce00bd2-5cbf-4ef5-a5c6-94d6b48a030d","uuid":"bd706ed5-6605-407a-a66a-e6a1ddea49a1"}
