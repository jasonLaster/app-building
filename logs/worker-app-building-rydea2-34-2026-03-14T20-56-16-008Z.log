[2026-03-14T20:44:30.806Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Xr7xMNfaXfAWGEHqvGGLhv","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions';\n     2→import { getSql } from './db';\n     3→\n     4→export default async function handler(req: Request, _context: Context) {\n     5→  if (req.method !== 'PUT') {\n     6→    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n     7→      status: 405,\n     8→      headers: { 'Content-Type': 'application/json' },\n     9→    });\n    10→  }\n    11→\n    12→  try {\n    13→    const authHeader = req.headers.get('Authorization');\n    14→    if (!authHeader?.startsWith('Bearer ')) {\n    15→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    16→        status: 401,\n    17→        headers: { 'Content-Type': 'application/json' },\n    18→      });\n    19→    }\n    20→\n    21→    const token = authHeader.slice(7);\n    22→    const sql = getSql();\n    23→\n    24→    const sessions = await sql`\n    25→      SELECT s.member_id FROM sessions s\n    26→      WHERE s.token = ${token} AND s.expires_at > NOW()\n    27→    `;\n    28→    const session = sessions[0];\n    29→    if (!session) {\n    30→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    31→        status: 401,\n    32→        headers: { 'Content-Type': 'application/json' },\n    33→      });\n    34→    }\n    35→\n    36→    const body = await req.json();\n    37→    const { projectId, field, value } = body;\n    38→\n    39→    if (!projectId || !field) {\n    40→      return new Response(JSON.stringify({ error: 'projectId and field are required' }), {\n    41→        status: 400,\n    42→        headers: { 'Content-Type': 'application/json' },\n    43→      });\n    44→    }\n    45→\n    46→    // Get current project state for activity logging\n    47→    const currentRows = await sql`\n    48→      SELECT p.*, m.name AS lead_name\n    49→      FROM projects p\n    50→      LEFT JOIN members m ON m.id = p.lead_id\n    51→      WHERE p.id = ${projectId}\n    52→    `;\n    53→    const current = currentRows[0];\n    54→    if (!current) {\n    55→      return new Response(JSON.stringify({ error: 'Project not found' }), {\n    56→        status: 404,\n    57→        headers: { 'Content-Type': 'application/json' },\n    58→      });\n    59→    }\n    60→\n    61→    const STATUS_LABELS: Record<string, string> = {\n    62→      planned: 'Planned',\n    63→      in_progress: 'In Progress',\n    64→      completed: 'Completed',\n    65→      cancelled: 'Cancelled',\n    66→    };\n    67→\n    68→    let activityAction = '';\n    69→\n    70→    if (field === 'name') {\n    71→      if (!value || !String(value).trim()) {\n    72→        return new Response(JSON.stringify({ error: 'Name is required' }), {\n    73→          status: 400,\n    74→          headers: { 'Content-Type': 'application/json' },\n    75→        });\n    76→      }\n    77→      await sql`UPDATE projects SET name = ${String(value).trim()} WHERE id = ${projectId}`;\n    78→      activityAction = `changed name from \"${current.name}\" to \"${String(value).trim()}\"`;\n    79→    } else if (field === 'status') {\n    80→      await sql`UPDATE projects SET status = ${value} WHERE id = ${projectId}`;\n    81→      const oldLabel = STATUS_LABELS[String(current.status)] || String(current.status);\n    82→      const newLabel = STATUS_LABELS[String(value)] || String(value);\n    83→      activityAction = `changed status from ${oldLabel} to ${newLabel}`;\n    84→    } else if (field === 'description') {\n    85→      const descVal = value || null;\n    86→      await sql`UPDATE projects SET description = ${descVal} WHERE id = ${projectId}`;\n    87→      activityAction = 'updated the description';\n    88→    } else if (field === 'targetDate') {\n    89→      const dateVal = value || null;\n    90→      await sql`UPDATE projects SET target_date = ${dateVal} WHERE id = ${projectId}`;\n    91→      if (dateVal) {\n    92→        activityAction = `set target date to ${value}`;\n    93→      } else {\n    94→        activityAction = 'removed target date';\n    95→      }\n    96→    } else if (field === 'leadId') {\n    97→      const leadVal = value || null;\n    98→      await sql`UPDATE projects SET lead_id = ${leadVal} WHERE id = ${projectId}`;\n    99→      if (leadVal) {\n   100→        const leadRows = await sql`SELECT name FROM members WHERE id = ${leadVal}`;\n   101→        const leadRow = leadRows[0];\n   102→        const newName = leadRow ? String(leadRow.name) : 'someone';\n   103→        if (current.lead_id) {\n   104→          activityAction = `changed lead from ${current.lead_name || 'unknown'} to ${newName}`;\n   105→        } else {\n   106→          activityAction = `set lead to ${newName}`;\n   107→        }\n   108→      } else {\n   109→        activityAction = `removed lead ${current.lead_name || ''}`;\n   110→      }\n   111→    } else {\n   112→      return new Response(JSON.stringify({ error: 'Invalid field' }), {\n   113→        status: 400,\n   114→        headers: { 'Content-Type': 'application/json' },\n   115→      });\n   116→    }\n   117→\n   118→    // Create project activity entry\n   119→    if (activityAction) {\n   120→      await sql`\n   121→        INSERT INTO project_activity (project_id, member_id, action, created_at)\n   122→        VALUES (${projectId}, ${session.member_id}, ${activityAction}, NOW())\n   123→      `;\n   124→    }\n   125→\n   126→    // Fetch updated project\n   127→    const updatedRows = await sql`\n   128→      SELECT\n   129→        p.id, p.name, p.description, p.status, p.target_date, p.lead_id,\n   130→        m.name AS lead_name, m.email AS lead_email,\n   131→        COUNT(i.id)::int AS total_issues,\n   132→        COUNT(CASE WHEN i.status = 'done' THEN 1 END)::int AS completed_issues,\n   133→        COUNT(CASE WHEN i.status = 'in_progress' THEN 1 END)::int AS in_progress_issues\n   134→      FROM projects p\n   135→      LEFT JOIN members m ON m.id = p.lead_id\n   136→      LEFT JOIN issues i ON i.project_id = p.id\n   137→      WHERE p.id = ${projectId}\n   138→      GROUP BY p.id, p.name, p.description, p.status, p.target_date, p.lead_id, m.name, m.email\n   139→    `;\n   140→    const updated = updatedRows[0];\n   141→    if (!updated) {\n   142→      return new Response(JSON.stringify({ error: 'Project not found after update' }), {\n   143→        status: 500,\n   144→        headers: { 'Content-Type': 'application/json' },\n   145→      });\n   146→    }\n   147→\n   148→    // Get latest activity\n   149→    const latestActivity = await sql`\n   150→      SELECT pa.id, pa.action, pa.created_at, pa.member_id, m2.name AS member_name, m2.email AS member_email\n   151→      FROM project_activity pa\n   152→      LEFT JOIN members m2 ON m2.id = pa.member_id\n   153→      WHERE pa.project_id = ${projectId}\n   154→      ORDER BY pa.created_at DESC\n   155→      LIMIT 1\n   156→    `;\n   157→\n   158→    const latestEntry = latestActivity[0];\n   159→\n   160→    return new Response(JSON.stringify({\n   161→      project: {\n   162→        id: String(updated.id),\n   163→        name: String(updated.name),\n   164→        description: updated.description ? String(updated.description) : null,\n   165→        status: String(updated.status),\n   166→        targetDate: updated.target_date ? String(updated.target_date).split('T')[0] : null,\n   167→        leadId: updated.lead_id ? String(updated.lead_id) : null,\n   168→        leadName: updated.lead_name ? String(updated.lead_name) : null,\n   169→        leadEmail: updated.lead_email ? String(updated.lead_email) : null,\n   170→        totalIssues: updated.total_issues,\n   171→        completedIssues: updated.completed_issues,\n   172→        inProgressIssues: updated.in_progress_issues,\n   173→      },\n   174→      activity: latestEntry ? {\n   175→        id: String(latestEntry.id),\n   176→        action: String(latestEntry.action),\n   177→        createdAt: String(latestEntry.created_at),\n   178→        memberId: String(latestEntry.member_id),\n   179→        memberName: latestEntry.member_name ? String(latestEntry.member_name) : null,\n   180→        memberEmail: latestEntry.member_email ? String(latestEntry.member_email) : null,\n   181→      } : null,\n   182→    }), {\n   183→      status: 200,\n   184→      headers: { 'Content-Type': 'application/json' },\n   185→    });\n   186→  } catch (err) {\n   187→    console.error('Update project error:', err);\n   188→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n   189→      status: 500,\n   190→      headers: { 'Content-Type': 'application/json' },\n   191→    });\n   192→  }\n   193→}\n   194→"}]},"parent_tool_use_id":"toolu_01NxzbEdHvg5HwikJ4Hzmti5","session_id":"fce00bd2-5cbf-4ef5-a5c6-94d6b48a030d","uuid":"c65eb793-c458-43fd-8c2d-c5e54f7ee8bd"}
