[2026-03-14T20:44:23.522Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01N37CybNfN2fYheE8y62Csy","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions';\n     2→import { getSql } from './db';\n     3→import crypto from 'crypto';\n     4→\n     5→function hashPassword(password: string, salt: string): string {\n     6→  return crypto.pbkdf2Sync(password, salt, 10000, 64, 'sha512').toString('hex');\n     7→}\n     8→\n     9→function generateToken(): string {\n    10→  return crypto.randomBytes(48).toString('hex');\n    11→}\n    12→\n    13→export default async function handler(req: Request, _context: Context) {\n    14→  if (req.method !== 'POST') {\n    15→    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n    16→      status: 405,\n    17→      headers: { 'Content-Type': 'application/json' },\n    18→    });\n    19→  }\n    20→\n    21→  try {\n    22→    const { email, password } = await req.json();\n    23→\n    24→    if (!email || !password) {\n    25→      return new Response(JSON.stringify({ error: 'Email and password are required' }), {\n    26→        status: 400,\n    27→        headers: { 'Content-Type': 'application/json' },\n    28→      });\n    29→    }\n    30→\n    31→    const sql = getSql();\n    32→    const users = await sql`SELECT id, name, email, password_hash, password_salt FROM members WHERE email = ${email}`;\n    33→    const user = users[0];\n    34→\n    35→    if (!user) {\n    36→      return new Response(JSON.stringify({ error: 'Invalid email or password' }), {\n    37→        status: 401,\n    38→        headers: { 'Content-Type': 'application/json' },\n    39→      });\n    40→    }\n    41→\n    42→    const hashedAttempt = hashPassword(password, user.password_salt);\n    43→    if (hashedAttempt !== user.password_hash) {\n    44→      return new Response(JSON.stringify({ error: 'Invalid email or password' }), {\n    45→        status: 401,\n    46→        headers: { 'Content-Type': 'application/json' },\n    47→      });\n    48→    }\n    49→\n    50→    const token = generateToken();\n    51→    const expiresAt = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString();\n    52→\n    53→    await sql`INSERT INTO sessions (token, member_id, expires_at) VALUES (${token}, ${user.id}, ${expiresAt})`;\n    54→\n    55→    return new Response(JSON.stringify({\n    56→      user: { id: user.id, name: user.name, email: user.email },\n    57→      token,\n    58→    }), {\n    59→      status: 200,\n    60→      headers: { 'Content-Type': 'application/json' },\n    61→    });\n    62→  } catch (err) {\n    63→    console.error('Login error:', err);\n    64→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n    65→      status: 500,\n    66→      headers: { 'Content-Type': 'application/json' },\n    67→    });\n    68→  }\n    69→}\n    70→"}]},"parent_tool_use_id":"toolu_01NxzbEdHvg5HwikJ4Hzmti5","session_id":"fce00bd2-5cbf-4ef5-a5c6-94d6b48a030d","uuid":"d61e998f-83a5-4d11-aef2-2e5825492fb9"}
