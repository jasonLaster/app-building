;\n   101→      if (!updated) {\n   102→        return jsonResponse({ error: 'Label not found' }, 404);\n   103→      }\n   104→\n   105→      const countRows = await sql`\n   106→        SELECT COUNT(*)::int AS cnt FROM issue_labels WHERE label_id = ${id}\n   107→      `;\n   108→      const countRow = countRows[0];\n   109→      const issue_count = countRow ? countRow.cnt : 0;\n   110→\n   111→      return jsonResponse({ label: { ...updated, issue_count } });\n   112→    }\n   113→\n   114→    if (req.method === 'DELETE') {\n   115→      const body = await req.json();\n   116→      const { id } = body as { id: string };\n   117→\n   118→      if (!id) {\n   119→        return jsonResponse({ error: 'Label id is required' }, 400);\n   120→      }\n   121→\n   122→      await sql`DELETE FROM issue_labels WHERE label_id = ${id}`;\n   123→      await sql`DELETE FROM labels WHERE id = ${id}`;\n   124→\n   125→      return jsonResponse({ success: true });\n   126→    }\n   127→\n   128→    return jsonResponse({ error: 'Method not allowed' }, 405);\n   129→  } catch (err) {\n   130→    console.error('Labels error:', err);\n   131→    return jsonResponse({ error: 'Internal server error' }, 500);\n   132→  }\n   133→}\n   134→"}]},"parent_tool_use_id":"toolu_01NxzbEdHvg5HwikJ4Hzmti5","session_id":"fce00bd2-5cbf-4ef5-a5c6-94d6b48a030d","uuid":"07505ac9-45cb-44f7-a6c4-6a6da847009c"}
