[2026-03-14T20:44:28.048Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MPsqN7oXJbrU4DaMcyKKsG","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions';\n     2→import { getSql } from './db';\n     3→\n     4→export default async function handler(req: Request, _context: Context) {\n     5→  if (req.method !== 'GET') {\n     6→    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n     7→      status: 405,\n     8→      headers: { 'Content-Type': 'application/json' },\n     9→    });\n    10→  }\n    11→\n    12→  try {\n    13→    const authHeader = req.headers.get('Authorization');\n    14→    if (!authHeader?.startsWith('Bearer ')) {\n    15→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    16→        status: 401,\n    17→        headers: { 'Content-Type': 'application/json' },\n    18→      });\n    19→    }\n    20→\n    21→    const token = authHeader.slice(7);\n    22→    const sql = getSql();\n    23→\n    24→    const sessions = await sql`\n    25→      SELECT s.member_id FROM sessions s\n    26→      WHERE s.token = ${token} AND s.expires_at > NOW()\n    27→    `;\n    28→    const session = sessions[0];\n    29→    if (!session) {\n    30→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    31→        status: 401,\n    32→        headers: { 'Content-Type': 'application/json' },\n    33→      });\n    34→    }\n    35→\n    36→    const url = new URL(req.url);\n    37→    const issueId = url.searchParams.get('issueId');\n    38→    if (!issueId) {\n    39→      return new Response(JSON.stringify({ error: 'issueId is required' }), {\n    40→        status: 400,\n    41→        headers: { 'Content-Type': 'application/json' },\n    42→      });\n    43→    }\n    44→\n    45→    const issues = await sql`\n    46→      SELECT\n    47→        i.id,\n    48→        i.title,\n    49→        i.description,\n    50→        i.status,\n    51→        i.priority,\n    52→        i.number,\n    53→        i.due_date,\n    54→        i.created_at,\n    55→        i.updated_at,\n    56→        i.team_id,\n    57→        i.assignee_id,\n    58→        i.project_id,\n    59→        i.cycle_id,\n    60→        i.parent_id,\n    61→        t.identifier AS team_identifier,\n    62→        t.name AS team_name,\n    63→        p.name AS project_name,\n    64→        m.name AS assignee_name,\n    65→        m.email AS assignee_email,\n    66→        c.name AS cycle_name\n    67→      FROM issues i\n    68→      JOIN teams t ON t.id = i.team_id\n    69→      LEFT JOIN projects p ON p.id = i.project_id\n    70→      LEFT JOIN members m ON m.id = i.assignee_id\n    71→      LEFT JOIN cycles c ON c.id = i.cycle_id\n    72→      WHERE i.id = ${issueId}\n    73→    `;\n    74→    const issue = issues[0];\n    75→    if (!issue) {\n    76→      return new Response(JSON.stringify({ error: 'Issue not found' }), {\n    77→        status: 404,\n    78→        headers: { 'Content-Type': 'application/json' },\n    79→      });\n    80→    }\n    81→\n    82→    // Fetch labels\n    83→    const issueLabels = await sql`\n    84→      SELECT l.id, l.name, l.color\n    85→      FROM issue_labels il\n    86→      JOIN labels l ON l.id = il.label_id\n    87→      WHERE il.issue_id = ${issueId}\n    88→    `;\n    89→\n    90→    // Fetch sub-issues\n    91→    const subIssues = await sql`\n    92→      SELECT\n    93→        si.id,\n    94→        si.title,\n    95→        si.status,\n    96→        si.priority,\n    97→        si.number,\n    98→        t.identifier AS team_identifier\n    99→      FROM issues si\n   100→      JOIN teams t ON t.id = si.team_id\n   101→      WHERE si.parent_id = ${issueId}\n   102→      ORDER BY si.created_at ASC\n   103→    `;\n   104→\n   105→    // Fetch activity\n   106→    const activity = await sql`\n   107→      SELECT\n   108→        a.id,\n   109→        a.action,\n   110→        a.created_at,\n   111→        a.member_id,\n   112→        m.name AS member_name,\n   113→        m.email AS member_email\n   114→      FROM activity a\n   115→      LEFT JOIN members m ON m.id = a.member_id\n   116→      WHERE a.issue_id = ${issueId}\n   117→      ORDER BY a.created_at ASC\n   118→    `;\n   119→\n   120→    // Fetch comments\n   121→    const comments = await sql`\n   122→      SELECT\n   123→        co.id,\n   124→        co.content,\n   125→        co.created_at,\n   126→        co.member_id,\n   127→        m.name AS member_name,\n   128→        m.email AS member_email\n   129→      FROM comments co\n   130→      LEFT JOIN members m ON m.id = co.member_id\n   131→      WHERE co.issue_id = ${issueId}\n   132→      ORDER BY co.created_at ASC\n   133→    `;\n   134→\n   135→    // Fetch team members for assignee selector\n   136→    const members = await sql`\n   137→      SELECT m.id, m.name, m.email\n   138→      FROM members m\n   139→      JOIN team_members tm ON tm.member_id = m.id\n   140→      WHERE tm.team_id = ${issue.team_id}\n   141→      ORDER BY m.name ASC\n   142→    `;\n   143→\n   144→    // Fetch team projects (include any project used by this team's issues)\n   145→    const projects = issue.project_id\n   146→      ? await sql`\n   147→          SELECT DISTINCT p.id, p.name\n   148→          FROM projects p\n   149→          WHERE p.id IN (\n   150→            SELECT DISTINCT i2.project_id FROM issues i2 WHERE i2.team_id = ${issue.team_id} AND i2.project_id IS NOT NULL\n   151→          ) OR p.id = ${issue.project_id}\n   152→          ORDER BY p.name ASC\n   153→        `\n   154→      : await sql`\n   155→          SELECT DISTINCT p.id, p.name\n   156→          FROM projects p\n   157→          WHERE p.id IN (\n   158→            SELECT DISTINCT i2.project_id FROM issues i2 WHERE i2.team_id = ${issue.team_id} AND i2.project_id IS NOT NULL\n   159→          )\n   160→          ORDER BY p.name ASC\n   161→        `;\n   162→\n   163→    // Fetch team cycles\n   164→    const cycles = await sql`\n   165→      SELECT c2.id, c2.name, c2.start_date, c2.end_date\n   166→      FROM cycles c2\n   167→      WHERE c2.team_id = ${issue.team_id}\n   168→      ORDER BY c2.start_date DESC\n   169→    `;\n   170→\n   171→    // Fetch all labels for the label picker\n   172→    const allLabels = await sql`\n   173→      SELECT id, name, color FROM labels ORDER BY name ASC\n   174→    `;\n   175→\n   176→    const enrichedIssue = {\n   177→      id: issue.id,\n   178→      title: issue.title,\n   179→      description: issue.description || '',\n   180→      status: issue.status,\n   181→      priority: issue.priority,\n   182→      identifier: `${issue.team_identifier}-${issue.number}`,\n   183→      number: issue.number,\n   184→      dueDate: issue.due_date ? String(issue.due_date).split('T')[0] : null,\n   185→      createdAt: issue.created_at,\n   186→      updatedAt: issue.updated_at,\n   187→      teamId: issue.team_id,\n   188→      teamName: issue.team_name,\n   189→      assigneeId: issue.assignee_id,\n   190→      assigneeName: issue.assignee_name,\n   191→      assigneeEmail: issue.assignee_email,\n   192→      projectId: issue.project_id,\n   193→      projectName: issue.project_name,\n   194→      cycleId: issue.cycle_id,\n   195→      cycleName: issue.cycle_name,\n   196→      parentId: issue.parent_id,\n   197→      labels: issueLabels.map((l) => ({ id: String(l.id), name: String(l.name), color: String(l.color) })),\n   198→    };\n   199→\n   200→    return new Response(JSON.stringify({\n   201→      issue: enrichedIssue,\n   202→      subIssues: subIssues.map((si) => ({\n   203→        id: si.id,\n   204→        title: si.title,\n   205→        status: si.status,\n   206→        priority: si.priority,\n   207→        identifier: `${si.team_identifier}-${si.number}`,\n   208→      })),\n   209→      activity: activity.map((a) => ({\n   210→        id: a.id,\n   211→        action: a.action,\n   212→        createdAt: a.created_at,\n   213→        memberId: a.member_id,\n   214→        memberName: a.member_name,\n   215→        memberEmail: a.member_email,\n   216→      })),\n   217→      comments: comments.map((co) => ({\n   218→        id: co.id,\n   219→        content: co.content,\n   220→        createdAt: co.created_at,\n   221→        memberId: co.member_id,\n   222→        memberName: co.member_name,\n   223→        memberEmail: co.member_email,\n   224→      })),\n   225→      members: members.map((m) => ({ id: String(m.id), name: String(m.name), email: String(m.email) })),\n   226→      projects: projects.map((p) => ({ id: String(p.id), name: String(p.name) })),\n   227→      cycles: cycles.map((c) => ({\n   228→        id: String(c.id),\n   229→        name: String(c.name),\n   230→        start_date: String(c.start_date),\n   231→        end_date: String(c.end_date),\n   232→      })),\n   233→      allLabels: allLabels.map((l) => ({ id: String(l.id), name: String(l.name), color: String(l.color) })),\n   234→    }), {\n   235→      status: 200,\n   236→      headers: { 'Content-Type': 'application/json' },\n   237→    });\n   238→  } catch (err) {\n   239→    console.error('Fetch issue detail error:', err);\n   240→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n   241→      status: 500,\n   242→      headers: { 'Content-Type': 'application/json' },\n   243→    });\n   244→  }\n   245→}\n   246→"}]},"parent_tool_use_id":"toolu_01NxzbEdHvg5HwikJ4Hzmti5","session_id":"fce00bd2-5cbf-4ef5-a5c6-94d6b48a030d","uuid":"389a988e-ccf8-4844-be63-d4b4c7d5fc38"}
