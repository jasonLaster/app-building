[2026-03-14T19:45:59.336Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016ALE4xdF8WPCJ3JvjgMufT","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test'\n     2→\n     3→/**\n     4→ * Helper to build a results page URL with search parameters.\n     5→ */\n     6→function buildResultsUrl(params?: {\n     7→  origin?: string\n     8→  destination?: string\n     9→  departureDate?: string\n    10→  returnDate?: string\n    11→  tripType?: string\n    12→  cabinClass?: string\n    13→  adults?: number\n    14→}): string {\n    15→  const nextMonth = new Date()\n    16→  nextMonth.setMonth(nextMonth.getMonth() + 1)\n    17→  const year = nextMonth.getFullYear()\n    18→  const month = String(nextMonth.getMonth() + 1).padStart(2, '0')\n    19→  const defaultDeparture = `${year}-${month}-25`\n    20→  const defaultReturn = `${year}-${month}-30`\n    21→\n    22→  const sp = new URLSearchParams({\n    23→    origin: params?.origin ?? 'LAX',\n    24→    destination: params?.destination ?? 'JFK',\n    25→    departureDate: params?.departureDate ?? defaultDeparture,\n    26→    tripType: params?.tripType ?? 'round_trip',\n    27→    cabinClass: params?.cabinClass ?? 'economy',\n    28→    adults: String(params?.adults ?? 1),\n    29→    children: '0',\n    30→    infants: '0',\n    31→  })\n    32→  if (params?.returnDate !== undefined) {\n    33→    sp.set('returnDate', params.returnDate)\n    34→  } else {\n    35→    sp.set('returnDate', defaultReturn)\n    36→  }\n    37→  return `/results?${sp.toString()}`\n    38→}\n    39→\n    40→/**\n    41→ * Helper to delete all tracked routes via API for a given session token.\n    42→ */\n    43→async function deleteAllTrackedRoutes(page: import('@playwright/test').Page, sessionToken: string) {\n    44→  const res = await page.request.get(`/api/tracked-routes?session=${sessionToken}&list=true`)\n    45→  if (res.ok()) {\n    46→    const data = await res.json() as { routes?: { id: string; origin_code: string; dest_code: string }[] }\n    47→    if (data.routes) {\n    48→      for (const route of data.routes) {\n    49→        await page.request.delete('/api/tracked-routes', {\n    50→          data: {\n    51→            sessionToken,\n    52→            originCode: route.origin_code,\n    53→            destCode: route.dest_code,\n    54→          },\n    55→        })\n    56→      }\n    57→    }\n    58→  }\n    59→}\n    60→\n    61→test.describe('TrackPricesToggle', () => {\n    62→  let sessionToken: string\n    63→\n    64→  test.beforeEach(async ({ page }) => {\n    65→    // Navigate to results page\n    66→    await page.goto(buildResultsUrl())\n    67→    await expect(page.getByTestId('search-results-page')).toBeVisible({ timeout: 15000 })\n    68→\n    69→    // Get session token from localStorage\n    70→    sessionToken = await page.evaluate(() => {\n    71→      return localStorage.getItem('session_token') || ''\n    72→    })\n    73→\n    74→    // Clean up tracked routes for this session\n    75→    if (sessionToken) {\n    76→      await deleteAllTrackedRoutes(page, sessionToken)\n    77→      // Reload to reflect clean state\n    78→      await page.reload()\n    79→      await expect(page.getByTestId('search-results-page')).toBeVisible({ timeout: 15000 })\n    80→    }\n    81→  })\n    82→\n    83→  test('TrackPricesToggle is displayed on results page', async ({ page }) => {\n    84→    // Verify toggle is visible\n    85→    const toggle = page.getByTestId('track-prices-toggle')\n    86→    await expect(toggle).toBeVisible({ timeout: 10000 })\n    87→\n    88→    // Verify it's in the off/untracked state\n    89→    const button = page.getByTestId('track-prices-button')\n    90→    await expect(button).toBeVisible()\n    91→    await expect(button).toContainText('Track prices')\n    92→    // Should NOT show \"Tracking prices\" (tracked state)\n    93→    await expect(button).not.toContainText('Tracking prices')\n    94→  })\n    95→\n    96→  test('TrackPricesToggle enables price tracking', async ({ page }) => {\n    97→    const button = page.getByTestId('track-prices-button')\n    98→\n    99→    // Verify initially off\n   100→    await expect(button).toContainText('Track prices', { timeout: 10000 })\n   101→    await expect(button).not.toContainText('Tracking prices')\n   102→\n   103→    // Click to enable tracking\n   104→    await button.click()\n   105→\n   106→    // Should switch to tracked state\n   107→    await expect(button).toContainText('Tracking prices', { timeout: 10000 })\n   108→  })\n   109→\n   110→  test('TrackPricesToggle disables price tracking', async ({ page }) => {\n   111→    const button = page.getByTestId('track-prices-button')\n   112→\n   113→    // First enable tracking\n   114→    await expect(button).toContainText('Track prices', { timeout: 10000 })\n   115→    await button.click()\n   116→    await expect(button).toContainText('Tracking prices', { timeout: 10000 })\n   117→\n   118→    // Now disable tracking\n   119→    await button.click()\n   120→\n   121→    // Should switch back to untracked state\n   122→    await expect(button).toContainText('Track prices', { timeout: 10000 })\n   123→    await expect(button).not.toContainText('Tracking prices')\n   124→  })\n   125→\n   126→  test('TrackPricesToggle reflects existing tracked route', async ({ page }) => {\n   127→    test.slow()\n   128→\n   129→    const button = page.getByTestId('track-prices-button')\n   130→\n   131→    // Enable tracking for LAX → JFK\n   132→    await expect(button).toContainText('Track prices', { timeout: 10000 })\n   133→    await button.click()\n   134→    await expect(button).toContainText('Tracking prices', { timeout: 10000 })\n   135→\n   136→    // Navigate away and come back to the same route\n   137→    await page.goto('/')\n   138→    await expect(page.getByTestId('search-page')).toBeVisible({ timeout: 10000 })\n   139→\n   140→    // Navigate back to the same search results\n   141→    await page.goto(buildResultsUrl())\n   142→    await expect(page.getByTestId('search-results-page')).toBeVisible({ timeout: 15000 })\n   143→\n   144→    // The toggle should reflect the existing tracked route (on state)\n   145→    await expect(page.getByTestId('track-prices-button')).toContainText('Tracking prices', { timeout: 10000 })\n   146→  })\n   147→\n   148→  test('TrackPricesToggle tracked route appears in My Trips', async ({ page }) => {\n   149→    test.slow()\n   150→\n   151→    const button = page.getByTestId('track-prices-button')\n   152→\n   153→    // Enable tracking for LAX → JFK\n   154→    await expect(button).toContainText('Track prices', { timeout: 10000 })\n   155→    await button.click()\n   156→    await expect(button).toContainText('Tracking prices', { timeout: 10000 })\n   157→\n   158→    // Navigate to My Trips page\n   159→    await page.goto('/trips')\n   160→    await expect(page.getByTestId('my-trips-page')).toBeVisible({ timeout: 10000 })\n   161→\n   162→    // Click the \"Tracked\" tab\n   163→    await page.getByTestId('trips-tab-tracked').click()\n   164→\n   165→    // Verify tracked route appears in the list\n   166→    const trackedList = page.getByTestId('trips-tracked-list')\n   167→    await expect(trackedList).toBeVisible({ timeout: 10000 })\n   168→\n   169→    // Verify route details (LAX → JFK)\n   170→    await expect(trackedList).toContainText('LAX')\n   171→    await expect(trackedList).toContainText('JFK')\n   172→  })\n   173→\n   174→  test('TrackPricesToggle can be toggled multiple times', async ({ page }) => {\n   175→    test.slow()\n   176→\n   177→    const button = page.getByTestId('track-prices-button')\n   178→\n   179→    // Initially off\n   180→    await expect(button).toContainText('Track prices', { timeout: 10000 })\n   181→    await expect(button).not.toContainText('Tracking prices')\n   182→\n   183→    // Toggle ON\n   184→    await button.click()\n   185→    await expect(button).toContainText('Tracking prices', { timeout: 10000 })\n   186→\n   187→    // Toggle OFF\n   188→    await button.click()\n   189→    await expect(button).toContainText('Track prices', { timeout: 10000 })\n   190→    await expect(button).not.toContainText('Tracking prices')\n   191→\n   192→    // Toggle ON again\n   193→    await button.click()\n   194→    await expect(button).toContainText('Tracking prices', { timeout: 10000 })\n   195→  })\n   196→})\n   197→"}]},"parent_tool_use_id":null,"session_id":"749045d3-bc8c-40ae-9c1b-d62b27286993","uuid":"738ce4c1-417d-4798-a0cf-c1084471a7cc","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/GoogleFlights/tests/track-prices-toggle.spec.ts","content":"import { test, expect } from '@playwright/test'\n\n/**\n * Helper to build a results page URL with search parameters.\n */\nfunction buildResultsUrl(params?: {\n  origin?: string\n  destination?: string\n  departureDate?: string\n  returnDate?: string\n  tripType?: string\n  cabinClass?: string\n  adults?: number\n}): string {\n  const nextMonth = new Date()\n  nextMonth.setMonth(nextMonth.getMonth() + 1)\n  const year = nextMonth.getFullYear()\n  const month = String(nextMonth.getMonth() + 1).padStart(2, '0')\n  const defaultDeparture = `${year}-${month}-25`\n  const defaultReturn = `${year}-${month}-30`\n\n  const sp = new URLSearchParams({\n    origin: params?.origin ?? 'LAX',\n    destination: params?.destination ?? 'JFK',\n    departureDate: params?.departureDate ?? defaultDeparture,\n    tripType: params?.tripType ?? 'round_trip',\n    cabinClass: params?.cabinClass ?? 'economy',\n    adults: String(params?.adults ?? 1),\n    children: '0',\n    infants: '0',\n  })\n  if (params?.returnDate !== undefined) {\n    sp.set('returnDate', params.returnDate)\n  } else {\n    sp.set('returnDate', defaultReturn)\n  }\n  return `/results?${sp.toString()}`\n}\n\n/**\n * Helper to delete all tracked routes via API for a given session token.\n */\nasync function deleteAllTrackedRoutes(page: import('@playwright/test').Page, sessionToken: string) {\n  const res = await page.request.get(`/api/tracked-routes?session=${sessionToken}&list=true`)\n  if (res.ok()) {\n    const data = await res.json() as { routes?: { id: string; origin_code: string; dest_code: string }[] }\n    if (data.routes) {\n      for (const route of data.routes) {\n        await page.request.delete('/api/tracked-routes', {\n          data: {\n            sessionToken,\n            originCode: route.origin_code,\n            destCode: route.dest_code,\n          },\n        })\n      }\n    }\n  }\n}\n\ntest.describe('TrackPricesToggle', () => {\n  let sessionToken: string\n\n  test.beforeEach(async ({ page }) => {\n    // Navigate to results page\n    await page.goto(buildResultsUrl())\n    await expect(page.getByTestId('search-results-page')).toBeVisible({ timeout: 15000 })\n\n    // Get session token from localStorage\n    sessionToken = await page.evaluate(() => {\n      return localStorage.getItem('session_token') || ''\n    })\n\n    // Clean up tracked routes for this session\n    if (sessionToken) {\n      await deleteAllTrackedRoutes(page, sessionToken)\n      // Reload to reflect clean state\n      await page.reload()\n      await expect(page.getByTestId('search-results-page')).toBeVisible({ timeout: 15000 })\n    }\n  })\n\n  test('TrackPricesToggle is displayed on results page', async ({ page }) => {\n    // Verify toggle is visible\n    const toggle = page.getByTestId('track-prices-toggle')\n    await expect(toggle).toBeVisible({ timeout: 10000 })\n\n    // Verify it's in the off/untracked state\n    const button = page.getByTestId('track-prices-button')\n    await expect(button).toBeVisible()\n    await expect(button).toContainText('Track prices')\n    // Should NOT show \"Tracking prices\" (tracked state)\n    await expect(button).not.toContainText('Tracking prices')\n  })\n\n  test('TrackPricesToggle enables price tracking', async ({ page }) => {\n    const button = page.getByTestId('track-prices-button')\n\n    // Verify initially off\n    await expect(button).toContainText('Track prices', { timeout: 10000 })\n    await expect(button).not.toContainText('Tracking prices')\n\n    // Click to enable tracking\n    await button.click()\n\n    // Should switch to tracked state\n    await expect(button).toContainText('Tracking prices', { timeout: 10000 })\n  })\n\n  test('TrackPricesToggle disables price tracking', async ({ page }) => {\n    const button = page.getByTestId('track-prices-button')\n\n    // First enable tracking\n    await expect(button).toContainText('Track prices', { timeout: 10000 })\n    await button.click()\n    await expect(button).toContainText('Tracking prices', { timeout: 10000 })\n\n    // Now disable tracking\n    await button.click()\n\n    // Should switch back to untracked state\n    await expect(button).toContainText('Track prices', { timeout: 10000 })\n    await expect(button).not.toContainText('Tracking prices')\n  })\n\n  test('TrackPricesToggle reflects existing tracked route', async ({ page }) => {\n    test.slow()\n\n    const button = page.getByTestId('track-prices-button')\n\n    // Enable tracking for LAX → JFK\n    await expect(button).toContainText('Track prices', { timeout: 10000 })\n    await button.click()\n    await expect(button).toContainText('Tracking prices', { timeout: 10000 })\n\n    // Navigate away and come back to the same route\n    await page.goto('/')\n    await expect(page.getByTestId('search-page')).toBeVisible({ timeout: 10000 })\n\n    // Navigate back to the same search results\n    await page.goto(buildResultsUrl())\n    await expect(page.getByTestId('search-results-page')).toBeVisible({ timeout: 15000 })\n\n    // The toggle should reflect the existing tracked route (on state)\n    await expect(page.getByTestId('track-prices-button')).toContainText('Tracking prices', { timeout: 10000 })\n  })\n\n  test('TrackPricesToggle tracked route appears in My Trips', async ({ page }) => {\n    test.slow()\n\n    const button = page.getByTestId('track-prices-button')\n\n    // Enable tracking for LAX → JFK\n    await expect(button).toContainText('Track prices', { timeout: 10000 })\n    await button.click()\n    await expect(button).toContainText('Tracking prices', { timeout: 10000 })\n\n    // Navigate to My Trips page\n    await page.goto('/trips')\n    await expect(page.getByTestId('my-trips-page')).toBeVisible({ timeout: 10000 })\n\n    // Click the \"Tracked\" tab\n    await page.getByTestId('trips-tab-tracked').click()\n\n    // Verify tracked route appears in the list\n    const trackedList = page.getByTestId('trips-tracked-list')\n    await expect(trackedList).toBeVisible({ timeout: 10000 })\n\n    // Verify route details (LAX → JFK)\n    await expect(trackedList).toContainText('LAX')\n    await expect(trackedList).toContainText('JFK')\n  })\n\n  test('TrackPricesToggle can be toggled multiple times', async ({ page }) => {\n    test.slow()\n\n    const button = page.getByTestId('track-prices-button')\n\n    // Initially off\n    await expect(button).toContainText('Track prices', { timeout: 10000 })\n    await expect(button).not.toContainText('Tracking prices')\n\n    // Toggle ON\n    await button.click()\n    await expect(button).toContainText('Tracking prices', { timeout: 10000 })\n\n    // Toggle OFF\n    await button.click()\n    await expect(button).toContainText('Track prices', { timeout: 10000 })\n    await expect(button).not.toContainText('Tracking prices')\n\n    // Toggle ON again\n    await button.click()\n    await expect(button).toContainText('Tracking prices', { timeout: 10000 })\n  })\n})\n","numLines":197,"startLine":1,"totalLines":197}}}
