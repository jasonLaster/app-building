ground: var(--color-primary-light);\n  border-color: var(--color-primary);\n  color: var(--color-primary);\n}\n\n.search-summary-bar__chip-icon {\n  font-size: 14px;\n}\n\n.search-summary-bar__arrow {\n  color: var(--color-text-secondary);\n  font-size: 16px;\n  font-weight: 500;\n}\n\n.search-summary-bar__divider {\n  width: 1px;\n  height: 24px;\n  background: var(--color-border-light);\n  margin: 0 4px;\n}\n\n.search-summary-bar__chip-wrapper {\n  position: relative;\n}\n\n.search-summary-bar__editor {\n  position: absolute;\n  top: calc(100% + 8px);\n  left: 0;\n  z-index: 100;\n  background: var(--color-surface);\n  border-radius: var(--radius-md);\n  box-shadow: 0 4px 16px var(--color-shadow-hover);\n  padding: 8px;\n  min-width: 280px;\n}\n\n.search-summary-bar__editor--wide {\n  min-width: 320px;\n}\n\n@media (max-width: 640px) {\n  .search-summary-bar {\n    padding: 8px 12px;\n  }\n\n  .search-summary-bar__chips {\n    gap: 6px;\n  }\n\n  .search-summary-bar__chip {\n    padding: 6px 12px;\n    font-size: 13px;\n  }\n\n  .search-summary-bar__divider {\n    display: none;\n  }\n}\n","numLines":98,"startLine":1,"totalLines":98}}}
