n className=\"cabin-class-selector__arrow\">{isOpen ? '▲' : '▼'}</span>\n    43→      </button>\n    44→      {isOpen && (\n    45→        <div className=\"cabin-class-selector__dropdown\" data-testid=\"cabin-class-dropdown\">\n    46→          {cabinClasses.map((cls) => (\n    47→            <button\n    48→              key={cls.value}\n    49→              className={`cabin-class-selector__option ${cabinClass === cls.value ? 'cabin-class-selector__option--selected' : ''}`}\n    50→              onClick={() => {\n    51→                dispatch(setCabinClass(cls.value))\n    52→                setIsOpen(false)\n    53→              }}\n    54→              data-testid={`cabin-class-option-${cls.value}`}\n    55→            >\n    56→              {cls.label}\n    57→            </button>\n    58→          ))}\n    59→        </div>\n    60→      )}\n    61→    </div>\n    62→  )\n    63→}\n    64→\n    65→export default CabinClassSelector\n    66→"}]},"parent_tool_use_id":null,"session_id":"749045d3-bc8c-40ae-9c1b-d62b27286993","uuid":"5618eeb7-9124-493b-8ebb-909b54e42e5e","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/GoogleFlights/src/components/CabinClassSelector.tsx","content":"import { useState, useRef, useEffect } from 'react'\nimport { useDispatch, useSelector } from 'react-redux'\nimport { setCabinClass, type CabinClass } from '../slices/searchSlice'\nimport type { RootState } from '../store'\nimport './CabinClassSelector.css'\n\nconst cabinClasses: { value: CabinClass; label: string }[] = [\n  { value: 'economy', label: 'Economy' },\n  { value: 'premium_economy', label: 'Premium Economy' },\n  { value: 'business', label: 'Business' },\n  { value: 'first', label: 'First' },\n]\n\nfunction CabinClassSelector() {\n  const dispatch = useDispatch()\n  const cabinClass = useSelector((state: RootState) => state.search.cabinClass)\n  const [isOpen, setIsOpen] = useState(false)\n  const ref = useRef<HTMLDivElement>(null)\n\n  useEffect(() => {\n    function handleClickOutside(e: MouseEvent) {\n      if (ref.current && !ref.current.contains(e.target as Node)) {\n        setIsOpen(false)\n      }\n    }\n    if (isOpen) {\n      document.addEventListener('mousedown', handleClickOutside)\n      return () => document.removeEventListener('mousedown', handleClickOutside)\n    }\n  }, [isOpen])\n\n  const selectedLabel = cabinClasses.find((c) => c.value === cabinClass)?.label || 'Economy'\n\n  return (\n    <div className=\"cabin-class-selector\" ref={ref} data-testid=\"cabin-class-selector\">\n      <button\n        className=\"cabin-class-selector__trigger\"\n        onClick={() => setIsOpen(!isOpen)}\n        data-testid=\"cabin-class-trigger\"\n      >\n        <span>{selectedLabel}</span>\n        <span className=\"cabin-class-selector__arrow\">{isOpen ? '▲' : '▼'}</span>\n      </button>\n      {isOpen && (\n        <div className=\"cabin-class-selector__dropdown\" data-testid=\"cabin-class-dropdown\">\n          {cabinClasses.map((cls) => (\n            <button\n              key={cls.value}\n              className={`cabin-class-selector__option ${cabinClass === cls.value ? 'cabin-class-selector__option--selected' : ''}`}\n              onClick={() => {\n                dispatch(setCabinClass(cls.value))\n                setIsOpen(false)\n              }}\n              data-testid={`cabin-class-option-${cls.value}`}\n            >\n              {cls.label}\n            </button>\n          ))}\n        </div>\n      )}\n    </div>\n  )\n}\n\nexport default CabinClassSelector\n","numLines":66,"startLine":1,"totalLines":66}}}
