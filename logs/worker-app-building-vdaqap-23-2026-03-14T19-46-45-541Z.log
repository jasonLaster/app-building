n    45→        <div className=\"tracked-route-card__route\">\n    46→          <span className=\"tracked-route-card__route-text\" data-testid={`tracked-route-route-${route.id}`}>\n    47→            {route.origin_code} → {route.dest_code}\n    48→          </span>\n    49→          <span className=\"tracked-route-card__cities\">\n    50→            {route.origin_city} to {route.dest_city}\n    51→          </span>\n    52→        </div>\n    53→      </div>\n    54→\n    55→      <div className=\"tracked-route-card__details\">\n    56→        <div className=\"tracked-route-card__date-range\" data-testid={`tracked-route-dates-${route.id}`}>\n    57→          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\">\n    58→            <rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\" />\n    59→            <line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\" />\n    60→            <line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\" />\n    61→            <line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\" />\n    62→          </svg>\n    63→          {dateRange}\n    64→        </div>\n    65→\n    66→        {route.lowest_price_cents != null && (\n    67→          <div className=\"tracked-route-card__price\" data-testid={`tracked-route-price-${route.id}`}>\n    68→            <span className=\"tracked-route-card__price-label\">Lowest price</span>\n    69→            <span className=\"tracked-route-card__price-value\">\n    70→              {formatPrice(route.lowest_price_cents)}\n    71→            </span>\n    72→          </div>\n    73→        )}\n    74→      </div>\n    75→\n    76→      <div className=\"tracked-route-card__actions\">\n    77→        <button\n    78→          className=\"tracked-route-card__search-btn\"\n    79→          onClick={handleSearch}\n    80→          data-testid={`tracked-route-search-${route.id}`}\n    81→        >\n    82→          Search\n    83→        </button>\n    84→        <button\n    85→          className=\"tracked-route-card__untrack-btn\"\n    86→          onClick={() => onUntrack(route.id)}\n    87→          disabled={isUntracking}\n    88→          data-testid={`tracked-route-untrack-${route.id}`}\n    89→        >\n    90→          {isUntracking ? 'Removing...' : 'Untrack'}\n    91→        </button>\n    92→      </div>\n    93→    </div>\n    94→  )\n    95→}\n    96→\n    97→export default TrackedRouteCard\n    98→"}]},"parent_tool_use_id":null,"session_id":"749045d3-bc8c-40ae-9c1b-d62b27286993","uuid":"b673a63b-92bc-4096-835a-dcf546d8795f","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/GoogleFlights/src/components/TrackedRouteCard.tsx","content":"import { useNavigate } from 'react-router-dom'\nimport type { TrackedRoute } from '../slices/tripsSlice'\nimport './TrackedRouteCard.css'\n\nfunction formatDate(dateStr: string | null): string {\n  if (!dateStr) return ''\n  const d = new Date(dateStr.split('T')[0] + 'T00:00:00')\n  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })\n}\n\nfunction formatPrice(cents: number): string {\n  return `$${Math.round(cents / 100)}`\n}\n\ninterface TrackedRouteCardProps {\n  route: TrackedRoute\n  onUntrack: (routeId: string) => void\n  isUntracking: boolean\n}\n\nfunction TrackedRouteCard({ route, onUntrack, isUntracking }: TrackedRouteCardProps) {\n  const navigate = useNavigate()\n\n  const handleSearch = () => {\n    const params = new URLSearchParams({\n      origin: route.origin_code,\n      destination: route.dest_code,\n      cabinClass: route.cabin_class || 'economy',\n    })\n    if (route.departure_date_start) {\n      params.set('departureDate', route.departure_date_start.split('T')[0] || '')\n    }\n    navigate(`/results?${params.toString()}`)\n  }\n\n  const dateRange = route.departure_date_start && route.departure_date_end\n    ? `${formatDate(route.departure_date_start)} – ${formatDate(route.departure_date_end)}`\n    : route.departure_date_start\n      ? `From ${formatDate(route.departure_date_start)}`\n      : 'Any dates'\n\n  return (\n    <div className=\"tracked-route-card\" data-testid={`tracked-route-card-${route.id}`}>\n      <div className=\"tracked-route-card__header\">\n        <div className=\"tracked-route-card__route\">\n          <span className=\"tracked-route-card__route-text\" data-testid={`tracked-route-route-${route.id}`}>\n            {route.origin_code} → {route.dest_code}\n          </span>\n          <span className=\"tracked-route-card__cities\">\n            {route.origin_city} to {route.dest_city}\n          </span>\n        </div>\n      </div>\n\n      <div className=\"tracked-route-card__details\">\n        <div className=\"tracked-route-card__date-range\" data-testid={`tracked-route-dates-${route.id}`}>\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\">\n            <rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\" />\n            <line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\" />\n            <line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\" />\n            <line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\" />\n          </svg>\n          {dateRange}\n        </div>\n\n        {route.lowest_price_cents != null && (\n          <div className=\"tracked-route-card__price\" data-testid={`tracked-route-price-${route.id}`}>\n            <span className=\"tracked-route-card__price-label\">Lowest price</span>\n            <span className=\"tracked-route-card__price-value\">\n              {formatPrice(route.lowest_price_cents)}\n            </span>\n          </div>\n        )}\n      </div>\n\n      <div className=\"tracked-route-card__actions\">\n        <button\n          className=\"tracked-route-card__search-btn\"\n          onClick={handleSearch}\n          data-testid={`tracked-route-search-${route.id}`}\n        >\n          Search\n        </button>\n        <button\n          className=\"tracked-route-card__untrack-btn\"\n          onClick={() => onUntrack(route.id)}\n          disabled={isUntracking}\n          data-testid={`tracked-route-untrack-${route.id}`}\n        >\n          {isUntracking ? 'Removing...' : 'Untrack'}\n        </button>\n      </div>\n    </div>\n  )\n}\n\nexport default TrackedRouteCard\n","numLines":98,"startLine":1,"totalLines":98}}}
