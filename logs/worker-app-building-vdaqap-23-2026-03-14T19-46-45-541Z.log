stid=\"summary-passengers-editor\">\n              <PassengerCountSelector />\n              <ApplyButton\n                testId=\"summary-passengers-done\"\n                onClick={() => {\n                  onSearch({\n                    adults: searchState.passengers.adults,\n                    children: searchState.passengers.children,\n                    infants: searchState.passengers.infants,\n                  })\n                  setEditing(null)\n                }}\n              />\n            </div>\n          )}\n        </div>\n\n        <div className=\"search-summary-bar__chip-wrapper\" style={{ position: 'relative' }}>\n          <button\n            className={`search-summary-bar__chip ${editing === 'cabinClass' ? 'search-summary-bar__chip--active' : ''}`}\n            onClick={() => setEditing(editing === 'cabinClass' ? null : 'cabinClass')}\n            data-testid=\"summary-cabin-class\"\n          >\n            <span className=\"search-summary-bar__chip-icon\">💺</span>\n            {formatCabinClass(cabinClass)}\n          </button>\n          {editing === 'cabinClass' && (\n            <div className=\"search-summary-bar__editor\" data-testid=\"summary-cabin-editor\">\n              <CabinClassSelector />\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  )\n}\n\nexport default SearchSummaryBar\n","structuredPatch":[{"oldStart":262,"oldLines":6,"newStart":262,"newLines":13,"lines":["           {editing === 'cabinClass' && (","             <div className=\"search-summary-bar__editor\" data-testid=\"summary-cabin-editor\">","               <CabinClassSelector />","+              <ApplyButton","+                testId=\"summary-cabin-done\"","+                onClick={() => {","+                  onSearch({ cabinClass: searchState.cabinClass })","+                  setEditing(null)","+                }}","+              />","             </div>","           )}","         </div>"]}],"userModified":false,"replace