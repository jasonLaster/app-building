Todo',\n    53→  async ({ id, updates }: { id: string; updates: Partial<Omit<Todo, 'id' | 'created_at' | 'updated_at'>> }) => {\n    54→    const res = await fetch(`${API_BASE}/${id}`, {\n    55→      method: 'PUT',\n    56→      headers: { 'Content-Type': 'application/json' },\n    57→      body: JSON.stringify(updates),\n    58→    })\n    59→    if (!res.ok) throw new Error('Failed to update todo')\n    60→    return (await res.json()) as Todo\n    61→  }\n    62→)\n    63→\n    64→export const deleteTodo = createAsyncThunk('todos/deleteTodo', async (id: string) => {\n    65→  const res = await fetch(`${API_BASE}/${id}`, { method: 'DELETE' })\n    66→  if (!res.ok) throw new Error('Failed to delete todo')\n    67→  return id\n    68→})\n    69→\n    70→export const clearCompleted = createAsyncThunk('todos/clearCompleted', async () => {\n    71→  const res = await fetch(`${API_BASE}?completed=true`, { method: 'DELETE' })\n    72→  if (!res.ok) throw new Error('Failed to clear completed')\n    73→  return (await res.json()) as Todo[]\n    74→})\n    75→\n    76→const todosSlice = createSlice({\n    77→  name: 'todos',\n    78→  initialState,\n    79→  reducers: {\n    80→    setFilter(state, action) {\n    81→      state.filter = action.payload\n    82→    },\n    83→    setSort(state, action) {\n    84→      state.sort = action.payload\n    85→    },\n    86→  },\n    87→  extraReducers: (builder) => {\n    88→    builder\n    89→      .addCase(fetchTodos.pending, (state) => {\n    90→        if (state.items.length === 0) {\n    91→          state.loading = true\n    92→        }\n    93→        state.error = null\n    94→      })\n    95→      .addCase(fetchTodos.fulfilled, (state, action) => {\n    96→        state.loading = false\n    97→        state.items = action.payload\n    98→      })\n    99→      .addCase(fetchTodos.rejected, (state, action) => {\n   100→        state.loading = false\n   101→        state.error = action.error.message || 'Failed to fetch