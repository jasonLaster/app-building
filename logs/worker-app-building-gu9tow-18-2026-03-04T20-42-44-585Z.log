')).toHaveClass(/line-through/, { timeout: 10000 })\n   179→\n   180→    // Header count should decrease\n   181→    await expect(page.getByTestId('todo-count')).toContainText('0 items left', { timeout: 10000 })\n   182→  })\n   183→\n   184→  test('Uncheck a completed todo to mark it active again', async ({ page }) => {\n   185→    const sql = getTestSql()\n   186→    if (sql) {\n   187→      await sql`TRUNCATE TABLE todos`\n   188→      await sql`\n   189→        INSERT INTO todos (title, completed, priority) VALUES\n   190→        ('Buy milk', true, 'medium'),\n   191→        ('Another task', false, 'low')\n   192→      `\n   193→    }\n   194→    await page.goto('/')\n   195→\n   196→    const todoItem = page.getByTestId('todo-item').filter({ hasText: 'Buy milk' })\n   197→    await expect(todoItem).toBeVisible({ timeout: 10000 })\n   198→\n   199→    // Initially: 1 active item (Another task), so header shows \"1 item left\"\n   200→    await expect(page.getByTestId('todo-count')).toContainText('1 item left', { timeout: 10000 })\n   201→\n   202→    // Verify completed styling initially present\n   203→    await expect(todoItem.getByTestId('todo-text')).toHaveClass(/line-through/)\n   204→\n   205→    // Click checkbox to mark active\n   206→    await todoItem.getByTestId('todo-checkbox').click()\n   207→\n   208→    // Strikethrough should be removed\n   209→    await expect(todoItem.getByTestId('todo-text')).not.toHaveClass(/line-through/, { timeout: 10000 })\n   210→\n   211→    // Header count should increase\n   212→    await expect(page.getByTestId('todo-count')).toContainText('2 items left', { timeout: 10000 })\n   213→  })\n   214→\n   215→  test('Completed todo has strikethrough text and reduced opacity', async ({ page }) => {\n   216→    // Seed data has 'Read a book' as completed\n   217→    await page.goto('/')\n   218→\n   219→    const completedItem = page.getByTestId('todo-item').filter({ hasText: 'Read a book' })\n   220→    await expect(complet