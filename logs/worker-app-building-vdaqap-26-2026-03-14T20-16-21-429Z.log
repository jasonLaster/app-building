\n   292→      { origin: 'SFO', dest: 'ORD', dep: '2026-04-01 14:30', arr: '2026-04-01 20:00', dur: 240, terminal_dep: 'T2', terminal_arr: 'T1' },\n   293→      { origin: 'ORD', dest: 'JFK', dep: '2026-04-01 21:30', arr: '2026-04-02 00:00', dur: 150, terminal_dep: 'T2', terminal_arr: 'T5' }\n   294→    ])\n   295→\n   296→  // LAX-LHR\n   297→  await createFlight('BA', 'BA500', 'LAX', 'LHR', '2026-04-01 20:00', '2026-04-02 14:30', 630, 'Boeing 777-300ER', true, true, true, 380, 649)\n   298→  await createFlight('AA', 'AA800', 'LAX', 'LHR', '2026-04-01 18:00', '2026-04-02 12:30', 630, 'Boeing 787-9', true, true, true, 370, 599)\n   299→\n   300→  // Create a session for seed data\n   301→  await sql`INSERT INTO sessions (session_token) VALUES ('seed-session-token')`\n   302→  const sessionRows = await sql`SELECT id FROM sessions WHERE session_token = 'seed-session-token'`\n   303→  const sessionRow = sessionRows[0]\n   304→  if (!sessionRow) return\n   305→  const sessionId = sessionRow.id as string\n   306→\n   307→  // Recent searches\n   308→  const laxId = airportMap.get('LAX')!\n   309→  const jfkId = airportMap.get('JFK')!\n   310→  const sfoId = airportMap.get('SFO')!\n   311→  const ordId = airportMap.get('ORD')!\n   312→  const lhrId = airportMap.get('LHR')!\n   313→\n   314→  await sql`INSERT INTO recent_searches (session_id, origin_airport_id, destination_airport_id, departure_date, return_date, passengers_adults, cabin_class, trip_type)\n   315→    VALUES (${sessionId}, ${laxId}, ${jfkId}, '2026-04-01', '2026-04-08', 1, 'economy', 'round_trip')`\n   316→  await sql`INSERT INTO recent_searches (session_id, origin_airport_id, destination_airport_id, departure_date, return_date, passengers_adults, cabin_class, trip_type)\n   317→    VALUES (${sessionId}, ${sfoId}, ${ordId}, '2026-04-05', '2026-04-10', 2, 'business', 'round_trip')`\n   318→\n   319→  // Sample bookings\n   320→  const flightForBooking = await sql`SELECT id FROM flights WHERE flight_number = '