→      searched_at TIMESTAMP DEFAULT now()\n    99→    )\n   100→  `\n   101→\n   102→  await sql`\n   103→    CREATE TABLE IF NOT EXISTS bookings (\n   104→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n   105→      session_id UUID REFERENCES sessions(id) ON DELETE CASCADE,\n   106→      flight_id UUID REFERENCES flights(id),\n   107→      return_flight_id UUID REFERENCES flights(id),\n   108→      booking_reference TEXT UNIQUE NOT NULL,\n   109→      cabin_class TEXT NOT NULL,\n   110→      total_price_cents INTEGER NOT NULL,\n   111→      status TEXT DEFAULT 'confirmed',\n   112→      created_at TIMESTAMP DEFAULT now()\n   113→    )\n   114→  `\n   115→\n   116→  await sql`\n   117→    CREATE TABLE IF NOT EXISTS booking_passengers (\n   118→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n   119→      booking_id UUID REFERENCES bookings(id) ON DELETE CASCADE,\n   120→      first_name TEXT NOT NULL,\n   121→      last_name TEXT NOT NULL,\n   122→      date_of_birth DATE,\n   123→      gender TEXT,\n   124→      email TEXT,\n   125→      phone TEXT,\n   126→      passenger_type TEXT DEFAULT 'adult'\n   127→    )\n   128→  `\n   129→\n   130→  await sql`\n   131→    CREATE TABLE IF NOT EXISTS tracked_routes (\n   132→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n   133→      session_id UUID REFERENCES sessions(id) ON DELETE CASCADE,\n   134→      origin_airport_id UUID REFERENCES airports(id),\n   135→      destination_airport_id UUID REFERENCES airports(id),\n   136→      departure_date_start DATE,\n   137→      departure_date_end DATE,\n   138→      cabin_class TEXT DEFAULT 'economy',\n   139→      created_at TIMESTAMP DEFAULT now()\n   140→    )\n   141→  `\n   142→\n   143→  // Indices\n   144→  await sql`CREATE INDEX IF NOT EXISTS idx_flights_origin ON flights(origin_airport_id)`\n   145→  await sql`CREATE INDEX IF NOT EXISTS idx_flights_destination ON flights(destination_airport_id)`\n   146→  await sql`CREATE INDEX IF NOT EXISTS idx_flights_departure ON flights(departure_time)`\n   147→  await sql`CREATE INDEX IF NOT EXISTS idx_prices_flight ON prices(flight_id)`\n   148→  await sql`CREATE INDEX IF NOT EXISTS idx_prices_cabin ON prices(cabin_class)`\n   149→  await sql`CREATE INDEX IF NOT EXISTS idx_recent_searches_session ON recent_searches(session_id)`\n   150→  await sql`CREATE INDEX IF NOT EXISTS idx_bookings_session ON bookings(session_id)`\n   151→  await sql`CREATE INDEX IF NOT EXISTS idx_airports_iata ON airports(iata_code)`\n   152→}\n   153→\n   154→// CLI entry point\n   155→if (process.argv[1] && import.meta.url.endsWith(process.argv[1].replace(/\\\\/g, '/'))) {\n   156→  const dbUrl = process.argv[2]\n   157→  if (!dbUrl) {\n   158→    console.error('Usage: tsx scripts/schema.ts <DATABASE_URL>')\n   159→    process.exit(1)\n   160→  }\n   161→  initSchema(dbUrl).then(() => console.log('Schema initialized')).catch(e => { console.error(e); process.exit(1) })\n   162→}\n   163→"}]},"parent_tool_use_id":"toolu_01M3ybkFoCmrLTMTzjerra5d","session_id":"925af744-7620-41be-a460-52cba7367495","uuid":"eb810342-0cbb-4851-848f-8cb1ee63f974"}
