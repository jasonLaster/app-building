[2026-03-14T20:09:28.043Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BubDhYybHW6XXGxc98pKo2","type":"tool_result","content":"     1→import { createSlice, createAsyncThunk, type PayloadAction } from '@reduxjs/toolkit'\n     2→\n     3→export interface FlightResult {\n     4→  id: string\n     5→  flight_number: string\n     6→  departure_time: string\n     7→  arrival_time: string\n     8→  duration_minutes: number\n     9→  aircraft_type: string\n    10→  has_wifi: boolean\n    11→  has_power: boolean\n    12→  has_entertainment: boolean\n    13→  co2_kg: number\n    14→  airline_name: string\n    15→  airline_code: string\n    16→  logo_color: string\n    17→  origin_code: string\n    18→  origin_name: string\n    19→  origin_city: string\n    20→  dest_code: string\n    21→  dest_name: string\n    22→  dest_city: string\n    23→  total_price_cents: number\n    24→  base_price_cents: number\n    25→  taxes_cents: number\n    26→  cabin_class: string\n    27→  available_seats: number\n    28→  num_legs: number\n    29→  layover_codes: string\n    30→}\n    31→\n    32→export interface FlightLeg {\n    33→  id: string\n    34→  leg_order: number\n    35→  departure_time: string\n    36→  arrival_time: string\n    37→  duration_minutes: number\n    38→  flight_number: string\n    39→  aircraft_type: string\n    40→  terminal_departure: string | null\n    41→  terminal_arrival: string | null\n    42→  origin_code: string\n    43→  origin_name: string\n    44→  origin_city: string\n    45→  dest_code: string\n    46→  dest_name: string\n    47→  dest_city: string\n    48→  airline_name: string | null\n    49→  airline_code: string | null\n    50→}\n    51→\n    52→export type SortOption = 'best' | 'price' | 'duration' | 'departure' | 'arrival'\n    53→\n    54→export interface StopsFilter {\n    55→  nonstop: boolean\n    56→  oneStop: boolean\n    57→  twoPlusStops: boolean\n    58→}\n    59→\n    60→export interface TimeFilter {\n    61→  morning: boolean   // 6:00 - 12:00\n    62→  afternoon: boolean // 12:00 - 18:00\n    63→  evening: boolean   // 18:00 - 24:00\n    64→  night: boolean     // 0:00 - 6:00\n    65→}\n    66→\n    67→interface FlightsState {\n    68→  flights: FlightResult[]\n    69→  loading: boolean\n    70→  total: number\n    71→  page: number\n    72→  totalPages: number\n    73→  loadingMore: boolean\n    74→  sortBy: SortOption\n    75→  stopsFilter: StopsFilter\n    76→  airlinesFilter: string[]\n    77→  priceRange: [number, number]\n    78→  priceRangeMax: [number, number]\n    79→  durationRange: [number, number]\n    80→  durationRangeMax: [number, number]\n    81→  departureTimeFilter: TimeFilter\n    82→  arrivalTimeFilter: TimeFilter\n    83→  expandedLegs: Record<string, FlightLeg[]>\n    84→  expandedLegsLoading: Record<string, boolean>\n    85→  isTracked: boolean\n    86→  isTrackedLoading: boolean\n    87→}\n    88→\n    89→const initialState: FlightsState = {\n    90→  flights: [],\n    91→  loading: false,\n    92→  total: 0,\n    93→  page: 1,\n    94→  totalPages: 0,\n    95→  loadingMore: false,\n    96→  sortBy: 'best',\n    97→  stopsFilter: { nonstop: false, oneStop: false, twoPlusStops: false },\n    98→  airlinesFilter: [],\n    99→  priceRange: [0, 10000],\n   100→  priceRangeMax: [0, 10000],\n   101→  durationRange: [0, 2880],\n   102→  durationRangeMax: [0, 2880],\n   103→  departureTimeFilter: { morning: false, afternoon: false, evening: false, night: false },\n   104→  arrivalTimeFilter: { morning: false, afternoon: false, evening: false, night: false },\n   105→  expandedLegs: {},\n   106→  expandedLegsLoading: {},\n   107→  isTracked: false,\n   108→  isTrackedLoading: false,\n   109→}\n   110→\n   111→export const searchFlights = createAsyncThunk(\n   112→  'flights/searchFlights',\n   113→  async (params: {\n   114→    origin: string\n   115→    destination: string\n   116→    departureDate: string\n   117→    cabinClass: string\n   118→    page?: number\n   119→  }) => {\n   120→    const qs = new URLSearchParams({\n   121→      origin: params.origin,\n   122→      destination: params.destination,\n   123→      departureDate: params.departureDate,\n   124→      cabinClass: params.cabinClass,\n   125→      page: String(params.page || 1),\n   126→    })\n   127→    const res = await fetch(`/api/search-flights?${qs}`)\n   128→    return res.json() as Promise<{\n   129→      flights: FlightResult[]\n   130→      total: number\n   131→      page: number\n   132→      totalPages: number\n   133→    }>\n   134→  }\n   135→)\n   136→\n   137→export const loadMoreFlights = createAsyncThunk(\n   138→  'flights/loadMoreFlights',\n   139→  async (params: {\n   140→    origin: string\n   141→    destination: string\n   142→    departureDate: string\n   143→    cabinClass: string\n   144→    page: number\n   145→  }) => {\n   146→    const qs = new URLSearchParams({\n   147→      origin: params.origin,\n   148→      destination: params.destination,\n   149→      departureDate: params.departureDate,\n   150→      cabinClass: params.cabinClass,\n   151→      page: String(params.page),\n   152→    })\n   153→    const res = await fetch(`/api/search-flights?${qs}`)\n   154→    return res.json() as Promise<{\n   155→      flights: FlightResult[]\n   156→      total: number\n   157→      page: number\n   158→      totalPages: number\n   159→    }>\n   160→  }\n   161→)\n   162→\n   163→export const fetchFlightLegs = createAsyncThunk(\n   164→  'flights/fetchFlightLegs',\n   165→  async (flightId: string) => {\n   166→    const res = await fetch(`/api/flight-legs?flightId=${encodeURIComponent(flightId)}`)\n   167→    const legs = await res.json() as FlightLeg[]\n   168→    return { flightId, legs }\n   169→  }\n   170→)\n   171→\n   172→export const checkTrackedRoute = createAsyncThunk(\n   173→  'flights/checkTrackedRoute',\n   174→  async (params: { sessionToken: string; origin: string; destination: string }) => {\n   175→    const qs = new URLSearchParams({\n   176→      session: params.sessionToken,\n   177→      origin: params.origin,\n   178→      destination: params.destination,\n   179→    })\n   180→    const res = await fetch(`/api/tracked-routes?${qs}`)\n   181→    const data = await res.json() as { tracked: boolean }\n   182→    return data.tracked\n   183→  }\n   184→)\n   185→\n   186→export const toggleTrackRoute = createAsyncThunk(\n   187→  'flights/toggleTrackRoute',\n   188→  async (params: {\n   189→    sessionToken: string\n   190→    originCode: string\n   191→    destCode: string\n   192→    departureDateStart?: string\n   193→    departureDateEnd?: string\n   194→    cabinClass?: string\n   195→    isCurrentlyTracked: boolean\n   196→  }) => {\n   197→    if (params.isCurrentlyTracked) {\n   198→      await fetch('/api/tracked-routes', {\n   199→        method: 'DELETE',\n   200→        headers: { 'Content-Type': 'application/json' },\n   201→        body: JSON.stringify({\n   202→          sessionToken: params.sessionToken,\n   203→          originCode: params.originCode,\n   204→          destCode: params.destCode,\n   205→        }),\n   206→      })\n   207→      return false\n   208→    } else {\n   209→      await fetch('/api/tracked-routes', {\n   210→        method: 'POST',\n   211→        headers: { 'Content-Type': 'application/json' },\n   212→        body: JSON.stringify({\n   213→          sessionToken: params.sessionToken,\n   214→          originCode: params.originCode,\n   215→          destCode: params.destCode,\n   216→          departureDateStart: params.departureDateStart,\n   217→          departureDateEnd: params.departureDateEnd,\n   218→          cabinClass: params.cabinClass,\n   219→        }),\n   220→      })\n   221→      return true\n   222→    }\n   223→  }\n   224→)\n   225→\n   226→const flightsSlice = createSlice({\n   227→  name: 'flights',\n   228→  initialState,\n   229→  reducers: {\n   230→    setSortBy(state, action: PayloadAction<SortOption>) {\n   231→      state.sortBy = action.payload\n   232→    },\n   233→    setStopsFilter(state, action: PayloadAction<StopsFilter>) {\n   234→      state.stopsFilter = action.payload\n   235→    },\n   236→    setAirlinesFilter(state, action: PayloadAction<string[]>) {\n   237→      state.airlinesFilter = action.payload\n   238→    },\n   239→    setPriceRange(state, action: PayloadAction<[number, number]>) {\n   240→      state.priceRange = action.payload\n   241→    },\n   242→    setDurationRange(state, action: PayloadAction<[number, number]>) {\n   243→      state.durationRange = action.payload\n   244→    },\n   245→    setDepartureTimeFilter(state, action: PayloadAction<TimeFilter>) {\n   246→      state.departureTimeFilter = action.payload\n   247→    },\n   248→    setArrivalTimeFilter(state, action: PayloadAction<TimeFilter>) {\n   249→      state.arrivalTimeFilter = action.payload\n   250→    },\n   251→    resetFilters(state) {\n   252→      state.stopsFilter = { nonstop: false, oneStop: false, twoPlusStops: false }\n   253→      state.airlinesFilter = []\n   254→      state.priceRange = state.priceRangeMax\n   255→      state.durationRange = state.durationRangeMax\n   256→      state.departureTimeFilter = { morning: false, afternoon: false, evening: false, night: false }\n   257→      state.arrivalTimeFilter = { morning: false, afternoon: false, evening: false, night: false }\n   258→      state.sortBy = 'best'\n   259→    },\n   260→  },\n   261→  extraReducers: (builder) => {\n   262→    builder\n   263→      .addCase(searchFlights.pending, (state) => {\n   264→        state.loading = true\n   265→        state.flights = []\n   266→        state.expandedLegs = {}\n   267→        state.expandedLegsLoading = {}\n   268→      })\n   269→      .addCase(searchFlights.fulfilled, (state, action) => {\n   270→        state.flights = action.payload.flights\n   271→        state.total = action.payload.total\n   272→        state.page = action.payload.page\n   273→        state.totalPages = action.payload.totalPages\n   274→        state.loading = false\n   275→\n   276→        // Calculate price and duration ranges\n   277→        if (action.payload.flights.length > 0) {\n   278→          const prices = action.payload.flights.map(f => f.total_price_cents)\n   279→          const durations = action.payload.flights.map(f => f.duration_minutes)\n   280→          const minPrice = Math.min(...prices)\n   281→          const maxPrice = Math.max(...prices)\n   282→          const minDuration = Math.min(...durations)\n   283→          const maxDuration = Math.max(...durations)\n   284→          state.priceRange = [minPrice, maxPrice]\n   285→          state.priceRangeMax = [minPrice, maxPrice]\n   286→          state.durationRange = [minDuration, maxDuration]\n   287→          state.durationRangeMax = [minDuration, maxDuration]\n   288→        }\n   289→\n   290→        // Reset filters on new search\n   291→        state.stopsFilter = { nonstop: false, oneStop: false, twoPlusStops: false }\n   292→        state.airlinesFilter = []\n   293→        state.departureTimeFilter = { morning: false, afternoon: false, evening: false, night: false }\n   294→        state.arrivalTimeFilter = { morning: false, afternoon: false, evening: false, night: false }\n   295→        state.sortBy = 'best'\n   296→      })\n   297→      .addCase(searchFlights.rejected, (state) => {\n   298→        state.loading = false\n   299→      })\n   300→      .addCase(loadMoreFlights.pending, (state) => {\n   301→        state.loadingMore = true\n   302→      })\n   303→      .addCase(loadMoreFlights.fulfilled, (state, action) => {\n   304→        state.flights = [...state.flights, ...action.payload.flights]\n   305→        state.page = action.payload.page\n   306→        state.totalPages = action.payload.totalPages\n   307→        state.total = action.payload.total\n   308→        state.loadingMore = false\n   309→\n   310→        // Update ranges with new data\n   311→        if (state.flights.length > 0) {\n   312→          const prices = state.flights.map(f => f.total_price_cents)\n   313→          const durations = state.flights.map(f => f.duration_minutes)\n   314→          state.priceRangeMax = [Math.min(...prices), Math.max(...prices)]\n   315→          state.durationRangeMax = [Math.min(...durations), Math.max(...durations)]\n   316→        }\n   317→      })\n   318→      .addCase(loadMoreFlights.rejected, (state) => {\n   319→        state.loadingMore = false\n   320→      })\n   321→      .addCase(fetchFlightLegs.pending, (state, action) => {\n   322→        state.expandedLegsLoading[action.meta.arg] = true\n   323→      })\n   324→      .addCase(fetchFlightLegs.fulfilled, (state, action) => {\n   325→        state.expandedLegs[action.payload.flightId] = action.payload.legs\n   326→        state.expandedLegsLoading[action.payload.flightId] = false\n   327→      })\n   328→      .addCase(fetchFlightLegs.rejected, (state, action) => {\n   329→        state.expandedLegsLoading[action.meta.arg] = false\n   330→      })\n   331→      .addCase(checkTrackedRoute.pending, (state) => {\n   332→        state.isTrackedLoading = true\n   333→      })\n   334→      .addCase(checkTrackedRoute.fulfilled, (state, action) => {\n   335→        state.isTracked = action.payload\n   336→        state.isTrackedLoading = false\n   337→      })\n   338→      .addCase(checkTrackedRoute.rejected, (state) => {\n   339→        state.isTrackedLoading = false\n   340→      })\n   341→      .addCase(toggleTrackRoute.fulfilled, (state, action) => {\n   342→        state.isTracked = action.payload\n   343→      })\n   344→  },\n   345→})\n   346→\n   347→export const {\n   348→  setSortBy,\n   349→  setStopsFilter,\n   350→  setAirlinesFilter,\n   351→  setPriceRange,\n   352→  setDurationRange,\n   353→  setDepartureTimeFilter,\n   354→  setArrivalTimeFilter,\n   355→  resetFilters,\n   356→} = flightsSlice.actions\n   357→\n   358→export default flightsSlice.reducer\n   359→"}]},"parent_tool_use_id":"toolu_01MihUNhDMxcNMGTt8mYGe1e","session_id":"925af744-7620-41be-a460-52cba7367495","uuid":"efa44688-8f8c-4339-ab51-efa8de734891"}
