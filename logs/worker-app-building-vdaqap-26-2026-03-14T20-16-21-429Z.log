e\">\n    38→        <div className=\"flight-details-page__loading\" data-testid=\"flight-details-loading\">\n    39→          <div className=\"flight-details-page__loading-spinner\" />\n    40→          <span>Loading flight details...</span>\n    41→        </div>\n    42→      </div>\n    43→    )\n    44→  }\n    45→\n    46→  if (error || !flight) {\n    47→    return (\n    48→      <div className=\"flight-details-page p-6 max-sm:p-3\" data-testid=\"flight-details-page\">\n    49→        <div className=\"flight-details-page__error\" data-testid=\"flight-details-error\">\n    50→          <h2>Flight not found</h2>\n    51→          <p>{error || 'Unable to load flight details.'}</p>\n    52→          <button\n    53→            className=\"flight-details-page__back-button\"\n    54→            onClick={() => navigate(-1)}\n    55→            data-testid=\"flight-details-back\"\n    56→          >\n    57→            ← Back to results\n    58→          </button>\n    59→        </div>\n    60→      </div>\n    61→    )\n    62→  }\n    63→\n    64→  // Calculate total price for BookingAction\n    65→  const adultBaseFare = flight.base_price_cents\n    66→  const childBaseFare = Math.round(flight.base_price_cents * 0.75)\n    67→  const infantBaseFare = Math.round(flight.base_price_cents * 0.1)\n    68→  const totalTaxes = flight.taxes_cents * (adults + children)\n    69→  const totalPriceCents =\n    70→    adultBaseFare * adults +\n    71→    childBaseFare * children +\n    72→    infantBaseFare * infants +\n    73→    totalTaxes\n    74→\n    75→  return (\n    76→    <div className=\"flight-details-page p-6 max-sm:p-3\" data-testid=\"flight-details-page\">\n    77→      <div className=\"flight-details-page__header\">\n    78→        <button\n    79→          className=\"flight-details-page__back-link\"\n    80→          onClick={() => navigate(-1)}\n    81→          data-testid=\"flight-details-back\"\n    82→        >\n    83→          ← Back to results\n    84→        </button>\n    85→        <h1 className=\"flight-details-page__title\">Flight Details & Booking</h1>\n    86→      </div>\n    87→\n    88→      <div className=\"flight-details-page__content\">\n    89→        <div className=\"flight-details-page__main\">\n    90→          <div className=\"flight-details-page__section\">\n    91→            <FlightSummary\n    92→              flight={flight}\n    93→              legs={legs}\n    94→              label={`Outbound · ${flight.origin_code} → ${flight.dest_code}`}\n    95→            />\n    96→          </div>\n    97→\n    98→          <div className=\"flight-details-page__section\">\n    99→            <PassengerForm />\n   100→          </div>\n   101→        </div>\n   102→\n   103→        <div className=\"flight-details-page__sidebar\">\n   104→          <div className=\"flight-details-page__section\">\n   105→            <PriceBreakdown\n   106→              flight={flight}\n   107→              passengers={{ adults, children, infants }}\n   108→            />\n   109→          </div>\n   110→\n   111→          <div className=\"flight-details-page__section\">\n   112→            <BookingAction\n   113→              flightId={flight.id}\n   114→              cabinClass={cabinClass}\n   115→              totalPriceCents={totalPriceCents}\n   116→            />\n   117→          </div>\n   118→\n   119→          {bookingComplete && (\n   120→            <button\n   121→              className=\"flight-details-page__trips-link\"\n   122→              onClick={() => navigate('/trips')}\n   123→              data-testid=\"view-trips-button\"\n   124→            >\n   125→              View My Trips\n   126→            </button>\n   127→          )}\n   128→        </div>\n   129→      </div>\n   130→    </div>\n   131→  )\n   132→}\n   133→\n   134→export default FlightDetailsPage\n   135→"}]},"parent_tool_use_id":null,"session_id":"925af744-7620-41be-a460-52cba7367495","uuid":"3bc9bac7-a4e0-4072-8412-69b84f1e6681","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/GoogleFlights/src/pages/FlightDetailsPage.tsx","content":"import { useEffect } from 'react'\nimport { useParams, useSearchParams, useNavigate } from 'react-router-dom'\nimport { useSelector, useDispatch } from 'react-redux'\nimport type { RootState, AppDispatch } from '../store'\nimport { fetchFlightForBooking, initializePassengers, resetBooking } from '../slices/bookingSlice'\nimport FlightSummary from '../components/FlightSummary'\nimport PriceBreakdown from '../components/PriceBreakdown'\nimport PassengerForm from '../components/PassengerForm'\nimport BookingAction from '../components/BookingAction'\nimport './FlightDetailsPage.css'\n\nfunction FlightDetailsPage() {\n  const { id } = useParams<{ id: string }>()\n  const [searchParams] = useSearchParams()\n  const navigate = useNavigate()\n  const dispatch = useDispatch<AppDispatch>()\n\n  const cabinClass = searchParams.get('cabin') || 'economy'\n  const adults = parseInt(searchParams.get('adults') || '1', 10)\n  const children = parseInt(searchParams.get('children') || '0', 10)\n  const infants = parseInt(searchParams.get('infants') || '0', 10)\n\n  const { flight, legs, loading, error, bookingComplete } = useSelector(\n    (state: RootState) => state.booking\n  )\n\n  useEffect(() => {\n    if (id) {\n      dispatch(resetBooking())\n      dispatch(fetchFlightForBooking({ flightId: id, cabinClass }))\n      dispatch(initializePassengers({ adults, children, infants }))\n    }\n  }, [id, cabinClass, adults, children, infants, dispatch])\n\n  if (loading) {\n    return (\n      <div className=\"flight-details-page p-6 max-sm:p-3\" data-testid=\"flight-details-page\">\n        <div className=\"flight-details-page__loading\" data-testid=\"flight-details-loading\">\n          <div className=\"flight-details-page__loading-spinner\" />\n          <span>Loading flight details...</span>\n        </div>\n      </div>\n    )\n  }\n\n  if (error || !flight) {\n    return (\n      <div className=\"flight-details-page p-6 max-sm:p-3\" data-testid=\"flight-details-page\">\n        <div className=\"flight-details-page__error\" data-testid=\"flight-details-error\">\n          <h2>Flight not found</h2>\n          <p>{error || 'Unable to load flight details.'}</p>\n          <button\n            className=\"flight-details-page__back-button\"\n            onClick={() => navigate(-1)}\n            data-testid=\"flight-details-back\"\n          >\n            ← Back to results\n          </button>\n        </div>\n      </div>\n    )\n  }\n\n  // Calculate total price for BookingAction\n  const adultBaseFare = flight.base_price_cents\n  const childBaseFare = Math.round(flight.base_price_cents * 0.75)\n  const infantBaseFare = Math.round(flight.base_price_cents * 0.1)\n  const totalTaxes = flight.taxes_cents * (adults + children)\n  const totalPriceCents =\n    adultBaseFare * adults +\n    childBaseFare * children +\n    infantBaseFare * infants +\n    totalTaxes\n\n  return (\n    <div className=\"flight-details-page p-6 max-sm:p-3\" data-testid=\"flight-details-page\">\n      <div className=\"flight-details-page__header\">\n        <button\n          className=\"flight-details-page__back-link\"\n          onClick={() => navigate(-1)}\n          data-testid=\"flight-details-back\"\n        >\n          ← Back to results\n        </button>\n        <h1 className=\"flight-details-page__title\">Flight Details & Booking</h1>\n      </div>\n\n      <div className=\"flight-details-page__content\">\n        <div className=\"flight-details-page__main\">\n          <div className=\"flight-details-page__section\">\n            <FlightSummary\n              flight={flight}\n              legs={legs}\n              label={`Outbound · ${flight.origin_code} → ${flight.dest_code}`}\n            />\n          </div>\n\n          <div className=\"flight-details-page__section\">\n            <PassengerForm />\n          </div>\n        </div>\n\n        <div className=\"flight-details-page__sidebar\">\n          <div className=\"flight-details-page__section\">\n            <PriceBreakdown\n              flight={flight}\n              passengers={{ adults, children, infants }}\n            />\n          </div>\n\n          <div className=\"flight-details-page__section\">\n            <BookingAction\n              flightId={flight.id}\n              cabinClass={cabinClass}\n              totalPriceCents={totalPriceCents}\n            />\n          </div>\n\n          {bookingComplete && (\n            <button\n              className=\"flight-details-page__trips-link\"\n              onClick={() => navigate('/trips')}\n              data-testid=\"view-trips-button\"\n            >\n              View My Trips\n            </button>\n          )}\n        </div>\n      </div>\n    </div>\n  )\n}\n\nexport default FlightDetailsPage\n","numLines":135,"startLine":1,"totalLines":135}}}
