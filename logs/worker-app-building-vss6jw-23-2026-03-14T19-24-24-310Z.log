x gap-3 justify-end\">\n          <button\n            data-testid=\"cancel-dialog-dismiss\"\n            onClick={onDismiss}\n            className=\"px-4 py-2 text-sm font-medium rounded-lg border border-border text-text hover:bg-bg-secondary transition-colors\"\n          >\n            Keep Booking\n          </button>\n          <button\n            data-testid=\"cancel-dialog-confirm\"\n            onClick={onConfirm}\n            className=\"px-4 py-2 text-sm font-medium rounded-lg bg-status-cancelled text-white hover:bg-status-cancelled/90 transition-colors\"\n          >\n            Yes, Cancel\n          </button>\n        </div>\n      </div>\n    </div>\n  )\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":350,"cache_read_input_tokens":49795,"cache_creation":{"ephemeral_5m_input_tokens":350,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"global"},"context_management":null},"parent_tool_use_id":null,"session_id":"4df6dc85-d756-49bf-87d9-904605d680a8","uuid":"789e3b13-b9d4-48c7-804a-a174a5cf4b1a"}
