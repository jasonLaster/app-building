[2026-03-14T19:19:44.758Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XUyYeAPDtyGZ9XmxSdSTK3","type":"tool_result","content":"     1→import { useState } from 'react'\n     2→import { Star } from 'lucide-react'\n     3→import type { Review } from '../slices/propertiesSlice'\n     4→\n     5→interface ReviewsSectionProps {\n     6→  reviews: Review[]\n     7→}\n     8→\n     9→const INITIAL_SHOW = 6\n    10→\n    11→const CATEGORIES: { key: keyof Review; label: string }[] = [\n    12→  { key: 'cleanliness', label: 'Cleanliness' },\n    13→  { key: 'accuracy', label: 'Accuracy' },\n    14→  { key: 'communication', label: 'Communication' },\n    15→  { key: 'location', label: 'Location' },\n    16→  { key: 'value', label: 'Value' },\n    17→]\n    18→\n    19→function formatDate(dateStr: string): string {\n    20→  const date = new Date(dateStr)\n    21→  return date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })\n    22→}\n    23→\n    24→function avgRating(reviews: Review[], key: keyof Review): number {\n    25→  const sum = reviews.reduce((acc, r) => acc + Number(r[key]), 0)\n    26→  return sum / reviews.length\n    27→}\n    28→\n    29→export default function ReviewsSection({ reviews }: ReviewsSectionProps) {\n    30→  const [showAll, setShowAll] = useState(false)\n    31→\n    32→  if (reviews.length === 0) {\n    33→    return (\n    34→      <div id=\"reviews-section\" data-testid=\"reviews-section\" className=\"py-6 border-b border-border\">\n    35→        <h2 className=\"text-lg font-semibold text-text mb-3\">Reviews</h2>\n    36→        <p className=\"text-text-secondary\">No reviews yet</p>\n    37→      </div>\n    38→    )\n    39→  }\n    40→\n    41→  const overallAvg = reviews.reduce((acc, r) => acc + Number(r.rating), 0) / reviews.length\n    42→  const displayReviews = showAll ? reviews : reviews.slice(0, INITIAL_SHOW)\n    43→\n    44→  return (\n    45→    <div id=\"reviews-section\" data-testid=\"reviews-section\" className=\"py-6 border-b border-border\">\n    46→      <div className=\"flex items-center gap-2 mb-4\">\n    47→        <Star size={20} className=\"fill-text text-text\" />\n    48→        <h2 className=\"text-lg font-semibold text-text\">\n    49→          {overallAvg.toFixed(1)} · {reviews.length} {reviews.length === 1 ? 'review' : 'reviews'}\n    50→        </h2>\n    51→      </div>\n    52→\n    53→      <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-x-8 gap-y-3 mb-6\">\n    54→        {CATEGORIES.map(({ key, label }) => {\n    55→          const avg = avgRating(reviews, key)\n    56→          return (\n    57→            <div key={key} data-testid={`rating-category-${key}`} className=\"flex items-center justify-between text-sm\">\n    58→              <span className=\"text-text-secondary\">{label}</span>\n    59→              <div className=\"flex items-center gap-1\">\n    60→                <div className=\"w-24 h-1 bg-bg-secondary rounded-full overflow-hidden\">\n    61→                  <div\n    62→                    className=\"h-full bg-text rounded-full\"\n    63→                    style={{ width: `${(avg / 5) * 100}%` }}\n    64→                  />\n    65→                </div>\n    66→                <span className=\"font-medium text-text text-xs w-6 text-right\">{avg.toFixed(1)}</span>\n    67→              </div>\n    68→            </div>\n    69→          )\n    70→        })}\n    71→      </div>\n    72→\n    73→      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n    74→        {displayReviews.map((review) => (\n    75→          <div key={review.id} data-testid={`review-card-${review.id}`} className=\"space-y-2\">\n    76→            <div className=\"flex items-center gap-3\">\n    77→              {review.guest_avatar ? (\n    78→                <img\n    79→                  src={review.guest_avatar}\n    80→                  alt={review.guest_name}\n    81→                  className=\"w-10 h-10 rounded-full object-cover\"\n    82→                />\n    83→              ) : (\n    84→                <div className=\"w-10 h-10 rounded-full bg-bg-secondary flex items-center justify-center text-sm font-semibold text-text-secondary\">\n    85→                  {review.guest_name.charAt(0)}\n    86→                </div>\n    87→              )}\n    88→              <div>\n    89→                <p className=\"font-medium text-text text-sm\">{review.guest_name}</p>\n    90→                <p className=\"text-text-secondary text-xs\">{formatDate(review.created_at)}</p>\n    91→              </div>\n    92→            </div>\n    93→            <div className=\"flex items-center gap-0.5\">\n    94→              {Array.from({ length: 5 }, (_, i) => (\n    95→                <Star\n    96→                  key={i}\n    97→                  size={12}\n    98→                  className={i < Number(review.rating) ? 'fill-text text-text' : 'text-border'}\n    99→                />\n   100→              ))}\n   101→            </div>\n   102→            {review.comment && (\n   103→              <p className=\"text-text-secondary text-sm leading-relaxed\">{review.comment}</p>\n   104→            )}\n   105→          </div>\n   106→        ))}\n   107→      </div>\n   108→\n   109→      {reviews.length > INITIAL_SHOW && (\n   110→        <button\n   111→          data-testid=\"reviews-toggle\"\n   112→          className=\"mt-6 font-semibold text-text underline cursor-pointer\"\n   113→          onClick={() => setShowAll(!showAll)}\n   114→        >\n   115→          {showAll ? 'Show less' : `Show all ${reviews.length} reviews`}\n   116→        </button>\n   117→      )}\n   118→    </div>\n   119→  )\n   120→}\n   121→"}]},"parent_tool_use_id":"toolu_01VqjKEakr2SHkrarXGXoNqr","session_id":"4df6dc85-d756-49bf-87d9-904605d680a8","uuid":"1faa3c44-86ea-4bca-8064-af3bee1a4169"}
