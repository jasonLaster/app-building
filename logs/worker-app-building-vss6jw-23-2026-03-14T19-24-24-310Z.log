?: number\n    67→  images?: PropertyImage[]\n    68→  amenities?: Amenity[]\n    69→  reviews?: Review[]\n    70→}\n    71→\n    72→export interface SearchFilters {\n    73→  city: string\n    74→  checkIn: string\n    75→  checkOut: string\n    76→  guests: number\n    77→  propertyType: string\n    78→  minPrice: number\n    79→  maxPrice: number\n    80→  minBedrooms: number\n    81→  minBeds: number\n    82→  minBathrooms: number\n    83→  amenityIds: string[]\n    84→  page: number\n    85→}\n    86→\n    87→interface PropertiesState {\n    88→  items: Property[]\n    89→  total: number\n    90→  totalPages: number\n    91→  page: number\n    92→  loading: boolean\n    93→  error: string | null\n    94→  filters: SearchFilters\n    95→}\n    96→\n    97→const initialFilters: SearchFilters = {\n    98→  city: '',\n    99→  checkIn: '',\n   100→  checkOut: '',\n   101→  guests: 0,\n   102→  propertyType: '',\n   103→  minPrice: 0,\n   104→  maxPrice: 0,\n   105→  minBedrooms: 0,\n   106→  minBeds: 0,\n   107→  minBathrooms: 0,\n   108→  amenityIds: [],\n   109→  page: 1,\n   110→}\n   111→\n   112→const initialState: PropertiesState = {\n   113→  items: [],\n   114→  total: 0,\n   115→  totalPages: 0,\n   116→  page: 1,\n   117→  loading: false,\n   118→  error: null,\n   119→  filters: initialFilters,\n   120→}\n   121→\n   122→export const fetchProperties = createAsyncThunk(\n   123→  'properties/fetchProperties',\n   124→  async (filters: SearchFilters, { rejectWithValue }) => {\n   125→    const params = new URLSearchParams()\n   126→    if (filters.city) params.set('city', filters.city)\n   127→    if (filters.checkIn) params.set('check_in', filters.checkIn)\n   128→    if (filters.checkOut) params.set('check_out', filters.checkOut)\n   129→    if (filters.guests > 0) params.set('guests', String(filters.guests))\n   130→    if (filters.propertyType) params.set('property_type', filters.propertyType)\n   131→    if (filters.minPrice > 0) params.set('min_price