name: 'replay-chromium',\n      use: { ...devices['Desktop Chrome'] },\n    },\n  ],\n  webServer: {\n    command: 'npx netlify dev --port 8888 --functions ./netlify/functions',\n    port: 8888,\n    reuseExistingServer: !process.env.CI,\n    timeout: 30000,\n  },\n})\n","numLines":32,"startLine":1,"totalLines":32}}}
