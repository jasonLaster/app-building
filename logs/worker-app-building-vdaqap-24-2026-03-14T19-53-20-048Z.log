[2026-03-14T19:47:53.392Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018FS2ybxgHSYQ4E2tNFhe6M","type":"tool_result","content":"     1→import { createSlice, createAsyncThunk, type PayloadAction } from '@reduxjs/toolkit'\n     2→import type { FlightLeg } from './flightsSlice'\n     3→\n     4→export interface PassengerInfo {\n     5→  firstName: string\n     6→  lastName: string\n     7→  dateOfBirth: string\n     8→  gender: string\n     9→  email: string\n    10→  phone: string\n    11→  passengerType: 'adult' | 'child' | 'infant'\n    12→}\n    13→\n    14→export interface BookingFlightDetail {\n    15→  id: string\n    16→  flight_number: string\n    17→  departure_time: string\n    18→  arrival_time: string\n    19→  duration_minutes: number\n    20→  aircraft_type: string\n    21→  has_wifi: boolean\n    22→  has_power: boolean\n    23→  has_entertainment: boolean\n    24→  co2_kg: number\n    25→  airline_name: string\n    26→  airline_code: string\n    27→  logo_color: string\n    28→  origin_code: string\n    29→  origin_name: string\n    30→  origin_city: string\n    31→  dest_code: string\n    32→  dest_name: string\n    33→  dest_city: string\n    34→  base_price_cents: number\n    35→  taxes_cents: number\n    36→  total_price_cents: number\n    37→  cabin_class: string\n    38→  available_seats: number\n    39→}\n    40→\n    41→interface BookingState {\n    42→  flight: BookingFlightDetail | null\n    43→  legs: FlightLeg[]\n    44→  loading: boolean\n    45→  error: string | null\n    46→  passengers: PassengerInfo[]\n    47→  validationErrors: Record<string, string>\n    48→  bookingInProgress: boolean\n    49→  bookingComplete: boolean\n    50→  bookingReference: string | null\n    51→  bookingError: string | null\n    52→}\n    53→\n    54→const initialState: BookingState = {\n    55→  flight: null,\n    56→  legs: [],\n    57→  loading: false,\n    58→  error: null,\n    59→  passengers: [],\n    60→  validationErrors: {},\n    61→  bookingInProgress: false,\n    62→  bookingComplete: false,\n    63→  bookingReference: null,\n    64→  bookingError: null,\n    65→}\n    66→\n    67→export const fetchFlightForBooking = createAsyncThunk(\n    68→  'booking/fetchFlightForBooking',\n    69→  async (params: { flightId: string; cabinClass: string }) => {\n    70→    const qs = new URLSearchParams({\n    71→      flightId: params.flightId,\n    72→      cabinClass: params.cabinClass,\n    73→    })\n    74→    const res = await fetch(`/api/bookings?${qs}`)\n    75→    if (!res.ok) {\n    76→      throw new Error('Failed to fetch flight details')\n    77→    }\n    78→    return res.json() as Promise<{ flight: BookingFlightDetail; legs: FlightLeg[] }>\n    79→  }\n    80→)\n    81→\n    82→export const createBooking = createAsyncThunk(\n    83→  'booking/createBooking',\n    84→  async (params: {\n    85→    sessionToken: string\n    86→    flightId: string\n    87→    returnFlightId?: string\n    88→    cabinClass: string\n    89→    totalPriceCents: number\n    90→    passengers: Array<{\n    91→      firstName: string\n    92→      lastName: string\n    93→      dateOfBirth: string\n    94→      gender: string\n    95→      email?: string\n    96→      phone?: string\n    97→      passengerType: string\n    98→    }>\n    99→  }) => {\n   100→    const res = await fetch('/api/bookings', {"}]},"parent_tool_use_id":"toolu_01UjQJdWtrgmqf2iiLsDQ6VY","session_id":"0234547c-0c1f-4430-8e8a-3c47a9bac0f9","uuid":"b6bbefc5-17f7-42e0-9e36-a3f9926d2b36"}
