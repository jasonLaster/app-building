   119→    const qs = new URLSearchParams({\n   120→      origin: params.origin,\n   121→      destination: params.destination,\n   122→      departureDate: params.departureDate,\n   123→      cabinClass: params.cabinClass,\n   124→      page: String(params.page || 1),\n   125→    })\n   126→    const res = await fetch(`/api/search-flights?${qs}`)\n   127→    return res.json() as Promise<{\n   128→      flights: FlightResult[]\n   129→      total: number\n   130→      page: number\n   131→      totalPages: number\n   132→    }>\n   133→  }\n   134→)\n   135→\n   136→export const loadMoreFlights = createAsyncThunk(\n   137→  'flights/loadMoreFlights',\n   138→  async (params: {\n   139→    origin: string\n   140→    destination: string\n   141→    departureDate: string\n   142→    cabinClass: string\n   143→    page: number\n   144→  }) => {\n   145→    const qs = new URLSearchParams({\n   146→      origin: params.origin,\n   147→      destination: params.destination,\n   148→      departureDate: params.departureDate,\n   149→      cabinClass: params.cabinClass,\n   150→      page: String(params.page),\n   151→    })\n   152→    const res = await fetch(`/api/search-flights?${qs}`)\n   153→    return res.json() as Promise<{\n   154→      flights: FlightResult[]\n   155→      total: number\n   156→      page: number\n   157→      totalPages: number\n   158→    }>\n   159→  }\n   160→)\n   161→\n   162→export const fetchFlightLegs = createAsyncThunk(\n   163→  'flights/fetchFlightLegs',\n   164→  async (flightId: string) => {\n   165→    const res = await fetch(`/api/flight-legs?flightId=${encodeURIComponent(flightId)}`)\n   166→    const legs = await res.json() as FlightLeg[]\n   167→    return { flightId, legs }\n   168→  }\n   169→)\n   170→\n   171→export const checkTrackedRoute = createAsyncThunk(\n   172→  'flights/checkTrackedRoute',\n   173→  async (params: { sessionToken: string; origin: string; destination: string }) => {\n   174→    const qs = new URLSearchParams({\n   175→      session: params.sessionToken,\n   176→      origin: params.origin,\n   177→      destination: params.destination,\n   178→    })\n   179→    const res = await fetch(`/api/tracked-routes?${qs}`)\n   180→    const data = await res.json() as { tracked: boolean }\n   181→    return data.tracked\n   182→  }\n   183→)\n   184→\n   185→export const toggleTrackRoute = createAsyncThunk(\n   186→  'flights/toggleTrackRoute',\n   187→  async (params: {\n   188→    sessionToken: string\n   189→    originCode: string\n   190→    destCode: string\n   191→    departureDateStart?: string\n   192→    departureDateEnd?: string\n   193→    cabinClass?: string\n   194→    isCurrentlyTracked: boolean\n   195→  }) => {\n   196→    if (params.isCurrentlyTracked) {\n   197→      await fetch('/api/tracked-routes', {\n   198→        method: 'DELETE',\n   199→        headers: { 'Content-Type': 'application/json' },\n   200→        body: JSON.stringify({\n   201→          sessionToken: params.sessionToken,\n   202→          originCode: params.originCode,\n   203→          destCode: params.destCode,\n   204→        }),\n   205→      })\n   206→      return false\n   207→    } else {\n   208→      await fetch('/api/tracked-routes', {\n   209→        method: 'POST',\n   210→        headers: { 'Content-Type': 'application/json' },\n   211→        body: JSON.stringify({\n   212→          sessionToken: params.sessionToken,\n   213→          originCode: params.originCode,\n   214→          destCode: params.destCode,\n   215→          departureDateStart: params.departureDateStart,\n   216→          departureDateEnd: params.departureDateEnd,\n   217→          cabinClass: params.cabinClass,\n   218→        }),\n   219→      })\n   220→      return true\n   221→    }\n   222→  }\n   223→)\n   224→\n   225→const flightsSlice = createSlice({\n   226→  name: 'flights',\n   227→  initialState,\n   228→  reducers: {\n   229→    setSortBy(state, action: PayloadAction<SortOption>) {\n   230→      state.sortBy = action.payload\n   231→    },\n   232→    setStopsFilter(state, action: PayloadAction<StopsFilter>) {\n   233→      state.stopsFilter = action.payload\n   234→    },\n   235→    setAirlinesFilter(state, action: PayloadAction<string[]>) {\n   236→      state.airlinesFilter = action.payload\n   237→    },\n   238→    setPriceRange(state, action: PayloadAction<[number, number]>) {\n   239→      state.priceRange = action.payload\n   240→    },\n   241→    setDurationRange(state, action: PayloadAction<[number, number]>) {\n   242→      state.durationRange = action.payload\n   243→    },\n   244→    setDepartureTimeFilter(state, action: PayloadAction<TimeFilter>) {\n   245→      state.departureTimeFilter = action.payload\n   246→    },\n   247→    setArrivalTimeFilter(state, action: PayloadAction<TimeFilter>) {\n   248→      state.arrivalTimeFilter = action.payload\n   249→    },\n   250→    resetFilters(state) {\n   251→      state.stopsFilter = { nonstop: false, oneStop: false, twoPlusStops: false }\n   252→      state.airlinesFilter = []\n   253→      state.priceRange = state.priceRangeMax\n   254→      state.durationRange = state.durationRangeMax\n   255→      state.departureTimeFilter = { morning: false, afternoon: false, evening: false, night: false }\n   256→      state.arrivalTimeFilter = { morning: false, afternoon: false, evening: false, night: false }\n   257→      state.sortBy = 'best'\n   258→    },\n   259→  },\n   260→  extraReducers: (builder) => {\n   261→    builder\n   262→      .addCase(searchFlights.pending, (state) => {\n   263→        state.loading = true\n   264→        state.flights = []\n   265→        state.expandedLegs = {}\n   266→        state.expandedLegsLoading = {}\n   267→      })\n   268→      .addCase(searchFlights.fulfilled, (state, action) => {\n   269→        state.flights = action.payload.flights\n   270→        state.total = action.payload.total\n   271→        state.page = action.payload.page\n   272→        state.totalPages = action.payload.totalPages\n   273→        state.loading = false\n   274→\n   275→        // Calculate price and duration ranges\n   276→        if (action.payload.flights.length > 0) {\n   277→          const prices = action.payload.flights.map(f => f.total_price_cents)\n   278→          const durations = action.payload.flights.map(f => f.duration_minutes)\n   279→          const minPrice = Math.min(...prices)\n   280→          const maxPrice = Math.max(...prices)\n   281→          const minDuration = Math.min(...durations)\n   282→          const maxDuration = Math.max(...durations)\n   283→          state.priceRange = [minPrice, maxPrice]\n   284→          state.priceRangeMax = [minPrice, maxPrice]\n   285→          state.durationRange = [minDuration, maxDuration]\n   286→          state.durationRangeMax = [minDuration, maxDuration]\n   287→        }\n   288→\n   289→        // Reset filters on new search\n   290→        state.stopsFilter = { nonstop: false, oneStop: false, twoPlusStops: false }\n   291→        state.airlinesFilter = []\n   292→        state.departureTimeFilter = { morning: false, afternoon: false, evening: false, night: false }\n   293→        state.arrivalTimeFilter = { morning: false, afternoon: false, evening: false, night: false }\n   294→        state.sortBy = 'best'\n   295→      })\n   296→      .addCase(searchFlights.rejected, (state) => {\n   297→        state.loading = false\n   298→      })\n   299→      .addCase(loadMoreFlights.pending, (state) => {\n   300→        state.loadingMore = true\n   301→      })\n   302→      .addCase(loadMoreFlights.fulfilled, (state, action) => {\n   303→        state.flights = [...state.flights, ...action.payload.flights]\n   304→        state.page = action.payload.page\n   305→        state.totalPages = action.payload.totalPages\n   306→        state.total = action.payload.total\n   307→        state.loadingMore = false\n   308→\n   309→        // Update ranges with new data\n   310→        if (state.flights.length > 0) {\n   311→          const prices = state.flights.map(f => f.total_price_cents)\n   312→          const durations = state.flights.map(f => f.duration_minutes)\n   313→          state.priceRangeMax = [Math.min(...prices), Math.max(...prices)]\n   314→          state.durationRangeMax = [Math.min(...durations), Math.max(...durations)]\n   315→        }\n   316→      })\n   317→      .addCase(loadMoreFlights.rejected, (state) => {\n   318→        state.loadingMore = false\n   319→      })\n   320→      .addCase(fetchFlightLegs.pending, (state, action) => {\n   321→        state.expandedLegsLoading[action.meta.arg] = true\n   322→      })\n   323→      .addCase(fetchFlightLegs.fulfilled, (state, action) => {\n   324→        state.expandedLegs[action.payload.flightId] = action.payload.legs\n   325→        state.expandedLegsLoading[action.payload.flightId] = false\n   326→      })\n   327→      .addCase(fetchFlightLegs.rejected, (state, action) => {\n   328→        state.expandedLegsLoading[action.meta.arg] = false\n   329→      })\n   330→      .addCase(checkTrackedRoute.pending, (state) => {\n   331→        state.isTrackedLoading = true\n   332→      })\n   333→      .addCase(checkTrackedRoute.fulfilled, (state, action) => {\n   334→        state.isTracked = action.payload\n   335→        state.isTrackedLoading = false\n   336→      })\n   337→      .addCase(checkTrackedRoute.rejected, (state) => {\n   338→        state.isTrackedLoading = false\n   339→      })\n   340→      .addCase(toggleTrackRoute.fulfilled, (state, action) => {\n   341→        state.isTracked = action.payload\n   342→      })\n   343→  },\n   344→})\n   345→\n   346→export const {\n   347→  setSortBy,\n   348→  setStopsFilter,\n   349→  setAirlinesFilter,\n   350→  setPriceRange,\n   351→  setDurationRange,\n   352→  setDepartureTimeFilter,\n   353→  setArrivalTimeFilter,\n   354→  resetFilters,\n   355→} = flightsSlice.actions\n   356→\n   357→export default flightsSlice.reducer\n   358→"}]},"parent_tool_use_id":null,"session_id":"0234547c-0c1f-4430-8e8a-3c47a9bac0f9","uuid":"1482f64a-a5d8-4887-8899-2c11ad98cd9e","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/GoogleFlights/src/slices/flightsSlice.ts","content":"import { createSlice, createAsyncThunk, type PayloadAction } from '@reduxjs/toolkit'\n\nexport interface FlightResult {\n  id: string\n  flight_number: string\n  departure_time: string\n  arrival_time: string\n  duration_minutes: number\n  aircraft_type: string\n  has_wifi: boolean\n  has_power: boolean\n  has_entertainment: boolean\n  co2_kg: number\n  airline_name: string\n  airline_code: string\n  logo_color: string\n  origin_code: string\n  origin_name: string\n  origin_city: string\n  dest_code: string\n  dest_name: string\n  dest_city: string\n  total_price_cents: number\n  base_price_cents: number\n  taxes_cents: number\n  cabin_class: string\n  available_seats: number\n  num_legs: number\n}\n\nexport interface FlightLeg {\n  id: string\n  leg_order: number\n  departure_time: string\n  arrival_time: string\n  duration_minutes: number\n  flight_number: string\n  aircraft_type: string\n  terminal_departure: string | null\n  terminal_arrival: string | null\n  origin_code: string\n  origin_name: string\n  origin_city: string\n  dest_code: string\n  dest_name: string\n  dest_city: string\n  airline_name: string | null\n  airline_code: string | null\n}\n\nexport type SortOption = 'best' | 'price' | 'duration' | 'departure' | 'arrival'\n\nexport interface StopsFilter {\n  nonstop: boolean\n  oneStop: boolean\n  twoPlusStops: boolean\n}\n\nexport interface TimeFilter {\n  morning: boolean   // 6:00 - 12:00\n  afternoon: boolean // 12:00 - 18:00\n  evening: boolean   // 18:00 - 24:00\n  night: boolean     // 0:00 - 6:00\n}\n\ninterface FlightsState {\n  flights: FlightResult[]\n  loading: boolean\n  total: number\n  page: number\n  totalPages: number\n  loadingMore: boolean\n  sortBy: SortOption\n  stopsFilter: StopsFilter\n  airlinesFilter: string[]\n  priceRange: [number, number]\n  priceRangeMax: [number, number]\n  durationRange: [number, number]\n  durationRangeMax: [number, number]\n  departureTimeFilter: TimeFilter\n  arrivalTimeFilter: TimeFilter\n  expandedLegs: Record<string, FlightLeg[]>\n  expandedLegsLoading: Record<string, boolean>\n  isTracked: boolean\n  isTrackedLoading: boolean\n}\n\nconst initialState: FlightsState = {\n  flights: [],\n  loading: false,\n  total: 0,\n  page: 1,\n  totalPages: 0,\n  loadingMore: false,\n  sortBy: 'best',\n  stopsFilter: { nonstop: false, oneStop: false, twoPlusStops: false },\n  airlinesFilter: [],\n  priceRange: [0, 10000],\n  priceRangeMax: [0, 10000],\n  durationRange: [0, 2880],\n  durationRangeMax: [0, 2880],\n  departureTimeFilter: { morning: false, afternoon: false, evening: false, night: false },\n  arrivalTimeFilter: { morning: false, afternoon: false, evening: false, night: false },\n  expandedLegs: {},\n  expandedLegsLoading: {},\n  isTracked: false,\n  isTrackedLoading: false,\n}\n\nexport const searchFlights = createAsyncThunk(\n  'flights/searchFlights',\n  async (params: {\n    origin: string\n    destination: string\n    departureDate: string\n    cabinClass: string\n    page?: number\n  }) => {\n    const qs = new URLSearchParams({\n      origin: params.origin,\n      destination: params.destination,\n      departureDate: params.departureDate,\n      cabinClass: params.cabinClass,\n      page: String(params.page || 1),\n    })\n    const res = await fetch(`/api/search-flights?${qs}`)\n    return res.json() as Promise<{\n      flights: FlightResult[]\n      total: number\n      page: number\n      totalPages: number\n    }>\n  }\n)\n\nexport const loadMoreFlights = createAsyncThunk(\n  'flights/loadMoreFlights',\n  async (params: {\n    origin: string\n    destination: string\n    departureDate: string\n    cabinClass: string\n    page: number\n  }) => {\n    const qs = new URLSearchParams({\n      origin: params.origin,\n      destination: params.destination,\n      departureDate: params.departureDate,\n      cabinClass: params.cabinClass,\n      page: String(params.page),\n    })\n    const res = await fetch(`/api/search-flights?${qs}`)\n    return res.json() as Promise<{\n      flights: FlightResult[]\n      total: number\n      page: number\n      totalPages: number\n    }>\n  }\n)\n\nexport const fetchFlightLegs = createAsyncThunk(\n  'flights/fetchFlightLegs',\n  async (flightId: string) => {\n    const res = await fetch(`/api/flight-legs?flightId=${encodeURIComponent(flightId)}`)\n    const legs = await res.json() as FlightLeg[]\n    return { flightId, legs }\n  }\n)\n\nexport const checkTrackedRoute = createAsyncThunk(\n  'flights/checkTrackedRoute',\n  async (params: { sessionToken: string; origin: string; destination: string }) => {\n    const qs = new URLSearchParams({\n      session: params.sessionToken,\n      origin: params.origin,\n      destination: params.destination,\n    })\n    const res = await fetch(`/api/tracked-routes?${qs}`)\n    const data = await res.json() as { tracked: boolean }\n    return data.tracked\n  }\n)\n\nexport const toggleTrackRoute = createAsyncThunk(\n  'flights/toggleTrackRoute',\n  async (params: {\n    sessionToken: string\n    originCode: string\n    destCode: string\n    departureDateStart?: string\n    departureDateEnd?: string\n    cabinClass?: string\n    isCurrentlyTracked: boolean\n  }) => {\n    if (params.isCurrentlyTracked) {\n      await fetch('/api/tracked-routes', {\n        method: 'DELETE',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({\n          sessionToken: params.sessionToken,\n          originCode: params.originCode,\n          destCode: params.destCode,\n        }),\n      })\n      return false\n    } else {\n      await fetch('/api/tracked-routes', {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({\n          sessionToken: params.sessionToken,\n          originCode: params.originCode,\n          destCode: params.destCode,\n          departureDateStart: params.departureDateStart,\n          departureDateEnd: params.departureDateEnd,\n          cabinClass: params.cabinClass,\n        }),\n      })\n      return true\n    }\n  }\n)\n\nconst flightsSlice = createSlice({\n  name: 'flights',\n  initialState,\n  reducers: {\n    setSortBy(state, action: PayloadAction<SortOption>) {\n      state.sortBy = action.payload\n    },\n    setStopsFilter(state, action: PayloadAction<StopsFilter>) {\n      state.stopsFilter = action.payload\n    },\n    setAirlinesFilter(state, action: PayloadAction<string[]>) {\n      state.airlinesFilter = action.payload\n    },\n    setPriceRange(state, action: PayloadAction<[number, number]>) {\n      state.priceRange = action.payload\n    },\n    setDurationRange(state, action: PayloadAction<[number, number]>) {\n      state.durationRange = action.payload\n    },\n    setDepartureTimeFilter(state, action: PayloadAction<TimeFilter>) {\n      state.departureTimeFilter = action.payload\n    },\n    setArrivalTimeFilter(state, action: PayloadAction<TimeFilter>) {\n      state.arrivalTimeFilter = action.payload\n    },\n    resetFilters(state) {\n      state.stopsFilter = { nonstop: false, oneStop: false, twoPlusStops: false }\n      state.airlinesFilter = []\n      state.priceRange = state.priceRangeMax\n      state.durationRange = state.durationRangeMax\n      state.departureTimeFilter = { morning: false, afternoon: false, evening: false, night: false }\n      state.arrivalTimeFilter = { morning: false, afternoon: false, evening: false, night: false }\n      state.sortBy = 'best'\n    },\n  },\n  extraReducers: (builder) => {\n    builder\n      .addCase(searchFlights.pending, (state) => {\n        state.loading = true\n        state.flights = []\n        state.expandedLegs = {}\n        state.expandedLegsLoading = {}\n      })\n      .addCase(searchFlights.fulfilled, (state, action) => {\n        state.flights = action.payload.flights\n        state.total = action.payload.total\n        state.page = action.payload.page\n        state.totalPages = action.payload.totalPages\n        state.loading = false\n\n        // Calculate price and duration ranges\n        if (action.payload.flights.length > 0) {\n          const prices = action.payload.flights.map(f => f.total_price_cents)\n          const durations = action.payload.flights.map(f => f.duration_minutes)\n          const minPrice = Math.min(...prices)\n          const maxPrice = Math.max(...prices)\n          const minDuration = Math.min(...durations)\n          const maxDuration = Math.max(...durations)\n          state.priceRange = [minPrice, maxPrice]\n          state.priceRangeMax = [minPrice, maxPrice]\n          state.durationRange = [minDuration, maxDuration]\n          state.durationRangeMax = [minDuration, maxDuration]\n        }\n\n        // Reset filters on new search\n        state.stopsFilter = { nonstop: false, oneStop: false, twoPlusStops: false }\n        state.airlinesFilter = []\n        state.departureTimeFilter = { morning: false, afternoon: false, evening: false, night: false }\n        state.arrivalTimeFilter = { morning: false, afternoon: false, evening: false, night: false }\n        state.sortBy = 'best'\n      })\n      .addCase(searchFlights.rejected, (state) => {\n        state.loading = false\n      })\n      .addCase(loadMoreFlights.pending, (state) => {\n        state.loadingMore = true\n      })\n      .addCase(loadMoreFlights.fulfilled, (state, action) => {\n        state.flights = [...state.flights, ...action.payload.flights]\n        state.page = action.payload.page\n        state.totalPages = action.payload.totalPages\n        state.total = action.payload.total\n        state.loadingMore = false\n\n        // Update ranges with new data\n        if (state.flights.length > 0) {\n          const prices = state.flights.map(f => f.total_price_cents)\n          const durations = state.flights.map(f => f.duration_minutes)\n          state.priceRangeMax = [Math.min(...prices), Math.max(...prices)]\n          state.durationRangeMax = [Math.min(...durations), Math.max(...durations)]\n        }\n      })\n      .addCase(loadMoreFlights.rejected, (state) => {\n        state.loadingMore = false\n      })\n      .addCase(fetchFlightLegs.pending, (state, action) => {\n        state.expandedLegsLoading[action.meta.arg] = true\n      })\n      .addCase(fetchFlightLegs.fulfilled, (state, action) => {\n        state.expandedLegs[action.payload.flightId] = action.payload.legs\n        state.expandedLegsLoading[action.payload.flightId] = false\n      })\n      .addCase(fetchFlightLegs.rejected, (state, action) => {\n        state.expandedLegsLoading[action.meta.arg] = false\n      })\n      .addCase(checkTrackedRoute.pending, (state) => {\n        state.isTrackedLoading = true\n      })\n      .addCase(checkTrackedRoute.fulfilled, (state, action) => {\n        state.isTracked = action.payload\n        state.isTrackedLoading = false\n      })\n      .addCase(checkTrackedRoute.rejected, (state) => {\n        state.isTrackedLoading = false\n      })\n      .addCase(toggleTrackRoute.fulfilled, (state, action) => {\n        state.isTracked = action.payload\n      })\n  },\n})\n\nexport const {\n  setSortBy,\n  setStopsFilter,\n  setAirlinesFilter,\n  setPriceRange,\n  setDurationRange,\n  setDepartureTimeFilter,\n  setArrivalTimeFilter,\n  resetFilters,\n} = flightsSlice.actions\n\nexport default flightsSlice.reducer\n","numLines":358,"startLine":1,"totalLines":358}}}
