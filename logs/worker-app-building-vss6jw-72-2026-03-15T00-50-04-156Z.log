[2026-03-15T00:34:51.850Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FpHWL9AnuTpzepFMuWCvsX","type":"tool_result","content":"     1→import { useNavigate } from 'react-router-dom'\n     2→import { Star, MessageSquare } from 'lucide-react'\n     3→import type { UserReview } from '../slices/userReviewsSlice'\n     4→\n     5→interface UserReviewsListProps {\n     6→  reviews: UserReview[]\n     7→  loading: boolean\n     8→}\n     9→\n    10→function formatDate(dateStr: string): string {\n    11→  const date = new Date(dateStr.split('T')[0] + 'T12:00:00')\n    12→  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })\n    13→}\n    14→\n    15→function StarRating({ rating }: { rating: number }) {\n    16→  return (\n    17→    <div className=\"flex items-center gap-0.5\" data-testid=\"star-rating\">\n    18→      {[1, 2, 3, 4, 5].map((star) => (\n    19→        <Star\n    20→          key={star}\n    21→          size={16}\n    22→          className={star <= rating ? 'text-primary fill-primary' : 'text-border'}\n    23→          fill={star <= rating ? 'currentColor' : 'none'}\n    24→        />\n    25→      ))}\n    26→    </div>\n    27→  )\n    28→}\n    29→\n    30→export default function UserReviewsList({ reviews, loading }: UserReviewsListProps) {\n    31→  const navigate = useNavigate()\n    32→\n    33→  if (loading) {\n    34→    return (\n    35→      <div data-testid=\"reviews-loading\" className=\"text-center py-8 text-text-secondary\">\n    36→        Loading reviews...\n    37→      </div>\n    38→    )\n    39→  }\n    40→\n    41→  return (\n    42→    <div data-testid=\"user-reviews-list\">\n    43→      <h2 className=\"text-xl font-semibold text-text mb-4 flex items-center gap-2\">\n    44→        <MessageSquare size={20} />\n    45→        My Reviews\n    46→      </h2>\n    47→\n    48→      {reviews.length === 0 ? (\n    49→        <div data-testid=\"reviews-empty-state\" className=\"text-center py-8 text-text-secondary border border-border rounded-xl\">\n    50→          You haven't written any reviews yet\n    51→        </div>\n    52→      ) : (\n    53→        <div className=\"space-y-3\">\n    54→          {reviews.map((review) => (\n    55→            <div\n    56→              key={review.id}\n    57→              data-testid={`review-card-${review.id}`}\n    58→              className=\"rounded-xl border border-border p-4 hover:shadow-md transition-shadow\"\n    59→            >\n    60→              <div className=\"flex items-start justify-between gap-2 mb-2\">\n    61→                <button\n    62→                  data-testid={`review-property-link-${review.id}`}\n    63→                  onClick={() => navigate(`/properties/${review.property_id}`)}\n    64→                  className=\"text-primary font-semibold hover:underline text-left\"\n    65→                >\n    66→                  {review.property_title}\n    67→                </button>\n    68→                <span className=\"text-xs text-text-secondary whitespace-nowrap\">\n    69→                  {formatDate(review.created_at)}\n    70→                </span>\n    71→              </div>\n    72→\n    73→              <StarRating rating={review.rating} />\n    74→\n    75→              {review.comment && (\n    76→                <p className=\"text-sm text-text mt-2\">{review.comment}</p>\n    77→              )}\n    78→            </div>\n    79→          ))}\n    80→        </div>\n    81→      )}\n    82→    </div>\n    83→  )\n    84→}\n    85→"}]},"parent_tool_use_id":"toolu_01VPwZ6Ufsw7t3k93wQciQv3","session_id":"7da53361-7b7a-4448-be86-193d39a038b9","uuid":"81cd9051-86b9-4dbb-9929-8bdd9e1e2250"}
