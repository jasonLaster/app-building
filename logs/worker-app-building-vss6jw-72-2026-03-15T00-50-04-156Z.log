[2026-03-15T00:34:56.515Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VjsRwGnmRhhNUzyDkrF7k9","type":"tool_result","content":"     1→import { useEffect } from 'react'\n     2→import { useParams, useNavigate, Link } from 'react-router-dom'\n     3→import { useSelector, useDispatch } from 'react-redux'\n     4→import type { RootState, AppDispatch } from '../store'\n     5→import { fetchBookingForReview, resetReviewForm } from '../slices/reviewFormSlice'\n     6→import PropertyBookingContext from '../components/PropertyBookingContext'\n     7→import ReviewForm from '../components/ReviewForm'\n     8→\n     9→export default function WriteReview() {\n    10→  const { bookingId } = useParams<{ bookingId: string }>()\n    11→  const dispatch = useDispatch<AppDispatch>()\n    12→  const navigate = useNavigate()\n    13→  const { currentUser } = useSelector((state: RootState) => state.auth)\n    14→  const { booking, loading, error, submitSuccess } = useSelector((state: RootState) => state.reviewForm)\n    15→\n    16→  useEffect(() => {\n    17→    if (!currentUser) {\n    18→      navigate('/login')\n    19→      return\n    20→    }\n    21→    if (bookingId) {\n    22→      dispatch(fetchBookingForReview({ bookingId, guestId: currentUser.id }))\n    23→    }\n    24→    return () => {\n    25→      dispatch(resetReviewForm())\n    26→    }\n    27→  }, [currentUser, bookingId, dispatch, navigate])\n    28→\n    29→  if (!currentUser) {\n    30→    return null\n    31→  }\n    32→\n    33→  if (loading) {\n    34→    return (\n    35→      <div className=\"p-6 max-sm:p-3 max-w-2xl mx-auto\" data-testid=\"write-review-page\">\n    36→        <div className=\"text-center py-12 text-text-secondary\">Loading booking details...</div>\n    37→      </div>\n    38→    )\n    39→  }\n    40→\n    41→  if (error) {\n    42→    return (\n    43→      <div className=\"p-6 max-sm:p-3 max-w-2xl mx-auto\" data-testid=\"write-review-page\">\n    44→        <div className=\"text-center py-12\">\n    45→          <p data-testid=\"review-page-error\" className=\"text-error text-lg font-medium mb-4\">{error}</p>\n    46→          <Link\n    47→            to=\"/trips\"\n    48→            className=\"text-primary hover:text-primary-dark font-medium underline\"\n    49→          >\n    50→            Back to My Trips\n    51→          </Link>\n    52→        </div>\n    53→      </div>\n    54→    )\n    55→  }\n    56→\n    57→  if (submitSuccess) {\n    58→    return (\n    59→      <div className=\"p-6 max-sm:p-3 max-w-2xl mx-auto\" data-testid=\"write-review-page\">\n    60→        <div className=\"text-center py-12\">\n    61→          <p data-testid=\"review-success-message\" className=\"text-success text-lg font-medium mb-4\">\n    62→            Review submitted successfully\n    63→          </p>\n    64→          <Link\n    65→            to=\"/trips\"\n    66→            className=\"text-primary hover:text-primary-dark font-medium underline\"\n    67→          >\n    68→            Back to My Trips\n    69→          </Link>\n    70→        </div>\n    71→      </div>\n    72→    )\n    73→  }\n    74→\n    75→  if (!booking) {\n    76→    return (\n    77→      <div className=\"p-6 max-sm:p-3 max-w-2xl mx-auto\" data-testid=\"write-review-page\">\n    78→        <div className=\"text-center py-12 text-text-secondary\">Booking not found</div>\n    79→      </div>\n    80→    )\n    81→  }\n    82→\n    83→  return (\n    84→    <div className=\"p-6 max-sm:p-3 max-w-2xl mx-auto\" data-testid=\"write-review-page\">\n    85→      <h1 className=\"text-2xl font-bold text-text mb-6\">Write a Review</h1>\n    86→      <div className=\"mb-6\">\n    87→        <PropertyBookingContext booking={booking} />\n    88→      </div>\n    89→      <ReviewForm booking={booking} />\n    90→    </div>\n    91→  )\n    92→}\n    93→"}]},"parent_tool_use_id":"toolu_01VPwZ6Ufsw7t3k93wQciQv3","session_id":"7da53361-7b7a-4448-be86-193d3