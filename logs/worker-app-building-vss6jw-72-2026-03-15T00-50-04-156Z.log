ent text\n   253→    await expect(card).toContainText('Amazing stay! The host was very welcoming.')\n   254→\n   255→    // Verify formatted date \"Jan 15, 2026\"\n   256→    await expect(card).toContainText('Jan 15, 2026')\n   257→  })\n   258→\n   259→  test('Reviews list updates after writing a new review', async ({ page }) => {\n   260→    test.slow()\n   261→    // Set up: delete all of Emma's reviews and non-seed bookings, create 2 new reviews via API\n   262→    await login(page, 'emma@example.com')\n   263→\n   264→    await deleteAllReviewsForGuest(page, EMMA_ID)\n   265→    await deleteNonSeedBookings(page)\n   266→\n   267→    // Create 2 reviews for Emma on different properties\n   268→    await createBookingAndReview(page, PROPERTY_VILLA, EMMA_ID, '2025-06-01', '2025-06-05', {\n   269→      rating: 4,\n   270→      cleanliness: 4,\n   271→      accuracy: 4,\n   272→      communication: 4,\n   273→      location: 4,\n   274→      value: 4,\n   275→      comment: 'Great villa stay',\n   276→    })\n   277→    await createBookingAndReview(page, PROPERTY_CABIN, EMMA_ID, '2025-07-01', '2025-07-05', {\n   278→      rating: 5,\n   279→      cleanliness: 5,\n   280→      accuracy: 5,\n   281→      communication: 5,\n   282→      location: 5,\n   283→      value: 5,\n   284→      comment: 'Wonderful cabin retreat',\n   285→    })\n   286→\n   287→    // Navigate to profile and verify 2 existing reviews\n   288→    await page.goto('/profile')\n   289→    await expect(page.getByTestId('user-reviews-list')).toBeVisible({ timeout: 30000 })\n   290→    const reviewCards = page.locator('[data-testid^=\"review-card-\"]')\n   291→    await expect(reviewCards).toHaveCount(2, { timeout: 30000 })\n   292→\n   293→    // Emma's seed booking e1111111 is 'completed' for Cozy Downtown Loft.\n   294→    // Its review was deleted above, so \"Write Review\" should be available.\n   295→    // Navigate to write a review for that booking\n   296→    await page.goto('/trips/e1111111