[2026-03-15T00:34:56.458Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WToiWHBAXWeyz6uahxDRc1","type":"tool_result","content":"     1→import { useState, useEffect, useCallback } from 'react'\n     2→import { useSelector, useDispatch } from 'react-redux'\n     3→import { useNavigate } from 'react-router-dom'\n     4→import type { RootState, AppDispatch } from '../store'\n     5→import {\n     6→  fetchHostStats,\n     7→  fetchHostListings,\n     8→  fetchHostBookings,\n     9→  deactivateProperty,\n    10→  activateProperty,\n    11→  updateHostBookingStatus,\n    12→} from '../slices/hostSlice'\n    13→import type { Property } from '../slices/propertiesSlice'\n    14→import StatsOverview from '../components/StatsOverview'\n    15→import ListingsTab from '../components/ListingsTab'\n    16→import BookingsTab from '../components/BookingsTab'\n    17→import AddListingForm from '../components/AddListingForm'\n    18→\n    19→type Tab = 'listings' | 'bookings'\n    20→\n    21→export default function HostDashboard() {\n    22→  const dispatch = useDispatch<AppDispatch>()\n    23→  const navigate = useNavigate()\n    24→  const currentUser = useSelector((state: RootState) => state.auth.currentUser)\n    25→  const { stats, listings, bookings, statsLoading, listingsLoading, bookingsLoading } = useSelector(\n    26→    (state: RootState) => state.host\n    27→  )\n    28→  const [activeTab, setActiveTab] = useState<Tab>('listings')\n    29→  const [showAddForm, setShowAddForm] = useState(false)\n    30→\n    31→  useEffect(() => {\n    32→    if (!currentUser) {\n    33→      navigate('/login')\n    34→    }\n    35→  }, [currentUser, navigate])\n    36→\n    37→  useEffect(() => {\n    38→    if (currentUser?.is_host) {\n    39→      dispatch(fetchHostStats(currentUser.id))\n    40→      dispatch(fetchHostListings(currentUser.id))\n    41→      dispatch(fetchHostBookings(currentUser.id))\n    42→    }\n    43→  }, [dispatch, currentUser])\n    44→\n    45→  const handleDeactivate = useCallback(async (property: Property) => {\n    46→    await dispatch(deactivateProperty(property.id))\n    47→  }, [dispatch])\n    48→\n    49→  const handleActivate = useCallback(async (property: Property) => {\n    50→    await dispatch(activateProperty(property.id))\n    51→  }, [dispatch])\n    52→\n    53→  const handleConfirmBooking = useCallback(async (bookingId: string) => {\n    54→    await dispatch(updateHostBookingStatus({ bookingId, status: 'confirmed' }))\n    55→    if (currentUser) {\n    56→      dispatch(fetchHostStats(currentUser.id))\n    57→    }\n    58→  }, [dispatch, currentUser])\n    59→\n    60→  const handleCancelBooking = useCallback(async (bookingId: string) => {\n    61→    await dispatch(updateHostBookingStatus({ bookingId, status: 'cancelled' }))\n    62→    if (currentUser) {\n    63→      dispatch(fetchHostStats(currentUser.id))\n    64→    }\n    65→  }, [dispatch, currentUser])\n    66→\n    67→  const handleAddListingSuccess = useCallback(() => {\n    68→    setShowAddForm(false)\n    69→    if (currentUser) {\n    70→      dispatch(fetchHostStats(currentUser.id))\n    71→      dispatch(fetchHostListings(currentUser.id))\n    72→    }\n    73→  }, [dispatch, currentUser])\n    74→\n    75→  if (!currentUser) {\n    76→    return null\n    77→  }\n    78→\n    79→  if (!currentUser.is_host) {\n    80→    return (\n    81→      <div data-testid=\"host-dashboard\" className=\"p-6 max-sm:p-3\">\n    82→        <div className=\"max-w-lg mx-auto text-center py-16\">\n    83→          <h1 className=\"text-2xl font-bold text-text mb-4\">Become a Host</h1>\n    84→          <p className=\"text-text-secondary mb-6\">\n    85→            You need to become a host to access this page. Visit your profile to get started.\n    86→          </p>\n    87→          <button\n    88→            data-testid=\"become-host-link\"\n    89→            onClick={() => navigate('/profile')}\n    90→            className=\"bg-primary text-white px-6 py-3 rounded-lg font-medium hover:bg-primary-dark transition-colors\"\n    91→          >\n    92→            Go to Profile\n    93→          </button>\n    94→        </div>\n    95→      </div>\n    96→    )\n    97→  }\n    98→\n    99→  return (\n   100→    <div data-testid=\"host-dashboard\" className=\"p-6 max-sm:p-3\">\n   101→      <div className=\"max-w-6xl mx-auto\">\n   102→        <h1 className=\"text-2xl font-bold text-text mb-6\">Host Dashboard</h1>\n   103→\n   104→        <StatsOverview stats={stats} loading={statsLoading} />\n   105→\n   106→        <div className=\"mt-8 mb-6\">\n   107→          <div className=\"flex border-b border-border\">\n   108→            <button\n   109→              data-testid=\"tab-listings\"\n   110→              onClick={() => setActiveTab('listings')}\n   111→              className={`px-6 py-3 text-sm font-medium border-b-2 transition-colors ${\n   112→                activeTab === 'listings'\n   113→                  ? 'border-primary text-primary'\n   114→                  : 'border-transparent text-text-secondary hover:text-text'\n   115→              }`}\n   116→            >\n   117→              Listings\n   118→            </button>\n   119→            <button\n   120→              data-testid=\"tab-bookings\"\n   121→              onClick={() => setActiveTab('bookings')}\n   122→              className={`px-6 py-3 text-sm font-medium border-b-2 transition-colors ${\n   123→                activeTab === 'bookings'\n   124→                  ? 'border-primary text-primary'\n   125→                  : 'border-transparent text-text-secondary hover:text-text'\n   126→              }`}\n   127→            >\n   128→              Bookings\n   129→            </button>\n   130→          </div>\n   131→        </div>\n   132→\n   133→        {activeTab === 'listings' && (\n   134→          <ListingsTab\n   135→            listings={listings}\n   136→            loading={listingsLoading}\n   137→            onDeactivate={handleDeactivate}\n   138→            onActivate={handleActivate}\n   139→            onAddListing={() => setShowAddForm(true)}\n   140→          />\n   141→        )}\n   142→\n   143→        {activeTab === 'bookings' && (\n   144→          <BookingsTab\n   145→            bookings={bookings}\n   146→            loading={bookingsLoading}\n   147→            onConfirm={handleConfirmBooking}\n   148→            onCancel={handleCancelBooking}\n   149→          />\n   150→        )}\n   151→\n   152→        {showAddForm && (\n   153→          <AddListingForm\n   154→            hostId={currentUser.id}\n   155→            onClose={() => setShowAddForm(false)}\n   156→            onSuccess={handleAddListingSuccess}\n   157→          />\n   158→        )}\n   159→      </div>\n   160→    </div>\n   161→  )\n   162→}\n   163→"}]},"parent_tool_use_id":"toolu_01D5KRTHarrJWPJhMzLvqJez","session_id":"7da53361-7b7a-4448-be86-193d39a038b9","uuid":"0d2eb6c9-35a6-4b34-9016-8ea74ea9a237"}
