[2026-03-14T22:48:10.599Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014oeQvtssGacXiY4kjyMnGM","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions'\n     2→import { getSql } from './db.js'\n     3→\n     4→export default async (request: Request, _context: Context) => {\n     5→  const sql = getSql()\n     6→  const url = new URL(request.url)\n     7→  const segments = url.pathname.split('/').filter(Boolean)\n     8→  const funcIdx = segments.indexOf('bookings')\n     9→  const bookingId = funcIdx >= 0 ? segments[funcIdx + 1] : undefined\n    10→\n    11→  const headers = { 'Content-Type': 'application/json' }\n    12→\n    13→  if (request.method === 'POST') {\n    14→    const body = await request.json() as {\n    15→      property_id: string\n    16→      guest_id: string\n    17→      check_in: string\n    18→      check_out: string\n    19→      num_guests: number\n    20→      total_price: number\n    21→      special_requests?: string\n    22→    }\n    23→\n    24→    const { property_id, guest_id, check_in, check_out, num_guests, total_price, special_requests } = body\n    25→\n    26→    if (!property_id || !guest_id || !check_in || !check_out || !num_guests || !total_price) {\n    27→      return new Response(JSON.stringify({ error: 'Missing required fields' }), { status: 400, headers })\n    28→    }\n    29→\n    30→    const overlap = await sql`\n    31→      SELECT id FROM bookings\n    32→      WHERE property_id = ${property_id}\n    33→      AND status IN ('confirmed', 'pending')\n    34→      AND check_in < ${check_out}\n    35→      AND check_out > ${check_in}\n    36→    `\n    37→    if (overlap.length > 0) {\n    38→      return new Response(JSON.stringify({ error: 'Property is not available for the selected dates' }), { status: 409, headers })\n    39→    }\n    40→\n    41→    const result = await sql`\n    42→      INSERT INTO bookings (id, property_id, guest_id, check_in, check_out, num_guests, total_price, status, special_requests, created_at)\n    43→      VALUES (gen_random_uuid(), ${property_id}, ${guest_id}, ${check_in}, ${check_out}, ${num_guests}, ${total_price}, 'pending', ${special_requests || null}, now())\n    44→      RETURNING *\n    45→    `\n    46→    const booking = result[0]\n    47→    return new Response(JSON.stringify(booking), { status: 201, headers })\n    48→  }\n    49→\n    50→  if (request.method === 'PUT' && bookingId) {\n    51→    const body = await request.json() as { status: string }\n    52→    const { status } = body\n    53→\n    54→    if (!['confirmed', 'cancelled'].includes(status)) {\n    55→      return new Response(JSON.stringify({ error: 'Invalid status' }), { status: 400, headers })\n    56→    }\n    57→\n    58→    const result = await sql`\n    59→      UPDATE bookings SET status = ${status} WHERE id = ${bookingId} RETURNING *\n    60→    `\n    61→    const booking = result[0]\n    62→    if (!booking) {\n    63→      return new Response(JSON.stringify({ error: 'Booking not found' }), { status: 404, headers })\n    64→    }\n    65→    return new Response(JSON.stringify(booking), { status: 200, headers })\n    66→  }\n    67→\n    68→  if (request.method === 'GET') {\n    69→    const guestId = url.searchParams.get('guest_id')\n    70→    if (!guestId) {\n    71→      return new Response(JSON.stringify({ error: 'guest_id is required' }), { status: 400, headers })\n    72→    }\n    73→\n    74→    const bookings = await sql`\n    75→      SELECT b.*,\n    76→        p.title as property_title, p.city as property_city, p.country as property_country,\n    77→        (SELECT url FROM property_images pi WHERE pi.property_id = p.id ORDER BY pi.display_order ASC LIMIT 1) as property_image,\n    78→        CASE WHEN EXISTS (SELECT 1 FROM reviews r WHERE r.booking_id = b.id) THEN true ELSE false END as has_review\n    79→      FROM bookings b\n    80→      JOIN properties p ON p.id = b.property_id\n    81→      WHERE b.guest_id = ${guestId}\n    82→      ORDER BY b.check_in ASC\n    83→    `\n    84→    return new Response(JSON.stringify(bookings), { status: 200, headers })\n    85→  }\n    86→\n    87→  return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers })\n    88→}\n    89→"}]},"parent_tool_use_id":null,"session_id":"e2246777-4cd6-42ce-8777-30d908ca9f10","uuid":"bc52d4d9-865f-4b10-b6b0-70ef59178632","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/netlify/functions/bookings.ts","content":"import type { Context } from '@netlify/functions'\nimport { getSql } from './db.js'\n\nexport default async (request: Request, _context: Context) => {\n  const sql = getSql()\n  const url = new URL(request.url)\n  const segments = url.pathname.split('/').filter(Boolean)\n  const funcIdx = segments.indexOf('bookings')\n  const bookingId = funcIdx >= 0 ? segments[funcIdx + 1] : undefined\n\n  const headers = { 'Content-Type': 'application/json' }\n\n  if (request.method === 'POST') {\n    const body = await request.json() as {\n      property_id: string\n      guest_id: string\n      check_in: string\n      check_out: string\n      num_guests: number\n      total_price: number\n      special_requests?: string\n    }\n\n    const { property_id, guest_id, check_in, check_out, num_guests, total_price, special_requests } = body\n\n    if (!property_id || !guest_id || !check_in || !check_out || !num_guests || !total_price) {\n      return new Response(JSON.stringify({ error: 'Missing required fields' }), { status: 400, headers })\n    }\n\n    const overlap = await sql`\n      SELECT id FROM bookings\n      WHERE property_id = ${property_id}\n      AND status IN ('confirmed', 'pending')\n      AND check_in < ${check_out}\n      AND check_out > ${check_in}\n    `\n    if (overlap.length > 0) {\n      return new Response(JSON.stringify({ error: 'Property is not available for the selected dates' }), { status: 409, headers })\n    }\n\n    const result = await sql`\n      INSERT INTO bookings (id, property_id, guest_id, check_in, check_out, num_guests, total_price, status, special_requests, created_at)\n      VALUES (gen_random_uuid(), ${property_id}, ${guest_id}, ${check_in}, ${check_out}, ${num_guests}, ${total_price}, 'pending', ${special_requests || null}, now())\n      RETURNING *\n    `\n    const booking = result[0]\n    return new Response(JSON.stringify(booking), { status: 201, headers })\n  }\n\n  if (request.method === 'PUT' && bookingId) {\n    const body = await request.json() as { status: string }\n    const { status } = body\n\n    if (!['confirmed', 'cancelled'].includes(status)) {\n      return new Response(JSON.stringify({ error: 'Invalid status' }), { status: 400, headers })\n    }\n\n    const result = await sql`\n      UPDATE bookings SET status = ${status} WHERE id = ${bookingId} RETURNING *\n    `\n    const booking = result[0]\n    if (!booking) {\n      return new Response(JSON.stringify({ error: 'Booking not found' }), { status: 404, headers })\n    }\n    return new Response(JSON.stringify(booking), { status: 200, headers })\n  }\n\n  if (request.method === 'GET') {\n    const guestId = url.searchParams.get('guest_id')\n    if (!guestId) {\n      return new Response(JSON.stringify({ error: 'guest_id is required' }), { status: 400, headers })\n    }\n\n    const bookings = await sql`\n      SELECT b.*,\n        p.title as property_title, p.city as property_city, p.country as property_country,\n        (SELECT url FROM property_images pi WHERE pi.property_id = p.id ORDER BY pi.display_order ASC LIMIT 1) as property_image,\n        CASE WHEN EXISTS (SELECT 1 FROM reviews r WHERE r.booking_id = b.id) THEN true ELSE false END as has_review\n      FROM bookings b\n      JOIN properties p ON p.id = b.property_id\n      WHERE b.guest_id = ${guestId}\n      ORDER BY b.check_in ASC\n    `\n    return new Response(JSON.stringify(bookings), { status: 200, headers })\n  }\n\n  return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers })\n}\n","numLines":89,"startLine":1,"totalLines":89}}}
