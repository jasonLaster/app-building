[2026-03-14T22:47:21.301Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GRhwaMiQXQXTFoyL9cA9RR","type":"tool_result","content":"     1→import { Home, Calendar, DollarSign, Star } from 'lucide-react'\n     2→import type { HostStats } from '../slices/hostSlice'\n     3→\n     4→interface StatsOverviewProps {\n     5→  stats: HostStats\n     6→  loading: boolean\n     7→}\n     8→\n     9→export default function StatsOverview({ stats, loading }: StatsOverviewProps) {\n    10→  const cards = [\n    11→    {\n    12→      label: 'Total Listings',\n    13→      value: String(stats.totalListings),\n    14→      icon: Home,\n    15→      testId: 'stat-total-listings',\n    16→    },\n    17→    {\n    18→      label: 'Active Bookings',\n    19→      value: String(stats.activeBookings),\n    20→      icon: Calendar,\n    21→      testId: 'stat-active-bookings',\n    22→    },\n    23→    {\n    24→      label: 'Total Earnings',\n    25→      value: `$${stats.totalEarnings.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}`,\n    26→      icon: DollarSign,\n    27→      testId: 'stat-total-earnings',\n    28→    },\n    29→    {\n    30→      label: 'Average Rating',\n    31→      value: stats.reviewCount > 0 ? Number(stats.avgRating).toFixed(1) : '—',\n    32→      icon: Star,\n    33→      testId: 'stat-average-rating',\n    34→    },\n    35→  ]\n    36→\n    37→  if (loading) {\n    38→    return (\n    39→      <div data-testid=\"stats-overview\" className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n    40→        {[1, 2, 3, 4].map((i) => (\n    41→          <div key={i} className=\"bg-white rounded-xl border border-border p-5 animate-pulse\">\n    42→            <div className=\"h-4 bg-bg-secondary rounded w-24 mb-3\" />\n    43→            <div className=\"h-8 bg-bg-secondary rounded w-16\" />\n    44→          </div>\n    45→        ))}\n    46→      </div>\n    47→    )\n    48→  }\n    49→\n    50→  return (\n    51→    <div data-testid=\"stats-overview\" className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n    52→      {cards.map((card) => (\n    53→        <div\n    54→          key={card.testId}\n    55→          data-testid={card.testId}\n    56→          className=\"bg-white rounded-xl border border-border p-5 flex items-start gap-4\"\n    57→        >\n    58→          <div className=\"w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0\">\n    59→            <card.icon size={20} className=\"text-primary\" />\n    60→          </div>\n    61→          <div>\n    62→            <p className=\"text-sm text-text-secondary font-medium\">{card.label}</p>\n    63→            <p className=\"text-2xl font-bold text-text mt-0.5 flex items-center gap-1\">\n    64→              {card.label === 'Average Rating' && stats.reviewCount > 0 && (\n    65→                <Star size={18} className=\"fill-status-pending text-status-pending\" />\n    66→              )}\n    67→              {card.value}\n    68→            </p>\n    69→          </div>\n    70→        </div>\n    71→      ))}\n    72→    </div>\n    73→  )\n    74→}\n    75→"}]},"parent_tool_use_id":"toolu_019vUP2dpwGtgzJahmbDkdDZ","session_id":"e2246777-4cd6-42ce-8777-30d908ca9f10","uuid":"acb58377-7f14-4847-b13a-631350854a1b"}
