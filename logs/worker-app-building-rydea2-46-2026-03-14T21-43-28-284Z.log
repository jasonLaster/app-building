[2026-03-14T21:36:45.084Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012F89YY3D4KcVgFTbACkiX4","type":"tool_result","content":"     1→import { useState, useEffect, useRef, useCallback } from 'react';\n     2→import { useSelector } from 'react-redux';\n     3→import type { RootState } from '../store';\n     4→import { StatusIcon, PriorityIcon, STATUS_CONFIG, STATUS_ORDER } from './IssueRow';\n     5→import './CreateIssueForm.css';\n     6→\n     7→const PRIORITY_ORDER = ['urgent', 'high', 'medium', 'low', 'none'] as const;\n     8→const PRIORITY_LABELS: Record<string, string> = {\n     9→  urgent: 'Urgent',\n    10→  high: 'High',\n    11→  medium: 'Medium',\n    12→  low: 'Low',\n    13→  none: 'No Priority',\n    14→};\n    15→\n    16→interface SearchableIssue {\n    17→  id: string;\n    18→  title: string;\n    19→  identifier: string;\n    20→}\n    21→\n    22→export interface CreateIssueFormData {\n    23→  teamId: string;\n    24→  title: string;\n    25→  description: string;\n    26→  status: string;\n    27→  priority: string;\n    28→  assigneeId: string | null;\n    29→  labelIds: string[];\n    30→  projectId: string | null;\n    31→  cycleId: string | null;\n    32→  dueDate: string | null;\n    33→  parentId: string | null;\n    34→}\n    35→\n    36→interface CreateIssueFormProps {\n    37→  defaultTeamId?: string;\n    38→  formData: CreateIssueFormData;\n    39→  onFormChange: (data: CreateIssueFormData) => void;\n    40→  titleError: string | null;\n    41→}\n    42→\n    43→type DropdownType = 'team' | 'status' | 'priority' | 'assignee' | 'labels' | 'project' | 'cycle' | 'parent' | null;\n    44→\n    45→export default function CreateIssueForm({ defaultTeamId, formData, onFormChange, titleError }: CreateIssueFormProps) {\n    46→  const { items: teams } = useSelector((state: RootState) => state.teams);\n    47→  const { items: labels } = useSelector((state: RootState) => state.labels);\n    48→  const token = useSelector((state: RootState) => state.auth.token);\n    49→\n    50→  const [openDropdown, setOpenDropdown] = useState<DropdownType>(null);\n    51→  const [assigneeSearch, setAssigneeSearch] = useState('');\n    52→  const [projectSearch, setProjectSearch] = useState('');\n    53→  const [parentSearch, setParentSearch] = useState('');\n    54→  const [parentResults, setParentResults] = useState<SearchableIssue[]>([]);\n    55→\n    56→  // Team-specific data (members, projects, cycles)\n    57→  const [teamMembers, setTeamMembers] = useState<Array<{ id: string; name: string; email: string }>>([]);\n    58→  const [teamProjects, setTeamProjects] = useState<Array<{ id: string; name: string }>>([]);\n    59→  const [teamCycles, setTeamCycles] = useState<Array<{ id: string; name: string; start_date: string; end_date: string }>>([]);\n    60→\n    61→  const formRef = useRef<HTMLDivElement>(null);\n    62→  const titleRef = useRef<HTMLInputElement>(null);\n    63→\n    64→  // Focus title on mount\n    65→  useEffect(() => {\n    66→    titleRef.current?.focus();\n    67→  }, []);\n    68→\n    69→  // Set default team\n    70→  useEffect(() => {\n    71→    if (defaultTeamId && !formData.teamId) {\n    72→      onFormChange({ ...formData, teamId: defaultTeamId });\n    73→    } else if (!formData.teamId && teams.length > 0 && teams[0]) {\n    74→      onFormChange({ ...formData, teamId: teams[0].id });\n    75→    }\n    76→  }, [defaultTeamId, teams]); // eslint-disable-line react-hooks/exhaustive-deps\n    77→\n    78→  // Fetch team-specific data when team changes\n    79→  const fetchTeamData = useCallback(async (teamId: string) => {\n    80→    if (!token || !teamId) return;\n    81→    try {\n    82→      const response = await fetch(`/api/team-issues?teamId=${teamId}`, {\n    83→        headers: { Authorization: `Bearer ${token}` },\n    84→      });\n    85→      if (response.ok) {\n    86→        const data = await response.json();\n    87→        setTeamMembers(data.members || []);\n    88→        setTeamProjects(data.projects || []);\n    89→        setTeamCycles(data.cycles || []);\n    90→      }\n    91→    } catch {\n    92→      // silently fail\n    93→    }\n    94→  }, [token]);\n    95→\n    96→  useEffect(() => {\n    97→    if (formData.teamId) {\n    98→      fetchTeamData(formData.teamId);\n    99→    }\n   100→  }, [formData.teamId, fetchTeamData]);\n   101→\n   102→  // Search parent issues\n   103→  useEffect(() => {\n   104→    if (!token || openDropdown !== 'parent') return;\n   105→    const controller = new AbortController();\n   106→    const fetchParents = async () => {\n   107→      try {\n   108→        const params = new URLSearchParams();\n   109→        if (parentSearch) params.set('q', parentSearch);\n   110→        if (formData.teamId) params.set('teamId', formData.teamId);\n   111→        const response = await fetch(`/api/search-issues?${params}`, {\n   112→          headers: { Authorization: `Bearer ${token}` },\n   113→          signal: controller.signal,\n   114→        });\n   115→        if (response.ok) {\n   116→          const data = await response.json();\n   117→          setParentResults(data.issues || []);\n   118→        }\n   119→      } catch {\n   120→        // ignore abort errors\n   121→      }\n   122→    };\n   123→    const timer = setTimeout(fetchParents, 200);\n   124→    return () => {\n   125→      clearTimeout(timer);\n   126→      controller.abort();\n   127→    };\n   128→  }, [parentSearch, formData.teamId, token, openDropdown]);\n   129→\n   130→  // Close dropdown on outside click\n   131→  useEffect(() => {\n   132→    function handleClickOutside(e: MouseEvent) {\n   133→      if (formRef.current && !formRef.current.contains(e.target as Node)) {\n   134→        setOpenDropdown(null);\n   135→      }\n   136→    }\n   137→    if (openDropdown) {\n   138→      document.addEventListener('mousedown', handleClickOutside);\n   139→    }\n   140→    return () => document.removeEventListener('mousedown', handleClickOutside);\n   141→  }, [openDropdown]);\n   142→\n   143→  function updateField<K extends keyof CreateIssueFormData>(key: K, value: CreateIssueFormData[K]) {\n   144→    onFormChange({ ...formData, [key]: value });\n   145→  }\n   146→\n   147→  function toggleDropdown(type: DropdownType) {\n   148→    setOpenDropdown(openDropdown === type ? null : type);\n   149→    if (type === 'assignee') setAssigneeSearch('');\n   150→    if (type === 'project') setProjectSearch('');\n   151→    if (type === 'parent') setParentSearch('');\n   152→  }\n   153→\n   154→  function handleTeamChange(teamId: string) {\n   155→    onFormChange({ ...formData, teamId, cycleId: null });\n   156→    setOpenDropdown(null);\n   157→  }\n   158→\n   159→  function handleLabelToggle(labelId: string) {\n   160→    const current = formData.labelIds;\n   161→    if (current.includes(labelId)) {\n   162→      updateField('labelIds', current.filter((id) => id !== labelId));\n   163→    } else {\n   164→      updateField('labelIds', [...current, labelId]);\n   165→    }\n   166→  }\n   167→\n   168→  function handleRemoveLabel(labelId: string) {\n   169→    updateField('labelIds', formData.labelIds.filter((id) => id !== labelId));\n   170→  }\n   171→\n   172→  const selectedTeam = teams.find((t) => t.id === formData.teamId);\n   173→  const selectedAssignee = teamMembers.find((m) => m.id === formData.assigneeId);\n   174→  const selectedProject = teamProjects.find((p) => p.id === formData.projectId);\n   175→  const selectedCycle = teamCycles.find((c) => c.id === formData.cycleId);\n   176→  const selectedLabels = labels.filter((l) => formData.labelIds.includes(l.id));\n   177→  const selectedParent = parentResults.find((i) => i.id === formData.parentId);\n   178→\n   179→  const filteredMembers = teamMembers.filter((m) =>\n   180→    m.name.toLowerCase().includes(assigneeSearch.toLowerCase())\n   181→  );\n   182→  const filteredProjects = teamProjects.filter((p) =>\n   183→    p.name.toLowerCase().includes(projectSearch.toLowerCase())\n   184→  );\n   185→  const filteredParents = parentResults.filter((i) =>\n   186→    !parentSearch || i.title.toLowerCase().includes(parentSearch.toLowerCase()) || i.identifier.toLowerCase().includes(parentSearch.toLowerCase())\n   187→  );\n   188→\n   189→  const statusConfig = STATUS_CONFIG[formData.status] || STATUS_CONFIG.backlog;\n   190→\n   191→  function formatDueDisplay(dateStr: string): string {\n   192→    const d = new Date(dateStr + 'T00:00:00');\n   193→    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });\n   194→  }\n   195→\n   196→  return (\n   197→    <div className=\"create-issue-form\" ref={formRef} data-testid=\"create-issue-form\">\n   198→      {/* Team Selector */}\n   199→      <div className=\"cif-field\" data-testid=\"create-issue-team-field\">\n   200→        <label className=\"cif-label\">Team</label>\n   201→        <div className=\"cif-dropdown-wrapper\">\n   202→          <button\n   203→            className=\"cif-select-btn\"\n   204→            onClick={() => toggleDropdown('team')}\n   205→            data-testid=\"create-issue-team-selector\"\n   206→          >\n   207→            <span>{selectedTeam ? selectedTeam.name : 'Select team'}</span>\n   208→            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n   209→          </button>\n   210→          {openDropdown === 'team' && (\n   211→            <div className=\"cif-dropdown\" data-testid=\"create-issue-team-dropdown\">\n   212→              {teams.map((team) => (\n   213→                <button\n   214→                  key={team.id}\n   215→                  className={`cif-dropdown-option ${formData.teamId === team.id ? 'cif-dropdown-option-active' : ''}`}\n   216→                  onClick={() => handleTeamChange(team.id)}\n   2