rogress')).toContainText('In Progress');\n    79→    await expect(page.getByTestId('team-issue-group-header-in_progress')).toContainText('(2)');\n    80→\n    81→    // Verify in_review group\n    82→    await expect(page.getByTestId('team-issue-group-in_review')).toBeVisible();\n    83→    await expect(page.getByTestId('team-issue-group-header-in_review')).toContainText('In Review');\n    84→    await expect(page.getByTestId('team-issue-group-header-in_review')).toContainText('(1)');\n    85→\n    86→    // Verify done group\n    87→    await expect(page.getByTestId('team-issue-group-done')).toBeVisible();\n    88→    await expect(page.getByTestId('team-issue-group-header-done')).toContainText('Done');\n    89→    await expect(page.getByTestId('team-issue-group-header-done')).toContainText('(1)');\n    90→\n    91→    // Verify cancelled group is NOT displayed (no cancelled issues in seed)\n    92→    await expect(page.getByTestId('team-issue-group-cancelled')).toHaveCount(0);\n    93→\n    94→    // Verify groups appear in correct status order\n    95→    const backlogBox = await page.getByTestId('team-issue-group-backlog').boundingBox();\n    96→    const todoBox = await page.getByTestId('team-issue-group-todo').boundingBox();\n    97→    const inProgressBox = await page.getByTestId('team-issue-group-in_progress').boundingBox();\n    98→    const inReviewBox = await page.getByTestId('team-issue-group-in_review').boundingBox();\n    99→    const doneBox = await page.getByTestId('team-issue-group-done').boundingBox();\n   100→    expect(backlogBox!.y).toBeLessThan(todoBox!.y);\n   101→    expect(todoBox!.y).toBeLessThan(inProgressBox!.y);\n   102→    expect(inProgressBox!.y).toBeLessThan(inReviewBox!.y);\n   103→    expect(inReviewBox!.y).toBeLessThan(doneBox!.y);\n   104→  });\n   105→\n   106→  test('Team Issues page shows all team issues, not just current user\\'s', async ({ page, baseURL }) => {\n   107→    await loginAndNavigateToTeamIssues(page, baseURL!);\n 