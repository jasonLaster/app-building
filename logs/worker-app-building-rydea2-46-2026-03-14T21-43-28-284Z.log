[2026-03-14T21:35:59.411Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0127rxYjrmJRc8LmGUbBFSRb","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test';\n     2→\n     3→// Helper to login via API and get token\n     4→async function loginViaApi(baseURL: string, email: string, password: string) {\n     5→  const response = await fetch(`${baseURL}/api/login`, {\n     6→    method: 'POST',\n     7→    headers: { 'Content-Type': 'application/json' },\n     8→    body: JSON.stringify({ email, password }),\n     9→  });\n    10→  return response.json();\n    11→}\n    12→\n    13→// Helper to create a user via signup API\n    14→async function createTestUser(baseURL: string, name: string, email: string, password: string) {\n    15→  const response = await fetch(`${baseURL}/api/signup`, {\n    16→    method: 'POST',\n    17→    headers: { 'Content-Type': 'application/json' },\n    18→    body: JSON.stringify({ name, email, password }),\n    19→  });\n    20→  return response.json();\n    21→}\n    22→\n    23→// Helper to login and navigate to /my-issues\n    24→async function loginAndNavigate(\n    25→  page: import('@playwright/test').Page,\n    26→  baseURL: string,\n    27→  email = 'alice@acme.com',\n    28→  password = 'password123'\n    29→) {\n    30→  const data = await loginViaApi(baseURL, email, password);\n    31→  await page.goto('/login');\n    32→  await page.evaluate((t) => localStorage.setItem('session_token', t), data.token);\n    33→  await page.goto('/my-issues');\n    34→  await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n    35→  return data;\n    36→}\n    37→\n    38→// Helper to get teams via API\n    39→async function getTeams(baseURL: string, token: string) {\n    40→  const response = await fetch(`${baseURL}/api/teams`, {\n    41→    headers: { Authorization: `Bearer ${token}` },\n    42→  });\n    43→  const data = await response.json();\n    44→  return data.teams;\n    45→}\n    46→\n    47→// Helper to create issue via API\n    48→async function createIssueViaApi(baseURL: string, token: string, issueData: Record<string, unknown>) {\n    49→  const response = await fetch(`${baseURL}/api/create-issue`, {\n    50→    method: 'POST',\n    51→    headers: {\n    52→      'Content-Type': 'application/json',\n    53→      Authorization: `Bearer ${token}`,\n    54→    },\n    55→    body: JSON.stringify(issueData),\n    56→  });\n    57→  return response.json();\n    58→}\n    59→\n    60→test.describe('MyIssuesList', () => {\n    61→  test('My Issues page renders with issues grouped by status', async ({ page, baseURL }) => {\n    62→    await loginAndNavigate(page, baseURL!);\n    63→\n    64→    // Alice has: todo (2 issues: ENG-6, DES-3) and in_progress (1 issue: ENG-1)\n    65→    // Verify todo group\n    66→    await expect(page.getByTestId('issue-group-todo')).toBeVisible({ timeout: 30000 });\n    67→    await expect(page.getByTestId('issue-group-header-todo')).toContainText('Todo');\n    68→    await expect(page.getByTestId('issue-group-header-todo')).toContainText('(2)');\n    69→\n    70→    // Verify in_progress group\n    71→    await expect(page.getByTestId('issue-group-in_progress')).toBeVisible();\n    72→    await expect(page.getByTestId('issue-group-header-in_progress')).toContainText('In Progress');\n    73→    await expect(page.getByTestId('issue-group-header-in_progress')).toContainText('(1)');\n    74→\n    75→    // Verify empty groups are NOT displayed\n    76→    await expect(page.getByTestId('issue-group-backlog')).toHaveCount(0);\n    77→    await expect(page.getByTestId('issue-group-in_review')).toHaveCount(0);\n    78→    await expect(page.getByTestId('issue-group-done')).toHaveCount(0);\n    79→    await expect(page.getByTestId('issue-group-cancelled')).toHaveCount(0);\n    80→\n    81→    // Verify groups appear in correct status order (todo before in_progress)\n    82→    const todoBox = await page.getByTestId('issue-group-todo').boundingBox();\n    83→    const inProgressBox = await page.getByTestId('issue-group-in_progress').boundingBox();\n    84→    expect(todoBox!.y).toBeLessThan(inProgressBox!.y);\n    85→  });\n    86→\n    87→  test('My Issues page shows empty state when no issues assigned', async ({ page, baseURL }) => {\n    88→    // Create a new user with no issues\n    89→    const email = `empty-user-${Date.now()}@test.com`;\n    90→    const data = await createTestUser(baseURL!, 'Empty User', email, 'password123');\n    91→\n    92→    await page.goto('/login');\n    93→    await page.evaluate((t) => localStorage.setItem('session_token', t), data.token);\n    94→    await page.goto('/my-issues');\n    95→    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n    96→\n    97→    // Verify empty state\n    98→    await expect(page.getByTestId('my-issues-empty')).toBeVisible({ timeout: 30000 });\n    99→    await expect(page.getByTestId('my-issues-empty')).toContainText('No issues assigned to you yet');\n   100→"}]},"parent_tool_use_id":"toolu_01VZCcEgJMeh3Ga6cQedHgo4","session_id":"dd761dfc-3c41-4aea-8240-b38c3f09e95a","uuid":"17b56d73-34c0-449e-9e53-e507e643682a"}
