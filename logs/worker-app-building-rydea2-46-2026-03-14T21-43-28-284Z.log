r\">{selectedAssignee.name.split(' ').map((n) => n[0]).join('').toUpperCase().slice(0, 2)}</span>\n   337→                <span>{selectedAssignee.name}</span>\n   338→              </>\n   339→            ) : (\n   340→              <span className=\"cif-placeholder\">No assignee</span>\n   341→            )}\n   342→            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n   343→          </button>\n   344→          {openDropdown === 'assignee' && (\n   345→            <div className=\"cif-dropdown cif-dropdown-searchable\" data-testid=\"create-issue-assignee-dropdown\">\n   346→              <input\n   347→                className=\"cif-search-input\"\n   348→                placeholder=\"Search members...\"\n   349→                value={assigneeSearch}\n   350→                onChange={(e) => setAssigneeSearch(e.target.value)}\n   351→                autoFocus\n   352→                data-testid=\"create-issue-assignee-search\"\n   353→              />\n   354→              <button\n   355→                className=\"cif-dropdown-option\"\n   356→                onClick={() => { updateField('assigneeId', null); setOpenDropdown(null); }}\n   357→                data-testid=\"create-issue-assignee-option-none\"\n   358→              >\n   359→                <span className=\"cif-avatar cif-avatar-empty\">?</span>\n   360→                <span>No assignee</span>\n   361→              </button>\n   362→              {filteredMembers.map((m) => (\n   363→                <button\n   364→                  key={m.id}\n   365→                  className={`cif-dropdown-option ${formData.assigneeId === m.id ? 'cif-dropdown-option-active' : ''}`}\n   366→                  onClick={() => { updateField('assigneeId', m.id); setOpenDropdown(null); }}\n   367→                  data-testid={`create-issue-assignee-option-${m.id}`}\n   368→                >\n   369→     