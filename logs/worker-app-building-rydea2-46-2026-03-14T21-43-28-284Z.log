[2026-03-14T21:35:52.918Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AvuL7QsebTFgQfNz46YUan","type":"tool_result","content":"     1→import { useState, useMemo } from 'react';\n     2→import { useSelector, useDispatch } from 'react-redux';\n     3→import type { RootState, AppDispatch } from '../store';\n     4→import type { TeamIssue } from '../slices/teamIssuesSlice';\n     5→import { toggleIssueSelection, selectGroupIssues } from '../slices/teamIssuesSlice';\n     6→import { STATUS_ORDER, STATUS_CONFIG, StatusIcon, PriorityIcon, PRIORITY_CONFIG } from './IssueRow';\n     7→import IssueRow from './IssueRow';\n     8→import './TeamIssuesList.css';\n     9→\n    10→const PRIORITY_ORDER = ['urgent', 'high', 'medium', 'low', 'none'] as const;\n    11→const STATUS_SORT_MAP: Record<string, number> = {};\n    12→STATUS_ORDER.forEach((s, i) => { STATUS_SORT_MAP[s] = i; });\n    13→const PRIORITY_SORT_MAP: Record<string, number> = {};\n    14→PRIORITY_ORDER.forEach((p, i) => { PRIORITY_SORT_MAP[p] = i; });\n    15→\n    16→interface IssueGroup {\n    17→  key: string;\n    18→  label: string;\n    19→  icon: React.ReactNode;\n    20→  issues: TeamIssue[];\n    21→}\n    22→\n    23→function sortIssues(issues: TeamIssue[], sortBy: string): TeamIssue[] {\n    24→  return [...issues].sort((a, b) => {\n    25→    switch (sortBy) {\n    26→      case 'priority':\n    27→        return (PRIORITY_SORT_MAP[a.priority] ?? 4) - (PRIORITY_SORT_MAP[b.priority] ?? 4);\n    28→      case 'created':\n    29→        return new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();\n    30→      case 'updated':\n    31→        return new Date(b.updatedAt).getTime() - new Date(a.updatedAt).getTime();\n    32→      case 'status':\n    33→        return (STATUS_SORT_MAP[a.status] ?? 0) - (STATUS_SORT_MAP[b.status] ?? 0);\n    34→      default:\n    35→        return 0;\n    36→    }\n    37→  });\n    38→}\n    39→\n    40→function getInitials(name: string): string {\n    41→  return name.split(' ').map((n) => n[0]).join('').toUpperCase().slice(0, 2);\n    42→}\n    43→\n    44→interface TeamIssuesListProps {\n    45→  issues: TeamIssue[];\n    46→  loading: boolean;\n    47→}\n    48→\n    49→export default function TeamIssuesList({ issues, loading }: TeamIssuesListProps) {\n    50→  const dispatch = useDispatch<AppDispatch>();\n    51→  const { selectedIds, groupBy, sortBy, members } = useSelector((state: RootState) => state.teamIssues);\n    52→  const [collapsedGroups, setCollapsedGroups] = useState<Record<string, boolean>>({});\n    53→\n    54→  const groups: IssueGroup[] = useMemo(() => {\n    55→    const sorted = sortIssues(issues, sortBy);\n    56→\n    57→    if (groupBy === 'none') {\n    58→      return [{\n    59→        key: 'all',\n    60→        label: '',\n    61→        icon: null,\n    62→        issues: sorted,\n    63→      }];\n    64→    }\n    65→\n    66→    if (groupBy === 'status') {\n    67→      const result: IssueGroup[] = [];\n    68→      for (const status of STATUS_ORDER) {\n    69→        const cfg = STATUS_CONFIG[status];\n    70→        const groupIssues = sorted.filter((i) => i.status === status);\n    71→        if (groupIssues.length > 0) {\n    72→          result.push({\n    73→            key: status,\n    74→            label: cfg.label,\n    75→            icon: <StatusIcon status={status} color={cfg.color} />,\n    76→            issues: groupIssues,\n    77→          });\n    78→        }\n    79→      }\n    80→      return result;\n    81→    }\n    82→\n    83→    if (groupBy === 'priority') {\n    84→      const result: IssueGroup[] = [];\n    85→      for (const priority of PRIORITY_ORDER) {\n    86→        const cfg = PRIORITY_CONFIG[priority];\n    87→        const groupIssues = sorted.filter((i) => i.priority === priority);\n    88→        if (groupIssues.length > 0) {\n    89→          result.push({\n    90→            key: priority,\n    91→            label: cfg.label,\n    92→            icon: <PriorityIcon priority={priority} />,\n    93→            issues: groupIssues,\n    94→          });\n    95→        }\n    96→      }\n    97→      return result;\n    98→    }\n    99→\n   100→    if (groupBy === 'assignee') {\n   101→      const result: IssueGroup[] = [];\n   102→      const assigneeMap = new Map<string, { name: string; issues: TeamIssue[] }>();\n   103→\n   104→      for (const m of members) {\n   105→        assigneeMap.set(m.id, { name: m.name, issues: [] });\n   106→      }\n   107→      assigneeMap.set('unassigned', { name: 'Unassigned', issues: [] });\n   108→\n   109→      for (const issue of sorted) {\n   110→        const key = issue.assigneeId || 'unassigned';\n   111→        const entry = assigneeMap.get(key);\n   112→        if (entry) {\n   113→          entry.issues.push(issue);\n   114→        } else {\n   115→          assigneeMap.set(key, { name: issue.assigneeName || 'Unknown', issues: [issue] });\n   116→        }\n   117→      }\n   118→\n   119→      for (const [key, entry] of assigneeMap.entries()) {\n   120→        if (entry.issues.length > 0) {\n   121→          result.push({\n   122→            key,\n   123→            label: entry.name,\n   124→            icon: key === 'unassigned' ? (\n   125→              <span className=\"team-issues-list-avatar team-issues-list-avatar-empty\">?</span>\n   126→            ) : (\n   127→              <span className=\"team-issues-list-avatar\">{getInitials(entry.name)}</span>\n   128→            ),\n   129→            issues: entry.issues,\n   130→          });\n   131→        }\n   132→      }\n   133→      return result;\n   134→    }\n   135→\n   136→    if (groupBy === 'project') {\n   137→      const result: IssueGroup[] = [];\n   138→      const projectMap = new Map<string, { name: string; issues: TeamIssue[] }>();\n   139→\n   140→      projectMap.set('none', { name: 'No Project', issues: [] });\n   141→\n   142→      for (const issue of sorted) {\n   143→        const key = issue.projectId || 'none';\n   144→        const entry = projectMap.get(key);\n   145→        if (entry) {\n   146→          entry.issues.push(issue);\n   147→        } else {\n   148→          projectMap.set(key, { name: issue.projectName || 'Unknown', issues: [issue] });\n   149→        }\n   150→      }\n   151→\n   152→      for (const [key, entry] of projectMap.entries()) {\n   153→        if (entry.issues.length > 0) {\n   154→          result.push({\n   155→            key,\n   156→            label: entry.name,\n   157→            icon: (\n   158→              <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--color-text-tertiary)\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n   159→                <path d=\"M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z\" />\n   160→              </svg>\n   161→            ),\n   162→            issues: entry.issues,\n   163→          });\n   164→        }\n   165→      }\n   166→      return result;\n   167→    }\n   168→\n   169→    if (groupBy === 'label') {\n   170→      const result: IssueGroup[] = [];\n   171→      const labelMap = new Map<string, { name: string; color: string; issues: TeamIssue[] }>();\n   172→\n   173→      labelMap.set('none', { name: 'No Label', color: 'var(--color-text-tertiary)', issues: [] });\n   174→\n   175→      for (const issue of sorted) {\n   176→        if (issue.labels.length === 0) {\n   177→          labelMap.get('none')!.issues.push(issue);\n   178→        } else {\n   179→          for (const label of issue.labels) {\n   180→            const entry = labelMap.get(label.id);\n   181→            if (entry) {\n   182→              entry.issues.push(issue);\n   183→            } else {\n   184→              labelMap.set(label.id, { name: label.name, color: label.color, issues: [issue] });\n   185→            }\n   186→          }\n   187→        }\n   188→      }\n 