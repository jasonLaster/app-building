lassName=\"cif-label\">Cycle</label>\n   480→        <div className=\"cif-dropdown-wrapper\">\n   481→          <button\n   482→            className=\"cif-select-btn\"\n   483→            onClick={() => toggleDropdown('cycle')}\n   484→            data-testid=\"create-issue-cycle-selector\"\n   485→          >\n   486→            <span className={selectedCycle ? '' : 'cif-placeholder'}>\n   487→              {selectedCycle ? selectedCycle.name : 'No cycle'}\n   488→            </span>\n   489→            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n   490→          </button>\n   491→          {openDropdown === 'cycle' && (\n   492→            <div className=\"cif-dropdown\" data-testid=\"create-issue-cycle-dropdown\">\n   493→              <button\n   494→                className=\"cif-dropdown-option\"\n   495→                onClick={() => { updateField('cycleId', null); setOpenDropdown(null); }}\n   496→                data-testid=\"create-issue-cycle-option-none\"\n   497→              >\n   498→                <span>No cycle</span>\n   499→              </button>\n   500→              {teamCycles.map((c) => {\n   501→                const now = new Date();\n   502→                const start = new Date(c.start_date);\n   503→                const end = new Date(c.end_date);\n   504→                const isActive = now >= start && now <= end;\n   505→                return (\n   506→                  <button\n   507→                    key={c.id}\n   508→                    className={`cif-dropdown-option ${formData.cycleId === c.id ? 'cif-dropdown-option-active' : ''}`}\n   509→                    onClick={() => { updateField('cycleId', c.id); setOpenDropdown(null); }}\n   510→                    data-testid={`create-issue-cycle-option-${c.id}`}\n   511→                  >\n   512→                    <span>{c.name}</span>\n   513→                    