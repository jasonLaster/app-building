[2026-03-14T20:56:46.340Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VxwvvAWPqo4zVW1riRvypt","type":"tool_result","content":"     1→import { execSync } from 'child_process'\n     2→import { writeFileSync, readFileSync, mkdirSync, existsSync } from 'fs'\n     3→import { join } from 'path'\n     4→import { initSchema } from './schema.js'\n     5→import { seedDatabase } from './seed-db.js'\n     6→\n     7→const appDir = join(import.meta.dirname, '..')\n     8→const logsDir = join(appDir, 'logs')\n     9→const envPath = join(appDir, '.env')\n    10→const logFile = join(logsDir, 'deploy.log')\n    11→\n    12→mkdirSync(logsDir, { recursive: true })\n    13→\n    14→function loadDotEnv(): void {\n    15→  if (!existsSync(envPath)) return\n    16→  const lines = readFileSync(envPath, 'utf-8').split('\\n')\n    17→  for (const line of lines) {\n    18→    const trimmed = line.trim()\n    19→    if (!trimmed || trimmed.startsWith('#')) continue\n    20→    const eqIdx = trimmed.indexOf('=')\n    21→    if (eqIdx === -1) continue\n    22→    const key = trimmed.slice(0, eqIdx).trim()\n    23→    const value = trimmed.slice(eqIdx + 1).trim().replace(/^[\"']|[\"']$/g, '')\n    24→    if (!process.env[key]) process.env[key] = value\n    25→  }\n    26→}\n    27→\n    28→function getEnvVar(name: string): string {\n    29→  const val = process.env[name]\n    30→  if (!val) { console.error(`Missing required env var: ${name}`); process.exit(1) }\n    31→  return val\n    32→}\n    33→\n    34→function appendEnv(key: string, value: string): void {\n    35→  const content = existsSync(envPath) ? readFileSync(envPath, 'utf-8') : ''\n    36→  if (content.includes(`${key}=`)) {\n    37→    const updated = content.replace(new RegExp(`^${key}=.*$`, 'm'), `${key}=${value}`)\n    38→    writeFileSync(envPath, updated)\n    39→  } else {\n    40→    writeFileSync(envPath, content + (content.endsWith('\\n') || content === '' ? '' : '\\n') + `${key}=${value}\\n`)\n    41→  }\n    42→  process.env[key] = value\n    43→}\n    44→\n    45→async function neonApi(method: string, path: string, body?: unknown): Promise<unknown> {\n    46→  const apiKey = getEnvVar('NEON_API_KEY')\n    47→  const res = await fetch(`https://console.neon.tech/api/v2${path}`, {\n    48→    method,\n    49→    headers: { Authorization: `Bearer ${apiKey}`, 'Content-Type': 'application/json' },\n    50→    body: body ? JSON.stringify(body) : undefined,\n    51→  })\n    52→  if (!res.ok) throw new Error(`Neon API ${method} ${path} failed (${res.status}): ${await res.text()}`)\n    53→  const ct = res.headers.get('content-type')\n    54→  if (ct?.includes('application/json')) return res.json()\n    55→  return null\n    56→}\n    57→\n    58→async function main(): Promise<void> {\n    59→  loadDotEnv()\n    60→  let output = ''\n    61→  let isFirstDeploy = false\n    62→\n    63→  // Step 1: Database setup\n    64→  if (!process.env['NEON_PROJECT_ID']) {\n    65→    isFirstDeploy = true\n    66→    const data = await neonApi('POST', '/projects', { project: { name: 'linear-clone' } }) as {\n    67→      project: { id: string }\n    68→      connection_uris: Array<{ connection_uri: string }>\n    69→    }\n    70→    const projectId = data.project.id\n    71→    const dbUrl = data.connection_uris[0]?.connection_uri\n    72→    if (!dbUrl) throw new Error('No connection URI in project creation response')\n    73→    appendEnv('NEON_PROJECT_ID', projectId)\n    74→    appendEnv('DATABASE_URL', dbUrl)\n    75→    output += `Created Neon project: ${projectId}\\n`\n    76→  }\n    77→\n    78→  // Step 2: Schema sync\n    79→  const dbUrl = getEnvVar('DATABASE_URL')\n    80→  await initSchema(dbUrl)\n    81→  output += 'Schema synchronized\\n'\n    82→\n    83→  // Step 4: Seed on first deploy\n    84→  if (isFirstDeploy) {\n    85→    await seedDatabase(dbUrl)\n    86→    output += 'Database seeded\\n'\n    87→  }\n    88→\n    89→  // Step 5: Netlify site setup\n    90→  if (!process.env['NETLIFY_SITE_ID']) {\n    91→    const slug = getEnvVar('NETLIFY_ACCOUNT_SLUG')\n    92→    const siteName = `linear-clone-${Date.now()}`\n    93→    try {\n    94→      const createOutput = execSync(\n    95→        `LC_ALL=C npx netlify sites:create --account-slug ${slug} --name ${siteName}`,\n    96→        { cwd: appDir, encoding: 'utf-8', stdio: 'pipe' }\n    97→      )\n    98→      output += createOutput + '\\n'\n    99→      // Extract site ID from output\n   100→      const siteIdMatch = createOutput.match(/Site ID:\\s+([a-f0-9-]+)/i)\n   101→        || createOutput.match(/\"site_id\":\\s*\"([^\"]+)\"/)\n   102→        || createOutput.match(/([a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12})/)\n   103→      if (siteIdMatch?.[1]) {\n   104→        appendEnv('NETLIFY_SITE_ID', siteIdMatch[1])\n   105→      } else {\n   106→        throw new Error('Could not extract site ID from netlify sites:create output')\n   107→      }\n   108→    } catch (e: unknown) {\n   109→      const err = e as { stdout?: string; stderr?: string }\n   110→      output += (err.stdout || '') + (err.stderr || '') + '\\n'\n   111→      writeFileSync(logFile, output)\n   112→      console.log('Deploy failed (netlify site creation) — see logs/deploy.log')\n   113→      process.exit(1)\n   114→    }\n   115→  }\n   116→\n   117→  const siteId = getEnvVar('NETLIFY_SITE_ID')\n   118→\n   119→  // Link site\n   120→  try {\n   121→    execSync(`npx netlify link --id ${siteId}`, { cwd: appDir, stdio: 'pipe' })\n   122→  } catch { /* may already be linked */ }\n   123→\n   124→  // Step 6: Build\n   125→  try {\n   126→    const buildOutput = execSync('npx vite build', { cwd: appDir, encoding: 'utf-8', stdio: 'pipe' })\n   127→    output += '=== Build ===\\n' + buildOutput + '\\n'\n   128→  } catch (e: unknown) {\n   129→    const err = e as { stdout?: string; stderr?: string }\n   130→    output += '=== Build ===\\n' + (err.stdout || '') + (err.stderr || '') + '\\n'\n   131→    writeFileSync(logFile, output)\n   132→    console.log('Deploy failed (build) — see logs/deploy.log')\n   133→    process.exit(1)\n   134→  }\n   135→\n   136→  // Step 7: Deploy\n   137→  try {\n   138→    const deployOutput = execSync(\n   139→      `LC_ALL=C npx netlify deploy --prod --dir dist --functions ./netlify/functions --site ${siteId}`,\n   140→      { cwd: appDir, encoding: 'utf-8', stdio: 'pipe' }\n   141→    )\n   142→    output += '=== Deploy ===\\n' + deployOutput + '\\n'\n   143→\n   144→    // Extract URL\n   145→    const urlMatch = deployOutput.match(/Website URL:\\s+(https?:\\/\\/\\S+)/i)\n   146→      || deployOutput.match(/(https:\\/\\/[^\\s]+\\.netlify\\.app)/i)\n   147→    const deployedUrl = urlMatch?.[1] || 'unknown'\n   148→\n   149→    // Step 8: Write deployment.txt\n   150→    const deploymentInfo = `url=${deployedUrl}\\nsite_id=${siteId}\\nneon_project_id=${getEnvVar('NEON_PROJECT_ID')}\\ndatabase_url=${dbUrl}\\n`\n   151→    const deploymentPath = join(appDir, 'deployment.txt')\n   152→    const existingDeployment = existsSync(deploymentPath) ? readFileSync(deploymentPath, 'utf-8') : ''\n   153→    const historyStart = existingDeployment.indexOf('\\n---')\n   154→    const history = historyStart >= 0 ? existingDeployment.slice(historyStart) : ''\n   155→    writeFileSync(deploymentPath, deploymentInfo + history)\n   156→\n   157→    writeFileSync(logFile, output)\n   158→    console.log(`Deployed to ${deployedUrl}`)\n   159→  } catch (e: unknown) {\n   160→    const err = e as { stdout?: string; stderr?: string }\n   161→    output += '=== Deploy ===\\n' + (err.stdout || '') + (err.stderr || '') + '\\n'\n   162→    writeFileSync(logFile, output)\n   163→    console.log('Deploy failed (netlify) — see logs/deploy.log')\n   164→    process.exit(1)\n   165→  }\n   166→}\n   167→\n   168→main()\n   169→"}]},"parent_tool_use_id":null,"session_id":"1df8f68e-c3f5-4476-ab07-9c768497602b","uuid":"1601b290-989a-45cd-aad1-79c27fc1855f","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/scripts/deploy.ts","content":"import { execSync } from 'child_process'\nimport { writeFileSync, readFileSync, mkdirSync, existsSync } from 'fs'\nimport { join } from 'path'\nimport { initSchema } from './schema.js'\nimport { seedDatabase } from './seed-db.js'\n\nconst appDir = join(import.meta.dirname, '..')\nconst logsDir = join(appDir, 'logs')\nconst envPath = join(appDir, '.env')\nconst logFile = join(logsDir, 'deploy.log')\n\nmkdirSync(logsDir, { recursive: true })\n\nfunction loadDotEnv(): void {\n  if (!existsSync(envPath)) return\n  const lines = readFileSync(envPath, 'utf-8').split('\\n')\n  for (const line of lines) {\n    const trimmed = line.trim()\n    if (!trimmed || trimmed.startsWith('#')) continue\n    const eqIdx = trimmed.indexOf('=')\n    if (eqIdx === -1) continue\n    const key = trimmed.slice(0, eqIdx).trim()\n    const value = trimmed.slice(eqIdx + 1).trim().replace(/^[\"']|[\"']$/g, '')\n    if (!process.env[key]) process.env[key] = value\n  }\n}\n\nfunction getEnvVar(name: string): string {\n  const val = process.env[name]\n  if (!val) { console.error(`Missing required env var: ${name}`); process.exit(1) }\n  return val\n}\n\nfunction appendEnv(key: string, value: string): void {\n  const content = existsSync(envPath) ? readFileSync(envPath, 'utf-8') : ''\n  if (content.includes(`${key}=`)) {\n    const updated = content.replace(new RegExp(`^${key}=.*$`, 'm'), `${key}=${value}`)\n    writeFileSync(envPath, updated)\n  } else {\n    writeFileSync(envPath, content + (content.endsWith('\\n') || content === '' ? '' : '\\n') + `${key}=${value}\\n`)\n  }\n  process.env[key] = value\n}\n\nasync function neonApi(method: string, path: string, body?: unknown): Promise<unknown> {\n  const apiKey = getEnvVar('NEON_API_KEY')\n  const res = await fetch(`https://console.neon.tech/api/v2${path}`, {\n    method,\n    headers: { Authorization: `Bearer ${apiKey}`, 'Content-Type': 'application/json' },\n    body: body ? JSON.stringify(body) : undefined,\n  })\n  if (!res.ok) throw new Error(`Neon API ${method} ${path} failed (${res.status}): ${await res.text()}`)\n  const ct = res.headers.get('content-type')\n  if (ct?.includes('application/json')) return res.json()\n  return null\n}\n\nasync function main(): Promise<void> {\n  loadDotEnv()\n  let output = ''\n  let isFirstDeploy = false\n\n  // Step 1: Database setup\n  if (!process.env['NEON_PROJECT_ID']) {\n    isFirstDeploy = true\n    const data = await neonApi('POST', '/projects', { project: { name: 'linear-clone' } }) as {\n      project: { id: string }\n      connection_uris: Array<{ connection_uri: string }>\n    }\n    const projectId = data.project.id\n    const dbUrl = data.connection_uris[0]?.connection_uri\n    if (!dbUrl) throw new Error('No connection URI in project creation response')\n    appendEnv('NEON_PROJECT_ID', projectId)\n    appendEnv('DATABASE_URL', dbUrl)\n    output += `Created Neon project: ${projectId}\\n`\n  }\n\n  // Step 2: Schema sync\n  const dbUrl = getEnvVar('DATABASE_URL')\n  await initSchema(dbUrl)\n  output += 'Schema synchronized\\n'\n\n  // Step 4: Seed on first deploy\n  if (isFirstDeploy) {\n    await seedDatabase(dbUrl)\n    output += 'Database seeded\\n'\n  }\n\n  // Step 5: Netlify site setup\n  if (!process.env['NETLIFY_SITE_ID']) {\n    const slug = getEnvVar('NETLIFY_ACCOUNT_SLUG')\n    const siteName = `linear-clone-${Date.now()}`\n    try {\n      const createOutput = execSync(\n        `LC_ALL=C npx netlify sites:create --account-slug ${slug} --name ${siteName}`,\n        { cwd: appDir, encoding: 'utf-8', stdio: 'pipe' }\n      )\n      output += createOutput + '\\n'\n      // Extract site ID from output\n      const siteIdMatch = createOutput.match(/Site ID:\\s+([a-f0-9-]+)/i)\n        || createOutput.match(/\"site_id\":\\s*\"([^\"]+)\"/)\n        || createOutput.match(/([a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12})/)\n      if (siteIdMatch?.[1]) {\n        appendEnv('NETLIFY_SITE_ID', siteIdMatch[1])\n      } else {\n        throw new Error('Could not extract site ID from netlify sites:create output')\n      }\n    } catch (e: unknown) {\n      const err = e as { stdout?: string; stderr?: string }\n      output += (err.stdout || '') + (err.stderr || '') + '\\n'\n      writeFileSync(logFile, output)\n      console.log('Deploy failed (netlify site creation) — see logs/deploy.log')\n      process.exit(1)\n    }\n  }\n\n  const siteId = getEnvVar('NETLIFY_SITE_ID')\n\n  // Link site\n  try {\n    execSync(`npx netlify link --id ${siteId}`, { cwd: appDir, stdio: 'pipe' })\n  } catch { /* may already be linked */ }\n\n  // Step 6: Build\n  try {\n    const buildOutput = execSync('npx vite build', { cwd: appDir, encoding: 'utf-8', stdio: 'pipe' })\n    output += '=== Build ===\\n' + buildOutput + '\\n'\n  } catch (e: unknown) {\n    const err = e as { stdout?: string; stderr?: string }\n    output += '=== Build ===\\n' + (err.stdout || '') + (err.stderr || '') + '\\n'\n    writeFileSync(logFile, output)\n    console.log('Deploy failed (build) — see logs/deploy.log')\n    process.exit(1)\n  }\n\n  // Step 7: Deploy\n  try {\n    const deployOutput = execSync(\n      `LC_ALL=C npx netlify deploy --prod --dir dist --functions ./netlify/functions --site ${siteId}`,\n      { cwd: appDir, encoding: 'utf-8', stdio: 'pipe' }\n    )\n    output += '=== Deploy ===\\n' + deployOutput + '\\n'\n\n    // Extract URL\n    const urlMatch = deployOutput.match(/Website URL:\\s+(https?:\\/\\/\\S+)/i)\n      || deployOutput.match(/(https:\\/\\/[^\\s]+\\.netlify\\.app)/i)\n    const deployedUrl = urlMatch?.[1] || 'unknown'\n\n    // Step 8: Write deployment.txt\n    const deploymentInfo = `url=${deployedUrl}\\nsite_id=${siteId}\\nneon_project_id=${getEnvVar('NEON_PROJECT_ID')}\\ndatabase_url=${dbUrl}\\n`\n    const deploymentPath = join(appDir, 'deployment.txt')\n    const existingDeployment = existsSync(deploymentPath) ? readFileSync(deploymentPath, 'utf-8') : ''\n    const historyStart = existingDeployment.indexOf('\\n---')\n    const history = historyStart >= 0 ? existingDeployment.slice(historyStart) : ''\n    writeFileSync(deploymentPath, deploymentInfo + history)\n\n    writeFileSync(logFile, output)\n    console.log(`Deployed to ${deployedUrl}`)\n  } catch (e: unknown) {\n    const err = e as { stdout?: string; stderr?: string }\n    output += '=== Deploy ===\\n' + (err.stdout || '') + (err.stderr || '') + '\\n'\n    writeFileSync(logFile, output)\n    console.log('Deploy failed (netlify) — see logs/deploy.log')\n    process.exit(1)\n  }\n}\n\nmain()\n","numLines":169,"startLine":1,"totalLines":169}}}
