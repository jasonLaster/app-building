ancel the confirmed booking e6666666\n    37→    const cancelBtn = page.getByTestId('cancel-button-e6666666-6666-6666-6666-666666666666')\n    38→    await expect(cancelBtn).toBeVisible({ timeout: 30000 })\n    39→    await cancelBtn.click()\n    40→\n    41→    await expect(page.getByTestId('cancel-dialog')).toBeVisible({ timeout: 30000 })\n    42→    await page.getByTestId('cancel-dialog-confirm').click()\n    43→\n    44→    // Dialog should close\n    45→    await expect(page.getByTestId('cancel-dialog')).not.toBeVisible({ timeout: 30000 })\n    46→\n    47→    // Booking should no longer be in Upcoming tab\n    48→    await expect(page.getByTestId('trip-card-e6666666-6666-6666-6666-666666666666')).not.toBeVisible({ timeout: 30000 })\n    49→\n    50→    // Switch to Cancelled tab - booking should appear there with cancelled status\n    51→    await page.getByTestId('tab-cancelled').click()\n    52→    await expect(page.getByTestId('trip-card-e6666666-6666-6666-6666-666666666666')).toBeVisible({ timeout: 30000 })\n    53→    await expect(page.getByTestId('status-badge-e6666666-6666-6666-6666-666666666666')).toHaveText('Cancelled')\n    54→  })\n    55→\n    56→  test('Dismissing cancellation dialog keeps booking unchanged', async ({ page }) => {\n    57→    await loginAs(page, 'emma@example.com')\n    58→    await page.goto('/trips')\n    59→    await expect(page.getByTestId('my-trips-page')).toBeVisible({ timeout: 30000 })\n    60→\n    61→    // Open cancel dialog for pending booking e3333333\n    62→    const cancelBtn = page.getByTestId('cancel-button-e3333333-3333-3333-3333-333333333333')\n    63→    await expect(cancelBtn).toBeVisible({ timeout: 30000 })\n    64→    await cancelBtn.click()\n    65→\n    66→    await expect(page.getByTestId('cancel-dialog')).toBeVisible({ timeout: 30000 })\n    67→\n    68→    // Click Keep Booking to dismiss\n    69→    await page.getByTestId('cancel-dialog-dismiss').click()\n    70→\n    71→    // Dialog should close\n   