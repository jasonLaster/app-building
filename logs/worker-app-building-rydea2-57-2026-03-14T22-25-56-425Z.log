 string) {\n    41→    setExpandedTeams((prev) => ({ ...prev, [teamId]: !prev[teamId] }));\n    42→  }\n    43→\n    44→  function isActive(path: string) {\n    45→    return location.pathname === path;\n    46→  }\n    47→\n    48→  function isTeamActive(teamId: string, sub: string) {\n    49→    return location.pathname === `/team/${teamId}/${sub}`;\n    50→  }\n    51→\n    52→  return (\n    53→    <aside\n    54→      className={`sidebar ${sidebarCollapsed ? 'sidebar-collapsed' : ''}`}\n    55→      data-testid=\"sidebar\"\n    56→    >\n    57→      <div className=\"sidebar-header\">\n    58→        <Link\n    59→          to=\"/my-issues\"\n    60→          className=\"sidebar-workspace-name\"\n    61→          data-testid=\"sidebar-workspace-name\"\n    62→          title={workspace?.name || 'Workspace'}\n    63→        >\n    64→          <span className=\"sidebar-workspace-icon\">\n    65→            <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\">\n    66→              <rect width=\"16\" height=\"16\" rx=\"4\" fill=\"var(--color-accent)\" />\n    67→              <text x=\"8\" y=\"11.5\" textAnchor=\"middle\" fill=\"#fff\" fontSize=\"9\" fontWeight=\"600\">\n    68→                {workspace?.name?.[0]?.toUpperCase() || 'W'}\n    69→              </text>\n    70→            </svg>\n    71→          </span>\n    72→          {!sidebarCollapsed && (\n    73→            <span className=\"sidebar-workspace-label\">{workspace?.name || 'Workspace'}</span>\n    74→          )}\n    75→        </Link>\n    76→        <SidebarCollapse />\n    77→      </div>\n    78→\n    79→      <nav className=\"sidebar-nav\" data-testid=\"sidebar-nav\">\n    80→        <div className=\"sidebar-section\">\n    81→          <Link\n    82→            to=\"/my-issues\"\n    83→            className={`sidebar-link ${isActive('/my-issues') ? 'sidebar-link-active' : ''}`}\n    84→            data-testid=\"sidebar-link-my-issues\"\n    85→            title=\"My Issu