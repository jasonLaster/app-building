    EXCEPTION WHEN duplicate_object THEN NULL;\n    54→    END $$\n    55→  `;\n    56→\n    57→  // Team members\n    58→  await sql`\n    59→    CREATE TABLE IF NOT EXISTS team_members (\n    60→      team_id UUID NOT NULL REFERENCES teams(id) ON DELETE CASCADE,\n    61→      member_id UUID NOT NULL REFERENCES members(id) ON DELETE CASCADE,\n    62→      PRIMARY KEY (team_id, member_id)\n    63→    )\n    64→  `;\n    65→\n    66→  // Labels\n    67→  await sql`\n    68→    CREATE TABLE IF NOT EXISTS labels (\n    69→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    70→      name TEXT NOT NULL UNIQUE,\n    71→      color TEXT NOT NULL\n    72→    )\n    73→  `;\n    74→\n    75→  // Projects\n    76→  await sql`\n    77→    CREATE TABLE IF NOT EXISTS projects (\n    78→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    79→      name TEXT NOT NULL,\n    80→      description TEXT,\n    81→      status TEXT NOT NULL DEFAULT 'planned',\n    82→      target_date DATE,\n    83→      lead_id UUID REFERENCES members(id) ON DELETE SET NULL,\n    84→      created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()\n    85→    )\n    86→  `;\n    87→\n    88→  // Cycles\n    89→  await sql`\n    90→    CREATE TABLE IF NOT EXISTS cycles (\n    91→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    92→      name TEXT NOT NULL,\n    93→      start_date DATE NOT NULL,\n    94→      end_date DATE NOT NULL,\n    95→      team_id UUID NOT NULL REFERENCES teams(id) ON DELETE CASCADE,\n    96→      status TEXT DEFAULT 'active'\n    97→    )\n    98→  `;\n    99→\n   100→  // Issues\n   101→  await sql`\n   102→    CREATE TABLE IF NOT EXISTS issues (\n   103→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n   104→      team_id UUID NOT NULL REFERENCES teams(id) ON DELETE CASCADE,\n   105→      title TEXT NOT NULL,\n   106→      description TEXT,\n   107→      status TEXT NOT NULL DEFAULT 'backlog',\n   108→      priority TEXT NOT NULL DEFAULT 'none',\n   109→      number INT NOT NULL,\n   110→      due_date DATE,\n   111→      assignee_id UUID REFERENCES members(id) ON DELETE SET NULL,\n   112→      project_id UUID REFERENCES projects(id) ON DELETE SET NULL,\n   113→      cycle_id UUID REFERENCES cycles(id) ON DELETE SET NULL,\n   114→      parent_id UUID REFERENCES issues(id) ON DELETE SET NULL,\n   115→      created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),\n   116→      updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()\n   117→    )\n   118→  `;\n   119→\n   120→  // Issue labels junction\n   121→  await sql`\n   122→    CREATE TABLE IF NOT EXISTS issue_labels (\n   123→      issue_id UUID NOT NULL REFERENCES issues(id) ON DELETE CASCADE,\n   124→      label_id UUID NOT NULL REFERENCES labels(id) ON DELETE CASCADE,\n   125→      PRIMARY KEY (issue_id, label_id)\n   126→    )\n   127→  `;\n   128→\n   129→  // Comments\n   130→  await sql`\n   131→    CREATE TABLE IF NOT EXISTS comments (\n   132→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n   133→      issue_id UUID NOT NULL REFERENCES issues(id) ON DELETE CASCADE,\n   134→      member_id UUID NOT NULL REFERENCES members(id) ON DELETE CASCADE,\n   135→      content TEXT NOT NULL,\n   136→      created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()\n   137→    )\n   138→  `;\n   139→\n   140→  // Activity log\n   141→  await sql`\n   142→    CREATE TABLE IF NOT EXISTS activity (\n   143→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n   144→      issue_id UUID NOT NULL REFERENCES issues(id) ON DELETE CASCADE,\n   145→      member_id UUID REFERENCES members(id) ON DELETE SET NULL,\n   146→      action TEXT NOT NULL,\n   147→      field TEXT,\n   148→      new_value TEXT,\n   149→      created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()\n   150→    )"}]},"parent_tool_use_id":"toolu_012kLD1GUfniyzar3nVmFaAY","session_id":"7db18531-1ab9-4e3d-8311-bcfa64f59629","uuid":"1191faa2-d748-4809-9e7e-ba045e0bdf67"}
