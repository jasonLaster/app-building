    49→test.describe('Home Page - Pagination', () => {\n    50→  test.beforeEach(async () => {\n    51→    await cleanupTestProperties()\n    52→  })\n    53→\n    54→  test.describe('Multi-page tests', () => {\n    55→    // Seed has 5 properties, create 30 more for 35 total (3 pages of 12)\n    56→    test.beforeEach(async () => {\n    57→      await seedExtraProperties(30)\n    58→    })\n    59→\n    60→    test('Pagination controls are displayed when results exceed one page', async ({ page }) => {\n    61→      await page.goto('/')\n    62→      await expect(page.locator('[data-testid^=\"property-card-\"]').first()).toBeVisible({ timeout: 30000 })\n    63→\n    64→      await expect(page.getByTestId('pagination')).toBeVisible()\n    65→      await expect(page.getByTestId('pagination-previous')).toBeVisible()\n    66→      await expect(page.getByTestId('pagination-next')).toBeVisible()\n    67→      await expect(page.getByTestId('pagination-page-1')).toBeVisible()\n    68→      await expect(page.getByTestId('pagination-page-2')).toBeVisible()\n    69→    })\n    70→\n    71→    test('Clicking Next page loads the next set of properties', async ({ page }) => {\n    72→      await page.goto('/')\n    73→      await expect(page.locator('[data-testid^=\"property-card-\"]').first()).toBeVisible({ timeout: 30000 })\n    74→\n    75→      // Verify we start on page 1 with 12 cards\n    76→      await expect(page.locator('[data-testid^=\"property-card-\"]')).toHaveCount(12, { timeout: 15000 })\n    77→\n    78→      // Click Next\n    79→      await page.getByTestId('pagination-next').click()\n    80→\n    81→      // Verify page 2 is now active\n    82→      await expect(page.getByTestId('pagination-page-2')).toHaveClass(/bg-text/, { timeout: 15000 })\n    83→\n    84→      // Previous button should now be enabled\n    85→      await expect(page.getByTestId('pagination-previous')).toBeEnabled()\n    86→\n    87→      // Page 2 should have cards loaded\n    88→      awai