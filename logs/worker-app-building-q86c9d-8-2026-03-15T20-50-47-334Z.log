l.searchParams.get('user_id')\n    42→    if (!propertyId || !userId) {\n    43→      return new Response(JSON.stringify({ error: 'propertyId and user_id are required' }), { status: 400, headers })\n    44→    }\n    45→    await sql`\n    46→      DELETE FROM favorites WHERE user_id = ${userId} AND property_id = ${propertyId}\n    47→    `\n    48→    return new Response(JSON.stringify({ success: true }), { status: 200, headers })\n    49→  }\n    50→\n    51→  return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers })\n    52→}\n    53→"}]},"parent_tool_use_id":"toolu_01U1ePQWC4iw1hQybMSzUsLM","session_id":"9bffb10d-41eb-4f04-b786-b79afb133992","uuid":"5008017b-98bf-4860-bfca-e346466ea26a"}
