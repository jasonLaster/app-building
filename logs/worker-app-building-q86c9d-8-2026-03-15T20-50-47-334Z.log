  <div className=\"flex items-start justify-between gap-1\">\n    43→          <h3 className=\"font-semibold text-text text-[15px] leading-tight truncate\">\n    44→            {property.city}, {property.country}\n    45→          </h3>\n    46→          {reviewCount > 0 ? (\n    47→            <div className=\"flex items-center gap-1 shrink-0\">\n    48→              <Star size={12} className=\"fill-text text-text\" />\n    49→              <span className=\"text-sm text-text\">{rating.toFixed(2)}</span>\n    50→              <span className=\"text-sm text-text-secondary\">({reviewCount})</span>\n    51→            </div>\n    52→          ) : (\n    53→            <span className=\"text-sm text-text-secondary shrink-0\">New</span>\n    54→          )}\n    55→        </div>\n    56→        <p className=\"text-text-secondary text-sm mt-0.5 truncate\">{property.title}</p>\n    57→        <p className=\"text-text-secondary text-sm\">\n    58→          {property.beds} {property.beds === 1 ? 'bed' : 'beds'}\n    59→        </p>\n    60→        <p className=\"mt-1 text-[15px]\">\n    61→          <span className=\"font-semibold text-text\">${Number(property.price_per_night).toFixed(0)}</span>\n    62→          <span className=\"text-text\"> / night</span>\n    63→        </p>\n    64→      </div>\n    65→    </div>\n    66→  )\n    67→}\n    68→"}]},"parent_tool_use_id":null,"session_id":"9bffb10d-41eb-4f04-b786-b79afb133992","uuid":"a9bc6c39-591d-4b58-b9b3-f431199d0643","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/components/PropertyCard.tsx","content":"import { useNavigate } from 'react-router-dom'\nimport { Star } from 'lucide-react'\nimport type { Property } from '../slices/propertiesSlice'\nimport FavoriteButton from './FavoriteButton'\n\ninterface PropertyCardProps {\n  property: Property\n}\n\nexport default function PropertyCard({ property }: PropertyCardProps) {\n  const navigate = useNavigate()\n  const rating = Number(property.avg_rating) || 0\n  const reviewCount = property.review_count || 0\n\n  return (\n    <div\n      data-testid={`property-card-${property.id}`}\n      className=\"cursor-pointer group\"\n      onClick={() => navigate(`/properties/${property.id}`)}\n    >\n      <div className=\"relative aspect-square overflow-hidden rounded-xl\">\n        {property.main_image ? (\n          <img\n            src={property.main_image}\n            alt={property.title}\n            className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-300\"\n          />\n        ) : (\n          <div className=\"w-full h-full bg-bg-secondary flex items-center justify-center text-text-secondary text-sm\">\n            No image\n          </div>\n        )}\n        <FavoriteButton propertyId={property.id} />\n        <span\n          data-testid={`property-type-badge-${property.id}`}\n          className=\"absolute top-3 left-3 bg-white/90 backdrop-blur-sm rounded-full px-2.5 py-1 text-xs font-semibold text-text shadow-sm\"\n        >\n          {property.property_type}\n        </span>\n      </div>\n      <div className=\"mt-3\">\n        <div className=\"flex items-start justify-between gap-1\">\n          <h3 className=\"font-semibold text-text text-[15px] leading-tight truncate\">\n            {property.city}, {property.country}\n          </h3>\n          {reviewCount > 0 ? (\n            <div className=\"flex items-center gap-1 shrink-0\">\n              <Star size={12} className=\"fill-text text-text\" />\n              <span className=\"text-sm text-text\">{rating.toFixed(2)}</span>\n              <span className=\"text-sm text-text-secondary\">({reviewCount})</span>\n            </div>\n          ) : (\n            <span className=\"text-sm text-text-secondary shrink-0\">New</span>\n          )}\n        </div>\n        <p className=\"text-text-secondary text-sm mt-0.5 truncate\">{property.title}</p>\n        <p className=\"text-text-secondary text-sm\">\n          {property.beds} {property.beds === 1 ? 'bed' : 'beds'}\n        </p>\n        <p className=\"mt-1 text-[15px]\">\n          <span className=\"font-semibold text-text\">${Number(property.price_per_night).toFixed(0)}</span>\n          <span className=\"text-text\"> / night</span>\n        </p>\n      </div>\n    </div>\n  )\n}\n","numLines":68,"startLine":1,"totalLines":68}}}
