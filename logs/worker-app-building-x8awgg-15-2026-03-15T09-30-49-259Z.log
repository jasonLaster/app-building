, true, false, 140, 179)\n   313→\n   314→  // Create a session for seed data\n   315→  await sql`INSERT INTO sessions (session_token) VALUES ('seed-session-token')`\n   316→  const sessionRows = await sql`SELECT id FROM sessions WHERE session_token = 'seed-session-token'`\n   317→  const sessionRow = sessionRows[0]\n   318→  if (!sessionRow) return\n   319→  const sessionId = sessionRow.id as string\n   320→\n   321→  // Recent searches\n   322→  const laxId = airportMap.get('LAX')!\n   323→  const jfkId = airportMap.get('JFK')!\n   324→  const sfoId = airportMap.get('SFO')!\n   325→  const ordId = airportMap.get('ORD')!\n   326→  const lhrId = airportMap.get('LHR')!\n   327→\n   328→  await sql`INSERT INTO recent_searches (session_id, origin_airport_id, destination_airport_id, departure_date, return_date, passengers_adults, cabin_class, trip_type)\n   329→    VALUES (${sessionId}, ${laxId}, ${jfkId}, '2026-04-01', '2026-04-08', 1, 'economy', 'round_trip')`\n   330→  await sql`INSERT INTO recent_searches (session_id, origin_airport_id, destination_airport_id, departure_date, return_date, passengers_adults, cabin_class, trip_type)\n   331→    VALUES (${sessionId}, ${sfoId}, ${ordId}, '2026-04-05', '2026-04-10', 2, 'business', 'round_trip')`\n   332→\n   333→  // Sample bookings\n   334→  const flightForBooking = await sql`SELECT id FROM flights WHERE flight_number = 'AA100' LIMIT 1`\n   335→  const bookingFlight = flightForBooking[0]\n   336→  if (bookingFlight) {\n   337→    await sql`INSERT INTO bookings (session_id, flight_id, booking_reference, cabin_class, total_price_cents, status)\n   338→      VALUES (${sessionId}, ${bookingFlight.id}, 'GF-ABC123', 'economy', 34385, 'confirmed')`\n   339→    const bookingRows = await sql`SELECT id FROM bookings WHERE booking_reference = 'GF-ABC123'`\n   340→    const booking = bookingRows[0]\n   341→    if (booking) {\n   342→      await sql`INSERT INTO booking_passengers (booking_id, first_name, last_name, date_of_birth, gender, email, phone, passenger_type)\n   343→        VALUES (${booking.id}, 'John', 'Doe', '1990-05-15', 'male', 'john@example.com', '+1234567890', 'adult')`\n   344→    }\n   345→  }\n   346→\n   347→  // Completed past booking\n   348→  const pastFlightRows = await sql`SELECT id FROM flights WHERE flight_number = 'DL950' LIMIT 1`\n   349→  const pastFlight = pastFlightRows[0]\n   350→  if (pastFlight) {\n   351→    await sql`INSERT INTO bookings (session_id, flight_id, booking_reference, cabin_class, total_price_cents, status)\n   352→      VALUES (${sessionId}, ${pastFlight.id}, 'GF-PAST01', 'economy', 28635, 'completed')`\n   353→  }\n   354→\n   355→  // Cancelled upcoming booking\n   356→  const cancelFlightRows = await sql`SELECT id FROM flights WHERE flight_number = 'DL200' LIMIT 1`\n   357→  const cancelFlight = cancelFlightRows[0]\n   358→  if (cancelFlight) {\n   359→    await sql`INSERT INTO bookings (session_id, flight_id, booking_reference, cabin_class, total_price_cents, status)\n   360→      VALUES (${sessionId}, ${cancelFlight.id}, 'GF-CANC01', 'economy', 32085, 'cancelled')`\n   361→  }\n   362→\n   363→  // Round-trip booking (LAX→JFK Mar 25, return JFK→LAX Mar 30)\n   364→  const sortFlight1Rows = await sql`SELECT id FROM flights WHERE flight_number = 'AA960' LIMIT 1`\n   365→  const returnFlight1Rows = await sql`SELECT id FROM flights WHERE flight_number = 'AA965' LIMIT 1`\n   366→  const sortFlight1 = sortFlight1Rows[0]\n   367→  const returnFlight1 = returnFlight1Rows[0]\n   368→  if (sortFlight1) {\n   369→    await sql`INSERT INTO bookings (session_id, flight_id, return_flight_id, booking_reference, cabin_class, total_price_cents, status)\n   370→      VALUES (${sessionId}, ${sortFlight1.id}, ${returnFlight1?.id || null}, 'GF-SORT01', 'economy', 33235, 'confirmed')`\n   371→  }\n   372→\n   373→  // Upcoming booking Mar 30\n   374→  const sortFlight2Rows = await sql`SELECT id FROM flights WHERE flight_number = 'DL960' LIMIT 1`\n   375→  const sortFlight2 = sortFlight2Rows[0]\n   376→  if (sortFlight2) {\n   377→    await sql`INSERT INTO bookings (session_id, flight_id, booking_reference, cabin_class, total_price_cents, status)\n   378→      VALUES (${sessionId}, ${sortFlight2.id}, 'GF-SORT02', 'economy', 30935, 'confirmed')`\n   379→  }\n   380→\n   381→  // Upcoming booking Apr 10\n   382→  const sortFlight3Rows = await sql`SELECT id FROM flights WHERE flight_number = 'UA970' LIMIT 1`\n   383→  const sortFlight3 = sortFlight3Rows[0]\n   384→  if (sortFlight3) {\n   385→    await sql`INSERT INTO bookings (session_id, flight_id, booking_reference, cabin_class, total_price_cents, status)\n   386→      VALUES (${sessionId}, ${sortFlight3.id}, 'GF-SORT03', 'economy', 35535, 'confirmed')`\n   387→  }\n   388→\n   389→  // One-way SFO→ORD Apr 5\n   390→  const oneWayFlightRows = await sql`SELECT id FROM flights WHERE flight_number = 'AA970' LIMIT 1`\n   391→  const oneWayFlight = oneWayFlightRows[0]\n   392→  if (oneWayFlight) {\n   393→    await sql`INSERT INTO bookings (session_id, flight_id, booking_reference, cabin_class, total_price_cents, status)\n   394→      VALUES (${sessionId}, ${oneWayFlight.id}, 'GF-ONEW01', 'economy', 20585, 'confirmed')`\n   395→  }\n   396→\n   397→  // Tracked routes\n   398→  const nrtId = airportMap.get('NRT')!\n   399→  const cdgId = airportMap.get('CDG')!\n   400→\n   401→  // LAX→LHR: lowest economy price is AA800 = $599 base → 68885 total cents\n   402→  // initial_price_cents = 61504 → trend = +12%\n   403→  await sql`INSERT INTO tracked_routes (session_id, origin_airport_id, destination_airport_id, departure_date_start, departure_date_end, cabin_class, initial_price_cents)\n   404→    VALUES (${sessionId}, ${laxId}, ${lhrId}, '2026-04-01', '2026-04-15', 'economy', 61504)`\n   405→\n   406→  // SFO→NRT: lowest economy price is UA800 = $749 base → 86135 total cents\n   407→  // initial_price_cents = 93625 → trend = -8%\n   408→  await sql`INSERT INTO tracked_routes (session_id, origin_airport_id, destination_airport_id, departure_date_start, departure_date_end, cabin_class, initial_price_cents)\n   409→    VALUES (${sessionId}, ${sfoId}, ${nrtId}, '2026-04-10', '2026-04-25', 'economy', 93625)`\n   410→\n   411→  // JFK→CDG: lowest economy price is AF100 = $499 base → 57385 total cents\n   412→  // initial_price_cents = 57385 → trend = 0% (no trend)\n   413→  await sql`INSERT INTO tracked_routes (session_id, origin_airport_id, destination_airport_id, departure_date_start, departure_date_end, cabin_class, initial_price_cents)\n   414→    VALUES (${sessionId}, ${jfkId}, ${cdgId}, '2026-05-01', '2026-05-15', 'economy', 57385)`\n   415→}\n   416→\n   417→// CLI entry point\n   418→const isMain = process.argv[1] && import.meta.url.endsWith(process.argv[1].replace(/\\\\/g, '/'))\n   419→if (isMain) {\n   420→  const dbUrl = process.argv[2]\n   421→  if (!dbUrl) {\n   422→    console.error('Usage: tsx scripts/seed-db.ts <DATABASE_URL>')\n   423→    process.exit(1)\n   424→  }\n   425→  truncateAndSeed(dbUrl).then(() => console.log('Seed complete')).catch(e => { console.error(e); process.exit(1) })\n   426→}\n   427→"}]},"parent_tool_use_id":"toolu_01ChBVB1ZWLt9LnwiSjpGAiV","session_id":"a7364a07-0623-40ea-bf2b-2159671725a0","uuid":"19f7d201-1bfe-486e-8f27-7208ecb98dc5"}
