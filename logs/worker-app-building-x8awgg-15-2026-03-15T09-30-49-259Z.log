[2026-03-15T09:24:34.351Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HHpq8W6FamyDBDRdho8aNi","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions'\n     2→import { getSql } from './db.js'\n     3→\n     4→export default async (request: Request, _context: Context) => {\n     5→  const sql = getSql()\n     6→  const url = new URL(request.url)\n     7→\n     8→  if (request.method === 'GET') {\n     9→    const session = url.searchParams.get('session') || ''\n    10→    const origin = url.searchParams.get('origin') || ''\n    11→    const destination = url.searchParams.get('destination') || ''\n    12→\n    13→    if (!session) {\n    14→      return Response.json({ error: 'Missing session' }, { status: 400 })\n    15→    }\n    16→\n    17→    // Check if a specific route is tracked\n    18→    if (origin && destination) {\n    19→      const result = await sql`\n    20→        SELECT tr.id\n    21→        FROM tracked_routes tr\n    22→        JOIN sessions s ON tr.session_id = s.id\n    23→        JOIN airports oa ON tr.origin_airport_id = oa.id\n    24→        JOIN airports da ON tr.destination_airport_id = da.id\n    25→        WHERE s.session_token = ${session}\n    26→          AND oa.iata_code = ${origin}\n    27→          AND da.iata_code = ${destination}\n    28→        LIMIT 1\n    29→      `\n    30→      return Response.json({ tracked: result.length > 0, id: result[0]?.id || null })\n    31→    }\n    32→\n    33→    // Get all tracked routes with lowest current price and trend\n    34→    const routes = await sql`\n    35→      SELECT tr.id, tr.departure_date_start, tr.departure_date_end, tr.cabin_class, tr.created_at,\n    36→             oa.iata_code as origin_code, oa.city as origin_city,\n    37→             da.iata_code as dest_code, da.city as dest_city,\n    38→             tr.initial_price_cents,\n    39→             (\n    40→               SELECT MIN(p.total_price_cents)\n    41→               FROM flights f2\n    42→               JOIN prices p ON p.flight_id = f2.id AND p.cabin_class = tr.cabin_class\n    43→               WHERE f2.origin_airport_id = tr.origin_airport_id\n    44→                 AND f2.destination_airport_id = tr.destination_airport_id\n    45→             ) as lowest_price_cents\n    46→      FROM tracked_routes tr\n    47→      JOIN sessions s ON tr.session_id = s.id\n    48→      JOIN airports oa ON tr.origin_airport_id = oa.id\n    49→      JOIN airports da ON tr.destination_airport_id = da.id\n    50→      WHERE s.session_token = ${session}\n    51→      ORDER BY tr.created_at DESC\n    52→    `\n    53→    const enriched = routes.map((r: Record<string, unknown>) => {\n    54→      const lowest = r.lowest_price_cents as number | null\n    55→      const initial = r.initial_price_cents as number | null\n    56→      let price_trend_percent: number | null = null\n    57→      if (initial && lowest && initial > 0) {\n    58→        price_trend_percent = Math.round(((lowest - initial) / initial) * 100)\n    59→      }\n    60→      return { ...r, price_trend_percent }\n    61→    })\n    62→    return Response.json(enriched)\n    63→  }\n    64→\n    65→  if (request.method === 'POST') {\n    66→    const body = await request.json() as {\n    67→      sessionToken: string\n    68→      originCode: string\n    69→      destCode: string\n    70→      departureDateStart?: string\n    71→      departureDateEnd?: string\n    72→      cabinClass?: string\n    73→    }\n    74→\n    75→    // Find or create session\n    76→    const sessions = await sql`\n    77→      SELECT id FROM sessions WHERE session_token = ${body.sessionToken}\n    78→    `\n    79→    let sessionId: string\n    80→    if (sessions[0]) {\n    81→      sessionId = sessions[0].id as string\n    82→    } else {\n    83→      const newSession = await sql`\n    84→        INSERT INTO sessions (id, session_token) VALUES (gen_random_uuid(), ${body.sessionToken})\n    85→        RETURNING id\n    86→      `\n    87→      sessionId = newSession[0]!.id as string\n    88→    }\n    89→\n    90→    const origins = await sql`SELECT id FROM airports WHERE iata_code = ${body.originCode}`\n    91→    const dests = await sql`SELECT id FROM airports WHERE iata_code = ${body.destCode}`\n    92→    const originId = origins[0]?.id as string\n    93→    const destId = dests[0]?.id as string\n    94→\n    95→    if (!originId || !destId) {\n    96→      return Response.json({ error: 'Airport not found' }, { status: 400 })\n    97→    }\n    98→\n    99→    const cabinClass = body.cabinClass || 'economy'\n   100→    // Compute initial lowest price at tracking time\n   101→    const priceRows = await sql`\n   102→      SELECT MIN(p.total_price_cents) as lowest\n   103→      FROM flights f\n   104→      JOIN prices p ON p.flight_id = f.id AND p.cabin_class = ${cabinClass}\n   105→      WHERE f.origin_airport_id = ${originId}\n   106→        AND f.destination_airport_id = ${destId}\n   107→    `\n   108→    const initialPrice = priceRows[0]?.lowest as number | null\n   109→\n   110→    await sql`\n   111→      INSERT INTO tracked_routes (id, session_id, origin_airport_id, destination_airport_id,\n   112→        departure_date_start, departure_date_end, cabin_class, initial_price_cents)\n   113→      VALUES (gen_random_uuid(), ${sessionId}, ${originId}, ${destId},\n   114→        ${body.departureDateStart || null}, ${body.departureDateEnd || null},\n   115→        ${cabinClass}, ${initialPrice})\n   116→    `\n   117→\n   118→    return Response.json({ success: true })\n   119→  }\n   120→\n   121→  if (request.method === 'DELETE') {\n   122→    const body = await request.json() as {\n   123→      sessionToken: string\n   124→      originCode?: string\n   125→      destCode?: string\n   126→      id?: string\n   127→    }\n   128→\n   129→    if (body.id) {\n   130→      await sql`\n   131→        DELETE FROM tracked_routes\n   132→        WHERE id = ${body.id}\n   133→          AND session_id IN (SELECT id FROM sessions WHERE session_token = ${body.sessionToken})\n   134→      `\n   135→    } else if (body.originCode && body.destCode) {\n   136→      await sql`\n   137→        DELETE FROM tracked_routes\n   138→        WHERE session_id IN (SELECT id FROM sessions WHERE session_token = ${body.sessionToken})\n   139→          AND origin_airport_id IN (SELECT id FROM airports WHERE iata_code = ${body.originCode})\n   140→          AND destination_airport_id IN (SELECT id FROM airports WHERE iata_code = ${body.destCode})\n   141→      `\n   142→    }\n   143→\n   144→    return Response.json({ success: true })\n   145→  }\n   146→\n   147→  return Response.json({ error: 'Method not allowed' }, { status: 405 })\n   148→}\n   149→"}]},"parent_tool_use_id":"toolu_01ChBVB1ZWLt9LnwiSjpGAiV","session_id":"a7364a07-0623-40ea-bf2b-2159671725a0","uuid":"fe0a1ad6-7315-41b2-9009-4fc8774e47e0"}
