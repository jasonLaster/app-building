ead) {\n    87→      dispatch(markNotificationRead(notification.id));\n    88→    }\n    89→    navigate(`/issue/${notification.issue_id}`);\n    90→  }\n    91→\n    92→  function handleArchive(e: React.MouseEvent) {\n    93→    e.stopPropagation();\n    94→    dispatch(archiveNotification(notification.id));\n    95→  }\n    96→\n    97→  return (\n    98→    <div\n    99→      className={`notification-row ${!notification.read ? 'notification-row-unread' : ''}`}\n   100→      data-testid={`notification-row-${notification.id}`}\n   101→      onClick={handleClick}\n   102→      role=\"button\"\n   103→      tabIndex={0}\n   104→      onKeyDown={(e) => { if (e.key === 'Enter') handleClick(); }}\n   105→    >\n   106→      <div className=\"notification-row-left\">\n   107→        <span className=\"notification-row-icon\" data-testid={`notification-icon-${notification.id}`}>\n   108→          {getTypeIcon(notification.type)}\n   109→        </span>\n   110→        <span className=\"notification-row-identifier\" data-testid={`notification-identifier-${notification.id}`}>\n   111→          {notification.issue_identifier}\n   112→        </span>\n   113→        <span className=\"notification-row-description\" data-testid={`notification-description-${notification.id}`}>\n   114→          {notification.description}\n   115→        </span>\n   116→      </div>\n   117→      <div className=\"notification-row-right\">\n   118→        <span className=\"notification-row-timestamp\" data-testid={`notification-timestamp-${notification.id}`}>\n   119→          {formatRelativeTime(notification.created_at)}\n   120→        </span>\n   121→        <button\n   122→          className=\"notification-row-archive-btn\"\n   123→          onClick={handleArchive}\n   124→          title=\"Archive\"\n   125→          data-testid={`notification-archive-btn-${notification.id}`}\n   126→        >\n   127→          <ArchiveIcon />\n   128→        </button>\n   129→      </div>\n   130→    </div>\n   131→  );\n   132→}\n   133→"}]},"parent_tool_use_id":null,"session_id":"8c773c69-5b70-4948-a5ae-cf557e586ea9","uuid":"6d8fe87c-ab66-4ae5-8862-255f6b5dc086","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/src/components/NotificationRow.tsx","content":"import { useNavigate } from 'react-router-dom';\nimport { useDispatch } from 'react-redux';\nimport type { AppDispatch } from '../store';\nimport type { Notification } from '../slices/notificationsSlice';\nimport { markNotificationRead, archiveNotification } from '../slices/notificationsSlice';\nimport './NotificationRow.css';\n\nfunction formatRelativeTime(dateStr: string): string {\n  const now = Date.now();\n  const date = new Date(dateStr).getTime();\n  const diff = now - date;\n  const seconds = Math.floor(diff / 1000);\n  const minutes = Math.floor(seconds / 60);\n  const hours = Math.floor(minutes / 60);\n  const days = Math.floor(hours / 24);\n\n  if (seconds < 60) return 'just now';\n  if (minutes < 60) return `${minutes}m ago`;\n  if (hours < 24) return `${hours}h ago`;\n  if (days < 30) return `${days}d ago`;\n  return `${Math.floor(days / 30)}mo ago`;\n}\n\nfunction AssignmentIcon() {\n  return (\n    <svg className=\"notification-type-icon notification-type-icon-assignment\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n      <path d=\"M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\" />\n      <circle cx=\"8.5\" cy=\"7\" r=\"4\" />\n      <line x1=\"20\" y1=\"8\" x2=\"20\" y2=\"14\" />\n      <line x1=\"23\" y1=\"11\" x2=\"17\" y2=\"11\" />\n    </svg>\n  );\n}\n\nfunction UpdateIcon() {\n  return (\n    <svg className=\"notification-type-icon notification-type-icon-update\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n      <polyline points=\"23 4 23 10 17 10\" />\n      <polyline points=\"1 20 1 14 7 14\" />\n      <path d=\"M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15\" />\n    </svg>\n  );\n}\n\nfunction MentionIcon() {\n  return (\n    <svg className=\"notification-type-icon notification-type-icon-mention\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n      <circle cx=\"12\" cy=\"12\" r=\"4\" />\n      <path d=\"M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-3.92 7.94\" />\n    </svg>\n  );\n}\n\nfunction ArchiveIcon() {\n  return (\n    <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n      <polyline points=\"21 8 21 21 3 21 3 8\" />\n      <rect x=\"1\" y=\"3\" width=\"22\" height=\"5\" />\n      <line x1=\"10\" y1=\"12\" x2=\"14\" y2=\"12\" />\n    </svg>\n  );\n}\n\nfunction getTypeIcon(type: string) {\n  switch (type) {\n    case 'assignment':\n      return <AssignmentIcon />;\n    case 'update':\n      return <UpdateIcon />;\n    case 'mention':\n      return <MentionIcon />;\n    default:\n      return <UpdateIcon />;\n  }\n}\n\ninterface NotificationRowProps {\n  notification: Notification;\n}\n\nexport default function NotificationRow({ notification }: NotificationRowProps) {\n  const dispatch = useDispatch<AppDispatch>();\n  const navigate = useNavigate();\n\n  function handleClick() {\n    if (!notification.read) {\n      dispatch(markNotificationRead(notification.id));\n    }\n    navigate(`/issue/${notification.issue_id}`);\n  }\n\n  function handleArchive(e: React.MouseEvent) {\n    e.stopPropagation();\n    dispatch(archiveNotification(notification.id));\n  }\n\n  return (\n    <div\n      className={`notification-row ${!notification.read ? 'notification-row-unread' : ''}`}\n      data-testid={`notification-row-${notification.id}`}\n      onClick={handleClick}\n      role=\"button\"\n      tabIndex={0}\n      onKeyDown={(e) => { if (e.key === 'Enter') handleClick(); }}\n    >\n      <div className=\"notification-row-left\">\n        <span className=\"notification-row-icon\" data-testid={`notification-icon-${notification.id}`}>\n          {getTypeIcon(notification.type)}\n        </span>\n        <span className=\"notification-row-identifier\" data-testid={`notification-identifier-${notification.id}`}>\n          {notification.issue_identifier}\n        </span>\n        <span className=\"notification-row-description\" data-testid={`notification-description-${notification.id}`}>\n          {notification.description}\n        </span>\n      </div>\n      <div className=\"notification-row-right\">\n        <span className=\"notification-row-timestamp\" data-testid={`notification-timestamp-${notification.id}`}>\n          {formatRelativeTime(notification.created_at)}\n        </span>\n        <button\n          className=\"notification-row-archive-btn\"\n          onClick={handleArchive}\n          title=\"Archive\"\n          data-testid={`notification-archive-btn-${notification.id}`}\n        >\n          <ArchiveIcon />\n        </button>\n      </div>\n    </div>\n  );\n}\n","numLines":133,"startLine":1,"totalLines":133}}}
