[2026-03-14T21:31:08.672Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PgwJpTXv8KvivzXx2z3sda","type":"tool_result","content":"     1→import { createSlice, createAsyncThunk } from '@reduxjs/toolkit';\n     2→\n     3→export interface Notification {\n     4→  id: string;\n     5→  type: 'assignment' | 'update' | 'mention';\n     6→  issue_id: string;\n     7→  description: string;\n     8→  read: boolean;\n     9→  archived: boolean;\n    10→  created_at: string;\n    11→  issue_identifier: string;\n    12→  issue_title: string;\n    13→}\n    14→\n    15→interface NotificationsState {\n    16→  unreadCount: number;\n    17→  items: Notification[];\n    18→  loading: boolean;\n    19→}\n    20→\n    21→const initialState: NotificationsState = {\n    22→  unreadCount: 0,\n    23→  items: [],\n    24→  loading: false,\n    25→};\n    26→\n    27→export const fetchUnreadCount = createAsyncThunk(\n    28→  'notifications/fetchUnreadCount',\n    29→  async (_, { getState, rejectWithValue }) => {\n    30→    const state = getState() as { auth: { token: string | null } };\n    31→    const token = state.auth.token;\n    32→    if (!token) return rejectWithValue('No token');\n    33→    const response = await fetch('/api/notifications-count', {\n    34→      headers: { Authorization: `Bearer ${token}` },\n    35→    });\n    36→    if (!response.ok) {\n    37→      return rejectWithValue('Failed to fetch notifications');\n    38→    }\n    39→    const data = await response.json();\n    40→    return data.count as number;\n    41→  }\n    42→);\n    43→\n    44→export const fetchNotifications = createAsyncThunk(\n    45→  'notifications/fetchNotifications',\n    46→  async (_, { getState, rejectWithValue }) => {\n    47→    const state = getState() as { auth: { token: string | null } };\n    48→    const token = state.auth.token;\n    49→    if (!token) return rejectWithValue('No token');\n    50→    const response = await fetch('/api/notifications', {\n    51→      headers: { Authorization: `Bearer ${token}` },\n    52→    });\n    53→    if (!response.ok) {\n    54→      return rejectWithValue('Failed to fetch notifications');\n    55→    }\n    56→    const data = await response.json();\n    57→    return data.notifications as Notification[];\n    58→  }\n    59→);\n    60→\n    61→export const markNotificationRead = createAsyncThunk(\n    62→  'notifications/markRead',\n    63→  async (notificationId: string, { getState, rejectWithValue }) => {\n    64→    const state = getState() as { auth: { token: string | null } };\n    65→    const token = state.auth.token;\n    66→    if (!token) return rejectWithValue('No token');\n    67→    const response = await fetch(`/api/notifications/${notificationId}/read`, {\n    68→      method: 'PUT',\n    69→      headers: { Authorization: `Bearer ${token}` },\n    70→    });\n    71→    if (!response.ok) {\n    72→      return rejectWithValue('Failed to mark as read');\n    73→    }\n    74→    return notificationId;\n    75→  }\n    76→);\n    77→\n    78→export const archiveNotification = createAsyncThunk(\n    79→  'notifications/archive',\n    80→  async (notificationId: string, { getState, rejectWithValue }) => {\n    81→    const state = getState() as { auth: { token: string | null } };\n    82→    const token = state.auth.token;\n    83→    if (!token) return rejectWithValue('No token');\n    84→    const response = await fetch(`/api/notifications/${notificationId}/archive`, {\n    85→      method: 'PUT',\n    86→      headers: { Authorization: `Bearer ${token}` },\n    87→    });\n    88→    if (!response.ok) {\n    89→      return rejectWithValue('Failed to archive notification');\n    90→    }\n    91→    return notificationId;\n    92→  }\n    93→);\n    94→\n    95→const notificationsSlice = createSlice({\n    96→  name: 'notifications',\n    97→  initialState,\n    98→  reducers: {\n    99→    decrementUnreadCount(state) {\n   100→      if (state.unreadCount > 0) {\n   101→        state.unreadCount -= 1;\n   102→      }\n   103→    },\n   104→    setUnreadCount(state, action) {\n   105→      state.unreadCount = action.payload;\n   106→    },\n   107→  },\n   108→  extraReducers: (builder) => {\n   109→    builder\n   110→      .addCase(fetchUnreadCount.fulfilled, (state, action) => {\n   111→        state.unreadCount = action.payload;\n   112→      })\n   113→      .addCase(fetchNotifications.pending, (state) => {\n   114→        if (state.items.length === 0) {\n   115→          state.loading = true;\n   116→        }\n   117→      })\n   118→      .addCase(fetchNotifications.fulfilled, (state, action) => {\n   119→        state.loading = false;\n   120→        state.items = action.payload;\n   121→        state.unreadCount = action.payload.filter((n) => !n.read).length;\n   122→      })\n   123→      .addCase(fetchNotifications.rejected, (state) => {\n   124→        state.loading = false;\n   125→      })\n   126→      .addCase(markNotificationRead.fulfilled, (state, action) => {\n   127→        const notification = state.items.find((n) => n.id === action.payload);\n   128→        if (notification && !notification.read) {\n   129→          notification.read = true;\n   130→          state.unreadCount = Math.max(0, state.unreadCount - 1);\n   131→        }\n   132→      })\n   133→      .addCase(archiveNotification.fulfilled, (state, action) => {\n   134→        const notification = state.items.find((n) => n.id === action.payload);\n   135→        if (notification && !notification.read) {\n   136→          state.unreadCount = Math.max(0, state.unreadCount - 1);\n   137→        }\n   138→        state.items = state.items.filter((n) => n.id !== action.payload);\n   139→      });\n   140→  },\n   141→});\n   142→\n   143→export const { decrementUnreadCount, setUnreadCount } = notificationsSlice.actions;\n   144→export default notificationsSlice.reducer;\n   145→"}]},"parent_tool_use_id":null,"session_id":"8c773c69-5b70-4948-a5ae-cf557e586ea9","uuid":"fcd04334-3697-41cd-ac7e-cbb2d77d4261","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/src/slices/notificationsSlice.ts","content":"import { createSlice, createAsyncThunk } from '@reduxjs/toolkit';\n\nexport interface Notification {\n  id: string;\n  type: 'assignment' | 'update' | 'mention';\n  issue_id: string;\n  description: string;\n  read: boolean;\n  archived: boolean;\n  created_at: string;\n  issue_identifier: string;\n  issue_title: string;\n}\n\ninterface NotificationsState {\n  unreadCount: number;\n  items: Notification[];\n  loading: boolean;\n}\n\nconst initialState: NotificationsState = {\n  unreadCount: 0,\n  items: [],\n  loading: false,\n};\n\nexport const fetchUnreadCount = createAsyncThunk(\n  'notifications/fetchUnreadCount',\n  async (_, { getState, rejectWithValue }) => {\n    const state = getState() as { auth: { token: string | null } };\n    const token = state.auth.token;\n    if (!token) return rejectWithValue('No token');\n    const response = await fetch('/api/notifications-count', {\n      headers: { Authorization: `Bearer ${token}` },\n    });\n    if (!response.ok) {\n      return rejectWithValue('Failed to fetch notifications');\n    }\n    const data = await response.json();\n    return data.count as number;\n  }\n);\n\nexport const fetchNotifications = createAsyncThunk(\n  'notifications/fetchNotifications',\n  async (_, { getState, rejectWithValue }) => {\n    const state = getState() as { auth: { token: string | null } };\n    const token = state.auth.token;\n    if (!token) return rejectWithValue('No token');\n    const response = await fetch('/api/notifications', {\n      headers: { Authorization: `Bearer ${token}` },\n    });\n    if (!response.ok) {\n      return rejectWithValue('Failed to fetch notifications');\n    }\n    const data = await response.json();\n    return data.notifications as Notification[];\n  }\n);\n\nexport const markNotificationRead = createAsyncThunk(\n  'notifications/markRead',\n  async (notificationId: string, { getState, rejectWithValue }) => {\n    const state = getState() as { auth: { token: string | null } };\n    const token = state.auth.token;\n    if (!token) return rejectWithValue('No token');\n    const response = await fetch(`/api/notifications/${notificationId}/read`, {\n      method: 'PUT',\n      headers: { Authorization: `Bearer ${token}` },\n    });\n    if (!response.ok) {\n      return rejectWithValue('Failed to mark as read');\n    }\n    return notificationId;\n  }\n);\n\nexport const archiveNotification = createAsyncThunk(\n  'notifications/archive',\n  async (notificationId: string, { getState, rejectWithValue }) => {\n    const state = getState() as { auth: { token: string | null } };\n    const token = state.auth.token;\n    if (!token) return rejectWithValue('No token');\n    const response = await fetch(`/api/notifications/${notificationId}/archive`, {\n      method: 'PUT',\n      headers: { Authorization: `Bearer ${token}` },\n    });\n    if (!response.ok) {\n      return rejectWithValue('Failed to archive notification');\n    }\n    return notificationId;\n  }\n);\n\nconst notificationsSlice = createSlice({\n  name: 'notifications',\n  initialState,\n  reducers: {\n    decrementUnreadCount(state) {\n      if (state.unreadCount > 0) {\n        state.unreadCount -= 1;\n      }\n    },\n    setUnreadCount(state, action) {\n      state.unreadCount = action.payload;\n    },\n  },\n  extraReducers: (builder) => {\n    builder\n      .addCase(fetchUnreadCount.fulfilled, (state, action) => {\n        state.unreadCount = action.payload;\n      })\n      .addCase(fetchNotifications.pending, (state) => {\n        if (state.items.length === 0) {\n          state.loading = true;\n        }\n      })\n      .addCase(fetchNotifications.fulfilled, (state, action) => {\n        state.loading = false;\n        state.items = action.payload;\n        state.unreadCount = action.payload.filter((n) => !n.read).length;\n      })\n      .addCase(fetchNotifications.rejected, (state) => {\n        state.loading = false;\n      })\n      .addCase(markNotificationRead.fulfilled, (state, action) => {\n        const notification = state.items.find((n) => n.id === action.payload);\n        if (notification && !notification.read) {\n          notification.read = true;\n          state.unreadCount = Math.max(0, state.unreadCount - 1);\n        }\n      })\n      .addCase(archiveNotification.fulfilled, (state, action) => {\n        const notification = state.items.find((n) => n.id === action.payload);\n        if (notification && !notification.read) {\n          state.unreadCount = Math.max(0, state.unreadCount - 1);\n        }\n        state.items = state.items.filter((n) => n.id !== action.payload);\n      });\n  },\n});\n\nexport const { decrementUnreadCount, setUnreadCount } = notificationsSlice.actions;\nexport default notificationsSlice.reducer;\n","numLines":145,"startLine":1,"totalLines":145}}}
