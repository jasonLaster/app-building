console.error('Fetch notifications count error:', err);\n    50→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n    51→      status: 500,\n    52→      headers: { 'Content-Type': 'application/json' },\n    53→    });\n    54→  }\n    55→}\n    56→"}]},"parent_tool_use_id":"toolu_015qryzSujPT5PpuZiGzYCdJ","session_id":"8c773c69-5b70-4948-a5ae-cf557e586ea9","uuid":"da49e4b2-ca20-4005-a3d3-ed6eda3ed215"}
