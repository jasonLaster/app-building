left {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  min-width: 0;\n  flex: 1;\n}\n\n.notification-row-icon {\n  flex-shrink: 0;\n  display: flex;\n  align-items: center;\n}\n\n.notification-type-icon {\n  opacity: 0.7;\n}\n\n.notification-type-icon-assignment {\n  color: var(--color-accent);\n}\n\n.notification-type-icon-update {\n  color: var(--color-status-done, #4caf50);\n}\n\n.notification-type-icon-mention {\n  color: var(--color-priority-high, #fb923c);\n}\n\n.notification-row-identifier {\n  flex-shrink: 0;\n  font-size: 13px;\n  color: var(--color-text-secondary);\n  font-weight: 500;\n  font-variant-numeric: tabular-nums;\n}\n\n.notification-row-description {\n  font-size: 14px;\n  color: var(--color-text-primary);\n  font-weight: 400;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  min-width: 0;\n}\n\n.notification-row-right {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  flex-shrink: 0;\n}\n\n.notification-row-timestamp {\n  font-size: 12px;\n  color: var(--color-text-tertiary);\n  white-space: nowrap;\n}\n\n.notification-row-archive-btn {\n  background: none;\n  border: none;\n  padding: 4px;\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  border-radius: 4px;\n  color: var(--color-text-tertiary);\n  transition: background-color 150ms ease, color 150ms ease;\n  opacity: 0;\n}\n\n.notification-row:hover .notification-row-archive-btn {\n  opacity: 1;\n}\n\n.notification-row-archive-btn:hover {\n  background-color: var(--color-bg-hover);\n  color: var(--color-text-primary);\n}\n","numLines":109,"startLine":1,"totalLines":109}}}
