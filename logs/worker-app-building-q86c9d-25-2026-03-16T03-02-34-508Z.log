9→        const user = result[0]\n    50→        if (!user) {\n    51→          return new Response(\n    52→            JSON.stringify({ error: 'No account found with this email' }),\n    53→            { status: 404, headers }\n    54→          )\n    55→        }\n    56→        return new Response(JSON.stringify(user), {\n    57→          status: 200,\n    58→          headers,\n    59→        })\n    60→      }\n    61→    }\n    62→\n    63→    if (request.method === 'DELETE') {\n    64→      // Delete all non-seed users (for test cleanup)\n    65→      const seedIds = [\n    66→        'a1111111-1111-1111-1111-111111111111',\n    67→        'a2222222-2222-2222-2222-222222222222',\n    68→        'a3333333-3333-3333-3333-333333333333',\n    69→        'a4444444-4444-4444-4444-444444444444',\n    70→      ]\n    71→      await sql`DELETE FROM users WHERE id != ALL(${seedIds})`\n    72→      return new Response(JSON.stringify({ success: true }), {\n    73→        status: 200,\n    74→        headers,\n    75→      })\n    76→    }\n    77→\n    78→    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n    79→      status: 405,\n    80→      headers,\n    81→    })\n    82→  } catch {\n    83→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n    84→      status: 500,\n    85→      headers,\n    86→    })\n    87→  }\n    88→}\n    89→"}]},"parent_tool_use_id":null,"session_id":"6a740ffb-b2f5-4751-aabf-5f2a1bcc96e7","uuid":"a456663e-201e-4b2a-ac09-cab0e435dc3e","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/netlify/functions/auth.ts","content":"import type { Context } from '@netlify/functions'\nimport { getSql } from './db.js'\n\nexport default async (request: Request, _context: Context) => {\n  const sql = getSql()\n  const headers = { 'Content-Type': 'application/json' }\n\n  try {\n    if (request.method === 'POST') {\n      const body = await request.json()\n      const { email, name } = body\n\n      if (!email) {\n        return new Response(JSON.stringify({ error: 'Email is required' }), {\n          status: 400,\n          headers,\n        })\n      }\n\n      if (name) {\n        // Register mode\n        const existing = await sql`SELECT * FROM users WHERE email = ${email}`\n        if (existing.length > 0) {\n          return new Response(\n            JSON.stringify({ error: 'An account with this email already exists' }),\n            { status: 409, headers }\n          )\n        }\n\n        const result = await sql`\n          INSERT INTO users (id, email, name, created_at)\n          VALUES (gen_random_uuid(), ${email}, ${name}, now())\n          RETURNING *\n        `\n        const user = result[0]\n        if (!user) {\n          return new Response(JSON.stringify({ error: 'Failed to create user' }), {\n            status: 500,\n            headers,\n          })\n        }\n        return new Response(JSON.stringify(user), {\n          status: 201,\n          headers,\n        })\n      } else {\n        // Login mode\n        const result = await sql`SELECT * FROM users WHERE email = ${email}`\n        const user = result[0]\n        if (!user) {\n          return new Response(\n            JSON.stringify({ error: 'No account found with this email' }),\n            { status: 404, headers }\n          )\n        }\n        return new Response(JSON.stringify(user), {\n          status: 200,\n          headers,\n        })\n      }\n    }\n\n    if (request.method === 'DELETE') {\n      // Delete all non-seed users (for test cleanup)\n      const seedIds = [\n        'a1111111-1111-1111-1111-111111111111',\n        'a2222222-2222-2222-2222-222222222222',\n        'a3333333-3333-3333-3333-333333333333',\n        'a4444444-4444-4444-4444-444444444444',\n      ]\n      await sql`DELETE FROM users WHERE id != ALL(${seedIds})`\n      return new Response(JSON.stringify({ success: true }), {\n        status: 200,\n        headers,\n      })\n    }\n\n    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n      status: 405,\n      headers,\n    })\n  } catch {\n    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n      status: 500,\n      headers,\n    })\n  }\n}\n","numLines":89,"startLine":1,"totalLines":89}}}
