[2026-03-14T21:55:42.323Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WWUMUmcjABvRQTG9VjRqgC","type":"tool_result","content":"     1→import { createSlice, createAsyncThunk } from '@reduxjs/toolkit';\n     2→import type { Issue, IssueLabel } from './issuesSlice';\n     3→\n     4→export interface SubIssue {\n     5→  id: string;\n     6→  title: string;\n     7→  status: string;\n     8→  priority: string;\n     9→  identifier: string;\n    10→}\n    11→\n    12→export interface ActivityEntry {\n    13→  id: string;\n    14→  action: string;\n    15→  createdAt: string;\n    16→  memberId: string;\n    17→  memberName: string | null;\n    18→  memberEmail: string | null;\n    19→}\n    20→\n    21→export interface Comment {\n    22→  id: string;\n    23→  content: string;\n    24→  createdAt: string;\n    25→  memberId: string;\n    26→  memberName: string | null;\n    27→  memberEmail: string | null;\n    28→}\n    29→\n    30→export interface TeamMember {\n    31→  id: string;\n    32→  name: string;\n    33→  email: string;\n    34→}\n    35→\n    36→export interface TeamProject {\n    37→  id: string;\n    38→  name: string;\n    39→}\n    40→\n    41→export interface TeamCycle {\n    42→  id: string;\n    43→  name: string;\n    44→  start_date: string;\n    45→  end_date: string;\n    46→}\n    47→\n    48→interface IssueDetailState {\n    49→  issue: Issue | null;\n    50→  subIssues: SubIssue[];\n    51→  activity: ActivityEntry[];\n    52→  comments: Comment[];\n    53→  members: TeamMember[];\n    54→  projects: TeamProject[];\n    55→  cycles: TeamCycle[];\n    56→  allLabels: IssueLabel[];\n    57→  loading: boolean;\n    58→  error: string | null;\n    59→}\n    60→\n    61→const initialState: IssueDetailState = {\n    62→  issue: null,\n    63→  subIssues: [],\n    64→  activity: [],\n    65→  comments: [],\n    66→  members: [],\n    67→  projects: [],\n    68→  cycles: [],\n    69→  allLabels: [],\n    70→  loading: false,\n    71→  error: null,\n    72→};\n    73→\n    74→export const fetchIssueDetail = createAsyncThunk(\n    75→  'issueDetail/fetchIssueDetail',\n    76→  async (issueId: string, { getState, rejectWithValue }) => {\n    77→    const state = getState() as { auth: { token: string | null } };\n    78→    const token = state.auth.token;\n    79→    if (!token) return rejectWithValue('No token');\n    80→    const response = await fetch(`/api/issue-detail?issueId=${issueId}`, {\n    81→      headers: { Authorization: `Bearer ${token}` },\n    82→    });\n    83→    if (!response.ok) {\n    84→      return rejectWithValue('Failed to fetch issue');\n    85→    }\n    86→    return await response.json();\n    87→  }\n    88→);\n    89→\n    90→export const updateIssueField = createAsyncThunk(\n    91→  'issueDetail/updateIssueField',\n    92→  async (\n    93→    payload: { issueId: string; field: string; value: string | null; labelIds?: string[] },\n    94→    { getState, rejectWithValue }\n    95→  ) => {\n    96→    const state = getState() as { auth: { token: string | null } };\n    97→    const token = state.auth.token;\n    98→    if (!token) return rejectWithValue('No token');\n    99→    const response = await fetch('/api/update-issue', {\n   100→      method: 'PUT',\n   101→      headers: {\n   102→        'Content-Type': 'application/json',\n   103→        Authorization: `Bearer ${token}`,\n   104→      },\n   105→      body: JSON.stringify(payload),\n   106→    });\n   107→    if (!response.ok) {\n   108→      return rejectWithValue('Failed to update issue');\n   109→    }\n   110→    return await response.json() as { issue: Issue; activity: ActivityEntry | null };\n   111→  }\n   112→);\n   113→\n   114→export const addComment = createAsyncThunk(\n   115→  'issueDetail/addComment',\n   116→  async (\n   117→    payload: { issueId: string; content: string },\n   118→    { getState, rejectWithValue }\n   119→  ) => {\n   120→    const state = getState() as { auth: { token: string | null } };\n   121→    const token = state.auth.token;\n   122→    if (!token) return rejectWithValue('No token');\n   123→    const response = await fetch('/api/add-comment', {\n   124→      method: 'POST',\n   125→      headers: {\n   126→        'Content-Type': 'application/json',\n   127→        Authorization: `Bearer ${token}`,\n   128→      },\n   129→      body: JSON.stringify(payload),\n   130→    });\n   131→    if (!response.ok) {\n   132→      return rejectWithValue('Failed to add comment');\n   133→    }\n   134→    return await response.json() as { comment: Comment };\n   135→  }\n   136→);\n   137→\n   138→const issueDetailSlice = createSlice({\n   139→  name: 'issueDetail',\n   140→  initialState,\n   141→  reducers: {\n   142→    clearIssueDetail(state) {\n   143→      state.issue = null;\n   144→      state.subIssues = [];\n   145→      state.activity = [];\n   146→      state.comments = [];\n   147→      state.members = [];\n   148→      state.projects = [];\n   149→      state.cycles = [];\n   150→      state.allLabels = [];\n   151→      state.loading = false;\n   152→      state.error = null;\n   153→    },\n   154→  },\n   155→  extraReducers: (builder) => {\n   156→    builder\n   157→      .addCase(fetchIssueDetail.pending, (state) => {\n   158→        if (!state.issue) {\n   159→          state.loading = true;\n   160→        }\n   161→        state.error = null;\n   162→      })\n   163→      .addCase(fetchIssueDetail.fulfilled, (state, action) => {\n   164→        state.loading = false;\n   165→        state.issue = action.payload.issue;\n   166→        state.subIssues = action.payload.subIssues;\n   167→        state.activity = action.payload.activity;\n   168→        state.comments = action.payload.comments;\n   169→        state.members = action.payload.members;\n   170→        state.projects = action.payload.projects;\n   171→        state.cycles = action.payload.cycles;\n   172→        state.allLabels = action.payload.allLabels;\n   173→      })\n   174→      .addCase(fetchIssueDetail.rejected, (state, action) => {\n   175→        state.loading = false;\n   176→        state.error = action.payload as string;\n   177→      })\n   178→      .addCase(updateIssueField.fulfilled, (state, action) => {\n   179→        state.issue = action.payload.issue;\n   180→        if (action.payload.activity) {\n   181→          state.activity.push(action.payload.activity);\n   182→        }\n   183→      })\n   184→      .addCase(addComment.fulfilled, (state, action) => {\n   185→        state.comments.push(action.payload.comment);\n   186→      });\n   187→  },\n   188→});\n   189→\n   190→export const { clearIssueDetail } = issueDetailSlice.actions;\n   191→export default issueDetailSlice.reducer;\n   192→"}]},"parent_tool_use_id":"toolu_01SnAv1pfGxoXbMM9HAbhGYS","session_id":"30fcfe2a-f025-455e-bebe-907f186e0891","uuid":"9209d83d-496e-4d84-9610-4b74b439fee4"}
