[2026-03-14T21:55:33.886Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JzmvFf6DvTavWZkzj73mZD","type":"tool_result","content":"     1→import { useState, useRef, useEffect } from 'react';\n     2→import { useDispatch } from 'react-redux';\n     3→import type { AppDispatch } from '../store';\n     4→import { updateIssueField } from '../slices/issueDetailSlice';\n     5→import './IssueDescription.css';\n     6→\n     7→interface IssueDescriptionProps {\n     8→  issueId: string;\n     9→  description: string;\n    10→}\n    11→\n    12→function renderMarkdown(md: string): string {\n    13→  let html = md\n    14→    // Escape HTML entities\n    15→    .replace(/&/g, '&amp;')\n    16→    .replace(/</g, '&lt;')\n    17→    .replace(/>/g, '&gt;');\n    18→\n    19→  // Code blocks (```)\n    20→  html = html.replace(/```([\\s\\S]*?)```/g, (_match, code) => {\n    21→    return `<pre class=\"md-code-block\"><code>${code.trim()}</code></pre>`;\n    22→  });\n    23→\n    24→  // Inline code\n    25→  html = html.replace(/`([^`]+)`/g, '<code class=\"md-inline-code\">$1</code>');\n    26→\n    27→  // Headings\n    28→  html = html.replace(/^### (.+)$/gm, '<h3>$1</h3>');\n    29→  html = html.replace(/^## (.+)$/gm, '<h2>$1</h2>');\n    30→  html = html.replace(/^# (.+)$/gm, '<h1>$1</h1>');\n    31→\n    32→  // Bold\n    33→  html = html.replace(/\\*\\*(.+?)\\*\\*/g, '<strong>$1</strong>');\n    34→\n    35→  // Italic\n    36→  html = html.replace(/\\*(.+?)\\*/g, '<em>$1</em>');\n    37→\n    38→  // Unordered lists\n    39→  html = html.replace(/^- (.+)$/gm, '<li>$1</li>');\n    40→  html = html.replace(/(<li>.*<\\/li>\\n?)+/g, (match) => `<ul>${match}</ul>`);\n    41→\n    42→  // Ordered lists\n    43→  html = html.replace(/^\\d+\\. (.+)$/gm, '<li>$1</li>');\n    44→  // Wrap consecutive <li> (not already in <ul>) in <ol>\n    45→  html = html.replace(/(?<!<\\/ul>)(<li>.*<\\/li>\\n?)+/g, (match) => {\n    46→    if (match.includes('<ul>')) return match;\n    47→    return `<ol>${match}</ol>`;\n    48→  });\n    49→\n    50→  // Paragraphs (lines that aren't already block elements)\n    51→  const lines = html.split('\\n');\n    52→  const result: string[] = [];\n    53→  for (const line of lines) {\n    54→    const trimmed = line.trim();\n    55→    if (!trimmed) {\n    56→      result.push('');\n    57→    } else if (\n    58→      trimmed.startsWith('<h') ||\n    59→      trimmed.startsWith('<pre') ||\n    60→      trimmed.startsWith('<ul') ||\n    61→      trimmed.startsWith('<ol') ||\n    62→      trimmed.startsWith('<li') ||\n    63→      trimmed.startsWith('</ul') ||\n    64→      trimmed.startsWith('</ol')\n    65→    ) {\n    66→      result.push(trimmed);\n    67→    } else {\n    68→      result.push(`<p>${trimmed}</p>`);\n    69→    }\n    70→  }\n    71→\n    72→  return result.join('\\n');\n    73→}\n    74→\n    75→export default function IssueDescription({ issueId, description }: IssueDescriptionProps) {\n    76→  const dispatch = useDispatch<AppDispatch>();\n    77→  const [editing, setEditing] = useState(false);\n    78→  const [value, setValue] = useState(description);\n    79→  const textareaRef = useRef<HTMLTextAreaElement>(null);\n    80→\n    81→  useEffect(() => {\n    82→    setValue(description);\n    83→  }, [description]);\n    84→\n    85→  useEffect(() => {\n    86→    if (editing && textareaRef.current) {\n    87→      textareaRef.current.focus();\n    88→      // Auto-resize\n    89→      textareaRef.current.style.height = 'auto';\n    90→      textareaRef.current.style.height = textareaRef.current.scrollHeight + 'px';\n    91→    }\n    92→  }, [editing]);\n    93→\n    94→  function handleClick() {\n    95→    setEditing(true);\n    96→  }\n    97→\n    98→  async function handleBlur() {\n    99→    if (value !== description) {\n   100→      await dispatch(updateIssueField({ issueId, field: 'description', value }));\n   101→    }\n   102→    setEditing(false);\n   103→  }\n   104→\n   105→  function handleKeyDown(e: React.KeyboardEvent) {\n   106→    if (e.key === 'Escape') {\n   107→      setValue(description);\n   108→      setEditing(false);\n   109→    }\n   110→  }\n   111→\n   112→  function handleTextareaChange(e: React.ChangeEvent<HTMLTextAreaElement>) {\n   113→    setValue(e.target.value);\n   114→    // Auto-resize\n   115→    e.target.style.height = 'auto';\n   116→    e.target.style.height = e.target.scrollHeight + 'px';\n   117→  }\n   118→\n   119→  return (\n   120→    <div className=\"issue-description\" data-testid=\"issue-description\">\n   121→      {editing ? (\n   122→        <textarea\n   123→          ref={textareaRef}\n   124→          className=\"issue-description-editor\"\n   125→          value={value}\n   126→          onChange={handleTextareaChange}\n   127→          onBlur={handleBlur}\n   128→          onKeyDown={handleKeyDown}\n   129→          placeholder=\"Add a description...\"\n   130→          data-testid=\"issue-description-editor\"\n   131→        />\n   132→      ) : (\n   133→        <div\n   134→          className={`issue-description-content ${!description ? 'issue-description-placeholder' : ''}`}\n   135→          onClick={handleClick}\n   136→          data-testid=\"issue-description-content\"\n   137→        >\n   138→          {description ? (\n   139→            <div\n   140→              className=\"issue-description-rendered\"\n   141→              dangerouslySetInnerHTML={{ __html: renderMarkdown(description) }}\n   142→              data-testid=\"issue-description-rendered\"\n   143→            />\n   144→          ) : (\n   145→            <span data-testid=\"issue-description-empty\">Add a description...</span>\n   146→          )}\n   147→        </div>\n   148→      )}\n   149→    </div>\n   150→  );\n   151→}\n   152→"}]},"parent_tool_use_id":"toolu_01SnAv1pfGxoXbMM9HAbhGYS","session_id":"30fcfe2a-f025-455e-bebe-907f186e0891","uuid":"3f020024-54ce-44b9-96a9-9b6e8fc023b2"}
