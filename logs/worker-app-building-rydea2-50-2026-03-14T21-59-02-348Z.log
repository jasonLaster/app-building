  }\n   104→\n   105→  function handleKeyDown(e: React.KeyboardEvent) {\n   106→    if (e.key === 'Escape') {\n   107→      setValue(description);\n   108→      setEditing(false);\n   109→    }\n   110→  }\n   111→\n   112→  function handleTextareaChange(e: React.ChangeEvent<HTMLTextAreaElement>) {\n   113→    setValue(e.target.value);\n   114→    // Auto-resize\n   115→    e.target.style.height = 'auto';\n   116→    e.target.style.height = e.target.scrollHeight + 'px';\n   117→  }\n   118→\n   119→  return (\n   120→    <div className=\"issue-description\" data-testid=\"issue-description\">\n   121→      {editing ? (\n   122→        <textarea\n   123→          ref={textareaRef}\n   124→          className=\"issue-description-editor\"\n   125→          value={value}\n   126→          onChange={handleTextareaChange}\n   127→          onBlur={handleBlur}\n   128→          onKeyDown={handleKeyDown}\n   129→          placeholder=\"Add a description...\"\n   130→          data-testid=\"issue-description-editor\"\n   131→        />\n   132→      ) : (\n   133→        <div\n   134→          className={`issue-description-content ${!description ? 'issue-description-placeholder' : ''}`}\n   135→          onClick={handleClick}\n   136→          data-testid=\"issue-description-content\"\n   137→        >\n   138→          {description ? (\n   139→            <div\n   140→              className=\"issue-description-rendered\"\n   141→              dangerouslySetInnerHTML={{ __html: renderMarkdown(description) }}\n   142→              data-testid=\"issue-description-rendered\"\n   143→            />\n   144→          ) : (\n   145→            <span data-testid=\"issue-description-empty\">Add a description...</span>\n   146→          )}\n   147→        </div>\n   148→      )}\n   149→    </div>\n   150→  );\n   151→}\n   152→"}]},"parent_tool_use_id":null,"session_id":"30fcfe2a-f025-455e-bebe-907f186e0891","uuid":"103e0b0b-5fdc-4562-b406-f02bf3aea5b7","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/src/components/IssueDescription.tsx","content":"import { useState, useRef, useEffect } from 'react';\nimport { useDispatch } from 'react-redux';\nimport type { AppDispatch } from '../store';\nimport { updateIssueField } from '../slices/issueDetailSlice';\nimport './IssueDescription.css';\n\ninterface IssueDescriptionProps {\n  issueId: string;\n  description: string;\n}\n\nfunction renderMarkdown(md: string): string {\n  let html = md\n    // Escape HTML entities\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;');\n\n  // Code blocks (```)\n  html = html.replace(/```([\\s\\S]*?)```/g, (_match, code) => {\n    return `<pre class=\"md-code-block\"><code>${code.trim()}</code></pre>`;\n  });\n\n  // Inline code\n  html = html.replace(/`([^`]+)`/g, '<code class=\"md-inline-code\">$1</code>');\n\n  // Headings\n  html = html.replace(/^### (.+)$/gm, '<h3>$1</h3>');\n  html = html.replace(/^## (.+)$/gm, '<h2>$1</h2>');\n  html = html.replace(/^# (.+)$/gm, '<h1>$1</h1>');\n\n  // Bold\n  html = html.replace(/\\*\\*(.+?)\\*\\*/g, '<strong>$1</strong>');\n\n  // Italic\n  html = html.replace(/\\*(.+?)\\*/g, '<em>$1</em>');\n\n  // Unordered lists\n  html = html.replace(/^- (.+)$/gm, '<li>$1</li>');\n  html = html.replace(/(<li>.*<\\/li>\\n?)+/g, (match) => `<ul>${match}</ul>`);\n\n  // Ordered lists\n  html = html.replace(/^\\d+\\. (.+)$/gm, '<li>$1</li>');\n  // Wrap consecutive <li> (not already in <ul>) in <ol>\n  html = html.replace(/(?<!<\\/ul>)(<li>.*<\\/li>\\n?)+/g, (match) => {\n    if (match.includes('<ul>')) return match;\n    return `<ol>${match}</ol>`;\n  });\n\n  // Paragraphs (lines that aren't already block elements)\n  const lines = html.split('\\n');\n  const result: string[] = [];\n  for (const line of lines) {\n    const trimmed = line.trim();\n    if (!trimmed) {\n      result.push('');\n    } else if (\n      trimmed.startsWith('<h') ||\n      trimmed.startsWith('<pre') ||\n      trimmed.startsWith('<ul') ||\n      trimmed.startsWith('<ol') ||\n      trimmed.startsWith('<li') ||\n      trimmed.startsWith('</ul') ||\n      trimmed.startsWith('</ol')\n    ) {\n      result.push(trimmed);\n    } else {\n      result.push(`<p>${trimmed}</p>`);\n    }\n  }\n\n  return result.join('\\n');\n}\n\nexport default function IssueDescription({ issueId, description }: IssueDescriptionProps) {\n  const dispatch = useDispatch<AppDispatch>();\n  const [editing, setEditing] = useState(false);\n  const [value, setValue] = useState(description);\n  const textareaRef = useRef<HTMLTextAreaElement>(null);\n\n  useEffect(() => {\n    setValue(description);\n  }, [description]);\n\n  useEffect(() => {\n    if (editing && textareaRef.current) {\n      textareaRef.current.focus();\n      // Auto-resize\n      textareaRef.current.style.height = 'auto';\n      textareaRef.current.style.height = textareaRef.current.scrollHeight + 'px';\n    }\n  }, [editing]);\n\n  function handleClick() {\n    setEditing(true);\n  }\n\n  async function handleBlur() {\n    if (value !== description) {\n      await dispatch(updateIssueField({ issueId, field: 'description', value }));\n    }\n    setEditing(false);\n  }\n\n  function handleKeyDown(e: React.KeyboardEvent) {\n    if (e.key === 'Escape') {\n      setValue(description);\n      setEditing(false);\n    }\n  }\n\n  function handleTextareaChange(e: React.ChangeEvent<HTMLTextAreaElement>) {\n    setValue(e.target.value);\n    // Auto-resize\n    e.target.style.height = 'auto';\n    e.target.style.height = e.target.scrollHeight + 'px';\n  }\n\n  return (\n    <div className=\"issue-description\" data-testid=\"issue-description\">\n      {editing ? (\n        <textarea\n          ref={textareaRef}\n          className=\"issue-description-editor\"\n          value={value}\n          onChange={handleTextareaChange}\n          onBlur={handleBlur}\n          onKeyDown={handleKeyDown}\n          placeholder=\"Add a description...\"\n          data-testid=\"issue-description-editor\"\n        />\n      ) : (\n        <div\n          className={`issue-description-content ${!description ? 'issue-description-placeholder' : ''}`}\n          onClick={handleClick}\n          data-testid=\"issue-description-content\"\n        >\n          {description ? (\n            <div\n              className=\"issue-description-rendered\"\n              dangerouslySetInnerHTML={{ __html: renderMarkdown(description) }}\n              data-testid=\"issue-description-rendered\"\n            />\n          ) : (\n            <span data-testid=\"issue-description-empty\">Add a description...</span>\n          )}\n        </div>\n      )}\n    </div>\n  );\n}\n","numLines":152,"startLine":1,"totalLines":152}}}
