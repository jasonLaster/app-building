   <Route path=\"/team/:teamId/cycles\" element={<ActiveCycle />} />\n    40→          <Route path=\"/issue/:issueId\" element={<IssueDetail />} />\n    41→          <Route path=\"/projects\" element={<Projects />} />\n    42→          <Route path=\"/project/:projectId\" element={<ProjectDetail />} />\n    43→          <Route path=\"/settings/members\" element={<Members />} />\n    44→          <Route path=\"/settings/teams\" element={<Teams />} />\n    45→          <Route path=\"/settings/labels\" element={<Labels />} />\n    46→          <Route path=\"/settings\" element={<Settings />} />\n    47→          <Route path=\"*\" element={<Navigate to=\"/my-issues\" replace />} />\n    48→        </Routes>\n    49→      </main>\n    50→      <KeyboardShortcuts />\n    51→      <CreateIssueModal />\n    52→    </div>\n    53→  );\n    54→}\n    55→\n    56→export default function App() {\n    57→  const dispatch = useDispatch<AppDispatch>();\n    58→  const { token, user } = useSelector((state: RootState) => state.auth);\n    59→  const location = useLocation();\n    60→\n    61→  useEffect(() => {\n    62→    if (token) {\n    63→      dispatch(fetchCurrentUser());\n    64→    }\n    65→  }, [dispatch, token]);\n    66→\n    67→  const isAuthPage = location.pathname === '/login' || location.pathname === '/signup';\n    68→\n    69→  if (!token && !isAuthPage) {\n    70→    return <Navigate to=\"/login\" replace />;\n    71→  }\n    72→\n    73→  if (token && !user) {\n    74→    return (\n    75→      <div className=\"app-loading\" data-testid=\"app-loading\">\n    76→        <div className=\"loading-spinner\" />\n    77→      </div>\n    78→    );\n    79→  }\n    80→\n    81→  if (token && user && isAuthPage) {\n    82→    return <Navigate to=\"/my-issues\" replace />;\n    83→  }\n    84→\n    85→  return (\n    86→    <Routes>\n    87→      <Route path=\"/login\" element={<Login />} />\n    88→      <Route path=\"/signup\" element={<SignUp />} />\n    89→      <Route path=\"/*\" element={<AuthenticatedLayout />} />\n    90→    </Routes>\n    91→  );\n    92→}\n    93→"}]},"parent_tool_use_id":"toolu_01SnAv1pfGxoXbMM9HAbhGYS","session_id":"30fcfe2a-f025-455e-bebe-907f186e0891","uuid":"fb39b1e5-c15b-47f0-8305-163ca6b92e12"}
