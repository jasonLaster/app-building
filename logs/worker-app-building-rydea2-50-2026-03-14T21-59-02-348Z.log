   59→);\n    60→\n    61→export interface CreateIssuePayload {\n    62→  teamId: string;\n    63→  title: string;\n    64→  description: string;\n    65→  status: string;\n    66→  priority: string;\n    67→  assigneeId: string | null;\n    68→  labelIds: string[];\n    69→  projectId: string | null;\n    70→  cycleId: string | null;\n    71→  dueDate: string | null;\n    72→  parentId: string | null;\n    73→}\n    74→\n    75→export const createIssue = createAsyncThunk(\n    76→  'issues/createIssue',\n    77→  async (payload: CreateIssuePayload, { getState, rejectWithValue }) => {\n    78→    const state = getState() as { auth: { token: string | null } };\n    79→    const token = state.auth.token;\n    80→    if (!token) return rejectWithValue('No token');\n    81→    const response = await fetch('/api/create-issue', {\n    82→      method: 'POST',\n    83→      headers: {\n    84→        'Content-Type': 'application/json',\n    85→        Authorization: `Bearer ${token}`,\n    86→      },\n    87→      body: JSON.stringify(payload),\n    88→    });\n    89→    if (!response.ok) {\n    90→      return rejectWithValue('Failed to create issue');\n    91→    }\n    92→    const data = await response.json();\n    93→    return data.issue as Issue;\n    94→  }\n    95→);\n    96→\n    97→export const updateIssueStatus = createAsyncThunk(\n    98→  'issues/updateIssueStatus',\n    99→  async ({ issueId, status }: { issueId: string; status: string }, { getState, rejectWithValue }) => {\n   100→    const state = getState() as { auth: { token: string | null } };\n   101→    const token = state.auth.token;\n   102→    if (!token) return rejectWithValue('No token');\n   103→    const response = await fetch('/api/update-issue-status', {\n   104→      method: 'PUT',\n   105→      headers: {\n   106→        'Content-Type': 'application/json',\n   107→        Authorization: `Bearer ${token}`,\n   108→      },\n   109→      body: JSON.stringify({ issueId, status }),\n   110→    });\n   111→    if (!response.ok) {\n   112→      return rejectWithValue('Failed to update status');\n   113→    }\n   114→    const data = await response.json();\n   115→    return { issueId, status: data.issue.status as string };\n   116→  }\n   117→);\n   118→\n   119→const issuesSlice = createSlice({\n   120→  name: 'issues',\n   121→  initialState,\n   122→  reducers: {},\n   123→  extraReducers: (builder) => {\n   124→    builder\n   125→      .addCase(fetchMyIssues.pending, (state) => {\n   126→        if (state.myIssues.length === 0) {\n   127→          state.loading = true;\n   128→        }\n   129→        state.error = null;\n   130→      })\n   131→      .addCase(fetchMyIssues.fulfilled, (state, action) => {\n   132→        state.loading = false;\n   133→        state.myIssues = action.payload;\n   134→      })\n   135→      .addCase(fetchMyIssues.rejected, (state, action) => {\n   136→        state.loading = false;\n   137→        state.error = action.payload as string;\n   138→      })\n   139→      .addCase(createIssue.fulfilled, (state, action) => {\n   140→        state.myIssues.unshift(action.payload);\n   141→      })\n   142→      .addCase(updateIssueStatus.fulfilled, (state, action) => {\n   143→        const { issueId, status } = action.payload;\n   144→        const issue = state.myIssues.find((i) => i.id === issueId);\n   145→        if (issue) {\n   146→          issue.status = status;\n   147→        }\n   148→      });\n   149→  },\n   150→});\n   151→\n   152→export default issuesSlice.reducer;\n   153→"}]},"parent_tool_use_id":"toolu_01SnAv1pfGxoXbMM9HAbhGYS","session_id":"30fcfe2a-f025-455e-bebe-907f186e0891","uuid":"280464fd-202f-49df-bd7b-09a6576762b9"}
