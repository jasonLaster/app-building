[2026-03-14T21:55:33.673Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BtBFsAu2BmdHyw4T6fdUpi","type":"tool_result","content":"     1→import { useEffect } from 'react';\n     2→import { useParams, useNavigate } from 'react-router-dom';\n     3→import { useSelector, useDispatch } from 'react-redux';\n     4→import type { RootState, AppDispatch } from '../store';\n     5→import { fetchIssueDetail, clearIssueDetail } from '../slices/issueDetailSlice';\n     6→import IssueHeader from '../components/IssueHeader';\n     7→import IssueDescription from '../components/IssueDescription';\n     8→import SubIssues from '../components/SubIssues';\n     9→import ActivityComments from '../components/ActivityComments';\n    10→import IssueSidebar from '../components/IssueSidebar';\n    11→import './IssueDetail.css';\n    12→\n    13→export default function IssueDetail() {\n    14→  const { issueId } = useParams<{ issueId: string }>();\n    15→  const dispatch = useDispatch<AppDispatch>();\n    16→  const navigate = useNavigate();\n    17→  const { token } = useSelector((state: RootState) => state.auth);\n    18→  const { issue, subIssues, activity, comments, members, projects, cycles, allLabels, loading, error } =\n    19→    useSelector((state: RootState) => state.issueDetail);\n    20→\n    21→  useEffect(() => {\n    22→    if (token && issueId) {\n    23→      dispatch(fetchIssueDetail(issueId));\n    24→    }\n    25→    return () => {\n    26→      dispatch(clearIssueDetail());\n    27→    };\n    28→  }, [dispatch, token, issueId]);\n    29→\n    30→  if (loading) {\n    31→    return (\n    32→      <div className=\"issue-detail-page\" data-testid=\"issue-detail-page\">\n    33→        <div className=\"issue-detail-loading\" data-testid=\"issue-detail-loading\">Loading...</div>\n    34→      </div>\n    35→    );\n    36→  }\n    37→\n    38→  if (error || !issue) {\n    39→    return (\n    40→      <div className=\"issue-detail-page\" data-testid=\"issue-detail-page\">\n    41→        <div className=\"issue-detail-error\" data-testid=\"issue-detail-error\">\n    42→          {error || 'Issue not found'}\n    43→          <button\n    44→            className=\"issue-detail-back-btn\"\n    45→            onClick={() => navigate(-1)}\n    46→            data-testid=\"issue-detail-back-btn\"\n    47→          >\n    48→            Go back\n    49→          </button>\n    50→        </div>\n    51→      </div>\n    52→    );\n    53→  }\n    54→\n    55→  return (\n    56→    <div className=\"issue-detail-page\" data-testid=\"issue-detail-page\">\n    57→      <div className=\"issue-detail-layout\" data-testid=\"issue-detail-layout\">\n    58→        <div className=\"issue-detail-main\" data-testid=\"issue-detail-main\">\n    59→          <IssueHeader issue={issue} />\n    60→          <IssueDescription issueId={issue.id} description={issue.description} />\n    61→          <SubIssues parentIssue={issue} subIssues={subIssues} />\n    62→          <ActivityComments issueId={issue.id} activity={activity} comments={comments} />\n    63→        </div>\n    64→        <div className=\"issue-detail-sidebar\" data-testid=\"issue-detail-sidebar\">\n    65→          <IssueSidebar\n    66→            issue={issue}\n    67→            members={members}\n    68→            projects={projects}\n    69→            cycles={cycles}\n    70→            allLabels={allLabels}\n    71→          />\n    72→        </div>\n    73→      </div>\n    74→    </div>\n    75→  );\n    76→}\n    77→"}]},"parent_tool_use_id":"toolu_01SnAv1pfGxoXbMM9HAbhGYS","session_id":"30fcfe2a-f025-455e-bebe-907f186e0891","uuid":"0737efee-7c4c-4acc-b4f8-089b992f4475"}
