ansition-colors disabled:opacity-50\"\n   761→              >\n   762→                {publishing ? (\n   763→                  <>\n   764→                    <Loader2 size={16} className=\"animate-spin\" />\n   765→                    Publishing...\n   766→                  </>\n   767→                ) : (\n   768→                  'Publish'\n   769→                )}\n   770→              </button>\n   771→            )}\n   772→          </div>\n   773→        </div>\n   774→      </div>\n   775→\n   776→      {showDiscardDialog && (\n   777→        <div\n   778→          data-testid=\"discard-dialog\"\n   779→          className=\"fixed inset-0 bg-black/50 flex items-center justify-center z-[60]\"\n   780→          onClick={() => setShowDiscardDialog(false)}\n   781→        >\n   782→          <div\n   783→            className=\"bg-white rounded-xl p-6 max-w-md w-full mx-4 shadow-lg\"\n   784→            onClick={(e) => e.stopPropagation()}\n   785→          >\n   786→            <h3 className=\"text-lg font-semibold text-text mb-2\">Discard your listing?</h3>\n   787→            <p className=\"text-text-secondary mb-6\">All entered information will be lost.</p>\n   788→            <div className=\"flex gap-3 justify-end\">\n   789→              <button\n   790→                data-testid=\"discard-dialog-keep\"\n   791→                onClick={() => setShowDiscardDialog(false)}\n   792→                className=\"px-4 py-2 text-sm font-medium text-text bg-bg-secondary rounded-lg hover:bg-border transition-colors\"\n   793→              >\n   794→                Keep Editing\n   795→              </button>\n   796→              <button\n   797→                data-testid=\"discard-dialog-confirm\"\n   798→                onClick={onClose}\n   799→                className=\"px-4 py-2 text-sm font-medium text-white bg-status-cancelled rounded-lg hover:opacity-90 transition-opacity\"\n   800→              >\n   801→                Discard\n   802→              <