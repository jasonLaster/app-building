ons.children,\n    54→    infants: options.infants,\n    55→    returnDate: options.returnDate,\n    56→  }))\n    57→  await expect(page.getByTestId('search-results-page')).toBeVisible({ timeout: 15000 })\n    58→  await expect(page.getByTestId('results-list')).toBeVisible({ timeout: 15000 })\n    59→\n    60→  let flightId: string\n    61→\n    62→  if (options.flightNumber) {\n    63→    const card = page.locator('[data-testid^=\"flight-card-\"]').filter({\n    64→      has: page.locator('[data-testid^=\"flight-card-flightnum-\"]', { hasText: new RegExp(`^${options.flightNumber}$`) })\n    65→    }).locator('[data-testid^=\"flight-card-main-\"]')\n    66→    await expect(card).toBeVisible({ timeout: 10000 })\n    67→    const testId = await card.getAttribute('data-testid')\n    68→    flightId = testId!.replace('flight-card-main-', '')\n    69→  } else {\n    70→    const firstCard = page.locator('[data-testid^=\"flight-card-main-\"]').first()\n    71→    const testId = await firstCard.getAttribute('data-testid')\n    72→    flightId = testId!.replace('flight-card-main-', '')\n    73→  }\n    74→\n    75→  const bookingParams = new URLSearchParams({\n    76→    cabin: options.cabinClass ?? 'economy',\n    77→    adults: options.adults ?? '1',\n    78→    children: options.children ?? '0',\n    79→    infants: options.infants ?? '0',\n    80→  })\n    81→\n    82→  await page.goto(`/booking/${flightId}?${bookingParams.toString()}`)\n    83→  await expect(page.getByTestId('flight-details-page')).toBeVisible({ timeout: 15000 })\n    84→  await expect(page.getByTestId('passenger-form')).toBeVisible({ timeout: 15000 })\n    85→\n    86→  return flightId\n    87→}\n    88→\n    89→test.describe('PassengerForm', () => {\n    90→  test('PassengerForm displays correct number of passenger forms', async ({ page }) => {\n    91→    await navigateToBookingPage(page, { adults: '2', children: '1' })\n    92→\n    93→    // Should have 3 passenger sub-forms\n    94→    await exp