(\n   216→              <span className=\"flight-card__amenity\" data-testid={`flight-card-wifi-${flight.id}`} title=\"Wi-Fi available\">\n   217→                📶 Wi-Fi\n   218→              </span>\n   219→            )}\n   220→            {flight.has_power && (\n   221→              <span className=\"flight-card__amenity\" data-testid={`flight-card-power-${flight.id}`} title=\"Power outlets available\">\n   222→                🔌 Power\n   223→              </span>\n   224→            )}\n   225→            {flight.has_entertainment && (\n   226→              <span className=\"flight-card__amenity\" data-testid={`flight-card-entertainment-${flight.id}`} title=\"In-flight entertainment\">\n   227→                🎬 Entertainment\n   228→              </span>\n   229→            )}\n   230→          </div>\n   231→\n   232→          <div className=\"flight-card__baggage\" data-testid={`flight-card-baggage-${flight.id}`}>\n   233→            <span className=\"flight-card__baggage-icon\">🧳</span>\n   234→            <span>\n   235→              {flight.cabin_class === 'economy'\n   236→                ? '1 carry-on bag, 1 personal item'\n   237→                : flight.cabin_class === 'premium_economy'\n   238→                  ? '1 carry-on bag, 1 checked bag included'\n   239→                  : '2 carry-on bags, 2 checked bags included'}\n   240→            </span>\n   241→          </div>\n   242→\n   243→          <div className=\"flight-card__actions\">\n   244→            <button\n   245→              className=\"flight-card__select-button\"\n   246→              onClick={handleSelect}\n   247→              data-testid={`flight-card-select-${flight.id}`}\n   248→            >\n   249→              Select flight · {formatPrice(flight.total_price_cents)}\n   250→            </button>\n   251→          </div>\n   252→        </div>\n   253→      )}\n   254→    </div>\n   255→  )\n   256→}\n   257→\n   258→function formatLayover(prevLeg: FlightLeg, nextLeg: FlightLeg): string {\n   259→  const prevArr = new Date(prevLeg.arrival_time).getTime()\n   260→  const nextDep = new Date(nextLeg.departure_time).getTime()\n   261→  const diffMinutes = Math.round((nextDep - prevArr) / (1000 * 60))\n   262→  return formatDuration(diffMinutes)\n   263→}\n   264→\n   265→export default FlightResultCard\n   266→"}]},"parent_tool_use_id":"toolu_01Nkzup3TR8CXxBMb4rmpbK4","session_id":"8c55d401-a852-4118-8076-86af31e25399","uuid":"ecb8cc4e-e146-4cb2-afc3-a5ecdfd20175"}
