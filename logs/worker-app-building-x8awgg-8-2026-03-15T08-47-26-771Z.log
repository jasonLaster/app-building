s = JSON.parse(readFileSync(resultsPath, 'utf-8'))\n   265→        for (const suite of (results.suites || [])) {\n   266→          for (const spec of (suite.specs || [])) {\n   267→            for (const test of (spec.tests || [])) {\n   268→              if (test.status === 'expected') passed++\n   269→              else if (test.status === 'unexpected') failed++\n   270→              else if (test.status === 'skipped') _skipped++\n   271→            }\n   272→          }\n   273→        }\n   274→      } catch { /* ignore parse errors */ }\n   275→    }\n   276→\n   277→    // Step 9: On failure, handle recordings\n   278→    let uploadedId = ''\n   279→    if (playwrightExit !== 0) {\n   280→      const recordingsLogPath = join(process.env.HOME || '~', '.replay', 'recordings.log')\n   281→      if (existsSync(recordingsLogPath)) {\n   282→        const lines = readFileSync(recordingsLogPath, 'utf-8').split('\\n').filter(Boolean)\n   283→        const recordings: Record<string, { id: string; duration?: number; result?: string; finished?: boolean }> = {}\n   284→\n   285→        for (const line of lines) {\n   286→          try {\n   287→            const entry = JSON.parse(line)\n   288→            if (entry.kind === 'createRecording') {\n   289→              recordings[entry.id] = { id: entry.id, duration: 0, finished: false }\n   290→            } else if (entry.kind === 'writeFinished' && recordings[entry.id]) {\n   291→              recordings[entry.id]!.finished = true\n   292→            } else if (entry.kind === 'addMetadata' && recordings[entry.id]) {\n   293→              const testResult = entry.metadata?.test?.result\n   294→              if (testResult) recordings[entry.id]!.result = testResult\n   295→              if (entry.metadata?.test?.duration) recordings[entry.id]!.duration = entry.metadata.test.duration\n   296→            }\n   297→          } catch { /* skip bad lines */ }\n   298→        }\n   299→\n   300→        // Find failed recordings\n   301→        const failedRecs = Object.values(recordings).filter(\n   302→          r => r.finished && (r.result === 'failed' || r.result === 'timedOut')\n   303→        )\n   304→\n   305→        log('\\n=== REPLAY RECORDINGS METADATA ===')\n   306→        for (const r of Object.values(recordings)) {\n   307→          log(JSON.stringify(r))\n   308→        }\n   309→        log('=== END REPLAY RECORDINGS METADATA ===')\n   310→\n   311→        if (failedRecs.length > 0) {\n   312→          // Pick the longest duration one\n   313→          failedRecs.sort((a, b) => (b.duration || 0) - (a.duration || 0))\n   314→          const toUpload = failedRecs[0]!\n   315→          log(`\\nUploading recording: ${toUpload.id}`)\n   316→          try {\n   317→            execSync(`npx replayio upload ${toUpload.id}`, {\n   318→              cwd: appDir,\n   319→              env: { ...process.env, RECORD_REPLAY_API_KEY },\n   320→              stdio: ['ignore', 'pipe', 'pipe'],\n   321→              timeout: 60000,\n   322→            })\n   323→            uploadedId = toUpload.id\n   324→            log(`REPLAY UPLOADED: ${uploadedId}`)\n   325→          } catch (ue: unknown) {\n   326→            const uploadErr = ue as { status?: number }\n   327→            log(`Upload failed with exit code: ${uploadErr.status}`)\n   328→          }\n   329→        }\n   330→      }\n   331→    }\n   332→\n   333→    // Clean up server\n   334→    serverProc.kill('SIGTERM')\n   335→    functionsProc.kill('SIGTERM')\n   336→\n   337→    // Step 10: Print summary\n   338→    writeFileSync(logPath, logContent)\n   339→\n   340→    let summary = ''\n   341→    if (failed > 0) {\n   342→      summary = `${passed} passed, ${failed} failed`\n   343→      if (uploadedId) summary += ` (recording: ${uploadedId})`\n   344→    } else if (passed > 0) {\n   345→      summary = `${passed} passed`\n   346→    } else {\n   347→      summary = playwrightExit === 0 ? 'Tests completed' : 'Tests failed'\n   348→    }\n   349→    summary += ` — see logs/test-run-${logNum}.log`\n   350→    console.log(summary)\n   351→  } finally {\n   352→    // Step 10: Clean up Neon branch\n   353→    try {\n   354→      await neonApi('DELETE', `/projects/${NEON_PROJECT_ID}/branches/${branchId}`)\n   355→      log('Cleaned up test branch')\n   356→    } catch { /* ignore */ }\n   357→\n   358→    // Remove local recordings\n   359→    try { execSync('npx replayio remove --all 2>/dev/null || true', { cwd: appDir, stdio: 'ignore' }) } catch { /* ignore */ }\n   360→\n   361→    writeFileSync(logPath, logContent)\n   362→  }\n   363→\n   364→  process.exit(playwrightExit)\n   365→}\n   366→\n   367→main().catch(e => {\n   368→  console.error(e)\n   369→  process.exit(1)\n   370→})\n   371→"}]},"parent_tool_use_id":"toolu_01E7qHHKtJAbvJbuNAA9SCp1","session_id":"8c55d401-a852-4118-8076-86af31e25399","uuid":"7ad03a18-ae37-45d9-9bcd-33b77a11441b"}
