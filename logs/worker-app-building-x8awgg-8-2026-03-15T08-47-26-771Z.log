oadAction<SortOption>) {\n   231→      state.sortBy = action.payload\n   232→    },\n   233→    setStopsFilter(state, action: PayloadAction<StopsFilter>) {\n   234→      state.stopsFilter = action.payload\n   235→    },\n   236→    setAirlinesFilter(state, action: PayloadAction<string[]>) {\n   237→      state.airlinesFilter = action.payload\n   238→    },\n   239→    setPriceRange(state, action: PayloadAction<[number, number]>) {\n   240→      state.priceRange = action.payload\n   241→    },\n   242→    setDurationRange(state, action: PayloadAction<[number, number]>) {\n   243→      state.durationRange = action.payload\n   244→    },\n   245→    setDepartureTimeFilter(state, action: PayloadAction<TimeFilter>) {\n   246→      state.departureTimeFilter = action.payload\n   247→    },\n   248→    setArrivalTimeFilter(state, action: PayloadAction<TimeFilter>) {\n   249→      state.arrivalTimeFilter = action.payload\n   250→    },\n   251→    resetFilters(state) {\n   252→      state.stopsFilter = { nonstop: false, oneStop: false, twoPlusStops: false }\n   253→      state.airlinesFilter = []\n   254→      state.priceRange = state.priceRangeMax\n   255→      state.durationRange = state.durationRangeMax\n   256→      state.departureTimeFilter = { morning: false, afternoon: false, evening: false, night: false }\n   257→      state.arrivalTimeFilter = { morning: false, afternoon: false, evening: false, night: false }\n   258→      state.sortBy = 'best'\n   259→    },\n   260→  },\n   261→  extraReducers: (builder) => {\n   262→    builder\n   263→      .addCase(searchFlights.pending, (state) => {\n   264→        state.loading = true\n   265→        state.flights = []\n   266→        state.expandedLegs = {}\n   267→        state.expandedLegsLoading = {}\n   268→      })\n   269→      .addCase(searchFlights.fulfilled, (state, action) => {\n   270→        state.flights = action.payload.flights\n   271→        state.total = action.payload.total\n   272→        state.page = action.payload.page\n   273→        state.totalPages = action.payload.totalPages\n   274→        state.loading = false\n   275→\n   276→        // Calculate price and duration ranges\n   277→        if (action.payload.flights.length > 0) {\n   278→          const prices = action.payload.flights.map(f => f.total_price_cents)\n   279→          const durations = action.payload.flights.map(f => f.duration_minutes)\n   280→          const minPrice = Math.min(...prices)\n   281→          const maxPrice = Math.max(...prices)\n   282→          const minDuration = Math.min(...durations)\n   283→          const maxDuration = Math.max(...durations)\n   284→          state.priceRange = [minPrice, maxPrice]\n   285→          state.priceRangeMax = [minPrice, maxPrice]\n   286→          state.durationRange = [minDuration, maxDuration]\n   287→          state.durationRangeMax = [minDuration, maxDuration]\n   288→        }\n   289→\n   290→        // Reset filters on new search\n   291→        state.stopsFilter = { nonstop: false, oneStop: false, twoPlusStops: false }\n   292→        state.airlinesFilter = []\n   293→        state.departureTimeFilter = { morning: false, afternoon: false, evening: false, night: false }\n   294→        state.arrivalTimeFilter = { morning: false, afternoon: false, evening: false, night: false }\n   295→        state.sortBy = 'best'\n   296→      })\n   297→      .addCase(searchFlights.rejected, (state) => {\n   298→        state.loading = false\n   299→      })\n   300→      .addCase(loadMoreFlights.pending, (state) => {\n   301→        state.loadingMore = true\n   302→      })\n   303→      .addCase(loadMoreFlights.fulfilled, (state, action) => {\n   304→        state.flights = [...state.flights, ...action.payload.flights]\n   305→        state.page = action.payload.page\n   306→        state.totalPages = action.payload.totalPages\n   307→        state.total = action.payload.total\n   308→        state.loadingMore = false\n   309→\n   310→        // Update ranges with new data\n   311→        if (state.flights.length > 0) {\n   312→          const prices = state.flights.map(f => f.total_price_cents)\n   313→          const durations = state.flights.map(f => f.duration_minutes)\n   314→          const oldPriceMax = state.priceRangeMax\n   315→          const oldDurationMax = state.durationRangeMax\n   316→          const newPriceMin = Math.min(...prices)\n   317→          const newPriceMax = Math.max(...prices)\n   318→          const newDurationMin = Math.min(...durations)\n   319→          const newDurationMax = Math.max(...durations)\n   320→          state.priceRangeMax = [newPriceMin, newPriceMax]\n   321→          state.durationRangeMax = [newDurationMin, newDurationMax]\n   322→          // Expand priceRange/durationRange if they were at the old max bounds\n   323→          if (state.priceRange[0] === oldPriceMax[0]) state.priceRange[0] = newPriceMin\n   324→          if (state.priceRange[1] === oldPriceMax[1]) state.priceRange[1] = newPriceMax\n   325→          if (state.durationRange[0] === oldDurationMax[0]) state.durationRange[0] = newDurationMin\n   326→          if (state.durationRange[1] === oldDurationMax[1]) state.durationRange[1] = newDurationMax\n   327→        }\n   328→      })\n   329→      .addCase(loadMoreFlights.rejected, (state) => {\n   330→        state.loadingMore = false\n   331→      })\n   332→      .addCase(fetchFlightLegs.pending, (state, action) => {\n   333→        state.expandedLegsLoading[action.meta.arg] = true\n   334→      })\n   335→      .addCase(fetchFlightLegs.fulfilled, (state, action) => {\n   336→        state.expandedLegs[action.payload.flightId] = action.payload.legs\n   337→        state.expandedLegsLoading[action.payload.flightId] = false\n   338→      })\n   339→      .addCase(fetchFlightLegs.rejected, (state, action) => {\n   340→        state.expandedLegsLoading[action.meta.arg] = false\n   341→      })\n   342→      .addCase(checkTrackedRoute.pending, (state) => 