1→  morning: boolean   // 6:00 - 12:00\n    62→  afternoon: boolean // 12:00 - 18:00\n    63→  evening: boolean   // 18:00 - 24:00\n    64→  night: boolean     // 0:00 - 6:00\n    65→}\n    66→\n    67→interface FlightsState {\n    68→  flights: FlightResult[]\n    69→  loading: boolean\n    70→  total: number\n    71→  page: number\n    72→  totalPages: number\n    73→  loadingMore: boolean\n    74→  sortBy: SortOption\n    75→  stopsFilter: StopsFilter\n    76→  airlinesFilter: string[]\n    77→  priceRange: [number, number]\n    78→  priceRangeMax: [number, number]\n    79→  durationRange: [number, number]\n    80→  durationRangeMax: [number, number]\n    81→  departureTimeFilter: TimeFilter\n    82→  arrivalTimeFilter: TimeFilter\n    83→  expandedLegs: Record<string, FlightLeg[]>\n    84→  expandedLegsLoading: Record<string, boolean>\n    85→  isTracked: boolean\n    86→  isTrackedLoading: boolean\n    87→}\n    88→\n    89→const initialState: FlightsState = {\n    90→  flights: [],\n    91→  loading: false,\n    92→  total: 0,\n    93→  page: 1,\n    94→  totalPages: 0,\n    95→  loadingMore: false,\n    96→  sortBy: 'best',\n    97→  stopsFilter: { nonstop: false, oneStop: false, twoPlusStops: false },\n    98→  airlinesFilter: [],\n    99→  priceRange: [0, 10000],\n   100→  priceRangeMax: [0, 10000],\n   101→  durationRange: [0, 2880],\n   102→  durationRangeMax: [0, 2880],\n   103→  departureTimeFilter: { morning: false, afternoon: false, evening: false, night: false },\n   104→  arrivalTimeFilter: { morning: false, afternoon: false, evening: false, night: false },\n   105→  expandedLegs: {},\n   106→  expandedLegsLoading: {},\n   107→  isTracked: false,\n   108→  isTrackedLoading: false,\n   109→}\n   110→\n   111→export const searchFlights = createAsyncThunk(\n   112→  'flights/searchFlights',\n   113→  async (params: {\n   114→    origin: string\n   115→    destination: string\n   116→    departureDate: string\n   117→    cabinClass: string\n   118→    page?: number\n   119→  }) => {\n   120→    const qs = new URLSearchParams({\n   121→      origin: params.origin,\n   122→      destination: params.destination,\n   123→      departureDate: params.departureDate,\n   124→      cabinClass: params.cabinClass,\n   125→      page: String(params.page || 1),\n   126→    })\n   127→    const res = await fetch(`/api/search-flights?${qs}`)\n   128→    return res.json() as Promise<{\n   129→      flights: FlightResult[]\n   130→      total: number\n   131→      page: number\n   132→      totalPages: number\n   133→    }>\n   134→  }\n   135→)\n   136→\n   137→export const loadMoreFlights = createAsyncThunk(\n   138→  'flights/loadMoreFlights',\n   139→  async (params: {\n   140→    origin: string\n   141→    destination: string\n   142→    departureDate: string\n   143→    cabinClass: string\n   144→    page: number\n   145→  }) => {\n   146→    const qs = new URLSearchParams({\n   147→      origin: params.origin,\n   148→      destination: params.destination,\n   149→      departureDate: params.departureDate,\n   150→      cabinClass: params.cabinClass,\n   151→      page: String(params.page),\n   152→    })\n   153→    const res = await fetch(`/api/search-flights?${qs}`)\n   154→    return res.json() as Promise<{\n   155→      flights: FlightResult[]\n   156→      total: number\n   157→      page: number\n   158→      totalPages: number\n   159→    }>\n   160→  }\n   161→)\n   162→\n   163→export const fetchFlightLegs = createAsyncThunk(\n   164→  'flights/fetchFlightLegs',\n   165→  async (flightId: string) => {\n   166→    const res = await fetch(`/api/flight-legs?flightId=${encodeURIComponent(flightId)}`)\n   167→    const legs = await res.json() as FlightLeg[]\n   168→    return { flightId, legs }\n   169→  }\n   170→)\n   171→\n   172→export const checkTrackedRoute = createAsyncThunk(\n   173→  'flights/checkTrackedRoute',\n   174→  async (params: { sessionToken: string; origin: string; destination: string }) => {\n   17