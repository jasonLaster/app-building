lector((state: RootState) => state.auth.token);\n    49→\n    50→  const [openDropdown, setOpenDropdown] = useState<DropdownType>(null);\n    51→  const [assigneeSearch, setAssigneeSearch] = useState('');\n    52→  const [projectSearch, setProjectSearch] = useState('');\n    53→  const [parentSearch, setParentSearch] = useState('');\n    54→  const [parentResults, setParentResults] = useState<SearchableIssue[]>([]);\n    55→\n    56→  // Team-specific data (members, projects, cycles)\n    57→  const [teamMembers, setTeamMembers] = useState<Array<{ id: string; name: string; email: string }>>([]);\n    58→  const [teamProjects, setTeamProjects] = useState<Array<{ id: string; name: string }>>([]);\n    59→  const [teamCycles, setTeamCycles] = useState<Array<{ id: string; name: string; start_date: string; end_date: string }>>([]);\n    60→\n    61→  const formRef = useRef<HTMLDivElement>(null);\n    62→  const titleRef = useRef<HTMLInputElement>(null);\n    63→\n    64→  // Focus title on mount\n    65→  useEffect(() => {\n    66→    titleRef.current?.focus();\n    67→  }, []);\n    68→\n    69→  // Set default team\n    70→  useEffect(() => {\n    71→    if (defaultTeamId && !formData.teamId) {\n    72→      onFormChange({ ...formData, teamId: defaultTeamId });\n    73→    } else if (!formData.teamId && teams.length > 0 && teams[0]) {\n    74→      onFormChange({ ...formData, teamId: teams[0].id });\n    75→    }\n    76→  }, [defaultTeamId, teams]); // eslint-disable-line react-hooks/exhaustive-deps\n    77→\n    78→  // Fetch team-specific data when team changes\n    79→  const fetchTeamData = useCallback(async (teamId: string) => {\n    80→    if (!token || !teamId) return;\n    81→    try {\n    82→      const response = await fetch(`/api/team-issues?teamId=${teamId}`, {\n    83→        headers: { Authorization: `Bearer ${token}` },\n    84→      });\n    85→      if (response.ok) {\n    86→        const data = await response.json();\n    87→        setTeamMembers(