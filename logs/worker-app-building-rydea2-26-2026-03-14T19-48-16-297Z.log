e: 13px;\n  font-weight: 500;\n  cursor: pointer;\n  white-space: nowrap;\n  transition: opacity 150ms ease;\n}\n\n.comment-submit-btn:disabled {\n  opacity: 0.4;\n  cursor: not-allowed;\n}\n\n.comment-submit-btn:not(:disabled):hover {\n  opacity: 0.9;\n}\n","structuredPatch":[],"originalFile":null}}
