[2026-03-14T19:36:13.878Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011aW2B6rjF4wUa4eer1eE4D","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions';\n     2→import { getSql } from './db';\n     3→\n     4→export default async function handler(req: Request, _context: Context) {\n     5→  if (req.method !== 'GET') {\n     6→    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n     7→      status: 405,\n     8→      headers: { 'Content-Type': 'application/json' },\n     9→    });\n    10→  }\n    11→\n    12→  try {\n    13→    const authHeader = req.headers.get('Authorization');\n    14→    if (!authHeader?.startsWith('Bearer ')) {\n    15→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    16→        status: 401,\n    17→        headers: { 'Content-Type': 'application/json' },\n    18→      });\n    19→    }\n    20→\n    21→    const token = authHeader.slice(7);\n    22→    const sql = getSql();\n    23→\n    24→    const sessions = await sql`\n    25→      SELECT s.member_id FROM sessions s\n    26→      WHERE s.token = ${token} AND s.expires_at > NOW()\n    27→    `;\n    28→    const session = sessions[0];\n    29→    if (!session) {\n    30→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    31→        status: 401,\n    32→        headers: { 'Content-Type': 'application/json' },\n    33→      });\n    34→    }\n    35→\n    36→    const url = new URL(req.url);\n    37→    const teamId = url.searchParams.get('teamId');\n    38→    if (!teamId) {\n    39→      return new Response(JSON.stringify({ error: 'teamId is required' }), {\n    40→        status: 400,\n    41→        headers: { 'Content-Type': 'application/json' },\n    42→      });\n    43→    }\n    44→\n    45→    const issues = await sql`\n    46→      SELECT\n    47→        i.id,\n    48→        i.title,\n    49→        i.description,\n    50→        i.status,\n    51→        i.priority,\n    52→        i.number,\n    53→        i.due_date,\n    54→        i.created_at,\n    55→        i.updated_at,\n    56→        i.team_id,\n    57→        i.assignee_id,\n    58→        i.project_id,\n    59→        i.cycle_id,\n    60→        i.parent_id,\n    61→        t.identifier AS team_identifier,\n    62→        t.name AS team_name,\n    63→        p.name AS project_name,\n    64→        m.name AS assignee_name,\n    65→        m.email AS assignee_email,\n    66→        c.name AS cycle_name\n    67→      FROM issues i\n    68→      JOIN teams t ON t.id = i.team_id\n    69→      LEFT JOIN projects p ON p.id = i.project_id\n    70→      LEFT JOIN members m ON m.id = i.assignee_id\n    71→      LEFT JOIN cycles c ON c.id = i.cycle_id\n    72→      WHERE i.team_id = ${teamId}\n    73→      ORDER BY i.created_at DESC\n    74→    `;\n    75→\n    76→    const issueIds = issues.map((i) => i.id);\n    77→\n    78→    let issueLabels: Array<{ issue_id: string; label_id: string; label_name: string; label_color: string }> = [];\n    79→    if (issueIds.length > 0) {\n    80→      issueLabels = await sql`\n    81→        SELECT il.issue_id, l.id AS label_id, l.name AS label_name, l.color AS label_color\n    82→        FROM issue_labels il\n    83→        JOIN labels l ON l.id = il.label_id\n    84→        WHERE il.issue_id = ANY(${issueIds})\n    85→      `;\n    86→    }\n    87→\n    88→    const labelsByIssue: Record<string, Array<{ id: string; name: string; color: string }>> = {};\n    89→    for (const il of issueLabels) {\n    90→      if (!labelsByIssue[il.issue_id]) {\n    91→        labelsByIssue[il.issue_id] = [];\n    92→      }\n    93→      labelsByIssue[il.issue_id].push({\n    94→        id: il.label_id,\n    95→        name: il.label_name,\n    96→        color: il.label_color,\n    97→      });\n    98→    }\n    99→\n   100→    const enrichedIssues = issues.map((issue) => ({\n   101→      id: issue.id,\n   102→      title: issue.title,\n   103→      description: issue.description,\n   104→      status: issue.status,\n   105→      priority: issue.priority,\n   106→      identifier: `${issue.team_identifier}-${issue.number}`,\n   107→      number: issue.number,\n   108→      dueDate: issue.due_date ? String(issue.due_date).split('T')[0] : null,\n   109→      createdAt: issue.created_at,\n   110→      updatedAt: issue.updated_at,\n   111→      teamId: issue.team_id,\n   112→      teamName: issue.team_name,\n   113→      assigneeId: issue.assignee_id,\n   114→      assigneeName: issue.assignee_name,\n   115→      assigneeEmail: issue.assignee_email,\n   116→      projectId: issue.project_id,\n   117→      projectName: issue.project_name,\n   118→      cycleId: issue.cycle_id,\n   119→      cycleName: issue.cycle_name,\n   120→      parentId: issue.parent_id,\n   121→      labels: labelsByIssue[issue.id] || [],\n   122→    }));\n   123→\n   124→    // Also fetch team members for assignee filter\n   125→    const members = await sql`\n   126→      SELECT m.id, m.name, m.email\n   127→      FROM members m\n   128→      JOIN team_members tm ON tm.member_id = m.id\n   129→      WHERE tm.team_id = ${teamId}\n   130→      ORDER BY m.name ASC\n   131→    `;\n   132→\n   133→    // Fetch team projects for project filter\n   134→    const projects = await sql`\n   135→      SELECT DISTINCT p.id, p.name\n   136→      FROM projects p\n   137→      JOIN issues i ON i.project_id = p.id\n   138→      WHERE i.team_id = ${teamId}\n   139→      ORDER BY p.name ASC\n   140→    `;\n   141→\n   142→    // Fetch team cycles for cycle filter\n   143→    const cycles = await sql`\n   144→      SELECT c.id, c.name, c.start_date, c.end_date\n   145→      FROM cycles c\n   146→      WHERE c.team_id = ${teamId}\n   147→      ORDER BY c.start_date DESC\n   148→    `;\n   149→\n   150→    return new Response(JSON.stringify({\n   151→      issues: enrichedIssues,\n   152→      members,\n   153→      projects,\n   154→      cycles,\n   155→    }), {\n   156→      status: 200,\n   157→      headers: { 'Content-Type': 'application/json' },\n   158→    });\n   159→  } catch (err) {\n   160→    console.error('Fetch team issues error:', err);\n   161→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n   162→      status: 500,\n   163→      headers: { 'Content-Type': 'application/json' },\n   164→    });\n   165→  }\n   166→}\n   167→"}]},"parent_tool_use_id":"toolu_01SJzCzLNg8CQ19fUkzZhFgY","session_id":"6da3f93c-eebf-4489-9bbd-9b71bb41a908","uuid":"b87db45a-867b-4a64-bf99-e3abb4e5919b"}
