cx=\"7\" cy=\"7\" r=\"6\" stroke={color} strokeWidth=\"1.5\" strokeDasharray=\"2 2\" />\n    34→        </svg>\n    35→      );\n    36→    case 'todo':\n    37→      return (\n    38→        <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\">\n    39→          <circle cx=\"7\" cy=\"7\" r=\"6\" stroke={color} strokeWidth=\"1.5\" />\n    40→        </svg>\n    41→      );\n    42→    case 'in_progress':\n    43→      return (\n    44→        <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\">\n    45→          <circle cx=\"7\" cy=\"7\" r=\"6\" stroke={color} strokeWidth=\"1.5\" />\n    46→          <path d=\"M7 1a6 6 0 0 1 0 12\" fill={color} />\n    47→        </svg>\n    48→      );\n    49→    case 'in_review':\n    50→      return (\n    51→        <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\">\n    52→          <circle cx=\"7\" cy=\"7\" r=\"6\" stroke={color} strokeWidth=\"1.5\" />\n    53→          <path d=\"M7 1a6 6 0 0 1 0 12 6 6 0 0 1-6-6\" fill={color} />\n    54→        </svg>\n    55→      );\n    56→    case 'done':\n    57→      return (\n    58→        <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\">\n    59→          <circle cx=\"7\" cy=\"7\" r=\"6.5\" fill={color} />\n    60→          <path d=\"M4.5 7l2 2 3.5-3.5\" stroke=\"#fff\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n    61→        </svg>\n    62→      );\n    63→    case 'cancelled':\n    64→      return (\n    65→        <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\">\n    66→          <circle cx=\"7\" cy=\"7\" r=\"6\" stroke={color} strokeWidth=\"1.5\" />\n    67→          <path d=\"M5 5l4 4M9 5l-4 4\" stroke={color} strokeWidth=\"1.5\" strokeLinecap=\"round\" />\n    68→        </svg>\n    69→      );\n    70→    default:\n    71→      return (\n    72→        <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\">\n    73→          <circle cx=\"7\" cy=\"7\" r=\"6\" stroke={color} strokeWidth=\"1.5\" />\n    74→        </svg>\n    75→      );\n    76→  }\n    77→}\n    78→\n    79→function PriorityIcon({ priority }: { priority: string }) {\n    80→  const config = PRIORITY_CONFIG[priority] || PRIORITY_CONFIG.none;\n    81→  const color = config.color;\n    82→\n    83→  switch (priority) {\n    84→    case 'urgent':\n    85→      return (\n    86→        <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke={color} strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n    87→          <path d=\"M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z\" />\n    88→          <line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\" />\n    89→          <line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\" />\n    90→        </svg>\n    91→      );\n    92→    case 'high':\n    93→      return (\n    94→        <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke={color} strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n    95→          <line x1=\"12\" y1=\"19\" x2=\"12\" y2=\"5\" />\n    96→          <polyline points=\"5 12 12 5 19 12\" />\n    97→        </svg>\n    98→      );\n    99→    case 'medium':\n   100→      return (\n   101→        <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke={color} strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n   102→          <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\" />\n   103→        </svg>\n   104→      );\n   105→    case 'low':\n   106→      return (\n   107→        <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke={color} strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n   108→          <line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\" />\n   109→          <polyline points=\"19 12 12 19 5 12\" />\n   110→        </svg>\n   111→      );\n   112→    default:\n   113→      return (\n   114→        <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke={color} strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n   115→          <circle cx=\"5\" cy=\"12\" r=\"1.5\" fill={color} />\n   116→          <circle cx=\"12\" cy=\"12\" r=\"1.5\" fill={color} />\n   117→          <circle cx=\"19\" cy=\"12\" r=\"1.5\" fill={color} />\n   118→        </svg>\n   119→      );\n   120→  }\n   121→}\n   122→\n   123→function getInitials(name: string): string {\n   124→  return name\n   125→    .split(' ')\n   126→    .map((n) => n[0])\n   127→    .join('')\n   128→    .toUpperCase()\n   129→    .slice(0, 2);\n   130→}\n   131→\n   132→function formatDueDate(dateStr: string): string {\n   133→  const date = new Date(dateStr + 'T00:00:00');\n   134→  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });\n   135→}\n   136→\n   137→interface IssueRowProps {\n   138→  issue: Issue;\n   139→  showCheckbox?: boolean;\n   140→  checked?: boolean;\n   141→  onCheckChange?: (issueId: string) => void;\n   142→}\n   143→\n   144→export default function IssueRow({ issue, showCheckbox, checked, onCheckChange }: IssueRowProps) {\n   145→  const dispatch = useDispatch<AppDispatch>();\n   146→  const navigate = useNavigate();\n   147→  const [statusDropdownOpen, setStatusDropdownOpen] = useState(false);\n   148→  const dropdownRef = useRef<HTMLDivElement>(null);\n   149→\n   150→  useEffect(() => {\n   151→    function handleClickOutside(e: MouseEvent) {\n   152→      if (dropdownRef.current && !dropdownRef.current.contains(e.target as Node)) {\n   153→        setStatusDropdownOpen(false);\n   154→      }\n   155→    }\n   156→    if (statusDropdownOpen) {\n   157→      document.addEventListener('mousedown', handleClickOutside);\n   158→    }\n   159→    return () => document.removeEventListener('mousedown', handleClickOutside);\n   160→  }, [statusDropdownOpen]);\n   161→\n   162→  function handleTitleClick() {\n   163→    navigate(`/issue/${issue.id}`);\n   164→  }\n   165→\n   166→  function handleStatusClick(e: React.MouseEvent) {\n   167→    e.stopPropagation();\n   168→    setStatusDropdownOpen(!statusDropdownOpen);\n   169→  }\n   170→\n   171→  function handleStatusChange(newStatus: string) {\n   172→    dispatch(updateIssueStatus({ issueId: issue.id, status: newStatus }));\n   173→    setStatusDropdownOpen(false);\n   174→  }\n   175→\n   176→  const statusConfig = STATUS_CONFIG[issue.status] || STATUS_CONFIG.todo;\n   177→  const priorityConfig = PRIORITY_CONFIG[issue.priority] || PRIORITY_CONFIG.none;\n   178→\n   179→  return (\n   180→    <div className={`issue-row ${checked ? 'issue-row-selected' : ''}`} data-testid={`issue-row-${issue.id}`}>\n   181→      <div className=\"issue-row-left\">\n   182→        {showCheckbox && (\n   183→          <label className=\"issue-row-checkbox-wrapper\" data-testid={`issue-checkbox-${issue.id}`} onClick={(e) => e.stopPropagation()}>\n   184→            <input\n   185→              type=\"checkbox\"\n   186→              className=\"issue-row-checkbox\"\n   187→              checked={!!checked}\n   188→              onChange={() => onCheckChange?.(issue.id)}\n   189→            />\n   190→          </label>\n   191→        )}\n   192→        <span className=\"issue-row-priority\" title={priorityConfig.label} data-testid={`issue-priority-${issue.id}`}>\n   193→          <PriorityIcon priority={issue.priority} />\n   194→        </span>\n   195→        <span className=\"issue-row-identifier\" data-testid={`issue-identifier-${issue.id}`}>\n   196→          {issue.identifier}\n   197→        </span>\n   198→        <button\n   199→          className=\"issue-row-title\"\n   200→          onClick={handleTitleClick}\n   201→          data-testid={`issue-title-${issue.id}`}\n   202→        >\n   203→          {issue.title}\n   204→        </button>\n   205→      </div>\n   206→      <div className=\"issue-row-right\">\n   207→        {issue.labels.length