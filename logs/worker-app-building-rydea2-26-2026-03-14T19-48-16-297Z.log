[2026-03-14T19:36:05.106Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JfQBSRW9fuVcw1dQpS4zrB","type":"tool_result","content":"     1→import { useEffect, useMemo, useState } from 'react';\n     2→import { useParams } from 'react-router-dom';\n     3→import { useSelector, useDispatch } from 'react-redux';\n     4→import type { RootState, AppDispatch } from '../store';\n     5→import { fetchTeamIssues } from '../slices/teamIssuesSlice';\n     6→import { fetchLabels } from '../slices/labelsSlice';\n     7→import { openCreateIssueModal } from '../slices/uiSlice';\n     8→import TeamFilters from '../components/TeamFilters';\n     9→import GroupBySort from '../components/GroupBySort';\n    10→import BulkActions from '../components/BulkActions';\n    11→import TeamIssuesList from '../components/TeamIssuesList';\n    12→import './TeamIssues.css';\n    13→\n    14→export default function TeamIssues() {\n    15→  const { teamId } = useParams<{ teamId: string }>();\n    16→  const dispatch = useDispatch<AppDispatch>();\n    17→  const { token } = useSelector((state: RootState) => state.auth);\n    18→  const { items: teams } = useSelector((state: RootState) => state.teams);\n    19→  const { items: teamIssues, loading } = useSelector((state: RootState) => state.teamIssues);\n    20→\n    21→  const [selectedStatuses, setSelectedStatuses] = useState<string[]>([]);\n    22→  const [selectedPriorities, setSelectedPriorities] = useState<string[]>([]);\n    23→  const [selectedAssignees, setSelectedAssignees] = useState<string[]>([]);\n    24→  const [selectedLabels, setSelectedLabels] = useState<string[]>([]);\n    25→  const [selectedProjects, setSelectedProjects] = useState<string[]>([]);\n    26→  const [selectedCycles, setSelectedCycles] = useState<string[]>([]);\n    27→\n    28→  const team = teams.find((t) => t.id === teamId);\n    29→\n    30→  useEffect(() => {\n    31→    if (token && teamId) {\n    32→      dispatch(fetchTeamIssues(teamId));\n    33→      dispatch(fetchLabels());\n    34→    }\n    35→  }, [dispatch, token, teamId]);\n    36→\n    37→  const filteredIssues = useMemo(() => {\n    38→    return teamIssues.filter((issue) => {\n    39→      if (selectedStatuses.length > 0 && !selectedStatuses.includes(issue.status)) {\n    40→        return false;\n    41→      }\n    42→      if (selectedPriorities.length > 0 && !selectedPriorities.includes(issue.priority)) {\n    43→        return false;\n    44→      }\n    45→      if (selectedAssignees.length > 0) {\n    46→        const matchesAssignee = selectedAssignees.some((a) => {\n    47→          if (a === 'unassigned') return !issue.assigneeId;\n    48→          return issue.assigneeId === a;\n    49→        });\n    50→        if (!matchesAssignee) return false;\n    51→      }\n    52→      if (selectedLabels.length > 0) {\n    53→        const issueLabelIds = issue.labels.map((l) => l.id);\n    54→        if (!selectedLabels.some((labelId) => issueLabelIds.includes(labelId))) {\n    55→          return false;\n    56→        }\n    57→      }\n    58→      if (selectedProjects.length > 0) {\n    59→        const matchesProject = selectedProjects.some((p) => {\n    60→          if (p === 'none') return !issue.projectId;\n    61→          return issue.projectId === p;\n    62→        });\n    63→        if (!matchesProject) return false;\n    64→      }\n    65→      if (selectedCycles.length > 0) {\n    66→        const matchesCycle = selectedCycles.some((c) => {\n    67→          if (c === 'none') return !issue.cycleId;\n    68→          return issue.cycleId === c;\n    69→        });\n    70→        if (!matchesCycle) return false;\n    71→      }\n    72→      return true;\n    73→    });\n    74→  }, [teamIssues, selectedStatuses, selectedPriorities, selectedAssignees, selectedLabels, selectedProjects, selectedCycles]);\n    75→\n    76→  function handleNewIssue() {\n    77→    dispatch(openCreateIssueModal());\n    78→  }\n    79→\n    80→  return (\n    81→    <div className=\"team-issues-page\" data-testid=\"team-issues-page\">\n    82→      <div className=\"team-issues-header\">\n    83→        <div className=\"team-issues-header-left\">\n    84→          <h1 className=\"team-issues-title\" data-testid=\"team-issues-title\">\n    85→            {team?.name || 'Team'} Issues\n    86→          </h1>\n    87→        </div>\n    88→        <button\n    89→          className=\"team-issues-new-btn\"\n    90→          onClick={handleNewIssue}\n    91→          data-testid=\"new-issue-btn\"\n    92→        >\n    93→          <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n    94→            <line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\" />\n    95→            <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\" />\n    96→          </svg>\n    97→          New Issue\n    98→        </button>\n    99→      </div>\n   100→\n   101→      <div className=\"team-issues-toolbar\">\n   102→        <TeamFilters\n   103→          selectedStatuses={selectedStatuses}\n   104→          selectedPriorities={selectedPriorities}\n   105→          selectedAssignees={selectedAssignees}\n   106→          selectedLabels={selectedLabels}\n   107→          selectedProjects={selectedProjects}\n   108→          selectedCycles={selectedCycles}\n   109→          onStatusChange={setSelectedStatuses}\n   110→          onPriorityChange={setSelectedPriorities}\n   111→          onAssigneeChange={setSelectedAssignees}\n   112→          onLabelChange={setSelectedLabels}\n   113→          onProjectChange={setSelectedProjects}\n   114→          onCycleChange={setSelectedCycles}\n   115→        />\n   116→        <GroupBySort />\n   117→      </div>\n   118→\n   119→      <BulkActions teamId={teamId || ''} />\n   120→      <TeamIssuesList issues={filteredIssues} loading={loading} />\n   121→    </div>\n   122→  );\n   123→}\n   124→"}]},"parent_tool_use_id":"toolu_01SJzCzLNg8CQ19fUkzZhFgY","session_id":"6da3f93c-eebf-4489-9bbd-9b71bb41a908","uuid":"c5e66e31-16ef-4be5-a48e-0b75fc5172a7"}
