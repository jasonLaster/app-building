d` attributes matching test requirements.\n\n<DONE>"}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":461,"cache_read_input_tokens":125702,"cache_creation":{"ephemeral_5m_input_tokens":461,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard","inference_geo":"global"},"context_management":null},"parent_tool_use_id":null,"session_id":"6da3f93c-eebf-4489-9bbd-9b71bb41a908","uuid":"a769f681-abc7-4327-8759-fe63a4f5fb64"}
