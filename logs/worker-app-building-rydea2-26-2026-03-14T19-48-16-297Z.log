[2026-03-14T19:37:04.028Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013fCaRLpb6rMvSjhiPQgkww","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions';\n     2→import { getSql } from './db';\n     3→\n     4→export default async function handler(req: Request, _context: Context) {\n     5→  if (req.method !== 'GET') {\n     6→    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n     7→      status: 405,\n     8→      headers: { 'Content-Type': 'application/json' },\n     9→    });\n    10→  }\n    11→\n    12→  try {\n    13→    const authHeader = req.headers.get('Authorization');\n    14→    if (!authHeader?.startsWith('Bearer ')) {\n    15→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    16→        status: 401,\n    17→        headers: { 'Content-Type': 'application/json' },\n    18→      });\n    19→    }\n    20→\n    21→    const token = authHeader.slice(7);\n    22→    const sql = getSql();\n    23→\n    24→    const sessions = await sql`\n    25→      SELECT s.member_id FROM sessions s\n    26→      WHERE s.token = ${token} AND s.expires_at > NOW()\n    27→    `;\n    28→    const session = sessions[0];\n    29→    if (!session) {\n    30→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    31→        status: 401,\n    32→        headers: { 'Content-Type': 'application/json' },\n    33→      });\n    34→    }\n    35→\n    36→    const url = new URL(req.url);\n    37→    const query = url.searchParams.get('q') || '';\n    38→    const teamId = url.searchParams.get('teamId') || '';\n    39→\n    40→    let issues;\n    41→    if (query) {\n    42→      issues = await sql`\n    43→        SELECT DISTINCT ON (i.id) i.id, i.title, i.number, t.identifier AS team_identifier\n    44→        FROM issues i\n    45→        JOIN teams t ON t.id = i.team_id\n    46→        WHERE (i.title ILIKE ${'%' + query + '%'} OR CONCAT(t.identifier, '-', i.number) ILIKE ${'%' + query + '%'})\n    47→        ${teamId ? sql`AND i.team_id = ${teamId}` : sql``}\n    48→        ORDER BY i.id, i.created_at DESC\n    49→        LIMIT 20\n    50→      `;\n    51→    } else if (teamId) {\n    52→      issues = await sql`\n    53→        SELECT i.id, i.title, i.number, t.identifier AS team_identifier\n    54→        FROM issues i\n    55→        JOIN teams t ON t.id = i.team_id\n    56→        WHERE i.team_id = ${teamId}\n    57→        ORDER BY i.created_at DESC\n    58→        LIMIT 20\n    59→      `;\n    60→    } else {\n    61→      issues = await sql`\n    62→        SELECT i.id, i.title, i.number, t.identifier AS team_identifier\n    63→        FROM issues i\n    64→        JOIN teams t ON t.id = i.team_id\n    65→        ORDER BY i.created_at DESC\n    66→        LIMIT 20\n    67→      `;\n    68→    }\n    69→\n    70→    const results = issues.map((i) => ({\n    71→      id: i.id,\n    72→      title: i.title,\n    73→      identifier: `${i.team_identifier}-${i.number}`,\n    74→    }));\n    75→\n    76→    return new Response(JSON.stringify({ issues: results }), {\n    77→      status: 200,\n    78→      headers: { 'Content-Type': 'application/json' },\n    79→    });\n    80→  } catch (err) {\n    81→    console.error('Search issues error:', err);\n    82→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n    83→      status: 500,\n    84→      headers: { 'Content-Type': 'application/json' },\n    85→    });\n    86→  }\n    87→}\n    88→"}]},"parent_tool_use_id":"toolu_01SJzCzLNg8CQ19fUkzZhFgY","session_id":"6da3f93c-eebf-4489-9bbd-9b71bb41a908","uuid":"7ae3edc6-326c-4db2-ba34-015bf813d961"}
