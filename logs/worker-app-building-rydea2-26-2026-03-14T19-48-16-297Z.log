  39→      }\n    40→      return true;\n    41→    });\n    42→  }, [myIssues, selectedStatuses, selectedPriorities, selectedLabels]);\n    43→\n    44→  return (\n    45→    <div className=\"my-issues-page\" data-testid=\"my-issues-page\">\n    46→      <div className=\"my-issues-header\">\n    47→        <h1 className=\"my-issues-title\" data-testid=\"my-issues-title\">My Issues</h1>\n    48→      </div>\n    49→      <FiltersToolbar\n    50→        selectedStatuses={selectedStatuses}\n    51→        selectedPriorities={selectedPriorities}\n    52→        selectedLabels={selectedLabels}\n    53→        onStatusChange={setSelectedStatuses}\n    54→        onPriorityChange={setSelectedPriorities}\n    55→        onLabelChange={setSelectedLabels}\n    56→      />\n    57→      <MyIssuesList issues={filteredIssues} loading={loading} />\n    58→    </div>\n    59→  );\n    60→}\n    61→"}]},"parent_tool_use_id":"toolu_01SJzCzLNg8CQ19fUkzZhFgY","session_id":"6da3f93c-eebf-4489-9bbd-9b71bb41a908","uuid":"3456610e-4bca-4a8d-9a99-e433af4ec6cf"}
