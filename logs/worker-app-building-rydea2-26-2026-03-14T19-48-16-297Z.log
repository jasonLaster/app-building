"my-issues-empty\">\n    54→        <svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--color-text-tertiary)\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n    55→          <circle cx=\"12\" cy=\"12\" r=\"10\" />\n    56→          <line x1=\"8\" y1=\"12\" x2=\"16\" y2=\"12\" />\n    57→        </svg>\n    58→        <p>No issues assigned to you yet</p>\n    59→      </div>\n    60→    );\n    61→  }\n    62→\n    63→  return (\n    64→    <div className=\"my-issues-list\" data-testid=\"my-issues-list\">\n    65→      {groups.map((group) => {\n    66→        const isCollapsed = !!collapsedGroups[group.status];\n    67→        return (\n    68→          <div key={group.status} className=\"my-issues-group\" data-testid={`issue-group-${group.status}`}>\n    69→            <button\n    70→              className=\"my-issues-group-header\"\n    71→              onClick={() => toggleGroup(group.status)}\n    72→              data-testid={`issue-group-header-${group.status}`}\n    73→            >\n    74→              <svg\n    75→                className={`my-issues-group-chevron ${isCollapsed ? '' : 'my-issues-group-chevron-expanded'}`}\n    76→                width=\"12\"\n    77→                height=\"12\"\n    78→                viewBox=\"0 0 24 24\"\n    79→                fill=\"none\"\n    80→                stroke=\"currentColor\"\n    81→                strokeWidth=\"2\"\n    82→                strokeLinecap=\"round\"\n    83→                strokeLinejoin=\"round\"\n    84→              >\n    85→                <polyline points=\"9 18 15 12 9 6\" />\n    86→              </svg>\n    87→              <StatusIcon status={group.status} color={group.color} />\n    88→              <span className=\"my-issues-group-label\">{group.label}</span>\n    89→              <span className=\"my-issues-group-count\">({group.issues.length})</span>\n    90→            </button>\n    91→            {!isCollapsed && (\n    92→              <div className=\"my-issues-group-items\" data-testid={`issue-group-items-${group.status}`}>\n    93→                {group.issues.map((issue) => (\n    94→                  <IssueRow key={issue.id} issue={issue} />\n    95→                ))}\n    96→              </div>\n    97→            )}\n    98→          </div>\n    99→        );\n   100→      })}\n   101→    </div>\n   102→  );\n   103→}\n   104→"}]},"parent_tool_use_id":"toolu_01SJzCzLNg8CQ19fUkzZhFgY","session_id":"6da3f93c-eebf-4489-9bbd-9b71bb41a908","uuid":"db8615d6-ef1c-448d-9b60-5c5a472b1926"}
