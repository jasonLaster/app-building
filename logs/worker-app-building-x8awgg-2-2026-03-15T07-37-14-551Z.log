ilterSidebar.css","content":".filter-sidebar {\n  background: var(--color-surface);\n  border-radius: var(--radius-lg);\n  box-shadow: 0 1px 3px var(--color-shadow);\n  padding: 20px;\n  width: 280px;\n  flex-shrink: 0;\n}\n\n.filter-sidebar__section {\n  padding-bottom: 16px;\n  margin-bottom: 16px;\n  border-bottom: 1px solid var(--color-border-light);\n}\n\n.filter-sidebar__section:last-child {\n  border-bottom: none;\n  margin-bottom: 0;\n  padding-bottom: 0;\n}\n\n.filter-sidebar__section-title {\n  font-size: 14px;\n  font-weight: 600;\n  color: var(--color-text-primary);\n  margin-bottom: 12px;\n}\n\n.filter-sidebar__checkbox {\n  display: flex;\n  align-items: flex-start;\n  gap: 10px;\n  padding: 6px 0;\n  cursor: pointer;\n  font-size: 14px;\n  color: var(--color-text-primary);\n}\n\n.filter-sidebar__checkbox input[type=\"checkbox\"] {\n  width: 18px;\n  height: 18px;\n  margin-top: 1px;\n  accent-color: var(--color-primary);\n  cursor: pointer;\n  flex-shrink: 0;\n}\n\n.filter-sidebar__time-label {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n.filter-sidebar__time-range {\n  font-size: 12px;\n  color: var(--color-text-tertiary);\n}\n\n/* Sort Dropdown */\n.filter-sidebar__sort {\n  position: relative;\n}\n\n.filter-sidebar__sort-button {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  width: 100%;\n  padding: 8px 12px;\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-md);\n  background: var(--color-surface);\n  font-size: 14px;\n  color: var(--color-text-primary);\n  cursor: pointer;\n  transition: border-color 0.15s;\n}\n\n.filter-sidebar__sort-button:hover {\n  border-color: var(--color-primary);\n}\n\n.filter-sidebar__sort-arrow {\n  transition: transform 0.2s;\n  font-size: 12px;\n  color: var(--color-text-secondary);\n}\n\n.filter-sidebar__sort-arrow--open {\n  transform: rotate(180deg);\n}\n\n.filter-sidebar__sort-dropdown {\n  position: absolute;\n  top: calc(100% + 4px);\n  left: 0;\n  right: 0;\n  z-index: 50;\n  background: var(--color-surface);\n  border-radius: var(--radius-md);\n  box-shadow: 0 4px 12px var(--color-shadow-hover);\n  overflow: hidden;\n}\n\n.filter-sidebar__sort-option {\n  display: block;\n  width: 100%;\n  padding: 10px 12px;\n  text-align: left;\n  font-size: 14px;\n  color: var(--color-text-primary);\n  background: none;\n  border: none;\n  cursor: pointer;\n  transition: background 0.1s;\n}\n\n.filter-sidebar__sort-option:hover {\n  background: var(--color-primary-light);\n}\n\n.filter-sidebar__sort-option--selected {\n  color: var(--color-primary);\n  font-weight: 500;\n  background: var(--color-primary-light);\n}\n\n/* Range Slider */\n.range-slider {\n  padding: 4px 0;","numLines":130,"startLine":1,"totalLines":212}}}
