nc ({ page }) => {\n   303→    // Open sort dropdown\n   304→    await page.getByTestId('sort-dropdown-button').click()\n   305→    await expect(page.getByTestId('sort-dropdown')).toBeVisible()\n   306→\n   307→    // Select Price (lowest)\n   308→    await page.getByTestId('sort-option-price').click()\n   309→\n   310→    // Verify dropdown closed and shows new selection\n   311→    await expect(page.getByTestId('sort-dropdown-button')).toContainText('Price (lowest)')\n   312→\n   313→    // Verify results are sorted by price ascending\n   314→    // Get all price elements\n   315→    const priceElements = page.locator('[data-testid^=\"flight-card-price-\"]')\n   316→    const count = await priceElements.count()\n   317→    expect(count).toBeGreaterThan(1)\n   318→\n   319→    const prices: number[] = []\n   320→    for (let i = 0; i < count; i++) {\n   321→      const text = await priceElements.nth(i).textContent()\n   322→      const price = parseInt(text!.replace('$', ''), 10)\n   323→      prices.push(price)\n   324→    }\n   325→\n   326→    // Verify ascending order\n   327→    for (let i = 1; i < prices.length; i++) {\n   328→      expect(prices[i]).toBeGreaterThanOrEqual(prices[i - 1]!)\n   329→    }\n   330→  })\n   331→\n   332→  test('FilterSidebar sort by Duration (shortest)', async ({ page }) => {\n   333→    // Open sort dropdown and select Duration\n   334→    await page.getByTestId('sort-dropdown-button').click()\n   335→    await expect(page.getByTestId('sort-dropdown')).toBeVisible()\n   336→    await page.getByTestId('sort-option-duration').click()\n   337→\n   338→    await expect(page.getByTestId('sort-dropdown-button')).toContainText('Duration (shortest)')\n   339→\n   340→    // Verify results are sorted by duration ascending\n   341→    const durationElements = page.locator('[data-testid^=\"flight-card-duration-\"]')\n   342→    const count = await durationElements.count()\n   343→    expect(count).toBeGreaterThan(1)\n   344→\n   345→    const durations: number[] = []\n   346→    for (let i = 0; i < count; i++) {\n   347→      const text = await durationElements.nth(i).textContent()\n   348→      // Parse duration like \"5h 30m\" or \"7h\"\n   349→      const match = text!.match(/(\\d+)h(?:\\s*(\\d+)m)?/)\n   350→      if (match) {\n   351→        const hours = parseInt(match[1]!, 10)\n   352→        const minutes = parseInt(match[2] || '0', 10)\n   353→        durations.push(hours * 60 + minutes)\n   354→      }\n   355→    }\n   356→\n   357→    // Verify ascending order\n   358→    for (let i = 1; i < durations.length; i++) {\n   359→      expect(durations[i]).toBeGreaterThanOrEqual(durations[i - 1]!)\n   360→    }\n   361→  })\n   362→\n   363→  test('FilterSidebar sort by Departure time (earliest)', async ({ page }) => {\n   364→    // Open sort dropdown and select Departure time\n   365→    await page.getByTestId('sort-dropdown-button').click()\n   366→    await expect(page.getByTestId('sort-dropdown')).toBeVisible()\n   367→    await page.getByTestId('sort-option-departure').click()\n   368→\n   369→    await expect(page.getByTestId('sort-dropdown-button')).toContainText('Departure time (earliest)')\n   370→\n   371→    // Verify results are sorted by departure time ascending\n   372→    const departureElements = page.locator('[data-testid^=\"flight-card-departure-\"]')\n   373→    const count = await departureElements.count()\n   374→    expect(count).toBeGreaterThan(1)\n   375→\n   376→    // First flight should have earliest departure (B6400 at 6:00 AM)\n   377→    await expect(departureElements.first()).toContainText('6:00')\n   378→  })\n   379→\n   380→  test('FilterSidebar sort by Arrival time (earliest)', async ({ page }) => {\n   381→    // Open sort dropdown and select Arrival time\n   382→    await page.getByTestId('sort-dropdown-button').click()\n   383→    await expect(page.getByTestId('sort-dropdown')).toBeVisible()\n   384→    await page.getByTestId('sort-option-arrival').click()\