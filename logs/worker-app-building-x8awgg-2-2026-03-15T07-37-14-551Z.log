[2026-03-15T07:21:21.956Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01T2RzZdr9Bk5jhyX9gpd3MK","type":"tool_result","content":"     1→import { useState } from 'react'\n     2→import { useSelector, useDispatch } from 'react-redux'\n     3→import { useNavigate, useSearchParams } from 'react-router-dom'\n     4→import type { RootState, AppDispatch } from '../store'\n     5→import type { FlightResult, FlightLeg } from '../slices/flightsSlice'\n     6→import { fetchFlightLegs } from '../slices/flightsSlice'\n     7→import './FlightResultCard.css'\n     8→\n     9→interface FlightResultCardProps {\n    10→  flight: FlightResult\n    11→}\n    12→\n    13→function formatTime(dateStr: string): string {\n    14→  const date = new Date(dateStr)\n    15→  return date.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true })\n    16→}\n    17→\n    18→function formatDuration(minutes: number): string {\n    19→  const h = Math.floor(minutes / 60)\n    20→  const m = minutes % 60\n    21→  return m > 0 ? `${h}h ${m}m` : `${h}h`\n    22→}\n    23→\n    24→function formatPrice(cents: number): string {\n    25→  return `$${Math.round(cents / 100)}`\n    26→}\n    27→\n    28→function getStopsLabel(numLegs: number): string {\n    29→  if (numLegs <= 1) return 'Nonstop'\n    30→  if (numLegs === 2) return '1 stop'\n    31→  return `${numLegs - 1} stops`\n    32→}\n    33→\n    34→function getAirlineInitials(name: string): string {\n    35→  return name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase()\n    36→}\n    37→\n    38→function getDayDiff(dep: string, arr: string): number {\n    39→  const depDate = new Date(dep)\n    40→  const arrDate = new Date(arr)\n    41→  const depDay = new Date(depDate.getFullYear(), depDate.getMonth(), depDate.getDate())\n    42→  const arrDay = new Date(arrDate.getFullYear(), arrDate.getMonth(), arrDate.getDate())\n    43→  return Math.round((arrDay.getTime() - depDay.getTime()) / (1000 * 60 * 60 * 24))\n    44→}\n    45→\n    46→function FlightResultCard({ flight }: FlightResultCardProps) {\n    47→  const dispatch = useDispatch<AppDispatch>()\n    48→  const navigate = useNavigate()\n    49→  const [searchParams] = useSearchParams()\n    50→  const [expanded, setExpanded] = useState(false)\n    51→\n    52→  const legs = useSelector((state: RootState) => state.flights.expandedLegs[flight.id])\n    53→  const legsLoading = useSelector((state: RootState) => state.flights.expandedLegsLoading[flight.id])\n    54→  const passengers = useSelector((state: RootState) => state.search.passengers)\n    55→\n    56→  function handleToggleExpand() {\n    57→    if (!expanded && !legs && !legsLoading) {\n    58→      dispatch(fetchFlightLegs(flight.id))\n    59→    }\n    60→    setExpanded(!expanded)\n    61→  }\n    62→\n    63→  function handleSelect(e: React.MouseEvent) {\n    64→    e.stopPropagation()\n    65→    const cabinClass = searchParams.get('cabinClass') || 'economy'\n    66→    navigate(`/booking/${flight.id}?cabin=${encodeURIComponent(cabinClass)}&adults=${passengers.adults}&children=${passengers.children}&infants=${passengers.infants}`)\n    67→  }\n    68→\n    69→  const dayDiff = getDayDiff(flight.departure_time, flight.arrival_time)\n    70→\n    71→  return (\n    72→    <div\n    73→      className={`flight-card ${expanded ? 'flight-card--expanded' : ''}`}\n    74→      data-testid={`flight-card-${flight.id}`}\n    75→    >\n    76→      <div className=\"flight-card__main\" onClick={handleToggleExpand} data-testid={`flight-card-main-${flight.id}`}>\n    77→        <div className=\"flight-card__airline\">\n    78→          <div\n    79→            className=\"flight-card__airline-logo\"\n    80→            style={{ backgroundColor: flight.logo_color || '#1A73E8' }}\n    81→            data-testid={`flight-card-logo-${flight.id}`}\n    82→          >\n    83→            {getAirlineInitials(flight.airline_name)}\n    84→          </div>\n    85→          <span className=\"flight-card__airline-name\" data-testid={`flight-card-airline-${flight.id}`}>\n    86→            {flight.airline_name}\n    87→          </span>\n    88→          <span className=\"flight-card__flight-number\" data-testid={`flight-card-flightnum-${flight.id}`}>\n    89→            {flight.flight_number}\n    90→          </span>\n    91→        </div>\n    92→\n    93→        <div className=\"flight-card__times\">\n    94→          <div className=\"flight-card__time-display\">\n    95→            <span className=\"flight-card__time\" data-testid={`flight-card-departure-${flight.id}`}>\n    96→              {formatTime(flight.departure_time)}\n    97→            </span>\n    98→            <span className=\"flight-card__time-arrow\">→</span>\n    99→            <span className=\"flight-card__time\" data-testid={`flight-card-arrival-${flight.id}`}>\n   100→              {formatTime(flight.arrival_time)}\n   101→              {dayDiff > 0 && (\n   102→                <span className=\"flight-card__day-indicator\" data-testid={`flight-card-day-${flight.id}`}>\n   103→                  +{dayDiff}\n   104→                </span>\n   105→              )}\n   106→            </span>\n   107→          </div>\n   108→          <div className=\"flight-card__route-codes\">\n   109→            {flight.origin_code} – {flight.dest_code}\n   110→          </div>\n   111→        </div>\n   112→\n   113→        <div className=\"flight-card__duration\" data-testid={`flight-card-duration-${flight.id}`}>\n   114→          <span className=\"flight-card__duration-text\">{formatDuration(flight.duration_minutes)}</span>\n   115→          <span className=\"flight-card__stops\" data-testid={`flight-card-stops-${flight.id}`}>\n   116→            {getStopsLabel(Number(flight.num_legs))}{flight.layover_codes ? ` · ${flight.layover_codes}` : ''}\n   117→          </span>\n   118→        </div>\n   119→\n   120→        <div className=\"flight-card__co2\" data-testid={`flight-card-co2-${flight.id}`}>\n   121→          {flight.co2_kg} kg CO₂\n   122→        </div>\n   123→\n   124→        <div className=\"flight-card__price\" data-testid={`flight-card-price-${flight.id}`}>\n   125→          {formatPrice(flight.total_price_cents)}\n   126→        </div>\n   127→\n   128→        <div className=\"flight-card__expand-icon\">\n   129→          {expanded ? '▲' : '▼'}\n   130→        </div>\n   131→      </div>\n   132→\n   133→      {expanded && (\n   134→        <div className=\"flight-card__details\" data-testid={`flight-card-details-${flight.id}`}>\n   135→          {legsLoading ? (\n   136→            <div className=\"flight-card__details-loading\" data-testid={`flight-card-loading-${flight.id}`}>\n   137→              Loading flight details...\n   138→            </div>\n   139→          ) : legs && legs.length > 0 ? (\n   140→            <div className=\"flight-card__legs\">\n   141→              {legs.map((leg: FlightLeg, index: number) => (\n   142→                <div key={leg.id}>\n   143→                  {index > 0 && (\n   144→                    <div className=\"flight-card__layover\" data-testid={`flight-card-layover-${flight.id}-${index}`}>\n   145→                      <div className=\"flight-card__layover-line\" />\n   146→                      <span className=\"flight-card__layover-text\">\n   147→                        {formatLayover(legs[index - 1]!, leg)} layover at {leg.origin_code}\n   148→                      </span>\n   149→                      <div className=\"flight-card__layover-line\" />\n   150→                    </div>\n   151→                  )}\n   152→                  <div className=\"flight-card__leg\" data-testid={`flight-card-leg-${flight.id}-${leg.leg_order}`}>\n   153→                    <div className=\"flight-card__leg-timeline\">\n   154→                      <div className=\"flight-card__leg-dot\" />\n   155→                      <div className=\"flight-card__leg-line\" />\n   156→                      <div className=\"flight-card__leg-dot\" />\n   157→                    </div>\n   158→                    <div className=\"flight-card__leg-info\">\n   159→                      <div className=\"flight-card__leg-row\">\n   160→                        <span className=\"flight-card__leg-time\">{formatTime(leg.departure_time)}</span>\n   161→                        <span className=\"flight-card__leg-airport\">\n   162→                          {leg.origin_name} ({leg.origin_code})\n   163→                          {leg.terminal_departure && <span className=\"flight-card__leg-terminal\"> · Terminal {leg.terminal_departure}</span>}\n   164→                        </span>\n   165→                      </div>\n   166→                      <div className=\"flight-card__leg-meta\">\n   167→                        <span>{formatDuration(leg.duration_minutes)}</span>\n   168→                        <span className=\"flight-card__leg-flight-num\">\n   169→                          {leg.airline_name || flight.airline_name} · {leg.flight_number}\n   170→                        </span>\n   171→                        {leg.aircraft_type && (\n   172→                          <span className=\"flight-card__leg-aircraft\">{leg.aircraft_type}</span>\n   173→                        )}\n   174→                      </div>\n   175→                      <div className=\"flight-card__leg-row\">\n   176→                        <span className=\"flight-card__leg-time\">{formatTime(leg.arrival_time)}</span>\n   177→                        <span className=\"flight-card__leg-airport\">\n   178→                          {leg.dest_name} ({leg.dest_code})\n   179→                          {leg.terminal_arrival && <span className=\"flight-card__leg-terminal\"> · Terminal {leg.terminal_arrival}</span>}\n   180→                        </span>\n   181→                      </div>\n   182→                    </div>\n   183→                  </div>\n   184→                </div>\n   185→              ))}\n   186→            </div>\n   187→          ) : (\n   188→            <div className=\"flight-card__legs\">\n   189→              <div className=\"flight-card__leg\" data-testid={`flight-card-leg-${flight.id}-single`}>\n   190→                <div className=\"flight-card__leg-timeline\">\n   191→                  <div className=\"flight-card__leg-dot\" />\n   192→                  <div className=\"flight-card__leg-line\" />\n   193→                  <div className=\"flight-card__leg-dot\" />\n   194→                </div>\n   195→                <div className=\"flight-card__leg-info\">\n   196→                  <div className=\"flight-card__leg-row\">\n   197→                    <span className=\"flight-card__leg-time\">{formatTime(flight.departure_time)}</span>\n   198→                    <span className=\"flight-card__leg-airport\">{flight.origin_name} ({flight.origin_code})</span>\n   199→                  </div>\n   200→                  <div className=\"flight-card__leg-meta\">\n   201→                    <span>{formatDuration(flight.duration_minutes)}</span>\n   202→                    <span className=\"flight-card__leg-flight-num\">{flight.airline_name} · {flight.flight_number}</span>\n   203→                    {flight.aircraft_type && <span className=\"flight-card__leg-aircraft\">{flight.aircraft_type}</span>}\n   204→                  </div>\n   205→                  <div className=\"flight-card__leg-row\">\n   206→                    <span className=\"flight-card__leg-time\">{formatTime(flight.arrival_time)}</span>\n   207→                    <span className=\"flight-card__leg-airport\">{flight.dest_name} ({flight.dest_code})</span>\n   208→                  </div>\n   209→                </div>\n   210→              </div>\n   211→            </div>\n   212→          )}\n   213→\n   214→          <div className=\"flight-card__amenities\" data-testid={`flight-card-amenities-${flight.id}`}>\n   215→            {flight.has_wifi && (\n   216→              <span className=\"flight-card__amenity\" data-testid={`flight-card-wifi-${flight.id}`} title=\"Wi-Fi available\">\n   217→                📶 Wi-Fi\n   218→              </span>\n   219→            )}\n   220→            {flight.has_power && (\n   221→              <span className=\"flight-card__amenity\" data-testid={`flight-card-power-${flight.id}`} title=\"Power outlets available\">\n   222→                🔌 Power\n   223→              </span>\n   224→            )}\n   225→            {flight.has_entertainment && (\n   226→              <span className=\"flight-card__amenity\" data-testid={`flight-card-entertainment-${flight.id}`} title=\"In-flight entertainment\">\n   227→                🎬 Entertainment\n   228→              </span>\n   229→            )}\n   230→          </div>\n   231→\n   232→          <div className=\"flight-card__baggage\" data-testid={`flight-card-baggage-${flight.id}`}>\n   233→            <span className=\"flight-card__baggage-icon\">🧳</span>\n   234→            <span>\n   235→              {flight.cabin_class === 'economy'\n   236→                ? '1 carry-on bag, 1 personal item'\n   237→                : flight.cabin_class === 'premium_economy'\n   238→                  ? '1 carry-on bag, 1 checked bag included'\n   239→                  : '2 carry-on bags, 2 checked bags included'}\n   240→            </span>\n   241→          </div>\n   242→\n   243→          <div className=\"flight-card__actions\">\n   244→            <button\n   245→              className=\"flight-card__select-button\"\n   246→              onClick={handleSelect}\n   247→              data-testid={`flight-card-select-${flight.id}`}\n   248→            >\n   249→              Select flight · {formatPrice(flight.total_price_cents)}\n   250→            </button>\n   251→          </div>\n   252→        </div>\n   253→      )}\n   254→    </div>\n   255→  )\n   256→}\n   257→\n   258→function formatLayover(prevLeg: FlightLeg, nextLeg: FlightLeg): string {\n   259→  const prevArr = new Date(prevLeg.arrival_time).getTime()\n   260→  const nextDep = new Date(nextLeg.departure_time).getTime()\n   261→  const diffMinutes = Math.round((nextDep - prevArr) / (1000 * 60))\n   262→  return formatDuration(diffMinutes)\n   263→}\n   264→\n   265→export default FlightResultCard\n   266→"}]},"parent_tool_use_id":"toolu_01MeNV7soe8dY7oVYrAXueWC","session_id":"05a60624-77ab-43db-a283-e7b7bde69626","uuid":"eccfb401-516d-4170-859d-f05c6b414e2a"}
