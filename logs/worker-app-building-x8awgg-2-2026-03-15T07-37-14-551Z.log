n formatCabinClass(cls: string): string {\n    53→  const map: Record<string, string> = {\n    54→    economy: 'Economy',\n    55→    premium_economy: 'Premium Economy',\n    56→    business: 'Business',\n    57→    first: 'First',\n    58→  }\n    59→  return map[cls] || cls\n    60→}\n    61→\n    62→function formatPassengers(adults: number, children: number, infants: number): string {\n    63→  const total = adults + children + infants\n    64→  if (total === 1) return '1 adult'\n    65→  return `${total} passengers`\n    66→}\n    67→\n    68→function SearchSummaryBar({\n    69→  origin, destination, departureDate, returnDate, tripType,\n    70→  cabinClass, adults, children, infants, onSearch,\n    71→}: SearchSummaryBarProps) {\n    72→  const [editing, setEditing] = useState<EditingField>(null)\n    73→  const containerRef = useRef<HTMLDivElement>(null)\n    74→\n    75→  const searchState = useSelector((state: RootState) => state.search)\n    76→\n    77→  useEffect(() => {\n    78→    function handleClickOutside(e: MouseEvent) {\n    79→      if (containerRef.current && !containerRef.current.contains(e.target as Node)) {\n    80→        setEditing(null)\n    81→      }\n    82→    }\n    83→    document.addEventListener('mousedown', handleClickOutside)\n    84→    return () => document.removeEventListener('mousedown', handleClickOutside)\n    85→  }, [])\n    86→\n    87→  function handleOriginSelect(airport: Airport | null) {\n    88→    if (airport) {\n    89→      onSearch({ origin: airport })\n    90→      setEditing(null)\n    91→    }\n    92→  }\n    93→\n    94→  function handleDestinationSelect(airport: Airport | null) {\n    95→    if (airport) {\n    96→      onSearch({ destination: airport })\n    97→      setEditing(null)\n    98→    }\n    99→  }\n   100→\n   101→  function handleDepartureDateSelect(date: string | null) {\n   102→    if (date) {\n   103→      onSearch({ departureDate: date })\n   104→      setEditing(null)\n   105→    }\n   106→  }\n   107→\n   108→  function handleReturnDateSelect(date: string | null) {\n   109→    if (date) {\n   110→      onSearch({ returnDate: date })\n   111→      setEditing(null)\n   112→    }\n   113→  }\n   114→\n   115→  const dateDisplay = returnDate\n   116→    ? `${formatDate(departureDate)} – ${formatDate(returnDate)}`\n   117→    : formatDate(departureDate)\n   118→\n   119→  return (\n   120→    <div className=\"search-summary-bar\" ref={containerRef} data-testid=\"search-summary-bar\">\n   121→      <div className=\"search-summary-bar__chips\">\n   122→        <div className=\"search-summary-bar__chip-wrapper\" style={{ position: 'relative' }}>\n   123→          <button\n   124→            className={`search-summary-bar__chip ${editing === 'origin' ? 'search-summary-bar__chip--active' : ''}`}\n   125→            onClick={() => setEditing(editing === 'origin' ? null : 'origin')}\n   126→            data-testid=\"summary-origin\"\n   127→          >\n   128→            <span className=\"search-summary-bar__chip-icon\">✈</span>\n   129→            {origin}\n   130→          </button>\n   131→          {editing === 'origin' && (\n   132→            <div className=\"search-summary-bar__editor\" data-testid=\"summary-origin-editor\">\n   133→              <AirportAutocomplete\n   134→                value={searchState.origin}\n   135→                onChange={handleOriginSelect}\n   136→                placeholder=\"Where from?\"\n   137→                testIdPrefix=\"summary-origin-autocomplete\"\n   138→              />\n   139→            </div>\n   140→          )}\n   141→        </div>\n   142→\n   143→        <span className=\"search-summary-bar__arrow\">→</span>\n   144→\n   145→        <div className=\"search-summary-bar__chip-wrapper\" style={{ position: 'relative' }}>\n   146→          <button\n   147→            className={`search-summary-bar__chip ${editing === 'destination' ? 'search-summary-bar__chip--active' : ''}`}\n   148→            onClick={() => setEditing(editing === 'destination' ? null : 'destination')}\n   149→            data-testid=\"summary-destination\"\n   150→          >\n   151→            <span className=\"search-summary-bar__chip-icon\">✈</span>\n   152→            {destination}\n   153→          </button>\n   154→          {editing === 'destination' && (\n   155→            <div className=\"search-summary-bar__editor\" data-testid=\"summary-destination-editor\">\n   156→              <AirportAutocomplete\n   157→                value={searchState.destination}\n   158→                onChange={handleDestinationSelect}\n   159→                placeholder=\"Where to?\"\n   160→                testIdPrefix=\"summary-dest-autocomplete\"\n   161→              />\n   162→            </div>\n   163→          )}\n   164→        </div>\n   165→\n   166→        <div className=\"search-summary-bar__divider\" />\n   167→\n   168→        <div className=\"search-summary-bar__chip-wrapper\" style={{ position: 'relative' }}>\n   169→          <button\n   170→            className={`search-summary-bar__chip ${editing === 'departureDate' ? 'search-summary-bar__chip--active' : ''}`}\n   171→            onClick={() => setEditing(editing === 'departureDate' ? null : 'departureDate')}\n   172→            data-testid=\"summary-dates\"\n   173→          >\n   174→            <span className=\"search-summary-bar__chip-icon\">📅</span>\n   175→            {dateDisplay}\n   176→          </button>\n   177→          {editing === 'departureDate' && (\n   178→            <div className=\"search-summary-bar__editor\" data-testid=\"summary-departure-editor\">\n   179→              <DatePicker\n   180→                value={departureDate}\n   181→                onChange={handleDepartureDateSelect}\n   182→                placeholder=\"Departure\"\n   183→                testIdPrefix=\"summary-departure\"\n   184→                initiallyOpen\n   185→              />\n   186→            </div>\n   187→          )}\n   188→          {editing === 'returnDate' && tripType === 'round_trip' && (\n   189→            <div className=\"search-summary-bar__editor\" data-testid=\"summary-return-editor\">\n   190→              <DatePicker\n   191→                value={returnDate}\n   192→                onChange={handleReturnDateSelect}\n   193→                placeholder=\"Return\"\n   194→                minDate={departureDate}\n   195→                testIdPrefix=\"summary-return\"\n   196→                initiallyOpen\n   197→              />\n   198→            </div>\n   199→          )}\n   200→        </div>\n   201→\n   202→        {tripType === 'round_trip' && returnDate && (\n   203→          <div className=\"search-summary-bar__chip-wrapper\" style={{ position: 'relative' }}>\n   204→            <button\n   205→              className={`search-summary-bar__chip ${editing === 'returnDate' ? 'search-summary-bar__chip--active' : ''}`}\n   206→              onClick={() => setEditing(editing === 'returnDate' ? null : 'returnDate')}\n   207→              data-testid=\"summary-return-date\"\n   208→            >\n   209→              <span className=\"search-summary-bar__chip-icon\">📅</span>\n   210→              Return: {formatDate(returnDate)}\n   211→            </button>\n   212→            {editing === 'returnDate' && (\n   213→              <div className=\"search-summary-bar__editor\" data-testid=\"summary-return-editor\">\n   214→                <DatePicker\n   215→                  value={returnDate}\n   216→                  onChange={handleReturnDateSelect}\n   217→                  placeholder=\"Return\"\n   218→                  minDate={departureDate}\n   219→                  testIdPrefix=\"summary-return\"\n   220→                  initiallyOpen\n   221→                />\n   222→              </div>\n   223→            )}\n   224→          </div>\n   225→        )}\n   226→\n   227→        <div className=\"search-summary-bar__divider\" />\n   228→\n   229→        <div className=\"search-summary-bar__chip-wrapper\" style={{ position: 'relative' }}>\n   230→          <button\n   231→            className={`search-summary-bar__chip ${editing === 'passengers' ? 'search-summary-bar__chip--active' : ''}`}\n   232→            onClick={() => setEditing(editing === 'passengers' ? null : 'passengers')}\n   233→            data-testid=\"summary-passengers\"\n   234→          >\n   235→            <span className=\"search-summary-bar__chip-icon\">👤</span>\n   236→            {formatPassengers(adults, children, infants)}\n   237→          </button>\n   238→          {editing === 'passengers' && (\n   239→            <div className=\"search-summary-bar__editor search-summary-bar__editor--wide\" data-testid=\"summary-passengers-editor\">\n   240→              <PassengerCountSelector />\n   241→              <ApplyButton\n   242→                testId=\"summary-passengers-done\"\n   243→                onClick={() => {\n   244→                  onSearch({\n   245→                    adults: searchState.passengers.adults,\n   246→                    children: searchState.passengers.children,\n   247→                    infants: searchState.passengers.infants,\n   248→                  })\n   249→                  setEditing(null)\n   250→                }}\n   251→              />\n   252→            </div>\n   253→          )}\n   254→        </div>\n   255→\n   256→        <div className=\"search-summary-bar__chip-wrapper\" style={{ position: 'relative' }}>\n   257→          <button\n   258→            className={`search-summary-bar__chip ${editing === 'cabinClass' ? 'search-summary-bar__chip--active' : ''}`}\n   259→            onClick={() => setEditing(editing === 'cabinClass' ? null : 'cabinClass')}\n   260→            data-testid=\"summary-cabin-class\"\n   261→          >\n   262→            <span className=\"search-summary-bar__chip-icon\">💺</span>\n   263→            {formatCabinClass(cabinClass)}\n   264→          </button>\n   265→       