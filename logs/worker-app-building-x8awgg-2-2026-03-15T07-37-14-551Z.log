[2026-03-15T07:21:21.825Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MDAr6WKZoEMfJpbtmT2f46","type":"tool_result","content":"     1→import { useEffect, useMemo, useCallback } from 'react'\n     2→import { useSearchParams, useNavigate } from 'react-router-dom'\n     3→import { useSelector, useDispatch } from 'react-redux'\n     4→import type { RootState, AppDispatch } from '../store'\n     5→import type { Airport } from '../slices/searchSlice'\n     6→import { setOrigin, setDestination, setDepartureDate, setReturnDate, setCabinClass, setPassengers } from '../slices/searchSlice'\n     7→import type { FlightResult, SortOption, TimeFilter } from '../slices/flightsSlice'\n     8→import { searchFlights, loadMoreFlights, checkTrackedRoute } from '../slices/flightsSlice'\n     9→import SearchSummaryBar from '../components/SearchSummaryBar'\n    10→import FilterSidebar from '../components/FilterSidebar'\n    11→import FlightResultCard from '../components/FlightResultCard'\n    12→import TrackPricesToggle from '../components/TrackPricesToggle'\n    13→import Pagination from '../components/Pagination'\n    14→import './SearchResultsPage.css'\n    15→\n    16→function getTimeCategory(dateStr: string): keyof TimeFilter {\n    17→  const hour = new Date(dateStr).getHours()\n    18→  if (hour >= 6 && hour < 12) return 'morning'\n    19→  if (hour >= 12 && hour < 18) return 'afternoon'\n    20→  if (hour >= 18) return 'evening'\n    21→  return 'night'\n    22→}\n    23→\n    24→function hasActiveTimeFilter(filter: TimeFilter): boolean {\n    25→  return filter.morning || filter.afternoon || filter.evening || filter.night\n    26→}\n    27→\n    28→function SearchResultsPage() {\n    29→  const [searchParams, setSearchParams] = useSearchParams()\n    30→  const navigate = useNavigate()\n    31→  const dispatch = useDispatch<AppDispatch>()\n    32→\n    33→  const originCode = searchParams.get('origin') || ''\n    34→  const destCode = searchParams.get('destination') || ''\n    35→  const departureDate = searchParams.get('departureDate') || ''\n    36→  const returnDate = searchParams.get('returnDate') || null\n    37→  const tripType = searchParams.get('tripType') || 'round_trip'\n    38→  const cabinClass = searchParams.get('cabinClass') || 'economy'\n    39→  const adults = parseInt(searchParams.get('adults') || '1')\n    40→  const children = parseInt(searchParams.get('children') || '0')\n    41→  const infants = parseInt(searchParams.get('infants') || '0')\n    42→\n    43→  const {\n    44→    flights, loading, page, totalPages, loadingMore,\n    45→    sortBy, stopsFilter, airlinesFilter,\n    46→    priceRange, durationRange,\n    47→    departureTimeFilter, arrivalTimeFilter,\n    48→  } = useSelector((state: RootState) => state.flights)\n    49→\n    50→  const sessionToken = useSelector((state: RootState) => state.search.sessionToken)\n    51→\n    52→  // Fetch flights on mount or when search params change\n    53→  useEffect(() => {\n    54→    if (originCode && destCode && departureDate) {\n    55→      dispatch(searchFlights({\n    56→        origin: originCode,\n    57→        destination: destCode,\n    58→        departureDate,\n    59→        cabinClass,\n    60→      }))\n    61→      dispatch(checkTrackedRoute({\n    62→        sessionToken,\n    63→        origin: originCode,\n    64→        destination: destCode,\n    65→      }))\n    66→    }\n    67→  }, [dispatch, originCode, destCode, departureDate, cabinClass, sessionToken])\n    68→\n    69→  // Apply client-side filters and sorting\n    70→  const filteredFlights = useMemo(() => {\n    71→    let result = [...flights]\n    72→\n    73→    // Stops filter\n    74→    const hasStopsFilter = stopsFilter.nonstop || stopsFilter.oneStop || stopsFilter.twoPlusStops\n    75→    if (hasStopsFilter) {\n    76→      result = result.filter((f: FlightResult) => {\n    77→        const numStops = Number(f.num_legs) - 1\n    78→        if (numStops === 0 && stopsFilter.nonstop) return true\n    79→        if (numStops === 1 && stopsFilter.oneStop) return true\n    80→        if (numStops >= 2 && stopsFilter.twoPlusStops) return true\n    81→        return false\n    82→      })\n    83→    }\n    84→\n    85→    // Airlines filter\n    86→    if (airlinesFilter.length > 0) {\n    87→      result = result.filter((f: FlightResult) => airlinesFilter.includes(f.airline_code))\n    88→    }\n    89→\n    90→    // Price range filter\n    91→    result = result.filter((f: FlightResult) =>\n    92→      f.total_price_cents >= priceRange[0] && f.total_price_cents <= priceRange[1]\n    93→    )\n    94→\n    95→    // Duration range filter\n    96→    result = result.filter((f: FlightResult) =>\n    97→      f.duration_minutes >= durationRange[0] && f.duration_minutes <= durationRange[1]\n    98→    )\n    99→\n   100→    // Departure time filter\n   101→    if (hasActiveTimeFilter(departureTimeFilter)) {\n   102→      result = result.filter((f: FlightResult) => {\n   103→        const cat = getTimeCategory(f.departure_time)\n   104→        return departureTimeFilter[cat]\n   105→      })\n   106→    }\n   107→\n   108→    // Arrival time filter\n   109→    if (hasActiveTimeFilter(arrivalTimeFilter)) {\n   110→      result = result.filter((f: FlightResult) => {\n   111→        const cat = getTimeCategory(f.arrival_time)\n   112→        return arrivalTimeFilter[cat]\n   113→      })\n   114→    }\n   115→\n   116→    // Sorting\n   117→    const sortFns: Record<SortOption, (a: FlightResult, b: FlightResult) => number> = {\n   118→      best: (a, b) => {\n   119→        // Best = combination of price and duration\n   120→        const scoreA = a.total_price_cents / 100 + a.duration_minutes * 2\n   121→        const scoreB = b.total_price_cents / 100 + b.duration_minutes * 2\n   122→        return scoreA - scoreB\n   123→      },\n   124→      price: (a, b) => a.total_price_cents - b.total_price_cents,\n   125→      duration: (a, b) => a.duration_minutes - b.duration_minutes,\n   126→      departure: (a, b) => new Date(a.departure_time).getTime() - new Date(b.departure_time).getTime(),\n   127→      arrival: (a, b) => new Date(a.arrival_time).getTime() - new Date(b.arrival_time).getTime(),\n   128→    }\n   129→    result.sort(sortFns[sortBy])\n   130→\n   131→    return result\n   132→  }, [flights, stopsFilter, airlinesFilter, priceRange, durationRange, departureTimeFilter, arrivalTimeFilter, sortBy])\n   133→\n   134→  const handleSearch = useCallback((params: {\n   135→    origin?: Airport\n   136→    destination?: Airport\n   137→    departureDate?: string\n   138→    returnDate?: string | null\n   139→    cabinClass?: string\n   140→    adults?: number\n   141→    children?: number\n   142→    infants?: number\n   143→  }) => {\n   144→    const newParams = new URLSearchParams(searchParams)\n   145→    if (params.origin) {\n   146→      newParams.set('origin', params.origin.iata_code)\n   147→      dispatch(setOrigin(params.origin))\n   148→    }\n   149→    if (params.destination) {\n   150→      newParams.set('destination', params.destination.iata_code)\n   151→      dispatch(setDestination(params.destination))\n   152→    }\n   153→    if (params.departureDate) {\n   154→      newParams.set('departureDate', params.departureDate)\n   155→      dispatch(setDepartureDate(params.departureDate))\n   156→    }\n   157→    if (params.returnDate !== undefined) {\n   158→      if (params.returnDate) {\n   159→        newParams.set('returnDate', params.returnDate)\n   160→      } else {\n   161→        newParams.delete('returnDate')\n   162→      }\n   163→      dispatch(setReturnDate(params.returnDate))\n   164→    }\n   165→    if (params.cabinClass) {\n   166→      newParams.set('cabinClass', params.cabinClass)\n   167→      dispatch(setCabinClass(params.cabinClass as 'economy' | 'premium_economy' | 'business' | 'first'))\n   168→    }\n   169→    if (params.adults !== undefined) {\n   170→      newParams.set('adults', String(params.adults))\n   171→      newParams.set('children', String(params.children ?? children))\n   172→      newParams.set('infants', String(params.infants ?? infants))\n   173→      dispatch(setPassengers({\n   174→        adults: params.adults,\n   175→        children: params.children ?? children,\n   176→        infants: params.infants ?? infants,\n   177→      }))\n   178→    }\n   179→    setSearchParams(newParams)\n   180→  }, [searchParams, setSearchParams, dispatch, children, infants])\n   181→\n   182→  function handleLoadMore() {\n   183→    dispatch(loadMoreFlights({\n   184→      origin: originCode,\n   185→      destination: destCode,\n   186→      departureDate,\n   187→      cabinClass,\n   188→      page: page + 1,\n   189→    }))\n   190→  }\n   191→\n   192→  if (!originCode || !destCode || !departureDate) {\n   193→    return (\n   194→      <div className=\"search-results-page p-6 max-sm:p-3\" data-testid=\"search-results-page\">\n   195→        <div className=\"search-results-page__empty\" data-testid=\"search-results-empty\">\n   196→          <h2>No search parameters</h2>\n   197→          <p>Please go back and enter your search criteria.</p>\n   198→          <button\n   199→            className=\"search-results-page__back-button\"\n   200→            onClick={() => navigate('/')}\n   201→            data-testid=\"back-to-search\"\n   202→          >\n   203→            Back to Search\n   204→          </button>\n   205→        </div>\n   206→      </div>\n   207→    )\n   208→  }\n   209→\n   210→  return (\n   211→    <div className=\"search-results-page p-6 max-sm:p-3\" data-testid=\"search-results-page\">\n   212→      <SearchSummaryBar\n   213→        origin={originCode}\n   214→        destination={destCode}\n   215→        departureDate={departureDate}\n   216→        returnDate={returnDate}\n   217→        tripType={tripType}\n   218→        cabinClass={cabinClass}\n   219→        adults={adults}\n   220→        children={children}\n   221→        infants={infants}\n   222→        onSearch={handleSearch}\n   223→      />\n   224→\n   225→      <div className=\"search-results-page__content\">\n   226→        <FilterSidebar />\n   227→\n   228→        <div className=\"search-results-page__results\">\n   229→          <div className=\"search-results-page__header\">\n   230→            <div className=\"search-results-page__count\" data-testid=\"results-count\">\n   231→              {loading ? 'Searching...' : `${filteredFlights.length} of ${flights.length} flights`}\n   232→            </div>\n   233→            <TrackPricesToggle\n   234→              originCode={originCode}\n   235→              destCode={destCode}\n   236→              departureDate={departureDate}\n   237→              returnDate={returnDate}\n   238→              cabinClass={cabinClass}\n   239→            />\n   240→          </div>\n   241→\n   242→          {loading ? (\n   243→            <div className=\"search-results-page__loading\" data-testid=\"results-loading\">\n   244→              <div className=\"search-results-page__loading-spinner\" />\n   245→              <p>Searching for the best flights...</p>\n   246→            </div>\n   247→          ) : filteredFlights.length === 0 ? (\n   248→            <div className=\"search-results-page__no-results\" data-testid=\"results-none\">\n   249→              <p>No flights found matching your criteria.</p>\n   250→              <p className=\"search-results-page__no-results-hint\">\n   251→                Try adjusting your filters or search dates.\n   252→              </p>\n   253→            </div>\n   254→          ) : (\n   255→            <>\n   256→              <div className=\"search-results-page__list\" data-testid=\"results-list\">\n   257→                {filteredFlights.map((flight: FlightResult) => (\n   258→                  <FlightResultCard key={flight.id} flight={flight} />\n   259→                ))}\n   260→              </div>\n   261→              <Pagination\n   262→                page={page}\n   263→                totalPages={totalPages}\n   264→                loading={loadingMore}\n   265→                onLoadMore={handleLoadMore}\n   266→              />\n   267→            </>\n   268→          )}\n   269→        </div>\n   270→      </div>\n   271→    </div>\n   272→  )\n   273→}\n   274→\n   275→export default SearchResultsPage\n   276→"}]},"parent_tool_use_id":"toolu_01MeNV7soe8dY7oVYrAXueWC","session_id":"05a60624-77ab-43db-a283-e7b7bde69626","uuid":"17b5f5ee-5eb4-4eab-a0d7-53ba17f00933"}
