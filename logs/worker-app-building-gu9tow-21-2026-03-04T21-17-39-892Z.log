[2026-03-04T21:16:12.138Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012QgyYMG53oQ7c9EegLbeA1","type":"tool_result","content":"     1→import { execSync, spawn } from 'child_process'\n     2→import { writeFileSync, readFileSync, mkdirSync, readdirSync, existsSync } from 'fs'\n     3→import { join } from 'path'\n     4→import { initSchema } from './schema.js'\n     5→import { seedDatabase, resetDatabase } from './seed-db.js'\n     6→\n     7→const appDir = join(import.meta.dirname, '..')\n     8→const logsDir = join(appDir, 'logs')\n     9→\n    10→// ── Helpers ──────────────────────────────────────────────────────────────────\n    11→\n    12→function getEnvVar(name: string): string {\n    13→  const val = process.env[name]\n    14→  if (!val) {\n    15→    console.error(`Missing required environment variable: ${name}`)\n    16→    process.exit(1)\n    17→  }\n    18→  return val\n    19→}\n    20→\n    21→function loadDotEnv(): void {\n    22→  const envPath = join(appDir, '.env')\n    23→  if (!existsSync(envPath)) return\n    24→  const lines = readFileSync(envPath, 'utf-8').split('\\n')\n    25→  for (const line of lines) {\n    26→    const trimmed = line.trim()\n    27→    if (!trimmed || trimmed.startsWith('#')) continue\n    28→    const eqIdx = trimmed.indexOf('=')\n    29→    if (eqIdx === -1) continue\n    30→    const key = trimmed.slice(0, eqIdx).trim()\n    31→    const value = trimmed.slice(eqIdx + 1).trim().replace(/^[\"']|[\"']$/g, '')\n    32→    if (!process.env[key]) {\n    33→      process.env[key] = value\n    34→    }\n    35→  }\n    36→}\n    37→\n    38→function getNextLogNumber(): number {\n    39→  mkdirSync(logsDir, { recursive: true })\n    40→  const existing = readdirSync(logsDir)\n    41→    .filter(f => /^test-run-\\d+\\.log$/.test(f))\n    42→    .map(f => parseInt(f.match(/test-run-(\\d+)\\.log/)![1], 10))\n    43→  return existing.length > 0 ? Math.max(...existing) + 1 : 1\n    44→}\n    45→\n    46→function killStaleProcesses(): void {\n    47→  try {\n    48→    execSync(\"pkill -f 'netlify dev' || true\", { stdio: 'ignore' })\n    49→  } catch { /* ignore */ }\n    50→  try {\n    51→    execSync(\"pkill -f 'vite' || true\", { stdio: 'ignore' })\n    52→  } catch { /* ignore */ }\n    53→  // Give processes time to exit\n    54→  execSync('sleep 1', { stdio: 'ignore' })\n    55→}\n    56→\n    57→// ── Neon API helpers ─────────────────────────────────────────────────────────\n    58→\n    59→async function neonApi(method: string, path: string, body?: unknown): Promise<unknown> {\n    60→  const apiKey = getEnvVar('NEON_API_KEY')\n    61→  const res = await fetch(`https://console.neon.tech/api/v2${path}`, {\n    62→    method,\n    63→    headers: {\n    64→      Authorization: `Bearer ${apiKey}`,\n    65→      'Content-Type': 'application/json',\n    66→      Accept: 'application/json',\n    67→    },\n    68→    body: body ? JSON.stringify(body) : undefined,\n    69→  })\n    70→  if (!res.ok) {\n    71→    const text = await res.text()\n    72→    throw new Error(`Neon API ${method} ${path} failed (${res.status}): ${text}`)\n    73→  }\n    74→  const contentType = res.headers.get('content-type')\n    75→  if (contentType?.includes('application/json')) {\n    76→    return res.json()\n    77→  }\n    78→  return null\n    79→}\n    80→\n    81→interface NeonBranch {\n    82→  id: string\n    83→  name: string\n    84→}\n    85→\n    86→interface NeonBranchListResponse {\n    87→  branches: NeonBranch[]\n    88→}\n    89→\n    90→interface NeonEndpoint {\n    91→  host: string\n    92→}\n    93→\n    94→interface NeonEndpointsResponse {\n    95→  endpoints: NeonEndpoint[]\n    96→}\n    97→\n    98→interface NeonBranchCreateResponse {\n    99→  branch: NeonBranch\n   100→  endpoints: NeonEndpoint[]\n   101→}\n   102→\n   103→async function cleanupStaleBranches(projectId: string): Promise<void> {\n   104→  const data = await neonApi('GET', `/projects/${projectId}/branches`) as NeonBranchListResponse\n   105→  const staleBranches = data.branches.filter((b: NeonBranch) => b.name.startsWith('test-run-'))\n   106→  for (const branch of staleBranches) {\n   107→    try {\n   108→      await neonApi('DELETE', `/projects/${projectId}/branches/${branch.id}`)\n   109→    } catch {\n   110→      // Best effort cleanup\n   111→    }\n   112→  }\n   113→}\n   114→\n   115→async function createEphemeralBranch(projectId: string, branchName: string): Promise<string> {\n   116→  const data = await neonApi('POST', `/projects/${projectId}/branches`, {\n   117→    branch: { name: branchName },\n   118→    endpoints: [{ type: 'read_write' }],\n   119→  }) as NeonBranchCreateResponse\n   120→\n   121→  const host = data.endpoints[0]?.host\n   122→  if (!host) {\n   123→    // Fetch endpoints separately\n   124→    const epData = await neonApi('GET', `/projects/${projectId}/branches/${data.branch.id}/endpoints`) as NeonEndpointsResponse\n   125→    if (!epData.endpoints[0]?.host) {\n   126→      throw new Error('No endpoint created for ephemeral branch')\n   127→    }\n   128→    return buildConnectionString(epData.endpoints[0].host)\n   129→  }\n   130→  return buildConnectionString(host)\n   131→}\n   132→\n   133→function buildConnectionString(host: string): string {\n   134→  const mainDbUrl = getEnvVar('DATABASE_URL')\n   135→  const url = new URL(mainDbUrl)\n   136→  url.hostname = host\n   137→  return url.toString()\n   138→}\n   139→\n   140→async function deleteBranch(projectId: string, branchName: string): Promise<void> {\n   141→  const data = await neonApi('GET', `/projects/${projectId}/branches`) as NeonBranchListResponse\n   142→  const branch = data.branches.find((b: NeonBranch) => b.name === branchName)\n   143→  if (branch) {\n   144→    await neonApi('DELETE', `/projects/${projectId}/branches/${branch.id}`)\n   145→  }\n   146→}\n   147→\n   148→// ── Replay recordings parser ─────────────────────────────────────────────────\n   149→\n   150→interface RecordingEntry {\n   151→  id?: string\n   152→  kind: string\n   153→  timestamp?: string\n   154→  metadata?: {\n   155→    test?: {\n   156→      result?: string\n   157→      title?: string\n   158→    }\n   159→    uri?: string\n   160→  }\n   161→  duration?: number\n   162→}\n   163→\n   164→interface ParsedRecording {\n   165→  id: string\n   166→  testResult: string\n   167→  testTitle: string\n   168→  specFile: string\n   169→  duration: number\n   170→}\n   171→\n   172→function parseRecordingsLog(): ParsedRecording[] {\n   173→  const logPath = join(process.env.HOME || '~', '.replay', 'recordings.log')\n   174→  if (!existsSync(logPath)) return []\n   175→\n   176→  const content = readFileSync(logPath, 'utf-8')\n   177→  const lines = content.split('\\n').filter(l => l.trim())\n   178→\n   179→  const recordings = new Map<string, { id: string; duration: number }>()\n   180→  const metadata = new Map<string, { testResult: string; testTitle: string; specFile: string }>()\n   181→\n   182→  for (const line of lines) {\n   183→    try {\n   184→      const entry = JSON.parse(line) as RecordingEntry\n   185→      if (entry.kind === 'createRecording' && entry.id) {\n   186→        recordings.set(entry.id, { id: entry.id, duration: 0 })\n   187→      }\n   188→      if (entry.kind === 'writeFinished' && entry.id) {\n   189→        const rec = recordings.get(entry.id)\n   190→        if (rec && entry.duration) {\n   191→          rec.duration = entry.duration\n   192→        }\n   193→      }\n   194→      if (entry.kind === 'addMetadata' && entry.id && entry.metadata?.test) {\n   195→        metadata.set(entry.id, {\n   196→          testResult: entry.metadata.test.result || 'unknown',\n   197→          testTitle: entry.metadata.test.title || '',\n   198→          specFile: entry.metadata.uri || '',\n   199→        })\n   200→      }\n   201→    } catch {\n   202→      // Skip malformed lines\n   203→    }\n   204→  }\n   205→\n   206→  const results: ParsedRecording[] = []\n   207→  for (const [id, rec] of recordings) {\n   208→    const meta = metadata.get(id)\n   209→    if (meta) {\n   210→      results.push({\n   211→        id,\n   212→        testResult: meta.testResult,\n   213→        testTitle: meta.testTitle,\n   214→        specFile: meta.specFile,\n   215→        duration: rec.duration,\n   216→      })\n   217→    }\n   218→  }\n   219→  return results\n   220→}\n   221→\n   222→// ── Main ─────────────────────────────────────────────────────────────────────\n   223→\n   224→async function main(): Promise<void> {\n   225→  loadDotEnv()\n   226→\n   227→  const testFile = process.argv[2]\n   228→  if (!testFile) {\n   229→    console.error('Usage: npm run test <testFile>')\n   230→    process.exit(1)\n   231→  }\n   232→\n   233→  const neonApiKey = getEnvVar('NEON_API_KEY')\n   234→  const projectId = getEnvVar('NEON_PROJECT_ID')\n   235→  // Ensure DATABASE_URL is available (needed for building connection strings)\n   236→  getEnvVar('DATABASE_URL')\n   237→  // Suppress unused variable warning\n   238→  void neonApiKey\n   239→\n   240→  const logNum = getNextLogNumber()\n   241→  const logFile = join(logsDir, `test-run-${logNum}.log`)\n   242→  const branchName = `test-run-${Date.now()}`\n   243→  let playwrightExitCode = 1\n   244→  let ephemeralDbUrl = ''\n   245→\n   246→  // Step 1: Kill stale processes\n   247→  killStaleProcesses()\n   248→\n   249→  // Step 2: Clean up stale Neon branches\n   250→  await cleanupStaleBranches(projectId)\n   251→\n   252→  // Step 3: Create ephemeral Neon branch\n   253→  try {\n   254→    ephemeralDbUrl = await createEphemeralBranch(projectId, branchName)\n   255→  } catch (err) {\n   256→    console.error(`Failed to create ephemeral branch: ${err}`)\n   257→    process.exit(1)\n   258→  }\n   259→\n   260→  try {\n   261→    // Step 4: Initialize schema and seed\n   262→    await initSchema(ephemeralDbUrl)\n   263→    await seedDatabase(ephemeralDbUrl)\n   264→\n   265→    // Step 5: Start netlify dev\n   266→    const netlifyBin = join(appDir, 'node_modules', '.bin', 'netlify')\n   267→    const netlifyDev = spawn(netlifyBin, ['dev', '--port', '8888', '--functions', './netlify/functions'], {\n   268→      cwd: appDir,\n   269→      env: { ...process.env, DATABASE_URL: ephemeralDbUrl },\n   270→      stdio: ['ignore', 'pipe', 'pipe'],\n   271→      detached: true,\n   272→    })\n   273→\n   274→    // Wait for netlify dev to be ready\n   275→    await new Promise<void>((resolve, reject) => {\n   276→      const timeout = setTimeout(() => {\n   277→        reject(new Error('netlify dev failed to start within 60 seconds'))\n   278→      }, 60000)\n   279→\n   280→      let output = ''\n   281→      const checkReady = (data: Buffer) => {\n   282→        output += data.toString()\n   283→        if (output.includes('Server ready') || output.includes('ready on') || output.includes('localhost:8888')) {\n   284→          clearTimeout(timeout)\n   285→          resolve()\n   286→        }\n   287→      }\n   288→\n   289→      netlifyDev.stdout?.on('data', checkReady)\n   290→      netlifyDev.stderr?.on('data', checkReady)\n   291→\n   292→      netlifyDev.on('error', (err) => {\n   293→        clearTimeout(timeout)\n   294→        reject(err)\n   295→      })\n   296→\n   297→      netlifyDev.on('exit', (code) => {\n   298→        if (code !== null && code !== 0) {\n   299→          clearTimeout(timeout)\n   300→          reject(new Error(`netlify dev exited with code ${code}\\n${output}`))\n   301→        }\n   302→      })\n   303→    })\n   304→\n   305→    // Step 6: Remove stale recordings\n   306→    try {\n   307→      execSync('npx replayio remove --all', { cwd: appDir, stdio: 'ignore' })\n   308→    } catch { /* ignore */ }\n   309→\n   310→    // Step 7: Run Playwright\n   311→    // Reset database before running (ensures clean state)\n   312→    await resetDatabase(ephemeralDbUrl)\n   313→\n   314→    try {\n   315→      const pwOutput = execSync(\n   316→        `npx playwright test ${testFile} --retries 0 --workers 1`,\n   317→        {\n   318→          cwd: appDir,\n   319→          encoding: 'utf-8',\n   320→          stdio: ['ignore', 'pipe', 'pipe'],\n   321→          env: {\n   322→            ...process.env,\n   323→            DATABASE_URL: ephemeralDbUrl,\n   324→            TEST_DATABASE_URL: ephemeralDbUrl,\n   325→            BASE_URL: 'http://localhost:8888',\n   326→          },\n   327→          timeout: 300000,\n   328→        }\n   329→      )\n   330→      writeFileSync(logFile, pwOutput)\n   331→      playwrightExitCode = 0\n   332→    } catch (e: unknown) {\n   333→      const err = e as { stdout?: string; stderr?: string; status?: number }\n   334→      const output = (err.stdout || '') + '\\n' + (err.stderr || '')\n   335→      writeFileSync(logFile, output)\n   336→      playwrightExitCode = err.status || 1\n   337→    }\n   338→\n   339→    // Step 8: Parse results\n   340→    let passed = 0\n   341→    let failed = 0\n   342→    let skipped = 0\n   343→    const resultsPath = join(appDir, 'test-results', 'results.json')\n   344→    if (existsSync(resultsPath)) {\n   345→      try {\n   346→        const resultsJson = JSON.parse(readFileSync(resultsPath, 'utf-8'))\n   347→        for (const suite of resultsJson.suites || []) {\n   348→          for (const spec of suite.specs || []) {\n   349→            for (const test of spec.tests || []) {\n   350→              if (test.status === 'expected' || test.status === 'passed') passed++\n   351→              else if (test.status === 'unexpected' || test.status === 'failed') failed++\n   352→              else if (test.status === 'skipped') skipped++\n   353→            }\n   354→          }\n   355→        }\n   356→      } catch {\n   357→        // If results.json is malformed, we'll just use exit code\n   358→      }\n   359→    }\n   360→\n   361→    // Step 9: On failure, handle recordings\n   362→    let uploadedRecordingId = ''\n   363→    if (playwrightExitCode !== 0) {\n   364→      const recordings = parseRecordingsLog()\n   365→\n   366→      // Append metadata to log\n   367→      if (recordings.length > 0) {\n   368→        let metadataBlock = '\\n=== REPLAY RECORDINGS METADATA ===\\n'\n   369→        for (const rec of recordings) {\n   370→          metadataBlock += JSON.stringify({\n   371→            id: rec.id,\n   372→            testResult: rec.testResult,\n   373→            testTitle: rec.testTitle,\n   374→            specFile: rec.specFile,\n   375→          }) + '\\n'\n   376→        }\n   377→        metadataBlock += '=== END REPLAY RECORDINGS METADATA ===\\n'\n   378→        writeFileSync(logFile, readFileSync(logFile, 'utf-8') + metadataBlock)\n   379→      }\n   380→\n   381→      // Find the longest-duration failed recording\n   382→      const failedRecordings = recordings\n   383→        .filter(r => r.testResult === 'failed' || r.testResult === 'timedOut')\n   384→        .sort((a, b) => b.duration - a.duration)\n   385→\n   386→      if (failedRecordings.length > 0) {\n   387→        const toUpload = failedRecordings[0]\n   388→        try {\n   389→          execSync(`npx replayio upload ${toUpload.id}`, {\n   390→            cwd: appDir,\n   391→            encoding: 'utf-8',\n   392→            stdio: 'pipe',\n   393→            timeout: 120000,\n   394→          })\n   395→          uploadedRecordingId = toUpload.id\n   396→          writeFileSync(logFile, readFileSync(logFile, 'utf-8') + `\\nREPLAY UPLOADED: ${uploadedRecordingId}\\n`)\n   397→        } catch (e: unknown) {\n   398→          const err = e as { status?: number }\n   399→          writeFileSync(logFile, readFileSync(logFile, 'utf-8') + `\\nREPLAY UPLOAD FAILED (exit code ${err.status || 'unknown'})\\n`)\n   400→        }\n   401→      }\n   402→    }\n   403→\n   404→    // Step 10: Cleanup - stop netlify dev\n   405→    try {\n   406→      if (netlifyDev.pid) {\n   407→        process.kill(-netlifyDev.pid, 'SIGTERM')\n   408→      }\n   409→    } catch { /* ignore */ }\n   410→\n   411→    // Step 11: Print summary\n   412→    const parts: string[] = []\n   413→    if (passed > 0) parts.push(`${passed} passed`)\n   414→    if (failed > 0) parts.push(`${failed} failed`)\n   415→    if (skipped > 0) parts.push(`${skipped} skipped`)\n   416→\n   417→    let summary = parts.length > 0 ? parts.join(', ') : (playwrightExitCode === 0 ? 'all passed' : 'tests failed')\n   418→    if (uploadedRecordingId) {\n   419→      summary += ` (recording: ${uploadedRecordingId})`\n   420→    }\n   421→    if (playwrightExitCode !== 0) {\n   422→      summary += ` — see logs/test-run-${logNum}.log`\n   423→    }\n   424→    console.log(summary)\n   425→\n   426→  } finally {\n   427→    // Step 10 continued: Delete ephemeral branch and clean recordings\n   428→    try {\n   429→      await deleteBranch(projectId, branchName)\n   430→    } catch { /* ignore */ }\n   431→\n   432→    try {\n   433→      execSync('npx replayio remove --all', { cwd: appDir, stdio: 'ignore' })\n   434→    } catch { /* ignore */ }\n   435→\n   436→    // Kill any leftover netlify dev\n   437→    killStaleProcesses()\n   438→  }\n   439→\n   440→  // Step 12: Exit with Playwright's exit code\n   441→  process.exit(playwrightExitCode)\n   442→}\n   443→\n   444→main()\n   445→"}]},"parent_tool_use_id":"toolu_01EzcZPajUVsgmVWmeuYgvGn","session_id":"52368737-6ec8-4ea8-bd8c-d8bae0c12160","uuid":"3c0582b0-0531-4096-bf22-237cddb53f26"}
