[2026-03-04T20:26:16.378Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MmxizGc5kt9nHUxb3XKTCH","type":"tool_result","content":"     1→import { execSync, spawn } from 'child_process'\n     2→import { writeFileSync, readFileSync, mkdirSync, readdirSync, existsSync } from 'fs'\n     3→import { join } from 'path'\n     4→import { initSchema } from './schema.js'\n     5→import { seedDatabase, resetDatabase } from './seed-db.js'\n     6→\n     7→const appDir = join(import.meta.dirname, '..')\n     8→const logsDir = join(appDir, 'logs')\n     9→\n    10→// ── Helpers ──────────────────────────────────────────────────────────────────\n    11→\n    12→function getEnvVar(name: string): string {\n    13→  const val = process.env[name]\n    14→  if (!val) {\n    15→    console.error(`Missing required environment variable: ${name}`)\n    16→    process.exit(1)\n    17→  }\n    18→  return val\n    19→}\n    20→\n    21→function loadDotEnv(): void {\n    22→  const envPath = join(appDir, '.env')\n    23→  if (!existsSync(envPath)) return\n    24→  const lines = readFileSync(envPath, 'utf-8').split('\\n')\n    25→  for (const line of lines) {\n    26→    const trimmed = line.trim()\n    27→    if (!trimmed || trimmed.startsWith('#')) continue\n    28→    const eqIdx = trimmed.indexOf('=')\n    29→    if (eqIdx === -1) continue\n    30→    const key = trimmed.slice(0, eqIdx).trim()\n    31→    const value = trimmed.slice(eqIdx + 1).trim().replace(/^[\"']|[\"']$/g, '')\n    32→    if (!process.env[key]) {\n    33→      process.env[key] = value\n    34→    }\n    35→  }\n    36→}\n    37→\n    38→function getNextLogNumber(): number {\n    39→  mkdirSync(logsDir, { recursive: true })\n    40→  const existing = readdirSync(logsDir)\n    41→    .filter(f => /^test-run-\\d+\\.log$/.test(f))\n    42→    .map(f => parseInt(f.match(/test-run-(\\d+)\\.log/)![1], 10))\n    43→  return existing.length > 0 ? Math.max(...existing) + 1 : 1\n    44→}\n    45→\n    46→function killStaleProcesses(): void {\n    47→  try {\n    48→    execSync(\"pkill -f 'netlify dev' || true\", { stdio: 'ignore' })\n    49→  } catch { /* ignore */ }\n    50→  try {\n    51→    execSync(\"pkill -f 'vite' || true\", { stdio: 'ignore' })\n    52→  } catch { /* ignore */ }\n    53→  // Give processes time to exit\n    54→  execSync('sleep 1', { stdio: 'ignore' })\n    55→}\n    56→\n    57→// ── Neon API helpers ─────────────────────────────────────────────────────────\n    58→\n    59→async function neonApi(method: string, path: string, body?: unknown): Promise<unknown> {\n    60→  const apiKey = getEnvVar('NEON_API_KEY')\n    61→  const res = await fetch(`https://console.neon.tech/api/v2${path}`, {\n    62→    method,\n    63→    headers: {\n    64→      Authorization: `Bearer ${apiKey}`,\n    65→      'Content-Type': 'application/json',\n    66→      Accept: 'application/json',\n    67→    },\n    68→    body: body ? JSON.stringify(body) : undefined,\n    69→  })\n    70→  if (!res.ok) {\n    71→    const text = await res.text()\n    72→    throw new Error(`Neon API ${method} ${path} failed (${res.status}): ${text}`)\n    73→  }\n    74→  const contentType = res.headers.get('content-type')\n    75→  if (contentType?.includes('application/json')) {\n    76→    return res.json()\n    77→  }\n    78→  return null\n    79→}\n    80→\n    81→interface NeonBranch {\n    82→  id: string\n    83→  name: string\n    84→}\n    85→\n    86→interface NeonBranchListResponse {\n    87→  branches: NeonBranch[]\n    88→}\n    89→\n    90→interface NeonEndpoint {\n    91→  host: string\n    92→}\n    93→\n    94→interface NeonEndpointsResponse {\n    95→  endpoints: NeonEndpoint[]\n    96→}\n    97→\n    98→interface NeonBranchCreateResponse {\n    99→  branch: NeonBranch\n   100→  endpoints: NeonEndpoint[]\n   101→}\n   102→\n   103→async function cleanupStaleBranches(projectId: string): Promise<void> {\n   104→  const data = await neonApi('GET', `/projects/${projectId}/branches`) as NeonBranchListResponse\n   105→  const staleBranches = data.branches.filter((b: NeonBranch) => b.name.startsWith('test-run-'))\n   106→  for (const branch of staleBranches) {\n   107→    try {\n   108→      await neonApi('DELETE', `/projects/${projectId}/branches/${branch.id}`)\n   109→    } catch {\n   110→      // Best effort cleanup\n   111→    }\n   112→  }\n   113→}\n   114→\n   115→async function createEphemeralBranch(projectId: string, branchName: string): Promise<string> {\n   116→  const data = await neonApi('POST', `/projects/${projectId}/branches`, {\n   117→    branch: { name: branchName },\n   118→    endpoints: [{ type: 'read_write' }],\n   119→  }) as NeonBranchCreateResponse\n   120→\n   121→  const host = data.endpoints[0]?.host\n   122→  if (!host) {\n   123→    // Fetch endpoints separately\n   124→    const epData = await neonApi('GET', `/projects/${projectId}/branches/${data.branch.id}/endpoints`) as NeonEndpointsResponse\n   125→    if (!epData.endpoints[0]?.host) {\n   126→      throw new Error('No endpoint created for ephemeral branch')\n   127→    }\n   128→    return buildConnectionString(epData.endpoints[0].host)\n   129→  }\n   130→  return buildConnectionString(host)\n   131→}\n   132→\n   133→function buildConnectionString(host: string): string {\n   134→  const mainDbUrl = getEnvVar('DATABASE_URL')\n   135→  const url = new URL(mainDbUrl)\n   136→  url.hostname = host\n   137→  return url.toString()\n   138→}\n   139→\n   140→async function deleteBranch(projectId: string, branchName: string): Promise<void> {\n   141→  const data = await neonApi('GET', `/projects/${projectId}/branches`) as NeonBranchListResponse\n   142→  const branch = data.branches.find((b: NeonBranch) => b.name === branchName)\n   143→  if (branch) {\n   144→    await neonApi('DELETE', `/projects/${projectId}/branches/${branch.id}`)\n   145→  }\n   146→}\n   147→\n   148→// ── Replay recordings parser ─────────────────────────────────────────────────\n   149→\n   150→interface RecordingEntry {\n   151→  id?: string\n   152→  kind: string\n   153→  timestamp?: string\n   154→  metadata?: {\n   155→    test?: {\n   156→      result?: string\n   157→      title?: string\n   158→    }\n   159→    uri?: string\n   160→  }\n   161→  duration?: number\n   162→}\n   163→\n   164→interface ParsedRecording {\n   165→  id: string\n   166→  testResult: string\n   167→  testTitle: string\n   168→  specFile: string\n   169→  duration: number\n   170→}\n   171→\n   172→function parseRecordingsLog(): ParsedRecording[] {\n   173→  const logPath = join(process.env.HOME || '~', '.replay', 'recordings.log')\n   174→  if (!existsSync(logPath)) return []\n   175→\n   176→  const content = readFileSync(logPath, 'utf-8')\n   177→  const lines = content.split('\\n').filter(l => l.trim())\n   178→\n   179→  const recordings = new Map<string, { id: string; duration: number }>()\n   180→  const metadata = new Map<string, { testResult: string; testTitle: string; specFile: string }>()\n   181→\n   182→  for (const line of lines) {\n   183→    try {\n   184→      const entry = JSON.parse(line) as RecordingEntry\n   185→      if (entry.kind === 'createRecording' && entry.id) {\n   186→        recordings.set(entry.id, { id: entry.id, duration: 0 })\n   187→      }\n   188→      if (entry.kind === 'writeFinished' && entry.id) {\n   189→        const rec = recordings.get(entry.id)\n   190→        if (rec && entry.duration) {\n   191→          rec.duration = entry.duration\n   192→        }\n   193→      }\n   194→      if (entry.kind === 'addMetadata' && entry.id && entry.metadata?.test) {\n   195→        metadata.set(entry.id, {\n   196→          testResult: entry.metadata.test.result || 'unknown',\n   197→          testTitle: entry.metadata.test.title || '',\n   198→          specFile: entry.metadata.uri || '',\n   199→        })\n   200→      }\n   201→    } catch {\n   202→      // Skip malformed lines\n   203→    }\n   204→  }\n   205→\n   206→  const results: ParsedRecording[] = []\n   207→  for (const [id, rec] of recordings) {\n   208→    const meta = metadata.get(id)\n   209→    if (meta) {\n   210→      results.push({\n   211→        id,\n   212→        testResult: meta.testResult,\n   213→        testTitle: meta.testTitle,\n   214→        specFile: meta.specFile,\n   215→        duration: rec.duration,\n   216→      })\n   217→    }\n   218→  }\n   219→  return results\n   220→}\n   221→\n   222→// ── Main ─────────────────────────────────────────────────────────────────────\n   223→\n   224→async function main(): Promise<void> {\n   225→  loadDotEnv()\n   226→\n   227→  const testFile = process.argv[2]\n   228→  if (!testFile) {\n   229→    console.error('Usage: npm run test <testFile>')\n   230→    process.exit(1)\n   231→  }\n   232→\n   233→  const neonApiKey = getEnvVar('NEON_API_KEY')\n   234→  const projectId = getEnvVar('NEON_PROJECT_ID')\n   235→  // Ensure DATABASE_URL is available (needed for building connection strings)\n   236→  getEnvVar('DATABASE_URL')\n   237→  // Suppress unused variable warning\n   238→  void neonApiKey\n   239→\n   240→  const logNum = getNextLogNumber()\n   241→  const logFile = join(logsDir, `test-run-${logNum}.log`)\n   242→  const branchName = `test-run-${Date.now()}`\n   243→  let playwrightExitCode = 1\n   244→  let ephemeralDbUrl = ''\n   245→\n   246→  // Step 1: Kill stale processes\n   247→  killStaleProcesses()\n   248→\n   249→  // Step 2: Clean up stale Neon branches\n   250→  await cleanupStaleBranches(projectId)\n   251→\n   252→  // Step 3: Create ephemeral Neon branch\n   253→  try {\n   254→    ephemeralDbUrl = await createEphemeralBranch(projectId, branchName)\n   255→  } catch (err) {\n   256→    console.error(`Failed to create ephemeral branch: ${err}`)\n   257→    process.exit(1)\n   258→  }\n   259→\n   260→  try {\n   261→    // Step 4: Initialize schema and seed\n   262→    await initSchema(ephemeralDbUrl)\n   263→    await seedDatabase(ephemeralDbUrl)\n   264→\n   265→    // Step 5: Start netlify dev\n   266→    const netlifyDev = spawn('netlify', ['dev', '--port', '8888'], {\n   267→      cwd: appDir,\n   268→      env: { ...process.env, DATABASE_URL: ephemeralDbUrl },\n   269→      stdio: ['ignore', 'pipe', 'pipe'],\n   270→      detached: true,\n   271→    })\n   272→\n   273→    // Wait for netlify dev to be ready\n   274→    await new Promise<void>((resolve, reject) => {\n   275→      const timeout = setTimeout(() => {\n   276→        reject(new Error('netlify dev failed to start within 60 seconds'))\n   277→      }, 60000)\n   278→\n   279→      let output = ''\n   280→      const checkReady = (data: Buffer) => {\n   281→        output += data.toString()\n   282→        if (output.includes('Server ready') || output.includes('ready on') || output.includes('localhost:8888')) {\n   283→          clearTimeout(timeout)\n   284→          resolve()\n   285→        }\n   286→      }\n   287→\n   288→      netlifyDev.stdout?.on('data', checkReady)\n   289→      netlifyDev.stderr?.on('data', checkReady)\n   290→\n   291→      netlifyDev.on('error', (err) => {\n   292→        clearTimeout(timeout)\n   293→        reject(err)\n   294→      })\n   295→\n   296→      netlifyDev.on('exit', (code) => {\n   297→        if (code !== null && code !== 0) {\n   298→          clearTimeout(timeout)\n   299→          reject(new Error(`netlify dev exited with code ${code}\\n${output}`))\n   300→        }\n   301→      })\n   302→    })\n   303→\n   304→    // Step 6: Remove stale recordings\n   305→    try {\n   306→      execSync('npx replayio remove --all', { cwd: appDir, stdio: 'ignore' })\n   307→    } catch { /* ignore */ }\n   308→\n   309→    // Step 7: Run Playwright\n   310→    // Reset database before running (ensures clean state)\n   311→    await resetDatabase(ephemeralDbUrl)\n   312→\n   313→    try {\n   314→      const pwOutput = execSync(\n   315→        `npx playwright test ${testFile} --retries 0 --workers 1`,\n   316→        {\n   317→          cwd: appDir,\n   318→          encoding: 'utf-8',\n   319→          stdio: ['ignore', 'pipe', 'pipe'],\n   320→          env: {\n   321→            ...process.env,\n   322→            DATABASE_URL: ephemeralDbUrl,\n   323→            TEST_DATABASE_URL: ephemeralDbUrl,\n   324→            BASE_URL: 'http://localhost:8888',\n   325→          },\n   326→          timeout: 300000,\n   327→        }\n   328→      )\n   329→      writeFileSync(logFile, pwOutput)\n   330→      playwrightExitCode = 0\n   331→    } catch (e: unknown) {\n   332→      const err = e as { stdout?: string; stderr?: string; status?: number }\n   333→      const output = (err.stdout || '') + '\\n' + (err.stderr || '')\n   334→      writeFileSync(logFile, output)\n   335→      playwrightExitCode = err.status || 1\n   336→    }\n   337→\n   338→    // Step 8: Parse results\n   339→    let passed = 0\n   340→    let failed = 0\n   341→    let skipped = 0\n   342→    const resultsPath = join(appDir, 'test-results', 'results.json')\n   343→    if (existsSync(resultsPath)) {\n   344→      try {\n   345→        const resultsJson = JSON.parse(readFileSync(resultsPath, 'utf-8'))\n   346→        for (const suite of resultsJson.suites || []) {\n   347→          for (const spec of suite.specs || []) {\n   348→            for (const test of spec.tests || []) {\n   349→              if (test.status === 'expected' || test.status === 'passed') passed++\n   350→              else if (test.status === 'unexpected' || test.status === 'failed') failed++\n   351→              else if (test.status === 'skipped') skipped++\n   352→            }\n   353→          }\n   354→        }\n   355→      } catch {\n   356→        // If results.json is malformed, we'll just use exit code\n   357→      }\n   358→    }\n   359→\n   360→    // Step 9: On failure, handle recordings\n   361→    let uploadedRecordingId = ''\n   362→    if (playwrightExitCode !== 0) {\n   363→      const recordings = parseRecordingsLog()\n   364→\n   365→      // Append metadata to log\n   366→      if (recordings.length > 0) {\n   367→        let metadataBlock = '\\n=== REPLAY RECORDINGS METADATA ===\\n'\n   368→        for (const rec of recordings) {\n   369→          metadataBlock += JSON.stringify({\n   370→            id: rec.id,\n   371→            testResult: rec.testResult,\n   372→            testTitle: rec.testTitle,\n   373→            specFile: rec.specFile,\n   374→          }) + '\\n'\n   375→        }\n   376→        metadataBlock += '=== END REPLAY RECORDINGS METADATA ===\\n'\n   377→        writeFileSync(logFile, readFileSync(logFile, 'utf-8') + metadataBlock)\n   378→      }\n   379→\n   380→      // Find the longest-duration failed recording\n   381→      const failedRecordings = recordings\n   382→        .filter(r => r.testResult === 'failed' || r.testResult === 'timedOut')\n   383→        .sort((a, b) => b.duration - a.duration)\n   384→\n   385→      if (failedRecordings.length > 0) {\n   386→        const toUpload = failedRecordings[0]\n   387→        try {\n   388→          execSync(`npx replayio upload ${toUpload.id}`, {\n   389→            cwd: appDir,\n   390→            encoding: 'utf-8',\n   391→            stdio: 'pipe',\n   392→            timeout: 120000,\n   393→          })\n   394→          uploadedRecordingId = toUpload.id\n   395→          writeFileSync(logFile, readFileSync(logFile, 'utf-8') + `\\nREPLAY UPLOADED: ${uploadedRecordingId}\\n`)\n   396→        } catch (e: unknown) {\n   397→          const err = e as { status?: number }\n   398→          writeFileSync(logFile, readFileSync(logFile, 'utf-8') + `\\nREPLAY UPLOAD FAILED (exit code ${err.status || 'unknown'})\\n`)\n   399→        }\n   400→      }\n   401→    }\n   402→\n   403→    // Step 10: Cleanup - stop netlify dev\n   404→    try {\n   405→      if (netlifyDev.pid) {\n   406→        process.kill(-netlifyDev.pid, 'SIGTERM')\n   407→      }\n   408→    } catch { /* ignore */ }\n   409→\n   410→    // Step 11: Print summary\n   411→    const parts: string[] = []\n   412→    if (passed > 0) parts.push(`${passed} passed`)\n   413→    if (failed > 0) parts.push(`${failed} failed`)\n   414→    if (skipped > 0) parts.push(`${skipped} skipped`)\n   415→\n   416→    let summary = parts.length > 0 ? parts.join(', ') : (playwrightExitCode === 0 ? 'all passed' : 'tests failed')\n   417→    if (uploadedRecordingId) {\n   418→      summary += ` (recording: ${uploadedRecordingId})`\n   419→    }\n   420→    if (playwrightExitCode !== 0) {\n   421→      summary += ` — see logs/test-run-${logNum}.log`\n   422→    }\n   423→    console.log(summary)\n   424→\n   425→  } finally {\n   426→    // Step 10 continued: Delete ephemeral branch and clean recordings\n   427→    try {\n   428→      await deleteBranch(projectId, branchName)\n   429→    } catch { /* ignore */ }\n   430→\n   431→    try {\n   432→      execSync('npx replayio remove --all', { cwd: appDir, stdio: 'ignore' })\n   433→    } catch { /* ignore */ }\n   434→\n   435→    // Kill any leftover netlify dev\n   436→    killStaleProcesses()\n   437→  }\n   438→\n   439→  // Step 12: Exit with Playwright's exit code\n   440→  process.exit(playwrightExitCode)\n   441→}\n   442→\n   443→main()\n   444→"}]},"parent_tool_use_id":null,"session_id":"716202eb-4d7a-44be-b0c3-e090898a2525","uuid":"aaa15f9d-2d40-4a4f-836e-8a5dc1a82458","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/todo-app/scripts/test.ts","content":"import { execSync, spawn } from 'child_process'\nimport { writeFileSync, readFileSync, mkdirSync, readdirSync, existsSync } from 'fs'\nimport { join } from 'path'\nimport { initSchema } from './schema.js'\nimport { seedDatabase, resetDatabase } from './seed-db.js'\n\nconst appDir = join(import.meta.dirname, '..')\nconst logsDir = join(appDir, 'logs')\n\n// ── Helpers ──────────────────────────────────────────────────────────────────\n\nfunction getEnvVar(name: string): string {\n  const val = process.env[name]\n  if (!val) {\n    console.error(`Missing required environment variable: ${name}`)\n    process.exit(1)\n  }\n  return val\n}\n\nfunction loadDotEnv(): void {\n  const envPath = join(appDir, '.env')\n  if (!existsSync(envPath)) return\n  const lines = readFileSync(envPath, 'utf-8').split('\\n')\n  for (const line of lines) {\n    const trimmed = line.trim()\n    if (!trimmed || trimmed.startsWith('#')) continue\n    const eqIdx = trimmed.indexOf('=')\n    if (eqIdx === -1) continue\n    const key = trimmed.slice(0, eqIdx).trim()\n    const value = trimmed.slice(eqIdx + 1).trim().replace(/^[\"']|[\"']$/g, '')\n    if (!process.env[key]) {\n      process.env[key] = value\n    }\n  }\n}\n\nfunction getNextLogNumber(): number {\n  mkdirSync(logsDir, { recursive: true })\n  const existing = readdirSync(logsDir)\n    .filter(f => /^test-run-\\d+\\.log$/.test(f))\n    .map(f => parseInt(f.match(/test-run-(\\d+)\\.log/)![1], 10))\n  return existing.length > 0 ? Math.max(...existing) + 1 : 1\n}\n\nfunction killStaleProcesses(): void {\n  try {\n    execSync(\"pkill -f 'netlify dev' || true\", { stdio: 'ignore' })\n  } catch { /* ignore */ }\n  try {\n    execSync(\"pkill -f 'vite' || true\", { stdio: 'ignore' })\n  } catch { /* ignore */ }\n  // Give processes time to exit\n  execSync('sleep 1', { stdio: 'ignore' })\n}\n\n// ── Neon API helpers ─────────────────────────────────────────────────────────\n\nasync function neonApi(method: string, path: string, body?: unknown): Promise<unknown> {\n  const apiKey = getEnvVar('NEON_API_KEY')\n  const res = await fetch(`https://console.neon.tech/api/v2${path}`, {\n    method,\n    headers: {\n      Authorization: `Bearer ${apiKey}`,\n      'Content-Type': 'application/json',\n      Accept: 'application/json',\n    },\n    body: body ? JSON.stringify(body) : undefined,\n  })\n  if (!res.ok) {\n    const text = await res.text()\n    throw new Error(`Neon API ${method} ${path} failed (${res.status}): ${text}`)\n  }\n  const contentType = res.headers.get('content-type')\n  if (contentType?.includes('application/json')) {\n    return res.json()\n  }\n  return null\n}\n\ninterface NeonBranch {\n  id: string\n  name: string\n}\n\ninterface NeonBranchListResponse {\n  branches: NeonBranch[]\n}\n\ninterface NeonEndpoint {\n  host: string\n}\n\ninterface NeonEndpointsResponse {\n  endpoints: NeonEndpoint[]\n}\n\ninterface NeonBranchCreateResponse {\n  branch: NeonBranch\n  endpoints: NeonEndpoint[]\n}\n\nasync function cleanupStaleBranches(projectId: string): Promise<void> {\n  const data = await neonApi('GET', `/projects/${projectId}/branches`) as NeonBranchListResponse\n  const staleBranches = data.branches.filter((b: NeonBranch) => b.name.startsWith('test-run-'))\n  for (const branch of staleBranches) {\n    try {\n      await neonApi('DELETE', `/projects/${projectId}/branches/${branch.id}`)\n    } catch {\n      // Best effort cleanup\n    }\n  }\n}\n\nasync function createEphemeralBranch(projectId: string, branchName: string): Promise<string> {\n  const data = await neonApi('POST', `/projects/${projectId}/branches`, {\n    branch: { name: branchName },\n    endpoints: [{ type: 'read_write' }],\n  }) as NeonBranchCreateResponse\n\n  const host = data.endpoints[0]?.host\n  if (!host) {\n    // Fetch endpoints separately\n    const epData = await neonApi('GET', `/projects/${projectId}/branches/${data.branch.id}/endpoints`) as NeonEndpointsResponse\n    if (!epData.endpoints[0]?.host) {\n      throw new Error('No endpoint created for ephemeral branch')\n    }\n    return buildConnectionString(epData.endpoints[0].host)\n  }\n  return buildConnectionString(host)\n}\n\nfunction buildConnectionString(host: string): string {\n  const mainDbUrl = getEnvVar('DATABASE_URL')\n  const url = new URL(mainDbUrl)\n  url.hostname = host\n  return url.toString()\n}\n\nasync function deleteBranch(projectId: string, branchName: string): Promise<void> {\n  const data = await neonApi('GET', `/projects/${projectId}/branches`) as NeonBranchListResponse\n  const branch = data.branches.find((b: NeonBranch) => b.name === branchName)\n  if (branch) {\n    await neonApi('DELETE', `/projects/${projectId}/branches/${branch.id}`)\n  }\n}\n\n// ── Replay recordings parser ─────────────────────────────────────────────────\n\ninterface RecordingEntry {\n  id?: string\n  kind: string\n  timestamp?: string\n  metadata?: {\n    test?: {\n      result?: string\n      title?: string\n    }\n    uri?: string\n  }\n  duration?: number\n}\n\ninterface ParsedRecording {\n  id: string\n  testResult: string\n  testTitle: string\n  specFile: string\n  duration: number\n}\n\nfunction parseRecordingsLog(): ParsedRecording[] {\n  const logPath = join(process.env.HOME || '~', '.replay', 'recordings.log')\n  if (!existsSync(logPath)) return []\n\n  const content = readFileSync(logPath, 'utf-8')\n  const lines = content.split('\\n').filter(l => l.trim())\n\n  const recordings = new Map<string, { id: string; duration: number }>()\n  const metadata = new Map<string, { testResult: string; testTitle: string; specFile: string }>()\n\n  for (const line of lines) {\n    try {\n      const entry = JSON.parse(line) as RecordingEntry\n      if (entry.kind === 'createRecording' && entry.id) {\n        recordings.set(entry.id, { id: entry.id, duration: 0 })\n      }\n      if (entry.kind === 'writeFinished' && entry.id) {\n        const rec = recordings.get(entry.id)\n        if (rec && entry.duration) {\n          rec.duration = entry.duration\n        }\n      }\n      if (entry.kind === 'addMetadata' && entry.id && entry.metadata?.test) {\n        metadata.set(entry.id, {\n          testResult: entry.metadata.test.result || 'unknown',\n          testTitle: entry.metadata.test.title || '',\n          specFile: entry.metadata.uri || '',\n        })\n      }\n    } catch {\n      // Skip malformed lines\n    }\n  }\n\n  const results: ParsedRecording[] = []\n  for (const [id, rec] of recordings) {\n    const meta = metadata.get(id)\n    if (meta) {\n      results.push({\n        id,\n        testResult: meta.testResult,\n        testTitle: meta.testTitle,\n        specFile: meta.specFile,\n        duration: rec.duration,\n      })\n    }\n  }\n  return results\n}\n\n// ── Main ─────────────────────────────────────────────────────────────────────\n\nasync function main(): Promise<void> {\n  loadDotEnv()\n\n  const testFile = process.argv[2]\n  if (!testFile) {\n    console.error('Usage: npm run test <testFile>')\n    process.exit(1)\n  }\n\n  const neonApiKey = getEnvVar('NEON_API_KEY')\n  const projectId = getEnvVar('NEON_PROJECT_ID')\n  // Ensure DATABASE_URL is available (needed for building connection strings)\n  getEnvVar('DATABASE_URL')\n  // Suppress unused variable warning\n  void neonApiKey\n\n  const logNum = getNextLogNumber()\n  const logFile = join(logsDir, `test-run-${logNum}.log`)\n  const branchName = `test-run-${Date.now()}`\n  let playwrightExitCode = 1\n  let ephemeralDbUrl = ''\n\n  // Step 1: Kill stale processes\n  killStaleProcesses()\n\n  // Step 2: Clean up stale Neon branches\n  await cleanupStaleBranches(projectId)\n\n  // Step 3: Create ephemeral Neon branch\n  try {\n    ephemeralDbUrl = await createEphemeralBranch(projectId, branchName)\n  } catch (err) {\n    console.error(`Failed to create ephemeral branch: ${err}`)\n    process.exit(1)\n  }\n\n  try {\n    // Step 4: Initialize schema and seed\n    await initSchema(ephemeralDbUrl)\n    await seedDatabase(ephemeralDbUrl)\n\n    // Step 5: Start netlify dev\n    const netlifyDev = spawn('netlify', ['dev', '--port', '8888'], {\n      cwd: appDir,\n      env: { ...process.env, DATABASE_URL: ephemeralDbUrl },\n      stdio: ['ignore', 'pipe', 'pipe'],\n      detached: true,\n    })\n\n    // Wait for netlify dev to be ready\n    await new Promise<void>((resolve, reject) => {\n      const timeout = setTimeout(() => {\n        reject(new Error('netlify dev failed to start within 60 seconds'))\n      }, 60000)\n\n      let output = ''\n      const checkReady = (data: Buffer) => {\n        output += data.toString()\n        if (output.includes('Server ready') || output.includes('ready on') || output.includes('localhost:8888')) {\n          clearTimeout(timeout)\n          resolve()\n        }\n      }\n\n      netlifyDev.stdout?.on('data', checkReady)\n      netlifyDev.stderr?.on('data', checkReady)\n\n      netlifyDev.on('error', (err) => {\n        clearTimeout(timeout)\n        reject(err)\n      })\n\n      netlifyDev.on('exit', (code) => {\n        if (code !== null && code !== 0) {\n          clearTimeout(timeout)\n          reject(new Error(`netlify dev exited with code ${code}\\n${output}`))\n        }\n      })\n    })\n\n    // Step 6: Remove stale recordings\n    try {\n      execSync('npx replayio remove --all', { cwd: appDir, stdio: 'ignore' })\n    } catch { /* ignore */ }\n\n    // Step 7: Run Playwright\n    // Reset database before running (ensures clean state)\n    await resetDatabase(ephemeralDbUrl)\n\n    try {\n      const pwOutput = execSync(\n        `npx playwright test ${testFile} --retries 0 --workers 1`,\n        {\n          cwd: appDir,\n          encoding: 'utf-8',\n          stdio: ['ignore', 'pipe', 'pipe'],\n          env: {\n            ...process.env,\n            DATABASE_URL: ephemeralDbUrl,\n            TEST_DATABASE_URL: ephemeralDbUrl,\n            BASE_URL: 'http://localhost:8888',\n          },\n          timeout: 300000,\n        }\n      )\n      writeFileSync(logFile, pwOutput)\n      playwrightExitCode = 0\n    } catch (e: unknown) {\n      const err = e as { stdout?: string; stderr?: string; status?: number }\n      const output = (err.stdout || '') + '\\n' + (err.stderr || '')\n      writeFileSync(logFile, output)\n      playwrightExitCode = err.status || 1\n    }\n\n    // Step 8: Parse results\n    let passed = 0\n    let failed = 0\n    let skipped = 0\n    const resultsPath = join(appDir, 'test-results', 'results.json')\n    if (existsSync(resultsPath)) {\n      try {\n        const resultsJson = JSON.parse(readFileSync(resultsPath, 'utf-8'))\n        for (const suite of resultsJson.suites || []) {\n          for (const spec of suite.specs || []) {\n            for (const test of spec.tests || []) {\n              if (test.status === 'expected' || test.status === 'passed') passed++\n              else if (test.status === 'unexpected' || test.status === 'failed') failed++\n              else if (test.status === 'skipped') skipped++\n            }\n          }\n        }\n      } catch {\n        // If results.json is malformed, we'll just use exit code\n      }\n    }\n\n    // Step 9: On failure, handle recordings\n    let uploadedRecordingId = ''\n    if (playwrightExitCode !== 0) {\n      const recordings = parseRecordingsLog()\n\n      // Append metadata to log\n      if (recordings.length > 0) {\n        let metadataBlock = '\\n=== REPLAY RECORDINGS METADATA ===\\n'\n        for (const rec of recordings) {\n          metadataBlock += JSON.stringify({\n            id: rec.id,\n            testResult: rec.testResult,\n            testTitle: rec.testTitle,\n            specFile: rec.specFile,\n          }) + '\\n'\n        }\n        metadataBlock += '=== END REPLAY RECORDINGS METADATA ===\\n'\n        writeFileSync(logFile, readFileSync(logFile, 'utf-8') + metadataBlock)\n      }\n\n      // Find the longest-duration failed recording\n      const failedRecordings = recordings\n        .filter(r => r.testResult === 'failed' || r.testResult === 'timedOut')\n        .sort((a, b) => b.duration - a.duration)\n\n      if (failedRecordings.length > 0) {\n        const toUpload = failedRecordings[0]\n        try {\n          execSync(`npx replayio upload ${toUpload.id}`, {\n            cwd: appDir,\n            encoding: 'utf-8',\n            stdio: 'pipe',\n            timeout: 120000,\n          })\n          uploadedRecordingId = toUpload.id\n          writeFileSync(logFile, readFileSync(logFile, 'utf-8') + `\\nREPLAY UPLOADED: ${uploadedRecordingId}\\n`)\n        } catch (e: unknown) {\n          const err = e as { status?: number }\n          writeFileSync(logFile, readFileSync(logFile, 'utf-8') + `\\nREPLAY UPLOAD FAILED (exit code ${err.status || 'unknown'})\\n`)\n        }\n      }\n    }\n\n    // Step 10: Cleanup - stop netlify dev\n    try {\n      if (netlifyDev.pid) {\n        process.kill(-netlifyDev.pid, 'SIGTERM')\n      }\n    } catch { /* ignore */ }\n\n    // Step 11: Print summary\n    const parts: string[] = []\n    if (passed > 0) parts.push(`${passed} passed`)\n    if (failed > 0) parts.push(`${failed} failed`)\n    if (skipped > 0) parts.push(`${skipped} skipped`)\n\n    let summary = parts.length > 0 ? parts.join(', ') : (playwrightExitCode === 0 ? 'all passed' : 'tests failed')\n    if (uploadedRecordingId) {\n      summary += ` (recording: ${uploadedRecordingId})`\n    }\n    if (playwrightExitCode !== 0) {\n      summary += ` — see logs/test-run-${logNum}.log`\n    }\n    console.log(summary)\n\n  } finally {\n    // Step 10 continued: Delete ephemeral branch and clean recordings\n    try {\n      await deleteBranch(projectId, branchName)\n    } catch { /* ignore */ }\n\n    try {\n      execSync('npx replayio remove --all', { cwd: appDir, stdio: 'ignore' })\n    } catch { /* ignore */ }\n\n    // Kill any leftover netlify dev\n    killStaleProcesses()\n  }\n\n  // Step 12: Exit with Playwright's exit code\n  process.exit(playwrightExitCode)\n}\n\nmain()\n","numLines":444,"startLine":1,"totalLines":444}}}
