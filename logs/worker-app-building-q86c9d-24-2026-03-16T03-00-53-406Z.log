[2026-03-16T02:59:32.826Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WZ9Fa5p3xyepyjGbNvMvYQ","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test'\n     2→import { truncateAndSeed } from '../scripts/seed-db'\n     3→\n     4→test.beforeAll(async () => {\n     5→  const dbUrl = process.env.DATABASE_URL\n     6→  if (dbUrl) {\n     7→    await truncateAndSeed(dbUrl)\n     8→  }\n     9→})\n    10→\n    11→// Booking IDs\n    12→const BOOKING_COMPLETED = 'e1111111-1111-1111-1111-111111111111' // Loft, Emma, completed\n    13→const BOOKING_CONFIRMED_VILLA = 'e2222222-2222-2222-2222-222222222222' // Villa, Alex, confirmed\n    14→const BOOKING_CANCELLED = 'e5555555-5555-5555-5555-555555555555' // Loft, Alex, cancelled\n    15→const BOOKING_CONFIRMED_TOWNHOUSE = 'e6666666-6666-6666-6666-666666666666' // Townhouse, Emma, confirmed\n    16→\n    17→// Property IDs for creating pending bookings\n    18→const PROP_LOFT = 'b1111111-1111-1111-1111-111111111111'\n    19→const GUEST_EMMA = 'a3333333-3333-3333-3333-333333333333'\n    20→\n    21→async function loginAsHost(page: import('@playwright/test').Page) {\n    22→  await page.goto('/login')\n    23→  await page.getByTestId('login-email-input').fill('sarah@example.com')\n    24→  await page.getByTestId('login-submit-button').click()\n    25→  await expect(page).toHaveURL('/', { timeout: 30000 })\n    26→}\n    27→\n    28→async function goToBookingsTab(page: import('@playwright/test').Page) {\n    29→  await loginAsHost(page)\n    30→  await page.goto('/hosting')\n    31→  await expect(page.getByTestId('tab-bookings')).toBeVisible({ timeout: 30000 })\n    32→  await page.getByTestId('tab-bookings').click()\n    33→  await expect(page.getByTestId('bookings-tab')).toBeVisible({ timeout: 15000 })\n    34→}\n    35→\n    36→async function createPendingBooking(request: import('@playwright/test').APIRequestContext, overrides?: { check_in?: string; check_out?: string; total_price?: number; num_guests?: number }) {\n    37→  const response = await request.post('http://localhost:8888/api/bookings', {\n    38→    data: {\n    39→      property_id: PROP_LOFT,\n    40→      guest_id: GUEST_EMMA,\n    41→      check_in: overrides?.check_in || '2027-08-01',\n    42→      check_out: overrides?.check_out || '2027-08-05',\n    43→      num_guests: overrides?.num_guests || 2,\n    44→      total_price: overrides?.total_price || 600,\n    45→    },\n    46→  })\n    47→  return response.json()\n    48→}\n    49→\n    50→test.describe('Host Dashboard - Bookings Tab Display & Filters', () => {\n    51→  test.beforeEach(async ({ request }) => {\n    52→    // Clean up non-seed bookings and reset seed booking statuses\n    53→    await request.delete('http://localhost:8888/api/bookings')\n    54→  })\n    55→\n    56→  test('Bookings tab displays table of bookings for host\\'s properties', async ({ page }) => {\n    57→    await goToBookingsTab(page)\n    58→\n    59→    // Table should be visible\n    60→    const table = page.getByTestId('bookings-table')\n    61→    await expect(table).toBeVisible({ timeout: 15000 })\n    62→\n    63→    // Verify column headers\n    64→    await expect(table.locator('th')).toHaveCount(8)\n    65→    await expect(table).toContainText('Property')\n    66→    await expect(table).toContainText('Guest')\n    67→    await expect(table).toContainText('Check-in')\n    68→    await expect(table).toContainText('Check-out')\n    69→    await expect(table).toContainText('Guests')\n    70→    await expect(table).toContainText('Total')\n    71→    await expect(table).toContainText('Status')\n    72→    await expect(table).toContainText('Actions')\n    73→\n    74→    // Sarah has 4 bookings\n    75→    const rows = page.locator('[data-testid^=\"booking-row-\"]')\n    76→    await expect(rows).toHaveCount(4, { timeout: 15000 })\n    77→  })\n    78→\n    79→  test('Bookings table shows correct data for each booking', async ({ page }) => {\n    80→    await goToBookingsTab(page)\n    81→\n    82→    // Check the confirmed Villa booking (e2222222): Villa, Alex Rivera, Apr 1-7 2026, 6 guests, $2,850, confirmed\n    83→    const villaRow = page.getByTestId(`booking-row-${BOOKING_CONFIRMED_VILLA}`)\n    84→    await expect(villaRow).toBeVisible({ timeout: 15000 })\n    85→    await expect(villaRow).toContainText('Beachfront Villa with Private Pool')\n    86→    await expect(villaRow).toContainText('Alex Rivera')\n    87→    await expect(villaRow).toContainText('Apr 1, 2026')\n    88→    await expect(villaRow).toContainText('Apr 7, 2026')\n    89→    await expect(villaRow).toContainText('6')\n    90→    await expect(villaRow).toContainText('$2,850')\n    91→\n    92→    const villaStatus = page.getByTestId(`booking-status-${BOOKING_CONFIRMED_VILLA}`)\n    93→    await expect(villaStatus).toHaveText(/confirmed/i)\n    94→  })\n    95→\n    96→  test('Bookings tab has status filter controls', async ({ page }) => {\n    97→    await goToBookingsTab(page)\n    98→\n    99→    // All 5 filter buttons should be visible\n   100→    await expect(page.getByTestId('booking-filter-all')).toBeVisible({ timeout: 15000 })"}]},"parent_tool_use_id":"toolu_01CczUCWnPqg3t5rNbY5YHaL","session_id":"401e079b-fea0-4b13-afb9-92cd0ea09018","uuid":"60800e7d-8638-4423-bb45-19342c1395c9"}
