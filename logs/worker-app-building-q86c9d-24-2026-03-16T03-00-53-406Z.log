ait expect(sliders).toBeVisible()\n    40→\n    41→    // Verify all six sliders exist with correct labels and default value of 0 (Not rated)\n    42→    const categories = [\n    43→      { key: 'rating', label: 'Overall' },\n    44→      { key: 'cleanliness', label: 'Cleanliness' },\n    45→      { key: 'accuracy', label: 'Accuracy' },\n    46→      { key: 'communication', label: 'Communication' },\n    47→      { key: 'location', label: 'Location' },\n    48→      { key: 'value', label: 'Value' },\n    49→    ]\n    50→\n    51→    for (const { key, label } of categories) {\n    52→      const sliderSection = page.getByTestId(`rating-slider-${key}`)\n    53→      await expect(sliderSection).toBeVisible()\n    54→      await expect(sliderSection).toContainText(label)\n    55→\n    56→      // Default value should be 0 (Not rated)\n    57→      const valueDisplay = page.getByTestId(`rating-value-${key}`)\n    58→      await expect(valueDisplay).toHaveText('Not rated')\n    59→\n    60→      const input = page.getByTestId(`rating-input-${key}`)\n    61→      await expect(input).toHaveValue('0')\n    62→    }\n    63→  })\n    64→\n    65→  test('Adjust overall rating slider', async ({ page }) => {\n    66→    await navigateToReviewPage(page)\n    67→\n    68→    await setSliderValue(page, 'rating', 5)\n    69→\n    70→    await expect(page.getByTestId('rating-value-rating')).toHaveText('5')\n    71→    await expect(page.getByTestId('rating-input-rating')).toHaveValue('5')\n    72→\n    73→    // Other sliders remain at default (Not rated)\n    74→    await expect(page.getByTestId('rating-value-cleanliness')).toHaveText('Not rated')\n    75→    await expect(page.getByTestId('rating-value-accuracy')).toHaveText('Not rated')\n    76→    await expect(page.getByTestId('rating-value-communication')).toHaveText('Not rated')\n    77→    await expect(page.getByTestId('rating-value-location')).toHaveText('Not rated')\n    78→    await expect(page.getByTestId('rating-value-val