[2026-03-16T02:59:30.444Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JJsX9G3f7AXkTpjyhq1Ttm","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test'\n     2→import { truncateAndSeed } from '../scripts/seed-db'\n     3→\n     4→test.beforeAll(async () => {\n     5→  const dbUrl = process.env.DATABASE_URL\n     6→  if (dbUrl) {\n     7→    await truncateAndSeed(dbUrl)\n     8→  }\n     9→})\n    10→\n    11→test.describe('Home Page - SearchBar', () => {\n    12→  test('Search bar displays all input fields on load', async ({ page }) => {\n    13→    await page.goto('/')\n    14→\n    15→    await expect(page.getByTestId('search-bar')).toBeVisible({ timeout: 30000 })\n    16→    await expect(page.getByTestId('search-location')).toBeVisible()\n    17→    await expect(page.getByTestId('search-location')).toHaveAttribute('placeholder', 'Where are you going?')\n    18→    await expect(page.getByTestId('search-checkin')).toBeVisible()\n    19→    await expect(page.getByTestId('search-checkin')).toHaveAttribute('type', 'date')\n    20→    await expect(page.getByTestId('search-checkout')).toBeVisible()\n    21→    await expect(page.getByTestId('search-checkout')).toHaveAttribute('type', 'date')\n    22→    await expect(page.getByTestId('search-guests')).toBeVisible()\n    23→    await expect(page.getByTestId('search-button')).toBeVisible()\n    24→  })\n    25→\n    26→  test('Search by location filters property results', async ({ page }) => {\n    27→    await page.goto('/')\n    28→    await expect(page.locator('[data-testid^=\"property-card-\"]').first()).toBeVisible({ timeout: 30000 })\n    29→\n    30→    await page.getByTestId('search-location').fill('New York')\n    31→    await page.getByTestId('search-button').click()\n    32→\n    33→    const cards = page.locator('[data-testid^=\"property-card-\"]')\n    34→    await expect(cards).toHaveCount(1, { timeout: 15000 })\n    35→    await expect(page.getByTestId('property-grid')).toContainText('New York')\n    36→  })\n    37→\n    38→  test('Search by check-in and check-out dates filters results', async ({ page }) => {\n    39→    await page.goto('/')\n    40→    await expect(page.locator('[data-testid^=\"property-card-\"]').first()).toBeVisible({ timeout: 30000 })\n    41→\n    42→    await page.getByTestId('search-checkin').fill('2026-04-01')\n    43→    await page.getByTestId('search-checkout').fill('2026-04-05')\n    44→    await page.getByTestId('search-button').click()\n    45→\n    46→    // Miami Villa has a confirmed booking Apr 1-7, so it should be excluded (4 of 5 remain)\n    47→    const cards = page.locator('[data-testid^=\"property-card-\"]')\n    48→    await expect(cards).toHaveCount(4, { timeout: 15000 })\n    49→  })\n    50→\n    51→  test('Search by guest count filters results', async ({ page }) => {\n    52→    await page.goto('/')\n    53→    await expect(page.locator('[data-testid^=\"property-card-\"]').first()).toBeVisible({ timeout: 30000 })\n    54→\n    55→    await page.getByTestId('search-guests').fill('5')\n    56→    await page.getByTestId('search-button').click()\n    57→\n    58→    // Properties with max_guests >= 5: Cabin (6), Villa (8), Townhouse (6) = 3\n    59→    const cards = page.locator('[data-testid^=\"property-card-\"]')\n    60→    await expect(cards).toHaveCount(3, { timeout: 15000 })\n    61→  })\n    62→\n    63→  test('Combined search with all fields filters results', async ({ page }) => {\n    64→    await page.goto('/')\n    65→    await expect(page.locator('[data-testid^=\"property-card-\"]').first()).toBeVisible({ timeout: 30000 })\n    66→\n    67→    await page.getByTestId('search-location').fill('New York')\n    68→    await page.getByTestId('search-checkin').fill('2026-05-10')\n    69→    await page.getByTestId('search-checkout').fill('2026-05-15')\n    70→    await page.getByTestId('search-guests').fill('3')\n    71→    await page.getByTestId('search-button').click()\n    72→\n    73→    // Only NY Loft matches: in New York, max_guests 4 >= 3, no conflicting bookings\n    74→    const cards = page.locator('[data-testid^=\"property-card-\"]')\n    75→    await expect(cards).toHaveCount(1, { timeout: 15000 })\n    76→    await expect(page.getByTestId('property-grid')).toContainText('New York')\n    77→  })\n    78→\n    79→  test('Clearing search fields and re-searching shows all results', async ({ page }) => {\n    80→    await page.goto('/')\n    81→    await expect(page.locator('[data-testid^=\"property-card-\"]').first()).toBeVisible({ timeout: 30000 })\n    82→\n    83→    const cards = page.locator('[data-testid^=\"property-card-\"]')\n    84→\n    85→    // Search by location\n    86→    await page.getByTestId('search-location').fill('New York')\n    87→    await page.getByTestId('search-button').click()\n    88→    await expect(cards).toHaveCount(1, { timeout: 15000 })\n    89→\n    90→    // Clear and re-search\n    91→    await page.getByTestId('search-location').fill('')\n    92→    await page.getByTestId('search-button').click()\n    93→    await expect(cards).toHaveCount(5, { timeout: 15000 })\n    94→  })\n    95→\n    96→  test('Search bar is functional on repeated use', async ({ page }) => {\n    97→    test.slow()\n    98→    await page.goto('/')\n    99→    await expect(page.locator('[data-testid^=\"property-card-\"]').first()).toBeVisible({ timeout: 30000 })\n   100→\n   101→    const cards = page.locator('[data-testid^=\"property-card-\"]')\n   102→\n   103→    // First search: New York\n   104→    await page.getByTestId('search-location').fill('New York')\n   105→    await page.getByTestId('search-button').click()\n   106→    await expect(cards).toHaveCount(1, { timeout: 15000 })\n   107→    await expect(page.getByTestId('property-grid')).toContainText('New York')\n   108→\n   109→    // Second search: Austin\n   110→    await page.getByTestId('search-location').fill('')\n   111→    await page.getByTestId('search-location').fill('Austin')\n   112→    await page.getByTestId('search-button').click()\n   113→    await expect(cards).toHaveCount(1, { timeout: 15000 })\n   114→    await expect(page.getByTestId('property-grid')).toContainText('Austin')\n   115→    await expect(page.getByTestId('search-location')).toHaveValue('Austin')\n   116→  })\n   117→\n   118→  test('Check-in date picker prevents selecting past dates', async ({ page }) => {\n   119→    await page.goto('/')\n   120→    await expect(page.getByTestId('search-bar')).toBeVisible({ timeout: 30000 })\n   121→\n   122→    const today = new Date().toISOString().split('T')[0]\n   123→    await expect(page.getByTestId('search-checkin')).toHaveAttribute('min', today)\n   124→  })\n   125→\n   126→  test('Check-out date must be after check-in date', async ({ page }) => {\n   127→    await page.goto('/')\n   128→    await expect(page.getByTestId('search-bar')).toBeVisible({ timeout: 30000 })\n   129→\n   130→    await page.getByTestId('search-checkin').fill('2026-04-10')\n   131→\n   132→    // Checkout min should be the day after check-in\n   133→    await expect(page.getByTestId('search-checkout')).toHaveAttribute('min', '2026-04-11')\n   134→  })\n   135→\n   136→  test('Guest count selector enforces minimum of 1', async ({ page }) => {\n   137→    await page.goto('/')\n   138→    await expect(page.getByTestId('search-bar')).toBeVisible({ timeout: 30000 })\n   139→\n   140→    await expect(page.getByTestId('search-guests')).toHaveAttribute('min', '1')\n   141→\n   142→    // Attempt to set guests to 0 - should be corrected to 1\n   143→    await page.getByTestId('search-guests').fill('0')\n   144→    await expect(page.getByTestId('search-guests')).toHaveValue('1')\n   145→  })\n   146→})\n   147→"}]},"parent_tool_use_id":"toolu_01CczUCWnPqg3t5rNbY5YHaL","session_id":"401e079b-fea0-4b13-afb9-92cd0ea09018","uuid":"c9f7dfb5-80c9-4c50-9758-a42cc0116e61"}
