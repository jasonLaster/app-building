timeout: 30000 })\n    41→}\n    42→\n    43→test.describe.serial('ReviewForm', () => {\n    44→  test.beforeEach(async ({ page }) => {\n    45→    await deleteAllReviewsForGuest(page, ALEX_ID)\n    46→  })\n    47→\n    48→  test('Review form displays comment text area', async ({ page }) => {\n    49→    await login(page, ALEX_EMAIL)\n    50→    await page.goto(`/trips/${ALEX_COMPLETED_BOOKING}/review`)\n    51→    await expect(page.getByTestId('review-form')).toBeVisible({ timeout: 30000 })\n    52→\n    53→    const textarea = page.getByTestId('review-comment-textarea')\n    54→    await expect(textarea).toBeVisible()\n    55→    await expect(textarea).toHaveAttribute('placeholder', /Tell others about your experience/)\n    56→  })\n    57→\n    58→  test('Submit button is visible', async ({ page }) => {\n    59→    await login(page, ALEX_EMAIL)\n    60→    await page.goto(`/trips/${ALEX_COMPLETED_BOOKING}/review`)\n    61→    await expect(page.getByTestId('review-form')).toBeVisible({ timeout: 30000 })\n    62→\n    63→    const submitBtn = page.getByTestId('submit-review-button')\n    64→    await expect(submitBtn).toBeVisible()\n    65→    await expect(submitBtn).toContainText('Submit Review')\n    66→  })\n    67→\n    68→  test('Type a comment in the text area', async ({ page }) => {\n    69→    await navigateToReviewPage(page)\n    70→\n    71→    const comment = 'Amazing stay! The villa was beautiful and the host was very responsive.'\n    72→    await page.getByTestId('review-comment-textarea').fill(comment)\n    73→    await expect(page.getByTestId('review-comment-textarea')).toHaveValue(comment)\n    74→  })\n    75→\n    76→  test('Submit review with all ratings and comment', async ({ page }) => {\n    77→    test.slow()\n    78→    await navigateToReviewPage(page)\n    79→\n    80→    await setAllRatings(page, {\n    81→      rating: 5,\n    82→      cleanliness: 5,\n    83→      accuracy: 4,\n    84→      communication: 5,\n    85→      location: 4,\