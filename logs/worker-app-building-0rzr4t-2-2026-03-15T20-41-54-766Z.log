  ]\n   341→\n   342→    // 1-stop connecting flight templates: [airlineCode, flightNumPrefix, depHour, depMin, totalDur, aircraft, wifi, power, entertainment, co2, basePrice, hubCode, leg1Dur, layoverMin, leg2Dur, leg1TermDep, leg1TermArr, leg2TermDep, leg2TermArr]\n   343→    const connectingTemplates: [string, string, number, number, number, string, boolean, boolean, boolean, number, number, string, number, number, number, string, string, string, string][] = [\n   344→      // Via ORD (Chicago)\n   345→      ['UA', 'UA3', 6, 0, 420, 'Boeing 737-900', true, true, false, 195, 149, 'ORD', 240, 90, 150, 'T2', 'T1', 'T1', 'T5'],\n   346→      ['AA', 'AA3', 8, 0, 450, 'Boeing 737-800', true, true, false, 200, 139, 'ORD', 240, 120, 150, 'T2', 'T3', 'T3', 'T8'],\n   347→      ['UA', 'UA4', 13, 0, 430, 'Airbus A320neo', true, true, false, 190, 159, 'ORD', 240, 100, 150, 'T2', 'T1', 'T2', 'T5'],\n   348→      // Via DFW (Dallas)\n   349→      ['AA', 'AA4', 7, 0, 460, 'Boeing 737 MAX', true, true, false, 210, 129, 'DFW', 210, 120, 210, 'T2', 'TC', 'TC', 'T8'],\n   350→      ['AA', 'AA5', 14, 0, 440, 'Boeing 737-800', true, true, false, 205, 139, 'DFW', 210, 100, 200, 'T2', 'TC', 'TC', 'T8'],\n   351→      // Via DEN (Denver)\n   352→      ['UA', 'UA5', 9, 0, 470, 'Boeing 737-800', true, false, false, 200, 119, 'DEN', 180, 120, 240, 'T2', 'B', 'B', 'T5'],\n   353→      ['F9', 'F98', 11, 0, 490, 'Airbus A321neo', false, false, false, 210, 89, 'DEN', 180, 150, 230, 'T2', 'A', 'A', 'T5'],\n   354→      // Via ATL (Atlanta)\n   355→      ['DL', 'DL3', 7, 30, 440, 'Boeing 757-200', true, true, true, 195, 139, 'ATL', 270, 90, 150, 'T2', 'S', 'S', 'T4'],\n   356→      ['DL', 'DL4', 15, 0, 460, 'Airbus A321neo', true, true, true, 200, 149, 'ATL', 270, 100, 150, 'T2', 'S', 'T', 'T4'],\n   357→      // Via LAX (Los Angeles)\n   358→      ['AA', 'AA6', 6, 30, 480, 'Boeing 737-800', true, true, false, 215, 119, 'LAX', 90, 120, 330, 'T2', 'T4', 'T4', 'T8'],\n   359→      ['DL', 'DL5', 10, 0, 460, 'Airbus A320', true, true, false, 205, 129, 'LAX', 90, 90, 330, 'T2', 'T5', 'T5', 'T4'],\n   360→      // Via SEA (Seattle — backtrack connecting)\n   361→      ['AS', 'AS9', 8, 0, 510, 'Boeing 737-900ER', true, true, false, 220, 109, 'SEA', 120, 120, 330, 'T2', 'N', 'N', 'T5'],\n   362→    ]\n   363→\n   364→    // Date range: March 16 – April 15, 2026 (31 days)\n   365→    const startDate = new Date('2026-03-16')\n   366→    const numDays = 31\n   367→\n   368→    // Seeded deterministic \"random\" for reproducible variation\n   369→    let seed = 42\n   370→    function seededRandom(): number {\n   371→      seed = (seed * 1103515245 + 12345) & 0x7fffffff\n   372→      return (seed >> 16) / 32768\n   373→    }\n   374→\n   375→    // Price multipliers by day-of-week: Fri/Sun premium, Tue/Wed discount\n   376→    const dowPriceMultipliers = [1.15, 0.95, 0.88, 0.88, 0.98, 1.22, 1.18] // Sun-Sat\n   377→\n   378→    // Advance purchase discount: closer dates are more expensive\n   379→    function advancePriceMult(daysOut: number): number {\n   380→      if (daysOut <= 3) return 1.35\n   381→      if (daysOut <= 7) return 1.20\n   382→      if (daysOut <= 14) return 1.05\n   383→      if (daysOut <= 21) return 0.95\n   384→      return 0.90\n   385→    }\n   386→\n   387→    for (let d = 0; d < numDays; d++) {\n   388→      const date = new Date(startDate)\n   389→      date.setDate(date.getDate() + d)\n   390→      const dateStr = date.toISOString().split('T')[0]!\n   391→      const dow = date.getDay() // 0=Sun\n   392→      const daysFromToday = Math.max(1, Math.round((date.getTime() - new Date('2026-03-15').getTime()) / 86400000))\n   393→\n   394→      const dowMult = dowPriceMultipliers[dow]!\n   395→      const advMult = advancePriceMult(daysFromToday)\n   396→\n   397→      // Nonstop flights — vary which ones operate each day for realism\n   398→      for (let t = 0; t < nonstopTemplates.length; t++) {\n   399→        const tmpl = nonstopTemplates[t]!\n   400→        // Skip some flights on certain days for variety (but keep majority)\n   401→        const skipHash = (d * 31 + t * 7) % 10\n   402→        if (skipHash === 0) continue // ~10% of flights don't operate on a given day\n   403→\n   404→        const [airline, prefix, depH, depM, dur, aircraft, wifi, power, ent, co2, baseEcon] = tmpl\n   405→        const dayNum = String(d + 1).padStart(2, '0')\n   406→        const flightNum = `${prefix}${dayNum}`\n   407→        const depHStr = String(depH).padStart(2, '0')\n   408→        const depMStr = String(depM).padStart(2, '0')\n   409→        const depTimeStr = `${dateStr} ${depHStr}:${depMStr}`\n   410→\n   411→        // Calculate arrival\n   412→        const depDate = new Date(`${dateStr}T${depHStr}:${depMStr}:00`)\n   413→        const arrDate = new Date(depDate.getTime() + dur * 60000)\n   414→        const arrStr = `${arrDate.getFullYear()}-${String(arrDate.getMonth() + 1).padStart(2, '0')}-${String(arrDate.getDate()).padStart(2, '0')} ${String(arrDate.getHours()).padStart(2, '0')}:${String(arrDate.getMinutes()).padStart(2, '0')}`\n   415→\n   416→        // Price varies by day-of-week, advance purchase, and random noise\n   417→        const noise = 0.90 + seededRandom() * 0.20 // ±10% noise\n   418→        const price = Math.round(baseEcon * dowMult * advMult * noise)\n   419→\n   420→        await createFlight(airline, flightNum, 'SFO', 'JFK', depTimeStr, arrStr, dur, aircraft, wifi, power, ent, co2, price)\n   421→      }\n   422→\n   423→      // Connecting flights — fewer per day\n   424→      for (let t = 0; t < connectingTemplates.length; t++) {\n   425→        const tmpl = connectingTemplates[t]!\n   426→        // ~20% skip for connecting flights\n   427→        const skipHash = (d * 17 + t * 13) % 5\n   428→        if (skipHash === 0) continue\n   429→\n   430→        const [airline, prefix, depH, depM, totalDur, aircraft, wifi, power, ent, co2, baseEcon, hubCode, leg1Dur, layoverMin, leg2Dur, l1td, l1ta, l2td, l2ta] = tmpl\n   431→        const dayNum = String(d + 1).padStart(2, '0')\n   432→        const flightNum = `${prefix}${dayNum}`\n   433→        const depHStr = String(depH).padStart(2, '0')\n   434→        const depMStr = String(depM).padStart(2, '0')\n   435→        const depTimeStr = `${dateStr} ${depHStr}:${depMStr}`\n   436→\n   437→        // Leg 1 arrival\n   438→        const depDate = new Date(`${dateStr}T${depHStr}:${depMStr}:00`)\n   439→        const leg1Arr = new Date(depDate.getTime() + leg1Dur * 60000)\n   440→        const leg2Dep = new Date(leg1Arr.getTime() + layoverMin * 60000)\n   441→        const leg2Arr = new Date(leg2Dep.getTime() + leg2Dur * 60000)\n   442→\n   443→        function fmtDt(dt: Date): string {\n   444→          return `${dt.getFullYear()}-${String(dt.getMonth() + 1).padStart(2, '0')}-${String(dt.getDate()).padStart(2, '0')} ${String(dt.getHours()).padStart(2, '0')}:${String(dt.getMinutes()).padStart(2, '0')}`\n   445→        }\n   446→\n   447→        const noise = 0.88 + seededRandom() * 0.24 // wider noise for connecting\n   448→        const price = Math.round(baseEcon * dowMult * advMult * noise)\n   449→\n   450→        await createFlight(airline, flightNum, 'SFO', 'JFK', depTimeStr, fmtDt(leg2Arr), totalDur, aircraft, wifi, power, ent, co2, price, [\n   451→          { origin: 'SFO', dest: hubCode, dep: depTimeStr, arr: fmtDt(leg1Arr), dur: leg1Dur, terminal_dep: l1td, terminal_arr: l1ta },\n   452→          { origin: hubCode, dest: 'JFK', dep: fmtDt(leg2Dep), arr: fmtDt(leg2Arr), dur: leg2Dur, terminal_dep: l2td, terminal_arr: l2ta }\n   453→        ])\n   454→      }\n   455→    }\n   456→  }\n   457→\n   458→  // LAX-LHR\n   459→  await createFlight('BA', 'BA500', 'LAX', 'LHR', '2026-04-01 20:00', '2026-04-02 14:30', 630, 'Boeing 777-300ER', true, true, true, 380, 649)\n   460→  await createFlight('AA', 'AA800', 'LAX', 'LHR', '2026-04-01 18:00', '2026-04-02 12:30', 630, 'Boeing 787-9', true, true, true, 370, 599)\n   461→\n   462→  // Past flights for trips testing\n   463→  await createFlight('DL', 'DL950', 'LAX', 'JFK', '2026-02-01 08:00', '2026-02-01 16:30', 330, 'Boeing 757-200', true, true, true, 165, 249)\n   464→\n   465→  // Additional future flights for trips testing\n   466→  await createFlight('AA', 'AA960', 'LAX', 'JFK', '2026-03-25 09:00', '2026-03-25 17:30', 330, 'Boeing 777-300ER', true, true, true, 180, 289)\n   467→  await createFlight('AA', 'AA965', 'JFK', 'LAX', '2026-03-30 08:00', '2026-03-30 11:00', 360, 'Boeing 777-300ER', true, true, true, 180, 289)\n   468→  await createFlight('DL', 'DL960', 'LAX', 'JFK', '2026-03-30 10:00', '2026-03-30 18:30', 330, 'Airbus A321neo', true, true, true, 165, 269)\n   469→  await createFlight('UA', 'UA970', 'LAX', 'JFK', '2026-04-10 08:00', '2026-04-10 16:30', 330, 'Boeing 787-9', true, true, true, 150, 309)\n   470→  await createFlight('AA', 'AA970', 'SFO', 'ORD', '2026-04-05 11:00', '2026-04-05 17:00', 270, 'Boeing 737-800', true, true, false, 140, 179)\n   471→\n   472→  // Create a session for seed data\n   473→  await sql`INSERT INTO sessions (session_token) VALUES ('seed-session-token')`\n   474→  const sessionRows = await sql`SELECT id FROM sessions WHERE session_token = 'seed-session-token'`\n   475→  const sessionRow = sessionRows[0]\n   476→  if (!sessionRow) return\n   477→  const sessionId = sessionRow.id as string\n   478→\n   479→  // Recent searches\n   480→  const laxId = airportMap.get('LAX')!\n   481→  const jfkId = airportMap.get('JFK')!\n   482→  const sfoId = airportMap.get('SFO')!\n   483→  const ordId = airportMap.get('ORD')!\n   484→  const lhrId = airportMap.get('LHR')!\n   485→\n   486→  await sql`INSERT INTO recent_searches (session_id, origin_airport_id, destination_airport_id, departure_date, return_date, passengers_adults, cabin_class, trip_type)\n   487→    VALUES (${sessionId}, ${laxId}, ${jfkId}, '2026-04-01', '2026-04-08', 1, 'economy', 'round_trip')`\n   488→  await sql`INSERT INTO recent_searches (session_id, origin_airport_id, destination_airport_id, departure_date, return_date, passengers_adults, cabin_class, trip_type)\n   489→    VALUES (${sessionId}, ${sfoId}, ${ordId}, '2026-04-05', '2026-04-10', 2, 'business', 'round_trip')`\n   490→\n   491→  // Sample bookings\n   492→  const flightForBooking = await sql`SELECT id FROM flights WHERE flight_number = 'AA100' LIMIT 1`\n   493→  const bookingFlight = flightForBooking[0]\n   494→  if (bookingFlight) {\n   495→    await sql`INSERT INTO bookings (session_id, flight_id, booking_reference, cabin_class, total_price_cents, status)\n   496→      VALUES (${sessionId}, ${bookingFlight.id}, 'GF-ABC123', 'economy', 34385, 'confirmed')`\n   497→    const bookingRows = await sql`SELECT id FROM bookings WHERE booking_reference = 'GF-ABC123'`\n   498→    const booking = bookingRows[0]\n   499→    if (booking) {\n   500→      await sql`INSERT INTO booking_passengers (booking_id, first_name, last_name, date_of_birth, gender, email, phone, passenger_type)\n   501→        VALUES (${booking.id}, 'John', 'Doe', '1990-05-15', 'male', 'john@example.com', '+1234567890', 'adult')`\n   502→    }\n   503→  }\n   504→\n   505→  // Completed past booking\n   506→  const pastFlightRows = await sql`SELECT id FROM flights WHERE flight_number = 'DL950' LIMIT 1`\n   507→  const pastFlight = pastFlightRows[0]\n   508→  if (pastFlight) {\n   509→    await sql`INSERT INTO bookings (session_id, flight_id, booking_reference, cabin_class, total_price_cents, status)\n   510→      VALUES (${sessionId}, ${pastFlight.id}, 'GF-PAST01', 'economy', 28635, 'completed')`\n   511→  }\n   512→\n   513→  // Cancelled upcoming booking\n   514→  const cancelFlightRows = await sql`SELECT id FROM flights WHERE flight_number = 'DL200' LIMIT 1`\n   515→  const cancelFlight = cancelFlightRows[0]\n   516→  if (cancelFlight) {\n   517→    await sql`INSERT INTO bookings (session_id, flight_id, booking_reference, cabin_class, total_price_cents, status)\n   518→      VALUES (${sessionId}, ${cancelFlight.id}, 'GF-CANC01', 'economy', 32085, 'cancelled')`\n   519→  }\n   520→\n   521→  // Round-trip booking (LAX→JFK Mar 25, return JFK→LAX Mar 30)\n   522→  const sortFlight1Rows = await sql`SELECT id FROM flights WHERE flight_number = 'AA960' LIMIT 1`\n   523→  const returnFlight1Rows = await sql`SELECT id FROM flights WHERE flight_number = 'AA965' LIMIT 1`\n   524→  const sortFlight1 = sortFlight1Rows[0]\n   525→  const returnFlight1 = returnFlight1Rows[0]\n   526→  if (sortFlight1) {\n   527→    await sql`INSERT INTO bookings (session_id, flight_id, return_flight_id, booking_reference, cabin_class, total_price_cents, status)\n   528→      VALUES (${sessionId}, ${sortFlight1.id}, ${returnFlight1?.id || null}, 'GF-SORT01', 'economy', 33235, 'confirmed')`\n   529→  }\n   530→\n   531→  // Upcoming booking Mar 30\n   532→  const sortFlight2Rows = await sql`SELECT id FROM flights WHERE flight_number = 'DL960' LIMIT 1`\n   533→  const sortFlight2 = sortFlight2Rows[0]\n   534→  if (sortFlight2) {\n   535→    await sql`INSERT INTO bookings (session_id, flight_id, booking_reference, cabin_class, total_price_cents, status)\n   536→      VALUES (${sessionId}, ${sortFlight2.id}, 'GF-SORT02', 'economy', 30935, 'confirmed')`\n   537→  }\n   538→\n   539→  // Upcoming booking Apr 10\n   540→  const sortFlight3Rows = await sql`SELECT id FROM flights WHERE flight_number = 'UA970' LIMIT 1`\n   541→  const sortFlight3 = sortFlight3Rows[0]\n   542→  if (sortFlight3) {\n   543→    await sql`INSERT INTO bookings (session_id, flight_id, booking_reference, cabin_class, total_price_cents, status)\n   544→      VALUES (${sessionId}, ${sortFlight3.id}, 'GF-SORT03', 'economy', 35535, 'confirmed')`\n   545→  }\n   546→\n   547→  // One-way SFO→ORD Apr 5\n   548→  const oneWayFlightRows = await sql`SELECT id FROM flights WHERE flight_number = 'AA970' LIMIT 1`\n   549→  const oneWayFlight = oneWayFlightRows[0]\n   550→  if (oneWayFlight) {\n   551→    await sql`INSERT INTO bookings (session_id, flight_id, booking_reference, cabin_class, total_price_cents, status)\n   552→      VALUES (${sessionId}, ${oneWayFlight.id}, 'GF-ONEW01', 'economy', 20585, 'confirmed')`\n   553→  }\n   554→\n   555→  // Tracked routes\n   556→  const nrtId = airportMap.get('NRT')!\n   557→  const cdgId = airportMap.get('CDG')!\n   558→\n   559→  // LAX→LHR: lowest economy price is AA800 = $599 base → 68885 total cents\n   560→  // initial_price_cents = 61504 → trend = +12%\n   561→  await sql`INSERT INTO tracked_routes (session_id, origin_airport_id, destination_airport_id, departure_date_start, departure_date_end, cabin_class, initial_price_cents)\n   562→    VALUES (${sessionId}, ${laxId}, ${lhrId}, '2026-04-01', '2026-04-15', 'economy', 61504)`\n   563→\n   564→  // SFO→NRT: lowest economy price is UA800 = $749 base → 86135 total cents\n   565→  // initial_price_cents = 93625 → trend = -8%\n   566→  await sql`INSERT INTO tracked_routes (session_id, origin_airport_id, destination_airport_id, departure_date_start, departure_date_end, cabin_class, initial_price_cents)\n   567→    VALUES (${sessionId}, ${sfoId}, ${nrtId}, '2026-04-10', '2026-04-25', 'economy', 93625)`\n   568→\n   569→  // JFK→CDG: lowest economy price is AF100 = $499 base → 57385 total cents\n   570→  // initial_price_cents = 57385 → trend = 0% (no trend)\n   571→  await sql`INSERT INTO tracked_routes (session_id, origin_airport_id, destination_airport_id, departure_date_start, departure_date_end, cabin_class, initial_price_cents)\n   572→    VALUES (${sessionId}, ${jfkId}, ${cdgId}, '2026-05-01', '2026-05-15', 'economy', 57385)`\n   573→}\n   574→\n   575→// CLI entry point\n   576→const isMain = process.argv[1] && import.meta.url.endsWith(process.argv[1].replace(/\\\\/g, '/'))\n   577→if (isMain) {\n   578→  const dbUrl = process.argv[2]\n   579→  if (!dbUrl) {\n   580→    console.error('Usage: tsx scripts/seed-db.ts <DATABASE_URL>')\n   581→    process.exit(1)\n   582→  }\n   583→  truncateAndSeed(dbUrl).then(() => console.log('Seed complete')).catch(e => { console.error(e); process.exit(1) })\n   584→}\n   585→"}]},"parent_tool_use_id":"toolu_01ET7ubBPVRT5Hd1cLwWoagh","session_id":"e5d16018-2020-41b2-88f2-80c18c9d8446","uuid":"90e503ca-5b8b-4287-b677-2930f04c35ca"}
[2026-03-15T20:19:12.865Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013xgssLog2L1F4TBin9hVLg","type":"tool_result","content":"     1→# seed-db\n     2→\n     3→## Purpose\n     4→\n     5→Seeds the database with initial data. The seed script lives at `scripts/seed-db.ts` in each app.\n     6→\n     7→## Usage\n     8→\n     9→```bash\n    10→npx tsx scripts/seed-db.ts\n    11→```\n    12→\n    13→## Known Issues\n    14→\n    15→### Existing data causes failures\n    16→\n    17→The seed script may fail if data already exists in the database (e.g., duplicate key errors).\n    18→This happens when re-seeding after a previous run or when Neon branches inherit parent data.\n    19→\n    20→**Workaround**: Clear existing data before re-seeding:\n    21→\n    22→```sql\n    23→-- Run via npx tsx -e or a cleanup script\n    24→TRUNCATE table1, table2, table3 CASCADE;\n    25→```\n    26→\n    27→Then re-run the seed script.\n    28→\n    29→### Best practice\n    30→\n    31→Seed scripts should always call `truncateAllTables()` (or equivalent) before inserting data\n    32→to ensure idempotency. If the app's seed script does not do this, consider adding a\n    33→`--clean` or `--force` flag that truncates all tables before seeding.\n    34→\n    35→### Pre-test re-seeding\n    36→\n    37→Always re-seed the database before running test suites to ensure a clean, known state. The\n    38→test script (`npm run test`) handles this automatically via ephemeral Neon branches with\n    39→truncate-and-seed between each test. If running tests manually or debugging, re-seed\n    40→explicitly:\n    41→\n    42→```bash\n    43→npx tsx scripts/seed-db.ts\n    44→```\n    45→\n    46→This eliminates the #2 source of test failures (data contamination from accumulated state).\n    47→\n    48→### When to use `scripts/seed-db.ts` vs `/api/seed`\n    49→\n    50→- **`npx tsx scripts/seed-db.ts`**: Use for initial database setup, manual re-seeding before\n    51→  test runs, and when the dev server is not running. Runs directly against the database.\n    52→- **`POST /api/seed` endpoint**: Use inside test `beforeEach`/`beforeAll` hooks to reset\n    53→  state between tests while the dev server is running. This is the preferred approach for\n    54→  in-test reseeding because it uses the same database connection as the running server and\n    55→  avoids connection conflicts. Many test failures trace back to stale seed data — using the\n    56→  `/api/seed` endpoint in `beforeEach` hooks is the most effective mitigation.\n    57→"}]},"parent_tool_use_id":"toolu_01ET7ubBPVRT5Hd1cLwWoagh","session_id":"e5d16018-2020-41b2-88f2-80c18c9d8446","uuid":"f1578306-b8e5-4e25-9a86-44bad0318457"}
