 50→      leg_order INTEGER NOT NULL,\n    51→      origin_airport_id UUID REFERENCES airports(id),\n    52→      destination_airport_id UUID REFERENCES airports(id),\n    53→      departure_time TIMESTAMP NOT NULL,\n    54→      arrival_time TIMESTAMP NOT NULL,\n    55→      duration_minutes INTEGER NOT NULL,\n    56→      airline_id UUID REFERENCES airlines(id),\n    57→      flight_number TEXT,\n    58→      aircraft_type TEXT,\n    59→      terminal_departure TEXT,\n    60→      terminal_arrival TEXT\n    61→    )\n    62→  `\n    63→\n    64→  await sql`\n    65→    CREATE TABLE IF NOT EXISTS prices (\n    66→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    67→      flight_id UUID REFERENCES flights(id) ON DELETE CASCADE,\n    68→      cabin_class TEXT NOT NULL,\n    69→      base_price_cents INTEGER NOT NULL,\n    70→      taxes_cents INTEGER NOT NULL,\n    71→      total_price_cents INTEGER NOT NULL,\n    72→      available_seats INTEGER,\n    73→      created_at TIMESTAMP DEFAULT now()\n    74→    )\n    75→  `\n    76→\n    77→  await sql`\n    78→    CREATE TABLE IF NOT EXISTS sessions (\n    79→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    80→      session_token TEXT UNIQUE NOT NULL,\n    81→      created_at TIMESTAMP DEFAULT now()\n    82→    )\n    83→  `\n    84→\n    85→  await sql`\n    86→    CREATE TABLE IF NOT EXISTS recent_searches (\n    87→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    88→      session_id UUID REFERENCES sessions(id) ON DELETE CASCADE,\n    89→      origin_airport_id UUID REFERENCES airports(id),\n    90→      destination_airport_id UUID REFERENCES airports(id),\n    91→      departure_date DATE NOT NULL,\n    92→      return_date DATE,\n    93→      passengers_adults INTEGER DEFAULT 1,\n    94→      passengers_children INTEGER DEFAULT 0,\n    95→      passengers_infants INTEGER DEFAULT 0,\n    96→      cabin_class TEXT DEFAULT 'economy',\n    97→      trip_type TEXT DEFAULT 'round_trip',\n    98