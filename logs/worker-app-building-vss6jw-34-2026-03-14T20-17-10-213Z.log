testid^=\"property-card-\"]').first()).toBeVisible({ timeout: 30000 })\n    33→\n    34→    await page.getByTestId('search-checkin').fill('2026-04-01')\n    35→    await page.getByTestId('search-checkout').fill('2026-04-05')\n    36→    await page.getByTestId('search-button').click()\n    37→\n    38→    // Miami Villa has a confirmed booking Apr 1-7, so it should be excluded (4 of 5 remain)\n    39→    const cards = page.locator('[data-testid^=\"property-card-\"]')\n    40→    await expect(cards).toHaveCount(4, { timeout: 15000 })\n    41→  })\n    42→\n    43→  test('Search by guest count filters results', async ({ page }) => {\n    44→    await page.goto('/')\n    45→    await expect(page.locator('[data-testid^=\"property-card-\"]').first()).toBeVisible({ timeout: 30000 })\n    46→\n    47→    await page.getByTestId('search-guests').fill('5')\n    48→    await page.getByTestId('search-button').click()\n    49→\n    50→    // Properties with max_guests >= 5: Cabin (6), Villa (8), Townhouse (6) = 3\n    51→    const cards = page.locator('[data-testid^=\"property-card-\"]')\n    52→    await expect(cards).toHaveCount(3, { timeout: 15000 })\n    53→  })\n    54→\n    55→  test('Combined search with all fields filters results', async ({ page }) => {\n    56→    await page.goto('/')\n    57→    await expect(page.locator('[data-testid^=\"property-card-\"]').first()).toBeVisible({ timeout: 30000 })\n    58→\n    59→    await page.getByTestId('search-location').fill('New York')\n    60→    await page.getByTestId('search-checkin').fill('2026-05-10')\n    61→    await page.getByTestId('search-checkout').fill('2026-05-15')\n    62→    await page.getByTestId('search-guests').fill('3')\n    63→    await page.getByTestId('search-button').click()\n    64→\n    65→    // Only NY Loft matches: in New York, max_guests 4 >= 3, no conflicting bookings\n    66→    const cards = page.locator('[data-testid^=\"property-card-\"]')\n    67→    await expect(cards).toHaveCount(1, { timeout: 15000 })\n    68→    await expect(page.getByTestId('property-grid')).toContainText('New York')\n    69→  })\n    70→\n    71→  test('Clearing search fields and re-searching shows all results', async ({ page }) => {\n    72→    await page.goto('/')\n    73→    await expect(page.locator('[data-testid^=\"property-card-\"]').first()).toBeVisible({ timeout: 30000 })\n    74→\n    75→    const cards = page.locator('[data-testid^=\"property-card-\"]')\n    76→\n    77→    // Search by location\n    78→    await page.getByTestId('search-location').fill('New York')\n    79→    await page.getByTestId('search-button').click()\n    80→    await expect(cards).toHaveCount(1, { timeout: 15000 })\n    81→\n    82→    // Clear and re-search\n    83→    await page.getByTestId('search-location').fill('')\n    84→    await page.getByTestId('search-button').click()\n    85→    await expect(cards).toHaveCount(5, { timeout: 15000 })\n    86→  })\n    87→\n    88→  test('Search bar is functional on repeated use', async ({ page }) => {\n    89→    test.slow()\n    90→    await page.goto('/')\n    91→    await expect(page.locator('[data-testid^=\"property-card-\"]').first()).toBeVisible({ timeout: 30000 })\n    92→\n    93→    const cards = page.locator('[data-testid^=\"property-card-\"]')\n    94→\n    95→    // First search: New York\n    96→    await page.getByTestId('search-location').fill('New York')\n    97→    await page.getByTestId('search-button').click()\n    98→    await expect(cards).toHaveCount(1, { timeout: 15000 })\n    99→    await expect(page.getByTestId('property-grid')).toContainText('New York')\n   100→\n   101→    // Second search: Austin\n   102→    await page.getByTestId('search-location').fill('')\n   103→    await page.getByTestId('search-location').fill('Austin')\n   104→    await page.getByTestId('search-button').click()\n   105→    await expect(cards).toHaveCount(1, { timeout: 15000 })\n   106→    await expect(page.getByTestId('property-grid')).toContainText('Austin')\n   107→    await expect(page.getByTestId('search-location')).toHaveValue('Austin')\n   108→  })\n   109→\n   110→  test('Check-in date picker prevents selecting past dates', async ({ page }) => {\n   111→    await page.goto('/')\n   112→    await expect(page.getByTestId('search-bar')).toBeVisible({ timeout: 30000 })\n   113→\n   114→    const today = new Date().toISOString().split('T')[0]\n   115→    await expect(page.getByTestId('search-checkin')).toHaveAttribute('min', today)\n   116→  })\n   117→\n   118→  test('Check-out date must be after check-in date', async ({ page }) => {\n   119→    await page.goto('/')\n   120→    await expect(page.getByTestId('search-bar')).toBeVisible({ timeout: 30000 })\n   121→\n   122→    await page.getByTestId('search-checkin').fill('2026-04-10')\n   123→\n   124→    // Checkout min should be the day after check-in\n   125→    await expect(page.getByTestId('search-checkout')).toHaveAttribute('min', '2026-04-11')\n   126→  })\n   127→\n   128→  test('Guest count selector enforces minimum of 1', async ({ page }) => {\n   129→    await page.goto('/')\n   130→    await expect(page.getByTestId('search-bar')).toBeVisible({ timeout: 30000 })\n   131→\n   132→    await expect(page.getByTestId('search-guests')).toHaveAttribute('min', '1')\n   133→\n   134→    // Attempt to set guests to 0 - should be corrected to 1\n   135→    await page.getByTestId('search-guests').fill('0')\n   136→    await expect(page.getByTestId('search-guests')).toHaveValue('1')\n   137→  })\n   138→})\n   139→"}]},"parent_tool_use_id":"toolu_01LUYg3bMdL4CawSyZudhxoM","session_id":"f8a296dd-7f46-4539-abd0-0e7f77f9cd8b","uuid":"7aa96b08-9d78-453d-a269-e71fa8c4c411"}
