[2026-03-14T19:13:26.419Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KWo7Sadiism51TQJR5QzpK","type":"tool_result","content":"     1→import { useState, useRef, useEffect } from 'react'\n     2→import { useDispatch, useSelector } from 'react-redux'\n     3→import { setPassengers } from '../slices/searchSlice'\n     4→import type { RootState } from '../store'\n     5→import './PassengerCountSelector.css'\n     6→\n     7→function PassengerCountSelector() {\n     8→  const dispatch = useDispatch()\n     9→  const passengers = useSelector((state: RootState) => state.search.passengers)\n    10→  const [isOpen, setIsOpen] = useState(false)\n    11→  const ref = useRef<HTMLDivElement>(null)\n    12→\n    13→  useEffect(() => {\n    14→    function handleClickOutside(e: MouseEvent) {\n    15→      if (ref.current && !ref.current.contains(e.target as Node)) {\n    16→        setIsOpen(false)\n    17→      }\n    18→    }\n    19→    if (isOpen) {\n    20→      document.addEventListener('mousedown', handleClickOutside)\n    21→      return () => document.removeEventListener('mousedown', handleClickOutside)\n    22→    }\n    23→  }, [isOpen])\n    24→\n    25→  const total = passengers.adults + passengers.children + passengers.infants\n    26→  const label = total === 1 ? '1 Adult' : `${total} passengers`\n    27→\n    28→  function updatePassengers(field: 'adults' | 'children' | 'infants', delta: number) {\n    29→    const newVal = passengers[field] + delta\n    30→    if (field === 'adults' && newVal < 1) return\n    31→    if (field !== 'adults' && newVal < 0) return\n    32→    if (field === 'infants' && newVal > passengers.adults) return\n    33→\n    34→    const updated = { ...passengers, [field]: newVal }\n    35→    // If adults decrease below infants, cap infants\n    36→    if (field === 'adults' && updated.infants > updated.adults) {\n    37→      updated.infants = updated.adults\n    38→    }\n    39→    dispatch(setPassengers(updated))\n    40→  }\n    41→\n    42→  return (\n    43→    <div className=\"passenger-selector\" ref={ref} data-testid=\"passenger-count-selector\">\n    44→      <button\n    45→        className=\"passenger-selector__trigger\"\n    46→        onClick={() => setIsOpen(!isOpen)}\n    47→        data-testid=\"passenger-count-trigger\"\n    48→      >\n    49→        <span className=\"passenger-selector__icon\">👤</span>\n    50→        <span>{label}</span>\n    51→        <span className=\"passenger-selector__arrow\">{isOpen ? '▲' : '▼'}</span>\n    52→      </button>\n    53→      {isOpen && (\n    54→        <div className=\"passenger-selector__dropdown\" data-testid=\"passenger-count-dropdown\">\n    55→          <div className=\"passenger-selector__row\" data-testid=\"passenger-row-adults\">\n    56→            <div className=\"passenger-selector__info\">\n    57→              <span className=\"passenger-selector__category\">Adults</span>\n    58→            </div>\n    59→            <div className=\"passenger-selector__controls\">\n    60→              <button\n    61→                className=\"passenger-selector__btn\"\n    62→                onClick={() => updatePassengers('adults', -1)}\n    63→                disabled={passengers.adults <= 1}\n    64→                data-testid=\"adults-decrement\"\n    65→              >\n    66→                −\n    67→              </button>\n    68→              <span className=\"passenger-selector__count\" data-testid=\"adults-count\">{passengers.adults}</span>\n    69→              <button\n    70→                className=\"passenger-selector__btn\"\n    71→                onClick={() => updatePassengers('adults', 1)}\n    72→                data-testid=\"adults-increment\"\n    73→              >\n    74→                +\n    75→              </button>\n    76→            </div>\n    77→          </div>\n    78→          <div className=\"passenger-selector__row\" data-testid=\"passenger-row-children\">\n    79→            <div className=\"passenger-selector__info\">\n    80→              <span className=\"passenger-selector__category\">Children</span>\n    81→              <span className=\"passenger-selector__age\">2-11</span>\n    82→            </div>\n    83→            <div className=\"passenger-selector__controls\">\n    84→              <button\n    85→                className=\"passenger-selector__btn\"\n    86→                onClick={() => updatePassengers('children', -1)}\n    87→                disabled={passengers.children <= 0}\n    88→                data-testid=\"children-decrement\"\n    89→              >\n    90→                −\n    91→              </button>\n    92→              <span className=\"passenger-selector__count\" data-testid=\"children-count\">{passengers.children}</span>\n    93→              <button\n    94→                className=\"passenger-selector__btn\"\n    95→                onClick={() => updatePassengers('children', 1)}\n    96→                data-testid=\"children-increment\"\n    97→              >\n    98→                +\n    99→              </button>\n   100→            </div>\n   101→          </div>\n   102→          <div className=\"passenger-selector__row\" data-testid=\"passenger-row-infants\">\n   103→            <div className=\"passenger-selector__info\">\n   104→              <span className=\"passenger-selector__category\">Infants</span>\n   105→              <span className=\"passenger-selector__age\">Under 2</span>\n   106→            </div>\n   107→            <div className=\"passenger-selector__controls\">\n   108→              <button\n   109→                className=\"passenger-selector__btn\"\n   110→                onClick={() => updatePassengers('infants', -1)}\n   111→                disabled={passengers.infants <= 0}\n   112→                data-testid=\"infants-decrement\"\n   113→              >\n   114→                −\n   115→              </button>\n   116→              <span className=\"passenger-selector__count\" data-testid=\"infants-count\">{passengers.infants}</span>\n   117→              <button\n   118→                className=\"passenger-selector__btn\"\n   119→                onClick={() => updatePassengers('infants', 1)}\n   120→                disabled={passengers.infants >= passengers.adults}\n   121→                data-testid=\"infants-increment\"\n   122→              >\n   123→                +\n   124→              </button>\n   125→            </div>\n   126→          </div>\n   127→        </div>\n   128→      )}\n   129→    </div>\n   130→  )\n   131→}\n   132→\n   133→export default PassengerCountSelector\n   134→"}]},"parent_tool_use_id":"toolu_0186sxMZPWsay4mkKM4wuB2j","session_id":"ac34eca8-511a-4c72-851b-3745b8c8cd54","uuid":"9ccf8550-9b02-49ae-94d6-6b9e8ca4f5b0"}
