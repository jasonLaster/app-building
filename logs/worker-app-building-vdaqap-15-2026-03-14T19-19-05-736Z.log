ng: false,\n    59→  trackedLoading: false,\n    60→  error: null,\n    61→  activeTab: 'upcoming',\n    62→  cancellingBookingId: null,\n    63→  cancelError: null,\n    64→  untrackingRouteId: null,\n    65→}\n    66→\n    67→export const fetchMyBookings = createAsyncThunk(\n    68→  'trips/fetchMyBookings',\n    69→  async (sessionToken: string) => {\n    70→    const res = await fetch(`/api/my-bookings?session=${encodeURIComponent(sessionToken)}`)\n    71→    if (!res.ok) throw new Error('Failed to fetch bookings')\n    72→    return res.json() as Promise<BookingTrip[]>\n    73→  }\n    74→)\n    75→\n    76→export const fetchTrackedRoutes = createAsyncThunk(\n    77→  'trips/fetchTrackedRoutes',\n    78→  async (sessionToken: string) => {\n    79→    const res = await fetch(`/api/tracked-routes?session=${encodeURIComponent(sessionToken)}`)\n    80→    if (!res.ok) throw new Error('Failed to fetch tracked routes')\n    81→    return res.json() as Promise<TrackedRoute[]>\n    82→  }\n    83→)\n    84→\n    85→export const cancelBooking = createAsyncThunk(\n    86→  'trips/cancelBooking',\n    87→  async (params: { bookingId: string; sessionToken: string }) => {\n    88→    const res = await fetch('/api/my-bookings', {\n    89→      method: 'PATCH',\n    90→      headers: { 'Content-Type': 'application/json' },\n    91→      body: JSON.stringify({\n    92→        bookingId: params.bookingId,\n    93→        sessionToken: params.sessionToken,\n    94→        status: 'cancelled',\n    95→      }),\n    96→    })\n    97→    if (!res.ok) throw new Error('Failed to cancel booking')\n    98→    return params.bookingId\n    99→  }\n   100→)\n   101→\n   102→export const untrackRoute = createAsyncThunk(\n   103→  'trips/untrackRoute',\n   104→  async (params: { routeId: string; sessionToken: string }) => {\n   105→    const res = await fetch('/api/tracked-routes', {\n   106→      method: 'DELETE',\n   107→      headers: { 'Content-Type': 'application/json' },\n   108→      body: JSON.stringify({\n   109→        sessionToken: params.sessionToken,\n   110→        id: params.routeId,\n   111→      }),\n   112→    })\n   113→    if (!res.ok) throw new Error('Failed to untrack route')\n   114→    return params.routeId\n   115→  }\n   116→)\n   117→\n   118→const tripsSlice = createSlice({\n   119→  name: 'trips',\n   120→  initialState,\n   121→  reducers: {\n   122→    setActiveTab(state, action: PayloadAction<TripsTab>) {\n   123→      state.activeTab = action.payload\n   124→    },\n   125→    clearCancelError(state) {\n   126→      state.cancelError = null\n   127→    },\n   128→  },\n   129→  extraReducers: (builder) => {\n   130→    builder\n   131→      .addCase(fetchMyBookings.pending, (state) => {\n   132→        if (state.bookings.length === 0) {\n   133→          state.loading = true\n   134→        }\n   135→        state.error = null\n   136→      })\n   137→      .addCase(fetchMyBookings.fulfilled, (state, action) => {\n   138→        state.bookings = action.payload\n   139→        state.loading = false\n   140→      })\n   141→      .addCase(fetchMyBookings.rejected, (state, action) => {\n   142→        state.loading = false\n   143→        state.error = action.error.message || 'Failed to load bookings'\n   144→      })\n   145→      .addCase(fetchTrackedRoutes.pending, (state) => {\n   146→        if (state.trackedRoutes.length === 0) {\n   147→          state.trackedLoading = true\n   148→        }\n   149→      })\n   150→      .addCase(fetchTrackedRoutes.fulfilled, (state, action) => {\n   151→        state.trackedRoutes = action.payload\n   152→        state.trackedLoading = false\n   153→      })\n   154→      .addCase(fetchTrackedRoutes.rejected, (state) => {\n   155→        state.trackedLoading = false\n   156→      })\n   157→      .addCase(cancelBooking.pending, (state, action) => {\n   158→        state.cancellingBookingId = action.meta.arg.bookingId\n   159→        state.cancelError = null\n   160→      })\n   161→      .addCase(cancelBooking.fulfilled, (state, action) => {\n   162→        state.cancellingBookingId = null\n   163→        const booking = state.bookings.find(b => b.id === action.payload)\n   164→        if (booking) {\n   165→          booking.status = 'cancelled'\n   166→        }\n   167→      })\n   168→      .addCase(cancelBooking.rejected, (state, action) => {\n   169→        state.cancellingBookingId = null\n   170→        state.cancelError = action.error.message || 'Failed to cancel booking. Please try again.'\n   171→      })\n   172→      .addCase(untrackRoute.pending, (state, action) => {\n   173→        state.untrackingRouteId = action.meta.arg.routeId\n   174→      })\n   175→      .addCase(untrackRoute.fulfilled, (state, action) => {\n   176→        state.untrackingRouteId = null\n   177→        state.trackedRoutes = state.trackedRoutes.filter(r => r.id !== action.payload)\n   178→      })\n   179→      .addCase(untrackRoute.rejected, (state) => {\n   180→        state.untrackingRouteId = null\n   181→      })\n   182→  },\n   183→})\n   184→\n   185→export const { setActiveTab, clearCancelError } = tripsSlice.actions\n   186→export default tripsSlice.reducer\n   187→"}]},"parent_tool_use_id":"toolu_0186sxMZPWsay4mkKM4wuB2j","session_id":"ac34eca8-511a-4c72-851b-3745b8c8cd54","uuid":"f40e13fb-3569-4e25-a1f8-f6024daf9c67"}
