t--moderate {\n  background: var(--color-warning);\n}\n\n.flexible-dates-grid__legend-dot--expensive {\n  background: var(--color-error);\n}\n\n.flexible-dates-grid__grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));\n  gap: 8px;\n}\n\n.flexible-dates-grid__cell {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 2px;\n  padding: 12px 8px;\n  border-radius: var(--radius-sm);\n  border: 1px solid var(--color-border-light);\n  cursor: pointer;\n  transition: transform 0.15s, box-shadow 0.15s;\n  text-align: center;\n}\n\n.flexible-dates-grid__cell:hover:not(:disabled) {\n  transform: translateY(-1px);\n  box-shadow: 0 2px 8px var(--color-shadow);\n}\n\n.flexible-dates-grid__cell:disabled {\n  cursor: default;\n  opacity: 0.5;\n}\n\n.flexible-dates-grid__cell--cheap {\n  background: #E6F4EA;\n  border-color: #CEEAD6;\n}\n\n.flexible-dates-grid__cell--moderate {\n  background: #FEF7E0;\n  border-color: #FEEFC3;\n}\n\n.flexible-dates-grid__cell--expensive {\n  background: #FCE8E6;\n  border-color: #F5C6C2;\n}\n\n.flexible-dates-grid__cell--none {\n  background: var(--color-background);\n  border-color: var(--color-border-light);\n}\n\n.flexible-dates-grid__cell-day {\n  font-size: 11px;\n  font-weight: 500;\n  color: var(--color-text-tertiary);\n  text-transform: uppercase;\n}\n\n.flexible-dates-grid__cell-date {\n  font-size: 12px;\n  color: var(--color-text-secondary);\n}\n\n.flexible-dates-grid__cell-price {\n  font-size: 14px;\n  font-weight: 600;\n  color: var(--color-text-primary);\n  margin-top: 2px;\n}\n\n.flexible-dates-grid__loading {\n  padding: 16px 0;\n}\n\n.flexible-dates-grid__skeleton-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));\n  gap: 8px;\n}\n\n.flexible-dates-grid__skeleton-cell {\n  height: 72px;\n  border-radius: var(--radius-sm);\n  background: var(--color-border-light);\n  animation: dates-pulse 1.5s infinite;\n}\n\n@keyframes dates-pulse