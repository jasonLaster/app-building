tokens":1,"cache_creation_input_tokens":363,"cache_read_input_tokens":51261,"cache_creation":{"ephemeral_5m_input_tokens":363,"ephemeral_1h_input_tokens":0},"output_tokens":24,"service_tier":"standard","inference_geo":"global"},"context_management":null},"parent_tool_use_id":null,"session_id":"ac34eca8-511a-4c72-851b-3745b8c8cd54","uuid":"1892e934-2597-4580-8a15-292db3292723"}
