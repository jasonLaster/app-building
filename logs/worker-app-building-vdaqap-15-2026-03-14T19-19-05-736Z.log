[2026-03-14T19:13:08.067Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FnTrWznBoZmpzi7UjTdknR","type":"tool_result","content":"     1→import { createSlice, createAsyncThunk, type PayloadAction } from '@reduxjs/toolkit'\n     2→import type { FlightLeg } from './flightsSlice'\n     3→\n     4→export interface PassengerInfo {\n     5→  firstName: string\n     6→  lastName: string\n     7→  dateOfBirth: string\n     8→  gender: string\n     9→  email: string\n    10→  phone: string\n    11→  passengerType: 'adult' | 'child' | 'infant'\n    12→}\n    13→\n    14→export interface BookingFlightDetail {\n    15→  id: string\n    16→  flight_number: string\n    17→  departure_time: string\n    18→  arrival_time: string\n    19→  duration_minutes: number\n    20→  aircraft_type: string\n    21→  has_wifi: boolean\n    22→  has_power: boolean\n    23→  has_entertainment: boolean\n    24→  co2_kg: number\n    25→  airline_name: string\n    26→  airline_code: string\n    27→  logo_color: string\n    28→  origin_code: string\n    29→  origin_name: string\n    30→  origin_city: string\n    31→  dest_code: string\n    32→  dest_name: string\n    33→  dest_city: string\n    34→  base_price_cents: number\n    35→  taxes_cents: number\n    36→  total_price_cents: number\n    37→  cabin_class: string\n    38→  available_seats: number\n    39→}\n    40→\n    41→interface BookingState {\n    42→  flight: BookingFlightDetail | null\n    43→  legs: FlightLeg[]\n    44→  loading: boolean\n    45→  error: string | null\n    46→  passengers: PassengerInfo[]\n    47→  validationErrors: Record<string, string>\n    48→  bookingInProgress: boolean\n    49→  bookingComplete: boolean\n    50→  bookingReference: string | null\n    51→  bookingError: string | null\n    52→}\n    53→\n    54→const initialState: BookingState = {\n    55→  flight: null,\n    56→  legs: [],\n    57→  loading: false,\n    58→  error: null,\n    59→  passengers: [],\n    60→  validationErrors: {},\n    61→  bookingInProgress: false,\n    62→  bookingComplete: false,\n    63→  bookingReference: null,\n    64→  bookingError: null,\n    65→}\n    66→\n    67→export const fetchFlightForBooking = createAsyncThunk(\n    68→  'booking/fetchFlightForBooking',\n    69→  async (params: { flightId: string; cabinClass: string }) => {\n    70→    const qs = new URLSearchParams({\n    71→      flightId: params.flightId,\n    72→      cabinClass: params.cabinClass,\n    73→    })\n    74→    const res = await fetch(`/api/bookings?${qs}`)\n    75→    if (!res.ok) {\n    76→      throw new Error('Failed to fetch flight details')\n    77→    }\n    78→    return res.json() as Promise<{ flight: BookingFlightDetail; legs: FlightLeg[] }>\n    79→  }\n    80→)\n    81→\n    82→export const createBooking = createAsyncThunk(\n    83→  'booking/createBooking',\n    84→  async (params: {\n    85→    sessionToken: string\n    86→    flightId: string\n    87→    returnFlightId?: string\n    88→    cabinClass: string\n    89→    totalPriceCents: number\n    90→    passengers: Array<{\n    91→      firstName: string\n    92→      lastName: string\n    93→      dateOfBirth: string\n    94→      gender: string\n    95→      email?: string\n    96→      phone?: string\n    97→      passengerType: string\n    98→    }>\n    99→  }) => {\n   100→    const res = await fetch('/api/bookings', {\n   101→      method: 'POST',\n   102→      headers: { 'Content-Type': 'application/json' },\n   103→      body: JSON.stringify(params),\n   104→    })\n   105→    if (!res.ok) {\n   106→      throw new Error('Booking failed. Please try again.')\n   107→    }\n   108→    return res.json() as Promise<{\n   109→      id: string\n   110→      bookingReference: string\n   111→      status: string\n   112→      createdAt: string\n   113→    }>\n   114→  }\n   115→)\n   116→\n   117→const bookingSlice = createSlice({\n   118→  name: 'booking',\n   119→  initialState,\n   120→  reducers: {\n   121→    initializePassengers(state, action: PayloadAction<{ adults: number; children: number; infants: number }>) {\n   122→      const passengers: PassengerInfo[] = []\n   123→      for (let i = 0; i < action.payload.adults; i++) {\n   124→        passengers.push({\n   125→          firstName: '', lastName: '', dateOfBirth: '', gender: '',\n   126→          email: '', phone: '', passengerType: 'adult',\n   127→        })\n   128→      }\n   129→      for (let i = 0; i < action.payload.children; i++) {\n   130→        passengers.push({\n   131→          firstName: '', lastName: '', dateOfBirth: '', gender: '',\n   132→          email: '', phone: '', passengerType: 'child',\n   133→        })\n   134→      }\n   135→      for (let i = 0; i < action.payload.infants; i++) {\n   136→        passengers.push({\n   137→          firstName: '', lastName: '', dateOfBirth: '', gender: '',\n   138→          email: '', phone: '', passengerType: 'infant',\n   139→        })\n   140→      }\n   141→      state.passengers = passengers\n   142→      state.validationErrors = {}\n   143→      state.bookingComplete = false\n   144→      state.bookingReference = null\n   145→      state.bookingError = null\n   146→    },\n   147→    updatePassenger(state, action: PayloadAction<{ index: number; field: keyof PassengerInfo; value: string }>) {\n   148→      const p = state.passengers[action.payload.index]\n   149→      if (p) {\n   150→        ;(p[action.payload.field] as string) = action.payload.value\n   151→      }\n   152→      // Clear validation error for this field\n   153→      delete state.validationErrors[`${action.payload.index}-${action.payload.field}`]\n   154→    },\n   155→    setValidationErrors(state, action: PayloadAction<Record<string, string>>) {\n   156→      state.validationErrors = action.payload\n   157→    },\n   158→    resetBooking(state) {\n   159→      state.flight = null\n   160→      state.legs = []\n   161→      state.loading = false\n   162→      state.error = null\n   163→      state.passengers = []\n   164→      state.validationErrors = {}\n   165→      state.bookingInProgress = false\n   166→      state.bookingComplete = false\n   167→      state.bookingReference = null\n   168→      state.bookingError = null\n   169→    },\n   170→  },\n   171→  extraReducers: (builder) => {\n   172→    builder\n   173→      .addCase(fetchFlightForBooking.pending, (state) => {\n   174→        state.loading = true\n   175→        state.error = null\n   176→      })\n   177→      .addCase(fetchFlightForBooking.fulfilled, (state, action) => {\n   178→        state.flight = action.payload.flight\n   179→        state.legs = action.payload.legs\n   180→        state.loading = false\n   181→      })\n   182→      .addCase(fetchFlightForBooking.rejected, (state, action) => {\n   183→        state.loading = false\n   184→        state.error = action.error.message || 'Failed to load flight details'\n   185→      })\n   186→      .addCase(createBooking.pending, (state) => {\n   187→        state.bookingInProgress = true\n   188→        state.bookingError = null\n   189→      })\n   190→      .addCase(createBooking.fulfilled, (state, action) => {\n   191→        state.bookingInProgress = false\n   192→        state.bookingComplete = true\n   193→        state.bookingReference = action.payload.bookingReference\n   194→      })\n   195→      .addCase(createBooking.rejected, (state, action) => {\n   196→        state.bookingInProgress = false\n   197→        state.bookingError = action.error.message || 'Booking failed. Please try again.'\n   198→      })\n   199→  },\n   200→})\n   201→\n   202→export const {\n   203→  initializePassengers,\n   204→  updatePassenger,\n   205→  setValidationErrors,\n   206→  resetBooking,\n   207→} = bookingSlice.actions\n   208→\n   209→export default bookingSlice.reducer\n   210→"}]},"parent_tool_use_id":"toolu_0186sxMZPWsay4mkKM4wuB2j","session_id":"ac34eca8-511a-4c72-851b-3745b8c8cd54","uuid":"8473d5a4-cfde-4a45-827e-1c