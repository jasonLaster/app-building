eals.rejected, (state) => {\n        state.dealsLoading = false\n      })\n  },\n})\n\nexport const { setExploreOrigin, setDateRange } = exploreSlice.actions\nexport default exploreSlice.reducer\n","structuredPatch":[],"originalFile":null}}
