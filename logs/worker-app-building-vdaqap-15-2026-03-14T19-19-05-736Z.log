eg.origin_name} ({leg.origin_code})\n   208→              {leg.terminal_departure && (\n   209→                <span className=\"flight-summary__terminal\" data-testid={`flight-summary-dep-terminal-${leg.leg_order}`}>\n   210→                  {' '}· Terminal {leg.terminal_departure}\n   211→                </span>\n   212→              )}\n   213→            </span>\n   214→          </div>\n   215→        </div>\n   216→\n   217→        <div className=\"flight-summary__timeline-line\">\n   218→          <span className=\"flight-summary__leg-duration\">{formatDuration(leg.duration_minutes)}</span>\n   219→        </div>\n   220→\n   221→        <div className=\"flight-summary__timeline-row\">\n   222→          <div className=\"flight-summary__timeline-dot\" />\n   223→          <div className=\"flight-summary__timeline-content\">\n   224→            <span className=\"flight-summary__leg-time\" data-testid={`flight-summary-arr-time-${leg.leg_order}`}>\n   225→              {formatTime(leg.arrival_time)}\n   226→              {legDayDiff > 0 && (\n   227→                <span className=\"flight-summary__day-indicator\" data-testid={`flight-summary-day-${leg.leg_order}`}>\n   228→                  +{legDayDiff}\n   229→                </span>\n   230→              )}\n   231→            </span>\n   232→            <span className=\"flight-summary__leg-airport\">\n   233→              {leg.dest_name} ({leg.dest_code})\n   234→              {leg.terminal_arrival && (\n   235→                <span className=\"flight-summary__terminal\" data-testid={`flight-summary-arr-terminal-${leg.leg_order}`}>\n   236→                  {' '}· Terminal {leg.terminal_arrival}\n   237→                </span>\n   238→              )}\n   239→            </span>\n   240→          </div>\n   241→        </div>\n   242→      </div>\n   243→    </div>\n   244→  )\n   245→}\n   246→\n   247→export default FlightSummary\n   248→"}]},"parent_tool_use_id":"toolu_0186sxMZPWsay4mkKM4wuB2j","session