s, 2 checked bags included'\n    44→}\n    45→\n    46→function formatLayover(prevLeg: FlightLeg, nextLeg: FlightLeg): string {\n    47→  const prevArr = new Date(prevLeg.arrival_time).getTime()\n    48→  const nextDep = new Date(nextLeg.departure_time).getTime()\n    49→  const diffMinutes = Math.round((nextDep - prevArr) / (1000 * 60))\n    50→  return formatDuration(diffMinutes)\n    51→}\n    52→\n    53→function FlightSummary({ flight, legs, label }: FlightSummaryProps) {\n    54→  const effectiveLegs = legs.length > 0 ? legs : null\n    55→  const numLegs = effectiveLegs ? effectiveLegs.length : 1\n    56→  const dayDiff = getDayDiff(flight.departure_time, flight.arrival_time)\n    57→\n    58→  return (\n    59→    <div className=\"flight-summary\" data-testid=\"flight-summary\">\n    60→      {label && (\n    61→        <div className=\"flight-summary__label\" data-testid=\"flight-summary-label\">\n    62→          {label}\n    63→        </div>\n    64→      )}\n    65→\n    66→      <div className=\"flight-summary__header\" data-testid=\"flight-summary-header\">\n    67→        <div className=\"flight-summary__route\">\n    68→          <span className=\"flight-summary__route-code\">{flight.origin_code}</span>\n    69→          <span className=\"flight-summary__route-arrow\">→</span>\n    70→          <span className=\"flight-summary__route-code\">{flight.dest_code}</span>\n    71→        </div>\n    72→        <div className=\"flight-summary__meta\">\n    73→          <span data-testid=\"flight-summary-duration\">{formatDuration(flight.duration_minutes)}</span>\n    74→          <span className=\"flight-summary__meta-sep\">·</span>\n    75→          <span data-testid=\"flight-summary-stops\">{getStopsLabel(numLegs)}</span>\n    76→        </div>\n    77→      </div>\n    78→\n    79→      <div className=\"flight-summary__legs\" data-testid=\"flight-summary-legs\">\n    80→        {effectiveLegs ? (\n    81→          effectiveLegs.map((leg, index) => {\n    82→            const prevLeg = index > 0 ? effectiveLegs[index - 1] : undefined\n    83→            return (\n    84→              <div key={leg.id}>\n    85→                {index > 0 && prevLeg && (\n    86→                  <div className=\"flight-summary__layover\" data-testid={`flight-summary-layover-${index}`}>\n    87→                    <div className=\"flight-summary__layover-badge\">\n    88→                      {formatLayover(prevLeg, leg)} layover at {leg.origin_code}\n    89→                    </div>\n    90→                  </div>\n    91→                )}\n    92→                <LegDetail\n    93→                  leg={leg}\n    94→                  airlineName={leg.airline_name || flight.airline_name}\n    95→                  airlineCode={leg.airline_code || flight.airline_code}\n    96→                  logoColor={flight.logo_color}\n    97→                  flightNumber={leg.flight_number || flight.flight_number}\n    98→                />\n    99→              </div>\n   100→            )\n   101→          })\n   102→        ) : (\n   103→          <LegDetail\n   104→            leg={{\n   105→              id: flight.id,\n   106→              leg_order: 1,\n   107→              departure_time: flight.departure_time,\n   108→              arrival_time: flight.arrival_time,\n   109→              duration_minutes: flight.duration_minutes,\n   110→              flight_number: flight.flight_number,\n   111→              aircraft_type: flight.aircraft_type,\n   112→              terminal_departure: null,\n   113→              terminal_arrival: null,\n   114→              origin_code: flight.origin_code,\n   115→              origin_name: flight.origin_name,\n   116→              origin_city: flight.origin_city,\n   117→              dest_code: flight.dest_code,\n   118→              dest_name: flight.dest_name,\n   119→              dest_city: flight.dest_city,\n   120→              airline_name: flight.airline_name,\n   121→              airline_code: flight.airline_code,\n   122→            }}\n   123→            airlineName={flight.airline_name}\n   124→            airlineCode={flight.airline_code}\n   125→            logoColor={flight.logo_color}\n   126→            flightNumber={flight.flight_number}\n   127→          />\n   128→        )}\n   129→      </div>\n   130→\n   131→      <div className=\"flight-summary__amenities\" data-testid=\"flight-summary-amenities\">\n   132→        {flight.has_wifi && (\n   133→          <span className=\"flight-summary__amenity\" data-testid=\"flight-summary-wifi\" title=\"Wi-Fi available\">\n   134→            📶 Wi-Fi\n   135→          </span>\n   136→        )}\n   137→        {flight.has_power && (\n   138→          <span className=\"flight-summary__amenity\" data-testid=\"flight-summary-power\" title=\"Power outlets available\">\n   139→            🔌 Power\n   140→          </span>\n   141→        )}\n   142→        {flight.has_entertainment && (\n   143→          <span className=\"flight-summary__amenity\" data-testid=\"flight-summary-entertainment\" title=\"In-flight entertainment\">\n   144→            🎬 Entertainment\n   145→          </span>\n   146→        )}\n   147→      </div>\n   148→\n   149→      <div className=\"flight-summary__baggage\" data-testid=\"flight-summary-baggage\">\n   150→        <span className=\"flight-summary__baggage-icon\">🧳</span>\n   151→        <span>{getBaggageInfo(flight.cabin_class)}</span>\n   152→      </div>\n   153→\n   154→      {dayDiff > 0 && (\n   155→        <div className=\"flight-summary__overnight-note\" data-testid=\"flight-summary-overnight\">\n   156→          Arrives +{dayDiff} day{dayDiff > 1 ? 's' : ''}\n   157→        </div>\n   158→      )}\n   159→    </div>\n   160→  )\n   161→}\n   162→\n   163→interface LegDetailProps {\n   164→  leg: FlightLeg\n   165→  airlineName: string\n   166→  airlineCode: string\n   167→  logoColor: string\n   168→  flightNumber: string\n   169→}\n   170→\n   171→function Leg