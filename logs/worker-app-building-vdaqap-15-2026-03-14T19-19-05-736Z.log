igin!.iata_code,\n    43→      destination: destination!.iata_code,\n    44→      departureDate: departureDate!,\n    45→      tripType,\n    46→      cabinClass,\n    47→      adults: String(passengers.adults),\n    48→      children: String(passengers.children),\n    49→      infants: String(passengers.infants),\n    50→    })\n    51→    if (returnDate) params.set('returnDate', returnDate)\n    52→\n    53→    navigate(`/results?${params.toString()}`)\n    54→  }\n    55→\n    56→  return (\n    57→    <button\n    58→      className=\"search-button\"\n    59→      onClick={handleSearch}\n    60→      data-testid=\"search-button\"\n    61→    >\n    62→      <span className=\"search-button__icon\">🔍</span>\n    63→      <span>Search</span>\n    64→    </button>\n    65→  )\n    66→}\n    67→\n    68→export default SearchButton\n    69→"}]},"parent_tool_use_id":"toolu_0186sxMZPWsay4mkKM4wuB2j","session_id":"ac34eca8-511a-4c72-851b-3745b8c8cd54","uuid":"d41ac460-0803-450b-8589-3555d9390e84"}
