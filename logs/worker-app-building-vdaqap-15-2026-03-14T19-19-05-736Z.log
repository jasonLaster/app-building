[2026-03-14T19:13:12.700Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014cqMiWNHvyoiyQriv5NhTo","type":"tool_result","content":"     1→import { useSelector, useDispatch } from 'react-redux'\n     2→import type { RootState, AppDispatch } from '../store'\n     3→import { createBooking, setValidationErrors } from '../slices/bookingSlice'\n     4→import './BookingAction.css'\n     5→\n     6→function isValidEmail(email: string): boolean {\n     7→  return /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)\n     8→}\n     9→\n    10→interface BookingActionProps {\n    11→  flightId: string\n    12→  returnFlightId?: string\n    13→  cabinClass: string\n    14→  totalPriceCents: number\n    15→}\n    16→\n    17→function BookingAction({ flightId, returnFlightId, cabinClass, totalPriceCents }: BookingActionProps) {\n    18→  const dispatch = useDispatch<AppDispatch>()\n    19→  const { passengers, bookingInProgress, bookingComplete, bookingReference, bookingError } = useSelector(\n    20→    (state: RootState) => state.booking\n    21→  )\n    22→  const sessionToken = useSelector((state: RootState) => state.search.sessionToken)\n    23→\n    24→  function handleBook() {\n    25→    if (bookingComplete) return\n    26→\n    27→    // Validate\n    28→    const errors: Record<string, string> = {}\n    29→    passengers.forEach((p, i) => {\n    30→      if (!p.firstName.trim()) errors[`${i}-firstName`] = 'First name is required'\n    31→      if (!p.lastName.trim()) errors[`${i}-lastName`] = 'Last name is required'\n    32→      if (!p.dateOfBirth) errors[`${i}-dateOfBirth`] = 'Date of birth is required'\n    33→      if (!p.gender) errors[`${i}-gender`] = 'Gender is required'\n    34→      if (i === 0) {\n    35→        if (!p.email.trim()) {\n    36→          errors[`${i}-email`] = 'Email is required'\n    37→        } else if (!isValidEmail(p.email.trim())) {\n    38→          errors[`${i}-email`] = 'Please enter a valid email address'\n    39→        }\n    40→        if (!p.phone.trim()) errors[`${i}-phone`] = 'Phone number is required'\n    41→      }\n    42→    })\n    43→\n    44→    if (Object.keys(errors).length > 0) {\n    45→      dispatch(setValidationErrors(errors))\n    46→      return\n    47→    }\n    48→\n    49→    dispatch(createBooking({\n    50→      sessionToken,\n    51→      flightId,\n    52→      returnFlightId,\n    53→      cabinClass,\n    54→      totalPriceCents,\n    55→      passengers: passengers.map((p, i) => ({\n    56→        firstName: p.firstName.trim(),\n    57→        lastName: p.lastName.trim(),\n    58→        dateOfBirth: p.dateOfBirth,\n    59→        gender: p.gender,\n    60→        email: i === 0 ? p.email.trim() : undefined,\n    61→        phone: i === 0 ? p.phone.trim() : undefined,\n    62→        passengerType: p.passengerType,\n    63→      })),\n    64→    }))\n    65→  }\n    66→\n    67→  if (bookingComplete && bookingReference) {\n    68→    return (\n    69→      <div className=\"booking-action\" data-testid=\"booking-action\">\n    70→        <div className=\"booking-action__confirmation\" data-testid=\"booking-confirmation\">\n    71→          <div className=\"booking-action__confirmation-icon\">✓</div>\n    72→          <h3 className=\"booking-action__confirmation-title\">Booking Confirmed!</h3>\n    73→          <p className=\"booking-action__reference\" data-testid=\"booking-reference\">\n    74→            Your booking reference: <strong>{bookingReference}</strong>\n    75→          </p>\n    76→          <p className=\"booking-action__confirmation-note\">\n    77→            You can view this booking on the My Trips page.\n    78→          </p>\n    79→        </div>\n    80→      </div>\n    81→    )\n    82→  }\n    83→\n    84→  return (\n    85→    <div className=\"booking-action\" data-testid=\"booking-action\">\n    86→      {bookingError && (\n    87→        <div className=\"booking-action__error\" data-testid=\"booking-error\">\n    88→          {bookingError}\n    89→        </div>\n    90→      )}\n    91→      <button\n    92→        className=\"booking-action__button\"\n    93→        onClick={handleBook}\n    94→        disabled={bookingInProgress}\n    95→        data-testid=\"booking-button\"\n    96→      >\n    97→        {bookingInProgress ? 'Booking...' : 'Book Flight'}\n    98→      </button>\n    99→    </div>\n   100→  )\n   101→}\n   102→\n   103→export default BookingAction\n   104→"}]},"parent_tool_use_id":"toolu_0186sxMZPWsay4mkKM4wuB2j","session_id":"ac34eca8-511a-4c72-851b-3745b8c8cd54","uuid":"bd2d6b4b-b82e-44c0-9a93-d115c66cee76"}
