[2026-03-15T00:27:48.958Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013WMmEMk99vqdHfCyubwrwq","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions'\n     2→import { getSql } from './db.js'\n     3→\n     4→export default async (request: Request, _context: Context) => {\n     5→  const sql = getSql()\n     6→  const url = new URL(request.url)\n     7→  const segments = url.pathname.split('/').filter(Boolean)\n     8→  const userIdx = segments.indexOf('users')\n     9→  const userId = userIdx >= 0 ? segments[userIdx + 1] : undefined\n    10→  const action = userIdx >= 0 ? segments[userIdx + 2] : undefined\n    11→\n    12→  const headers = { 'Content-Type': 'application/json' }\n    13→\n    14→  if (!userId) {\n    15→    return new Response(JSON.stringify({ error: 'User ID is required' }), { status: 400, headers })\n    16→  }\n    17→\n    18→  try {\n    19→  if (request.method === 'GET') {\n    20→    const result = await sql`SELECT * FROM users WHERE id = ${userId}`\n    21→    const user = result[0]\n    22→    if (!user) {\n    23→      return new Response(JSON.stringify({ error: 'User not found' }), { status: 404, headers })\n    24→    }\n    25→    return new Response(JSON.stringify(user), { status: 200, headers })\n    26→  }\n    27→\n    28→  if (request.method === 'POST' && action === 'become-host') {\n    29→    const result = await sql`\n    30→      UPDATE users SET is_host = true WHERE id = ${userId} RETURNING *\n    31→    `\n    32→    const user = result[0]\n    33→    if (!user) {\n    34→      return new Response(JSON.stringify({ error: 'User not found' }), { status: 404, headers })\n    35→    }\n    36→    return new Response(JSON.stringify(user), { status: 200, headers })\n    37→  }\n    38→\n    39→  if (request.method === 'PUT') {\n    40→    const body = await request.json() as {\n    41→      name?: string\n    42→      bio?: string | null\n    43→      phone?: string | null\n    44→      avatar_url?: string | null\n    45→    }\n    46→\n    47→    const existing = await sql`SELECT * FROM users WHERE id = ${userId}`\n    48→    const existingUser = existing[0]\n    49→    if (!existingUser) {\n    50→      return new Response(JSON.stringify({ error: 'User not found' }), { status: 404, headers })\n    51→    }\n    52→\n    53→    const eu = existingUser as Record<string, unknown>\n    54→    const result = await sql`\n    55→      UPDATE users SET\n    56→        name = ${body.name !== undefined ? body.name : eu.name as string},\n    57→        bio = ${body.bio !== undefined ? (body.bio || null) : eu.bio as string | null},\n    58→        phone = ${body.phone !== undefined ? (body.phone || null) : eu.phone as string | null},\n    59→        avatar_url = ${body.avatar_url !== undefined ? (body.avatar_url || null) : eu.avatar_url as string | null}\n    60→      WHERE id = ${userId}\n    61→      RETURNING *\n    62→    `\n    63→    const user = result[0]\n    64→    return new Response(JSON.stringify(user), { status: 200, headers })\n    65→  }\n    66→\n    67→  return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers })\n    68→  } catch {\n    69→    return new Response(JSON.stringify({ error: 'Internal server error' }), { status: 500, headers })\n    70→  }\n    71→}\n    72→"}]},"parent_tool_use_id":"toolu_01PVTrAKh9qYCnZ8cR9hEe2k","session_id":"24c86dd7-4f1e-4262-a2f5-95ade9fc16a6","uuid":"0d161920-2a31-433b-a678-7acb109a3017"}
