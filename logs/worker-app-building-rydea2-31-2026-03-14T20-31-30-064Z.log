 padding: 20px 24px 0;\n}\n\n.imm-title {\n  font-size: 16px;\n  font-weight: 600;\n  color: var(--color-text-primary);\n  margin: 0;\n}\n\n.imm-body {\n  padding: 16px 24px;\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n}\n\n.imm-field {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.imm-label {\n  font-size: 12px;\n  font-weight: 500;\n  color: var(--color-text-secondary);\n}\n\n.imm-input {\n  padding: 8px 10px;\n  background-color: var(--color-bg-primary);\n  border: 1px solid var(--color-border);\n  border-radius: 6px;\n  color: var(--color-text-primary);\n  font-size: 13px;\n  outline: none;\n  transition: border-color 150ms ease;\n}\n\n.imm-input:focus {\n  border-color: var(--color-accent);\n}\n\n.imm-input-error {\n  border-color: #ef4444;\n}\n\n.imm-error {\n  font-size: 11px;\n  color: #ef4444;\n}\n\n.imm-footer {\n  display: flex;\n  justify-content: flex-end;\n  gap: 8px;\n  padding: 0 24px 20px;\n}\n\n.imm-cancel-btn {\n  padding: 6px 14px;\n  border: 1px solid var(--color-border);\n  border-radius: 6px;\n  background: none;\n  color: var(--color-text-secondary);\n  font-size: 13px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: background-color 150ms ease, color 150ms ease;\n}\n\n.imm-cancel-btn:hover {\n  background-color: var(--color-bg-hover);\n  color: var(--color-text-primary);\n}\n\n.imm-submit-btn {\n  padding: 6px 14px;\n  border: none;\n  border-radius: 6px;\n  background-color: var(--color-accent);\n  color: #fff;\n  font-size: 13px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: opacity 150ms ease;\n}\n\n.imm-submit-btn:hover {\n  opacity: 0.9;\n}\n\n.imm-submit-btn:disabled {\n  opacity: 0.6;\n  cursor: not-allowed;\n}\n","numLines":121,"startLine":1,"totalLines":121}}}
