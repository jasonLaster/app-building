= getState() as { auth: { token: string | null } };\n   163→    const token = state.auth.token;\n   164→    if (!token) return rejectWithValue('No token');\n   165→    const response = await fetch(\n   166→      `/api/project-milestones?milestoneId=${payload.milestoneId}&projectId=${payload.projectId}`,\n   167→      {\n   168→        method: 'DELETE',\n   169→        headers: { Authorization: `Bearer ${token}` },\n   170→      }\n   171→    );\n   172→    if (!response.ok) {\n   173→      return rejectWithValue('Failed to delete milestone');\n   174→    }\n   175→    return { milestoneId: payload.milestoneId };\n   176→  }\n   177→);\n   178→\n   179→export const updateProjectIssueStatus = createAsyncThunk(\n   180→  'projectDetail/updateProjectIssueStatus',\n   181→  async (\n   182→    payload: { issueId: string; status: string },\n   183→    { getState, rejectWithValue }\n   184→  ) => {\n   185→    const state = getState() as { auth: { token: string | null } };\n   186→    const token = state.auth.token;\n   187→    if (!token) return rejectWithValue('No token');\n   188→    const response = await fetch('/api/update-issue-status', {\n   189→      method: 'PUT',\n   190→      headers: {\n   191→        'Content-Type': 'application/json',\n   192→        Authorization: `Bearer ${token}`,\n   193→      },\n   194→      body: JSON.stringify(payload),\n   195→    });\n   196→    if (!response.ok) {\n   197→      return rejectWithValue('Failed to update issue status');\n   198→    }\n   199→    const data = await response.json();\n   200→    return { issueId: payload.issueId, status: data.issue.status as string };\n   201→  }\n   202→);\n   203→\n   204→export const bulkUpdateProjectIssues = createAsyncThunk(\n   205→  'projectDetail/bulkUpdateProjectIssues',\n   206→  async (\n   207→    payload: {\n   208→      issueIds: string[];\n   209→      projectId: string;\n   210→      status?: string;\n   211→      priority?: string;\n   212→      assigneeId?: string | null;\n   213→      labelId?: string;\n   214→    },\n   215→    { getState, dispatch, rejectWithValue }\n   216→  ) => {\n   217→    const state = getState() as { auth: { token: string | null } };\n   218→    const token = state.auth.token;\n   219→    if (!token) return rejectWithValue('No token');\n   220→    const { projectId, ...body } = payload;\n   221→    const response = await fetch('/api/bulk-update-issues', {\n   222→      method: 'PUT',\n   223→      headers: {\n   224→        'Content-Type': 'application/json',\n   225→        Authorization: `Bearer ${token}`,\n   226→      },\n   227→      body: JSON.stringify(body),\n   228→    });\n   229→    if (!response.ok) {\n   230→      return rejectWithValue('Failed to bulk update issues');\n   231→    }\n   232→    dispatch(fetchProjectDetail(projectId));\n   233→    return payload;\n   234→  }\n   235→);\n   236→\n   237→const projectDetailSlice = createSlice({\n   238→  name: 'projectDetail',\n   239→  initialState,\n   240→  reducers: {\n   241→    clearProjectDetail(state) {\n   242→      state.project = null;\n   243→      state.issues = [];\n   244→      state.milestones = [];\n   245→      state.members = [];\n   246→      state.labels = [];\n   247→      state.activity = [];\n   248→      state.loading = false;\n   249→      state.error = null;\n   250→      state.selectedIssueIds = [];\n   251→    },\n   252→    toggleProjectIssueSelection(state, action: { payload: string }) {\n   253→      const id = action.payload;\n   254→      const idx = state.selectedIssueIds.indexOf(id);\n   255→      if (idx >= 0) {\n   256→        state.selectedIssueIds.splice(idx, 1);\n   257→      } else {\n   258→        state.selectedIssueIds.push(id);\n   259→      }\n   260→    },\n   261→    clearProjectIssueSelection(state) {\n   262→      state.selectedIssueIds = [];\n   263→    },\n   264→  },\n   265→  extraReducers: (builder) => {\n   266→    builder\n   267→      .addCase(fetchProjectDetail.pending, (state) => {\n 