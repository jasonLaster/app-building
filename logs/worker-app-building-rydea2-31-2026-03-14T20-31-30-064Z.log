ink: 0;\n}\n\n.project-badge-planned {\n  background-color: rgba(156, 163, 175, 0.15);\n  color: #9ca3af;\n  border: 1px solid rgba(156, 163, 175, 0.3);\n}\n\n.project-badge-in-progress {\n  background-color: rgba(94, 106, 210, 0.15);\n  color: var(--color-accent);\n  border: 1px solid rgba(94, 106, 210, 0.3);\n}\n\n.project-badge-completed {\n  background-color: rgba(34, 197, 94, 0.15);\n  color: #22c55e;\n  border: 1px solid rgba(34, 197, 94, 0.3);\n}\n\n.project-badge-cancelled {\n  background-color: rgba(239, 68, 68, 0.15);\n  color: #ef4444;\n  border: 1px solid rgba(239, 68, 68, 0.3);\n}\n\n.project-card-meta {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  flex-wrap: wrap;\n}\n\n.project-card-lead {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 12px;\n  color: var(--color-text-secondary);\n}\n\n.project-card-avatar {\n  width: 20px;\n  height: 20px;\n  border-radius: 50%;\n  background-color: var(--color-accent);\n  color: #fff;\n  font-size: 9px;\n  font-weight: 600;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n\n.project-card-lead-name {\n  color: var(--color-text-secondary);\n}\n\n.project-card-no-lead {\n  color: var(--color-text-tertiary);\n  font-style: italic;\n}\n\n.project-card-date {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  font-size: 12px;\n  color: var(--color-text-secondary);\n}\n\n.project-card-date svg {\n  color: var(--color-text-tertiary);\n}\n\n.project-card-no-date {\n  color: var(--color-text-tertiary);\n  font-style: italic;\n}\n\n.project-card-progress {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.project-card-progress-bar {\n  flex: 1;\n  height: 4px;\n  background-color: var(--color-border);\n  border-radius: 2px;\n  overflow: hidden;\n}\n\n.project-card-progress-fill {\n  height: 100%;\n  background-color: var(--color-accent);\n  border-radius: 2px;\n  transition: width 300ms ease;\n}\n\n.project-card-progress-complete {\n  background-color: #22c55e;\n}\n\n.project-card-progress-text {\n  font-size: 11px;\n  color: var(--color-text-tertiary);\n  white-space: nowrap;\n  flex-shrink: 0;\n}\n\n.project-card-teams {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  flex-wrap: wrap;\n}\n\n.project-card-team-icon {\n  width: 24px;\n  height: 24px;\n  border-radius: 4px;\n  background-color: rgba(94, 106, 210, 0.15);\n  color: var(--color-accent);\n  font-size: 9px;\n  font-weight: 700;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n  letter-spacing: 0.5px;\n}\n","numLines":179,"startLine":1,"totalLines":179}}}
