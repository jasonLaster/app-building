ions', {\n    51→      headers: { Authorization: `Bearer ${token}` },\n    52→    });\n    53→    if (!response.ok) {\n    54→      return rejectWithValue('Failed to fetch notifications');\n    55→    }\n    56→    const data = await response.json();\n    57→    return data.notifications as Notification[];\n    58→  }\n    59→);\n    60→\n    61→export const markNotificationRead = createAsyncThunk(\n    62→  'notifications/markRead',\n    63→  async (notificationId: string, { getState, rejectWithValue }) => {\n    64→    const state = getState() as { auth: { token: string | null } };\n    65→    const token = state.auth.token;\n    66→    if (!token) return rejectWithValue('No token');\n    67→    const response = await fetch(`/api/notifications/${notificationId}/read`, {\n    68→      method: 'PUT',\n    69→      headers: { Authorization: `Bearer ${token}` },\n    70→    });\n    71→    if (!response.ok) {\n    72→      return rejectWithValue('Failed to mark as read');\n    73→    }\n    74→    return notificationId;\n    75→  }\n    76→);\n    77→\n    78→export const archiveNotification = createAsyncThunk(\n    79→  'notifications/archive',\n    80→  async (notificationId: string, { getState, rejectWithValue }) => {\n    81→    const state = getState() as { auth: { token: string | null } };\n    82→    const token = state.auth.token;\n    83→    if (!token) return rejectWithValue('No token');\n    84→    const response = await fetch(`/api/notifications/${notificationId}/archive`, {\n    85→      method: 'PUT',\n    86→      headers: { Authorization: `Bearer ${token}` },\n    87→    });\n    88→    if (!response.ok) {\n    89→      return rejectWithValue('Failed to archive notification');\n    90→    }\n    91→    return notificationId;\n    92→  }\n    93→);\n    94→\n    95→const notificationsSlice = createSlice({\n    96→  name: 'notifications',\n    97→  initialState,\n    98→  reducers: {\n    99→    decrementUnreadCount(state) {\n   100→      if (state.unreadCount > 0) {\n   101→        state.unreadCount -= 1;\n   102→      }\n   103→    },\n   104→    setUnreadCount(state, action) {\n   105→      state.unreadCount = action.payload;\n   106→    },\n   107→  },\n   108→  extraReducers: (builder) => {\n   109→    builder\n   110→      .addCase(fetchUnreadCount.fulfilled, (state, action) => {\n   111→        state.unreadCount = action.payload;\n   112→      })\n   113→      .addCase(fetchNotifications.pending, (state) => {\n   114→        if (state.items.length === 0) {\n   115→          state.loading = true;\n   116→        }\n   117→      })\n   118→      .addCase(fetchNotifications.fulfilled, (state, action) => {\n   119→        state.loading = false;\n   120→        state.items = action.payload;\n   121→        state.unreadCount = action.payload.filter((n) => !n.read).length;\n   122→      })\n   123→      .addCase(fetchNotifications.rejected, (state) => {\n   124→        state.loading = false;\n   125→      })\n   126→      .addCase(markNotificationRead.fulfilled, (state, action) => {\n   127→        const notification = state.items.find((n) => n.id === action.payload);\n   128→        if (notification && !notification.read) {\n   129→          notification.read = true;\n   130→          state.unreadCount = Math.max(0, state.unreadCount - 1);\n   131→        }\n   132→      })\n   133→      .addCase(archiveNotification.fulfilled, (state, action) => {\n   134→        const notification = state.items.find((n) => n.id === action.payload);\n   135→        if (notification && !notification.read) {\n   136→          state.unreadCount = Math.max(0, state.unreadCount - 1);\n   137→        }\n   138→        state.items = state.items.filter((n) => n.id !== action.payload);\n   139→      });\n   140→  },\n   141→});\n   142→\n   143→export const { decrementUnreadCount, setUnreadCount } = notificationsSlice.actions;\n   144→export default notificationsSlice.reducer;\n   145→"}]},"parent_tool_use_id":"toolu_011wWewFbP6RJwjN7R5ZTd