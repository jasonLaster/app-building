ccent);\n}\n\n.ctm-error {\n  font-size: 11px;\n  color: #ef4444;\n}\n\n.ctm-server-error {\n  font-size: 12px;\n  color: #ef4444;\n  padding: 8px 10px;\n  background-color: rgba(239, 68, 68, 0.1);\n  border-radius: 6px;\n}\n\n.ctm-footer {\n  display: flex;\n  justify-content: flex-end;\n  gap: 8px;\n  padding: 0 24px 20px;\n}\n\n.ctm-cancel-btn {\n  padding: 6px 14px;\n  border: 1px solid var(--color-border);\n  border-radius: 6px;\n  background: none;\n  color: var(--color-text-secondary);\n  font-size: 13px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: background-color 150ms ease, color 150ms ease;\n}\n\n.ctm-cancel-btn:hover {\n  background-color: var(--color-bg-hover);\n  color: var(--color-text-primary);\n}\n\n.ctm-submit-btn {\n  padding: 6px 14px;\n  border: none;\n  border-radius: 6px;\n  background-color: var(--color-accent);\n  color: #fff;\n  font-size: 13px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: opacity 150ms ease;\n}\n\n.ctm-submit-btn:hover {\n  opacity: 0.9;\n}\n\n.ctm-submit-btn:disabled {\n  opacity: 0.6;\n  cursor: not-allowed;\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":321,"cache_read_input_tokens":73893,"cache_creation":{"ephemeral_5m_input_tokens":321,"ephemeral_1h_input_tokens":0},"output_tokens":25,"service_tier":"standard","inference_geo":"global"},"context_management":null},"parent_tool_use_id":null,"session_id":"f7c3ec87-3773-46b4-8373-fe050b22f9e3","uuid":"4f352696-7356-47e8-b483-099b1fb1b6c4"}
