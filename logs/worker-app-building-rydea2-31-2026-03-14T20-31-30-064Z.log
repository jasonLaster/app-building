wasDone = issue.status === 'done';\n   309→          const nowDone = status === 'done';\n   310→          const wasInProgress = issue.status === 'in_progress';\n   311→          const nowInProgress = status === 'in_progress';\n   312→          issue.status = status;\n   313→          // Update project counts\n   314→          if (state.project) {\n   315→            if (!wasDone && nowDone) {\n   316→              state.project.completedIssues += 1;\n   317→            } else if (wasDone && !nowDone) {\n   318→              state.project.completedIssues -= 1;\n   319→            }\n   320→            if (!wasInProgress && nowInProgress) {\n   321→              state.project.inProgressIssues += 1;\n   322→            } else if (wasInProgress && !nowInProgress) {\n   323→              state.project.inProgressIssues -= 1;\n   324→            }\n   325→          }\n   326→        }\n   327→      })\n   328→      .addCase(bulkUpdateProjectIssues.fulfilled, (state) => {\n   329→        state.selectedIssueIds = [];\n   330→      })\n   331→      // Cross-slice: handle status updates from IssueRow (issuesSlice)\n   332→      .addCase(updateIssueStatus.fulfilled, (state, action) => {\n   333→        const { issueId, status } = action.payload;\n   334→        const issue = state.issues.find((i) => i.id === issueId);\n   335→        if (issue) {\n   336→          const wasDone = issue.status === 'done';\n   337→          const nowDone = status === 'done';\n   338→          const wasInProgress = issue.status === 'in_progress';\n   339→          const nowInProgress = status === 'in_progress';\n   340→          issue.status = status;\n   341→          if (state.project) {\n   342→            if (!wasDone && nowDone) {\n   343→              state.project.completedIssues += 1;\n   344→            } else if (wasDone && !nowDone) {\n   345→              state.project.completedIssues -= 1;\n   346→            }\n   347→            if (!wasInProgress && nowInProgress) {\n   348→       