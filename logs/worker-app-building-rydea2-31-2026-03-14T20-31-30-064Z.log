es\"\n    86→          >\n    87→            <svg className=\"sidebar-icon\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n    88→              <path d=\"M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2\" />\n    89→              <circle cx=\"12\" cy=\"7\" r=\"4\" />\n    90→            </svg>\n    91→            {!sidebarCollapsed && <span>My Issues</span>}\n    92→          </Link>\n    93→          <Link\n    94→            to=\"/inbox\"\n    95→            className={`sidebar-link ${isActive('/inbox') ? 'sidebar-link-active' : ''}`}\n    96→            data-testid=\"sidebar-link-inbox\"\n    97→            title=\"Inbox\"\n    98→          >\n    99→            <svg className=\"sidebar-icon\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n   100→              <polyline points=\"22 12 16 12 14 15 10 15 8 12 2 12\" />\n   101→              <path d=\"M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z\" />\n   102→            </svg>\n   103→            {!sidebarCollapsed && <span>Inbox</span>}\n   104→            {unreadCount > 0 && (\n   105→              <span className=\"sidebar-badge\" data-testid=\"sidebar-inbox-badge\">\n   106→                {unreadCount}\n   107→              </span>\n   108→            )}\n   109→          </Link>\n   110→        </div>\n   111→\n   112→        {teams.length > 0 && (\n   113→          <div className=\"sidebar-section\" data-testid=\"sidebar-teams-section\">\n   114→            {!sidebarCollapsed && (\n   115→              <span className=\"sidebar-section-label\">Teams</span>\n   116→            )}\n   117→            {teams.map((team) => (\n   118→              <div key={team.id} className=\"sidebar-team\" data-testid={`sidebar-team-${team.id}`}>\n   119→    