tate, rejectWithValue }\n   114→  ) => {\n   115→    const state = getState() as { auth: { token: string | null } };\n   116→    const token = state.auth.token;\n   117→    if (!token) return rejectWithValue('No token');\n   118→    const response = await fetch('/api/cycles', {\n   119→      method: 'POST',\n   120→      headers: {\n   121→        'Content-Type': 'application/json',\n   122→        Authorization: `Bearer ${token}`,\n   123→      },\n   124→      body: JSON.stringify(payload),\n   125→    });\n   126→    if (!response.ok) {\n   127→      return rejectWithValue('Failed to create cycle');\n   128→    }\n   129→    return await response.json() as CycleSummary;\n   130→  }\n   131→);\n   132→\n   133→const cyclesSlice = createSlice({\n   134→  name: 'cycles',\n   135→  initialState,\n   136→  reducers: {\n   137→    setSelectedCycleId(state, action: { payload: string | null }) {\n   138→      state.selectedCycleId = action.payload;\n   139→    },\n   140→    setCycleGroupBy(state, action: { payload: CyclesState['groupBy'] }) {\n   141→      state.groupBy = action.payload;\n   142→    },\n   143→    setCycleSortBy(state, action: { payload: CyclesState['sortBy'] }) {\n   144→      state.sortBy = action.payload;\n   145→    },\n   146→    toggleCycleIssueSelection(state, action: { payload: string }) {\n   147→      const id = action.payload;\n   148→      const idx = state.selectedIds.indexOf(id);\n   149→      if (idx >= 0) {\n   150→        state.selectedIds.splice(idx, 1);\n   151→      } else {\n   152→        state.selectedIds.push(id);\n   153→      }\n   154→    },\n   155→    selectCycleGroupIssues(state, action: { payload: string[] }) {\n   156→      const ids = action.payload;\n   157→      const allSelected = ids.every((id) => state.selectedIds.includes(id));\n   158→      if (allSelected) {\n   159→        state.selectedIds = state.selectedIds.filter((id) => !ids.includes(id));\n   160→      } else {\n   161→        const newIds = ids.filter((id