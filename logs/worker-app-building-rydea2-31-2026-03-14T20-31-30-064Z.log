    </Link>\n    42→        <span\n    43→          className={`project-card-badge ${statusCfg.className}`}\n    44→          data-testid={`project-card-status-${project.id}`}\n    45→        >\n    46→          {statusCfg.label}\n    47→        </span>\n    48→      </div>\n    49→\n    50→      <div className=\"project-card-meta\">\n    51→        {/* Lead */}\n    52→        <div className=\"project-card-lead\" data-testid={`project-card-lead-${project.id}`}>\n    53→          {project.leadName ? (\n    54→            <>\n    55→              <span className=\"project-card-avatar\">\n    56→                {getInitials(project.leadName)}\n    57→              </span>\n    58→              <span className=\"project-card-lead-name\">{project.leadName}</span>\n    59→            </>\n    60→          ) : (\n    61→            <span className=\"project-card-no-lead\">No lead</span>\n    62→          )}\n    63→        </div>\n    64→\n    65→        {/* Target Date */}\n    66→        <div className=\"project-card-date\" data-testid={`project-card-date-${project.id}`}>\n    67→          {project.targetDate ? (\n    68→            <>\n    69→              <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n    70→                <rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\" />\n    71→                <line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\" />\n    72→                <line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\" />\n    73→                <line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\" />\n    74→              </svg>\n    75→              <span>{formatTargetDate(project.targetDate)}</span>\n    76→            </>\n    77→          ) : (\n    78→            <span className=\"project-card-no-date\">No target date</span>\n    79→          )}\n    80→        </div>\n    81→      </div>\n    82→\n    83→      {/* Progress Bar */}\n    84→      <div className=\"project-card-progress\" data-testid={`project-card-progress-${project.id}`}>\n    85→        <div className=\"project-card-progress-bar\">\n    86→          <div\n    87→            className={`project-card-progress-fill ${percentage === 100 ? 'project-card-progress-complete' : ''}`}\n    88→            style={{ width: `${percentage}%` }}\n    89→          />\n    90→        </div>\n    91→        <span className=\"project-card-progress-text\">\n    92→          {project.completedIssues}/{project.totalIssues} ({percentage}%)\n    93→        </span>\n    94→      </div>\n    95→\n    96→      {/* Team Icons */}\n    97→      {project.teams.length > 0 && (\n    98→        <div className=\"project-card-teams\" data-testid={`project-card-teams-${project.id}`}>\n    99→          {project.teams.map((team) => (\n   100→            <span\n   101→              key={team.id}\n   102→              className=\"project-card-team-icon\"\n   103→              title={team.name}\n   104→              data-testid={`project-card-team-${project.id}-${team.id}`}\n   105→            >\n   106→              {team.identifier.slice(0, 2)}\n   107→            </span>\n   108→          ))}\n   109→        </div>\n   110→      )}\n   111→    </div>\n   112→  );\n   113→}\n   114→"}]},"parent_tool_use_id":null,"session_id":"f7c3ec87-3773-46b4-8373-fe050b22f9e3","uuid":"29769161-d83b-4f7f-9526-c0259c6741ea","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/src/components/ProjectCard.tsx","content":"import { Link } from 'react-router-dom';\nimport type { Project } from '../slices/projectsSlice';\nimport './ProjectCard.css';\n\nconst PROJECT_STATUS_CONFIG: Record<string, { label: string; className: string }> = {\n  planned: { label: 'Planned', className: 'project-badge-planned' },\n  in_progress: { label: 'In Progress', className: 'project-badge-in-progress' },\n  completed: { label: 'Completed', className: 'project-badge-completed' },\n  cancelled: { label: 'Cancelled', className: 'project-badge-cancelled' },\n};\n\nfunction getInitials(name: string): string {\n  return name.split(' ').map((n) => n[0]).join('').toUpperCase().slice(0, 2);\n}\n\ninterface ProjectCardProps {\n  project: Project;\n}\n\nexport default function ProjectCard({ project }: ProjectCardProps) {\n  const percentage = project.totalIssues > 0\n    ? Math.round((project.completedIssues / project.totalIssues) * 100)\n    : 0;\n\n  const statusCfg = PROJECT_STATUS_CONFIG[project.status] || PROJECT_STATUS_CONFIG.planned;\n\n  function formatTargetDate(dateStr: string): string {\n    const d = new Date(dateStr + 'T00:00:00');\n    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });\n  }\n\n  return (\n    <div className=\"project-card\" data-testid={`project-card-${project.id}`}>\n      <div className=\"project-card-header\">\n        <Link\n          to={`/project/${project.id}`}\n          className=\"project-card-name\"\n          data-testid={`project-card-name-${project.id}`}\n        >\n          {project.name}\n        </Link>\n        <span\n          className={`project-card-badge ${statusCfg.className}`}\n          data-testid={`project-card-status-${project.id}`}\n        >\n          {statusCfg.label}\n        </span>\n      </div>\n\n      <div className=\"project-card-meta\">\n        {/* Lead */}\n        <div className=\"project-card-lead\" data-testid={`project-card-lead-${project.id}`}>\n          {project.leadName ? (\n            <>\n              <span className=\"project-card-avatar\">\n                {getInitials(project.leadName)}\n              </span>\n              <span className=\"project-card-lead-name\">{project.leadName}</span>\n            </>\n          ) : (\n            <span className=\"project-card-no-lead\">No lead</span>\n          )}\n        </div>\n\n        {/* Target Date */}\n        <div className=\"project-card-date\" data-testid={`project-card-date-${project.id}`}>\n          {project.targetDate ? (\n            <>\n              <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n                <rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\" />\n                <line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\" />\n                <line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\" />\n                <line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\" />\n              </svg>\n              <span>{formatTargetDate(project.targetDate)}</span>\n            </>\n          ) : (\n            <span className=\"project-card-no-date\">No target date</span>\n          )}\n        </div>\n      </div>\n\n      {/* Progress Bar */}\n      <div className=\"project-card-progress\" data-testid={`project-card-progress-${project.id}`}>\n        <div className=\"project-card-progress-bar\">\n          <div\n            className={`project-card-progress-fill ${percentage === 100 ? 'project-card-progress-complete' : ''}`}\n            style={{ width: `${percentage}%` }}\n          />\n        </div>\n        <span className=\"project-card-progress-text\">\n          {project.completedIssues}/{project.totalIssues} ({percentage}%)\n        </span>\n      </div>\n\n      {/* Team Icons */}\n      {project.teams.length > 0 && (\n        <div className=\"project-card-teams\" data-testid={`project-card-teams-${project.id}`}>\n          {project.teams.map((team) => (\n            <span\n              key={team.id}\n              className=\"project-card-team-icon\"\n              title={team.name}\n              data-testid={`project-card-team-${project.id}-${team.id}`}\n            >\n              {team.identifier.slice(0, 2)}\n            </span>\n          ))}\n        </div>\n      )}\n    </div>\n  );\n}\n","numLines":114,"startLine":1,"totalLines":114}}}
