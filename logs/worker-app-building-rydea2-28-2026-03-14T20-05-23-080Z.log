[2026-03-14T19:59:49.059Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QhrVuYBtKBoDLnq61vUrt1","type":"tool_result","content":"     1→import { createSlice, createAsyncThunk } from '@reduxjs/toolkit';\n     2→import type { Issue } from './issuesSlice';\n     3→import { updateIssueStatus } from './issuesSlice';\n     4→\n     5→export interface CycleSummary {\n     6→  id: string;\n     7→  name: string;\n     8→  startDate: string;\n     9→  endDate: string;\n    10→  teamId: string;\n    11→  issueCount: number;\n    12→  doneCount: number;\n    13→  inProgressCount: number;\n    14→  isActive: boolean;\n    15→}\n    16→\n    17→export interface CycleIssue extends Issue {\n    18→  cycleName: string | null;\n    19→}\n    20→\n    21→export interface BurndownEntry {\n    22→  date: string;\n    23→  count: number;\n    24→}\n    25→\n    26→export interface CycleDetail {\n    27→  id: string;\n    28→  name: string;\n    29→  startDate: string;\n    30→  endDate: string;\n    31→  teamId: string;\n    32→}\n    33→\n    34→interface CycleDetailMember {\n    35→  id: string;\n    36→  name: string;\n    37→  email: string;\n    38→}\n    39→\n    40→interface CyclesState {\n    41→  cycles: CycleSummary[];\n    42→  loading: boolean;\n    43→  error: string | null;\n    44→  selectedCycleId: string | null;\n    45→  cycleDetail: CycleDetail | null;\n    46→  cycleIssues: CycleIssue[];\n    47→  cycleMembers: CycleDetailMember[];\n    48→  burndown: BurndownEntry[];\n    49→  detailLoading: boolean;\n    50→  detailError: string | null;\n    51→  groupBy: 'status' | 'priority' | 'assignee' | 'project' | 'label' | 'none';\n    52→  sortBy: 'priority' | 'created' | 'updated' | 'status';\n    53→  selectedIds: string[];\n    54→}\n    55→\n    56→const initialState: CyclesState = {\n    57→  cycles: [],\n    58→  loading: false,\n    59→  error: null,\n    60→  selectedCycleId: null,\n    61→  cycleDetail: null,\n    62→  cycleIssues: [],\n    63→  cycleMembers: [],\n    64→  burndown: [],\n    65→  detailLoading: false,\n    66→  detailError: null,\n    67→  groupBy: 'status',\n    68→  sortBy: 'priority',\n    69→  selectedIds: [],\n    70→};\n    71→\n    72→export const fetchCycles = createAsyncThunk(\n    73→  'cycles/fetchCycles',\n    74→  async (teamId: string, { getState, rejectWithValue }) => {\n    75→    const state = getState() as { auth: { token: string | null } };\n    76→    const token = state.auth.token;\n    77→    if (!token) return rejectWithValue('No token');\n    78→    const response = await fetch(`/api/cycles?teamId=${teamId}`, {\n    79→      headers: { Authorization: `Bearer ${token}` },\n    80→    });\n    81→    if (!response.ok) {\n    82→      return rejectWithValue('Failed to fetch cycles');\n    83→    }\n    84→    return await response.json() as { cycles: CycleSummary[] };\n    85→  }\n    86→);\n    87→\n    88→export const fetchCycleIssues = createAsyncThunk(\n    89→  'cycles/fetchCycleIssues',\n    90→  async (cycleId: string, { getState, rejectWithValue }) => {\n    91→    const state = getState() as { auth: { token: string | null } };\n    92→    const token = state.auth.token;\n    93→    if (!token) return rejectWithValue('No token');\n    94→    const response = await fetch(`/api/cycle-issues?cycleId=${cycleId}`, {\n    95→      headers: { Authorization: `Bearer ${token}` },\n    96→    });\n    97→    if (!response.ok) {\n    98→      return rejectWithValue('Failed to fetch cycle issues');\n    99→    }\n   100→    return await response.json() as {\n   101→      cycle: CycleDetail;\n   102→      issues: CycleIssue[];\n   103→      members: CycleDetailMember[];\n   104→      burndown: BurndownEntry[];\n   105→    };\n   106→  }\n   107→);\n   108→\n   109→export const createCycle = createAsyncThunk(\n   110→  'cycles/createCycle',\n   111→  async (\n   112→    payload: { teamId: string; name: string; startDate: string; endDate: string },\n   113→    { getState, rejectWithValue }\n   114→  ) => {\n   115→    const state = getState() as { auth: { token: string | null } };\n   116→    const token = state.auth.token;\n   117→    if (!token) return rejectWithValue('No token');\n   118→    const response = await fetch('/api/cycles', {\n   119→      method: 'POST',\n   120→      headers: {\n   121→        'Content-Type': 'application/json',\n   122→        Authorization: `Bearer ${token}`,\n   123→      },\n   124→      body: JSON.stringify(payload),\n   125→    });\n   126→    if (!response.ok) {\n   127→      return rejectWithValue('Failed to create cycle');\n   128→    }\n   129→    return await response.json() as CycleSummary;\n   130→  }\n   131→);\n   132→\n   133→const cyclesSlice = createSlice({\n   134→  name: 'cycles',\n   135→  initialState,\n   136→  reducers: {\n   137→    setSelectedCycleId(state, action: { payload: string | null }) {\n   138→      state.selectedCycleId = action.payload;\n   139→    },\n   140→    setCycleGroupBy(state, action: { payload: CyclesState['groupBy'] }) {\n   141→      state.groupBy = action.payload;\n   142→    },\n   143→    setCycleSortBy(state, action: { payload: CyclesState['sortBy'] }) {\n   144→      state.sortBy = action.payload;\n   145→    },\n   146→    toggleCycleIssueSelection(state, action: { payload: string }) {\n   147→      const id = action.payload;\n   148→      const idx = state.selectedIds.indexOf(id);\n   149→      if (idx >= 0) {\n   150→        state.selectedIds.splice(idx, 1);\n   151→      } else {\n   152→        state.selectedIds.push(id);\n   153→      }\n   154→    },\n   155→    selectCycleGroupIssues(state, action: { payload: string[] }) {\n   156→      const ids = action.payload;\n   157→      const allSelected = ids.every((id) => state.selectedIds.includes(id));\n   158→      if (allSelected) {\n   159→        state.selectedIds = state.selectedIds.filter((id) => !ids.includes(id));\n   160→      } else {\n   161→        const newIds = ids.filter((id) => !state.selectedIds.includes(id));\n   162→        state.selectedIds.push(...newIds);\n   163→      }\n   164→    },\n   165→    clearCycleSelection(state) {\n   166→      state.selectedIds = [];\n   167→    },\n   168→  },\n   169→  extraReducers: (builder) => {\n   170→    builder\n   171→      .addCase(fetchCycles.pending, (state) => {\n   172→        if (state.cycles.length === 0) {\n   173→          state.loading = true;\n   174→        }\n   175→        state.error = null;\n   176→      })\n   177→      .addCase(fetchCycles.fulfilled, (state, action) => {\n   178→        state.loading = false;\n   179→        state.cycles = action.payload.cycles;\n   180→      })\n   181→      .addCase(fetchCycles.rejected, (state, action) => {\n   182→        state.loading = false;\n   183→        state.error = action.payload as string;\n   184→      })\n   185→      .addCase(fetchCycleIssues.pending, (state) => {\n   186→        if (state.cycleIssues.length === 0) {\n   187→          state.detailLoading = true;\n   188→        }\n   189→        state.detailError = null;\n   190→      })\n   191→      .addCase(fetchCycleIssues.fulfilled, (state, action) => {\n   192→        state.detailLoading = false;\n   193→        state.cycleDetail = action.payload.cycle;\n   194→        state.cycleIssues = action.payload.issues;\n   195→        state.cycleMembers = action.payload.members;\n   196→        state.burndown = action.payload.burndown;\n   197→        state.selectedIds = [];\n   198→      })\n   199→      .addCase(fetchCycleIssues.rejected, (state, action) => {\n   200→        state.detailLoading = false;\n   201→        state.detailError = action.payload as string;\n   202→      })\n   203→      .addCase(createCycle.fulfilled, (state, action) => {\n   204→        state.cycles.push(action.payload);\n   205→        state.cycles.sort((a, b) => a.startDate.localeCompare(b.startDate));\n   206→      })\n   207→      .addCase(updateIssueStatus.fulfilled, (state, action) => {\n   208→        const { issueId, status } = action.payload;\n   209→        const issue = state.cycleIssues.find((i) => i.id === issueId);\n   210→        if (issue) {\n   211→          issue.status = status;\n   212→        }\n   213→      });\n   214→  },\n   215→});\n   216→\n   217→export const {\n   218→  setSelectedCycleId,\n   219→  setCycleGroupBy,\n   220→  setCycleSortBy,\n   221→  toggleCycleIssueSelection,\n   222→  selectCycleGroupIssues,\n   223→  clearCycleSelection,\n   224→} = cyclesSlice.actions;\n   225→\n   226→export default cyclesSlice.reducer;\n   227→"}]},"parent_tool_use_id":null,"session_id":"54b4dc3a-146d-4ec6-8623-05191aa19d81","uuid":"7222c63f-5460-412f-83b6-dfd82377240d","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/src/slices/cyclesSlice.ts","content":"import { createSlice, createAsyncThunk } from '@reduxjs/toolkit';\nimport type { Issue } from './issuesSlice';\nimport { updateIssueStatus } from './issuesSlice';\n\nexport interface CycleSummary {\n  id: string;\n  name: string;\n  startDate: string;\n  endDate: string;\n  teamId: string;\n  issueCount: number;\n  doneCount: number;\n  inProgressCount: number;\n  isActive: boolean;\n}\n\nexport interface CycleIssue extends Issue {\n  cycleName: string | null;\n}\n\nexport interface BurndownEntry {\n  date: string;\n  count: number;\n}\n\nexport interface CycleDetail {\n  id: string;\n  name: string;\n  startDate: string;\n  endDate: string;\n  teamId: string;\n}\n\ninterface CycleDetailMember {\n  id: string;\n  name: string;\n  email: string;\n}\n\ninterface CyclesState {\n  cycles: CycleSummary[];\n  loading: boolean;\n  error: string | null;\n  selectedCycleId: string | null;\n  cycleDetail: CycleDetail | null;\n  cycleIssues: CycleIssue[];\n  cycleMembers: CycleDetailMember[];\n  burndown: BurndownEntry[];\n  detailLoading: boolean;\n  detailError: string | null;\n  groupBy: 'status' | 'priority' | 'assignee' | 'project' | 'label' | 'none';\n  sortBy: 'priority' | 'created' | 'updated' | 'status';\n  selectedIds: string[];\n}\n\nconst initialState: CyclesState = {\n  cycles: [],\n  loading: false,\n  error: null,\n  selectedCycleId: null,\n  cycleDetail: null,\n  cycleIssues: [],\n  cycleMembers: [],\n  burndown: [],\n  detailLoading: false,\n  detailError: null,\n  groupBy: 'status',\n  sortBy: 'priority',\n  selectedIds: [],\n};\n\nexport const fetchCycles = createAsyncThunk(\n  'cycles/fetchCycles',\n  async (teamId: string, { getState, rejectWithValue }) => {\n    const state = getState() as { auth: { token: string | null } };\n    const token = state.auth.token;\n    if (!token) return rejectWithValue('No token');\n    const response = await fetch(`/api/cycles?teamId=${teamId}`, {\n      headers: { Authorization: `Bearer ${token}` },\n    });\n    if (!response.ok) {\n      return rejectWithValue('Failed to fetch cycles');\n    }\n    return await response.json() as { cycles: CycleSummary[] };\n  }\n);\n\nexport const fetchCycleIssues = createAsyncThunk(\n  'cycles/fetchCycleIssues',\n  async (cycleId: string, { getState, rejectWithValue }) => {\n    const state = getState() as { auth: { token: string | null } };\n    const token = state.auth.token;\n    if (!token) return rejectWithValue('No token');\n    const response = await fetch(`/api/cycle-issues?cycleId=${cycleId}`, {\n      headers: { Authorization: `Bearer ${token}` },\n    });\n    if (!response.ok) {\n      return rejectWithValue('Failed to fetch cycle issues');\n    }\n    return await response.json() as {\n      cycle: CycleDetail;\n      issues: CycleIssue[];\n      members: CycleDetailMember[];\n      burndown: BurndownEntry[];\n    };\n  }\n);\n\nexport const createCycle = createAsyncThunk(\n  'cycles/createCycle',\n  async (\n    payload: { teamId: string; name: string; startDate: string; endDate: string },\n    { getState, rejectWithValue }\n  ) => {\n    const state = getState() as { auth: { token: string | null } };\n    const token = state.auth.token;\n    if (!token) return rejectWithValue('No token');\n    const response = await fetch('/api/cycles', {\n      method: 'POST',\n      headers: {\n        'Content-Type': 'application/json',\n        Authorization: `Bearer ${token}`,\n      },\n      body: JSON.stringify(payload),\n    });\n    if (!response.ok) {\n      return rejectWithValue('Failed to create cycle');\n    }\n    return await response.json() as CycleSummary;\n  }\n);\n\nconst cyclesSlice = createSlice({\n  name: 'cycles',\n  initialState,\n  reducers: {\n    setSelectedCycleId(state, action: { payload: string | null }) {\n      state.selectedCycleId = action.payload;\n    },\n    setCycleGroupBy(state, action: { payload: CyclesState['groupBy'] }) {\n      state.groupBy = action.payload;\n    },\n    setCycleSortBy(state, action: { payload: CyclesState['sortBy'] }) {\n      state.sortBy = action.payload;\n    },\n    toggleCycleIssueSelection(state, action: { payload: string }) {\n      const id = action.payload;\n      const idx = state.selectedIds.indexOf(id);\n      if (idx >= 0) {\n        state.selectedIds.splice(idx, 1);\n      } else {\n        state.selectedIds.push(id);\n      }\n    },\n    selectCycleGroupIssues(state, action: { payload: string[] }) {\n      const ids = action.payload;\n      const allSelected = ids.every((id) => state.selectedIds.includes(id));\n      if (allSelected) {\n        state.selectedIds = state.selectedIds.filter((id) => !ids.includes(id));\n      } else {\n        const newIds = ids.filter((id) => !state.selectedIds.includes(id));\n        state.selectedIds.push(...newIds);\n      }\n    },\n    clearCycleSelection(state) {\n      state.selectedIds = [];\n    },\n  },\n  extraReducers: (builder) => {\n    builder\n      .addCase(fetchCycles.pending, (state) => {\n        if (state.cycles.length === 0) {\n          state.loading = true;\n        }\n        state.error = null;\n      })\n      .addCase(fetchCycles.fulfilled, (state, action) => {\n        state.loading = false;\n        state.cycles = action.payload.cycles;\n      })\n      .addCase(fetchCycles.rejected, (state, action) => {\n        state.loading = false;\n        state.error = action.payload as string;\n      })\n      .addCase(fetchCycleIssues.pending, (state) => {\n        if (state.cycleIssues.length === 0) {\n          state.detailLoading = true;\n        }\n        state.detailError = null;\n      })\n      .addCase(fetchCycleIssues.fulfilled, (state, action) => {\n        state.detailLoading = false;\n        state.cycleDetail = action.payload.cycle;\n        state.cycleIssues = action.payload.issues;\n        state.cycleMembers = action.payload.members;\n        state.burndown = action.payload.burndown;\n        state.selectedIds = [];\n      })\n      .addCase(fetchCycleIssues.rejected, (state, action) => {\n        state.detailLoading = false;\n        state.detailError = action.payload as string;\n      })\n      .addCase(createCycle.fulfilled, (state, action) => {\n        state.cycles.push(action.payload);\n        state.cycles.sort((a, b) => a.startDate.localeCompare(b.startDate));\n      })\n      .addCase(updateIssueStatus.fulfilled, (state, action) => {\n        const { issueId, status } = action.payload;\n        const issue = state.cycleIssues.find((i) => i.id === issueId);\n        if (issue) {\n          issue.status = status;\n        }\n      });\n  },\n});\n\nexport const {\n  setSelectedCycleId,\n  setCycleGroupBy,\n  setCycleSortBy,\n  toggleCycleIssueSelection,\n  selectCycleGroupIssues,\n  clearCycleSelection,\n} = cyclesSlice.actions;\n\nexport default cyclesSlice.reducer;\n","numLines":227,"startLine":1,"totalLines":227}}}
