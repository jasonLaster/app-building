[2026-03-14T19:59:18.791Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KsTKesyFDGgiMLUEn786cj","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions';\n     2→import { getSql } from './db';\n     3→\n     4→export default async function handler(req: Request, _context: Context) {\n     5→  try {\n     6→    const authHeader = req.headers.get('Authorization');\n     7→    if (!authHeader?.startsWith('Bearer ')) {\n     8→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n     9→        status: 401,\n    10→        headers: { 'Content-Type': 'application/json' },\n    11→      });\n    12→    }\n    13→\n    14→    const token = authHeader.slice(7);\n    15→    const sql = getSql();\n    16→\n    17→    const sessions = await sql`\n    18→      SELECT s.member_id FROM sessions s\n    19→      WHERE s.token = ${token} AND s.expires_at > NOW()\n    20→    `;\n    21→    const session = sessions[0];\n    22→    if (!session) {\n    23→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    24→        status: 401,\n    25→        headers: { 'Content-Type': 'application/json' },\n    26→      });\n    27→    }\n    28→\n    29→    const url = new URL(req.url);\n    30→\n    31→    if (req.method === 'GET') {\n    32→      const teamId = url.searchParams.get('teamId');\n    33→      if (!teamId) {\n    34→        return new Response(JSON.stringify({ error: 'teamId is required' }), {\n    35→          status: 400,\n    36→          headers: { 'Content-Type': 'application/json' },\n    37→        });\n    38→      }\n    39→\n    40→      // Fetch all cycles for the team with issue stats\n    41→      const cycles = await sql`\n    42→        SELECT\n    43→          c.id,\n    44→          c.name,\n    45→          c.start_date,\n    46→          c.end_date,\n    47→          c.team_id,\n    48→          COUNT(i.id)::int AS issue_count,\n    49→          COUNT(CASE WHEN i.status = 'done' THEN 1 END)::int AS done_count,\n    50→          COUNT(CASE WHEN i.status = 'in_progress' OR i.status = 'in_review' THEN 1 END)::int AS in_progress_count\n    51→        FROM cycles c\n    52→        LEFT JOIN issues i ON i.cycle_id = c.id\n    53→        WHERE c.team_id = ${teamId}\n    54→        GROUP BY c.id, c.name, c.start_date, c.end_date, c.team_id\n    55→        ORDER BY c.start_date ASC\n    56→      `;\n    57→\n    58→      // Determine active cycle: current date falls within start_date and end_date\n    59→      const now = new Date();\n    60→      const enrichedCycles = cycles.map((c) => {\n    61→        const startDate = new Date(String(c.start_date).split('T')[0] + 'T00:00:00');\n    62→        const endDate = new Date(String(c.end_date).split('T')[0] + 'T23:59:59');\n    63→        const isActive = now >= startDate && now <= endDate;\n    64→        return {\n    65→          id: c.id,\n    66→          name: c.name,\n    67→          startDate: String(c.start_date).split('T')[0],\n    68→          endDate: String(c.end_date).split('T')[0],\n    69→          teamId: c.team_id,\n    70→          issueCount: c.issue_count,\n    71→          doneCount: c.done_count,\n    72→          inProgressCount: c.in_progress_count,\n    73→          isActive,\n    74→        };\n    75→      });\n    76→\n    77→      return new Response(JSON.stringify({ cycles: enrichedCycles }), {\n    78→        status: 200,\n    79→        headers: { 'Content-Type': 'application/json' },\n    80→      });\n    81→    }\n    82→\n    83→    if (req.method === 'POST') {\n    84→      const body = await req.json() as {\n    85→        teamId: string;\n    86→        name: string;\n    87→        startDate: string;\n    88→        endDate: string;\n    89→      };\n    90→\n    91→      if (!body.teamId || !body.name || !body.startDate || !body.endDate) {\n    92→        return new Response(JSON.stringify({ error: 'All fields are required' }), {\n    93→          status: 400,\n    94→          headers: { 'Content-Type': 'application/json' },\n    95→        });\n    96→      }\n    97→\n    98→      const result = await sql`\n    99→        INSERT INTO cycles (name, start_date, end_date, team_id)\n   100→        VALUES (${body.name}, ${body.startDate}, ${body.endDate}, ${body.teamId})\n   101→        RETURNING id, name, start_date, end_date, team_id\n   102→      `;\n   103→\n   104→      const cycle = result[0];\n   105→      if (!cycle) {\n   106→        return new Response(JSON.stringify({ error: 'Failed to create cycle' }), {\n   107→          status: 500,\n   108→          headers: { 'Content-Type': 'application/json' },\n   109→        });\n   110→      }\n   111→\n   112→      return new Response(JSON.stringify({\n   113→        id: cycle.id,\n   114→        name: cycle.name,\n   115→        startDate: String(cycle.start_date).split('T')[0],\n   116→        endDate: String(cycle.end_date).split('T')[0],\n   117→        teamId: cycle.team_id,\n   118→        issueCount: 0,\n   119→        doneCount: 0,\n   120→        inProgressCount: 0,\n   121→        isActive: false,\n   122→      }), {\n   123→        status: 201,\n   124→        headers: { 'Content-Type': 'application/json' },\n   125→      });\n   126→    }\n   127→\n   128→    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n   129→      status: 405,\n   130→      headers: { 'Content-Type': 'application/json' },\n   131→    });\n   132→  } catch (err) {\n   133→    console.error('Cycles error:', err);\n   134→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n   135→      status: 500,\n   136→      headers: { 'Content-Type': 'application/json' },\n   137→    });\n   138→  }\n   139→}\n   140→"}]},"parent_tool_use_id":"toolu_0117Tuu1QNw947AjWT71VE25","session_id":"54b4dc3a-146d-4ec6-8623-05191aa19d81","uuid":"27796b8c-131e-42be-a877-034852af3cd0"}
