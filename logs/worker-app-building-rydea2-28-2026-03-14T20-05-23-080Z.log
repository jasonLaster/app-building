.title,\n   103→      description: issue.description,\n   104→      status: issue.status,\n   105→      priority: issue.priority,\n   106→      identifier: `${issue.team_identifier}-${issue.number}`,\n   107→      number: issue.number,\n   108→      dueDate: issue.due_date ? String(issue.due_date).split('T')[0] : null,\n   109→      createdAt: issue.created_at,\n   110→      updatedAt: issue.updated_at,\n   111→      teamId: issue.team_id,\n   112→      teamName: issue.team_name,\n   113→      assigneeId: issue.assignee_id,\n   114→      assigneeName: issue.assignee_name,\n   115→      assigneeEmail: issue.assignee_email,\n   116→      projectId: issue.project_id,\n   117→      projectName: issue.project_name,\n   118→      cycleId: issue.cycle_id,\n   119→      cycleName: issue.cycle_name,\n   120→      parentId: issue.parent_id,\n   121→      labels: labelsByIssue[issue.id] || [],\n   122→    }));\n   123→\n   124→    // Also fetch team members for assignee filter\n   125→    const members = await sql`\n   126→      SELECT m.id, m.name, m.email\n   127→      FROM members m\n   128→      JOIN team_members tm ON tm.member_id = m.id\n   129→      WHERE tm.team_id = ${teamId}\n   130→      ORDER BY m.name ASC\n   131→    `;\n   132→\n   133→    // Fetch team projects for project filter\n   134→    const projects = await sql`\n   135→      SELECT DISTINCT p.id, p.name\n   136→      FROM projects p\n   137→      JOIN issues i ON i.project_id = p.id\n   138→      WHERE i.team_id = ${teamId}\n   139→      ORDER BY p.name ASC\n   140→    `;\n   141→\n   142→    // Fetch team cycles for cycle filter\n   143→    const cycles = await sql`\n   144→      SELECT c.id, c.name, c.start_date, c.end_date\n   145→      FROM cycles c\n   146→      WHERE c.team_id = ${teamId}\n   147→      ORDER BY c.start_date DESC\n   148→    `;\n   149→\n   150→    return new Response(JSON.stringify({\n   151→      issues: enrichedIssues,\n   152→      members,\n   153→      projects,\n   154→      