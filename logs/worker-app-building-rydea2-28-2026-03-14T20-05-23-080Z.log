cle-list\">\n    42→      {cycles.map((cycle) => {\n    43→        const percentage = cycle.issueCount > 0\n    44→          ? Math.round((cycle.doneCount / cycle.issueCount) * 100)\n    45→          : 0;\n    46→        const isSelected = selectedCycleId === cycle.id;\n    47→\n    48→        return (\n    49→          <button\n    50→            key={cycle.id}\n    51→            className={`cycle-list-row ${cycle.isActive ? 'cycle-list-row-active' : ''} ${isSelected ? 'cycle-list-row-selected' : ''}`}\n    52→            onClick={() => onSelectCycle(cycle.id)}\n    53→            data-testid={`cycle-row-${cycle.id}`}\n    54→          >\n    55→            <div className=\"cycle-list-row-left\">\n    56→              <div className=\"cycle-list-row-header\">\n    57→                <svg className=\"cycle-list-icon\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n    58→                  <polyline points=\"23 4 23 10 17 10\" />\n    59→                  <polyline points=\"1 20 1 14 7 14\" />\n    60→                  <path d=\"M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15\" />\n    61→                </svg>\n    62→                <span className=\"cycle-list-name\" data-testid={`cycle-name-${cycle.id}`}>{cycle.name}</span>\n    63→                {cycle.isActive && (\n    64→                  <span className=\"cycle-list-active-badge\" data-testid={`cycle-active-badge-${cycle.id}`}>Active</span>\n    65→                )}\n    66→              </div>\n    67→              <div className=\"cycle-list-meta\">\n    68→                <span className=\"cycle-list-dates\" data-testid={`cycle-dates-${cycle.id}`}>\n    69→                  {formatDateRange(cycle.startDate, cycle.endDate)}\n    70→                </span>\n    71→                <span className=\"cycle-list-issue-count\" data-testid={`cycle-issue-count-${cycle.id}`}>\n    72→                  {cycle.issueCount} {cycle.issueCount === 1 ? 'issue' : 'issues'}\n    73→                </span>\n    74→              </div>\n    75→            </div>\n    76→            <div className=\"cycle-list-row-right\">\n    77→              <div className=\"cycle-list-progress-wrapper\">\n    78→                <div className=\"cycle-list-progress-bar\" data-testid={`cycle-progress-${cycle.id}`}>\n    79→                  <div\n    80→                    className=\"cycle-list-progress-fill\"\n    81→                    style={{ width: `${percentage}%` }}\n    82→                  />\n    83→                </div>\n    84→                <span className=\"cycle-list-progress-text\">{percentage}%</span>\n    85→              </div>\n    86→            </div>\n    87→          </button>\n    88→        );\n    89→      })}\n    90→    </div>\n    91→  );\n    92→}\n    93→"}]},"parent_tool_use_id":null,"session_id":"54b4dc3a-146d-4ec6-8623-05191aa19d81","uuid":"d1769a55-f830-449a-8444-b530ce3dc9db","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/src/components/CycleList.tsx","content":"import type { CycleSummary } from '../slices/cyclesSlice';\nimport './CycleList.css';\n\nfunction formatDateRange(startDate: string, endDate: string): string {\n  const start = new Date(startDate + 'T00:00:00');\n  const end = new Date(endDate + 'T00:00:00');\n  const opts: Intl.DateTimeFormatOptions = { month: 'short', day: 'numeric' };\n  return `${start.toLocaleDateString('en-US', opts)} – ${end.toLocaleDateString('en-US', opts)}`;\n}\n\ninterface CycleListProps {\n  cycles: CycleSummary[];\n  loading: boolean;\n  selectedCycleId: string | null;\n  onSelectCycle: (cycleId: string) => void;\n}\n\nexport default function CycleList({ cycles, loading, selectedCycleId, onSelectCycle }: CycleListProps) {\n  if (loading) {\n    return (\n      <div className=\"cycle-list-loading\" data-testid=\"cycle-list-loading\">\n        Loading...\n      </div>\n    );\n  }\n\n  if (cycles.length === 0) {\n    return (\n      <div className=\"cycle-list-empty\" data-testid=\"cycle-list-empty\">\n        <svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--color-text-tertiary)\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n          <polyline points=\"23 4 23 10 17 10\" />\n          <polyline points=\"1 20 1 14 7 14\" />\n          <path d=\"M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15\" />\n        </svg>\n        <p>No cycles yet. Create your first cycle to get started.</p>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"cycle-list\" data-testid=\"cycle-list\">\n      {cycles.map((cycle) => {\n        const percentage = cycle.issueCount > 0\n          ? Math.round((cycle.doneCount / cycle.issueCount) * 100)\n          : 0;\n        const isSelected = selectedCycleId === cycle.id;\n\n        return (\n          <button\n            key={cycle.id}\n            className={`cycle-list-row ${cycle.isActive ? 'cycle-list-row-active' : ''} ${isSelected ? 'cycle-list-row-selected' : ''}`}\n            onClick={() => onSelectCycle(cycle.id)}\n            data-testid={`cycle-row-${cycle.id}`}\n          >\n            <div className=\"cycle-list-row-left\">\n              <div className=\"cycle-list-row-header\">\n                <svg className=\"cycle-list-icon\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n                  <polyline points=\"23 4 23 10 17 10\" />\n                  <polyline points=\"1 20 1 14 7 14\" />\n                  <path d=\"M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15\" />\n                </svg>\n                <span className=\"cycle-list-name\" data-testid={`cycle-name-${cycle.id}`}>{cycle.name}</span>\n                {cycle.isActive && (\n                  <span className=\"cycle-list-active-badge\" data-testid={`cycle-active-badge-${cycle.id}`}>Active</span>\n                )}\n              </div>\n              <div className=\"cycle-list-meta\">\n                <span className=\"cycle-list-dates\" data-testid={`cycle-dates-${cycle.id}`}>\n                  {formatDateRange(cycle.startDate, cycle.endDate)}\n                </span>\n                <span className=\"cycle-list-issue-count\" data-testid={`cycle-issue-count-${cycle.id}`}>\n                  {cycle.issueCount} {cycle.issueCount === 1 ? 'issue' : 'issues'}\n                </span>\n              </div>\n            </div>\n            <div className=\"cycle-list-row-right\">\n              <div className=\"cycle-list-progress-wrapper\">\n                <div className=\"cycle-list-progress-bar\" data-testid={`cycle-progress-${cycle.id}`}>\n                  <div\n                    className=\"cycle-list-progress-fill\"\n                    style={{ width: `${percentage}%` }}\n                  />\n                </div>\n                <span className=\"cycle-list-progress-text\">{percentage}%</span>\n              </div>\n            </div>\n          </button>\n        );\n      })}\n    </div>\n  );\n}\n","numLines":93,"startLine":1,"totalLines":93}}}
