\n  color: var(--color-text-secondary);\n}\n\n.project-card-avatar {\n  width: 20px;\n  height: 20px;\n  border-radius: 50%;\n  background-color: var(--color-accent);\n  color: #fff;\n  font-size: 9px;\n  font-weight: 600;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n\n.project-card-lead-name {\n  color: var(--color-text-secondary);\n}\n\n.project-card-no-lead {\n  color: var(--color-text-tertiary);\n  font-style: italic;\n}\n\n.project-card-date {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  font-size: 12px;\n  color: var(--color-text-secondary);\n}\n\n.project-card-date svg {\n  color: var(--color-text-tertiary);\n}\n\n.project-card-no-date {\n  color: var(--color-text-tertiary);\n  font-style: italic;\n}\n\n.project-card-progress {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.project-card-progress-bar {\n  flex: 1;\n  height: 4px;\n  background-color: var(--color-border);\n  border-radius: 2px;\n  overflow: hidden;\n}\n\n.project-card-progress-fill {\n  height: 100%;\n  background-color: var(--color-accent);\n  border-radius: 2px;\n  transition: width 300ms ease;\n}\n\n.project-card-progress-complete {\n  background-color: #22c55e;\n}\n\n.project-card-progress-text {\n  font-size: 11px;\n  color: var(--color-text-tertiary);\n  white-space: nowrap;\n  flex-shrink: 0;\n}\n\n.project-card-teams {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  flex-wrap: wrap;\n}\n\n.project-card-team-icon {\n  width: 24px;\n  height: 24px;\n  border-radius: 4px;\n  background-color: rgba(94, 106, 210, 0.15);\n  color: var(--color-accent);\n  font-size: 9px;\n  font-weight: 700;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n  letter-spacing: 0.5px;\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1418,"cache_read_input_tokens":81628,"cache_creation":{"ephemeral_5m_input_