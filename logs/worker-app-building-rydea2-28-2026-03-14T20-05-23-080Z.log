nd-color: rgba(0, 0, 0, 0.6);\n  backdrop-filter: blur(2px);\n}\n\n.create-issue-modal {\n  background-color: var(--color-bg-surface);\n  border: 1px solid var(--color-border);\n  border-radius: 12px;\n  width: 100%;\n  max-width: 560px;\n  max-height: 85vh;\n  display: flex;\n  flex-direction: column;\n  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);\n}\n\n.cim-header {\n  padding: 20px 24px 0;\n}\n\n.cim-title {\n  font-size: 16px;\n  font-weight: 600;\n  color: var(--color-text-primary);\n  margin: 0;\n}\n\n.cim-body {\n  padding: 16px 24px;\n  overflow-y: auto;\n  flex: 1;\n}\n\n.cim-footer {\n  padding: 0 24px 20px;\n}\n\n.cim-success {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 12px;\n  padding: 40px 24px;\n  font-size: 15px;\n  color: var(--color-text-primary);\n}\n\n.cim-success strong {\n  color: var(--color-accent);\n}\n","numLines":58,"startLine":1,"totalLines":58}}}
