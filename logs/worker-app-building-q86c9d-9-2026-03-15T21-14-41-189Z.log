[2026-03-15T20:51:09.230Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VhXxBrEiFZjiRU173Vjjnf","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test'\n     2→\n     3→// Helper to log in as a user\n     4→async function loginAs(page: import('@playwright/test').Page, email: string) {\n     5→  await page.goto('/login')\n     6→  await page.getByTestId('login-email-input').fill(email)\n     7→  await page.getByTestId('login-submit-button').click()\n     8→  await expect(page).toHaveURL('/', { timeout: 30000 })\n     9→}\n    10→\n    11→const EMMA_ID = 'a3333333-3333-3333-3333-333333333333'\n    12→\n    13→// Properties that should be in Emma's favorites (seed state)\n    14→const EMMA_FAVORITED = [\n    15→  'b2222222-2222-2222-2222-222222222222',\n    16→  'b3333333-3333-3333-3333-333333333333',\n    17→]\n    18→\n    19→// Properties used in tests that should NOT be in Emma's favorites (seed state)\n    20→const EMMA_NOT_FAVORITED = [\n    21→  'b1111111-1111-1111-1111-111111111111',\n    22→  'b4444444-4444-4444-4444-444444444444',\n    23→  'b5555555-5555-5555-5555-555555555555',\n    24→]\n    25→\n    26→test.describe('Home Page - FavoriteButton', () => {\n    27→  // Reset Emma's favorites to seed state before each test\n    28→  test.beforeEach(async ({ request }) => {\n    29→    for (const propertyId of EMMA_FAVORITED) {\n    30→      await request.post('/api/favorites', {\n    31→        data: { user_id: EMMA_ID, property_id: propertyId },\n    32→      })\n    33→    }\n    34→    for (const propertyId of EMMA_NOT_FAVORITED) {\n    35→      await request.delete(`/api/favorites/${propertyId}?user_id=${EMMA_ID}`)\n    36→    }\n    37→  })\n    38→\n    39→  test('Favorite button shows outline heart when property is not favorited', async ({ page }) => {\n    40→    // Log in as Emma (favorites: b2222222, b3333333 — NOT b1111111)\n    41→    await loginAs(page, 'emma@example.com')\n    42→\n    43→    await expect(page.getByTestId('property-grid')).toBeVisible({ timeout: 30000 })\n    44→    await expect(page.locator('[data-testid^=\"property-card-\"]').first()).toBeVisible({ timeout: 15000 })\n    45→\n    46→    // b1111111 is NOT in Emma's favorites\n    47→    const favBtn = page.getByTestId('favorite-button-b1111111-1111-1111-1111-111111111111')\n    48→    await expect(favBtn).toBeVisible({ timeout: 15000 })\n    49→\n    50→    // Heart should not have the filled class (fill-primary)\n    51→    const heart = favBtn.locator('svg')\n    52→    await expect(heart).not.toHaveClass(/fill-primary/)\n    53→    await expect(heart).toHaveClass(/text-text-secondary/)\n    54→  })\n    55→\n    56→  test('Clicking favorite button on unfavorited property adds it to favorites', async ({ page }) => {\n    57→    // Log in as Emma (favorites: b2222222, b3333333 — NOT b4444444)\n    58→    await loginAs(page, 'emma@example.com')\n    59→\n    60→    await expect(page.getByTestId('property-grid')).toBeVisible({ timeout: 30000 })\n    61→    await expect(page.locator('[data-testid^=\"property-card-\"]').first()).toBeVisible({ timeout: 15000 })\n    62→\n    63→    // b4444444 is NOT in Emma's favorites\n    64→    const favBtn = page.getByTestId('favorite-button-b4444444-4444-4444-4444-444444444444')\n    65→    await expect(favBtn).toBeVisible({ timeout: 15000 })\n    66→\n    67→    // Verify it's not favorited initially\n    68→    const heart = favBtn.locator('svg')\n    69→    await expect(heart).toHaveClass(/text-text-secondary/, { timeout: 15000 })\n    70→\n    71→    // Click to favorite\n    72→    await favBtn.click()\n    73→\n    74→    // Heart should become filled\n    75→    await expect(heart).toHaveClass(/fill-primary/, { timeout: 15000 })\n    76→  })\n    77→\n    78→  test('Clicking favorite button on favorited property removes it from favorites', async ({ page }) => {\n    79→    // Log in as Emma (favorites: b2222222, b3333333)\n    80→    await loginAs(page, 'emma@example.com')\n    81→\n    82→    await expect(page.getByTestId('property-grid')).toBeVisible({ timeout: 30000 })\n    83→    await expect(page.locator('[data-testid^=\"property-card-\"]').first()).toBeVisible({ timeout: 15000 })\n    84→\n    85→    // b2222222 IS in Emma's favorites\n    86→    const favBtn = page.getByTestId('favorite-button-b2222222-2222-2222-2222-222222222222')\n    87→    await expect(favBtn).toBeVisible({ timeout: 15000 })\n    88→\n    89→    // Verify it's favorited initially (filled heart)\n    90→    const heart = favBtn.locator('svg')\n    91→    await expect(heart).toHaveClass(/fill-primary/, { timeout: 15000 })\n    92→\n    93→    // Click to unfavorite\n    94→    await favBtn.click()\n    95→\n    96→    // Heart should return to outline\n    97→    await expect(heart).toHaveClass(/text-text-secondary/, { timeout: 15000 })\n    98→  })\n    99→\n   100→  test('Favorite button does not navigate to property detail page', async ({ page }) => {\n   101→    await loginAs(page, 'emma@example.com')\n   102→\n   103→    await expect(page.getByTestId('property-grid')).toBeVisible({ timeout: 30000 })\n   104→    await expect(page.locator('[data-testid^=\"property-card-\"]').first()).toBeVisible({ timeout: 15000 })\n   105→\n   106→    const favBtn = page.getByTestId('favorite-button-b1111111-1111-1111-1111-111111111111')\n   107→    await expect(favBtn).toBeVisible({ timeout: 15000 })\n   108→\n   109→    // Click the favorite button\n   110→    await favBtn.click()\n   111→\n   112→    // Should remain on the home page, not navigate to property detail\n   113→    await expect(page).toHaveURL('/', { timeout: 5000 })\n   114→  })\n   115→\n   116→  test('Favorite button is not shown when user is not logged in', async ({ page }) => {\n   117→    await page.goto('/')\n   118→\n   119→    await expect(page.getByTestId('property-grid')).toBeVisible({ timeout: 30000 })\n   120→    await expect(page.locator('[data-testid^=\