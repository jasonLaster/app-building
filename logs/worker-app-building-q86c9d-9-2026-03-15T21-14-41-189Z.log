15000 })\n    68→    await expect(page.getByTestId('property-grid')).toContainText('New York')\n    69→  })\n    70→\n    71→  test('Clearing search fields and re-searching shows all results', async ({ page }) => {\n    72→    await page.goto('/')\n    73→    await expect(page.locator('[data-testid^=\"property-card-\"]').first()).toBeVisible({ timeout: 30000 })\n    74→\n    75→    const cards = page.locator('[data-testid^=\"property-card-\"]')\n    76→\n    77→    // Search by location\n    78→    await page.getByTestId('search-location').fill('New York')\n    79→    await page.getByTestId('search-button').click()\n    80→    await expect(cards).toHaveCount(1, { timeout: 15000 })\n    81→\n    82→    // Clear and re-search\n    83→    await page.getByTestId('search-location').fill('')\n    84→    await page.getByTestId('search-button').click()\n    85→    await expect(cards).toHaveCount(5, { timeout: 15000 })\n    86→  })\n    87→\n    88→  test('Search bar is functional on repeated use', async ({ page }) => {\n    89→    test.slow()\n    90→    await page.goto('/')\n    91→    await expect(page.locator('[data-testid^=\"property-card-\"]').first()).toBeVisible({ timeout: 30000 })\n    92→\n    93→    const cards = page.locator('[data-testid^=\"property-card-\"]')\n    94→\n    95→    // First search: New York\n    96→    await page.getByTestId('search-location').fill('New York')\n    97→    await page.getByTestId('search-button').click()\n    98→    await expect(cards).toHaveCount(1, { timeout: 15000 })\n    99→    await expect(page.getByTestId('property-grid')).toContainText('New York')\n   100→\n   101→    // Second search: Austin\n   102→    await page.getByTestId('search-location').fill('')\n   103→    await page.getByTestId('search-location').fill('Austin')\n   104→    await page.getByTestId('search-button').click()\n   105→    await expect(cards).toHaveCount(1, { timeout: 15000 })\n   106→    await expect(page.getByTestId('property-grid')).toContainText('Aust