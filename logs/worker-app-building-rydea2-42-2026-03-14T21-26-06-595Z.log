  Authorization: `Bearer ${token}`,\n    47→    },\n    48→    body: JSON.stringify(issueData),\n    49→  });\n    50→  return response.json();\n    51→}\n    52→\n    53→test.describe('IssueRow', () => {\n    54→  test('Issue row displays all required fields', async ({ page, baseURL }) => {\n    55→    // Create an issue with all fields set via API\n    56→    const { token, user } = await loginViaApi(baseURL!, 'alice@acme.com', 'password123');\n    57→    const teams = await getTeams(baseURL!, token);\n    58→    const engTeam = teams.find((t: { identifier: string }) => t.identifier === 'ENG');\n    59→    const labels = await getLabels(baseURL!, token);\n    60→    const bugLabel = labels.find((l: { name: string }) => l.name === 'Bug');\n    61→\n    62→    // Get projects via team-issues\n    63→    const teamResponse = await fetch(`${baseURL}/api/team-issues?teamId=${engTeam.id}`, {\n    64→      headers: { Authorization: `Bearer ${token}` },\n    65→    });\n    66→    const teamData = await teamResponse.json();\n    67→    const v2Project = teamData.projects?.find((p: { name: string }) => p.name === 'V2 Launch');\n    68→\n    69→    const issueTitle = `All fields issue ${Date.now()}`;\n    70→    const createResult = await createIssueViaApi(baseURL!, token, {\n    71→      teamId: engTeam.id,\n    72→      title: issueTitle,\n    73→      status: 'in_progress',\n    74→      priority: 'high',\n    75→      assigneeId: user.id,\n    76→      labelIds: [bugLabel.id],\n    77→      projectId: v2Project?.id || null,\n    78→      dueDate: '2026-03-20',\n    79→    });\n    80→    const createdIssue = createResult.issue;\n    81→\n    82→    await page.goto('/login');\n    83→    await page.evaluate((t) => localStorage.setItem('session_token', t), token);\n    84→    await page.goto('/my-issues');\n    85→    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n    86→\n    87→    // Find the created issue row\n    88→    const issueRow = page.getByTestId(`issue-row-${createdIssue.id}`);\n    89→    await expect(issueRow).toBeVisible({ timeout: 30000 });\n    90→\n    91→    // Verify priority icon\n    92→    await expect(page.getByTestId(`issue-priority-${createdIssue.id}`)).toBeVisible();\n    93→\n    94→    // Verify identifier\n    95→    await expect(page.getByTestId(`issue-identifier-${createdIssue.id}`)).toHaveText(createdIssue.identifier);\n    96→\n    97→    // Verify title\n    98→    await expect(page.getByTestId(`issue-title-${createdIssue.id}`)).toHaveText(issueTitle);\n    99→\n   100→    // Verify status button\n   101→    await expect(page.getByTestId(`issue-status-btn-${createdIssue.id}`)).toBeVisible();\n   102→\n   103→    // Verify label badge\n   104→    await expect(page.getByTestId(`issue-labels-${createdIssue.id}`)).toBeVisible();\n   105→    await expect(page.getByTestId(`issue-label-${createdIssue.id}-${bugLabel.id}`)).toContainText('Bug');\n   106→\n   107→    // Verify assignee\n   108→    await expect(page.getByTestId(`issue-assignee-${createdIssue.id}`)).toBeVisible();\n   109→    await expect(page.getByTestId(`issue-assignee-${createdIssue.id}`)).toHaveText('AJ');\n   110→\n   111→    // Verify due date\n   112→    await expect(page.getByTestId(`issue-due-date-${createdIssue.id}`)).toBeVisible();\n   113→    await expect(page.getByTestId(`issue-due-date-${createdIssue.id}`)).toHaveText('Mar 20');\n   114→\n   115→    // Verify project name\n   116→    await expect(page.getByTestId(`issue-project-${createdIssue.id}`)).toBeVisible();\n   117→    await expect(page.getByTestId(`issue-project-${createdIssue.id}`)).toHaveText('V2 Launch');\n   118→  });\n   119→\n   120→  test('Issue row title is clickable and navigates to issue detail', async ({ page, baseURL }) => {\n   121→    const { token } = await loginViaApi(baseURL!, 'alice@acme.com', 'password123');\n   122→    const issues = await getMyIssues(baseURL!, token);\n   123→    const eng1 = issues.find((i: { identifier: string }) => i.identifier === 'ENG-1');\n   124→\n   125→    await page.goto('/login');\n   126→    await page.evaluate((t) => localStorage.setItem('session_token', t), token);\n   127→    await page.goto('/my-issues');\n   128→    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n   129→\n   130→    // Click the issue title\n   131→    await page.getByTestId(`issue-title-${eng1.id}`).click();\n   132→\n   133→    // Verify navigation to issue detail page\n   134→    await expect(page).toHaveURL(new RegExp(`/issue/${eng1.id}`), { timeout: 30000 });\n   135→  });\n   136→\n   137→  test('Issue row status icon is clickable to change status', async ({ page, baseURL }) => {\n   138→    const { token } = await loginViaApi(baseURL!, 'alice@acme.com', 'password123');\n   139→    const issues = await getMyIssues(baseURL!, token);\n   140→    // Use ENG-6 which is 'todo' status\n   141→    const eng6 = issues.find((i: { identifier: string }) => i.identifier === 'ENG-6');\n   142→\n   143→    await page.goto('/login');\n   144→    await page.evaluate((t) => localStorage.setItem('session_token', t), token);\n   145→    await page.goto('/my-issues');\n   146→    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n   147→\n   148→    // Click the status icon\n   149→    await page.getByTestId(`issue-status-btn-${eng6.id}`).click();\n   150→\n   151→    // Verify dropdown appears with all statuses\n   152→    await expect(page.getByTestId(`issue-status-dropdown-${eng6.id}`)).toBeVisible({ timeout: 10000 });\n   153→    await expect(page.getByTestId('issue-status-option-backlog')).toBeVisible();\n   154→    await expect(page.getByTestId('issue-status-option-todo')).toBeVisible();\n   155→    await expect(page.getByTestId('issue-status-option-in_progress')).toBeVisible();\n   156→    await expect(page.getByTestId('issue-status-option-in_review')).toBeVisible();\n   157→    await expect(page.getByTestId('issue-status-option-done')).toBeVisible();\n   158→    await expect(page.getByTestId('issue-status-option-cancelled')).toBeVisible();\n   159→  });\n   160→\n   161→  test('Changing status via issue row status dropdown persists', async ({ page, baseURL }) => {\n   162→    const { token } = await loginViaApi(baseURL!, 'alice@acme.com', 'password123');\n   163→    const issues = await getMyIssues(baseURL!, token);\n   164→    const eng6 = issues.find((i: { identifier: string }) => i.identifier === 'ENG-6');\n   165→\n   166→    await page.goto('/login');\n   167→    await page.evaluate((t) => localStorage.setItem('session_token', t), token);\n   168→    await page.goto('/my-issues');\n   169→    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n   170→\n   171→    // Verify ENG-6 is in todo group initially\n   172→    const todoItems = page.getByTestId('issue-group-items-todo');\n   173→    await expect(todoItems).toBeVisible({ timeout: 30000 });\n   174→    await expect(todoItems.getByTestId(`issue-row-${eng6.id}`)).toBeVisible();\n   175→\n   176→    // Open status dropdown and change to in_progress\n   177→    await page.getByTestId(`issue-status-btn-${eng6.id}`).click();\n   178→    await expect(page.getByTestId(`issue-status-dropdown-${eng6.id}`)).toBeVisible({ timeout: 10000 });\n   179→    await page.getByTestId('issue-status-option-in_progress').click();\n   180→\n   181→    // Verify dropdown closed\n   182→    await expect(page.getByTestId(`issue-status-dropdown-${eng6.id}`)).toHaveCount(0);\n   183→\n   184→    // Verify the issue moved to in_progress group\n   185→    await expect(page.getByTestId('issue-group-items-in_progress').getByTestId(`issue-row-${eng6.id}`)).toBeVisible({ timeout: 30000 });\n   186→\n   187→    // Verify persistence by reloading the page\n   188→    await page.reload();\n   189→    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n   190→    await expect(page.getByTestId('issue-group-items-in_progress').getByTestId(`issue-row-${eng6.id}`)).toBeVisible({ timeout: 30000 });\n   191→  });\n   192→\n   193→  test('Issue row status change updates group membership', async ({ page, baseURL }) => {\n   194→    const { token } = await loginViaApi(baseURL!, 'alice@acme.com', 'password123');\n   195→    const issues = await getMyIssues(baseURL!, token);\n   196→    const eng6 = issues.find((i: { identifier: string }) => i.identifier === 'ENG-6');\n   197→\n   198→    await page.goto('/login');\n   199→    await page.evaluate((t) => localStorage.setItem('session_token', t), token);\n   200→    await page.goto('/my-issues');\n   201→    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n   202→\n   203→    // Initial state: todo has 2, in_progress has 1\n   204→    await expect(page.getByTestId('issue-group-header-todo')).toContainText('(2)', { timeout: 30000 });\n   205→    await expect(page.getByTestId('issue-group-header-in_progress')).toContainText('(1)');\n   206→\n   207→    // Change ENG-6 from todo to in_progress\n   208→    await page.getByTestId(`issue-status-btn-${eng6.id}`).click();\n   209→    await expect(page.getByTestId(`issue-status-dropdown-${eng6.id}`)).toBeVisible({ timeout: 10000 });\n   210→    await page.getByTestId('issue-status-option-in_progress').click();\n   211→\n   212→    // Verify counts updated: todo has 1, in_progress has 2\n   213→    await expect(page.getByTestId('issue-group-header-todo')).toContainText('(1)');\n   214→    await expect(page.getByTestId('issue-group-header-in_progress')).toContainText('(2)');\n   215→  });\n   216→\n   217→  test('Issue row status dropdown can be used multiple times', async ({ page, baseURL }) => {\n   218→    test.slow();\n   219→\n   220→    const { token } = await loginViaApi(baseURL!, 'alice@acme.com', 'password123');\n   221→    const issues = await getMyIssues(baseURL!, token);\n   222→    const eng6 = issues.find((i: { identifier: string }) => i.identifier === 'ENG-6');\n   223→\n   224→    await page.goto('/login');\n   225→    await page.evaluate((t) => localStorage.setItem('session_token', t), token);\n   226→    await page.goto('/my-issues');\n   227→    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n   228→    await expect(page.getByTestId('issue-group-items-todo')).toBeVisible({ timeout: 30000 });\n   229→\n   230→    // First status change: todo -> in_progress\n   231→    await page.getByTestId(`issue-status-btn-${eng6.id}`).click();\n   232→    await expect(page.getByTestId(`issue-status-dropdown-${eng6.id}`)).toBeVisible({ timeout: 10000 });\n   233→    await page.getByTestId('issue-status-option-in_progress').click();\n   234→    await expect(page.getByTestId(`issue-status-dropdown-${eng6.id}`)).toHaveCount(0);\n   235→\n   236→    // Verify issue is in in_progress group\n   237→    await expect(page.getByTestId('issue-group-items-in_progress').getByTestId(`issue-row-${eng6.id}`)).toBeVisible({ timeout: 30000 });\n   238→\n   239→    // Second status change: in_progress -> done\n   240→    await page.getByTestId(`issue-status-btn-${eng6.id}`).click();\n   241→    await expect(page.getByTestId(`issue-status-dropdown-${eng6.id}`)).toBeVisible({ timeout: 10000 });\n   242→    await page.getByTestId('issue-status-option-done').click();\n   243→    await expect(page.getByTestId(`issue-status-dropdown-${eng6.id}`)).toHaveCount(0);\n   244→\n   245→    // Verify issue is in done group\n   246→    await expect(page.getByTestId('issue-group-items-done').getByTestId(`issue-row-${eng6.id}`)).toBeVisible({ timeout: 30000 });\n   247→  });\n   248→\n   249→  test('Issue row displays priority icon with correct color', async ({ page, baseURL }) => {\n   250→    // Alice has: ENG-6 (urgent), ENG-1 (high), DES-3 (low)\n   251→    const { token } = await loginViaApi(baseURL!, 'alice@acme.com', 'password123');\n   252→    const issues = await getMyIssues(baseURL!, token);\n   253→    const urgentIssue = issues.find((i: { identifier: string }) => i.identifier === 'ENG-6');\n   254→    const highIssue = issues.find((i: { identifier: string }) => i.identifier === 'ENG-1');\n   255→    const lowIssue = issues.find((i: { identifier: string }) => i.identifier === 'DES-3');\n   256→\n   257→    await page.goto('/login');\n   258→    await page.evaluate((t) => localStorage.setItem('session_token', t), token);\n   259→    await page.goto('/my-issues');\n   260→    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n   261→    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(3, { timeout: 30000 });\n   262→\n   263→    // Verify priority icons are present with correct titles\n   264→    await expect(page.getByTestId(`issue-priority-${urgentIssue.id}`)).toHaveAttribute('title', 'Urgent');\n   265→    await expect(page.getByTestId(`issue-priority-${highIssue.id}`)).toHaveAttribute('title', 'High');\n   266→    await expect(page.getByTestId(`issue-priority-${lowIssue.id}`)).toHaveAttribute('title', 'Low');\n   267→\n   268→    // Verify each priority icon contains an SVG\n   269→    await expect(page.getByTestId(`issue-priority-${urgentIssue.id}`).locator('svg')).toBeVisible();\n   270→    await expect(page.getByTestId(`issue-priority-${highIssue.id}`).locator('svg')).toBeVisible();\n   271→    await expect(page.getByTestId(`issue-priority-${lowIssue.id}`).locator('svg')).toBeVisible();\n   272→  });\n   273→\n   274→  test('Issue row displays labels as colored badges', async ({ page, baseURL }) => {\n   275→    // Create an issue with two labels\n   276→    const { token, user } = await loginViaApi(baseURL!, 'alice@acme.com', 'password123');\n   277→    const teams = await getTeams(baseURL!, token);\n   278→    const engTeam = teams.find((t: { identifier: string }) => t.identifier === 'ENG');\n   279→    const labels = await getLabels(baseURL!, token);\n   280→    const bugLabel = labels.find((l: { name: string }) => l.name === 'Bug');\n   281→    const featureLabel = labels.find((l: { name: string }) => l.name === 'Feature');\n   282→\n   283→    const createResult = await createIssueViaApi(baseURL!, token, {\n   284→      teamId: engTeam.id,\n   285→      title: `Multi-label issue ${Date.now()}`,\n   286→      status: 'todo',\n   287→      priority: 'medium',\n   288→      assigneeId: user.id,\n   289→      labelIds: [bugLabel.id, featureLabel.id],\n   290→    });\n   291→    const issue = createResult.issue;\n   292→\n   293→    await page.goto('/login');\n   294→    await page.evaluate((t) => localStorage.setItem('session_token', t), token);\n   295→    await page.goto('/my-issues');\n   296→    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n   297→\n   298→    // Verify both label badges are shown\n   299→    await expect(page.getByTestId(`issue-labels-${issue.id}`)).toBeVisible({ timeout: 30000 });\n   300→    await expect(page.getByTestId(`issue-label-${issue.id}-${bugLabel.id}`)).toContainText('Bug');\n   301→    await expect(page.getByTestId(`issue-label-${issue.id}-${featureLabel.id}`)).toContainText('Feature');\n   302→  });\n   303→\n   304→  test('Issue row shows assignee avatar', async ({ page, baseURL }) => {\n   305→    const { token } = await loginViaApi(baseURL!, 'alice@acme.com', 'password123');\n   306→    const issues = await getMyIssues(baseURL!, token);\n   307→    // ENG-1 is assigned to Alice Johnson\n   308→    const eng1 = issues.find((i: { identifier: string }) => i.identifier === 'ENG-1');\n   309→\n   310→    await page.goto('/login');\n   311→    await page.evaluate((t) => localStorage.setItem('session_token', t), token);\n   312→    await page.goto('/my-issues');\n   313→    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n   314→\n   315→    // Verify assignee avatar shows initials \"AJ\" for Alice Johnson\n   316→    await expect(page.getByTestId(`issue-assignee-${eng1.id}`)).toBeVisible({ timeout: 30000 });\n   317→    await expect(page.getByTestId(`issue-assignee-${eng1.id}`)).toHaveText('AJ');\n   318→    await expect(page.getByTestId(`issue-assignee-${eng1.id}`)).toHaveAttribute('title', 'Alice Johnson');\n   319→  });\n   320→\n   321→  test('Issue row shows due date', async ({ page, baseURL }) => {\n   322→    // Create an issue with a due date\n   323→    const { token, user } = await loginViaApi(baseURL!, 'alice@acme.com', 'password123');\n   324→    const teams = await getTeams(baseURL!, token);\n   325→    const engTeam = teams.find((t: { identifier: string }) => t.identifier === 'ENG');\n   326→\n   327→    const createResult = await createIssueViaApi(baseURL!, token, {\n   328→      teamId: engTeam.id,\n   329→      title: `Due date issue ${Date.now()}`,\n   330→      status: 'todo',\n   331→      priority: 'medium',\n   332→      assigneeId: user.id,\n   333→      dueDate: '2026-03-20',\n   334→    });\n   335→    const issue = createResult.issue;\n   336→\n   337→    await page.goto('/login');\n   338→    await page.evaluate((t) => localStorage.setItem('session_token', t), token);\n   339→    await page.goto('/my-issues');\n   340→    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n   341→\n   342→    // Verify due date is displayed\n   343→    await expect(page.getByTestId(`issue-due-date-${issue.id}`)).toBeVisible({ timeout: 30000 });\n   344→    await expect(page.getByTestId(`issue-due-date-${issue.id}`)).toHaveText('Mar 20');\n   345→  });\n   346→\n   347→  test('Issue row shows project name when assigned', async ({ page, baseURL }) => {\n   348→    const { token } = await loginViaApi(baseURL!, 'alice@acme.com', 'password123');\n   349→    const issues = await getMyIssues(baseURL!, token);\n   350→    // ENG-1 is assigned to V2 Launch project\n   351→    const eng1 = issues.find((i: { identifier: string }) => i.identifier === 'ENG-1');\n   352→\n   353→    await page.goto('/login');\n   354→    await page.evaluate((t) => localStorage.setItem('session_token', t), token);\n   355→    await page.goto('/my-issues');\n   356→    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n   357→\n   358→    // Verify project name is displayed\n   359→    await expect(page.getByTestId(`issue-project-${eng1.id}`)).toBeVisible({ timeout: 30000 });\n   360→    await expect(page.getByTestId(`issue-project-${eng1.id}`)).toHaveText('V2 Launch');\n   361→  });\n   362→\n   363→  test('Issue row hides optional fields when not set', async ({ page, baseURL }) => {\n   364→    // Create an issue with minimal fields (no labels, no due date, no project)\n   365→    const { token, user } = await loginViaApi(baseURL!, 'alice@acme.com', 'password123');\n   366→    const teams = await getTeams(baseURL!, token);\n   367→    const engTeam = teams.find((t: { identifier: string }) => t.identifier === 'ENG');\n   368→\n   369→    const createResult = await createIssueViaApi(baseURL!, token, {\n   370→      teamId: engTeam.id,\n   371→      title: `Minimal issue ${Date.now()}`,\n   372→      status: 'backlog',\n   373→      priority: 'none',\n   374→      assigneeId: user.id,\n   375→    });\n   376→    const issue = createResult.issue;\n   377→\n   378→    await page.goto('/login');\n   379→    await page.evaluate((t) => localStorage.setItem('session_token', t), token);\n   380→    await page.goto('/my-issues');\n   381→    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n   382→\n   383→    // Verify the issue row exists\n   384→    await expect(page.getByTestId(`issue-row-${issue.id}`)).toBeVisible({ timeout: 30000 });\n   385→\n   386→    // Verify required fields are present\n   387→    await expect(page.getByTestId(`issue-priority-${issue.id}`)).toBeVisible();\n   388→    await expect(page.getByTestId(`issue-identifier-${issue.id}`)).toBeVisible();\n   389→    await expect(page.getByTestId(`issue-title-${issue.id}`)).toBeVisible();\n   390→    await expect(page.getByTestId(`issue-status-btn-${issue.id}`)).toBeVisible();\n   391→    await expect(page.getByTestId(`issue-assignee-${issue.id}`)).toBeVisible();\n   392→\n   393→    // Verify optional fields are NOT shown\n   394→    await expect(page.getByTestId(`issue-labels-${issue.id}`)).toHaveCount(0);\n   395→    await expect(page.getByTestId(`issue-due-date-${issue.id}`)).toHaveCount(0);\n   396→    await expect(page.getByTestId(`issue-project-${issue.id}`)).toHaveCount(0);\n   397→  });\n   398→});\n   399→"}]},"parent_tool_use_id":null,"session_id":"10e19085-a83f-4be1-bcf4-a4ad823ec258","uuid":"d563d70e-6e68-4f80-8ae1-a3762e899621","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/tests/my-issues-row.spec.ts","content":"import { test, expect } from '@playwright/test';\n\n// Helper to login via API and get token\nasync function loginViaApi(baseURL: string, email: string, password: string) {\n  const response = await fetch(`${baseURL}/api/login`, {\n    method: 'POST',\n    headers: { 'Content-Type': 'application/json' },\n    body: JSON.stringify({ email, password }),\n  });\n  return response.json();\n}\n\n// Helper to get teams via API\nasync function getTeams(baseURL: string, token: string) {\n  const response = await fetch(`${baseURL}/api/teams`, {\n    headers: { Authorization: `Bearer ${token}` },\n  });\n  const data = await response.json();\n  return data.teams;\n}\n\n// Helper to get labels via API\nasync function getLabels(baseURL: string, token: string) {\n  const response = await fetch(`${baseURL}/api/labels`, {\n    headers: { Authorization: `Bearer ${token}` },\n  });\n  const data = await response.json();\n  return data.labels;\n}\n\n// Helper to get my issues via API\nasync function getMyIssues(baseURL: string, token: string) {\n  const response = await fetch(`${baseURL}/api/my-issues`, {\n    headers: { Authorization: `Bearer ${token}` },\n  });\n  const data = await response.json();\n  return data.issues;\n}\n\n// Helper to create issue via API\nasync function createIssueViaApi(baseURL: string, token: string, issueData: Record<string, unknown>) {\n  const response = await fetch(`${baseURL}/api/create-issue`, {\n    method: 'POST',\n    headers: {\n      'Content-Type': 'application/json',\n      Authorization: `Bearer ${token}`,\n    },\n    body: JSON.stringify(issueData),\n  });\n  return response.json();\n}\n\ntest.describe('IssueRow', () => {\n  test('Issue row displays all required fields', async ({ page, baseURL }) => {\n    // Create an issue with all fields set via API\n    const { token, user } = await loginViaApi(baseURL!, 'alice@acme.com', 'password123');\n    const teams = await getTeams(baseURL!, token);\n    const engTeam = teams.find((t: { identifier: string }) => t.identifier === 'ENG');\n    const labels = await getLabels(baseURL!, token);\n    const bugLabel = labels.find((l: { name: string }) => l.name === 'Bug');\n\n    // Get projects via team-issues\n    const teamResponse = await fetch(`${baseURL}/api/team-issues?teamId=${engTeam.id}`, {\n      headers: { Authorization: `Bearer ${token}` },\n    });\n    const teamData = await teamResponse.json();\n    const v2Project = teamData.projects?.find((p: { name: string }) => p.name === 'V2 Launch');\n\n    const issueTitle = `All fields issue ${Date.now()}`;\n    const createResult = await createIssueViaApi(baseURL!, token, {\n      teamId: engTeam.id,\n      title: issueTitle,\n      status: 'in_progress',\n      priority: 'high',\n      assigneeId: user.id,\n      labelIds: [bugLabel.id],\n      projectId: v2Project?.id || null,\n      dueDate: '2026-03-20',\n    });\n    const createdIssue = createResult.issue;\n\n    await page.goto('/login');\n    await page.evaluate((t) => localStorage.setItem('session_token', t), token);\n    await page.goto('/my-issues');\n    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n\n    // Find the created issue row\n    const issueRow = page.getByTestId(`issue-row-${createdIssue.id}`);\n    await expect(issueRow).toBeVisible({ timeout: 30000 });\n\n    // Verify priority icon\n    await expect(page.getByTestId(`issue-priority-${createdIssue.id}`)).toBeVisible();\n\n    // Verify identifier\n    await expect(page.getByTestId(`issue-identifier-${createdIssue.id}`)).toHaveText(createdIssue.identifier);\n\n    // Verify title\n    await expect(page.getByTestId(`issue-title-${createdIssue.id}`)).toHaveText(issueTitle);\n\n    // Verify status button\n    await expect(page.getByTestId(`issue-status-btn-${createdIssue.id}`)).toBeVisible();\n\n    // Verify label badge\n    await expect(page.getByTestId(`issue-labels-${createdIssue.id}`)).toBeVisible();\n    await expect(page.getByTestId(`issue-label-${createdIssue.id}-${bugLabel.id}`)).toContainText('Bug');\n\n    // Verify assignee\n    await expect(page.getByTestId(`issue-assignee-${createdIssue.id}`)).toBeVisible();\n    await expect(page.getByTestId(`issue-assignee-${createdIssue.id}`)).toHaveText('AJ');\n\n    // Verify due date\n    await expect(page.getByTestId(`issue-due-date-${createdIssue.id}`)).toBeVisible();\n    await expect(page.getByTestId(`issue-due-date-${createdIssue.id}`)).toHaveText('Mar 20');\n\n    // Verify project name\n    await expect(page.getByTestId(`issue-project-${createdIssue.id}`)).toBeVisible();\n    await expect(page.getByTestId(`issue-project-${createdIssue.id}`)).toHaveText('V2 Launch');\n  });\n\n  test('Issue row title is clickable and navigates to issue detail', async ({ page, baseURL }) => {\n    const { token } = await loginViaApi(baseURL!, 'alice@acme.com', 'password123');\n    const issues = await getMyIssues(baseURL!, token);\n    const eng1 = issues.find((i: { identifier: string }) => i.identifier === 'ENG-1');\n\n    await page.goto('/login');\n    await page.evaluate((t) => localStorage.setItem('session_token', t), token);\n    await page.goto('/my-issues');\n    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n\n    // Click the issue title\n    await page.getByTestId(`issue-title-${eng1.id}`).click();\n\n    // Verify navigation to issue detail page\n    await expect(page).toHaveURL(new RegExp(`/issue/${eng1.id}`), { timeout: 30000 });\n  });\n\n  test('Issue row status icon is clickable to change status', async ({ page, baseURL }) => {\n    const { token } = await loginViaApi(baseURL!, 'alice@acme.com', 'password123');\n    const issues = await getMyIssues(baseURL!, token);\n    // Use ENG-6 which is 'todo' status\n    const eng6 = issues.find((i: { identifier: string }) => i.identifier === 'ENG-6');\n\n    await page.goto('/login');\n    await page.evaluate((t) => localStorage.setItem('session_token', t), token);\n    await page.goto('/my-issues');\n    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n\n    // Click the status icon\n    await page.getByTestId(`issue-status-btn-${eng6.id}`).click();\n\n    // Verify dropdown appears with all statuses\n    await expect(page.getByTestId(`issue-status-dropdown-${eng6.id}`)).toBeVisible({ timeout: 10000 });\n    await expect(page.getByTestId('issue-status-option-backlog')).toBeVisible();\n    await expect(page.getByTestId('issue-status-option-todo')).toBeVisible();\n    await expect(page.getByTestId('issue-status-option-in_progress')).toBeVisible();\n    await expect(page.getByTestId('issue-status-option-in_review')).toBeVisible();\n    await expect(page.getByTestId('issue-status-option-done')).toBeVisible();\n    await expect(page.getByTestId('issue-status-option-cancelled')).toBeVisible();\n  });\n\n  test('Changing status via issue row status dropdown persists', async ({ page, baseURL }) => {\n    const { token } = await loginViaApi(baseURL!, 'alice@acme.com', 'password123');\n    const issues = await getMyIssues(baseURL!, token);\n    const eng6 = issues.find((i: { identifier: string }) => i.identifier === 'ENG-6');\n\n    await page.goto('/login');\n    await page.evaluate((t) => localStorage.setItem('session_token', t), token);\n    await page.goto('/my-issues');\n    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n\n    // Verify ENG-6 is in todo group initially\n    const todoItems = page.getByTestId('issue-group-items-todo');\n    await expect(todoItems).toBeVisible({ timeout: 30000 });\n    await expect(todoItems.getByTestId(`issue-row-${eng6.id}`)).toBeVisible();\n\n    // Open status dropdown and change to in_progress\n    await page.getByTestId(`issue-status-btn-${eng6.id}`).click();\n    await expect(page.getByTestId(`issue-status-dropdown-${eng6.id}`)).toBeVisible({ timeout: 10000 });\n    await page.getByTestId('issue-status-option-in_progress').click();\n\n    // Verify dropdown closed\n    await expect(page.getByTestId(`issue-status-dropdown-${eng6.id}`)).toHaveCount(0);\n\n    // Verify the issue moved to in_progress group\n    await expect(page.getByTestId('issue-group-items-in_progress').getByTestId(`issue-row-${eng6.id}`)).toBeVisible({ timeout: 30000 });\n\n    // Verify persistence by reloading the page\n    await page.reload();\n    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n    await expect(page.getByTestId('issue-group-items-in_progress').getByTestId(`issue-row-${eng6.id}`)).toBeVisible({ timeout: 30000 });\n  });\n\n  test('Issue row status change updates group membership', async ({ page, baseURL }) => {\n    const { token } = await loginViaApi(baseURL!, 'alice@acme.com', 'password123');\n    const issues = await getMyIssues(baseURL!, token);\n    const eng6 = issues.find((i: { identifier: string }) => i.identifier === 'ENG-6');\n\n    await page.goto('/login');\n    await page.evaluate((t) => localStorage.setItem('session_token', t), token);\n    await page.goto('/my-issues');\n    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n\n    // Initial state: todo has 2, in_progress has 1\n    await expect(page.getByTestId('issue-group-header-todo')).toContainText('(2)', { timeout: 30000 });\n    await expect(page.getByTestId('issue-group-header-in_progress')).toContainText('(1)');\n\n    // Change ENG-6 from todo to in_progress\n    await page.getByTestId(`issue-status-btn-${eng6.id}`).click();\n    await expect(page.getByTestId(`issue-status-dropdown-${eng6.id}`)).toBeVisible({ timeout: 10000 });\n    await page.getByTestId('issue-status-option-in_progress').click();\n\n    // Verify counts updated: todo has 1, in_progress has 2\n    await expect(page.getByTestId('issue-group-header-todo')).toContainText('(1)');\n    await expect(page.getByTestId('issue-group-header-in_progress')).toContainText('(2)');\n  });\n\n  test('Issue row status dropdown can be used multiple times', async ({ page, baseURL }) => {\n    test.slow();\n\n    const { token } = await loginViaApi(baseURL!, 'alice@acme.com', 'password123');\n    const issues = await getMyIssues(baseURL!, token);\n    const eng6 = issues.find((i: { identifier: string }) => i.identifier === 'ENG-6');\n\n    await page.goto('/login');\n    await page.evaluate((t) => localStorage.setItem('session_token', t), token);\n    await page.goto('/my-issues');\n    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n    await expect(page.getByTestId('issue-group-items-todo')).toBeVisible({ timeout: 30000 });\n\n    // First status change: todo -> in_progress\n    await page.getByTestId(`issue-status-btn-${eng6.id}`).click();\n    await expect(page.getByTestId(`issue-status-dropdown-${eng6.id}`)).toBeVisible({ timeout: 10000 });\n    await page.getByTestId('issue-status-option-in_progress').click();\n    await expect(page.getByTestId(`issue-status-dropdown-${eng6.id}`)).toHaveCount(0);\n\n    // Verify issue is in in_progress group\n    await expect(page.getByTestId('issue-group-items-in_progress').getByTestId(`issue-row-${eng6.id}`)).toBeVisible({ timeout: 30000 });\n\n    // Second status change: in_progress -> done\n    await page.getByTestId(`issue-status-btn-${eng6.id}`).click();\n    await expect(page.getByTestId(`issue-status-dropdown-${eng6.id}`)).toBeVisible({ timeout: 10000 });\n    await page.getByTestId('issue-status-option-done').click();\n    await expect(page.getByTestId(`issue-status-dropdown-${eng6.id}`)).toHaveCount(0);\n\n    // Verify issue is in done group\n    await expect(page.getByTestId('issue-group-items-done').getByTestId(`issue-row-${eng6.id}`)).toBeVisible({ timeout: 30000 });\n  });\n\n  test('Issue row displays priority icon with correct color', async ({ page, baseURL }) => {\n    // Alice has: ENG-6 (urgent), ENG-1 (high), DES-3 (low)\n    const { token } = await loginViaApi(baseURL!, 'alice@acme.com', 'password123');\n    const issues = await getMyIssues(baseURL!, token);\n    const urgentIssue = issues.find((i: { identifier: string }) => i.identifier === 'ENG-6');\n    const highIssue = issues.find((i: { identifier: string }) => i.identifier === 'ENG-1');\n    const lowIssue = issues.find((i: { identifier: string }) => i.identifier === 'DES-3');\n\n    await page.goto('/login');\n    await page.evaluate((t) => localStorage.setItem('session_token', t), token);\n    await page.goto('/my-issues');\n    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(3, { timeout: 30000 });\n\n    // Verify priority icons are present with correct titles\n    await expect(page.getByTestId(`issue-priority-${urgentIssue.id}`)).toHaveAttribute('title', 'Urgent');\n    await expect(page.getByTestId(`issue-priority-${highIssue.id}`)).toHaveAttribute('title', 'High');\n    await expect(page.getByTestId(`issue-priority-${lowIssue.id}`)).toHaveAttribute('title', 'Low');\n\n    // Verify each priority icon contains an SVG\n    await expect(page.getByTestId(`issue-priority-${urgentIssue.id}`).locator('svg')).toBeVisible();\n    await expect(page.getByTestId(`issue-priority-${highIssue.id}`).locator('svg')).toBeVisible();\n    await expect(page.getByTestId(`issue-priority-${lowIssue.id}`).locator('svg')).toBeVisible();\n  });\n\n  test('Issue row displays labels as colored badges', async ({ page, baseURL }) => {\n    // Create an issue with two labels\n    const { token, user } = await loginViaApi(baseURL!, 'alice@acme.com', 'password123');\n    const teams = await getTeams(baseURL!, token);\n    const engTeam = teams.find((t: { identifier: string }) => t.identifier === 'ENG');\n    const labels = await getLabels(baseURL!, token);\n    const bugLabel = labels.find((l: { name: string }) => l.name === 'Bug');\n    const featureLabel = labels.find((l: { name: string }) => l.name === 'Feature');\n\n    const createResult = await createIssueViaApi(baseURL!, token, {\n      teamId: engTeam.id,\n      title: `Multi-label issue ${Date.now()}`,\n      status: 'todo',\n      priority: 'medium',\n      assigneeId: user.id,\n      labelIds: [bugLabel.id, featureLabel.id],\n    });\n    const issue = createResult.issue;\n\n    await page.goto('/login');\n    await page.evaluate((t) => localStorage.setItem('session_token', t), token);\n    await page.goto('/my-issues');\n    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n\n    // Verify both label badges are shown\n    await expect(page.getByTestId(`issue-labels-${issue.id}`)).toBeVisible({ timeout: 30000 });\n    await expect(page.getByTestId(`issue-label-${issue.id}-${bugLabel.id}`)).toContainText('Bug');\n    await expect(page.getByTestId(`issue-label-${issue.id}-${featureLabel.id}`)).toContainText('Feature');\n  });\n\n  test('Issue row shows assignee avatar', async ({ page, baseURL }) => {\n    const { token } = await loginViaApi(baseURL!, 'alice@acme.com', 'password123');\n    const issues = await getMyIssues(baseURL!, token);\n    // ENG-1 is assigned to Alice Johnson\n    const eng1 = issues.find((i: { identifier: string }) => i.identifier === 'ENG-1');\n\n    await page.goto('/login');\n    await page.evaluate((t) => localStorage.setItem('session_token', t), token);\n    await page.goto('/my-issues');\n    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n\n    // Verify assignee avatar shows initials \"AJ\" for Alice Johnson\n    await expect(page.getByTestId(`issue-assignee-${eng1.id}`)).toBeVisible({ timeout: 30000 });\n    await expect(page.getByTestId(`issue-assignee-${eng1.id}`)).toHaveText('AJ');\n    await expect(page.getByTestId(`issue-assignee-${eng1.id}`)).toHaveAttribute('title', 'Alice Johnson');\n  });\n\n  test('Issue row shows due date', async ({ page, baseURL }) => {\n    // Create an issue with a due date\n    const { token, user } = await loginViaApi(baseURL!, 'alice@acme.com', 'password123');\n    const teams = await getTeams(baseURL!, token);\n    const engTeam = teams.find((t: { identifier: string }) => t.identifier === 'ENG');\n\n    const createResult = await createIssueViaApi(baseURL!, token, {\n      teamId: engTeam.id,\n      title: `Due date issue ${Date.now()}`,\n      status: 'todo',\n      priority: 'medium',\n      assigneeId: user.id,\n      dueDate: '2026-03-20',\n    });\n    const issue = createResult.issue;\n\n    await page.goto('/login');\n    await page.evaluate((t) => localStorage.setItem('session_token', t), token);\n    await page.goto('/my-issues');\n    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n\n    // Verify due date is displayed\n    await expect(page.getByTestId(`issue-due-date-${issue.id}`)).toBeVisible({ timeout: 30000 });\n    await expect(page.getByTestId(`issue-due-date-${issue.id}`)).toHaveText('Mar 20');\n  });\n\n  test('Issue row shows project name when assigned', async ({ page, baseURL }) => {\n    const { token } = await loginViaApi(baseURL!, 'alice@acme.com', 'password123');\n    const issues = await getMyIssues(baseURL!, token);\n    // ENG-1 is assigned to V2 Launch project\n    const eng1 = issues.find((i: { identifier: string }) => i.identifier === 'ENG-1');\n\n    await page.goto('/login');\n    await page.evaluate((t) => localStorage.setItem('session_token', t), token);\n    await page.goto('/my-issues');\n    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n\n    // Verify project name is displayed\n    await expect(page.getByTestId(`issue-project-${eng1.id}`)).toBeVisible({ timeout: 30000 });\n    await expect(page.getByTestId(`issue-project-${eng1.id}`)).toHaveText('V2 Launch');\n  });\n\n  test('Issue row hides optional fields when not set', async ({ page, baseURL }) => {\n    // Create an issue with minimal fields (no labels, no due date, no project)\n    const { token, user } = await loginViaApi(baseURL!, 'alice@acme.com', 'password123');\n    const teams = await getTeams(baseURL!, token);\n    const engTeam = teams.find((t: { identifier: string }) => t.identifier === 'ENG');\n\n    const createResult = await createIssueViaApi(baseURL!, token, {\n      teamId: engTeam.id,\n      title: `Minimal issue ${Date.now()}`,\n      status: 'backlog',\n      priority: 'none',\n      assigneeId: user.id,\n    });\n    const issue = createResult.issue;\n\n    await page.goto('/login');\n    await page.evaluate((t) => localStorage.setItem('session_token', t), token);\n    await page.goto('/my-issues');\n    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n\n    // Verify the issue row exists\n    await expect(page.getByTestId(`issue-row-${issue.id}`)).toBeVisible({ timeout: 30000 });\n\n    // Verify required fields are present\n    await expect(page.getByTestId(`issue-priority-${issue.id}`)).toBeVisible();\n    await expect(page.getByTestId(`issue-identifier-${issue.id}`)).toBeVisible();\n    await expect(page.getByTestId(`issue-title-${issue.id}`)).toBeVisible();\n    await expect(page.getByTestId(`issue-status-btn-${issue.id}`)).toBeVisible();\n    await expect(page.getByTestId(`issue-assignee-${issue.id}`)).toBeVisible();\n\n    // Verify optional fields are NOT shown\n    await expect(page.getByTestId(`issue-labels-${issue.id}`)).toHaveCount(0);\n    await expect(page.getByTestId(`issue-due-date-${issue.id}`)).toHaveCount(0);\n    await expect(page.getByTestId(`issue-project-${issue.id}`)).toHaveCount(0);\n  });\n});\n","numLines":399,"startLine":1,"totalLines":399}}}
