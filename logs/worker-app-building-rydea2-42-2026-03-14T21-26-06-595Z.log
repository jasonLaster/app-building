er INT NOT NULL,\n   110→      due_date DATE,\n   111→      assignee_id UUID REFERENCES members(id) ON DELETE SET NULL,\n   112→      project_id UUID REFERENCES projects(id) ON DELETE SET NULL,\n   113→      cycle_id UUID REFERENCES cycles(id) ON DELETE SET NULL,\n   114→      parent_id UUID REFERENCES issues(id) ON DELETE SET NULL,\n   115→      created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),\n   116→      updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()\n   117→    )\n   118→  `;\n   119→\n   120→  // Issue labels junction\n   121→  await sql`\n   122→    CREATE TABLE IF NOT EXISTS issue_labels (\n   123→      issue_id UUID NOT NULL REFERENCES issues(id) ON DELETE CASCADE,\n   124→      label_id UUID NOT NULL REFERENCES labels(id) ON DELETE CASCADE,\n   125→      PRIMARY KEY (issue_id, label_id)\n   126→    )\n   127→  `;\n   128→\n   129→  // Comments\n   130→  await sql`\n   131→    CREATE TABLE IF NOT EXISTS comments (\n   132→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n   133→      issue_id UUID NOT NULL REFERENCES issues(id) ON DELETE CASCADE,\n   134→      member_id UUID NOT NULL REFERENCES members(id) ON DELETE CASCADE,\n   135→      content TEXT NOT NULL,\n   136→      created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()\n   137→    )\n   138→  `;\n   139→\n   140→  // Activity log\n   141→  await sql`\n   142→    CREATE TABLE IF NOT EXISTS activity (\n   143→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n   144→      issue_id UUID NOT NULL REFERENCES issues(id) ON DELETE CASCADE,\n   145→      member_id UUID REFERENCES members(id) ON DELETE SET NULL,\n   146→      action TEXT NOT NULL,\n   147→      field TEXT,\n   148→      new_value TEXT,\n   149→      created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()\n   150→    )\n   151→  `;\n   152→\n   153→  // Notifications\n   154→  await sql`\n   155→    CREATE TABLE IF NOT EXISTS notifications (\n   156→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n   157→      member_id UUID NOT NULL 