[2026-03-14T21:16:45.458Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012ucPugkBJHVmsyY56jGFKH","type":"tool_result","content":"     1→import { createSlice, createAsyncThunk } from '@reduxjs/toolkit';\n     2→\n     3→interface AuthState {\n     4→  user: {\n     5→    id: string;\n     6→    name: string;\n     7→    email: string;\n     8→  } | null;\n     9→  token: string | null;\n    10→  loading: boolean;\n    11→  error: string | null;\n    12→}\n    13→\n    14→const initialState: AuthState = {\n    15→  user: null,\n    16→  token: localStorage.getItem('session_token'),\n    17→  loading: false,\n    18→  error: null,\n    19→};\n    20→\n    21→export const login = createAsyncThunk(\n    22→  'auth/login',\n    23→  async (credentials: { email: string; password: string }, { rejectWithValue }) => {\n    24→    const response = await fetch('/api/login', {\n    25→      method: 'POST',\n    26→      headers: { 'Content-Type': 'application/json' },\n    27→      body: JSON.stringify(credentials),\n    28→    });\n    29→    const data = await response.json();\n    30→    if (!response.ok) {\n    31→      return rejectWithValue(data.error || 'Invalid email or password');\n    32→    }\n    33→    return data;\n    34→  }\n    35→);\n    36→\n    37→export const signup = createAsyncThunk(\n    38→  'auth/signup',\n    39→  async (credentials: { name: string; email: string; password: string }, { rejectWithValue }) => {\n    40→    const response = await fetch('/api/signup', {\n    41→      method: 'POST',\n    42→      headers: { 'Content-Type': 'application/json' },\n    43→      body: JSON.stringify(credentials),\n    44→    });\n    45→    const data = await response.json();\n    46→    if (!response.ok) {\n    47→      return rejectWithValue(data.error || 'Sign up failed');\n    48→    }\n    49→    return data;\n    50→  }\n    51→);\n    52→\n    53→export const fetchCurrentUser = createAsyncThunk(\n    54→  'auth/fetchCurrentUser',\n    55→  async (_, { getState, rejectWithValue }) => {\n    56→    const state = getState() as { auth: AuthState };\n    57→    const token = state.auth.token;\n    58→    if (!token) {\n    59→      return rejectWithValue('No token');\n    60→    }\n    61→    const response = await fetch('/api/me', {\n    62→      headers: { Authorization: `Bearer ${token}` },\n    63→    });\n    64→    if (!response.ok) {\n    65→      return rejectWithValue('Session expired');\n    66→    }\n    67→    const data = await response.json();\n    68→    return data;\n    69→  }\n    70→);\n    71→\n    72→const authSlice = createSlice({\n    73→  name: 'auth',\n    74→  initialState,\n    75→  reducers: {\n    76→    logout(state) {\n    77→      state.user = null;\n    78→      state.token = null;\n    79→      state.error = null;\n    80→      localStorage.removeItem('session_token');\n    81→    },\n    82→    clearError(state) {\n    83→      state.error = null;\n    84→    },\n    85→  },\n    86→  extraReducers: (builder) => {\n    87→    builder\n    88→      .addCase(login.pending, (state) => {\n    89→        state.loading = true;\n    90→        state.error = null;\n    91→      })\n    92→      .addCase(login.fulfilled, (state, action) => {\n    93→        state.loading = false;\n    94→        state.user = action.payload.user;\n    95→        state.token = action.payload.token;\n    96→        localStorage.setItem('session_token', action.payload.token);\n    97→      })\n    98→      .addCase(login.rejected, (state, action) => {\n    99→        state.loading = false;\n   100→        state.error = action.payload as string;\n   101→      })\n   102→      .addCase(signup.pending, (state) => {\n   103→        state.loading = true;\n   104→        state.error = null;\n   105→      })\n   106→      .addCase(signup.fulfilled, (state, action) => {\n   107→        state.loading = false;\n   108→        state.user = action.payload.user;\n   109→        state.token = action.payload.token;\n   110→        localStorage.setItem('session_token', action.payload.token);\n   111→      })\n   112→      .addCase(signup.rejected, (state, action) => {\n   113→        state.loading = false;\n   114→        state.error = action.payload as string;\n   115→      })\n   116→      .addCase(fetchCurrentUser.fulfilled, (state, action) => {\n   117→        state.user = action.payload.user;\n   118→      })\n   119→      .addCase(fetchCurrentUser.rejected, (state) => {\n   120→        state.user = null;\n   121→        state.token = null;\n   122→        localStorage.removeItem('session_token');\n   123→      });\n   124→  },\n   125→});\n   126→\n   127→export const { logout, clearError } = authSlice.actions;\n   128→export default authSlice.reducer;\n   129→"}]},"parent_tool_use_id":"toolu_01PXe1kgiB6QnYdYr74jyDNJ","session_id":"10e19085-a83f-4be1-bcf4-a4ad823ec258","uuid":"0a05b27f-7066-4ab6-b8fd-905acedf1691"}
