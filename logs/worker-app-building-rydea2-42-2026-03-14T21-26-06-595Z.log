 41→  test('Successful login with valid credentials', async ({ page, baseURL }) => {\n    42→    test.slow();\n    43→\n    44→    // Create a test user via API\n    45→    const email = `user-${Date.now()}@test.com`;\n    46→    const password = 'password123';\n    47→    await createTestUser(baseURL!, 'Test User', email, password);\n    48→\n    49→    await page.goto('/login');\n    50→    await expect(page.getByTestId('login-form')).toBeVisible({ timeout: 30000 });\n    51→\n    52→    // Fill in credentials\n    53→    await page.getByTestId('login-email-input').fill(email);\n    54→    await page.getByTestId('login-password-input').fill(password);\n    55→    await page.getByTestId('login-submit-button').click();\n    56→\n    57→    // Verify redirect to /my-issues\n    58→    await expect(page).toHaveURL(/\\/my-issues/, { timeout: 30000 });\n    59→\n    60→    // Verify session token in localStorage\n    61→    const token = await page.evaluate(() => localStorage.getItem('session_token'));\n    62→    expect(token).toBeTruthy();\n    63→\n    64→    // Verify sidebar is visible (authenticated layout)\n    65→    await expect(page.getByTestId('app-layout')).toBeVisible({ timeout: 30000 });\n    66→  });\n    67→\n    68→  test('Login fails with invalid email', async ({ page }) => {\n    69→    await page.goto('/login');\n    70→    await expect(page.getByTestId('login-form')).toBeVisible({ timeout: 30000 });\n    71→\n    72→    // Enter non-existent email\n    73→    await page.getByTestId('login-email-input').fill('nonexistent@test.com');\n    74→    await page.getByTestId('login-password-input').fill('password123');\n    75→    await page.getByTestId('login-submit-button').click();\n    76→\n    77→    // Verify error message\n    78→    await expect(page.getByTestId('login-error')).toBeVisible({ timeout: 30000 });\n    79→    await expect(page.getByTestId('login-error')).toContainText('Invalid email or password');\n    80→\n    81→    // Verify still on 