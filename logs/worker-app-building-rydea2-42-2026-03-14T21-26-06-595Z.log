[2026-03-14T21:16:37.297Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011UTzgoPaESuoDCsAos4oYw","type":"tool_result","content":"     1→import { useEffect, useMemo, useState } from 'react';\n     2→import { useSelector, useDispatch } from 'react-redux';\n     3→import type { RootState, AppDispatch } from '../store';\n     4→import { fetchMyIssues } from '../slices/issuesSlice';\n     5→import { fetchLabels } from '../slices/labelsSlice';\n     6→import FiltersToolbar from '../components/FiltersToolbar';\n     7→import MyIssuesList from '../components/MyIssuesList';\n     8→import './MyIssues.css';\n     9→\n    10→export default function MyIssues() {\n    11→  const dispatch = useDispatch<AppDispatch>();\n    12→  const { token } = useSelector((state: RootState) => state.auth);\n    13→  const { myIssues, loading } = useSelector((state: RootState) => state.issues);\n    14→\n    15→  const [selectedStatuses, setSelectedStatuses] = useState<string[]>([]);\n    16→  const [selectedPriorities, setSelectedPriorities] = useState<string[]>([]);\n    17→  const [selectedLabels, setSelectedLabels] = useState<string[]>([]);\n    18→\n    19→  useEffect(() => {\n    20→    if (token) {\n    21→      dispatch(fetchMyIssues());\n    22→      dispatch(fetchLabels());\n    23→    }\n    24→  }, [dispatch, token]);\n    25→\n    26→  const filteredIssues = useMemo(() => {\n    27→    return myIssues.filter((issue) => {\n    28→      if (selectedStatuses.length > 0 && !selectedStatuses.includes(issue.status)) {\n    29→        return false;\n    30→      }\n    31→      if (selectedPriorities.length > 0 && !selectedPriorities.includes(issue.priority)) {\n    32→        return false;\n    33→      }\n    34→      if (selectedLabels.length > 0) {\n    35→        const issueLabelIds = issue.labels.map((l) => l.id);\n    36→        if (!selectedLabels.some((labelId) => issueLabelIds.includes(labelId))) {\n    37→          return false;\n    38→        }\n    39→      }\n    40→      return true;\n    41→    });\n    42→  }, [myIssues, selectedStatuses, selectedPriorities, selectedLabels]);\n    43→\n    44→  return (\n    45→    <div className=\"my-issues-page\" data-testid=\"my-issues-page\">\n    46→      <div className=\"my-issues-header\">\n    47→        <h1 className=\"my-issues-title\" data-testid=\"my-issues-title\">My Issues</h1>\n    48→      </div>\n    49→      <FiltersToolbar\n    50→        selectedStatuses={selectedStatuses}\n    51→        selectedPriorities={selectedPriorities}\n    52→        selectedLabels={selectedLabels}\n    53→        onStatusChange={setSelectedStatuses}\n    54→        onPriorityChange={setSelectedPriorities}\n    55→        onLabelChange={setSelectedLabels}\n    56→      />\n    57→      <MyIssuesList issues={filteredIssues} loading={loading} />\n    58→    </div>\n    59→  );\n    60→}\n    61→"}]},"parent_tool_use_id":"toolu_01PXe1kgiB6QnYdYr74jyDNJ","session_id":"10e19085-a83f-4be1-bcf4-a4ad823ec258","uuid":"529aca55-8980-457b-bf62-d3bb6322630d"}
