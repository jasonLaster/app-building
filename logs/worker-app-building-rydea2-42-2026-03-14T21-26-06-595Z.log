[2026-03-14T21:16:37.443Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BjBLRh9mQsFoqgJqML5ZCf","type":"tool_result","content":"     1→import { useState, useMemo } from 'react';\n     2→import type { Issue } from '../slices/issuesSlice';\n     3→import { STATUS_ORDER, STATUS_CONFIG, StatusIcon } from './IssueRow';\n     4→import IssueRow from './IssueRow';\n     5→import './MyIssuesList.css';\n     6→\n     7→interface MyIssuesListProps {\n     8→  issues: Issue[];\n     9→  loading: boolean;\n    10→}\n    11→\n    12→interface StatusGroup {\n    13→  status: string;\n    14→  label: string;\n    15→  color: string;\n    16→  issues: Issue[];\n    17→}\n    18→\n    19→export default function MyIssuesList({ issues, loading }: MyIssuesListProps) {\n    20→  const [collapsedGroups, setCollapsedGroups] = useState<Record<string, boolean>>({});\n    21→\n    22→  const groups: StatusGroup[] = useMemo(() => {\n    23→    const grouped: StatusGroup[] = [];\n    24→    for (const status of STATUS_ORDER) {\n    25→      const config = STATUS_CONFIG[status];\n    26→      const groupIssues = issues.filter((i) => i.status === status);\n    27→      if (groupIssues.length > 0) {\n    28→        grouped.push({\n    29→          status,\n    30→          label: config.label,\n    31→          color: config.color,\n    32→          issues: groupIssues,\n    33→        });\n    34→      }\n    35→    }\n    36→    return grouped;\n    37→  }, [issues]);\n    38→\n    39→  function toggleGroup(status: string) {\n    40→    setCollapsedGroups((prev) => ({ ...prev, [status]: !prev[status] }));\n    41→  }\n    42→\n    43→  if (loading) {\n    44→    return (\n    45→      <div className=\"my-issues-list-loading\" data-testid=\"my-issues-loading\">\n    46→        Loading...\n    47→      </div>\n    48→    );\n    49→  }\n    50→\n    51→  if (issues.length === 0) {\n    52→    return (\n    53→      <div className=\"my-issues-list-empty\" data-testid=\"my-issues-empty\">\n    54→        <svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--color-text-tertiary)\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n    55→          <circle cx=\"12\" cy=\"12\" r=\"10\" />\n    56→          <line x1=\"8\" y1=\"12\" x2=\"16\" y2=\"12\" />\n    57→        </svg>\n    58→        <p>No issues assigned to you yet</p>\n    59→      </div>\n    60→    );\n    61→  }\n    62→\n    63→  return (\n    64→    <div className=\"my-issues-list\" data-testid=\"my-issues-list\">\n    65→      {groups.map((group) => {\n    66→        const isCollapsed = !!collapsedGroups[group.status];\n    67→        return (\n    68→          <div key={group.status} className=\"my-issues-group\" data-testid={`issue-group-${group.status}`}>\n    69→            <button\n    70→              className=\"my-issues-group-header\"\n    71→              onClick={() => toggleGroup(group.status)}\n    72→              data-testid={`issue-group-header-${group.status}`}\n    73→            >\n    74→              <svg\n    75→                className={`my-issues-group-chevron ${isCollapsed ? '' : 'my-issues-group-chevron-expanded'}`}\n    76→                width=\"12\"\n    77→                height=\"12\"\n    78→                viewBox=\"0 0 24 24\"\n    79→                fill=\"none\"\n    80→                stroke=\"currentColor\"\n    81→                strokeWidth=\"2\"\n    82→                strokeLinecap=\"round\"\n    83→                strokeLinejoin=\"round\"\n    84→              >\n    85→                <polyline points=\"9 18 15 12 9 6\" />\n    86→              </svg>\n    87→              <StatusIcon status={group.status} color={group.color} />\n    88→              <span className=\"my-issues-group-label\">{group.label}</span>\n    89→              <span className=\"my-issues-group-count\">({group.issues.length})</span>\n    90→            </button>\n    91→            {!isCollapsed && (\n    92→              <div className=\"my-issues-group-items\" data-testid={`issue-group-items-${group.status}`}>\n    93→                {group.issues.map((issue) => (\n    94→                  <IssueRow key={issue.id} issue={issue} />\n    95→                ))}\n    96→              </div>\n    97→            )}\n    98→          </div>\n    99→        );\n   100→      })}\n   101→    </div>\n   102→  );\n   103→}\n   104→"}]},"parent_tool_use_id":"toolu_01PXe1kgiB6QnYdYr74jyDNJ","session_id":"10e19085-a83f-4be1-bcf4-a4ad823ec258","uuid":"536a019c-53b0-4f4a-be12-ff9dbd1f0048"}
