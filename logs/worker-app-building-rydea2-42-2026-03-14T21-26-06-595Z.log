[2026-03-14T21:17:38.925Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01S8n683sRJS3TVoGpjuZK8c","type":"tool_result","content":"     1→import { neon } from '@neondatabase/serverless';\n     2→import { randomBytes, pbkdf2Sync } from 'crypto';\n     3→\n     4→export async function truncateAndSeed(databaseUrl: string) {\n     5→  const sql = neon(databaseUrl);\n     6→\n     7→  // Truncate all tables in dependency order\n     8→  await sql`TRUNCATE project_activity, project_milestones, notifications, activity, comments, issue_labels, issues, cycles, team_members, sessions, projects, labels, teams, members, workspaces CASCADE`;\n     9→\n    10→  await seedDatabase(databaseUrl);\n    11→}\n    12→\n    13→export async function seedDatabase(databaseUrl: string) {\n    14→  const sql = neon(databaseUrl);\n    15→\n    16→  // Helper to hash passwords\n    17→  function hashPassword(password: string) {\n    18→    const salt = randomBytes(16).toString('hex');\n    19→    const hash = pbkdf2Sync(password, salt, 10000, 64, 'sha512').toString('hex');\n    20→    return { hash, salt };\n    21→  }\n    22→\n    23→  // Create workspace\n    24→  const wsRows = await sql`\n    25→    INSERT INTO workspaces (name) VALUES ('Acme Corp')\n    26→    RETURNING id\n    27→  `;\n    28→  const _workspaceId = wsRows[0]?.id;\n    29→\n    30→  // Create members\n    31→  const pw1 = hashPassword('password123');\n    32→  const pw2 = hashPassword('password123');\n    33→  const pw3 = hashPassword('password123');\n    34→\n    35→  const m1Rows = await sql`\n    36→    INSERT INTO members (name, email, password_hash, password_salt, role)\n    37→    VALUES ('Alice Johnson', 'alice@acme.com', ${pw1.hash}, ${pw1.salt}, 'admin')\n    38→    RETURNING id\n    39→  `;\n    40→  const m2Rows = await sql`\n    41→    INSERT INTO members (name, email, password_hash, password_salt, role)\n    42→    VALUES ('Bob Smith', 'bob@acme.com', ${pw2.hash}, ${pw2.salt}, 'member')\n    43→    RETURNING id\n    44→  `;\n    45→  const m3Rows = await sql`\n    46→    INSERT INTO members (name, email, password_hash, password_salt, role)\n    47→    VALUES ('Carol Davis', 'carol@acme.com', ${pw3.hash}, ${pw3.salt}, 'member')\n    48→    RETURNING id\n    49→  `;\n    50→\n    51→  const aliceId = m1Rows[0]?.id;\n    52→  const bobId = m2Rows[0]?.id;\n    53→  const carolId = m3Rows[0]?.id;\n    54→\n    55→  // Create teams\n    56→  const t1Rows = await sql`\n    57→    INSERT INTO teams (name, identifier, description)\n    58→    VALUES ('Engineering', 'ENG', 'Core product engineering team')\n    59→    RETURNING id\n    60→  `;\n    61→  const t2Rows = await sql`\n    62→    INSERT INTO teams (name, identifier, description)\n    63→    VALUES ('Design', 'DES', 'Product design and UX team')\n    64→    RETURNING id\n    65→  `;\n    66→\n    67→  const engId = t1Rows[0]?.id;\n    68→  const desId = t2Rows[0]?.id;\n    69→\n    70→  // Set default team on workspace\n    71→  await sql`UPDATE workspaces SET default_team_id = ${engId} WHERE name = 'Acme Corp'`;\n    72→\n    73→  // Team members\n    74→  await sql`INSERT INTO team_members (team_id, member_id) VALUES (${engId}, ${aliceId})`;\n    75→  await sql`INSERT INTO team_members (team_id, member_id) VALUES (${engId}, ${bobId})`;\n    76→  await sql`INSERT INTO team_members (team_id, member_id) VALUES (${engId}, ${carolId})`;\n    77→  await sql`INSERT INTO team_members (team_id, member_id) VALUES (${desId}, ${aliceId})`;\n    78→  await sql`INSERT INTO team_members (team_id, member_id) VALUES (${desId}, ${carolId})`;\n    79→\n    80→  // Create labels\n    81→  const l1Rows = await sql`INSERT INTO labels (name, color) VALUES ('Bug', '#ef4444') RETURNING id`;\n    82→  const l2Rows = await sql`INSERT INTO labels (name, color) VALUES ('Feature', '#22c55e') RETURNING id`;\n    83→  const l3Rows = await sql`INSERT INTO labels (name, color) VALUES ('Improvement', '#3b82f6') RETURNING id`;