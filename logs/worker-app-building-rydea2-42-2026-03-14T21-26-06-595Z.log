xpect(page.getByTestId('issue-group-in_review')).toHaveCount(0);\n    87→    await expect(page.getByTestId('issue-group-done')).toHaveCount(0);\n    88→    await expect(page.getByTestId('issue-group-cancelled')).toHaveCount(0);\n    89→\n    90→    // Verify groups appear in correct status order (todo before in_progress)\n    91→    const todoBox = await page.getByTestId('issue-group-todo').boundingBox();\n    92→    const inProgressBox = await page.getByTestId('issue-group-in_progress').boundingBox();\n    93→    expect(todoBox!.y).toBeLessThan(inProgressBox!.y);\n    94→  });\n    95→\n    96→  test('My Issues page shows empty state when no issues assigned', async ({ page, baseURL }) => {\n    97→    // Create a new user with no issues\n    98→    const email = `empty-user-${Date.now()}@test.com`;\n    99→    const data = await createTestUser(baseURL!, 'Empty User', email, 'password123');\n   100→\n   101→    await page.goto('/login');\n   102→    await page.evaluate((t) => localStorage.setItem('session_token', t), data.token);\n   103→    await page.goto('/my-issues');\n   104→    await expect(page.getByTestId('my-issues-page')).toBeVisible({ timeout: 30000 });\n   105→\n   106→    // Verify empty state\n   107→    await expect(page.getByTestId('my-issues-empty')).toBeVisible({ timeout: 30000 });\n   108→    await expect(page.getByTestId('my-issues-empty')).toContainText('No issues assigned to you yet');\n   109→\n   110→    // Verify no issue list is shown\n   111→    await expect(page.getByTestId('my-issues-list')).toHaveCount(0);\n   112→  });\n   113→\n   114→  test('Status group is collapsible', async ({ page, baseURL }) => {\n   115→    await loginAndNavigate(page, baseURL!);\n   116→\n   117→    // Verify in_progress group items are visible\n   118→    await expect(page.getByTestId('issue-group-items-in_progress')).toBeVisible({ timeout: 30000 });\n   119→\n   120→    // Click the in_progress header to collapse\n   121→    await page.getByTestId('issue-gro