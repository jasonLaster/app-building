         ${issue.assigneeId}, ${projectId})\n   144→      RETURNING id\n   145→    `;\n   146→    const issueId = rows[0]?.id;\n   147→    if (issueId && issue.labelId) {\n   148→      await sql`INSERT INTO issue_labels (issue_id, label_id) VALUES (${issueId}, ${issue.labelId})`;\n   149→    }\n   150→  }\n   151→\n   152→  // Create project milestones\n   153→  await sql`\n   154→    INSERT INTO project_milestones (project_id, name, target_date, completed)\n   155→    VALUES (${projectId}, 'API Complete', '2026-04-15', false)\n   156→  `;\n   157→  await sql`\n   158→    INSERT INTO project_milestones (project_id, name, target_date, completed)\n   159→    VALUES (${projectId}, 'Beta Launch', '2026-05-30', false)\n   160→  `;\n   161→\n   162→  // Create some notifications for Alice\n   163→  const firstEngIssueRows = await sql`SELECT id FROM issues WHERE team_id = ${engId} AND number = 2 LIMIT 1`;\n   164→  const notifIssueId = firstEngIssueRows[0]?.id;\n   165→\n   166→  if (notifIssueId) {\n   167→    await sql`\n   168→      INSERT INTO notifications (member_id, type, message, issue_id, read, archived)\n   169→      VALUES (${aliceId}, 'assigned', 'You were assigned to ENG-2: Implement real-time notifications', ${notifIssueId}, false, false)\n   170→    `;\n   171→    await sql`\n   172→      INSERT INTO notifications (member_id, type, message, issue_id, read, archived)\n   173→      VALUES (${aliceId}, 'comment', 'Bob commented on ENG-2: Implement real-time notifications', ${notifIssueId}, false, false)\n   174→    `;\n   175→    await sql`\n   176→      INSERT INTO notifications (member_id, type, message, issue_id, read, archived)\n   177→      VALUES (${aliceId}, 'mention', 'Carol mentioned you in ENG-2: Implement real-time notifications', ${notifIssueId}, false, false)\n   178→    `;\n   179→  }\n   180→\n   181→  console.log('Database seeded successfully');\n   182→}\n   183→\n   184→export async function resetDatabase(databaseUrl: string) {\n   185→  await truncateAndSeed(databaseUrl);\n   186→}\n   187→\n   188→// CLI\n   189→const url = process.argv[2];\n   190→if (url) {\n   191→  truncateAndSeed(url).then(() => {\n   192→    process.exit(0);\n   193→  }).catch((err) => {\n   194→    console.error('Seed failed:', err);\n   195→    process.exit(1);\n   196→  });\n   197→}\n   198→"}]},"parent_tool_use_id":"toolu_01PXe1kgiB6QnYdYr74jyDNJ","session_id":"10e19085-a83f-4be1-bcf4-a4ad823ec258","uuid":"abe22fa7-8ccf-408b-b5b9-27795ae0be0d"}
