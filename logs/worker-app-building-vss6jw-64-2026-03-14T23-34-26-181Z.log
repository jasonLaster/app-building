[2026-03-14T23:30:56.198Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DHRnzWLJrpwKvaz7jEFgb4","type":"tool_result","content":"     1→import { createSlice, createAsyncThunk } from '@reduxjs/toolkit'\n     2→\n     3→export interface User {\n     4→  id: string\n     5→  email: string\n     6→  name: string\n     7→  avatar_url: string | null\n     8→  bio: string | null\n     9→  phone: string | null\n    10→  is_host: boolean\n    11→  created_at: string\n    12→}\n    13→\n    14→interface AuthState {\n    15→  currentUser: User | null\n    16→  loading: boolean\n    17→  error: string | null\n    18→}\n    19→\n    20→function loadUserFromStorage(): User | null {\n    21→  try {\n    22→    const stored = localStorage.getItem('currentUser')\n    23→    return stored ? JSON.parse(stored) : null\n    24→  } catch {\n    25→    return null\n    26→  }\n    27→}\n    28→\n    29→function saveUserToStorage(user: User | null) {\n    30→  if (user) {\n    31→    localStorage.setItem('currentUser', JSON.stringify(user))\n    32→  } else {\n    33→    localStorage.removeItem('currentUser')\n    34→  }\n    35→}\n    36→\n    37→const initialState: AuthState = {\n    38→  currentUser: loadUserFromStorage(),\n    39→  loading: false,\n    40→  error: null,\n    41→}\n    42→\n    43→export const loginUser = createAsyncThunk(\n    44→  'auth/loginUser',\n    45→  async (email: string, { rejectWithValue }) => {\n    46→    const response = await fetch('/api/auth', {\n    47→      method: 'POST',\n    48→      headers: { 'Content-Type': 'application/json' },\n    49→      body: JSON.stringify({ email }),\n    50→    })\n    51→    const data = await response.json()\n    52→    if (!response.ok) {\n    53→      return rejectWithValue(data.error || 'Login failed')\n    54→    }\n    55→    return data as User\n    56→  }\n    57→)\n    58→\n    59→export const registerUser = createAsyncThunk(\n    60→  'auth/registerUser',\n    61→  async ({ name, email }: { name: string; email: string }, { rejectWithValue }) => {\n    62→    const response = await fetch('/api/auth', {\n    63→      method: 'POST',\n    64→      headers: { 'Content-Type': 'application/json' },\n    65→      body: JSON.stringify({ name, email }),\n    66→    })\n    67→    const data = await response.json()\n    68→    if (!response.ok) {\n    69→      return rejectWithValue(data.error || 'Registration failed')\n    70→    }\n    71→    return data as User\n    72→  }\n    73→)\n    74→\n    75→export const updateUser = createAsyncThunk(\n    76→  'auth/updateUser',\n    77→  async (\n    78→    { id, ...fields }: { id: string; name?: string; bio?: string | null; phone?: string | null; avatar_url?: string | null },\n    79→    { rejectWithValue }\n    80→  ) => {\n    81→    const response = await fetch(`/api/users/${id}`, {\n    82→      method: 'PUT',\n    83→      headers: { 'Content-Type': 'application/json' },\n    84→      body: JSON.stringify(fields),\n    85→    })\n    86→    const data = await response.json()\n    87→    if (!response.ok) {\n    88→      return rejectWithValue(data.error || 'Update failed')\n    89→    }\n    90→    return data as User\n    91→  }\n    92→)\n    93→\n    94→export const becomeHost = createAsyncThunk(\n    95→  'auth/becomeHost',\n    96→  async (userId: string, { rejectWithValue }) => {\n    97→    const response = await fetch(`/api/users/${userId}/become-host`, {\n    98→      method: 'POST',\n    99→      headers: { 'Content-Type': 'application/json' },\n   100→    })\n   101→    const data = await response.json()\n   102→    if (!response.ok) {\n   103→      return rejectWithValue(data.error || 'Failed to become host')\n   104→    }\n   105→    return data as User\n   106→  }\n   107→)\n   108→\n   109→const authSlice = createSlice({\n   110→  name: 'auth',\n   111→  initialState,\n   112→  reducers: {\n   113→    logout(state) {\n   114→      state.currentUser = null\n   115→      state.error = null\n   116→      saveUserToStorage(null)\n   117→    },\n   118→    clearError(state) {\n   119→      state.error = null\n   120→    },\n   121→  },\n   122→  extraReducers: (builder) => {\n   123→    builder\n   124→      .addCase(loginUser.pending, (state) => {\n   125→        state.loading = true\n   126→        state.error = null\n   127→      })\n   128→      .addCase(loginUser.fulfilled, (state, action) => {\n   129→        state.loading = false\n   130→        state.currentUser = action.payload\n   131→        state.error = null\n   132→        saveUserToStorage(action.payload)\n   133→      })\n   134→      .addCase(loginUser.rejected, (state, action) => {\n   135→        state.loading = false\n   136→        state.error = action.payload as string\n   137→      })\n   138→      .addCase(registerUser.pending, (state) => {\n   139→        state.loading = true\n   140→        state.error = null\n   141→      })\n   142→      .addCase(registerUser.fulfilled, (state, action) => {\n   143→        state.loading = false\n   144→        state.currentUser = action.payload\n   145→        state.error = null\n   146→        saveUserToStorage(action.payload)\n   147→      })\n   148→      .addCase(registerUser.rejected, (state, action) => {\n   149→        state.loading = false\n   150→        state.error = action.payload as string\n   151→      })\n   152→      .addCase(updateUser.fulfilled, (state, action) => {\n   153→        state.currentUser = action.payload\n   154→        saveUserToStorage(action.payload)\n   155→      })\n   156→      .addCase(becomeHost.fulfilled, (state, action) => {\n   157→        state.currentUser = action.payload\n   158→        saveUserToStorage(action.payload)\n   159→      })\n   160→  },\n   161→})\n   162→\n   163→export const { logout, clearError } = authSlice.actions\n   164→export default authSlice.reducer\n   165→"}]},"parent_tool_use_id":"toolu_017XhAF8qmexwiHi3mM3GhgD","session_id":"624c3583-9a36-4974-ba26-76d645b863d6","uuid":"