[2026-03-14T19:59:21.584Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017UUKD9JcaTVJ1yhqfZziTy","type":"tool_result","content":"     1→import { createSlice, createAsyncThunk } from '@reduxjs/toolkit'\n     2→\n     3→export interface User {\n     4→  id: string\n     5→  email: string\n     6→  name: string\n     7→  avatar_url: string | null\n     8→  bio: string | null\n     9→  phone: string | null\n    10→  is_host: boolean\n    11→  created_at: string\n    12→}\n    13→\n    14→interface AuthState {\n    15→  currentUser: User | null\n    16→  loading: boolean\n    17→  error: string | null\n    18→}\n    19→\n    20→const initialState: AuthState = {\n    21→  currentUser: null,\n    22→  loading: false,\n    23→  error: null,\n    24→}\n    25→\n    26→export const loginUser = createAsyncThunk(\n    27→  'auth/loginUser',\n    28→  async (email: string, { rejectWithValue }) => {\n    29→    const response = await fetch('/api/auth', {\n    30→      method: 'POST',\n    31→      headers: { 'Content-Type': 'application/json' },\n    32→      body: JSON.stringify({ email }),\n    33→    })\n    34→    const data = await response.json()\n    35→    if (!response.ok) {\n    36→      return rejectWithValue(data.error || 'Login failed')\n    37→    }\n    38→    return data as User\n    39→  }\n    40→)\n    41→\n    42→export const registerUser = createAsyncThunk(\n    43→  'auth/registerUser',\n    44→  async ({ name, email }: { name: string; email: string }, { rejectWithValue }) => {\n    45→    const response = await fetch('/api/auth', {\n    46→      method: 'POST',\n    47→      headers: { 'Content-Type': 'application/json' },\n    48→      body: JSON.stringify({ name, email }),\n    49→    })\n    50→    const data = await response.json()\n    51→    if (!response.ok) {\n    52→      return rejectWithValue(data.error || 'Registration failed')\n    53→    }\n    54→    return data as User\n    55→  }\n    56→)\n    57→\n    58→export const updateUser = createAsyncThunk(\n    59→  'auth/updateUser',\n    60→  async (\n    61→    { id, ...fields }: { id: string; name?: string; bio?: string | null; phone?: string | null; avatar_url?: string | null },\n    62→    { rejectWithValue }\n    63→  ) => {\n    64→    const response = await fetch(`/api/users/${id}`, {\n    65→      method: 'PUT',\n    66→      headers: { 'Content-Type': 'application/json' },\n    67→      body: JSON.stringify(fields),\n    68→    })\n    69→    const data = await response.json()\n    70→    if (!response.ok) {\n    71→      return rejectWithValue(data.error || 'Update failed')\n    72→    }\n    73→    return data as User\n    74→  }\n    75→)\n    76→\n    77→export const becomeHost = createAsyncThunk(\n    78→  'auth/becomeHost',\n    79→  async (userId: string, { rejectWithValue }) => {\n    80→    const response = await fetch(`/api/users/${userId}/become-host`, {\n    81→      method: 'POST',\n    82→      headers: { 'Content-Type': 'application/json' },\n    83→    })\n    84→    const data = await response.json()\n    85→    if (!response.ok) {\n    86→      return rejectWithValue(data.error || 'Failed to become host')\n    87→    }\n    88→    return data as User\n    89→  }\n    90→)\n    91→\n    92→const authSlice = createSlice({\n    93→  name: 'auth',\n    94→  initialState,\n    95→  reducers: {\n    96→    logout(state) {\n    97→      state.currentUser = null\n    98→      state.error = null\n    99→    },\n   100→    clearError(state) {\n   101→      state.error = null\n   102→    },\n   103→  },\n   104→  extraReducers: (builder) => {\n   105→    builder\n   106→      .addCase(loginUser.pending, (state) => {\n   107→        state.loading = true\n   108→        state.error = null\n   109→      })\n   110→      .addCase(loginUser.fulfilled, (state, action) => {\n   111→        state.loading = false\n   112→        state.currentUser = action.payload\n   113→        state.error = null\n   114→      })\n   115→      .addCase(loginUser.rejected, (state, action) => {\n   116→        state.loading = false\n   117→        state.error = action.payload as string\n   118→      })\n   119→      .addCase(registerUser.pending, (state) => {\n   120→        state.loading = true\n   121→        state.error = null\n   122→      })\n   123→      .addCase(registerUser.fulfilled, (state, action) => {\n   124→        state.loading = false\n   125→        state.currentUser = action.payload\n   126→        state.error = null\n   127→      })\n   128→      .addCase(registerUser.rejected, (state, action) => {\n   129→        state.loading = false\n   130→        state.error = action.payload as string\n   131→      })\n   132→      .addCase(updateUser.fulfilled, (state, action) => {\n   133→        state.currentUser = action.payload\n   134→      })\n   135→      .addCase(becomeHost.fulfilled, (state, action) => {\n   136→        state.currentUser = action.payload\n   137→      })\n   138→  },\n   139→})\n   140→\n   141→export const { logout, clearError } = authSlice.actions\n   142→export default authSlice.reducer\n   143→"}]},"parent_tool_use_id":"toolu_01Ya4D4Po5qBs6VDDUntHGsS","session_id":"4b8e85d4-c615-49d3-9dcd-b514bc030171","uuid":"02ca3a54-b1c3-46c7-9b48-22bd0cb31a57"}
