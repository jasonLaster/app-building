nt').click()\n   325→    await expect(page.getByTestId('bathrooms-value')).toHaveText('0')\n   326→\n   327→    // Click Next\n   328→    await page.getByTestId('add-listing-next').click()\n   329→\n   330→    // Should still be on step 3\n   331→    await expect(page.getByTestId('add-listing-step-3')).toBeVisible()\n   332→\n   333→    // Validation error should appear\n   334→    await expect(page.getByTestId('add-listing-step-3')).toContainText('Max guests must be at least 1')\n   335→  })\n   336→\n   337→  test('Step 4 — Amenities selection displayed', async ({ page }) => {\n   338→    await openAddListingForm(page)\n   339→    await completeStep1(page)\n   340→    await completeStep2(page)\n   341→    await completeStep3(page)\n   342→\n   343→    // Step 4 should be visible\n   344→    await expect(page.getByTestId('add-listing-step-4')).toBeVisible()\n   345→\n   346→    // Step indicator shows step 4 of 7\n   347→    await expect(page.getByTestId('step-indicator')).toContainText('Step 4 of 7')\n   348→\n   349→    // Category headings should be visible\n   350→    await expect(page.getByTestId('add-listing-step-4')).toContainText('Essentials')\n   351→    await expect(page.getByTestId('add-listing-step-4')).toContainText('Features')\n   352→    await expect(page.getByTestId('add-listing-step-4')).toContainText('Safety')\n   353→    await expect(page.getByTestId('add-listing-step-4')).toContainText('Location')\n   354→\n   355→    // Some amenity checkboxes should be visible\n   356→    await expect(page.getByTestId(`amenity-checkbox-${AMENITY_WIFI}`)).toBeVisible()\n   357→    await expect(page.getByTestId(`amenity-checkbox-${AMENITY_KITCHEN}`)).toBeVisible()\n   358→    await expect(page.getByTestId(`amenity-checkbox-${AMENITY_POOL}`)).toBeVisible()\n   359→  })\n   360→\n   361→  test('Step 4 — Selecting amenities', async ({ page }) => {\n   362→    await openAddListingForm(page)\n   363→    await completeStep1(page)\n   364→    await completeStep2(page)\