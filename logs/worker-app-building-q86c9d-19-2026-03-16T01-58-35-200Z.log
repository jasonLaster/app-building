e=\"overflow-x-auto\">\n    90→          <table data-testid=\"bookings-table\" className=\"w-full\">\n    91→            <thead>\n    92→              <tr className=\"border-b border-border\">\n    93→                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Property</th>\n    94→                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Guest</th>\n    95→                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Check-in</th>\n    96→                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Check-out</th>\n    97→                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Guests</th>\n    98→                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Total</th>\n    99→                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Status</th>\n   100→                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Actions</th>\n   101→              </tr>\n   102→            </thead>\n   103→            <tbody>\n   104→              {filteredBookings.map((booking) => (\n   105→                <tr\n   106→                  key={booking.id}\n   107→                  data-testid={`booking-row-${booking.id}`}\n   108→                  className=\"border-b border-border hover:bg-bg-secondary/50 transition-colors\"\n   109→                >\n   110→                  <td className=\"py-3 px-4 text-sm font-medium text-text\">{booking.property_title}</td>\n   111→                  <td className=\"py-3 px-4 text-sm text-text\">{booking.guest_name}</td>\n   112→                  <td className=\"py-3 px-4 text-sm text-text-secondary\">{formatDate(booking.check_in)}</td>\n   113→                  <td className=\"py-3 px-4 text-sm text-text-secondary\">{formatDate(booking.check_out)}</td>\n   114→                  <td className=\"py-3 px-4 text-sm text-text\">{booking.num_guests}</td>\n   115→                  <td className=\"py-3 px-4 text-sm font-medium text-text\">\n   116→                    ${Number(booking.total_price).toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}\n   117→                  </td>\n   118→                  <td className=\"py-3 px-4\">\n   119→                    <span\n   120→                      data-testid={`booking-status-${booking.id}`}\n   121→                      className={`inline-block px-2.5 py-1 rounded-full text-xs font-semibold capitalize ${statusColors[booking.status] || ''}`}\n   122→                    >\n   123→                      {booking.status}\n   124→                    </span>\n   125→                  </td>\n   126→                  <td className=\"py-3 px-4\">\n   127→                    {booking.status === 'pending' && (\n   128→                      <div className=\"flex gap-2\">\n   129→                        <button\n   130→                          data-testid={`booking-confirm-${booking.id}`}\n   131→                          onClick={() => handleConfirm(booking.id)}\n   132→                          disabled={actionLoading === booking.id}\n   133→                          className=\"px-3 py-1.5 text-xs font-medium text-white bg-status-confirmed rounded-lg hover:opacity-90 transition-opacity disabled:opacity-50\"\n   134→                        >\n   135→                          {actionLoading === booking.id ? '...' : 'Confirm'}\n   136→                        </button>\n   137→                        <button\n   138→                          data-testid={`booking-cancel-${booking.id}`}\n   139→                          onClick={() => handleCancelClick(booking)}\n   140→                          disabled={actionLoading === booking.id}\n   141→                          className=\"px-3 py-1.5 text-xs font-medium text-white bg-status-cancelled rounded-lg hover:opacity-90 transition-opacity disabled:opacity-50\"\n   142→                        >\n   143→                          Cancel\n   144→                        </button>\n   145→                      </div>\n   146→                    )}\n   147→                    {booking.status === 'confirmed' && (\n   148→                      <button\n   149→                        data-testid={`booking-cancel-${booking.id}`}\n   150→                        onClick={() => handleCancelClick(booking)}\n   151→                        disabled={actionLoading === booking.id}\n   152→                        className=\"px-3 py-1.5 text-xs font-medium text-white bg-status-cancelled rounded-lg hover:opacity-90 transition-opacity disabled:opacity-50\"\n   153→                      >\n   154→                        Cancel\n   155→                      </button>\n   156→                    )}\n   157→                  </td>\n   158→                </tr>\n   159→              ))}\n   160→            </tbody>\n   161→          </table>\n   162→        </div>\n   163→      )}\n   164→\n   165→      {cancelDialog && (\n   166→        <div\n   167→          data-testid=\"cancel-booking-dialog\"\n   168→          className=\"fixed inset-0 bg-black/50 flex items-center justify-center z-50\"\n   169→          onClick={() => setCancelDialog(null)}\n   170→        >\n   171→          <div\n   172→            className=\"bg-white rounded-xl p-6 max-w-md w-full mx-4 shadow-lg\"\n   173→            onClick={(e) => e.stopPropagation()}\n   174→          >\n   175→            <h3 className=\"text-lg font-semibold text-text mb-2\">Cancel Booking</h3>\n   176→            <p className=\"text-text-secondary mb-1\">Are you sure you want to cancel this booking?</p>\n   177→            <div className=\"bg-bg-secondary rounded-lg p-3 mb-6 text-sm\">\n   178→              <p className=\"font-medium text-text\">{cancelDialog.property_title}</p>\n   179→              <p className=\"text-text-secondary\">Guest: {cancelDialog.guest_name}</p>\n   180→              <p className=\"text-text-secondary\">\n   181→                {formatDate(cancelDialog.check_in)} — {formatDate(cancelDialog.check_out)}\n   182→              </p>\n   183→            </div>\n   184→            <div className=\"flex gap-3 justify-end\">\n   185→              <button\n   186→                data-testid=\"cancel-booking-dialog-dismiss\"\n   187→                onClick={() => setCancelDialog(null)}\n   188→                className=\"px-4 py-2 text-sm font-medium text-text bg-bg-secondary rounded-lg hover:bg-border transition-colors\"\n   189→              >\n   190→                Keep Booking\n   191→              </button>\n   192→              <button\n   193→                data-testid=\"cancel-booking-dialog-confirm\"\n   194→                onClick={handleConfirmCancel}\n   195→                disabled={actionLoading === cancelDialog.id}\n   196→                className=\"px-4 py-2 text-sm font-medium text-white bg-status-cancelled rounded-lg hover:opacity-90 transition-opacity disabled:opacity-50\"\n   197→              >\n   198→                {actionLoading === cancelDialog.id ? 'Cancelling...' : 'Yes, Cancel'}\n   199→              </button>\n   200→            </div>\n   201→          </div>\n   202→        </div>\n   203→      )}\n   204→    </div>\n   205→  )\n   206→}\n   207→"}]},"parent_tool_use_id":null,"session_id":"6906f647-fc66-40dd-bce6-1567d9ff29c1","uuid":"b39cf8cc-a1f1-42f7-9e63-83dfd131f3e0","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/components/BookingsTab.tsx","content":"import { useState } from 'react'\nimport { Loader2, Calendar } from 'lucide-react'\nimport type { HostBooking } from '../slices/hostSlice'\n\ninterface BookingsTabProps {\n  bookings: HostBooking[]\n  loading: boolean\n  onConfirm: (bookingId: string) => Promise<void>\n  onCancel: (bookingId: string) => Promise<void>\n}\n\nconst STATUS_FILTERS = ['All', 'Pending', 'Confirmed', 'Cancelled', 'Completed'] as const\ntype StatusFilter = (typeof STATUS_FILTERS)[number]\n\nconst statusColors: Record<string, string> = {\n  pending: 'bg-status-pending/20 text-status-pending',\n  confirmed: 'bg-status-confirmed/20 text-status-confirmed',\n  cancelled: 'bg-status-cancelled/20 text-status-cancelled',\n  completed: 'bg-status-completed/20 text-status-completed',\n}\n\nfunction formatDate(dateStr: string): string {\n  const d = new Date(dateStr.split('T')[0] + 'T12:00:00')\n  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })\n}\n\nexport default function BookingsTab({ bookings, loading, onConfirm, onCancel }: BookingsTabProps) {\n  const [activeFilter, setActiveFilter] = useState<StatusFilter>('All')\n  const [cancelDialog, setCancelDialog] = useState<HostBooking | null>(null)\n  const [actionLoading, setActionLoading] = useState<string | null>(null)\n\n  const filteredBookings = activeFilter === 'All'\n    ? bookings\n    : bookings.filter((b) => b.status === activeFilter.toLowerCase())\n\n  const handleConfirm = async (bookingId: string) => {\n    setActionLoading(bookingId)\n    await onConfirm(bookingId)\n    setActionLoading(null)\n  }\n\n  const handleCancelClick = (booking: HostBooking) => {\n    setCancelDialog(booking)\n  }\n\n  const handleConfirmCancel = async () => {\n    if (!cancelDialog) return\n    setActionLoading(cancelDialog.id)\n    await onCancel(cancelDialog.id)\n    setActionLoading(null)\n    setCancelDialog(null)\n  }\n\n  if (loading) {\n    return (\n      <div className=\"flex items-center justify-center py-16\">\n        <Loader2 size={32} className=\"animate-spin text-primary\" />\n      </div>\n    )\n  }\n\n  return (\n    <div data-testid=\"bookings-tab\">\n      <div className=\"flex items-center gap-2 mb-6 flex-wrap\">\n        {STATUS_FILTERS.map((filter) => (\n          <button\n            key={filter}\n            data-testid={`booking-filter-${filter.toLowerCase()}`}\n            onClick={() => setActiveFilter(filter)}\n            className={`px-4 py-2 rounded-full text-sm font-medium transition-colors ${\n              activeFilter === filter\n                ? 'bg-primary text-white'\n                : 'bg-bg-secondary text-text-secondary hover:bg-border'\n            }`}\n          >\n            {filter}\n          </button>\n        ))}\n      </div>\n\n      {filteredBookings.length === 0 ? (\n        <div data-testid=\"bookings-empty-state\" className=\"text-center py-16\">\n          <Calendar size={48} className=\"mx-auto text-text-secondary mb-4 opacity-50\" />\n          <p className=\"text-text-secondary text-lg\">\n            {activeFilter === 'All' ? 'No bookings yet' : `No ${activeFilter.toLowerCase()} bookings`}\n          </p>\n        </div>\n      ) : (\n        <div className=\"overflow-x-auto\">\n          <table data-testid=\"bookings-table\" className=\"w-full\">\n            <thead>\n              <tr className=\"border-b border-border\">\n                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Property</th>\n                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Guest</th>\n                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Check-in</th>\n                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Check-out</th>\n                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Guests</th>\n                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Total</th>\n                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Status</th>\n                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Actions</th>\n              </tr>\n            </thead>\n            <tbody>\n              {filteredBookings.map((booking) => (\n                <tr\n                  key={booking.id}\n                  data-testid={`booking-row-${booking.id}`}\n                  className=\"border-b border-border hover:bg-bg-secondary/50 transition-colors\"\n                >\n                  <td className=\"py-3 px-4 text-sm font-medium text-text\">{booking.property_title}</td>\n                  <td className=\"py-3 px-4 text-sm text-text\">{booking.guest_name}</td>\n                  <td className=\"py-3 px-4 text-sm text-text-secondary\">{formatDate(booking.check_in)}</td>\n                  <td className=\"py-3 px-4 text-sm text-text-secondary\">{formatDate(booking.check_out)}</td>\n                  <td className=\"py-3 px-4 text-sm text-text\">{booking.num_guests}</td>\n                  <td className=\"py-3 px-4 text-sm font-medium text-text\">\n                    ${Number(booking.total_price).toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}\n                  </td>\n                  <td className=\"py-3 px-4\">\n                    <span\n                      data-testid={`booking-status-${booking.id}`}\n                      className={`inline-block px-2.5 py-1 rounded-full text-xs font-semibold capitalize ${statusColors[booking.status] || ''}`}\n                    >\n                      {booking.status}\n                    </span>\n                  </td>\n                  <td className=\"py-3 px-4\">\n                    {booking.status === 'pending' && (\n                      <div className=\"flex gap-2\">\n                        <button\n                          data-testid={`booking-confirm-${booking.id}`}\n                          onClick={() => handleConfirm(booking.id)}\n                          disabled={actionLoading === booking.id}\n                          className=\"px-3 py-1.5 text-xs font-medium text-white bg-status-confirmed rounded-lg hover:opacity-90 transition-opacity disabled:opacity-50\"\n                        >\n                          {actionLoading === booking.id ? '...' : 'Confirm'}\n                        </button>\n                        <button\n                          data-testid={`booking-cancel-${booking.id}`}\n                          onClick={() => handleCancelClick(booking)}\n                          disabled={actionLoading === booking.id}\n                          className=\"px-3 py-1.5 text-xs font-medium text-white bg-status-cancelled rounded-lg hover:opacity-90 transition-opacity disabled:opacity-50\"\n                        >\n                          Cancel\n                        </button>\n                      </div>\n                    )}\n                    {booking.status === 'confirmed' && (\n                      <button\n                        data-testid={`booking-cancel-${booking.id}`}\n                        onClick={() => handleCancelClick(booking)}\n                        disabled={actionLoading === booking.id}\n                        className=\"px-3 py-1.5 text-xs font-medium text-white bg-status-cancelled rounded-lg hover:opacity-90 transition-opacity disabled:opacity-50\"\n                      >\n                        Cancel\n                      </button>\n                    )}\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      )}\n\n      {cancelDialog && (\n        <div\n          data-testid=\"cancel-booking-dialog\"\n          className=\"fixed inset-0 bg-black/50 flex items-center justify-center z-50\"\n          onClick={() => setCancelDialog(null)}\n        >\n          <div\n            className=\"bg-white rounded-xl p-6 max-w-md w-full mx-4 shadow-lg\"\n            onClick={(e) => e.stopPropagation()}\n          >\n            <h3 className=\"text-lg font-semibold text-text mb-2\">Cancel Booking</h3>\n            <p className=\"text-text-secondary mb-1\">Are you sure you want to cancel this booking?</p>\n            <div className=\"bg-bg-secondary rounded-lg p-3 mb-6 text-sm\">\n              <p className=\"font-medium text-text\">{cancelDialog.property_title}</p>\n              <p className=\"text-text-secondary\">Guest: {cancelDialog.guest_name}</p>\n              <p className=\"text-text-secondary\">\n                {formatDate(cancelDialog.check_in)} — {formatDate(cancelDialog.check_out)}\n              </p>\n            </div>\n            <div className=\"flex gap-3 justify-end\">\n              <button\n                data-testid=\"cancel-booking-dialog-dismiss\"\n                onClick={() => setCancelDialog(null)}\n                className=\"px-4 py-2 text-sm font-medium text-text bg-bg-secondary rounded-lg hover:bg-border transition-colors\"\n              >\n                Keep Booking\n              </button>\n              <button\n                data-testid=\"cancel-booking-dialog-confirm\"\n                onClick={handleConfirmCancel}\n                disabled={actionLoading === cancelDialog.id}\n                className=\"px-4 py-2 text-sm font-medium text-white bg-status-cancelled rounded-lg hover:opacity-90 transition-opacity disabled:opacity-50\"\n              >\n                {actionLoading === cancelDialog.id ? 'Cancelling...' : 'Yes, Cancel'}\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  )\n}\n","numLines":207,"startLine":1,"totalLines":207}}}
