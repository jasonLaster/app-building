[2026-03-16T03:06:24.894Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SLdHohHJwdF1gBgZzoVUsw","type":"tool_result","content":"     1→import { useState } from 'react'\n     2→import { Search } from 'lucide-react'\n     3→\n     4→interface SearchBarProps {\n     5→  onSearch: (filters: { city: string; checkIn: string; checkOut: string; guests: number }) => void\n     6→  initialCity?: string\n     7→  initialCheckIn?: string\n     8→  initialCheckOut?: string\n     9→  initialGuests?: number\n    10→}\n    11→\n    12→export default function SearchBar({ onSearch, initialCity = '', initialCheckIn = '', initialCheckOut = '', initialGuests = 0 }: SearchBarProps) {\n    13→  const [city, setCity] = useState(initialCity)\n    14→  const [checkIn, setCheckIn] = useState(initialCheckIn)\n    15→  const [checkOut, setCheckOut] = useState(initialCheckOut)\n    16→  const [guests, setGuests] = useState(initialGuests)\n    17→\n    18→  const today = new Date().toISOString().split('T')[0]\n    19→\n    20→  const checkOutMin = (() => {\n    21→    if (!checkIn) return today\n    22→    const d = new Date(checkIn + 'T00:00:00')\n    23→    d.setDate(d.getDate() + 1)\n    24→    return d.toISOString().split('T')[0]\n    25→  })()\n    26→\n    27→  const handleSubmit = (e: React.FormEvent) => {\n    28→    e.preventDefault()\n    29→    onSearch({ city, checkIn, checkOut, guests })\n    30→  }\n    31→\n    32→  const handleGuestsChange = (value: string) => {\n    33→    const num = parseInt(value, 10)\n    34→    if (isNaN(num) || num < 1) {\n    35→      setGuests(1)\n    36→    } else {\n    37→      setGuests(num)\n    38→    }\n    39→  }\n    40→\n    41→  return (\n    42→    <form\n    43→      data-testid=\"search-bar\"\n    44→      onSubmit={handleSubmit}\n    45→      className=\"flex items-center rounded-full border border-border bg-bg shadow-md hover:shadow-lg transition-shadow max-w-3xl mx-auto\"\n    46→    >\n    47→      <div className=\"flex-1 min-w-0 px-6 py-3\">\n    48→        <label className=\"block text-xs font-semibold text-text\">Where</label>\n    49→        <input\n    50→          data-testid=\"search-location\"\n    51→          type=\"text\"\n    52→          placeholder=\"Where are you going?\"\n    53→          value={city}\n    54→          onChange={(e) => setCity(e.target.value)}\n    55→          className=\"w-full text-sm text-text-secondary outline-none bg-transparent placeholder-text-secondary\"\n    56→        />\n    57→      </div>\n    58→\n    59→      <div className=\"w-px h-8 bg-border shrink-0\" />\n    60→\n    61→      <div className=\"px-4 py-3\">\n    62→        <label className=\"block text-xs font-semibold text-text\">When</label>\n    63→        <div className=\"flex items-center gap-2\">\n    64→          <input\n    65→            data-testid=\"search-checkin\"\n    66→            type=\"date\"\n    67→            value={checkIn}\n    68→            min={today}\n    69→            onChange={(e) => {\n    70→              setCheckIn(e.target.value)\n    71→              if (checkOut && e.target.value >= checkOut) {\n    72→                setCheckOut('')\n    73→              }\n    74→            }}\n    75→            className=\"text-sm text-text-secondary outline-none bg-transparent w-[130px]\"\n    76→          />\n    77→          <span className=\"text-text-secondary text-xs\">–</span>\n    78→          <input\n    79→            data-testid=\"search-checkout\"\n    80→            type=\"date\"\n    81→            value={checkOut}\n    82→            min={checkOutMin}\n    83→            onChange={(e) => setCheckOut(e.target.value)}\n    84→            className=\"text-sm text-text-secondary outline-none bg-transparent w-[130px]\"\n    85→          />\n    86→        </div>\n    87→      </div>\n    88→\n    89→      <div className=\"w-px h-8 bg-border shrink-0\" />\n    90→\n    91→      <div className=\"flex items-center gap-2 pl-4 pr-2 py-2\">\n    92→        <div>\n    93→          <label className=\"block text-xs font-semibold text-text\">Who</label>\n    94→          <input\n    95→            data-testid=\"search-guests\"\n    96→            type=\"number\"\n    97→            min={1}\n    98→            placeholder=\"Add guests\"\n    99→            value={guests || ''}\n   100→            onChange={(e) => handleGuestsChange(e.target.value)}\n   101→            className=\"w-24 text-sm text-text-secondary outline-none bg-transparent placeholder-text-secondary\"\n   102→          />\n   103→        </div>\n   104→        <button\n   105→          data-testid=\"search-button\"\n   106→          type=\"submit\"\n   107→          className=\"flex items-center justify-center rounded-full bg-primary p-3 text-white hover:bg-primary-dark transition-colors shrink-0\"\n   108→        >\n   109→          <Search size={16} />\n   110→        </button>\n   111→      </div>\n   112→    </form>\n   113→  )\n   114→}\n   115→"}]},"parent_tool_use_id":"toolu_01ACeYYC9ZFpLxDMj3EpFqMU","session_id":"7cf5a2ff-0ab5-4175-9389-38775b817822","uuid":"57db7ca4-ed75-4f42-9c80-dbe330390e75"}
