[2026-03-16T04:10:07.283Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018WDWgaqUwK65Km6qPdVYeE","type":"tool_result","content":"     1→import { useState, useEffect, useRef, useCallback } from 'react'\n     2→import { useNavigate } from 'react-router-dom'\n     3→import { Star, Edit, Power, Plus, Loader2, MapPin } from 'lucide-react'\n     4→import type { Property } from '../slices/propertiesSlice'\n     5→\n     6→interface ListingsTabProps {\n     7→  listings: Property[]\n     8→  loading: boolean\n     9→  onDeactivate: (property: Property) => Promise<void>\n    10→  onActivate: (property: Property) => Promise<void>\n    11→  onAddListing: () => void\n    12→}\n    13→\n    14→export default function ListingsTab({ listings, loading, onDeactivate, onActivate, onAddListing }: ListingsTabProps) {\n    15→  const navigate = useNavigate()\n    16→  const [confirmDialog, setConfirmDialog] = useState<Property | null>(null)\n    17→  const [actionLoading, setActionLoading] = useState<string | null>(null)\n    18→  const dialogRef = useRef<HTMLDivElement>(null)\n    19→  const triggerRef = useRef<HTMLButtonElement | null>(null)\n    20→\n    21→  const handleKeyDown = useCallback((e: KeyboardEvent) => {\n    22→    if (e.key === 'Escape') {\n    23→      setConfirmDialog(null)\n    24→    }\n    25→    if (e.key === 'Tab' && dialogRef.current) {\n    26→      const focusable = dialogRef.current.querySelectorAll<HTMLElement>(\n    27→        'button, [href], input, select, textarea, [tabindex]:not([tabindex=\"-1\"])'\n    28→      )\n    29→      const first = focusable[0]\n    30→      const last = focusable[focusable.length - 1]\n    31→      if (e.shiftKey && document.activeElement === first) {\n    32→        e.preventDefault()\n    33→        last?.focus()\n    34→      } else if (!e.shiftKey && document.activeElement === last) {\n    35→        e.preventDefault()\n    36→        first?.focus()\n    37→      }\n    38→    }\n    39→  }, [])\n    40→\n    41→  useEffect(() => {\n    42→    if (confirmDialog) {\n    43→      document.addEventListener('keydown', handleKeyDown)\n    44→      dialogRef.current?.querySelector<HTMLElement>('button')?.focus()\n    45→      return () => document.removeEventListener('keydown', handleKeyDown)\n    46→    } else {\n    47→      triggerRef.current?.focus()\n    48→    }\n    49→  }, [confirmDialog, handleKeyDown])\n    50→\n    51→  const handleDeactivateClick = (property: Property, button: HTMLButtonElement) => {\n    52→    triggerRef.current = button\n    53→    setConfirmDialog(property)\n    54→  }\n    55→\n    56→  const handleConfirmDeactivate = async () => {\n    57→    if (!confirmDialog) return\n    58→    setActionLoading(confirmDialog.id)\n    59→    await onDeactivate(confirmDialog)\n    60→    setActionLoading(null)\n    61→    setConfirmDialog(null)\n    62→  }\n    63→\n    64→  const handleActivate = async (property: Property) => {\n    65→    setActionLoading(property.id)\n    66→    await onActivate(property)\n    67→    setActionLoading(null)\n    68→  }\n    69→\n    70→  if (loading) {\n    71→    return (\n    72→      <div className=\"flex items-center justify-center py-16\" role=\"status\">\n    73→        <Loader2 size={32} className=\"animate-spin text-primary\" aria-hidden=\"true\" />\n    74→        <span className=\"sr-only\">Loading listings...</span>\n    75→      </div>\n    76→    )\n    77→  }\n    78→\n    79→  return (\n    80→    <div data-testid=\"listings-tab\">\n    81→      <div className=\"flex items-center justify-between mb-6\">\n    82→        <h2 className=\"text-lg max-sm:text-base font-semibold text-text\">Your Listings</h2>\n    83→        <button\n    84→          data-testid=\"add-listing-button\"\n    85→          onClick={onAddListing}\n    86→          className=\"flex items-center gap-2 bg-primary text-white px-4 py-2.5 rounded-lg font-medium hover:bg-primary-dark transition-colors\"\n    87→        >\n   