[2026-03-16T04:08:41.034Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K9x6aKHwqoHCfcuSRLV6bf","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions'\n     2→import { getSql } from './db.js'\n     3→\n     4→export default async (request: Request, _context: Context) => {\n     5→  const sql = getSql()\n     6→  const url = new URL(request.url)\n     7→  const headers = { 'Content-Type': 'application/json' }\n     8→\n     9→  if (request.method === 'GET') {\n    10→    const hostId = url.searchParams.get('host_id')\n    11→    if (!hostId) {\n    12→      return new Response(JSON.stringify({ error: 'host_id is required' }), { status: 400, headers })\n    13→    }\n    14→\n    15→    const listingsResult = await sql`\n    16→      SELECT count(*)::int as total_listings\n    17→      FROM properties WHERE host_id = ${hostId} AND is_active = true\n    18→    `\n    19→    const listingsRow = listingsResult[0]\n    20→    const totalListings = listingsRow ? (listingsRow as Record<string, unknown>).total_listings as number : 0\n    21→\n    22→    const bookingsResult = await sql`\n    23→      SELECT count(*)::int as active_bookings\n    24→      FROM bookings b\n    25→      JOIN properties p ON p.id = b.property_id\n    26→      WHERE p.host_id = ${hostId} AND b.status IN ('pending', 'confirmed')\n    27→    `\n    28→    const bookingsRow = bookingsResult[0]\n    29→    const activeBookings = bookingsRow ? (bookingsRow as Record<string, unknown>).active_bookings as number : 0\n    30→\n    31→    const earningsResult = await sql`\n    32→      SELECT COALESCE(sum(b.total_price), 0)::numeric as total_earnings\n    33→      FROM bookings b\n    34→      JOIN properties p ON p.id = b.property_id\n    35→      WHERE p.host_id = ${hostId} AND b.status = 'completed'\n    36→    `\n    37→    const earningsRow = earningsResult[0]\n    38→    const totalEarnings = earningsRow ? Number((earningsRow as Record<string, unknown>).total_earnings) : 0\n    39→\n    40→    const ratingResult = await sql`\n    41→      SELECT COALESCE(AVG(r.rating)::numeric(10,1), 0) as avg_rating,\n    42→        count(*)::int as review_count\n    43→      FROM reviews r\n    44→      JOIN properties p ON p.id = r.property_id\n    45→      WHERE p.host_id = ${hostId}\n    46→    `\n    47→    const ratingRow = ratingResult[0]\n    48→    const avgRating = ratingRow ? Number((ratingRow as Record<string, unknown>).avg_rating) : 0\n    49→    const reviewCount = ratingRow ? (ratingRow as Record<string, unknown>).review_count as number : 0\n    50→\n    51→    return new Response(JSON.stringify({\n    52→      totalListings,\n    53→      activeBookings,\n    54→      totalEarnings,\n    55→      avgRating,\n    56→      reviewCount,\n    57→    }), { status: 200, headers })\n    58→  }\n    59→\n    60→  return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers })\n    61→}\n    62→"}]},"parent_tool_use_id":null,"session_id":"4877f3d7-4b15-4027-8594-e225d536fda7","uuid":"2c63b3fc-451a-4cf4-8867-0456f5616002","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/netlify/functions/host-stats.ts","content":"import type { Context } from '@netlify/functions'\nimport { getSql } from './db.js'\n\nexport default async (request: Request, _context: Context) => {\n  const sql = getSql()\n  const url = new URL(request.url)\n  const headers = { 'Content-Type': 'application/json' }\n\n  if (request.method === 'GET') {\n    const hostId = url.searchParams.get('host_id')\n    if (!hostId) {\n      return new Response(JSON.stringify({ error: 'host_id is required' }), { status: 400, headers })\n    }\n\n    const listingsResult = await sql`\n      SELECT count(*)::int as total_listings\n      FROM properties WHERE host_id = ${hostId} AND is_active = true\n    `\n    const listingsRow = listingsResult[0]\n    const totalListings = listingsRow ? (listingsRow as Record<string, unknown>).total_listings as number : 0\n\n    const bookingsResult = await sql`\n      SELECT count(*)::int as active_bookings\n      FROM bookings b\n      JOIN properties p ON p.id = b.property_id\n      WHERE p.host_id = ${hostId} AND b.status IN ('pending', 'confirmed')\n    `\n    const bookingsRow = bookingsResult[0]\n    const activeBookings = bookingsRow ? (bookingsRow as Record<string, unknown>).active_bookings as number : 0\n\n    const earningsResult = await sql`\n      SELECT COALESCE(sum(b.total_price), 0)::numeric as total_earnings\n      FROM bookings b\n      JOIN properties p ON p.id = b.property_id\n      WHERE p.host_id = ${hostId} AND b.status = 'completed'\n    `\n    const earningsRow = earningsResult[0]\n    const totalEarnings = earningsRow ? Number((earningsRow as Record<string, unknown>).total_earnings) : 0\n\n    const ratingResult = await sql`\n      SELECT COALESCE(AVG(r.rating)::numeric(10,1), 0) as avg_rating,\n        count(*)::int as review_count\n      FROM reviews r\n      JOIN properties p ON p.id = r.property_id\n      WHERE p.host_id = ${hostId}\n    `\n    const ratingRow = ratingResult[0]\n    const avgRating = ratingRow ? Number((ratingRow as Record<string, unknown>).avg_rating) : 0\n    const reviewCount = ratingRow ? (ratingRow as Record<string, unknown>).review_count as number : 0\n\n    return new Response(JSON.stringify({\n      totalListings,\n      activeBookings,\n      totalEarnings,\n      avgRating,\n      reviewCount,\n    }), { status: 200, headers })\n  }\n\n  return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers })\n}\n","numLines":62,"startLine":1,"totalLines":62}}}
