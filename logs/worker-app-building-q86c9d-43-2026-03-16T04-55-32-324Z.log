/api/properties', {\n   115→      method: 'POST',\n   116→      headers: { 'Content-Type': 'application/json' },\n   117→      body: JSON.stringify(data),\n   118→    })\n   119→    const result = await response.json()\n   120→    if (!response.ok) {\n   121→      return rejectWithValue(result.error || 'Failed to create property')\n   122→    }\n   123→    return result as Property\n   124→  }\n   125→)\n   126→\n   127→export const deactivateProperty = createAsyncThunk(\n   128→  'host/deactivateProperty',\n   129→  async (propertyId: string, { rejectWithValue }) => {\n   130→    const response = await fetch(`/api/properties/${propertyId}`, {\n   131→      method: 'DELETE',\n   132→    })\n   133→    const result = await response.json()\n   134→    if (!response.ok) {\n   135→      return rejectWithValue(result.error || 'Failed to deactivate property')\n   136→    }\n   137→    return result as Property\n   138→  }\n   139→)\n   140→\n   141→export const activateProperty = createAsyncThunk(\n   142→  'host/activateProperty',\n   143→  async (propertyId: string, { rejectWithValue }) => {\n   144→    const response = await fetch(`/api/properties/${propertyId}`, {\n   145→      method: 'PUT',\n   146→      headers: { 'Content-Type': 'application/json' },\n   147→      body: JSON.stringify({ is_active: true }),\n   148→    })\n   149→    const result = await response.json()\n   150→    if (!response.ok) {\n   151→      return rejectWithValue(result.error || 'Failed to activate property')\n   152→    }\n   153→    return result as Property\n   154→  }\n   155→)\n   156→\n   157→export const updateHostBookingStatus = createAsyncThunk(\n   158→  'host/updateBookingStatus',\n   159→  async ({ bookingId, status }: { bookingId: string; status: string }, { rejectWithValue }) => {\n   160→    const response = await fetch(`/api/bookings/${bookingId}`, {\n   161→      method: 'PUT',\n   162→      headers: { 'Content-Type': 'application/json' },\n   163→      body: JSON.stringify