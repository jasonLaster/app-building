flex items-center justify-center text-text-secondary text-sm\">\n   126→                      No image\n   127→                    </div>\n   128→                  )}\n   129→                  <span\n   130→                    data-testid={`listing-status-${property.id}`}\n   131→                    className={`absolute top-3 left-3 text-xs font-semibold px-2.5 py-1 rounded-full ${\n   132→                      property.is_active\n   133→                        ? 'bg-status-confirmed/20 text-status-confirmed'\n   134→                        : 'bg-border text-text-secondary'\n   135→                    }`}\n   136→                  >\n   137→                    {property.is_active ? 'Active' : 'Inactive'}\n   138→                  </span>\n   139→                </div>\n   140→\n   141→                <div className=\"p-4\">\n   142→                  <h3 className=\"font-semibold text-text truncate\">{property.title}</h3>\n   143→                  <div className=\"flex items-center gap-1 text-sm text-text-secondary mt-1\">\n   144→                    <MapPin size={14} aria-hidden=\"true\" />\n   145→                    <span>{property.city}</span>\n   146→                  </div>\n   147→                  <div className=\"flex items-center justify-between mt-2\">\n   148→                    <p className=\"text-sm\">\n   149→                      <span className=\"font-semibold text-text\">${Number(property.price_per_night).toFixed(0)}</span>\n   150→                      <span className=\"text-text-secondary\"> / night</span>\n   151→                    </p>\n   152→                    {reviewCount > 0 ? (\n   153→                      <div className=\"flex items-center gap-1\">\n   154→                        <Star size={14} className=\"fill-text text-text\" aria-hidden=\"true\" />\n   155→                        <span className=\"text-sm font-medium\">{rating.toFixed(1)}</span>\n   156→                        <span className=\"text-sm text-text-secondary\">({review