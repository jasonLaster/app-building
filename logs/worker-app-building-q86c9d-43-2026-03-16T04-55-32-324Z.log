       >\n                {actionLoading === confirmDialog.id ? 'Deactivating...' : 'Yes, Deactivate'}\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  )\n}\n\nfunction Home(props: { size: number; className: string; 'aria-hidden'?: boolean | 'true' | 'false' }) {\n  return (\n    <svg\n      xmlns=\"http://www.w3.org/2000/svg\"\n      width={props.size}\n      height={props.size}\n      viewBox=\"0 0 24 24\"\n      fill=\"none\"\n      stroke=\"currentColor\"\n      strokeWidth=\"2\"\n      strokeLinecap=\"round\"\n      strokeLinejoin=\"round\"\n      className={props.className}\n      aria-hidden={props['aria-hidden']}\n    >\n      <path d=\"m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\" />\n      <polyline points=\"9 22 9 12 15 12 15 22\" />\n    </svg>\n  )\n}\n","structuredPatch":[{"oldStart":201,"oldLines":6,"newStart":201,"newLines":19,"lines":["         </div>","       )}"," ","+      {hasMore && (","+        <div className=\"text-center mt-6\">","+          <button","+            data-testid=\"load-more-listings\"","+            onClick={onLoadMore}","+            disabled={loadingMore}","+            className=\"px-6 py-2.5 text-sm font-medium text-text border border-border rounded-lg hover:bg-bg-secondary transition-colors disabled:opacity-50\"","+          >","+            {loadingMore ? 'Loading...' : 'Load more listings'}","+          </button>","+        </div>","+      )}","+","       {confirmDialog && (","         <div","           data-testid=\"deactivate-dialog\""]}],"userModified":false,"replaceAll":false}}
