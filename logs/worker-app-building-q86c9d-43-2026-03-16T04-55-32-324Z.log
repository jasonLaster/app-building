[2026-03-16T04:10:06.778Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015j8JytFH1bRjWq5b4wK7fV","type":"tool_result","content":"     1→import { useState, useRef } from 'react'\n     2→import type { Booking } from '../slices/bookingsSlice'\n     3→import TripCard from './TripCard'\n     4→import { Link } from 'react-router-dom'\n     5→\n     6→type TabKey = 'upcoming' | 'past' | 'cancelled'\n     7→\n     8→interface TripsTabsProps {\n     9→  bookings: Booking[]\n    10→  onCancelBooking: (booking: Booking) => void\n    11→}\n    12→\n    13→const tabs: { key: TabKey; label: string }[] = [\n    14→  { key: 'upcoming', label: 'Upcoming' },\n    15→  { key: 'past', label: 'Past' },\n    16→  { key: 'cancelled', label: 'Cancelled' },\n    17→]\n    18→\n    19→function filterBookings(bookings: Booking[], tab: TabKey): Booking[] {\n    20→  const today = new Date().toISOString().split('T')[0]\n    21→  switch (tab) {\n    22→    case 'upcoming':\n    23→      return bookings\n    24→        .filter(\n    25→          (b) =>\n    26→            (b.status === 'pending' || b.status === 'confirmed') &&\n    27→            b.check_in.split('T')[0]! >= today!\n    28→        )\n    29→        .sort((a, b) => a.check_in.localeCompare(b.check_in))\n    30→    case 'past':\n    31→      return bookings\n    32→        .filter((b) => b.status === 'completed')\n    33→        .sort((a, b) => a.check_in.localeCompare(b.check_in))\n    34→    case 'cancelled':\n    35→      return bookings\n    36→        .filter((b) => b.status === 'cancelled')\n    37→        .sort((a, b) => a.check_in.localeCompare(b.check_in))\n    38→  }\n    39→}\n    40→\n    41→export default function TripsTabs({ bookings, onCancelBooking }: TripsTabsProps) {\n    42→  const [activeTab, setActiveTab] = useState<TabKey>('upcoming')\n    43→  const filtered = filterBookings(bookings, activeTab)\n    44→  const tabRefs = useRef<(HTMLButtonElement | null)[]>([])\n    45→\n    46→  const handleTabKeyDown = (e: React.KeyboardEvent, index: number) => {\n    47→    let nextIndex: number | null = null\n    48→    if (e.key === 'ArrowRight') {\n    49→      nextIndex = (index + 1) % tabs.length\n    50→    } else if (e.key === 'ArrowLeft') {\n    51→      nextIndex = (index - 1 + tabs.length) % tabs.length\n    52→    } else if (e.key === 'Home') {\n    53→      nextIndex = 0\n    54→    } else if (e.key === 'End') {\n    55→      nextIndex = tabs.length - 1\n    56→    }\n    57→    if (nextIndex !== null) {\n    58→      e.preventDefault()\n    59→      setActiveTab(tabs[nextIndex]!.key)\n    60→      tabRefs.current[nextIndex]?.focus()\n    61→    }\n    62→  }\n    63→\n    64→  return (\n    65→    <div data-testid=\"trips-tabs\">\n    66→      <div className=\"flex gap-1 border-b border-border mb-6\" role=\"tablist\" aria-label=\"Trip categories\">\n    67→        {tabs.map((tab, index) => (\n    68→          <button\n    69→            key={tab.key}\n    70→            ref={(el) => { tabRefs.current[index] = el }}\n    71→            data-testid={`tab-${tab.key}`}\n    72→            role=\"tab\"\n    73→            aria-selected={activeTab === tab.key}\n    74→            aria-controls={`tabpanel-${tab.key}`}\n    75→            id={`tab-${tab.key}`}\n    76→            tabIndex={activeTab === tab.key ? 0 : -1}\n    77→            onClick={() => setActiveTab(tab.key)}\n    78→            onKeyDown={(e) => handleTabKeyDown(e, index)}\n    79→            className={`px-4 max-sm:px-3 py-3 max-sm:py-2 text-sm font-medium border-b-2 transition-colors ${\n    80→              activeTab === tab.key\n    81→                ? 'border-text text-text'\n    82→                : 'border-transparent text-text-secondary hover:text-text hover:border-border-dark'\n    83→            }`}\n    84→          >\n    85→            {tab.label}\n    86→          </button>\n    87→        ))}\n    88→      </div>\n    89→\n    90→      <div\n    91→        data-testid=\"trips-list\"\n    92→        role=\"tabpanel\"\n    93→        id={`tabpanel-${activeTab}`}\n    94→        aria-labelledby={`tab-${activeTab}`}\n    95→      >\n    96→        {filtered.length === 0 ? (\n    97→          <div data-testid=\"trips-empty-state\" className=\"text-center py-12\">\n    98→            <p className=\"text-text-secondary text-lg\">\n    99→              {activeTab === 'upcoming' && 'No upcoming trips'}\n   100→              {activeTab === 'past' && 'No past trips'}\n   101→              {activeTab === 'cancelled' && 'No cancelled trips.'}\n   102→            </p>\n   103→            {activeTab === 'upcoming' && (\n   104→              <Link\n   105→                to=\"/\"\n   106→                className=\"inline-block mt-3 text-primary hover:text-primary-dark font-medium\"\n   107→              >\n   108→                Browse properties\n   109→              </Link>\n   110→            )}\n   111→          </div>\n   112→        ) : (\n   113→          <ul className=\"grid gap-4\" role=\"list\">\n   114→            {filtered.map((booking) => (\n   115→              <li key={booking.id}>\n   116→                <TripCard\n   117→                  booking={booking}\n   118→                  onCancel={() => onCancelBooking(booking)}\n   119→                />\n   120→              </li>\n   121→            ))}\n   122→          </ul>\n   123→        )}\n   124→      </div>\n   125→    </div>\n   126→  )\n   127→}\n   128→"}]},"parent_tool_use_id":null,"session_id":"4877f3d7-4b15-4027-8594-e225d536fda7","uuid":"50c0b5bf-4cbe-4d63-8ff0-add1f34ffa7b","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/components/TripsTabs.tsx","content":"import { useState, useRef } from 'react'\nimport type { Booking } from '../slices/bookingsSlice'\nimport TripCard from './TripCard'\nimport { Link } from 'react-router-dom'\n\ntype TabKey = 'upcoming' | 'past' | 'cancelled'\n\ninterface TripsTabsProps {\n  bookings: Booking[]\n  onCancelBooking: (booking: Booking) => void\n}\n\nconst tabs: { key: TabKey; label: string }[] = [\n  { key: 'upcoming', label: 'Upcoming' },\n  { key: 'past', label: 'Past' },\n  { key: 'cancelled', label: 'Cancelled' },\n]\n\nfunction filterBookings(bookings: Booking[], tab: TabKey): Booking[] {\n  const today = new Date().toISOString().split('T')[0]\n  switch (tab) {\n    case 'upcoming':\n      return bookings\n        .filter(\n          (b) =>\n            (b.status === 'pending' || b.status === 'confirmed') &&\n            b.check_in.split('T')[0]! >= today!\n        )\n        .sort((a, b) => a.check_in.localeCompare(b.check_in))\n    case 'past':\n      return bookings\n        .filter((b) => b.status === 'completed')\n        .sort((a, b) => a.check_in.localeCompare(b.check_in))\n    case 'cancelled':\n      return bookings\n        .filter((b) => b.status === 'cancelled')\n        .sort((a, b) => a.check_in.localeCompare(b.check_in))\n  }\n}\n\nexport default function TripsTabs({ bookings, onCancelBooking }: TripsTabsProps) {\n  const [activeTab, setActiveTab] = useState<TabKey>('upcoming')\n  const filtered = filterBookings(bookings, activeTab)\n  const tabRefs = useRef<(HTMLButtonElement | null)[]>([])\n\n  const handleTabKeyDown = (e: React.KeyboardEvent, index: number) => {\n    let nextIndex: number | null = null\n    if (e.key === 'ArrowRight') {\n      nextIndex = (index + 1) % tabs.length\n    } else if (e.key === 'ArrowLeft') {\n      nextIndex = (index - 1 + tabs.length) % tabs.length\n    } else if (e.key === 'Home') {\n      nextIndex = 0\n    } else if (e.key === 'End') {\n      nextIndex = tabs.length - 1\n    }\n    if (nextIndex !== null) {\n      e.preventDefault()\n      setActiveTab(tabs[nextIndex]!.key)\n      tabRefs.current[nextIndex]?.focus()\n    }\n  }\n\n  return (\n    <div data-testid=\"trips-tabs\">\n      <div className=\"flex gap-1 border-b border-border mb-6\" role=\"tablist\" aria-label=\"Trip categories\">\n        {tabs.map((tab, index) => (\n          <button\n            key={tab.key}\n            ref={(el) => { tabRefs.current[index] = el }}\n            data-testid={`tab-${tab.key}`}\n            role=\"tab\"\n            aria-selected={activeTab === tab.key}\n            aria-controls={`tabpanel-${tab.key}`}\n            id={`tab-${tab.key}`}\n            tabIndex={activeTab === tab.key ? 0 : -1}\n            onClick={() => setActiveTab(tab.key)}\n            onKeyDown={(e) => handleTabKeyDown(e, index)}\n            className={`px-4 max-sm:px-3 py-3 max-sm:py-2 text-sm font-medium border-b-2 transition-colors ${\n              activeTab === tab.key\n                ? 'border-text text-text'\n                : 'border-transparent text-text-secondary hover:text-text hover:border-border-dark'\n            }`}\n          >\n            {tab.label}\n          </button>\n        ))}\n      </div>\n\n      <div\n        data-testid=\"trips-list\"\n        role=\"tabpanel\"\n        id={`tabpanel-${activeTab}`}\n        aria-labelledby={`tab-${activeTab}`}\n      >\n        {filtered.length === 0 ? (\n          <div data-testid=\"trips-empty-state\" className=\"text-center py-12\">\n            <p className=\"text-text-secondary text-lg\">\n              {activeTab === 'upcoming' && 'No upcoming trips'}\n              {activeTab === 'past' && 'No past trips'}\n              {activeTab === 'cancelled' && 'No cancelled trips.'}\n            </p>\n            {activeTab === 'upcoming' && (\n              <Link\n                to=\"/\"\n                className=\"inline-block mt-3 text-primary hover:text-primary-dark font-medium\"\n              >\n                Browse properties\n              </Link>\n            )}\n          </div>\n        ) : (\n          <ul className=\"grid gap-4\" role=\"list\">\n            {filtered.map((booking) => (\n              <li key={booking.id}>\n                <TripCard\n                  booking={booking}\n                  onCancel={() => onCancelBooking(booking)}\n                />\n              </li>\n            ))}\n          </ul>\n        )}\n      </div>\n    </div>\n  )\n}\n","numLines":128,"startLine":1,"totalLines":128}}}
