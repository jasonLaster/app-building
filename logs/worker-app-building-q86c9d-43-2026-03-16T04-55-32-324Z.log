   })\n    47→    if (!response.ok) {\n    48→      const data = await response.json()\n    49→      return rejectWithValue(data.error || 'Failed to remove favorite')\n    50→    }\n    51→    return propertyId\n    52→  }\n    53→)\n    54→\n    55→const favoritesSlice = createSlice({\n    56→  name: 'favorites',\n    57→  initialState,\n    58→  reducers: {},\n    59→  extraReducers: (builder) => {\n    60→    builder\n    61→      .addCase(fetchFavorites.pending, (state) => {\n    62→        state.loading = true\n    63→      })\n    64→      .addCase(fetchFavorites.fulfilled, (state, action) => {\n    65→        state.loading = false\n    66→        state.propertyIds = action.payload\n    67→      })\n    68→      .addCase(fetchFavorites.rejected, (state) => {\n    69→        state.loading = false\n    70→      })\n    71→      .addCase(addFavorite.fulfilled, (state, action) => {\n    72→        if (!state.propertyIds.includes(action.payload)) {\n    73→          state.propertyIds.push(action.payload)\n    74→        }\n    75→      })\n    76→      .addCase(removeFavorite.fulfilled, (state, action) => {\n    77→        state.propertyIds = state.propertyIds.filter((id) => id !== action.payload)\n    78→      })\n    79→  },\n    80→})\n    81→\n    82→export default favoritesSlice.reducer\n    83→"}]},"parent_tool_use_id":"toolu_01KWBX78un6MDLFmyi97k13g","session_id":"4877f3d7-4b15-4027-8594-e225d536fda7","uuid":"7dde950f-d206-4b5a-b693-e1b01fee8bab"}
