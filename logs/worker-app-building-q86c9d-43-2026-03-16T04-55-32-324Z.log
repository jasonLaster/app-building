  45→        <MessageSquare size={20} aria-hidden=\"true\" />\n    46→        My Reviews\n    47→      </h2>\n    48→\n    49→      {reviews.length === 0 ? (\n    50→        <div data-testid=\"reviews-empty-state\" className=\"text-center py-8 text-text-secondary border border-border rounded-xl\">\n    51→          You haven't written any reviews yet\n    52→        </div>\n    53→      ) : (\n    54→        <ul className=\"space-y-3 list-none p-0 m-0\">\n    55→          {reviews.map((review) => (\n    56→            <li\n    57→              key={review.id}\n    58→              data-testid={`review-card-${review.id}`}\n    59→              className=\"rounded-xl border border-border p-4 max-sm:p-3 hover:shadow-md transition-shadow\"\n    60→            >\n    61→              <div className=\"flex items-start justify-between gap-2 mb-2 max-sm:flex-col\">\n    62→                <button\n    63→                  data-testid={`review-property-link-${review.id}`}\n    64→                  onClick={() => navigate(`/properties/${review.property_id}`)}\n    65→                  className=\"text-primary font-semibold hover:underline text-left\"\n    66→                >\n    67→                  {review.property_title}\n    68→                </button>\n    69→                <span className=\"text-xs text-text-secondary whitespace-nowrap\">\n    70→                  {formatDate(review.created_at)}\n    71→                </span>\n    72→              </div>\n    73→\n    74→              <StarRating rating={review.rating} />\n    75→\n    76→              {review.comment && (\n    77→                <p className=\"text-sm text-text mt-2\">{review.comment}</p>\n    78→              )}\n    79→            </li>\n    80→          ))}\n    81→        </ul>\n    82→      )}\n    83→    </section>\n    84→  )\n    85→}\n    86→"}]},"parent_tool_use_id":"toolu_01KWBX78un6MDLFmyi97k13g","session_id":"4877f3d7-4b15-4027-8594-e225d536fda7","uuid":"61412839-b89d-4837-82e8-8ce5158