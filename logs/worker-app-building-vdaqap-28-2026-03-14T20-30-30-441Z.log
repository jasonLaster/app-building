\n   292→      { origin: 'SFO', dest: 'ORD', dep: '2026-04-01 14:30', arr: '2026-04-01 20:00', dur: 240, terminal_dep: 'T2', terminal_arr: 'T1' },\n   293→      { origin: 'ORD', dest: 'JFK', dep: '2026-04-01 21:30', arr: '2026-04-02 00:00', dur: 150, terminal_dep: 'T2', terminal_arr: 'T5' }\n   294→    ])\n   295→\n   296→  // LAX-LHR\n   297→  await createFlight('BA', 'BA500', 'LAX', 'LHR', '2026-04-01 20:00', '2026-04-02 14:30', 630, 'Boeing 777-300ER', true, true, true, 380, 649)\n   298→  await createFlight('AA', 'AA800', 'LAX', 'LHR', '2026-04-01 18:00', '2026-04-02 12:30', 630, 'Boeing 787-9', true, true, true, 370, 599)\n   299→\n   300→  // Create a session for seed data\n   301→  await sql`INSERT INTO sessions (session_token) VALUES ('seed-session-token')`\n   302→  const sessionRows = await sql`SELECT id FROM sessions WHERE session_token = 'seed-session-token'`\n   303→  const sessionRow = sessionRows[0]\n   304→  if (!sessionRow) return\n   305→  const sessionId = sessionRow.id as string\n   306→\n   307→  // Recent searches\n   308→  const laxId = airportMap.get('LAX')!\n   309→  const jfkId = airportMap.get('JFK')!\n   310→  const sfoId = airportMap.get('SFO')!\n   311→  const ordId = airportMap.get('ORD')!\n   312→  const lhrId = airportMap.get('LHR')!\n   313→\n   314→  await sql`INSERT INTO recent_searches (session_id, origin_airport_id, destination_airport_id, departure_date, return_date, passengers_adults, cabin_class, trip_type)\n   315→    VALUES (${sessionId}, ${laxId}, ${jfkId}, '2026-04-01', '2026-04-08', 1, 'economy', 'round_trip')`\n   316→  await sql`INSERT INTO recent_searches (session_id, origin_airport_id, destination_airport_id, departure_date, return_date, passengers_adults, cabin_class, trip_type)\n   317→    VALUES (${sessionId}, ${sfoId}, ${ordId}, '2026-04-05', '2026-04-10', 2, 'business', 'round_trip')`\n   318→\n   319→  // Sample bookings\n   320→  const flightForBooking = await sql`SELECT id FROM flights WHERE flight_number = 'AA100' LIMIT 1`\n   321→  const bookingFlight = flightForBooking[0]\n   322→  if (bookingFlight) {\n   323→    await sql`INSERT INTO bookings (session_id, flight_id, booking_reference, cabin_class, total_price_cents, status)\n   324→      VALUES (${sessionId}, ${bookingFlight.id}, 'GF-ABC123', 'economy', 34385, 'confirmed')`\n   325→    const bookingRows = await sql`SELECT id FROM bookings WHERE booking_reference = 'GF-ABC123'`\n   326→    const booking = bookingRows[0]\n   327→    if (booking) {\n   328→      await sql`INSERT INTO booking_passengers (booking_id, first_name, last_name, date_of_birth, gender, email, phone, passenger_type)\n   329→        VALUES (${booking.id}, 'John', 'Doe', '1990-05-15', 'male', 'john@example.com', '+1234567890', 'adult')`\n   330→    }\n   331→  }\n   332→\n   333→  // Tracked routes\n   334→  await sql`INSERT INTO tracked_routes (session_id, origin_airport_id, destination_airport_id, departure_date_start, departure_date_end, cabin_class)\n   335→    VALUES (${sessionId}, ${laxId}, ${lhrId}, '2026-04-15', '2026-04-30', 'economy')`\n   336→}\n   337→\n   338→// CLI entry point\n   339→const isMain = process.argv[1] && import.meta.url.endsWith(process.argv[1].replace(/\\\\/g, '/'))\n   340→if (isMain) {\n   341→  const dbUrl = process.argv[2]\n   342→  if (!dbUrl) {\n   343→    console.error('Usage: tsx scripts/seed-db.ts <DATABASE_URL>')\n   344→    process.exit(1)\n   345→  }\n   346→  truncateAndSeed(dbUrl).then(() => console.log('Seed complete')).catch(e => { console.error(e); process.exit(1) })\n   347→}\n   348→"}]},"parent_tool_use_id":"toolu_01JkX3wc1PCW2kgBXSxRdnJB","session_id":"05923c41-2ea4-40be-b7d6-bb4c984a6ea5","uuid":"1ddad2a5-06f9-4b37-a305-b2f0af86d2a8"}
