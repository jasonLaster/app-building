[2026-03-15T21:19:54.336Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GQ34543uPqLq1uJbmJAZCw","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test'\n     2→\n     3→// b2222222: Villa, Miami, 18 amenities across all 4 categories (Essentials, Features, Safety, Location)\n     4→const PROPERTY_MANY_AMENITIES = 'b2222222-2222-2222-2222-222222222222'\n     5→// b4444444: Apartment, Austin, 6 amenities in Essentials + Features + Safety (no Location category)\n     6→const PROPERTY_FEW_AMENITIES = 'b4444444-4444-4444-4444-444444444444'\n     7→\n     8→test.describe('Property Detail - AmenitiesList', () => {\n     9→  test('Amenities list displays amenities grouped by category with icons', async ({ page }) => {\n    10→    await page.goto(`/properties/${PROPERTY_MANY_AMENITIES}`)\n    11→\n    12→    const amenitiesList = page.getByTestId('amenities-list')\n    13→    await expect(amenitiesList).toBeVisible({ timeout: 30000 })\n    14→\n    15→    // Should display category headings - Villa has amenities in all 4 categories\n    16→    await expect(amenitiesList).toContainText('Essentials')\n    17→    await expect(amenitiesList).toContainText('Features')\n    18→    await expect(amenitiesList).toContainText('Safety')\n    19→    await expect(amenitiesList).toContainText('Location')\n    20→\n    21→    // Each amenity should be displayed with name and icon (within initial 10)\n    22→    // Check a few specific amenities that should be visible initially\n    23→    await expect(amenitiesList).toContainText('WiFi')\n    24→    await expect(amenitiesList).toContainText('Kitchen')\n    25→    await expect(amenitiesList).toContainText('Pool')\n    26→\n    27→    // Each amenity item should have an icon (svg element) and name\n    28→    const firstAmenity = amenitiesList.locator('[data-testid^=\"amenity-\"]').first()\n    29→    await expect(firstAmenity).toBeVisible()\n    30→    await expect(firstAmenity.locator('svg')).toBeVisible()\n    31→  })\n    32→\n    33→  test('Amenities list only shows categories that have amenities', async ({ page }) => {\n    34→    // b4444444 has amenities in Essentials (WiFi, Kitchen, Air conditioning),\n    35→    // Features (Gym, Pool), and Safety (Smoke alarm) — no Location category\n    36→    await page.goto(`/properties/${PROPERTY_FEW_AMENITIES}`)\n    37→\n    38→    const amenitiesList = page.getByTestId('amenities-list')\n    39→    await expect(amenitiesList).toBeVisible({ timeout: 30000 })\n    40→\n    41→    // Should show categories that have amenities\n    42→    await expect(amenitiesList).toContainText('Essentials')\n    43→    await expect(amenitiesList).toContainText('Features')\n    44→    await expect(amenitiesList).toContainText('Safety')\n    45→\n    46→    // Should NOT show Location category (no location amenities for this property)\n    47→    await expect(amenitiesList.locator('h3').filter({ hasText: /^Location$/ })).toHaveCount(0)\n    48→  })\n    49→\n    50→  test('Amenities list shows \"Show all amenities\" when there are many amenities', async ({ page }) => {\n    51→    // b2222222 has 18 amenities (> 10 threshold)\n    52→    await page.goto(`/properties/${PROPERTY_MANY_AMENITIES}`)\n    53→\n    54→    const amenitiesList = page.getByTestId('amenities-list')\n    55→    await expect(amenitiesList).toBeVisible({ timeout: 30000 })\n    56→\n    57→    // Should show \"Show all 18 amenities\" button\n    58→    const toggle = page.getByTestId('amenities-toggle')\n    59→    await expect(toggle).toBeVisible()\n    60→    await expect(toggle).toHaveText('Show all 18 amenities')\n    61→\n    62→    // Only initial 10 amenities should be displayed\n    63→    const visibleAmenities = amenitiesList.locator('[data-testid^=\"amenity-\"]')\n    64→    await expect(visibleAmenities).toHaveCount(10)\n    65→  })\n    66→\n    67→  test('Clicking \"Show all amenities\" reveals the complete list', async ({ page }) => {\n    68→    await page.goto(`/properties/${PROPERTY_MANY_AMENITIES}`)\n    69→\n    70→    const amenitiesList = page.getByTestId('amenities-list')\n    71→    await expect(amenitiesList).toBeVisible({ timeout: 30000 })\n    72→\n    73→    const toggle = page.getByTestId('amenities-toggle')\n    74→    await expect(toggle).toHaveText('Show all 18 amenities')\n    75→\n    76→    // Click to show all\n    77→    await toggle.click()\n    78→\n    79→    // All 18 amenities should now be visible\n    80→    const allAmenities = amenitiesList.locator('[data-testid^=\"amenity-\"]')\n    81→    await expect(allAmenities).toHaveCount(18)\n    82→\n    83→    // Button should now say \"Show less\"\n    84→    await expect(toggle).toHaveText('Show less')\n    85→\n    86→    // All 4 categories should be visible\n    87→    await expect(amenitiesList).toContainText('Essentials')\n    88→    await expect(amenitiesList).toContainText('Features')\n    89→    await expect(amenitiesList).toContainText('Safety')\n    90→    await expect(amenitiesList).toContainText('Location')\n    91→  })\n    92→\n    93→  test('Amenities list displays message when property has no amenities', async ({ page }) => {\n    94→    // Create a property with no amenities via API\n    95→    const createResponse = await page.request.post('/api/properties', {\n    96→      data: {\n    97→        host_id: 'a1111111-1111-1111-1111-111111111111',\n    98→        title: `No Amenities Property ${Date.now()}`,\n    99→        description: 'A property with no amenities for testing',\n   100→        property_type: 'Apartment',\n   101→        price_per_night: 100,\n   102→        cleaning_fee: 25,\n   103→        max_guests: 2,\n   104→        bedrooms: 1,\n   105→        beds: 1,\n   106→        bathrooms: 1,\n   107→        address: '1 Test St',\n   108→        city: 'Testville',\n   109→        state: 'TS',\n   110→        country: 'United States',\n   111→      },\n   112→    })\n   113→    const property = await createResponse.json()\n   114→\n   115→    await page.goto(`/properties/${property.id}`)\n   116→\n   117→    const amenitiesList = page.getByTestId('amenities-list')\n   118→    await expect(amenitiesList).toBeVisible({ timeout: 30000 })\n   119→\n   120→    // Should display \"No amenities listed\" message\n   121→    await expect(amenitiesList).toContainText('No amenities listed')\n   122→\n   123→    // Should not have any amenity items\n   124→    await expect(amenitiesList.locator('[data-testid^=\"amenity-\"]')).toHaveCount(0)\n   125→  })\n   126→})\n   127→"}]},"parent_tool_use_id":null,"session_id":"a844be5f-3072-408c-8afd-f6a5163e3be9","uuid":"0cfb9069-ff1e-4a1a-8a83-50ca79564770","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/tests/amenities-list.spec.ts","content":"import { test, expect } from '@playwright/test'\n\n// b2222222: Villa, Miami, 18 amenities across all 4 categories (Essentials, Features, Safety, Location)\nconst PROPERTY_MANY_AMENITIES = 'b2222222-2222-2222-2222-222222222222'\n// b4444444: Apartment, Austin, 6 amenities in Essentials + Features + Safety (no Location category)\nconst PROPERTY_FEW_AMENITIES = 'b4444444-4444-4444-4444-444444444444'\n\ntest.describe('Property Detail - AmenitiesList', () => {\n  test('Amenities list displays amenities grouped by category with icons', async ({ page }) => {\n    await page.goto(`/properties/${PROPERTY_MANY_AMENITIES}`)\n\n    const amenitiesList = page.getByTestId('amenities-list')\n    await expect(amenitiesList).toBeVisible({ timeout: 30000 })\n\n    // Should display category headings - Villa has amenities in all 4 categories\n    await expect(amenitiesList).toContainText('Essentials')\n    await expect(amenitiesList).toContainText('Features')\n    await expect(amenitiesList).toContainText('Safety')\n    await expect(amenitiesList).toContainText('Location')\n\n    // Each amenity should be displayed with name and icon (within initial 10)\n    // Check a few specific amenities that should be visible initially\n    await expect(amenitiesList).toContainText('WiFi')\n    await expect(amenitiesList).toContainText('Kitchen')\n    await expect(amenitiesList).toContainText('Pool')\n\n    // Each amenity item should have an icon (svg element) and name\n    const firstAmenity = amenitiesList.locator('[data-testid^=\"amenity-\"]').first()\n    await expect(firstAmenity).toBeVisible()\n    await expect(firstAmenity.locator('svg')).toBeVisible()\n  })\n\n  test('Amenities list only shows categories that have amenities', async ({ page }) => {\n    // b4444444 has amenities in Essentials (WiFi, Kitchen, Air conditioning),\n    // Features (Gym, Pool), and Safety (Smoke alarm) — no Location category\n    await page.goto(`/properties/${PROPERTY_FEW_AMENITIES}`)\n\n    const amenitiesList = page.getByTestId('amenities-list')\n    await expect(amenitiesList).toBeVisible({ timeout: 30000 })\n\n    // Should show categories that have amenities\n    await expect(amenitiesList).toContainText('Essentials')\n    await expect(amenitiesList).toContainText('Features')\n    await expect(amenitiesList).toContainText('Safety')\n\n    // Should NOT show Location category (no location amenities for this property)\n    await expect(amenitiesList.locator('h3').filter({ hasText: /^Location$/ })).toHaveCount(0)\n  })\n\n  test('Amenities list shows \"Show all amenities\" when there are many amenities', async ({ page }) => {\n    // b2222222 has 18 amenities (> 10 threshold)\n    await page.goto(`/properties/${PROPERTY_MANY_AMENITIES}`)\n\n    const amenitiesList = page.getByTestId('amenities-list')\n    await expect(amenitiesList).toBeVisible({ timeout: 30000 })\n\n    // Should show \"Show all 18 amenities\" button\n    const toggle = page.getByTestId('amenities-toggle')\n    await expect(toggle).toBeVisible()\n    await expect(toggle).toHaveText('Show all 18 amenities')\n\n    // Only initial 10 amenities should be displayed\n    const visibleAmenities = amenitiesList.locator('[data-testid^=\"amenity-\"]')\n    await expect(visibleAmenities).toHaveCount(10)\n  })\n\n  test('Clicking \"Show all amenities\" reveals the complete list', async ({ page }) => {\n    await page.goto(`/properties/${PROPERTY_MANY_AMENITIES}`)\n\n    const amenitiesList = page.getByTestId('amenities-list')\n    await expect(amenitiesList).toBeVisible({ timeout: 30000 })\n\n    const toggle = page.getByTestId('amenities-toggle')\n    await expect(toggle).toHaveText('Show all 18 amenities')\n\n    // Click to show all\n    await toggle.click()\n\n    // All 18 amenities should now be visible\n    const allAmenities = amenitiesList.locator('[data-testid^=\"amenity-\"]')\n    await expect(allAmenities).toHaveCount(18)\n\n    // Button should now say \"Show less\"\n    await expect(toggle).toHaveText('Show less')\n\n    // All 4 categories should be visible\n    await expect(amenitiesList).toContainText('Essentials')\n    await expect(amenitiesList).toContainText('Features')\n    await expect(amenitiesList).toContainText('Safety')\n    await expect(amenitiesList).toContainText('Location')\n  })\n\n  test('Amenities list displays message when property has no amenities', async ({ page }) => {\n    // Create a property with no amenities via API\n    const createResponse = await page.request.post('/api/properties', {\n      data: {\n        host_id: 'a1111111-1111-1111-1111-111111111111',\n        title: `No Amenities Property ${Date.now()}`,\n        description: 'A property with no amenities for testing',\n        property_type: 'Apartment',\n        price_per_night: 100,\n        cleaning_fee: 25,\n        max_guests: 2,\n        bedrooms: 1,\n        beds: 1,\n        bathrooms: 1,\n        address: '1 Test St',\n        city: 'Testville',\n        state: 'TS',\n        country: 'United States',\n      },\n    })\n    const property = await createResponse.json()\n\n    await page.goto(`/properties/${property.id}`)\n\n    const amenitiesList = page.getByTestId('amenities-list')\n    await expect(amenitiesList).toBeVisible({ timeout: 30000 })\n\n    // Should display \"No amenities listed\" message\n    await expect(amenitiesList).toContainText('No amenities listed')\n\n    // Should not have any amenity items\n    await expect(amenitiesList.locator('[data-testid^=\"amenity-\"]')).toHaveCount(0)\n  })\n})\n","numLines":127,"startLine":1,"totalLines":127}}}
