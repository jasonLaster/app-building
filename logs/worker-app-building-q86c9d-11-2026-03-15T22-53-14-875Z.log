[2026-03-15T21:19:54.310Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Qdr1qnRL4ybmC52PHj8gLA","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test'\n     2→\n     3→// b1111111: Loft, $150/night, $75 cleaning, 4 max guests, host: Sarah (a1111111)\n     4→const PROPERTY_LOFT = 'b1111111-1111-1111-1111-111111111111'\n     5→// b3333333: Cabin, $200/night, $50 cleaning, 6 max guests, host: Mike (a2222222)\n     6→const PROPERTY_CABIN = 'b3333333-3333-3333-3333-333333333333'\n     7→// Guest user: Emma Wilson (a3333333)\n     8→const GUEST_EMAIL = 'emma@example.com'\n     9→// Host user: Sarah Chen (a1111111) — owns b1111111\n    10→const HOST_EMAIL = 'sarah@example.com'\n    11→\n    12→async function loginAs(page: import('@playwright/test').Page, email: string) {\n    13→  await page.goto('/login')\n    14→  await page.getByTestId('login-email-input').fill(email)\n    15→  await page.getByTestId('login-submit-button').click()\n    16→  await expect(page).toHaveURL('/', { timeout: 30000 })\n    17→}\n    18→\n    19→async function deleteAllBookings(page: import('@playwright/test').Page, guestId: string) {\n    20→  const res = await page.request.get(`/api/bookings?guest_id=${guestId}`)\n    21→  const bookings = await res.json()\n    22→  for (const booking of bookings) {\n    23→    await page.request.put(`/api/bookings/${booking.id}`, {\n    24→      data: { status: 'cancelled' },\n    25→    })\n    26→  }\n    27→}\n    28→\n    29→test.describe('Property Detail - BookingCard', () => {\n    30→  test('Booking card displays price per night', async ({ page }) => {\n    31→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n    32→\n    33→    const card = page.getByTestId('booking-card')\n    34→    await expect(card).toBeVisible({ timeout: 30000 })\n    35→\n    36→    // $150 / night\n    37→    await expect(card).toContainText('$150')\n    38→    await expect(card).toContainText('/ night')\n    39→  })\n    40→\n    41→  test('Booking card displays check-in and check-out date pickers', async ({ page }) => {\n    42→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n    43→\n    44→    const card = page.getByTestId('booking-card')\n    45→    await expect(card).toBeVisible({ timeout: 30000 })\n    46→\n    47→    const checkin = page.getByTestId('booking-checkin')\n    48→    const checkout = page.getByTestId('booking-checkout')\n    49→\n    50→    await expect(checkin).toBeVisible()\n    51→    await expect(checkout).toBeVisible()\n    52→\n    53→    // Both should be date inputs and initially empty\n    54→    await expect(checkin).toHaveAttribute('type', 'date')\n    55→    await expect(checkout).toHaveAttribute('type', 'date')\n    56→    await expect(checkin).toHaveValue('')\n    57→    await expect(checkout).toHaveValue('')\n    58→  })\n    59→\n    60→  test('Booking card displays guest count selector', async ({ page }) => {\n    61→    // b3333333: max_guests = 6\n    62→    await page.goto(`/properties/${PROPERTY_CABIN}`)\n    63→\n    64→    const card = page.getByTestId('booking-card')\n    65→    await expect(card).toBeVisible({ timeout: 30000 })\n    66→\n    67→    const guestsSelect = page.getByTestId('booking-guests')\n    68→    await expect(guestsSelect).toBeVisible()\n    69→\n    70→    // Should have options from 1 to 6\n    71→    const options = guestsSelect.locator('option')\n    72→    await expect(options).toHaveCount(6)\n    73→\n    74→    // First option should be \"1 guest\"\n    75→    await expect(options.first()).toHaveText('1 guest')\n    76→    // Last option should be \"6 guests\"\n    77→    await expect(options.last()).toHaveText('6 guests')\n    78→  })\n    79→\n    80→  test('Selecting dates and guests shows price breakdown', async ({ page }) => {\n    81→    // b1111111: $150/night, $75 cleaning fee\n    82→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n    83→\n    84→    const card = page.getByTestId('booking-card')\n    85→    await expect(card).toBeVisible({ timeout: 30000 })\n    86→\n    87→    // Select check-in and check-out (3 nights)\n    88→    await page.getByTestId('booking-checkin').fill('2026-05-01')\n    89→    await page.getByTestId('booking-checkout').fill('2026-05-04')\n    90→    await page.getByTestId('booking-guests').selectOption('2')\n    91→\n    92→    // Price breakdown should appear\n    93→    const breakdown = page.getByTestId('price-breakdown')\n    94→    await expect(breakdown).toBeVisible()\n    95→\n    96→    // $150 x 3 nights = $450\n    97→    await expect(breakdown).toContainText('$150 x 3 nights')\n    98→    await expect(breakdown).toContainText('$450')\n    99→\n   100→    // Cleaning fee: $75\n   101→    await expect(breakdown).toContainText('Cleaning fee')\n   102→    await expect(breakdown).toContainText('$75')\n   103→\n   104→    // Total: $525\n   105→    await expect(breakdown).toContainText('Total')\n   106→    await expect(breakdown).toContainText('$525')\n   107→  })\n   108→\n   109→  test('Price breakdown updates when dates change', async ({ page }) => {\n   110→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   111→\n   112→    const card = page.getByTestId('booking-card')\n   113→    await expect(card).toBeVisible({ timeout: 30000 })\n   114→\n   115→    // Initial: 3 nights\n   116→    await page.getByTestId('booking-checkin').fill('2026-05-01')\n   117→    await page.getByTestId('booking-checkout').fill('2026-05-04')\n   118→\n   119→    const breakdown = page.getByTestId('price-breakdown')\n   120→    await expect(breakdown).toContainText('$150 x 3 nights')\n   121→    await expect(breakdown).toContainText('$525')\n   122→\n   123→    // Change to 5 nights\n   124→    await page.getByTestId('booking-checkout').fill('2026-05-06')\n   125→\n   126→    // $150 x 5 nights = $750, Total: $825\n   127→    await expect(breakdown).toContainText('$150 x 5 nights')\n   128→    await expect(breakdown).toContainText('$750')\n   129→    await expect(breakdown).toContainText('$825')\n   130→  })\n   131→\n   132→  test('Reserve button creates a booking when logged in', async ({ page }) => {\n   133→    test.slow()\n   134→    await loginAs(page, GUEST_EMAIL)\n   135→\n   136→    // Clean up any existing bookings for this guest\n   137→    await deleteAllBookings(page, 'a3333333-3333-3333-3333-333333333333')\n   138→\n   139→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   140→\n   141→    const card = page.getByTestId('booking-card')\n   142→    await expect(card).toBeVisible({ timeout: 30000 })\n   143→\n   144→    // Select dates and guests\n   145→    await page.getByTestId('booking-checkin').fill('2026-07-01')\n   146→    await page.getByTestId('booking-checkout').fill('2026-07-04')\n   147→    await page.getByTestId('booking-guests').selectOption('2')\n   148→\n   149→    // Click Reserve\n   150→    const reserveBtn = page.getByTestId('reserve-button')\n   151→    await expect(reserveBtn).toBeEnabled()\n   152→    await reserveBtn.click()\n   153→\n   154→    // Success message should appear\n   155→    await expect(page.getByTestId('booking-success')).toContainText('Booking confirmed', { timeout: 30000 })\n   156→\n   157→    // Should redirect to /trips\n   158→    await expect(page).toHaveURL('/trips', { timeout: 30000 })\n   159→  })\n   160→\n   161→  test('Reserve button is disabled when dates are not selected', async ({ page }) => {\n   162→    test.slow()\n   163→    await loginAs(page, GUEST_EMAIL)\n   164→\n   165→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   166→\n   167→    const card = page.getByTestId('booking-card')\n   168→    await expect(card).toBeVisible({ timeout: 30000 })\n   169→\n   170→    // No dates selected - reserve button should be disabled\n   171→    const reserveBtn = page.getByTestId('reserve-button')\n   172→    await expect(reserveBtn).toBeVisible()\n   173→    await expect(reserveBtn).toBeDisabled()\n   174→\n   175→    // Should show hint text\n   176→    await expect(card).toContainText('Select dates to book')\n   177→  })\n   178→\n   179→  test('Reserve button prompts login when user is not logged in', async ({ page }) => {\n   180→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   181→\n   182→    const card = page.getByTestId('booking-card')\n   183→    await expect(card).toBeVisible({ timeout: 30000 })\n   184→\n   185→    // Not logged in - should show login prompt button\n   186→    const loginPrompt = page.getByTestId('booking-login-prompt')\n   187→    await expect(loginPrompt).toBeVisible()\n   188→    await expect(loginPrompt).toContainText('Log in to reserve')\n   189→\n   190→    // Click login prompt\n   191→    await loginPrompt.click()\n   192→\n   193→    // Should navigate to login page\n   194→    await expect(page).toHaveURL('/login', { timeout: 30000 })\n   195→  })\n   196→\n   197→  test(\"Reserve button is disabled for host's own property\", async ({ page }) => {\n   198→    test.slow()\n   199→    // Login as Sarah (host of b1111111)\n   200→    await loginAs(page, HOST_EMAIL)\n   201→\n   202→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   203→\n   204→    const card = page.getByTestId('booking-card')\n   205→    await expect(card).toBeVisible({ timeout: 30000 })\n   206→\n   207→    // Should show \"You cannot book your own property\" message\n   208→    const ownMessage = page.getByTestId('own-property-message')\n   209→    await expect(ownMessage).toBeVisible()\n   210→    await expect(ownMessage).toContainText('You cannot book your own property')\n   211→\n   212→    // Reserve button should not be visible (replaced by own-property message)\n   213→    await expect(page.getByTestId('reserve-button')).not.toBeVisible()\n   214→  })\n   215→\n   216→  test('Check-in date picker prevents selecting past dates', async ({ page }) => {\n   217→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   218→\n   219→    const card = page.getByTestId('booking-card')\n   220→    await expect(card).toBeVisible({ timeout: 30000 })\n   221→\n   222→    const checkin = page.getByTestId('booking-checkin')\n   223→\n   224→    // The min attribute should be set to today's date\n   225→    const today = new Date().toISOString().split('T')[0]\n   226→    await expect(checkin).toHaveAttribute('min', today!)\n   227→  })\n   228→\n   229→  test('Check-out date must be after check-in date', async ({ page }) => {\n   230→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   231→\n   232→    const card = page.getByTestId('booking-card')\n   233→    await expect(card).toBeVisible({ timeout: 30000 })\n   234→\n   235→    // Set check-in date\n   236→    await page.getByTestId('booking-checkin').fill('2026-05-01')\n   237→\n   238→    // Check-out min should be set to check-in date or later\n   239→    const checkout = page.getByTestId('booking-checkout')\n   240→    await expect(checkout).toHaveAttribute('min', '2026-05-01')\n   241→  })\n   242→\n   243→  test('Guest count cannot exceed property max_guests', async ({ page }) => {\n   244→    // b1111111: max_guests = 4\n   245→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   246→\n   247→    const card = page.getByTestId('booking-card')\n   248→    await expect(card).toBeVisible({ timeout: 30000 })\n   249→\n   250→    const guestsSelect = page.getByTestId('booking-guests')\n   251→    const options = guestsSelect.locator('option')\n   252→\n   253→    // Should have exactly 4 options (1-4)\n   254→    await expect(options).toHaveCount(4)\n   255→\n   256→    // Last option value should be \"4\"\n   257→    await expect(options.last()).toHaveText('4 guests')\n   258→  })\n   259→\n   260→  test('Guest count minimum is 1', async ({ page }) => {\n   261→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   262→\n   263→    const card = page.getByTestId('booking-card')\n   264→    await expect(card).toBeVisible({ timeout: 30000 })\n   265→\n   266→    const guestsSelect = page.getByTestId('booking-guests')\n   267→\n   268→    // First option should be \"1 guest\" (minimum)\n   269→    const options = guestsSelect.locator('option')\n   270→    await expect(options.first()).toHaveText('1 guest')\n   271→\n   272→    // Default value should be 1\n   273→    await expect(guestsSelect).toHaveValue('1')\n   274→  })\n   275→\n   276→  test('Reserve button shows error for unavailable dates', async ({ page }) => {\n   277→    test.slow()\n   278→    await loginAs(page, GUEST_EMAIL)\n   279→\n   280→    // b2222222 has a confirmed booking for 2026-04-01 to 2026-04-07 (by Alex)\n   281→    await page.goto('/properties/b2222222-2222-2222-2222-222222222222')\n   282→\n   283→    const card = page.getByTestId('booking-card')\n   284→    await expect(card).toBeVisible({ timeout: 30000 })\n   285→\n   286→    // Select overlapping dates\n   287→    await page.getByTestId('booking-checkin').fill('2026-04-02')\n   288→    await page.getByTestId('booking-checkout').fill('2026-04-06')\n   289→    await page.getByTestId('booking-guests').selectOption('2')\n   290→\n   291→    // Click Reserve\n   292→    const reserveBtn = page.getByTestId('reserve-button')\n   293→    await expect(reserveBtn).toBeEnabled()\n   294→    await reserveBtn.click()\n   295→\n   296→    // Should show error about unavailable dates\n   297→    const errorMsg = page.getByTestId('booking-error')\n   298→    await expect(errorMsg).toBeVisible({ timeout: 30000 })\n   299→    await expect(errorMsg).toContainText('not available')\n   300→  })\n   301→\n   302→  test('Booking card date pickers and guest selector are functional on repeated use', async ({ page }) => {\n   303→    // b1111111: $150/night, $75 cleaning fee, 4 max guests\n   304→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   305→\n   306→    const card = page.getByTestId('booking-card')\n   307→    await expect(card).toBeVisible({ timeout: 30000 })\n   308→\n   309→    const checkin = page.getByTestId('booking-checkin')\n   310→    const checkout = page.getByTestId('booking-checkout')\n   311→    const guestsSelect = page.getByTestId('booking-guests')\n   312→    const breakdown = page.getByTestId('price-breakdown')\n   313→\n   314→    // First selection: 2026-05-01 to 2026-05-04 (3 nights), 2 guests\n   315→    await checkin.fill('2026-05-01')\n   316→    await checkout.fill('2026-05-04')\n   317→    await guestsSelect.selectOption('2')\n   318→\n   319→    // $150 x 3 = $450 + $75 = $525\n   320→    await expect(breakdown).toContainText('$150 x 3 nights')\n   321→    await expect(breakdown).toContainText('$525')\n   322→\n   323→    // Change dates: 2026-06-01 to 2026-06-05 (4 nights)\n   324→    await checkin.fill('2026-06-01')\n   325→    await checkout.fill('2026-06-05')\n   326→\n   327→    // $150 x 4 = $600 + $75 = $675\n   328→    await expect(breakdown).toContainText('$150 x 4 nights')\n   329→    await expect(breakdown).toContainText('$675')\n   330→\n   331→    // Change guests: 2 -> 4 -> 2\n   332→    await guestsSelect.selectOption('4')\n   333→    await expect(guestsSelect).toHaveValue('4')\n   334→    await guestsSelect.selectOption('2')\n   335→    await expect(guestsSelect).toHaveValue('2')\n   336→\n   337→    // Price breakdown should still be correct after guest changes\n   338→    await expect(breakdown).toContainText('$150 x 4 nights')\n   339→    await expect(breakdown).toContainText('$675')\n   340→\n   341→    // Final state verification\n   342→    await expect(checkin).toHaveValue('2026-06-01')\n   343→    await expect(checkout).toHaveValue('2026-06-05')\n   344→    await expect(guestsSelect).toHaveValue('2')\n   345→  })\n   346→\n   347→  test('Booking card is sticky on desktop viewport', async ({ page }) => {\n   348→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   349→\n   350→    const card = page.getByTestId('booking-card')\n   351→    await expect(card).toBeVisible({ timeout: 30000 })\n   352→\n   353→    // Verify the card has