ser',\n    55→  async (_, { getState, rejectWithValue }) => {\n    56→    const state = getState() as { auth: AuthState };\n    57→    const token = state.auth.token;\n    58→    if (!token) {\n    59→      return rejectWithValue('No token');\n    60→    }\n    61→    const response = await fetch('/api/me', {\n    62→      headers: { Authorization: `Bearer ${token}` },\n    63→    });\n    64→    if (!response.ok) {\n    65→      return rejectWithValue('Session expired');\n    66→    }\n    67→    const data = await response.json();\n    68→    return data;\n    69→  }\n    70→);\n    71→\n    72→const authSlice = createSlice({\n    73→  name: 'auth',\n    74→  initialState,\n    75→  reducers: {\n    76→    logout(state) {\n    77→      state.user = null;\n    78→      state.token = null;\n    79→      state.error = null;\n    80→      localStorage.removeItem('session_token');\n    81→    },\n    82→    clearError(state) {\n    83→      state.error = null;\n    84→    },\n    85→  },\n    86→  extraReducers: (builder) => {\n    87→    builder\n    88→      .addCase(login.pending, (state) => {\n    89→        state.loading = true;\n    90→        state.error = null;\n    91→      })\n    92→      .addCase(login.fulfilled, (state, action) => {\n    93→        state.loading = false;\n    94→        state.user = action.payload.user;\n    95→        state.token = action.payload.token;\n    96→        localStorage.setItem('session_token', action.payload.token);\n    97→      })\n    98→      .addCase(login.rejected, (state, action) => {\n    99→        state.loading = false;\n   100→        state.error = action.payload as string;\n   101→      })\n   102→      .addCase(signup.pending, (state) => {\n   103→        state.loading = true;\n   104→        state.error = null;\n   105→      })\n   106→      .addCase(signup.fulfilled, (state, action) => {\n   107→        state.loading = false;\n   108→        state.user = action.payload.user;\n   109→        state.token = action.payload.token;\n   110→        localStorage.setItem('session_token', action.payload.token);\n   111→      })\n   112→      .addCase(signup.rejected, (state, action) => {\n   113→        state.loading = false;\n   114→        state.error = action.payload as string;\n   115→      })\n   116→      .addCase(fetchCurrentUser.fulfilled, (state, action) => {\n   117→        state.user = action.payload.user;\n   118→      })\n   119→      .addCase(fetchCurrentUser.rejected, (state) => {\n   120→        state.user = null;\n   121→        state.token = null;\n   122→        localStorage.removeItem('session_token');\n   123→      });\n   124→  },\n   125→});\n   126→\n   127→export const { logout, clearError } = authSlice.actions;\n   128→export default authSlice.reducer;\n   129→"}]},"parent_tool_use_id":null,"session_id":"99814115-c30e-4f87-9cbf-74bddf769cac","uuid":"e44500d3-d081-49c6-9cfb-96f21745f70d","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/src/slices/authSlice.ts","content":"import { createSlice, createAsyncThunk } from '@reduxjs/toolkit';\n\ninterface AuthState {\n  user: {\n    id: string;\n    name: string;\n    email: string;\n  } | null;\n  token: string | null;\n  loading: boolean;\n  error: string | null;\n}\n\nconst initialState: AuthState = {\n  user: null,\n  token: localStorage.getItem('session_token'),\n  loading: false,\n  error: null,\n};\n\nexport const login = createAsyncThunk(\n  'auth/login',\n  async (credentials: { email: string; password: string }, { rejectWithValue }) => {\n    const response = await fetch('/api/login', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify(credentials),\n    });\n    const data = await response.json();\n    if (!response.ok) {\n      return rejectWithValue(data.error || 'Invalid email or password');\n    }\n    return data;\n  }\n);\n\nexport const signup = createAsyncThunk(\n  'auth/signup',\n  async (credentials: { name: string; email: string; password: string }, { rejectWithValue }) => {\n    const response = await fetch('/api/signup', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify(credentials),\n    });\n    const data = await response.json();\n    if (!response.ok) {\n      return rejectWithValue(data.error || 'Sign up failed');\n    }\n    return data;\n  }\n);\n\nexport const fetchCurrentUser = createAsyncThunk(\n  'auth/fetchCurrentUser',\n  async (_, { getState, rejectWithValue }) => {\n    const state = getState() as { auth: AuthState };\n    const token = state.auth.token;\n    if (!token) {\n      return rejectWithValue('No token');\n    }\n    const response = await fetch('/api/me', {\n      headers: { Authorization: `Bearer ${token}` },\n    });\n    if (!response.ok) {\n      return rejectWithValue('Session expired');\n    }\n    const data = await response.json();\n    return data;\n  }\n);\n\nconst authSlice = createSlice({\n  name: 'auth',\n  initialState,\n  reducers: {\n    logout(state) {\n      state.user = null;\n      state.token = null;\n      state.error = null;\n      localStorage.removeItem('session_token');\n    },\n    clearError(state) {\n      state.error = null;\n    },\n  },\n  extraReducers: (builder) => {\n    builder\n      .addCase(login.pending, (state) => {\n        state.loading = true;\n        state.error = null;\n      })\n      .addCase(login.fulfilled, (state, action) => {\n        state.loading = false;\n        state.user = action.payload.user;\n        state.token = action.payload.token;\n        localStorage.setItem('session_token', action.payload.token);\n      })\n      .addCase(login.rejected, (state, action) => {\n        state.loading = false;\n        state.error = action.payload as string;\n      })\n      .addCase(signup.pending, (state) => {\n        state.loading = true;\n        state.error = null;\n      })\n      .addCase(signup.fulfilled, (state, action) => {\n        state.loading = false;\n        state.user = action.payload.user;\n        state.token = action.payload.token;\n        localStorage.setItem('session_token', action.payload.token);\n      })\n      .addCase(signup.rejected, (state, action) => {\n        state.loading = false;\n        state.error = action.payload as string;\n      })\n      .addCase(fetchCurrentUser.fulfilled, (state, action) => {\n        state.user = action.payload.user;\n      })\n      .addCase(fetchCurrentUser.rejected, (state) => {\n        state.user = null;\n        state.token = null;\n        localStorage.removeItem('session_token');\n      });\n  },\n});\n\nexport const { logout, clearError } = authSlice.actions;\nexport default authSlice.reducer;\n","numLines":129,"startLine":1,"totalLines":129}}}
