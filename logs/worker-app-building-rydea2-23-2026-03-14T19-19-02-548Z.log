\"7\" r=\"6\" stroke={color} strokeWidth=\"1.5\" />\n    74→        </svg>\n    75→      );\n    76→  }\n    77→}\n    78→\n    79→function PriorityIcon({ priority }: { priority: string }) {\n    80→  const config = PRIORITY_CONFIG[priority] || PRIORITY_CONFIG.none;"}]},"parent_tool_use_id":"toolu_017o3c7ZbXzUdsG6RF8aGt3H","session_id":"99814115-c30e-4f87-9cbf-74bddf769cac","uuid":"eb29fc95-95f7-4c38-b0ad-1cc7c417935f"}
