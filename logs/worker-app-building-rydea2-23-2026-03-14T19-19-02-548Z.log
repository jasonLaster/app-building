ondary);\n}\n\n.signup-form-input {\n  background-color: var(--color-bg-surface);\n  border: 1px solid var(--color-border);\n\n==> /repo/apps/LinearClone/src/components/Sidebar.css <==\n.sidebar {\n  width: 240px;\n  min-width: 240px;\n  height: 100vh;\n  background-color: var(--color-bg);\n  border-right: 1px solid var(--color-border);\n  display: flex;\n  flex-direction: column;\n  transition: width 150ms ease, min-width 150ms ease;\n  position: relative;\n  z-index: 10;\n}\n\n.sidebar-collapsed {\n  width: 48px;\n  min-width: 48px;\n}\n\n.sidebar-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 12px 12px 8px;\n  gap: 8px;\n}\n\n.sidebar-collapsed .sidebar-header {\n  padding: 12px 6px 8px;\n  justify-content: center;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.sidebar-workspace-name {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  text-decoration: none;\n  color: var(--color-text-primary);\n  font-size: 14px;\n  font-weight: 600;\n  overflow: hidden;\n  white-space: nowrap;\n}\n\n.sidebar-workspace-icon {\n  flex-shrink: 0;\n  display: flex;\n  align-items: center;\n}\n\n==> /repo/apps/LinearClone/src/components/SidebarCollapse.css <==\n.sidebar-collapse-toggle {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 24px;\n  height: 24px;\n  border: none;\n  background: none;\n  color: var(--color-text-tertiary);\n  cursor: pointer;\n  border-radius: 4px;\n  transition: background-color 150ms ease, color 150ms ease;\n  flex-shrink: 0;\n}\n\n.sidebar-collapse-toggle:hover {\n  background-color: var(--color-bg-surface);\n  color: var(--color-text-primary);\n}\n\n.sidebar-collapse-icon {\n  transition: transform 150ms ease;\n}\n\n.sidebar-collapse-icon-collapsed {\n  transform: rotate(180deg);\n}\n\n==> /repo/apps/LinearClone/src/components/IssueRow.css <==\n.issue-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 6px 12px;\n  height: 36px;\n  border-bottom: 1px solid var(--color-border);\n  transition: background-color 150ms ease;\n  gap: 8px;\n}\n\n.issue-row:hover {\n  background-color: var(--color-bg-surface);\n}\n\n.issue-row-left {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  min-width: 0;\n  flex: 1;\n}\n\n.issue-row-priority {\n  flex-shrink: 0;\n  display: flex;\n  align-items: center;\n}\n\n.issue-row-identifier {\n  flex-shrink: 0;\n  font-size: 12px;\n  color: var(--color-text-tertiary);\n  font-weight: 500;\n  font-variant-numeric: tabular-nums;\n}\n\n.issue-row-title {\n  background: none;\n  border: none;\n  padding: 0;\n  margin: 0;\n  font-size: 14px;\n  font-weight: 500;\n  color: var(--color-text-primary);\n  cursor: pointer;\n  text-align: left;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n\n==> /repo/apps/LinearClone/src/components/FiltersToolbar.css <==\n.filters-toolbar {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 0;\n}\n\n.filters-toolbar-filter {\n  position: relative;\n}\n\n.filters-toolbar-btn {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: 4px 10px;\n  border: 1px solid var(--color-border);\n  border-radius: 6px;\n  background: none;\n  color: var(--color-text-secondary);\n  font-size: 12px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease;\n  white-space: nowrap;\n}\n\n.filters-toolbar-btn:hover {\n  background-color: var(--color-bg-surface);\n  border-color: var(--color-text-tertiary);\n  color: var(--color-text-primary);\n}\n\n.filters-toolbar-btn-active {\n  background-color: rgba(94, 106, 210, 0.1);\n  border-color: var(--color-accent);\n  color: var(--color-accent);\n}\n\n.filters-toolbar-btn-active:hover {\n  background-color: rgba(94, 106, 210, 0.15);\n  border-color: var(--color-accent);\n  color: var(--color-accent);\n}\n\n.filters-toolbar-badge {\n  background-color: var(--color-accent);\n  