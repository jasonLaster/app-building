-tertiary);\n  white-space: nowrap;\n}\n\n.notification-row-archive-btn {\n  background: none;\n  border: none;\n  padding: 4px;\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  border-radius: 4px;\n  color: var(--color-text-tertiary);\n  transition: background-color 150ms ease, color 150ms ease;\n  opacity: 0;\n}\n\n.notification-row:hover .notification-row-archive-btn {\n  opacity: 1;\n}\n\n.notification-row-archive-btn:hover {\n  background-color: var(--color-bg-hover);\n  color: var(--color-text-primary);\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1505,"cache_read_input_tokens":56333,"cache_creation":{"ephemeral_5m_input_tokens":1505,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"global"},"context_management":null},"parent_tool_use_id":null,"session_id":"99814115-c30e-4f87-9cbf-74bddf769cac","uuid":"b5144e0d-6dd8-48d2-9056-b3fa68164530"}
