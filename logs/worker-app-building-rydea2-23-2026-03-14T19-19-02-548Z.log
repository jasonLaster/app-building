,\n    });\n  } catch (err) {\n    console.error('Fetch notifications count error:', err);\n    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n      status: 500,\n      headers: { 'Content-Type': 'application/json' },\n    });\n  }\n}\n","numLines":56,"startLine":1,"totalLines":56}}}
