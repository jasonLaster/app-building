   93→    },\n    94→    {\n    95→      \"skill\": \"skills/tasks/build/writeApp.md\",\n    96→      \"subtasks\": [\n    97→        \"WriteComponentLabelList: Write the LabelList component with colored dots, names, and issue counts\",\n    98→        \"WriteComponentCreateLabel: Write the CreateLabel form with name field and color picker\",\n    99→        \"WriteComponentEditDeleteLabel: Write the EditDeleteLabel with inline editing and delete confirmation\",\n   100→        \"WritePageLabels: Write the Labels page\"\n   101→      ],\n   102→      \"timestamp\": \"2026-03-14T18:57:06.538Z\",\n   103→      \"app\": \"LinearClone\"\n   104→    },\n   105→    {\n   106→      \"skill\": \"skills/tasks/build/writeApp.md\",\n   107→      \"subtasks\": [\n   108→        \"WriteComponentWorkspaceSettings: Write the WorkspaceSettings component with workspace name and default team fields\",\n   109→        \"WritePageSettings: Write the Settings page\"\n   110→      ],\n   111→      \"timestamp\": \"2026-03-14T18:57:06.538Z\",\n   112→      \"app\": \"LinearClone\"\n   113→    },\n   114→    {\n   115→      \"skill\": \"skills/tasks/build/writeApp.md\",\n   116→      \"subtasks\": [\n   117→        \"SetupApp: Setup the app\",\n   118→        \"DesignDatabase: Design the database\"\n   119→      ],\n   120→      \"timestamp\": \"2026-03-14T18:56:37.640Z\",\n   121→      \"app\": \"LinearClone\"\n   122→    },\n   123→    {\n   124→      \"skill\": \"skills/tasks/writeScript.md\",\n   125→      \"subtasks\": [\n   126→        \"Unpack: Implement package scripts\"\n   127→      ],\n   128→      \"timestamp\": \"2026-03-14T18:21:07.448Z\",\n   129→      \"app\": \"LinearClone\"\n   130→    },\n   131→    {\n   132→      \"skill\": \"skills/tasks/build/writeTests.md\",\n   133→      \"subtasks\": [\n   134→        \"Unpack: Write Playwright tests\"\n   135→      ],\n   136→      \"timestamp\": \"2026-03-14T18:21:07.448Z\",\n   137→      \"app\": \"LinearClone\"\n   138→    },\