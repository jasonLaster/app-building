[2026-03-14T22:09:23.092Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Wf3XzHp7MMGPmqCacckYcE","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test';\n     2→\n     3→// Helper to login via API and get token\n     4→async function loginViaApi(baseURL: string, email: string, password: string) {\n     5→  const response = await fetch(`${baseURL}/api/login`, {\n     6→    method: 'POST',\n     7→    headers: { 'Content-Type': 'application/json' },\n     8→    body: JSON.stringify({ email, password }),\n     9→  });\n    10→  return response.json();\n    11→}\n    12→\n    13→// Helper to get teams via API\n    14→async function getTeams(baseURL: string, token: string) {\n    15→  const response = await fetch(`${baseURL}/api/teams`, {\n    16→    headers: { Authorization: `Bearer ${token}` },\n    17→  });\n    18→  const data = await response.json();\n    19→  return data.teams;\n    20→}\n    21→\n    22→// Helper to get team issues via API\n    23→async function getTeamIssues(baseURL: string, token: string, teamId: string) {\n    24→  const response = await fetch(`${baseURL}/api/team-issues?teamId=${teamId}`, {\n    25→    headers: { Authorization: `Bearer ${token}` },\n    26→  });\n    27→  const data = await response.json();\n    28→  return data.issues;\n    29→}\n    30→\n    31→// Helper to get labels via API\n    32→async function getLabels(baseURL: string, token: string) {\n    33→  const response = await fetch(`${baseURL}/api/labels`, {\n    34→    headers: { Authorization: `Bearer ${token}` },\n    35→  });\n    36→  const data = await response.json();\n    37→  return data.labels;\n    38→}\n    39→\n    40→// Helper to get projects via API\n    41→async function getProjects(baseURL: string, token: string) {\n    42→  const response = await fetch(`${baseURL}/api/projects`, {\n    43→    headers: { Authorization: `Bearer ${token}` },\n    44→  });\n    45→  const data = await response.json();\n    46→  return data.projects;\n    47→}\n    48→\n    49→// Helper to login and navigate to an issue detail page\n    50→async function loginAndNavigateToIssue(\n    51→  page: import('@playwright/test').Page,\n    52→  baseURL: string,\n    53→  issueNumber: number,\n    54→  email = 'alice@acme.com',\n    55→  password = 'password123'\n    56→) {\n    57→  const data = await loginViaApi(baseURL, email, password);\n    58→  const teams = await getTeams(baseURL, data.token);\n    59→  const engTeam = teams.find((t: { identifier: string }) => t.identifier === 'ENG');\n    60→  const issues = await getTeamIssues(baseURL, data.token, engTeam.id);\n    61→  const issue = issues.find((i: { number: number }) => i.number === issueNumber);\n    62→\n    63→  await page.goto('/login');\n    64→  await page.evaluate((t) => localStorage.setItem('session_token', t), data.token);\n    65→  await page.goto(`/issue/${issue.id}`);\n    66→  await expect(page.getByTestId('issue-detail-page')).toBeVisible({ timeout: 30000 });\n    67→  await expect(page.getByTestId('issue-sidebar')).toBeVisible({ timeout: 30000 });\n    68→  return { token: data.token, user: data.user, engTeam, issue };\n    69→}\n    70→\n    71→test.describe('Issue Detail Sidebar - Labels', () => {\n    72→  test('Add labels via multi-select picker', async ({ page, baseURL }) => {\n    73→    // ENG-7: has Improvement label, no other labels\n    74→    await loginAndNavigateToIssue(page, baseURL!, 7);\n    75→\n    76→    // Click the Labels button\n    77→    await page.getByTestId('sidebar-labels-btn').click();\n    78→\n    79→    // Verify multi-select dropdown appears with all available labels\n    80→    await expect(page.getByTestId('sidebar-labels-dropdown')).toBeVisible();\n    81→    await expect(page.getByTestId('sidebar-labels-dropdown')).toContainText('Bug');\n    82→    await expect(page.getByTestId('sidebar-labels-dropdown')).toContainText('Feature');\n    83→    await expect(page.getByTestId('sidebar-labels-dropdown')).toContainText('Improvement');\n    84→    await expect(page.getByTestId('sidebar-labels-dropdown')).toContainText('Documentation');\n    85→  });\n    86→\n    87→  test('Select multiple labels', async ({ page, baseURL }) => {\n    88→    // ENG-5: has Documentation label\n    89→    const { token } = await loginAndNavigateToIssue(page, baseURL!, 5);\n    90→\n    91→    // Get label IDs for assertions\n    92→    const labels = await getLabels(baseURL!, token);\n    93→    const bugLabel = labels.find((l: { name: string }) => l.name === 'Bug');\n    94→    const featureLabel = labels.find((l: { name: string }) => l.name === 'Feature');\n    95→\n    96→    // Open labels dropdown\n    97→    await page.getByTestId('sidebar-labels-btn').click();\n    98→    await expect(page.getByTestId('sidebar-labels-dropdown')).toBeVisible();\n    99→\n   100→    // Click \"Bug\" label\n   101→    await page.getByTestId(`sidebar-label-option-${bugLabel.id}`).click();\n   102→\n   103→    // Click \"Feature\" label\n   104→    await page.getByTestId(`sidebar-label-option-${featureLabel.id}`).click();\n   105→\n   106→    // Verify both new labels appear as badges in the sidebar (along with existing Documentation)\n   107→    await expect(page.getByTestId(`sidebar-label-badge-${bugLabel.id}`)).toBeVisible({ timeout: 30000 });\n   108→    await expect(page.getByTestId(`sidebar-label-badge-${featureLabel.id}`)).toBeVisible({ timeout: 30000 });\n   109→  });\n   110→\n   111→  test('Remove a label', async ({ page, baseURL }) => {\n   112→    // ENG-1: has Bug label\n   113→    const { token } = await loginAndNavigateToIssue(page, baseURL!, 1);\n   114→\n   115→    // Get label IDs\n   116→    const labels = await getLabels(baseURL!, token);\n   117→    const bugLabel = labels.find((l: { name: string }) => l.name === 'Bug');\n   118→\n   119→    // Verify Bug label badge is displayed\n   120→    await expect(page.getByTestId(`sidebar-label-badge-${bugLabel.id}`)).