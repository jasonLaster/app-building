rs: Record<string, string>\n    61→}\n    62→\n    63→function getOrCreateSessionToken(): string {\n    64→  const key = 'gf_session_token'\n    65→  let token = localStorage.getItem(key)\n    66→  if (!token) {\n    67→    token = crypto.randomUUID()\n    68→    localStorage.setItem(key, token)\n    69→  }\n    70→  return token\n    71→}\n    72→\n    73→const initialState: SearchState = {\n    74→  tripType: 'round_trip',\n    75→  passengers: { adults: 1, children: 0, infants: 0 },\n    76→  cabinClass: 'economy',\n    77→  origin: null,\n    78→  destination: null,\n    79→  departureDate: null,\n    80→  returnDate: null,\n    81→  recentSearches: [],\n    82→  recentSearchesLoading: false,\n    83→  popularDestinations: [],\n    84→  popularDestinationsLoading: false,\n    85→  sessionToken: typeof window !== 'undefined' ? getOrCreateSessionToken() : '',\n    86→  validationErrors: {},\n    87→}\n    88→\n    89→export const fetchRecentSearches = createAsyncThunk(\n    90→  'search/fetchRecentSearches',\n    91→  async (sessionToken: string) => {\n    92→    const res = await fetch(`/api/recent-searches?session=${encodeURIComponent(sessionToken)}`)\n    93→    return res.json() as Promise<RecentSearch[]>\n    94→  }\n    95→)\n    96→\n    97→export const saveRecentSearch = createAsyncThunk(\n    98→  'search/saveRecentSearch',\n    99→  async (params: {\n   100→    sessionToken: string\n   101→    originCode: string\n   102→    destCode: string\n   103→    departureDate: string\n   104→    returnDate: string | null\n   105→    adults: number\n   106→    children: number\n   107→    infants: number\n   108→    cabinClass: string\n   109→    tripType: string\n   110→  }) => {\n   111→    await fetch('/api/recent-searches', {\n   112→      method: 'POST',\n   113→      headers: { 'Content-Type': 'application/json' },\n   114→      body: JSON.stringify(params),\n   115→    })\n   116→  }\n   117→)\n   118→\n   119→export const fetchPopularDestinations = createAsyncThunk(\n   120→  'search/fetchPopularDestinations',\n   121→  async () => {\n   122→    const res = await fetch('/api/popular-destinations')\n   123→    return res.json() as Promise<PopularDestination[]>\n   124→  }\n   125→)\n   126→\n   127→const searchSlice = createSlice({\n   128→  name: 'search',\n   129→  initialState,\n   130→  reducers: {\n   131→    setTripType(state, action: PayloadAction<TripType>) {\n   132→      state.tripType = action.payload\n   133→      if (action.payload === 'one_way') {\n   134→        state.returnDate = null\n   135→      }\n   136→    },\n   137→    setPassengers(state, action: PayloadAction<{ adults: number; children: number; infants: number }>) {\n   138→      state.passengers = action.payload\n   139→    },\n   140→    setCabinClass(state, action: PayloadAction<CabinClass>) {\n   141→      state.cabinClass = action.payload\n   142→    },\n   143→    setOrigin(state, action: PayloadAction<Airport | null>) {\n   144→      state.origin = action.payload\n   145→      delete state.validationErrors['origin']\n   146→    },\n   147→    setDestination(state, action: PayloadAction<Airport | null>) {\n   148→      state.destination = action.payload\n   149→      delete state.validationErrors['destination']\n   150→    },\n   151→    swapAirports(state) {\n   152→      const temp = state.origin\n   153→      state.origin = state.destination\n   154→      state.destination = temp\n   155→    },\n   156→    setDepartureDate(state, action: PayloadAction<string | null>) {\n   157→      state.departureDate = action.payload\n   158→      delete state.validationErrors['departureDate']\n   159→    },\n   160→    setReturnDate(state, action: PayloadAction<string | null>) {\n   161→      state.returnDate = action.payload\n   162→      delete state.validationErrors['returnDate']\n   163→    },\n   164→    setValidationErrors(state, action: PayloadAction<Record<string, string>>) {\n   165→      state.validationErrors = action.payload\n   166→    },\n   167→    clearValidationErrors(state) {\n   168→      state.validationErrors = {}\n   169→    },\n   170→  },\n   171→  extraReducers: (builder) => {\n   172→    builder\n   173→      .addCase(fetchRecentSearches.pending, (state) => {\n   174→        if (state.recentSearches.length === 0) {\n   175→          state.recentSearchesLoading = true\n   176→        }\n   177→      })\n   178→      .addCase(fetchRecentSearches.fulfilled, (state, action) => {\n   179→        state.recentSearches = action.payload\n   180→        state.recentSearchesLoading = false\n   181→      })\n   182→      .addCase(fetchRecentSearches.rejected, (state) => {\n   183→        state.recentSearchesLoading = false\n   184→      })\n   185→      .addCase(fetchPopularDestinations.pending, (state) => {\n   186→        if (state.popularDestinations.length === 0) {\n   187→          state.popularDestinationsLoading = true\n   188→        }\n   189→      })\n   190→      .addCase(fetchPopularDestinations.fulfilled, (state, action) => {\n   191→        state.popularDestinations = action.payload\n   192→        state.popularDestinationsLoading = false\n   193→      })\n   194→      .addCase(fetchPopularDestinations.rejected, (state) => {\n   195→        state.popularDestinationsLoading = false\n   196→      })\n   197→  },\n   198→})\n   199→\n   200→export const {\n   201→  setTripType,\n   202→  setPassengers,\n   203→  setCabinClass,\n   204→  setOrigin,\n   205→  setDestination,\n   206→  swapAirports,\n   207→  setDepartureDate,\n   208→  setReturnDate,\n   209→  setValidationErrors,\n   210→  clearValidationErrors,\n   211→} = searchSlice.actions\n   212→\n   213→export default searchSlice.reducer\n   214→"}]},"parent_tool_use_id":null,"session_id":"b4b0b3d3-2c6a-4406-854f-49cde2c25320","uuid":"1a436842-d714-4616-b616-3fda0103ca3a","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/GoogleFlights/src/slices/searchSlice.ts","content":"import { createSlice, createAsyncThunk, type PayloadAction } from '@reduxjs/toolkit'\n\nexport interface Airport {\n  id: string\n  iata_code: string\n  name: string\n  city: string\n  country: string\n  latitude?: number\n  longitude?: number\n}\n\nexport interface RecentSearch {\n  id: string\n  origin_code: string\n  origin_name: string\n  origin_city: string\n  dest_code: string\n  dest_name: string\n  dest_city: string\n  departure_date: string\n  return_date: string | null\n  passengers_adults: number\n  passengers_children: number\n  passengers_infants: number\n  cabin_class: string\n  trip_type: string\n  searched_at: string\n}\n\nexport interface PopularDestination {\n  id: string\n  iata_code: string\n  city: string\n  country: string\n  gradient: string\n  min_price: number | null\n}\n\nexport type TripType = 'round_trip' | 'one_way' | 'multi_city'\nexport type CabinClass = 'economy' | 'premium_economy' | 'business' | 'first'\n\ninterface SearchState {\n  tripType: TripType\n  passengers: {\n    adults: number\n    children: number\n    infants: number\n  }\n  cabinClass: CabinClass\n  origin: Airport | null\n  destination: Airport | null\n  departureDate: string | null\n  returnDate: string | null\n  recentSearches: RecentSearch[]\n  recentSearchesLoading: boolean\n  popularDestinations: PopularDestination[]\n  popularDestinationsLoading: boolean\n  sessionToken: string\n  validationErrors: Record<string, string>\n}\n\nfunction getOrCreateSessionToken(): string {\n  const key = 'gf_session_token'\n  let token = localStorage.getItem(key)\n  if (!token) {\n    token = crypto.randomUUID()\n    localStorage.setItem(key, token)\n  }\n  return token\n}\n\nconst initialState: SearchState = {\n  tripType: 'round_trip',\n  passengers: { adults: 1, children: 0, infants: 0 },\n  cabinClass: 'economy',\n  origin: null,\n  destination: null,\n  departureDate: null,\n  returnDate: null,\n  recentSearches: [],\n  recentSearchesLoading: false,\n  popularDestinations: [],\n  popularDestinationsLoading: false,\n  sessionToken: typeof window !== 'undefined' ? getOrCreateSessionToken() : '',\n  validationErrors: {},\n}\n\nexport const fetchRecentSearches = createAsyncThunk(\n  'search/fetchRecentSearches',\n  async (sessionToken: string) => {\n    const res = await fetch(`/api/recent-searches?session=${encodeURIComponent(sessionToken)}`)\n    return res.json() as Promise<RecentSearch[]>\n  }\n)\n\nexport const saveRecentSearch = createAsyncThunk(\n  'search/saveRecentSearch',\n  async (params: {\n    sessionToken: string\n    originCode: string\n    destCode: string\n    departureDate: string\n    returnDate: string | null\n    adults: number\n    children: number\n    infants: number\n    cabinClass: string\n    tripType: string\n  }) => {\n    await fetch('/api/recent-searches', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify(params),\n    })\n  }\n)\n\nexport const fetchPopularDestinations = createAsyncThunk(\n  'search/fetchPopularDestinations',\n  async () => {\n    const res = await fetch('/api/popular-destinations')\n    return res.json() as Promise<PopularDestination[]>\n  }\n)\n\nconst searchSlice = createSlice({\n  name: 'search',\n  initialState,\n  reducers: {\n    setTripType(state, action: PayloadAction<TripType>) {\n      state.tripType = action.payload\n      if (action.payload === 'one_way') {\n        state.returnDate = null\n      }\n    },\n    setPassengers(state, action: PayloadAction<{ adults: number; children: number; infants: number }>) {\n      state.passengers = action.payload\n    },\n    setCabinClass(state, action: PayloadAction<CabinClass>) {\n      state.cabinClass = action.payload\n    },\n    setOrigin(state, action: PayloadAction<Airport | null>) {\n      state.origin = action.payload\n      delete state.validationErrors['origin']\n    },\n    setDestination(state, action: PayloadAction<Airport | null>) {\n      state.destination = action.payload\n      delete state.validationErrors['destination']\n    },\n    swapAirports(state) {\n      const temp = state.origin\n      state.origin = state.destination\n      state.destination = temp\n    },\n    setDepartureDate(state, action: PayloadAction<string | null>) {\n      state.departureDate = action.payload\n      delete state.validationErrors['departureDate']\n    },\n    setReturnDate(state, action: PayloadAction<string | null>) {\n      state.returnDate = action.payload\n      delete state.validationErrors['returnDate']\n    },\n    setValidationErrors(state, action: PayloadAction<Record<string, string>>) {\n      state.validationErrors = action.payload\n    },\n    clearValidationErrors(state) {\n      state.validationErrors = {}\n    },\n  },\n  extraReducers: (builder) => {\n    builder\n      .addCase(fetchRecentSearches.pending, (state) => {\n        if (state.recentSearches.length === 0) {\n          state.recentSearchesLoading = true\n        }\n      })\n      .addCase(fetchRecentSearches.fulfilled, (state, action) => {\n        state.recentSearches = action.payload\n        state.recentSearchesLoading = false\n      })\n      .addCase(fetchRecentSearches.rejected, (state) => {\n        state.recentSearchesLoading = false\n      })\n      .addCase(fetchPopularDestinations.pending, (state) => {\n        if (state.popularDestinations.length === 0) {\n          state.popularDestinationsLoading = true\n        }\n      })\n      .addCase(fetchPopularDestinations.fulfilled, (state, action) => {\n        state.popularDestinations = action.payload\n        state.popularDestinationsLoading = false\n      })\n      .addCase(fetchPopularDestinations.rejected, (state) => {\n        state.popularDestinationsLoading = false\n      })\n  },\n})\n\nexport const {\n  setTripType,\n  setPassengers,\n  setCabinClass,\n  setOrigin,\n  setDestination,\n  swapAirports,\n  setDepartureDate,\n  setReturnDate,\n  setValidationErrors,\n  clearValidationErrors,\n} = searchSlice.actions\n\nexport default searchSlice.reducer\n","numLines":214,"startLine":1,"totalLines":214}}}
