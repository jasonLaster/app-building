dren),\n    47→      infants: String(search.passengers_infants),\n    48→    })\n    49→    if (search.return_date) params.set('returnDate', search.return_date.split('T')[0]!)\n    50→\n    51→    navigate(`/results?${params.toString()}`)\n    52→  }\n    53→\n    54→  if (recentSearchesLoading) {\n    55→    return (\n    56→      <div className=\"recent-searches\" data-testid=\"recent-searches\">\n    57→        <h3 className=\"recent-searches__title\">Recent searches</h3>\n    58→        <div className=\"recent-searches__loading\">Loading...</div>\n    59→      </div>\n    60→    )\n    61→  }\n    62→\n    63→  if (recentSearches.length === 0) {\n    64→    return (\n    65→      <div className=\"recent-searches\" data-testid=\"recent-searches\">\n    66→        <h3 className=\"recent-searches__title\">Recent searches</h3>\n    67→        <p className=\"recent-searches__empty\" data-testid=\"recent-searches-empty\">No recent searches</p>\n    68→      </div>\n    69→    )\n    70→  }\n    71→\n    72→  return (\n    73→    <div className=\"recent-searches\" data-testid=\"recent-searches\">\n    74→      <h3 className=\"recent-searches__title\">Recent searches</h3>\n    75→      <div className=\"recent-searches__list\" data-testid=\"recent-searches-list\">\n    76→        {recentSearches.map((search) => {\n    77→          const depDate = search.departure_date.split('T')[0] || ''\n    78→          const retDate = search.return_date ? search.return_date.split('T')[0] : null\n    79→          const totalPassengers = search.passengers_adults + search.passengers_children + search.passengers_infants\n    80→          const dateDisplay = retDate\n    81→            ? `${formatShortDate(depDate)} – ${formatShortDate(retDate || '')}`\n    82→            : formatShortDate(depDate)\n    83→\n    84→          return (\n    85→            <button\n    86→              key={search.id}\n    87→              className=\"recent-searches__item\"\n    88→              onClick={() => handleClick(search)}\n    89→              data-testid={`recent-search-${search.id}`}\n    90→            >\n    91→              <div className=\"recent-searches__route\">\n    92→                <span className=\"recent-searches__code\">{search.origin_code}</span>\n    93→                <span className=\"recent-searches__arrow\">→</span>\n    94→                <span className=\"recent-searches__code\">{search.dest_code}</span>\n    95→              </div>\n    96→              <div className=\"recent-searches__details\">\n    97→                <span>{dateDisplay}</span>\n    98→                <span className=\"recent-searches__separator\">·</span>\n    99→                <span>{totalPassengers} {totalPassengers === 1 ? 'passenger' : 'passengers'}</span>\n   100→              </div>\n   101→            </button>\n   102→          )\n   103→        })}\n   104→      </div>\n   105→    </div>\n   106→  )\n   107→}\n   108→\n   109→function formatShortDate(dateStr: string): string {\n   110→  if (!dateStr) return ''\n   111→  const d = new Date(dateStr + 'T00:00:00')\n   112→  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })\n   113→}\n   114→\n   115→export default RecentSearches\n   116→"}]},"parent_tool_use_id":null,"session_id":"b4b0b3d3-2c6a-4406-854f-49cde2c25320","uuid":"e389097d-c044-44b6-b849-f61d8590fb6b","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/GoogleFlights/src/components/RecentSearches.tsx","content":"import { useEffect } from 'react'\nimport { useDispatch, useSelector } from 'react-redux'\nimport { useNavigate } from 'react-router-dom'\nimport {\n  fetchRecentSearches,\n  setTripType,\n  setCabinClass,\n  setPassengers,\n  type TripType,\n  type CabinClass,\n} from '../slices/searchSlice'\nimport type { RootState, AppDispatch } from '../store'\nimport './RecentSearches.css'\n\nfunction RecentSearches() {\n  const dispatch = useDispatch<AppDispatch>()\n  const navigate = useNavigate()\n  const { recentSearches, recentSearchesLoading, sessionToken } = useSelector(\n    (state: RootState) => state.search\n  )\n\n  useEffect(() => {\n    if (sessionToken) {\n      dispatch(fetchRecentSearches(sessionToken))\n    }\n  }, [dispatch, sessionToken])\n\n  function handleClick(search: (typeof recentSearches)[number]) {\n    // Update search form state\n    dispatch(setTripType(search.trip_type as TripType))\n    dispatch(setCabinClass(search.cabin_class as CabinClass))\n    dispatch(setPassengers({\n      adults: search.passengers_adults,\n      children: search.passengers_children,\n      infants: search.passengers_infants,\n    }))\n\n    // Navigate to results\n    const params = new URLSearchParams({\n      origin: search.origin_code,\n      destination: search.dest_code,\n      departureDate: search.departure_date.split('T')[0]!,\n      tripType: search.trip_type,\n      cabinClass: search.cabin_class,\n      adults: String(search.passengers_adults),\n      children: String(search.passengers_children),\n      infants: String(search.passengers_infants),\n    })\n    if (search.return_date) params.set('returnDate', search.return_date.split('T')[0]!)\n\n    navigate(`/results?${params.toString()}`)\n  }\n\n  if (recentSearchesLoading) {\n    return (\n      <div className=\"recent-searches\" data-testid=\"recent-searches\">\n        <h3 className=\"recent-searches__title\">Recent searches</h3>\n        <div className=\"recent-searches__loading\">Loading...</div>\n      </div>\n    )\n  }\n\n  if (recentSearches.length === 0) {\n    return (\n      <div className=\"recent-searches\" data-testid=\"recent-searches\">\n        <h3 className=\"recent-searches__title\">Recent searches</h3>\n        <p className=\"recent-searches__empty\" data-testid=\"recent-searches-empty\">No recent searches</p>\n      </div>\n    )\n  }\n\n  return (\n    <div className=\"recent-searches\" data-testid=\"recent-searches\">\n      <h3 className=\"recent-searches__title\">Recent searches</h3>\n      <div className=\"recent-searches__list\" data-testid=\"recent-searches-list\">\n        {recentSearches.map((search) => {\n          const depDate = search.departure_date.split('T')[0] || ''\n          const retDate = search.return_date ? search.return_date.split('T')[0] : null\n          const totalPassengers = search.passengers_adults + search.passengers_children + search.passengers_infants\n          const dateDisplay = retDate\n            ? `${formatShortDate(depDate)} – ${formatShortDate(retDate || '')}`\n            : formatShortDate(depDate)\n\n          return (\n            <button\n              key={search.id}\n              className=\"recent-searches__item\"\n              onClick={() => handleClick(search)}\n              data-testid={`recent-search-${search.id}`}\n            >\n              <div className=\"recent-searches__route\">\n                <span className=\"recent-searches__code\">{search.origin_code}</span>\n                <span className=\"recent-searches__arrow\">→</span>\n                <span className=\"recent-searches__code\">{search.dest_code}</span>\n              </div>\n              <div className=\"recent-searches__details\">\n                <span>{dateDisplay}</span>\n                <span className=\"recent-searches__separator\">·</span>\n                <span>{totalPassengers} {totalPassengers === 1 ? 'passenger' : 'passengers'}</span>\n              </div>\n            </button>\n          )\n        })}\n      </div>\n    </div>\n  )\n}\n\nfunction formatShortDate(dateStr: string): string {\n  if (!dateStr) return ''\n  const d = new Date(dateStr + 'T00:00:00')\n  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })\n}\n\nexport default RecentSearches\n","numLines":116,"startLine":1,"totalLines":116}}}
