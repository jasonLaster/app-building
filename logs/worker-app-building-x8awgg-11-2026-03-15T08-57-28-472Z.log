[2026-03-15T08:52:20.665Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UrtRFWeNVV782ye4NzmzTT","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions'\n     2→import { getSql } from './db.js'\n     3→\n     4→export default async (request: Request, _context: Context) => {\n     5→  const sql = getSql()\n     6→  const url = new URL(request.url)\n     7→\n     8→  if (request.method === 'GET') {\n     9→    const sessionToken = url.searchParams.get('session') || ''\n    10→    if (!sessionToken) return Response.json([])\n    11→\n    12→    const results = await sql`\n    13→      SELECT rs.id, rs.departure_date, rs.return_date, rs.passengers_adults, rs.passengers_children,\n    14→             rs.passengers_infants, rs.cabin_class, rs.trip_type, rs.searched_at,\n    15→             oa.iata_code as origin_code, oa.name as origin_name, oa.city as origin_city,\n    16→             da.iata_code as dest_code, da.name as dest_name, da.city as dest_city\n    17→      FROM recent_searches rs\n    18→      JOIN airports oa ON rs.origin_airport_id = oa.id\n    19→      JOIN airports da ON rs.destination_airport_id = da.id\n    20→      JOIN sessions s ON rs.session_id = s.id\n    21→      WHERE s.session_token = ${sessionToken}\n    22→      ORDER BY rs.searched_at DESC\n    23→      LIMIT 10\n    24→    `\n    25→    return Response.json(results)\n    26→  }\n    27→\n    28→  if (request.method === 'POST') {\n    29→    const body = await request.json()\n    30→    const { sessionToken, originCode, destCode, departureDate, returnDate, adults, children, infants, cabinClass, tripType } = body\n    31→\n    32→    // Ensure session exists\n    33→    const existing = await sql`SELECT id FROM sessions WHERE session_token = ${sessionToken}`\n    34→    let sessionId: string\n    35→    const existingRow = existing[0]\n    36→    if (existingRow) {\n    37→      sessionId = existingRow.id as string\n    38→    } else {\n    39→      const newSession = await sql`INSERT INTO sessions (session_token) VALUES (${sessionToken}) RETURNING id`\n    40→      const newRow = newSession[0]\n    41→      if (!newRow) return Response.json({ error: 'Failed to create session' }, { status: 500 })\n    42→      sessionId = newRow.id as string\n    43→    }\n    44→\n    45→    const originRows = await sql`SELECT id FROM airports WHERE iata_code = ${originCode}`\n    46→    const destRows = await sql`SELECT id FROM airports WHERE iata_code = ${destCode}`\n    47→    const originRow = originRows[0]\n    48→    const destRow = destRows[0]\n    49→    if (!originRow || !destRow) return Response.json({ error: 'Airport not found' }, { status: 400 })\n    50→\n    51→    await sql`\n    52→      INSERT INTO recent_searches (session_id, origin_airport_id, destination_airport_id, departure_date, return_date, passengers_adults, passengers_children, passengers_infants, cabin_class, trip_type)\n    53→      VALUES (${sessionId}, ${originRow.id}, ${destRow.id}, ${departureDate}, ${returnDate || null}, ${adults || 1}, ${children || 0}, ${infants || 0}, ${cabinClass || 'economy'}, ${tripType || 'round_trip'})\n    54→    `\n    55→\n    56→    return Response.json({ success: true })\n    57→  }\n    58→\n    59→  return Response.json({ error: 'Method not allowed' }, { status: 405 })\n    60→}\n    61→"}]},"parent_tool_use_id":"toolu_01FENfkm3BqEmijo3bznqQea","session_id":"b4b0b3d3-2c6a-4406-854f-49cde2c25320","uuid":"21c3cab1-d0bc-4d28-8d88-69899bfa1121"}
