ndleClickOutside);\n    40→  }, [openDropdown]);\n    41→\n    42→  if (selectedIds.length === 0) {\n    43→    return null;\n    44→  }\n    45→\n    46→  function toggleDropdown(type: DropdownType) {\n    47→    setOpenDropdown(openDropdown === type ? null : type);\n    48→  }\n    49→\n    50→  function handleStatusChange(status: string) {\n    51→    dispatch(bulkUpdateIssues({ issueIds: selectedIds, status, teamId }));\n    52→    setOpenDropdown(null);\n    53→  }\n    54→\n    55→  function handlePriorityChange(priority: string) {\n    56→    dispatch(bulkUpdateIssues({ issueIds: selectedIds, priority, teamId }));\n    57→    setOpenDropdown(null);\n    58→  }\n    59→\n    60→  function handleAssigneeChange(assigneeId: string | null) {\n    61→    dispatch(bulkUpdateIssues({ issueIds: selectedIds, assigneeId, teamId }));\n    62→    setOpenDropdown(null);\n    63→  }\n    64→\n    65→  function handleLabelChange(labelId: string) {\n    66→    dispatch(bulkUpdateIssues({ issueIds: selectedIds, labelId, teamId }));\n    67→    setOpenDropdown(null);\n    68→  }\n    69→\n    70→  return (\n    71→    <div className=\"bulk-actions\" ref={toolbarRef} data-testid=\"bulk-actions-toolbar\">\n    72→      <span className=\"bulk-actions-count\" data-testid=\"bulk-actions-count\">\n    73→        {selectedIds.length} selected\n    74→      </span>\n    75→\n    76→      <div className=\"bulk-actions-buttons\">\n    77→        <div className=\"bulk-actions-dropdown-wrapper\">\n    78→          <button\n    79→            className=\"bulk-actions-btn\"\n    80→            onClick={() => toggleDropdown('status')}\n    81→            data-testid=\"bulk-action-status\"\n    82→          >\n    83→            Status\n    84→          </button>\n    85→          {openDropdown === 'status' && (\n    86→            <div className=\"bulk-actions-dropdown\" data-testid=\"bulk-action-status-dropdown\">\n    87→              {STATUS_ORDER.map((s) => {\n    88→                const cfg = STATUS_CONFIG[s];\n    89→                return (\n    90→                  <button\n    91→                    key={s}\n    92→                    className=\"bulk-actions-option\"\n    93→                    onClick={() => handleStatusChange(s)}\n    94→                    data-testid={`bulk-status-option-${s}`}\n    95→                  >\n    96→                    <StatusIcon status={s} color={cfg.color} />\n    97→                    <span>{cfg.label}</span>\n    98→                  </button>\n    99→                );\n   100→              })}\n   101→            </div>\n   102→          )}\n   103→        </div>\n   104→\n   105→        <div className=\"bulk-actions-dropdown-wrapper\">\n   106→          <button\n   107→            className=\"bulk-actions-btn\"\n   108→            onClick={() => toggleDropdown('priority')}\n   109→            data-testid=\"bulk-action-priority\"\n   110→          >\n   111→            Priority\n   112→          </button>\n   113→          {openDropdown === 'priority' && (\n   114→            <div className=\"bulk-actions-dropdown\" data-testid=\"bulk-action-priority-dropdown\">\n   115→              {PRIORITY_ORDER.map((p) => (\n   116→                <button\n   117→                  key={p}\n   118→                  className=\"bulk-actions-option\"\n   119→                  onClick={() => handlePriorityChange(p)}\n   120→                  data-testid={`bulk-priority-option-${p}`}\n   121→                >\n   122→                  <PriorityIcon priority={p} />\n   123→                  <span>{PRIORITY_CONFIG_MAP[p].label}</span>\n   124→                </button>\n   125→              ))}\n   126→            </div>\n   127→          )}\n   128→        </div>\n   129→\n   130→        <div className=\"bulk-actions-dropdown-wrapper\">\n   131→          <button\n   132→            className=\"bulk-actions-btn\"\n   133→            onClick={() => toggleDropdown('assignee')}\n   134→            data-testid=\"bulk-action-assignee\"\n   135→          >\n   136→            Assignee\n   137→          </button>\n   138→          {openDropdown === 'assignee' && (\n   139→            <div className=\"bulk-actions-dropdown\" data-testid=\"bulk-action-assignee-dropdown\">\n   140→              <button\n   141→                className=\"bulk-actions-option\"\n   142→                onClick={() => handleAssigneeChange(null)}\n   143→                data-testid=\"bulk-assignee-option-unassigned\"\n   144→              >\n   145→                <span className=\"bulk-actions-avatar bulk-actions-avatar-empty\">?</span>\n   146→                <span>Unassigned</span>\n   147→              </button>\n   148→              {members.map((m) => (\n   149→                <button\n   150→                  key={m.id}\n   151→                  className=\"bulk-actions-option\"\n   152→                  onClick={() => handleAssigneeChange(m.id)}\n   153→                  data-testid={`bulk-assignee-option-${m.id}`}\n   154→                >\n   155→                  <span className=\"bulk-actions-avatar\">\n   156→                    {m.name.split(' ').map((n) => n[0]).join('').toUpperCase().slice(0, 2)}\n   157→                  </span>\n   158→                  <span>{m.name}</span>\n   159→                </button>\n   160→              ))}\n   161→            </div>\n   162→          )}\n   163→        </div>\n   164→\n   165→        <div className=\"bulk-actions-dropdown-wrapper\">\n   166→          <button\n   167→            className=\"bulk-actions-btn\"\n   168→            onClick={() => toggleDropdown('label')}\n   169→            data-testid=\"bulk-action-label\"\n   170→          >\n   171→            Label\n   172→          </button>\n   173→          {openDropdown === 'label' && (\n   174→            <div className=\"bulk-actions-dropdown\" data-testid=\"bulk-action-label-dropdown\">\n   175→              {labels.map((label) => (\n   176→                <button\n   177→                  key={label.id}\n   178→                  className=\"bulk-actions-option\"\n   179→                  onClick={() => handleLabelChange(label.id)}\n   180→                  data-testid={`bulk-label-option-${label.id}`}\n   181→                >\n   182→                  <span className=\"bulk-actions-label-dot\" style={{ backgroundColor: label.color }} />\n   183→                  <span>{label.name}</span>\n   184→                </button>\n   185→              ))}\n   186→              {labels.length === 0 && (\n   187→                <div className=\"bulk-actions-empty\">No labels available</div>\n   188→              )}\n   189→            </div>\n   190→          )}\n   191→        </div>\n   192→      </div>\n   193→\n   194→      <button\n   195→        className=\"bulk-actions-cancel\"\n   196→        onClick={() => dispatch(clearSelection())}\n   197→        data-testid=\"bulk-actions-cancel\"\n   198→      >\n   199→        Cancel\n   200→      </button>\n   201→    </div>\n   202→  );\n   203→}\n   204→"}]},"parent_tool_use_id":null,"session_id":"fb1ffc50-dd2f-4394-84c9-ce4b197eaf03","uuid":"8e18c9ed-567d-484d-bf1a-8887d84ea441","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/src/components/BulkActions.tsx","content":"import { useState, useRef, useEffect } from 'react';\nimport { useSelector, useDispatch } from 'react-redux';\nimport type { RootState, AppDispatch } from '../store';\nimport { bulkUpdateIssues, clearSelection } from '../slices/teamIssuesSlice';\nimport { STATUS_ORDER, STATUS_CONFIG, StatusIcon, PriorityIcon } from './IssueRow';\nimport './BulkActions.css';\n\nconst PRIORITY_ORDER = ['urgent', 'high', 'medium', 'low', 'none'] as const;\nconst PRIORITY_CONFIG_MAP: Record<string, { label: string }> = {\n  urgent: { label: 'Urgent' },\n  high: { label: 'High' },\n  medium: { label: 'Medium' },\n  low: { label: 'Low' },\n  none: { label: 'No Priority' },\n};\n\ntype DropdownType = 'status' | 'priority' | 'assignee' | 'label' | null;\n\ninterface BulkActionsProps {\n  teamId: string;\n}\n\nexport default function BulkActions({ teamId }: BulkActionsProps) {\n  const dispatch = useDispatch<AppDispatch>();\n  const { selectedIds, members } = useSelector((state: RootState) => state.teamIssues);\n  const { items: labels } = useSelector((state: RootState) => state.labels);\n  const [openDropdown, setOpenDropdown] = useState<DropdownType>(null);\n  const toolbarRef = useRef<HTMLDivElement>(null);\n\n  useEffect(() => {\n    function handleClickOutside(e: MouseEvent) {\n      if (toolbarRef.current && !toolbarRef.current.contains(e.target as Node)) {\n        setOpenDropdown(null);\n      }\n    }\n    if (openDropdown) {\n      document.addEventListener('mousedown', handleClickOutside);\n    }\n    return () => document.removeEventListener('mousedown', handleClickOutside);\n  }, [openDropdown]);\n\n  if (selectedIds.length === 0) {\n    return null;\n  }\n\n  function toggleDropdown(type: DropdownType) {\n    setOpenDropdown(openDropdown === type ? null : type);\n  }\n\n  function handleStatusChange(status: string) {\n    dispatch(bulkUpdateIssues({ issueIds: selectedIds, status, teamId }));\n    setOpenDropdown(null);\n  }\n\n  function handlePriorityChange(priority: string) {\n    dispatch(bulkUpdateIssues({ issueIds: selectedIds, priority, teamId }));\n    setOpenDropdown(null);\n  }\n\n  function handleAssigneeChange(assigneeId: string | null) {\n    dispatch(bulkUpdateIssues({ issueIds: selectedIds, assigneeId, teamId }));\n    setOpenDropdown(null);\n  }\n\n  function handleLabelChange(labelId: string) {\n    dispatch(bulkUpdateIssues({ issueIds: selectedIds, labelId, teamId }));\n    setOpenDropdown(null);\n  }\n\n  return (\n    <div className=\"bulk-actions\" ref={toolbarRef} data-testid=\"bulk-actions-toolbar\">\n      <span className=\"bulk-actions-count\" data-testid=\"bulk-actions-count\">\n        {selectedIds.length} selected\n      </span>\n\n      <div className=\"bulk-actions-buttons\">\n        <div className=\"bulk-actions-dropdown-wrapper\">\n          <button\n            className=\"bulk-actions-btn\"\n            onClick={() => toggleDropdown('status')}\n            data-testid=\"bulk-action-status\"\n          >\n            Status\n          </button>\n          {openDropdown === 'status' && (\n            <div className=\"bulk-actions-dropdown\" data-testid=\"bulk-action-status-dropdown\">\n              {STATUS_ORDER.map((s) => {\n                const cfg = STATUS_CONFIG[s];\n                return (\n                  <button\n                    key={s}\n                    className=\"bulk-actions-option\"\n                    onClick={() => handleStatusChange(s)}\n                    data-testid={`bulk-status-option-${s}`}\n                  >\n                    <StatusIcon status={s} color={cfg.color} />\n                    <span>{cfg.label}</span>\n                  </button>\n                );\n              })}\n            </div>\n          )}\n        </div>\n\n        <div className=\"bulk-actions-dropdown-wrapper\">\n          <button\n            className=\"bulk-actions-btn\"\n            onClick={() => toggleDropdown('priority')}\n            data-testid=\"bulk-action-priority\"\n          >\n            Priority\n          </button>\n          {openDropdown === 'priority' && (\n            <div className=\"bulk-actions-dropdown\" data-testid=\"bulk-action-priority-dropdown\">\n              {PRIORITY_ORDER.map((p) => (\n                <button\n                  key={p}\n                  className=\"bulk-actions-option\"\n                  onClick={() => handlePriorityChange(p)}\n                  data-testid={`bulk-priority-option-${p}`}\n                >\n                  <PriorityIcon priority={p} />\n                  <span>{PRIORITY_CONFIG_MAP[p].label}</span>\n                </button>\n              ))}\n            </div>\n          )}\n        </div>\n\n        <div className=\"bulk-actions-dropdown-wrapper\">\n          <button\n            className=\"bulk-actions-btn\"\n            onClick={() => toggleDropdown('assignee')}\n            data-testid=\"bulk-action-assignee\"\n          >\n            Assignee\n          </button>\n          {openDropdown === 'assignee' && (\n            <div className=\"bulk-actions-dropdown\" data-testid=\"bulk-action-assignee-dropdown\">\n              <button\n                className=\"bulk-actions-option\"\n                onClick={() => handleAssigneeChange(null)}\n                data-testid=\"bulk-assignee-option-unassigned\"\n              >\n                <span className=\"bulk-actions-avatar bulk-actions-avatar-empty\">?</span>\n                <span>Unassigned</span>\n              </button>\n              {members.map((m) => (\n                <button\n                  key={m.id}\n                  className=\"bulk-actions-option\"\n                  onClick={() => handleAssigneeChange(m.id)}\n                  data-testid={`bulk-assignee-option-${m.id}`}\n                >\n                  <span className=\"bulk-actions-avatar\">\n                    {m.name.split(' ').map((n) => n[0]).join('').toUpperCase().slice(0, 2)}\n                  </span>\n                  <span>{m.name}</span>\n                </button>\n              ))}\n            </div>\n          )}\n        </div>\n\n        <div className=\"bulk-actions-dropdown-wrapper\">\n          <button\n            className=\"bulk-actions-btn\"\n            onClick={() => toggleDropdown('label')}\n            data-testid=\"bulk-action-label\"\n          >\n            Label\n          </button>\n          {openDropdown === 'label' && (\n            <div className=\"bulk-actions-dropdown\" data-testid=\"bulk-action-label-dropdown\">\n              {labels.map((label) => (\n                <button\n                  key={label.id}\n                  className=\"bulk-actions-option\"\n                  onClick={() => handleLabelChange(label.id)}\n                  data-testid={`bulk-label-option-${label.id}`}\n                >\n                  <span className=\"bulk-actions-label-dot\" style={{ backgroundColor: label.color }} />\n                  <span>{label.name}</span>\n                </button>\n              ))}\n              {labels.length === 0 && (\n                <div className=\"bulk-actions-empty\">No labels available</div>\n              )}\n            </div>\n          )}\n        </div>\n      </div>\n\n      <button\n        className=\"bulk-actions-cancel\"\n        onClick={() => dispatch(clearSelection())}\n        data-testid=\"bulk-actions-cancel\"\n      >\n        Cancel\n      </button>\n    </div>\n  );\n}\n","numLines":204,"startLine":1,"totalLines":204}}}
