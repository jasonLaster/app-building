[2026-03-14T19:27:57.412Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MxhEKM5DVdDduBAdhzCtjK","type":"tool_result","content":"     1→import { createSlice, createAsyncThunk } from '@reduxjs/toolkit';\n     2→\n     3→export interface IssueLabel {\n     4→  id: string;\n     5→  name: string;\n     6→  color: string;\n     7→}\n     8→\n     9→export interface Issue {\n    10→  id: string;\n    11→  title: string;\n    12→  description: string;\n    13→  status: string;\n    14→  priority: string;\n    15→  identifier: string;\n    16→  number: number;\n    17→  dueDate: string | null;\n    18→  createdAt: string;\n    19→  updatedAt: string;\n    20→  teamId: string;\n    21→  teamName: string;\n    22→  assigneeId: string | null;\n    23→  assigneeName: string | null;\n    24→  assigneeEmail: string | null;\n    25→  projectId: string | null;\n    26→  projectName: string | null;\n    27→  cycleId: string | null;\n    28→  parentId: string | null;\n    29→  labels: IssueLabel[];\n    30→}\n    31→\n    32→interface IssuesState {\n    33→  myIssues: Issue[];\n    34→  loading: boolean;\n    35→  error: string | null;\n    36→}\n    37→\n    38→const initialState: IssuesState = {\n    39→  myIssues: [],\n    40→  loading: false,\n    41→  error: null,\n    42→};\n    43→\n    44→export const fetchMyIssues = createAsyncThunk(\n    45→  'issues/fetchMyIssues',\n    46→  async (_, { getState, rejectWithValue }) => {\n    47→    const state = getState() as { auth: { token: string | null } };\n    48→    const token = state.auth.token;\n    49→    if (!token) return rejectWithValue('No token');\n    50→    const response = await fetch('/api/my-issues', {\n    51→      headers: { Authorization: `Bearer ${token}` },\n    52→    });\n    53→    if (!response.ok) {\n    54→      return rejectWithValue('Failed to fetch issues');\n    55→    }\n    56→    const data = await response.json();\n    57→    return data.issues as Issue[];\n    58→  }\n    59→);\n    60→\n    61→export const updateIssueStatus = createAsyncThunk(\n    62→  'issues/updateIssueStatus',\n    63→  async ({ issueId, status }: { issueId: string; status: string }, { getState, rejectWithValue }) => {\n    64→    const state = getState() as { auth: { token: string | null } };\n    65→    const token = state.auth.token;\n    66→    if (!token) return rejectWithValue('No token');\n    67→    const response = await fetch('/api/update-issue-status', {\n    68→      method: 'PUT',\n    69→      headers: {\n    70→        'Content-Type': 'application/json',\n    71→        Authorization: `Bearer ${token}`,\n    72→      },\n    73→      body: JSON.stringify({ issueId, status }),\n    74→    });\n    75→    if (!response.ok) {\n    76→      return rejectWithValue('Failed to update status');\n    77→    }\n    78→    const data = await response.json();\n    79→    return { issueId, status: data.issue.status as string };\n    80→  }\n    81→);\n    82→\n    83→const issuesSlice = createSlice({\n    84→  name: 'issues',\n    85→  initialState,\n    86→  reducers: {},\n    87→  extraReducers: (builder) => {\n    88→    builder\n    89→      .addCase(fetchMyIssues.pending, (state) => {\n    90→        if (state.myIssues.length === 0) {\n    91→          state.loading = true;\n    92→        }\n    93→        state.error = null;\n    94→      })\n    95→      .addCase(fetchMyIssues.fulfilled, (state, action) => {\n    96→        state.loading = false;\n    97→        state.myIssues = action.payload;\n    98→      })\n    99→      .addCase(fetchMyIssues.rejected, (state, action) => {\n   100→        state.loading = false;\n   101→        state.error = action.payload as string;\n   102→      })\n   103→      .addCase(updateIssueStatus.fulfilled, (state, action) => {\n   104→        const { issueId, status } = action.payload;\n   105→        const issue = state.myIssues.find((i) => i.id === issueId);\n   106→        if (issue) {\n   107→          issue.status = status;\n   108→        }\n   109→      });\n   110→  },\n   111→});\n   112→\n   113→export default issuesSlice.reducer;\n   114→"}]},"parent_tool_use_id":"toolu_016e1ckREppSeN1K5Dw6jKKC","session_id":"fb1ffc50-dd2f-4394-84c9-ce4b197eaf03","uuid":"b34bbe59-47fd-4cde-92a2-d04f3ddad7ef"}
