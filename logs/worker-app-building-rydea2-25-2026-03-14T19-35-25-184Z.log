rClone/src/pages/SignUp.tsx\n/repo/apps/LinearClone/src/pages/TeamIssues.css\n/repo/apps/LinearClone/src/pages/TeamIssues.tsx\n/repo/apps/LinearClone/src/slices/authSlice.ts\n/repo/apps/LinearClone/src/slices/issuesSlice.ts\n/repo/apps/LinearClone/src/slices/labelsSlice.ts\n/repo/apps/LinearClone/src/slices/notificationsSlice.ts\n/repo/apps/LinearClone/src/slices/teamIssuesSlice.ts\n/repo/apps/LinearClone/src/slices/teamsSlice.ts\n/repo/apps/LinearClone/src/slices/uiSlice.ts\n/repo/apps/LinearClone/src/slices/workspaceSlice.ts\n/repo/apps/LinearClone/src/store.ts","is_error":false}]},"parent_tool_use_id":"toolu_016e1ckREppSeN1K5Dw6jKKC","session_id":"fb1ffc50-dd2f-4394-84c9-ce4b197eaf03","uuid":"ad8c41c3-e47e-4725-941b-a4b4894bc9df"}
