 state.loading = false;\n    55→        state.error = action.payload as string;\n    56→      });\n    57→  },\n    58→});\n    59→\n    60→export default workspaceSlice.reducer;\n    61→"}]},"parent_tool_use_id":"toolu_016e1ckREppSeN1K5Dw6jKKC","session_id":"fb1ffc50-dd2f-4394-84c9-ce4b197eaf03","uuid":"2eb7d0b2-2944-4e42-b78c-d4923b0e8f2c"}
