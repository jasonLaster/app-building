[2026-03-14T19:28:16.747Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Lh4aN1mNBCzqxmthznd8Gk","type":"tool_result","content":"     1→import { createServer, IncomingMessage, ServerResponse } from \"http\";\n     2→import { resolve } from \"path\";\n     3→import { cloneRepo, checkoutTargetBranch, commitAndPushTarget, getRevision, toTokenUrl } from \"./git\";\n     4→import {\n     5→  processTask,\n     6→  getNextTask,\n     7→  currentAgentProcess,\n     8→  getPendingTaskCount,\n     9→  absorbForeignTaskFiles,\n    10→  addPromptTask,\n    11→  requestInterrupt,\n    12→  type EventCallback,\n    13→  type CommandSpec,\n    14→} from \"./worker\";\n    15→import { createBufferedLogger, archiveCurrentLog, redactSecrets } from \"./log\";\n    16→import { formatLogLine, stripTimestamp } from \"./format\";\n    17→\n    18→// --- Configuration from env ---\n    19→\n    20→const PORT = parseInt(process.env.PORT ?? \"3000\", 10);\n    21→const REPO_URL = process.env.REPO_URL ?? \"\";\n    22→const CLONE_BRANCH = process.env.CLONE_BRANCH ?? \"main\";\n    23→const PUSH_BRANCH = process.env.PUSH_BRANCH ?? CLONE_BRANCH;\n    24→const CONTAINER_NAME = process.env.CONTAINER_NAME ?? \"agent\";\n    25→const WEBHOOK_URL = process.env.WEBHOOK_URL ?? \"\";\n    26→const WEBHOOK_SECRET = process.env.WEBHOOK_SECRET ?? \"\";\n    27→const INITIAL_PROMPT = process.env.INITIAL_PROMPT ?? \"\";\n    28→const REPO_DIR = \"/repo\";\n    29→const LOGS_DIR = resolve(REPO_DIR, \"logs\");\n    30→\n    31→// Set CONTAINER_MODE so log.ts loads secrets from env vars\n    32→process.env.CONTAINER_MODE = \"1\";\n    33→\n    34→// --- OffsetBuffer ---\n    35→\n    36→class OffsetBuffer<T> {\n    37→  private items: T[] = [];\n    38→\n    39→  append(item: T): void {\n    40→    this.items.push(item);\n    41→  }\n    42→\n    43→  since(offset: number): { items: T[]; nextOffset: number } {\n    44→    const start = Math.max(0, Math.min(offset, this.items.length));\n    45→    return {\n    46→      items: this.items.slice(start),\n    47→      nextOffset: this.items.length,\n    48→    };\n    49→  }\n    50→\n    51→  get length(): number {\n    52→    return this.items.length;\n    53→  }\n    54→}\n    55→\n    56→// --- State ---\n    57→\n    58→const eventBuffer = new OffsetBuffer<string>();\n    59→const logBuffer = new OffsetBuffer<string>();\n    60→\n    61→let totalCost = 0;\n    62→let iteration = 0;\n    63→let tasksProcessed = 0;\n    64→let lastActivityAt = new Date().toISOString();\n    65→\n    66→// --- Container state ---\n    67→\n    68→type ContainerState = \"starting\" | \"idle\" | \"processing\" | \"stopping\" | \"stopped\";\n    69→let state: ContainerState = \"starting\";\n    70→let detachRequested = process.env.DETACHED === \"1\";\n    71→let stopRequested = false;\n    72→// Wake signal for processing loop\n    73→let wakeResolve: (() => void) | null = null;\n    74→\n    75→function wake(): void {\n    76→  if (wakeResolve) {\n    77→    wakeResolve();\n    78→    wakeResolve = null;\n    79→  }\n    80→}\n    81→\n    82→function waitForWake(): Promise<void> {\n    83→  return new Promise((resolve) => {\n    84→    wakeResolve = resolve;\n    85→  });\n    86→}\n    87→\n    88→// --- Webhook ---\n    89→\n    90→function postWebhook(type: string, data?: Record<string, unknown>): void {\n    91→  if (!WEBHOOK_URL) return;\n    92→  const payload = JSON.stringify({\n    93→    type,\n    94→    containerName: CONTAINER_NAME,\n    95→    timestamp: new Date().toISOString(),\n    96→    ...(data !== undefined ? { data } : {}),\n    97→  });\n    98→  const headers: Record<string, string> = { \"Content-Type\": \"application/json\" };\n    99→  if (WEBHOOK_SECRET) headers[\"Authorization\"] = `Bearer ${WEBHOOK_SECRET}`;\n   100→  fetch(WEBHOOK_URL, {\n   101→    method: \"POST\",\n   102→    headers,\n   103→    body: payload,\n   104→  }).then((res) => {\n   105→    if (!res.ok) {\n   106→      console.error(`Webhook ${type} failed: ${res.status} ${res.statusText}`);\n   107→    }\n   108→  }).catch((err) => {\n   109→    console.error(`Webhook ${type} error: ${err.message}`);\n   110→  });\n   111→}\n   112→\n   113→// --- Default agent config ---\n   114→\n   115→function buildDefaultAgent(): CommandSpec {\n   116→  const args: string[] = [];\n   117→  args.push(\"--model\", \"claude-opus-4-6\");\n   118→  args.push(\"--dangerously-skip-permissions\");\n   119→\n   120→  // MCP servers\n   121→  const mcpServers: Record<string, object> = {\n   122→    playwright: { type: \"http\", url: \"http://localhost:8931/mcp\" },\n   123→  };\n   124→  const replayKey = process.env.RECORD_REPLAY_API_KEY;\n   125→  if (replayKey) {\n   126→    mcpServers.replay = { type: \"http\", url: \"https://dispatch.replay.io/nut/mcp\" };\n   127→  }\n   128→  args.push(\"--mcp-config\", JSON.stringify({ mcpServers }));\n   129→\n   130→  return { bin: \"claude\", args };\n   131→}\n   132→\n   133→// --- Logger (initialized after clone) ---\n   134→\n   135→let log: ReturnType<typeof createBufferedLogger>;\n   136→\n   137→const onEvent: EventCallback = (rawLine) => {\n   138→  eventBuffer.append(redactSecrets(rawLine));\n   139→  lastActivityAt = new Date().toISOString();\n   140→};\n   141→\n   142→// --- HTTP helpers ---\n   143→\n   144→function readBody(req: IncomingMessage): Promise<string> {\n   145→  return new Promise((resolve, reject) => {\n   146→    const chunks: Buffer[] = [];\n   147→    req.on(\"data\", (chunk: Buffer) => chunks.push(chunk));\n   148→    req.on(\"end\", () => resolve(Buffer.concat(chunks).toString()));\n   149→    req.on(\"error\", reject);\n   150→  });\n   151→}\n   152→\n   153→function json(res: ServerResponse, status: number, body: unknown): void {\n   154→  const data = JSON.stringify(body);\n   155→  res.writeHead(status, {\n   156→    \"Content-Type\": \"application/json\",\n   157→    \"Cache-Control\": \"no-store\",\n   158→  });\n   159→  res.end(data);\n   160→}\n   161→\n   162→function getQuery(url: string, key: string): string | null {\n   163→  const qIdx = url.indexOf(\"?\");\n   164→  if (qIdx === -1) return null;\n   165→  const params = new URLSearchParams(url.slice(qIdx));\n   166→  return params.get(key);\n   167→}\n   168→\n   169→// --- Processing loop ---\n   170→//\n   171→// The container runs a single loop that processes tasks from the persistent\n   172→// task queue file. All work — including incoming messages and INITIAL_PROMPT —\n   173→// is converted to tasks before processing. This means:\n   174→//\n   175→// - On restart after a crash, the worker picks up remaining tasks from the\n   176→//   last committed task file without re-processing completed work.\n   177→// - The loop has a single code path for all work items.\n   178→//\n   179→// Shutdown is controlled by two mechanisms:\n   180→//\n   181→// 1. **Detach** (POST /detach): Sets `detachRequested`. The container continues\n   182→//    processing any in-flight or queued tasks, then exits once the task queue\n   183→//    is empty. This is the normal shutdown path.\n   184→//\n   185→// 2. **Stop** (POST /stop): Sets `stopRequested`. The container breaks out of\n   186→//    the loop immediately (interrupting any running agent process), commits\n   187→//    any remaining work, and exits. This is the forced shutdown path.\n   188→\n   189→async function processLoop(): Promise<void> {\n   190→  const defaultAgent = buildDefaultAgent();\n   191→  // Track session ID across prompt tasks so interactive messages share context\n   192→  let promptSessionId: string | undefined;\n   193→\n   194→  while (true) {\n   195→    if (stopRequested) {\n   196→      log(\"Stop requested. Exiting loop.\");\n   197→      break;\n   198→    }\n   199→\n   200→    // Process pending tasks\n   201→    const task = getNextTask(log);\n   202→    if (task) {\n   203→      state = \"processing\";\n   204→      postWebhook(\"task.started\", { iteration, skill: task.skill, subtasks: task.subtasks, prompt: task.prompt ?? null });\n   205→      const taskStartedAt = Date.now();\n   206→      const result = await processTask(\n   207→        task,\n   208→        defaultAgent,\n   209→        log,\n   210→        onEvent,\n   211→        () => stopRequested,\n   212→        (label) => {\n   213→          if (!stopRequested) {\n   214→            iteration++;\n   215→            lastActivityAt = new Date().toISOString();\n   216→            archiveCurrentLog(LOGS_DIR, CONTAINER_NAME, iteration);\n   217→            commitAndPushTarget(label, PUSH_BRANCH, log, () => stopRequested, REPO_DIR);\n   218→          }\n   219→        },\n   220→        PUSH_BRANCH,\n   221→        task.prompt ? promptSessionId : undefined,\n   222→      );\n   223→      if (task.prompt && result.session_id) {\n   224→        promptSessionId = result.session_id;\n   225→      }\n   226→      totalCost += result.cost;\n   227→      tasksProcessed++;\n   228→      postWebhook(\"task.done\", { skill: task.skill, subtasks: task.subtasks, prompt: task.prompt ?? null, cost: result.cost, totalCost, failed: !result.success, pendingTasks: getPendingTaskCount(), duration_ms: Date.now() - taskStartedAt });\n   229→      if (!result.success) {\n   230→        log(`Task failed. Stopping task processing. ${getPendingTaskCount()} task(s) remain in queue.`);\n   231→        detachRequested = true;\n   232→      }\n   233→      continue;\n   234→    }\n   235→\n   236→    // Detach: exit immediately when task queue is empty\n   237→    if (detachRequested) {\n   238→      log(\"Detach requested and all work complete. Exiting.\");\n   239→      break;\n   240→    }\n   241→\n   242→    // Wait for something to happen\n   243→    log(`Idle. ${getPendingTaskCount()} tasks pending. Waiting...`);\n   244→    state = \"idle\";\n   245→    postWebhook(\"container.idle\", { pendingTasks: getPendingTaskCount() });\n   246→    await waitForWake();\n   247→  }\n   248→\n   249→  // Only reachable via stopRequested or detach — commit remaining work and exit\n   250→  log(\"Shutting down.\");\n   251→  postWebhook(\"container.stopping\", {});\n   252→\n   253→  try {\n   254→    iteration++;\n   255→    archiveCurrentLog(LOGS_DIR, CONTAINER_NAME, iteration);\n   256→    commitAndPushTarget(`Final work from ${CONTAINER_NAME}`, PUSH_BRANCH, log, () => true, REPO_DIR);\n   257→  } catch (e: any) {\n   258→    log(`Warning: failed to push final work: ${e.message}`);\n   259→  }\n   260→\n   261→  postWebhook(\"container.stopped\", {});\n   262→\n   263→  setTimeout(() => process.exit(0), 5000);\n   264→}\n   265→\n   266→// --- HTTP server ---\n   267→\n   268→const server = createServer(async (req, res) => {\n   269→  const url = req.url ?? \"/\";\n   270→  const method = req.method ?? \"GET\";\n   271→\n   272→  try {\n   273→    // POST /message — add prompt as a task\n   274→    if (method === \"POST\" && url === \"/message\") {\n   275→      const body = JSON.parse(await readBody(req));\n   276→      const prompt = body.prompt;\n   277→      if (!prompt || typeof prompt !== \"string\") {\n   278→        json(res, 400, { error: \"prompt is required\" });\n   279→        return;\n   280→      }\n   281→      addPromptTask(prompt);\n   282→      log(`Message received (state=${state}, pendingTasks=${getPendingTaskCount()})`);\n   283→      postWebhook(\"message.queued\", { prompt });\n   284→      wake();\n   285→      json(res, 200, { ok: true });\n   286→      return;\n   287→    }\n   288→\n   289→    // GET /events?offset=N\n   290→    if (method === \"GET\" && url.startsWith(\"/events\")) {\n   291→      const offset = parseInt(getQuery(url, \"offset\") ?? \"0\", 10);\n   292→      const result = eventBuffer.since(offset);\n   293→      json(res, 200, { items: result.items, nextOffset: result.nextOffset });\n   294→      return;\n   295→    }\n   296→\n   297→    // GET /logs?offset=N\n   298→    if (method === \"GET\" && url.startsWith(\"/logs\")) {\n   299→      const offset = parseInt(getQuery(url, \"offset\") ?? \"0\", 10);\n   300→      const result = logBuffer.since(offset);\n   301→      json(res, 200, { items: result.items, nextOffset: result.nextOffset });\n   302→      return;\n   303→    }\n   304→\n   305→    // POST /interrupt\n   306→    if (method === \"POST\" && url === \"/interrupt\") {\n   307→      log(`Interrupt received (state=${state}, hasProcess=${!!currentAgentProcess})`);\n   308→      const hadProcess = !!currentAgentProcess;\n   309→      requestInterrupt(log);\n   310→      json(res, 200, { interrupted: hadProcess });\n   311→      return;\n   312→    }\n   313→\n   314→    // POST /detach\n   315→    if (method === \"POST\" && url === \"/detach\") {\n   316→      detachRequested = true;\n   317→      wake();\n   318→      json(res, 200, { detaching: true });\n   319→      return;\n   320→    }\n   321→\n   322→    // POST /stop\n   323→    if (method === \"POST\" && url === \"/stop\") {\n   324→      stopRequested = true;\n   325→      // Kill any running agent process\n   326→      if (currentAgentProcess) {\n   327→        currentAgentProcess.kill(\"SIGINT\");\n   328→      }\n   329→      wake();\n   330→      json(res, 200, { stopping: true });\n   331→      return;\n   332→    }\n   333→\n   334→    // GET /status\n   335→    if (method === \"GET\" && url === \"/status\") {\n   336→      json(res, 200, {\n   337→        state,\n   338→        containerName: CONTAINER_NAME,\n   339→        pushBranch: PUSH_BRANCH,\n   340→        pendingTasks: getPendingTaskCount(),\n   341→        tasksProcessed,\n   342→        totalCost,\n   343→        iteration,\n   344→        detachRequested,\n   345→        revision: getRevision(REPO_DIR),\n   346→        lastActivityAt,\n   347→      });\n   348→      return;\n   349→    }\n   350→\n   351→    json(res, 404, { error: \"not found\" });\n   352→  } catch (e: any) {\n   353→    json(res, 500, { error: e.message });\n   354→  }\n   355→});\n   356→\n   357→// --- Startup ---\n   358→\n   359→/** Log to both console and the HTTP log buffer (if available). */\n   360→function startupLog(msg: string): void {\n   361→  const line = `[${new Date().toISOString()}] ${msg}`;\n   362→  console.log(line);\n   363→  logBuffer.append(line);\n   364→}\n   365→\n   366→async function main(): Promise<void> {\n   367→  startupLog(`=== Container starting ===`);\n   368→  startupLog(`Container: ${CONTAINER_NAME}`);\n   369→  startupLog(`Clone branch: ${CLONE_BRANCH}, Push branch: ${PUSH_BRANCH}`);\n   370→  startupLog(`Repo URL: ${REPO_URL || \"(not set)\"}`);\n   371→\n   372→  // Clone repo\n   373→  if (!REPO_URL) {\n   374→    startupLog(\"Fatal: REPO_URL environment variable is required\");\n   375→    process.exit(1);\n   376→  }\n   377→\n   378→  const cloneUrl = toTokenUrl(REPO_URL, process.env.GITHUB_TOKEN);\n   379→  startupLog(`Cloning repo...`);\n   380→  try {\n   381→    cloneRepo(cloneUrl, CLONE_BRANCH, REPO_DIR);\n   382→    startupLog(\"Clone complete.\");\n   383→  } catch (e: any) {\n   384→    startupLog(`Fatal: clone failed: ${e.message}`);\n   385→    process.exit(1);\n   386→  }\n   387→\n   388→  // Now that /repo exists, initialize the logger\n   389→  log = createBufferedLogger(LOGS_DIR, CONTAINER_NAME, iteration, (line) => {\n   390→    logBuffer.append(line);\n   391→    // Format log lines for webhook using the same logic as read-log\n   392→    const formatted = formatLogLine(stripTimestamp(line));\n   393→    if (formatted) {\n   394→      postWebhook(\"log\", { line: formatted });\n   395→    }\n   396→  });\n   397→\n   398→  // Checkout target branch if different from clone branch\n   399→  if (PUSH_BRANCH !== CLONE_BRANCH) {\n   400→    log(`Checking out target branch ${PUSH_BRANCH}...`);\n   401→    checkoutTargetBranch(PUSH_BRANCH, log, REPO_DIR);\n   402→  }\n   403→\n   404→  log(`Revision: ${getRevision(REPO_DIR)}`);\n   405→  log(`Push branch: ${PUSH_BRANCH}`);\n   406→\n   407→  // Absorb task files from other containers before checking task count\n   408→  absorbForeignTaskFiles(log);\n   409→\n   410→  // Add INITIAL_PROMPT as a task only if there are no existing tasks.\n   411→  // On restart after a crash, the cloned repo will have the last-pushed task\n   412→  // file with remaining tasks, so INITIAL_PROMPT won't be re-added.\n   413→  if (INITIAL_PROMPT && getPendingTaskCount() === 0) {\n   414→    log(\"Adding initial prompt as task.\");\n   415→    addPromptTask(INITIAL_PROMPT);\n   416→  }\n   417→\n   418→  log(`Pending tasks: ${getPendingTaskCount()}`);\n   419→\n   420→  // Change working directory to repo\n   421→  process.chdir(REPO_DIR);\n   422→\n   423→  // Start HTTP server\n   424→  server.listen(PORT, () => {\n   425→    log(`HTTP server listening on port ${PORT}`);\n   426→    state = \"idle\";\n   427→    postWebhook(\"container.started\", { pushBranch: PUSH_BRANCH, revision: getRevision(REPO_DIR) });\n   428→    postWebhook(\"container.idle\", { pendingTasks: getPendingTaskCount() });\n   429→  });\n   430→\n   431→  // Start processing loop\n   432→  processLoop();\n   433→}\n   434→\n   435→main().catch((e) => {\n   436→  console.error(e);\n   437→  process.exit(1);\n   438→});\n   439→"}]},"parent_tool_use_id":"toolu_016e1ckREppSeN1K5Dw6jKKC","session_id":"fb1ffc50-dd2f-4394-84c9-ce4b197eaf03","uuid":"033169d9-74e0-4b84-b7ad-b235028db430"}
