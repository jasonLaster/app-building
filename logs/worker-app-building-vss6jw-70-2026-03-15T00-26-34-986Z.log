it should be up when `beforeEach` runs.\n\nLet me now run the tests to see if the fix works."}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1113,"cache_read_input_tokens":70809,"cache_creation":{"ephemeral_5m_input_tokens":1113,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"global"},"context_management":null},"parent_tool_use_id":null,"session_id":"99c20f83-7864-4a55-a0d6-29119d896fad","uuid":"791a3984-37a5-410e-8ab2-1edaf5110893"}
