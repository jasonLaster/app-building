ore re-seeding in each `beforeEach`, or switch to `beforeAll` to seed just once. Let me check what cleanup endpoints are available in the properties API.","signature":""}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":11676,"cache_read_input_tokens":51750,"cache_creation":{"ephemeral_5m_input_tokens":11676,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"global"},"context_management":null},"parent_tool_use_id":null,"session_id":"99c20f83-7864-4a55-a0d6-29119d896fad","uuid":"fcf15322-68e4-42fd-82c7-4a9ef6618606"}
