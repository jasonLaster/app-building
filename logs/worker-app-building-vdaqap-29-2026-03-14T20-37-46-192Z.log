-color-text-secondary);\n}\n\n.tracked-route-card__price {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-end;\n  gap: 2px;\n}\n\n.tracked-route-card__price-label {\n  font-size: 11px;\n  color: var(--color-text-tertiary);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.tracked-route-card__price-value {\n  font-size: 20px;\n  font-weight: 600;\n  color: var(--color-success);\n}\n\n.tracked-route-card__actions {\n  display: flex;\n  gap: 12px;\n}\n\n.tracked-route-card__search-btn {\n  flex: 1;\n  padding: 8px 16px;\n  font-size: 13px;\n  font-weight: 500;\n  color: var(--color-surface);\n  background: var(--color-primary);\n  border: none;\n  border-radius: var(--radius-sm);\n  cursor: pointer;\n  transition: background 0.2s;\n}\n\n.tracked-route-card__search-btn:hover {\n  background: var(--color-primary-hover);\n}\n\n.tracked-route-card__untrack-btn {\n  flex: 1;\n  padding: 8px 16px;\n  font-size: 13px;\n  font-weight: 500;\n  color: var(--color-text-secondary);\n  background: transparent;\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-sm);\n  cursor: pointer;\n  transition: background 0.2s, color 0.2s;\n}\n\n.tracked-route-card__untrack-btn:hover {\n  background: var(--color-background);\n  color: var(--color-text-primary);\n}\n\n.tracked-route-card__untrack-btn:disabled {\n  opacity: 0.6;\n  cursor: not-allowed;\n}\n","structuredPatch":[{"oldStart":113,"oldLines":3,"newStart":113,"newLines":18,"lines":["   opacity: 0.6;","   cursor: not-allowed;"," }","+","+.tracked-route-card__trend {","+  display: inline-block;","+  margin-left: 8px;","+  font-size: 13px;","+  font-weight: 500;","+}","+","+.tracked-route-card__trend--up {","+  color: var(--color-error, #d32f2f);","+}","+","+.tracked-route-card__trend--down {","+  color: var(--color-success, #2e7d32);","+}"]}],"userModified":false,"replaceAll":false}}
