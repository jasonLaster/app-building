[2026-03-14T20:31:11.968Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AnHbitAzbdmDFv5TwN7iVp","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test'\n     2→\n     3→/**\n     4→ * Helper to build a results page URL with search parameters.\n     5→ */\n     6→function buildResultsUrl(params?: {\n     7→  origin?: string\n     8→  destination?: string\n     9→  departureDate?: string\n    10→  returnDate?: string\n    11→  tripType?: string\n    12→  cabinClass?: string\n    13→  adults?: number\n    14→}): string {\n    15→  const nextMonth = new Date()\n    16→  nextMonth.setMonth(nextMonth.getMonth() + 1)\n    17→  const year = nextMonth.getFullYear()\n    18→  const month = String(nextMonth.getMonth() + 1).padStart(2, '0')\n    19→  const defaultDeparture = `${year}-${month}-25`\n    20→  const defaultReturn = `${year}-${month}-30`\n    21→\n    22→  const sp = new URLSearchParams({\n    23→    origin: params?.origin ?? 'LAX',\n    24→    destination: params?.destination ?? 'JFK',\n    25→    departureDate: params?.departureDate ?? defaultDeparture,\n    26→    tripType: params?.tripType ?? 'round_trip',\n    27→    cabinClass: params?.cabinClass ?? 'economy',\n    28→    adults: String(params?.adults ?? 1),\n    29→    children: '0',\n    30→    infants: '0',\n    31→  })\n    32→  if (params?.returnDate !== undefined) {\n    33→    sp.set('returnDate', params.returnDate)\n    34→  } else {\n    35→    sp.set('returnDate', defaultReturn)\n    36→  }\n    37→  return `/results?${sp.toString()}`\n    38→}\n    39→\n    40→/**\n    41→ * Helper to delete all tracked routes via API for a given session token.\n    42→ */\n    43→async function deleteAllTrackedRoutes(page: import('@playwright/test').Page, sessionToken: string) {\n    44→  const res = await page.request.get(`/api/tracked-routes?session=${sessionToken}&list=true`)\n    45→  if (res.ok()) {\n    46→    const data = await res.json() as { routes?: { id: string; origin_code: string; dest_code: string }[] }\n    47→    if (data.routes) {\n    48→      for (const route of data.routes) {\n    49→        await page.request.delete('/api/tracked-routes', {\n    50→          data: {\n    51→            sessionToken,\n    52→            originCode: route.origin_code,\n    53→            destCode: route.dest_code,\n    54→          },\n    55→        })\n    56→      }\n    57→    }\n    58→  }\n    59→}\n    60→\n    61→test.describe('TrackPricesToggle', () => {\n    62→  let sessionToken: string\n    63→\n    64→  test.beforeEach(async ({ page }) => {\n    65→    // Navigate to results page\n    66→    await page.goto(buildResultsUrl())\n    67→    await expect(page.getByTestId('search-results-page')).toBeVisible({ timeout: 15000 })\n    68→\n    69→    // Get session token from localStorage\n    70→    sessionToken = await page.evaluate(() => {\n    71→      return localStorage.getItem('session_token') || ''\n    72→    })\n    73→\n    74→    // Clean up tracked routes for this session\n    75→    if (sessionToken) {\n    76→      await deleteAllTrackedRoutes(page, sessionToken)\n    77→      // Reload to reflect clean state\n    78→      await page.reload()\n    79→      await expect(page.getByTestId('search-results-page')).toBeVisible({ timeout: 15000 })\n    80→    }\n    81→  })\n    82→\n    83→  test('TrackPricesToggle is displayed on results page', async ({ page }) => {\n    84→    // Verify toggle is visible\n    85→    const toggle = page.getByTestId('track-prices-toggle')\n    86→    await expect(toggle).toBeVisible({ timeout: 10000 })\n    87→\n    88→    // Verify it's in the off/untracked state\n    89→    const button = page.getByTestId('track-prices-button')\n    90→    await expect(button).toBeVisible()\n    91→    const label = page.getByTestId('track-prices-label')\n    92→    await expect(label).toHaveText('Track prices')\n    93→  })\n    94→\n    95→  test('TrackPricesToggle enables price tracking', async ({ page }) => {\n    96→    const button = page.getByTestId('track-prices-button')\n    97→    const label = page.getByTestId('track-prices-label')\n    98→\n    99→    // Verify initially off\n   100→    await expect(label).toHaveText('Track prices', { timeout: 10000 })\n   101→\n   102→    // Click to enable tracking\n   103→    await button.click()\n   104→\n   105→    // Should switch to tracked state\n   106→    await expect(label).toHaveText('Tracking prices', { timeout: 10000 })\n   107→  })\n   108→\n   109→  test('TrackPricesToggle disables price tracking', async ({ page }) => {\n   110→    const button = page.getByTestId('track-prices-button')\n   111→    const label = page.getByTestId('track-prices-label')\n   112→\n   113→    // First enable tracking\n   114→    await expect(label).toHaveText('Track prices', { timeout: 10000 })\n   115→    await button.click()\n   116→    await expect(label).toHaveText('Tracking prices', { timeout: 10000 })\n   117→\n   118→    // Now disable tracking\n   119→    await button.click()\n   120→\n   121→    // Should switch back to untracked state\n   122→    await expect(label).toHaveText('Track prices', { timeout: 10000 })\n   123→  })\n   124→\n   125→  test('TrackPricesToggle reflects existing tracked route', async ({ page }) => {\n   126→    test.slow()\n   127→\n   128→    const button = page.getByTestId('track-prices-button')\n   129→    const label = page.getByTestId('track-prices-label')\n   130→\n   131→    // Enable tracking for LAX → JFK\n   132→    await expect(label).toHaveText('Track prices', { timeout: 10000 })\n   133→    await button.click()\n   134→    await expect(label).toHaveText('Tracking prices', { timeout: 10000 })\n   135→\n   136→    // Navigate away and come back to the same route\n   137→    await page.goto('/')\n   138→    await expect(page.getByTestId('search-page')).toBeVisible({ timeout: 10000 })\n   139→\n   140→    // Navigate back to the same search results\n   141→    await page.goto(buildResultsUrl())\n   142→    await expect(page.getByTestId('search-results-page')).toBeVisible({ timeout: 15000 })\n   143→\n   144→    // The toggle should reflect the existing tracked route (on state)\n   145→    await expect(page.getByTestId('track-prices-label')).toHaveText('Tracking prices', { timeout: 10000 })\n   146→  })\n   147→\n   148→  test('TrackPricesToggle tracked route appears in My Trips', async ({ page }) => {\n   149→    test.slow()\n   150→\n   151→    const button = page.getByTestId('track-prices-button')\n   152→    const label = page.getByTestId('track-prices-label')\n   153→\n   154→    // Enable tracking for LAX → JFK\n   155→    await expect(label).toHaveText('Track prices', { timeout: 10000 })\n   156→    await button.click()\n   157→    await expect(label).toHaveText('Tracking prices', { timeout: 10000 })\n   158→\n   159→    // Navigate to My Trips page\n   160→    await page.goto('/trips')\n   161→    await expect(page.getByTestId('my-trips-page')).toBeVisible({ timeout: 10000 })\n   162→\n   163→    // Click the \"Tracked\" tab\n   164→    await page.getByTestId('trips-tab-tracked').click()\n   165→\n   166→    // Verify tracked route appears in the list\n   167→    const trackedList = page.getByTestId('trips-tracked-list')\n   168→    await expect(trackedList).toBeVisible({ timeout: 10000 })\n   169→\n   170→    // Verify route details (LAX → JFK)\n   171→    await expect(trackedList).toContainText('LAX')\n   172→    await expect(trackedList).toContainText('JFK')\n   173→  })\n   174→\n   175→  test('TrackPricesToggle can be toggled multiple times', async ({ page }) => {\n   176→    test.slow()\n   177→\n   178→    const button = page.getByTestId('track-prices-button')\n   179→    const label = page.getByTestId('track-prices-label')\n   180→\n   181→    // Initially off\n   182→    await expect(label).toHaveText('Track prices', { timeout: 10000 })\n   183→\n   184→    // Toggle ON\n   185→    await button.click()\n   186→    await expect(label).toHaveText('Tracking prices', { timeout: 10000 })\n   187→\n   188→    // Toggle OFF\n   189→    await button.click()\n   190→    await expect(label).toHaveText('Track prices', { timeout: 10000 })\n   191→\n   192→    // Toggle ON again\n   193→    await button.click()\n   194→    await expect(label).toHaveText('Tracking prices', { timeout: 10000 })\n   195→  })\n   196→})\n   197→"}]},"parent_tool_use_id":"toolu_01JzzrmWG1FGKgoiX3oAasLn","session_id":"69f9b163-3df5-4d89-bb17-117162edeb04","uuid":"5659e270-0011-41d2-99b0-73f5186840bd"}
