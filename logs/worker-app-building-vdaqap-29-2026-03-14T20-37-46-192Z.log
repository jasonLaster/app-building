_time) >= now)\n    53→    .sort((a, b) => new Date(a.departure_time).getTime() - new Date(b.departure_time).getTime())\n    54→\n    55→  const pastBookings = bookings\n    56→    .filter(b => new Date(b.departure_time) < now)\n    57→    .sort((a, b) => new Date(b.departure_time).getTime() - new Date(a.departure_time).getTime())\n    58→\n    59→  const handleCancelClick = useCallback((booking: BookingTrip) => {\n    60→    dispatch(clearCancelError())\n    61→    setCancelTarget(booking)\n    62→  }, [dispatch])\n    63→\n    64→  const handleConfirmCancel = useCallback(async () => {\n    65→    if (!cancelTarget) return\n    66→    const result = await dispatch(cancelBooking({ bookingId: cancelTarget.id, sessionToken }))\n    67→    if (cancelBooking.fulfilled.match(result)) {\n    68→      setCancelTarget(null)\n    69→    }\n    70→  }, [dispatch, cancelTarget, sessionToken])\n    71→\n    72→  const handleDismissCancel = useCallback(() => {\n    73→    setCancelTarget(null)\n    74→    dispatch(clearCancelError())\n    75→  }, [dispatch])\n    76→\n    77→  const handleUntrack = useCallback((routeId: string) => {\n    78→    dispatch(untrackRoute({ routeId, sessionToken }))\n    79→  }, [dispatch, sessionToken])\n    80→\n    81→  const renderContent = () => {\n    82→    if (activeTab === 'upcoming') {\n    83→      if (loading) {\n    84→        return <div className=\"my-trips__loading\" data-testid=\"trips-loading\">Loading...</div>\n    85→      }\n    86→      if (upcomingBookings.length === 0) {\n    87→        return (\n    88→          <div className=\"my-trips__empty\" data-testid=\"trips-empty-upcoming\">\n    89→            <div className=\"my-trips__empty-icon\">✈</div>\n    90→            <p className=\"my-trips__empty-text\">No upcoming trips</p>\n    91→            <p className=\"my-trips__empty-subtext\">Search for flights to plan your next trip!</p>\n    92→          </div>\n    93→        )\n    94→      }\n    95→      return (\n    96→   