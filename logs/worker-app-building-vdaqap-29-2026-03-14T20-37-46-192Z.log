ws[0]\n   346→  if (pastFlight) {\n   347→    await sql`INSERT INTO bookings (session_id, flight_id, booking_reference, cabin_class, total_price_cents, status)\n   348→      VALUES (${sessionId}, ${pastFlight.id}, 'GF-PAST01', 'economy', 28635, 'completed')`\n   349→  }\n   350→\n   351→  // Cancelled upcoming booking\n   352→  const cancelFlightRows = await sql`SELECT id FROM flights WHERE flight_number = 'DL200' LIMIT 1`\n   353→  const cancelFlight = cancelFlightRows[0]\n   354→  if (cancelFlight) {\n   355→    await sql`INSERT INTO bookings (session_id, flight_id, booking_reference, cabin_class, total_price_cents, status)\n   356→      VALUES (${sessionId}, ${cancelFlight.id}, 'GF-CANC01', 'economy', 32085, 'cancelled')`\n   357→  }\n   358→\n   359→  // Round-trip booking (LAX→JFK Mar 25, return JFK→LAX Mar 30)\n   360→  const sortFlight1Rows = await sql`SELECT id FROM flights WHERE flight_number = 'AA960' LIMIT 1`\n   361→  const returnFlight1Rows = await sql`SELECT id FROM flights WHERE flight_number = 'AA965' LIMIT 1`\n   362→  const sortFlight1 = sortFlight1Rows[0]\n   363→  const returnFlight1 = returnFlight1Rows[0]\n   364→  if (sortFlight1) {\n   365→    await sql`INSERT INTO bookings (session_id, flight_id, return_flight_id, booking_reference, cabin_class, total_price_cents, status)\n   366→      VALUES (${sessionId}, ${sortFlight1.id}, ${returnFlight1?.id || null}, 'GF-SORT01', 'economy', 33235, 'confirmed')`\n   367→  }\n   368→\n   369→  // Upcoming booking Mar 30\n   370→  const sortFlight2Rows = await sql`SELECT id FROM flights WHERE flight_number = 'DL960' LIMIT 1`\n   371→  const sortFlight2 = sortFlight2Rows[0]\n   372→  if (sortFlight2) {\n   373→    await sql`INSERT INTO bookings (session_id, flight_id, booking_reference, cabin_class, total_price_cents, status)\n   374→      VALUES (${sessionId}, ${sortFlight2.id}, 'GF-SORT02', 'economy', 30935, 'confirmed')`\n   375→  }\n   376→\n   377→  // Upcoming booking Apr 10\n   378→  const sortFlight3Rows = await sql`SELECT id FROM flights WHERE flight_number = 'UA970' LIMIT 1`\n   379→  const sortFlight3 = sortFlight3Rows[0]\n   380→  if (sortFlight3) {\n   381→    await sql`INSERT INTO bookings (session_id, flight_id, booking_reference, cabin_class, total_price_cents, status)\n   382→      VALUES (${sessionId}, ${sortFlight3.id}, 'GF-SORT03', 'economy', 35535, 'confirmed')`\n   383→  }\n   384→\n   385→  // One-way SFO→ORD Apr 5\n   386→  const oneWayFlightRows = await sql`SELECT id FROM flights WHERE flight_number = 'AA970' LIMIT 1`\n   387→  const oneWayFlight = oneWayFlightRows[0]\n   388→  if (oneWayFlight) {\n   389→    await sql`INSERT INTO bookings (session_id, flight_id, booking_reference, cabin_class, total_price_cents, status)\n   390→      VALUES (${sessionId}, ${oneWayFlight.id}, 'GF-ONEW01', 'economy', 20585, 'confirmed')`\n   391→  }\n   392→\n   393→  // Tracked routes\n   394→  await sql`INSERT INTO tracked_routes (session_id, origin_airport_id, destination_airport_id, departure_date_start, departure_date_end, cabin_class)\n   395→    VALUES (${sessionId}, ${laxId}, ${lhrId}, '2026-04-15', '2026-04-30', 'economy')`\n   396→}\n   397→\n   398→// CLI entry point\n   399→const isMain = process.argv[1] && import.meta.url.endsWith(process.argv[1].replace(/\\\\/g, '/'))\n   400→if (isMain) {\n   401→  const dbUrl = process.argv[2]\n   402→  if (!dbUrl) {\n   403→    console.error('Usage: tsx scripts/seed-db.ts <DATABASE_URL>')\n   404→    process.exit(1)\n   405→  }\n   406→  truncateAndSeed(dbUrl).then(() => console.log('Seed complete')).catch(e => { console.error(e); process.exit(1) })\n   407→}\n   408→"}]},"parent_tool_use_id":"toolu_01JzzrmWG1FGKgoiX3oAasLn","session_id":"69f9b163-3df5-4d89-bb17-117162edeb04","uuid":"af6d8a0c-343c-4224-b3a4-8f5ab2673ba7"}
