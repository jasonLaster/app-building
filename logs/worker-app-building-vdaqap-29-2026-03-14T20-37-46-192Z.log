te-card__route {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.tracked-route-card__route-text {\n  font-size: 20px;\n  font-weight: 600;\n  color: var(--color-text-primary);\n  letter-spacing: 0.5px;\n}\n\n.tracked-route-card__cities {\n  font-size: 13px;\n  color: var(--color-text-secondary);\n}\n\n.tracked-route-card__details {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 16px;\n  padding-bottom: 16px;\n  border-bottom: 1px solid var(--color-border-light);\n}\n\n.tracked-route-card__date-range {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 14px;\n  color: var(--color-text-secondary);\n}\n\n.tracked-route-card__price {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-end;\n  gap: 2px;\n}\n\n.tracked-route-card__price-label {\n  font-size: 11px;\n  color: var(--color-text-tertiary);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.tracked-route-card__price-value {\n  font-size: 20px;\n  font-weight: 600;\n  color: var(--color-success);\n}\n\n.tracked-route-card__actions {\n  display: flex;\n  gap: 12px;\n}\n\n.tracked-route-card__search-btn {\n  flex: 1;\n  padding: 8px 16px;\n  font-size: 13px;\n  font-weight: 500;\n  color: var(--color-surface);\n  background: var(--color-primary);\n  border: none;\n  border-radius: var(--radius-sm);\n  cursor: pointer;\n  transition: background 0.2s;\n}\n\n.tracked-route-card__search-btn:hover {\n  background: var(--color-primary-hover);\n}\n\n.tracked-route-card__untrack-btn {\n  flex: 1;\n  padding: 8px 16px;\n  font-size: 13px;\n  font-weight: 500;\n  color: var(--color-text-secondary);\n  background: transparent;\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-sm);\n  cursor: pointer;\n  transition: background 0.2s, color 0.2s;\n}\n\n.tracked-route-card__untrack-btn:hover {\n  background: var(--color-background);\n  color: var(--color-text-primary);\n}\n\n.tracked-route-card__untrack-btn:disabled {\n  opacity: 0.6;\n  cursor: not-allowed;\n}\n","numLines":116,"startLine":1,"totalLines":116}}}
