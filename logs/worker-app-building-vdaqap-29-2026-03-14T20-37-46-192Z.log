"cancel-modal__label\">Route</span>\n    48→            <span className=\"cancel-modal__value\">{booking.origin_code} → {booking.dest_code}</span>\n    49→          </div>\n    50→          <div className=\"cancel-modal__detail-row\">\n    51→            <span className=\"cancel-modal__label\">Date</span>\n    52→            <span className=\"cancel-modal__value\">{formatDate(booking.departure_time)}</span>\n    53→          </div>\n    54→          <div className=\"cancel-modal__detail-row\">\n    55→            <span className=\"cancel-modal__label\">Flight</span>\n    56→            <span className=\"cancel-modal__value\">{booking.airline_name} {booking.flight_number}</span>\n    57→          </div>\n    58→          <div className=\"cancel-modal__detail-row\">\n    59→            <span className=\"cancel-modal__label\">Reference</span>\n    60→            <span className=\"cancel-modal__value cancel-modal__value--mono\">{booking.booking_reference}</span>\n    61→          </div>\n    62→        </div>\n    63→\n    64→        {error && (\n    65→          <div className=\"cancel-modal__error\" data-testid=\"cancel-modal-error\">\n    66→            {error}\n    67→          </div>\n    68→        )}\n    69→\n    70→        <div className=\"cancel-modal__actions\">\n    71→          <button\n    72→            className=\"cancel-modal__btn cancel-modal__btn--dismiss\"\n    73→            onClick={onDismiss}\n    74→            disabled={isCancelling}\n    75→            data-testid=\"cancel-modal-keep\"\n    76→          >\n    77→            Keep Booking\n    78→          </button>\n    79→          <button\n    80→            className=\"cancel-modal__btn cancel-modal__btn--confirm\"\n    81→            onClick={onConfirm}\n    82→            disabled={isCancelling}\n    83→            data-testid=\"cancel-modal-confirm\"\n    84→          >\n    85→            {isCancelling ? 'Cancelling...' : 'Cancel Booking'}\n    86→          </button>\n    87→        </div>\n    88→      </div>\n    89→    </div>\n    90→  )\n    91→}\n    92→\n    93→export default CancelBookingModal\n    94→"}]},"parent_tool_use_id":null,"session_id":"69f9b163-3df5-4d89-bb17-117162edeb04","uuid":"407e9e28-9077-4d49-9eda-e063b49f8770","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/GoogleFlights/src/components/CancelBookingModal.tsx","content":"import { useEffect } from 'react'\nimport type { BookingTrip } from '../slices/tripsSlice'\nimport './CancelBookingModal.css'\n\nfunction formatDate(dateStr: string): string {\n  const d = new Date(dateStr)\n  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })\n}\n\ninterface CancelBookingModalProps {\n  booking: BookingTrip\n  onConfirm: () => void\n  onDismiss: () => void\n  isCancelling: boolean\n  error: string | null\n}\n\nfunction CancelBookingModal({ booking, onConfirm, onDismiss, isCancelling, error }: CancelBookingModalProps) {\n  useEffect(() => {\n    const handleKeyDown = (e: KeyboardEvent) => {\n      if (e.key === 'Escape') {\n        onDismiss()\n      }\n    }\n    document.addEventListener('keydown', handleKeyDown)\n    return () => document.removeEventListener('keydown', handleKeyDown)\n  }, [onDismiss])\n\n  return (\n    <div\n      className=\"cancel-modal__overlay\"\n      onClick={onDismiss}\n      data-testid=\"cancel-modal-overlay\"\n    >\n      <div\n        className=\"cancel-modal\"\n        onClick={(e) => e.stopPropagation()}\n        data-testid=\"cancel-booking-modal\"\n      >\n        <h2 className=\"cancel-modal__title\">Cancel Booking</h2>\n        <p className=\"cancel-modal__message\">\n          Are you sure you want to cancel this booking?\n        </p>\n\n        <div className=\"cancel-modal__details\" data-testid=\"cancel-modal-details\">\n          <div className=\"cancel-modal__detail-row\">\n            <span className=\"cancel-modal__label\">Route</span>\n            <span className=\"cancel-modal__value\">{booking.origin_code} → {booking.dest_code}</span>\n          </div>\n          <div className=\"cancel-modal__detail-row\">\n            <span className=\"cancel-modal__label\">Date</span>\n            <span className=\"cancel-modal__value\">{formatDate(booking.departure_time)}</span>\n          </div>\n          <div className=\"cancel-modal__detail-row\">\n            <span className=\"cancel-modal__label\">Flight</span>\n            <span className=\"cancel-modal__value\">{booking.airline_name} {booking.flight_number}</span>\n          </div>\n          <div className=\"cancel-modal__detail-row\">\n            <span className=\"cancel-modal__label\">Reference</span>\n            <span className=\"cancel-modal__value cancel-modal__value--mono\">{booking.booking_reference}</span>\n          </div>\n        </div>\n\n        {error && (\n          <div className=\"cancel-modal__error\" data-testid=\"cancel-modal-error\">\n            {error}\n          </div>\n        )}\n\n        <div className=\"cancel-modal__actions\">\n          <button\n            className=\"cancel-modal__btn cancel-modal__btn--dismiss\"\n            onClick={onDismiss}\n            disabled={isCancelling}\n            data-testid=\"cancel-modal-keep\"\n          >\n            Keep Booking\n          </button>\n          <button\n            className=\"cancel-modal__btn cancel-modal__btn--confirm\"\n            onClick={onConfirm}\n            disabled={isCancelling}\n            data-testid=\"cancel-modal-confirm\"\n          >\n            {isCancelling ? 'Cancelling...' : 'Cancel Booking'}\n          </button>\n        </div>\n      </div>\n    </div>\n  )\n}\n\nexport default CancelBookingModal\n","numLines":94,"startLine":1,"totalLines":94}}}
