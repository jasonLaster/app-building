l.searchParams.get('user_id')\n    42→    if (!propertyId || !userId) {\n    43→      return new Response(JSON.stringify({ error: 'propertyId and user_id are required' }), { status: 400, headers })\n    44→    }\n    45→    await sql`\n    46→      DELETE FROM favorites WHERE user_id = ${userId} AND property_id = ${propertyId}\n    47→    `\n    48→    return new Response(JSON.stringify({ success: true }), { status: 200, headers })\n    49→  }\n    50→\n    51→  return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers })\n    52→}\n    53→"}]},"parent_tool_use_id":null,"session_id":"82728290-c351-4d4c-b4fe-7b89f455d93a","uuid":"c4e80622-da4c-4f53-bc45-6f8223f6c43b","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/netlify/functions/favorites.ts","content":"import type { Context } from '@netlify/functions'\nimport { getSql } from './db.js'\n\nexport default async (request: Request, _context: Context) => {\n  const sql = getSql()\n  const url = new URL(request.url)\n  const segments = url.pathname.split('/').filter(Boolean)\n  const headers = { 'Content-Type': 'application/json' }\n\n  if (request.method === 'GET') {\n    const userId = url.searchParams.get('user_id')\n    if (!userId) {\n      return new Response(JSON.stringify({ error: 'user_id is required' }), { status: 400, headers })\n    }\n    const favorites = await sql`\n      SELECT f.property_id, f.created_at\n      FROM favorites f\n      WHERE f.user_id = ${userId}\n      ORDER BY f.created_at DESC\n    `\n    return new Response(JSON.stringify(favorites), { status: 200, headers })\n  }\n\n  if (request.method === 'POST') {\n    const body = await request.json()\n    const { user_id, property_id } = body\n    if (!user_id || !property_id) {\n      return new Response(JSON.stringify({ error: 'user_id and property_id are required' }), { status: 400, headers })\n    }\n    await sql`\n      INSERT INTO favorites (user_id, property_id, created_at)\n      VALUES (${user_id}, ${property_id}, now())\n      ON CONFLICT (user_id, property_id) DO NOTHING\n    `\n    return new Response(JSON.stringify({ success: true }), { status: 201, headers })\n  }\n\n  if (request.method === 'DELETE') {\n    const favIdx = segments.indexOf('favorites')\n    const propertyId = favIdx >= 0 ? segments[favIdx + 1] : undefined\n    const userId = url.searchParams.get('user_id')\n    if (!propertyId || !userId) {\n      return new Response(JSON.stringify({ error: 'propertyId and user_id are required' }), { status: 400, headers })\n    }\n    await sql`\n      DELETE FROM favorites WHERE user_id = ${userId} AND property_id = ${propertyId}\n    `\n    return new Response(JSON.stringify({ success: true }), { status: 200, headers })\n  }\n\n  return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers })\n}\n","numLines":53,"startLine":1,"totalLines":53}}}
