[2026-03-14T19:53:51.119Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Df3yDZyS6otEER9wKkz54D","type":"tool_result","content":"     1→import { useState, useRef, useEffect, useMemo } from 'react'\n     2→import { useSelector, useDispatch } from 'react-redux'\n     3→import type { RootState, AppDispatch } from '../store'\n     4→import type { FlightResult, SortOption, StopsFilter, TimeFilter } from '../slices/flightsSlice'\n     5→import {\n     6→  setSortBy,\n     7→  setStopsFilter,\n     8→  setAirlinesFilter,\n     9→  setPriceRange,\n    10→  setDurationRange,\n    11→  setDepartureTimeFilter,\n    12→  setArrivalTimeFilter,\n    13→} from '../slices/flightsSlice'\n    14→import './FilterSidebar.css'\n    15→\n    16→const SORT_OPTIONS: { value: SortOption; label: string }[] = [\n    17→  { value: 'best', label: 'Best' },\n    18→  { value: 'price', label: 'Price (lowest)' },\n    19→  { value: 'duration', label: 'Duration (shortest)' },\n    20→  { value: 'departure', label: 'Departure time (earliest)' },\n    21→  { value: 'arrival', label: 'Arrival time (earliest)' },\n    22→]\n    23→\n    24→const TIME_LABELS: { key: keyof TimeFilter; label: string; range: string }[] = [\n    25→  { key: 'morning', label: 'Morning', range: '6:00 AM – 12:00 PM' },\n    26→  { key: 'afternoon', label: 'Afternoon', range: '12:00 PM – 6:00 PM' },\n    27→  { key: 'evening', label: 'Evening', range: '6:00 PM – 12:00 AM' },\n    28→  { key: 'night', label: 'Night', range: '12:00 AM – 6:00 AM' },\n    29→]\n    30→\n    31→function formatPrice(cents: number): string {\n    32→  return `$${Math.round(cents / 100)}`\n    33→}\n    34→\n    35→function formatDuration(minutes: number): string {\n    36→  const h = Math.floor(minutes / 60)\n    37→  const m = minutes % 60\n    38→  return m > 0 ? `${h}h ${m}m` : `${h}h`\n    39→}\n    40→\n    41→interface RangeSliderProps {\n    42→  min: number\n    43→  max: number\n    44→  value: [number, number]\n    45→  onChange: (val: [number, number]) => void\n    46→  formatLabel: (val: number) => string\n    47→  testIdPrefix: string\n    48→  histogram?: number[]\n    49→}\n    50→\n    51→function RangeSlider({ min, max, value, onChange, formatLabel, testIdPrefix, histogram }: RangeSliderProps) {\n    52→  const trackRef = useRef<HTMLDivElement>(null)\n    53→\n    54→  const range = max - min || 1\n    55→  const leftPct = ((value[0] - min) / range) * 100\n    56→  const rightPct = ((value[1] - min) / range) * 100\n    57→\n    58→  function handlePointerDown(handle: 'min' | 'max') {\n    59→    return (e: React.PointerEvent) => {\n    60→      e.preventDefault()\n    61→      const track = trackRef.current\n    62→      if (!track) return\n    63→\n    64→      const onMove = (moveEvent: PointerEvent) => {\n    65→        const rect = track.getBoundingClientRect()\n    66→        const pct = Math.max(0, Math.min(1, (moveEvent.clientX - rect.left) / rect.width))\n    67→        const val = Math.round(min + pct * range)\n    68→\n    69→        if (handle === 'min') {\n    70→          onChange([Math.min(val, value[1]), value[1]])\n    71→        } else {\n    72→          onChange([value[0], Math.max(val, value[0])])\n    73→        }\n    74→      }\n    75→\n    76→      const onUp = () => {\n    77→        document.removeEventListener('pointermove', onMove)\n    78→        document.removeEventListener('pointerup', onUp)\n    79→      }\n    80→\n    81→      document.addEventListener('pointermove', onMove)\n    82→      document.addEventListener('pointerup', onUp)\n    83→    }\n    84→  }\n    85→\n    86→  const maxHistVal = histogram ? Math.max(...histogram, 1) : 1\n    87→\n    88→  return (\n    89→    <div className=\"range-slider\" data-testid={`${testIdPrefix}-slider`}>\n    90→      {histogram && histogram.length > 0 && (\n    91→        <div className=\"range-slider__histogram\" data-testid={`${testIdPrefix}-histogram`}>\n    92→          {histogram.map((count, i) => (\n    93→            <div\n    94→              key={i}\n    95→              className=\"range-slider__histogram-bar\"\n    96→              style={{ height: `${(count / maxHistVal) * 40}px` }}\n    97→            />\n    98→          ))}\n    99→        </div>\n   100→      )}\n   101→      <div className=\"range-slider__labels\">\n   102→        <span data-testid={`${testIdPrefix}-min-label`}>{formatLabel(value[0])}</span>\n   103→        <span data-testid={`${testIdPrefix}-max-label`}>{formatLabel(value[1])}</span>\n   104→      </div>\n   105→      <div className=\"range-slider__track\" ref={trackRef} data-testid={`${testIdPrefix}-track`}>\n   106→        <div\n   107→          className=\"range-slider__fill\"\n   108→          style={{ left: `${leftPct}%`, width: `${rightPct - leftPct}%` }}\n   109→        />\n   110→        <div\n   111→          className=\"range-slider__handle\"\n   112→          style={{ left: `${leftPct}%` }}\n   113→          onPointerDown={handlePointerDown('min')}\n   114→          data-testid={`${testIdPrefix}-handle-min`}\n   115→          role=\"slider\"\n   116→          aria-valuemin={min}\n   117→          aria-valuemax={max}\n   118→          aria-valuenow={value[0]}\n   119→          aria-label=\"Minimum\"\n   120→          tabIndex={0}\n   121→        />\n   122→        <div\n   123→          className=\"range-slider__handle\"\n   124→          style={{ left: `${rightPct}%` }}\n   125→          onPointerDown={handlePointerDown('max')}\n   126→          data-testid={`${testIdPrefix}-handle-max`}\n   127→          role=\"slider\"\n   128→          aria-valuemin={min}\n   129→          aria-valuemax={max}\n   130→          aria-valuenow={value[1]}\n   131→          aria-label=\"Maximum\"\n   132→          tabIndex={0}\n   133→        />\n   134→      </div>\n   135→    </div>\n   136→  )\n   137→}\n   138→\n   139→function FilterSidebar() {\n   140→  const dispatch = useDispatch<AppDispatch>()\n   141→  const {\n   142→    flights, sortBy, stopsFilter, airlinesFilter,\n   143→    priceRange, priceRangeMax, durationRange, durationRangeMax,\n   144→    departureTimeFilter, arrivalTimeFilter,\n   145→  } = useSelector((state: RootState) => state.flights)\n   146→\n   147→  const [sortOpen, setSortOpen] = useState(false)\n   148→  const sortRef = useRef<HTMLDivElement>(null)\n   149→\n   150→  useEffect(() => {\n   151→    function handleClickOutside(e: MouseEvent) {\n   152→      if (sortRef.current && !sortRef.current.contains(e.target as Node)) {\n   153→        setSortOpen(false)\n   154→      }\n   155→    }\n   156→    document.addEventListener('mousedown', handleClickOutside)\n   157→    return () => document.removeEventListener('mousedown', handleClickOutside)\n   158→  }, [])\n   159→\n   160→  // Compute airline counts\n   161→  const airlineCounts = useMemo(() => {\n   162→    const counts: Record<string, { name: string; count: number }> = {}\n   163→    flights.forEach((f: FlightResult) => {\n   164→      if (!counts[f.airline_code]) {\n   165→        counts[f.airline_code] = { name: f.airline_name, count: 0 }\n   166→      }\n   167→      counts[f.airline_code]!.count++\n   168→    })\n   169→    return counts\n   170→  }, [flights])\n   171→\n   172→  // Compute price histogram\n   173→  const priceHistogram = useMemo(() => {\n   174→    if (flights.length === 0) return []\n   175→    const buckets = 10\n   176→    const [pMin, pMax] = priceRangeMax\n   177→    const range = pMax - pMin || 1\n   178→    const hist = new Array(buckets).fill(0) as number[]\n   179→    flights.forEach((f: FlightResult) => {\n   180→      const idx = Math.min(buckets - 1, Math.floor(((f.total_price_cents - pMin) / range) * buckets))\n   181→      const current = hist[idx]\n   182→      if (current !== undefined) {\n   183→        hist[idx] = current + 1\n   184→      }\n   185→    })\n   186→    return hist\n   187→  }, [flights, priceRangeMax])\n   188→\n   189→  function handleStopsChange(key: keyof StopsFilter) {\n   190→    dispatch(setStopsFilter({ ...stopsFilter, [key]: !stopsFilter[key] }))\n   191→  }\n   192→\n   193→  function handleAirlineToggle(code: string) {\n   194→    const newFilter = airlinesFilter.includes(code)\n   195→      ? airlinesFilter.filter(c => c !== code)\n   196→      : [...airlinesFilter, code]\n   197→    dispatch(setAirlinesFilter(newFilter))\n   198→  }\n   199→\n   200→  function handleDepartureTimeChange(key: keyof TimeFilter) {\n   201→    dispatch(setDepartureTimeFilter({ ...departureTimeFilter, [key]: !departureTimeFilter[key] }))\n   202→  }\n   203→\n   204→  function handleArrivalTimeChange(key: keyof TimeFilter) {\n   205→    dispatch(setArrivalTimeFilter({ ...arrivalTimeFilter, [key]: !arrivalTimeFilter[key] }))\n   206→  }\n   207→\n   208→  const sortLabel = SORT_OPTIONS.find(o => o.value === sortBy)?.label || 'Best'\n   209→\n   210→  return (\n   211→    <div className=\"filter-sidebar\" data-testid=\"filter-sidebar\">\n   212→      {/* Sort By */}\n   213→      <div className=\"filter-sidebar__section\" data-testid=\"filter-sort-section\">\n   214→        <h3 className=\"filter-sidebar__section-title\">Sort by</h3>\n   215→        <div className=\"filter-sidebar__sort\" ref={sortRef}>\n   216→          <button\n   217→            className=\"filter-sidebar__sort-button\"\n   218→            onClick={() => setSortOpen(!sortOpen)}\n   219→            data-testid=\"sort-dropdown-button\"\n   220→          >\n   221→            <span>{sortLabel}</span>\n   222→            <span className={`filter-sidebar__sort-arrow ${sortOpen ? 'filter-sidebar__sort-arrow--open' : ''}`}>▾</span>\n   223→          </button>\n   224→          {sortOpen && (\n   225→            <div className=\"filter-sidebar__sort-dropdown\" data-testid=\"sort-dropdown\">\n   226→              {SORT_OPTIONS.map(opt => (\n   227→                <button\n   228→                  key={opt.value}\n   229→                  className={`filter-sidebar__sort-option ${sortBy === opt.value ? 'filter-sidebar__sort-option--selected' : ''}`}\n   230→                  onClick={() => {\n   231→                    dispatch(setSortBy(opt.value))\n   232→                    setSortOpen(false)\n   233→                  }}\n   234→                  data-testid={`sort-option-${opt.value}`}\n   235→                >\n   236→                  {opt.label}\n   237→                </button>\n   238→              ))}\n   239→            </div>\n   240→          )}\n   241→        </div>\n   242→      </div>\n   243→\n   244→      {/* Stops */}\n   245→      <div className=\"filter-sidebar__section\" data-testid=\"filter-stops-section\">\n   246→        <h3 className=\"filter-sidebar__section-title\">Stops</h3>\n   247→        <label className=\"filter-sidebar__checkbox\" data-testid=\"filter-stops-nonstop\">\n   248→          <input\n   249→            type=\"checkbox\"\n   250→            checked={stopsFilter.nonstop}\n   251→            onChange={() => handleStopsChange('nonstop')}\n   252→          />\n   253→          <span>Nonstop</span>\n   254→        </label>\n   255→        <label className=\"filter-sidebar__checkbox\" data-testid=\"filter-stops-one\">\n   256→          <input\n   257→            type=\"checkbox\"\n   258→            checked={stopsFilter.oneStop}\n   259→            onChange={() => handleStopsChange('oneStop')}\n   260→          />\n   261→          <span>1 stop</span>\n   262→        </label>\n   263→        <label className=\"filter-sidebar__checkbox\" data-testid=\"filter-stops-two-plus\">\n   264→          <input\n   265→            type=\"checkbox\"\n   266→            checked={stopsFilter.twoPlusStops}\n   267→            onChange={() => handleStopsChange('twoPlusStops')}\n   268→          />\n   269→          <span>2+ stops</span>\n   270→        </label>\n   271→      </div>\n   272→\n   273→      {/* Airlines */}\n   274→      <div className=\"filter-sidebar__section\" data-testid=\"filter-airlines-section\">\n   275→        <h3 className=\"filter-sidebar__section-title\">Airlines</h3>\n   276→        {Object.entries(airlineCounts).map(([code, info]) => (\n   277→          <label key={code} className=\"filter-sidebar__checkbox\" data-testid={`filter-airline-${code}`}>\n   278→            <input\n   279→              type=\"checkbox\"\n   280→              checked={airlinesFilter.includes(code)}\n   281→              onChange={() => handleAirlineToggle(code)}\n   282→            />\n   283→            <span>{info.name} ({info.count})</span>\n   284→          </label>\n   285→        ))}\n   286→      </div>\n   287→\n   288→      {/* Price Range */}\n   289→      <div className=\"filter-sidebar__section\" data-testid=\"filter-price-section\">\n   290→        <h3 className=\"filter-sidebar__section-title\">Price range</h3>\n   291→        <RangeSlider\n   292→          min={priceRangeMax[0]}\n   293→          max={priceRangeMax[1]}\n   294→          value={priceRange}\n   295→          onChange={(val) => dispatch(setPriceRange(val))}\n   296→          formatLabel={formatPrice}\n   297→          testIdPrefix=\"price-range\"\n   298→          histogram={priceHistogram}\n   299→        />\n   300→      </div>\n   301→\n   302→      {/* Duration Range */}\n   303→      <div className=\"filter-sidebar__section\" data-testid=\"filter-duration-section\">\n   304→        <h3 className=\"filter-sidebar__section-title\">Duration range</h3>\n   305→        <RangeSlider\n   306→          min={durationRangeMax[0]}\n   307→          max={durationRangeMax[1]}\n   308→          value={durationRange}\n   309→          onChange={(val) => dispatch(setDurationRange(val))}\n   310→          formatLabel={formatDuration}\n   311→          testIdPrefix=\"duration-range\"\n   312→        />\n   313→      </div>\n   314→\n   315→      {/* Departure Time */}\n   316→      <div className=\"filter-sidebar__section\" data-testid=\"filter-departure-time-section\">\n   317→        <h3 className=\"filter-sidebar__section-title\">Departure time</h3>\n   318→        {TIME_LABELS.map(({ key, label, range }) => (\n   319→          <label key={key} className=\"filter-sidebar__checkbox\" data-testid={`filter-departure-${key}`}>\n   320→            <input\n   321→              type=\"checkbox\"\n   322→              checked={departureTimeFilter[key]}\n   323→              onChange={() => handleDepartureTimeChange(key)}\n   324→            />\n   325→            <span className=\"filter-sidebar__time-label\">\n   326→              {label}\n   327→              <span className=\"filter-sidebar__time-range\">{range}</span>\n   328→            </span>\n   329→          </label>\n   330→        ))}\n   331→      </div>\n   332→\n   333→      {/* Arrival Time */}\n   334→      <div className=\"filter-sidebar__section\" data-testid=\"filter-arrival-time-section\">\n   335→        <h3 className=\"filter-sidebar__section-title\">Arrival time</h3>\n   336→        {TIME_LABELS.map(({ key, label, range }) => (\n   337→          <label key={key} className=\"filter-sidebar__checkbox\" data-testid={`filter-arrival-${key}`}>\n   338→            <input\n   339→              type=\"checkbox\"\n   340→              checked={arrivalTimeFilter[key]}\n   341→              onChange={() => handleArrivalTimeChange(key)}\n   342→            />\n   343→            <span className=\"filter-sidebar__time-label\">\n   344→              {label}\n   345→              <span className=\"filter-sidebar__time-range\">{range}</span>\n   346→            </span>\n   347→          </label>\n   348→        ))}\n   349→      </div>\n   350→    </div>\n   351→  )\n   352→}\n   353→\n   354→export default FilterSidebar\n   355→"}]},"parent_tool_use_id":"toolu_01WHJyBsfTCpeu9AQnDHA24R","session_id":"755439b7-7306-4724-ae36-7d6e61e30f0f","uuid":"e3d6b024-f6f2-4a8d-a4a4-a1f4c1cb7592"}
