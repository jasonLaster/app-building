[2026-03-14T19:54:11.463Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012PgbDN8PoUDaFxdBXwtWdc","type":"tool_result","content":"     1→import { useState, useRef, useEffect } from 'react'\n     2→import { useSelector } from 'react-redux'\n     3→import type { RootState } from '../store'\n     4→import type { Airport } from '../slices/searchSlice'\n     5→import AirportAutocomplete from './AirportAutocomplete'\n     6→import DatePicker from './DatePicker'\n     7→import PassengerCountSelector from './PassengerCountSelector'\n     8→import CabinClassSelector from './CabinClassSelector'\n     9→import './SearchSummaryBar.css'\n    10→\n    11→type EditingField = 'origin' | 'destination' | 'departureDate' | 'returnDate' | 'passengers' | 'cabinClass' | null\n    12→\n    13→interface SearchSummaryBarProps {\n    14→  origin: string\n    15→  destination: string\n    16→  departureDate: string\n    17→  returnDate: string | null\n    18→  tripType: string\n    19→  cabinClass: string\n    20→  adults: number\n    21→  children: number\n    22→  infants: number\n    23→  onSearch: (params: {\n    24→    origin?: Airport\n    25→    destination?: Airport\n    26→    departureDate?: string\n    27→    returnDate?: string | null\n    28→    cabinClass?: string\n    29→    adults?: number\n    30→    children?: number\n    31→    infants?: number\n    32→  }) => void\n    33→}\n    34→\n    35→function ApplyButton({ onClick, testId }: { onClick: () => void; testId: string }) {\n    36→  return (\n    37→    <button\n    38→      className=\"search-summary-bar__apply-btn\"\n    39→      onClick={onClick}\n    40→      data-testid={testId}\n    41→    >\n    42→      Done\n    43→    </button>\n    44→  )\n    45→}\n    46→\n    47→function formatDate(dateStr: string): string {\n    48→  const date = new Date(dateStr + 'T00:00:00')\n    49→  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })\n    50→}\n    51→\n    52→function formatCabinClass(cls: string): string {\n    53→  const map: Record<string, string> = {\n    54→    economy: 'Economy',\n    55→    premium_economy: 'Premium Economy',\n    56→    business: 'Business',\n    57→    first: 'First',\n    58→  }\n    59→  return map[cls] || cls\n    60→}\n    61→\n    62→function formatPassengers(adults: number, children: number, infants: number): string {\n    63→  const total = adults + children + infants\n    64→  if (total === 1) return '1 adult'\n    65→  return `${total} passengers`\n    66→}\n    67→\n    68→function SearchSummaryBar({\n    69→  origin, destination, departureDate, returnDate, tripType,\n    70→  cabinClass, adults, children, infants, onSearch,\n    71→}: SearchSummaryBarProps) {\n    72→  const [editing, setEditing] = useState<EditingField>(null)\n    73→  const containerRef = useRef<HTMLDivElement>(null)\n    74→\n    75→  const searchState = useSelector((state: RootState) => state.search)\n    76→\n    77→  useEffect(() => {\n    78→    function handleClickOutside(e: MouseEvent) {\n    79→      if (containerRef.current && !containerRef.current.contains(e.target as Node)) {\n    80→        setEditing(null)\n    81→      }\n    82→    }\n    83→    document.addEventListener('mousedown', handleClickOutside)\n    84→    return () => document.removeEventListener('mousedown', handleClickOutside)\n    85→  }, [])\n    86→\n    87→  function handleOriginSelect(airport: Airport | null) {\n    88→    if (airport) {\n    89→      onSearch({ origin: airport })\n    90→      setEditing(null)\n    91→    }\n    92→  }\n    93→\n    94→  function handleDestinationSelect(airport: Airport | null) {\n    95→    if (airport) {\n    96→      onSearch({ destination: airport })\n    97→      setEditing(null)\n    98→    }\n    99→  }\n   100→\n   101→  function handleDepartureDateSelect(date: string | null) {\n   102→    if (date) {\n   103→      onSearch({ departureDate: date })\n   104→      setEditing(null)\n   105→    }\n   106→  }\n   107→\n   108→  function handleReturnDateSelect(date: string | null) {\n   109→    if (date) {\n   110→      onSearch({ returnDate: date })\n   111→      setEditing(null)\n   112→    }\n   113→  }\n   114→\n   115→  const dateDisplay = returnDate\n   116→    ? `${formatDate(departureDate)} – ${formatDate(returnDate)}`\n   117→    : formatDate(departureDate)\n   118→\n   119→  return (\n   120→    <div className=\"search-summary-bar\" ref={containerRef} data-testid=\"search-summary-bar\">\n   121→      <div className=\"search-summary-bar__chips\">\n   122→        <div className=\"search-summary-bar__chip-wrapper\" style={{ position: 'relative' }}>\n   123→          <button\n   124→            className={`search-summary-bar__chip ${editing === 'origin' ? 'search-summary-bar__chip--active' : ''}`}\n   125→            onClick={() => setEditing(editing === 'origin' ? null : 'origin')}\n   126→            data-testid=\"summary-origin\"\n   127→          >\n   128→            <span className=\"search-summary-bar__chip-icon\">✈</span>\n   129→            {origin}\n   130→          </button>\n   131→          {editing === 'origin' && (\n   132→            <div className=\"search-summary-bar__editor\" data-testid=\"summary-origin-editor\">\n   133→              <AirportAutocomplete\n   134→                value={searchState.origin}\n   135→                onChange={handleOriginSelect}\n   136→                placeholder=\"Where from?\"\n   137→                testIdPrefix=\"summary-origin-autocomplete\"\n   138→              />\n   139→            </div>\n   140→          )}\n   141→        </div>\n   142→\n   143→        <span className=\"search-summary-bar__arrow\">→</span>\n   144→\n   145→        <div className=\"search-summary-bar__chip-wrapper\" style={{ position: 'relative' }}>\n   146→          <button\n   147→            className={`search-summary-bar__chip ${editing === 'destination' ? 'search-summary-bar__chip--active' : ''}`}\n   148→            onClick={() => setEditing(editing === 'destination' ? null : 'destination')}\n   149→            data-testid=\"summary-destination\"\n   150→          >"}]},"parent_tool_use_id":"toolu_01WHJyBsfTCpeu9AQnDHA24R","session_id":"755439b7-7306-4724-ae36-7d6e61e30f0f","uuid":"7f1f7683-2810-49d5-b44d-c43c595b697f"}
