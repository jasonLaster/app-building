   119→    const qs = new URLSearchParams({\n   120→      origin: params.origin,\n   121→      destination: params.destination,\n   122→      departureDate: params.departureDate,\n   123→      cabinClass: params.cabinClass,\n   124→      page: String(params.page || 1),\n   125→    })\n   126→    const res = await fetch(`/api/search-flights?${qs}`)\n   127→    return res.json() as Promise<{\n   128→      flights: FlightResult[]\n   129→      total: number\n   130→      page: number\n   131→      totalPages: number\n   132→    }>\n   133→  }\n   134→)\n   135→\n   136→export const loadMoreFlights = createAsyncThunk(\n   137→  'flights/loadMoreFlights',\n   138→  async (params: {\n   139→    origin: string\n   140→    destination: string\n   141→    departureDate: string\n   142→    cabinClass: string\n   143→    page: number\n   144→  }) => {\n   145→    const qs = new URLSearchParams({\n   146→      origin: params.origin,\n   147→      destination: params.destination,\n   148→      departureDate: params.departureDate,\n   149→      cabinClass: params.cabinClass,\n   150→      page: String(params.page),"}]},"parent_tool_use_id":"toolu_01WHJyBsfTCpeu9AQnDHA24R","session_id":"755439b7-7306-4724-ae36-7d6e61e30f0f","uuid":"0172873c-bd57-4739-ad7e-b5842a851b38"}
