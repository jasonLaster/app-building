[2026-03-14T19:54:05.111Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Q6Tqpox6pQ3MswN3usyUX5","type":"tool_result","content":"     1→import { useEffect, useMemo, useCallback } from 'react'\n     2→import { useSearchParams, useNavigate } from 'react-router-dom'\n     3→import { useSelector, useDispatch } from 'react-redux'\n     4→import type { RootState, AppDispatch } from '../store'\n     5→import type { Airport } from '../slices/searchSlice'\n     6→import { setOrigin, setDestination, setDepartureDate, setReturnDate, setCabinClass, setPassengers } from '../slices/searchSlice'\n     7→import type { FlightResult, SortOption, TimeFilter } from '../slices/flightsSlice'\n     8→import { searchFlights, loadMoreFlights, checkTrackedRoute } from '../slices/flightsSlice'\n     9→import SearchSummaryBar from '../components/SearchSummaryBar'\n    10→import FilterSidebar from '../components/FilterSidebar'\n    11→import FlightResultCard from '../components/FlightResultCard'\n    12→import TrackPricesToggle from '../components/TrackPricesToggle'\n    13→import Pagination from '../components/Pagination'\n    14→import './SearchResultsPage.css'\n    15→\n    16→function getTimeCategory(dateStr: string): keyof TimeFilter {\n    17→  const hour = new Date(dateStr).getHours()\n    18→  if (hour >= 6 && hour < 12) return 'morning'\n    19→  if (hour >= 12 && hour < 18) return 'afternoon'\n    20→  if (hour >= 18) return 'evening'\n    21→  return 'night'\n    22→}\n    23→\n    24→function hasActiveTimeFilter(filter: TimeFilter): boolean {\n    25→  return filter.morning || filter.afternoon || filter.evening || filter.night\n    26→}\n    27→\n    28→function SearchResultsPage() {\n    29→  const [searchParams, setSearchParams] = useSearchParams()\n    30→  const navigate = useNavigate()\n    31→  const dispatch = useDispatch<AppDispatch>()\n    32→\n    33→  const originCode = searchParams.get('origin') || ''\n    34→  const destCode = searchParams.get('destination') || ''\n    35→  const departureDate = searchParams.get('departureDate') || ''\n    36→  const returnDate = searchParams.get('returnDate') || null\n    37→  const tripType = searchParams.get('tripType') || 'round_trip'\n    38→  const cabinClass = searchParams.get('cabinClass') || 'economy'\n    39→  const adults = parseInt(searchParams.get('adults') || '1')\n    40→  const children = parseInt(searchParams.get('children') || '0')\n    41→  const infants = parseInt(searchParams.get('infants') || '0')\n    42→\n    43→  const {\n    44→    flights, loading, page, totalPages, loadingMore,\n    45→    sortBy, stopsFilter, airlinesFilter,\n    46→    priceRange, durationRange,\n    47→    departureTimeFilter, arrivalTimeFilter,\n    48→  } = useSelector((state: RootState) => state.flights)\n    49→\n    50→  const sessionToken = useSelector((state: RootState) => state.search.sessionToken)\n    51→\n    52→  // Fetch flights on mount or when search params change\n    53→  useEffect(() => {\n    54→    if (originCode && destCode && departureDate) {\n    55→      dispatch(searchFlights({\n    56→        origin: originCode,\n    57→        destination: destCode,\n    58→        departureDate,\n    59→        cabinClass,\n    60→      }))\n    61→      dispatch(checkTrackedRoute({\n    62→        sessionToken,\n    63→        origin: originCode,\n    64→        destination: destCode,\n    65→      }))\n    66→    }\n    67→  }, [dispatch, originCode, destCode, departureDate, cabinClass, sessionToken])\n    68→\n    69→  // Apply client-side filters and sorting\n    70→  const filteredFlights = useMemo(() => {\n    71→    let result = [...flights]\n    72→\n    73→    // Stops filter\n    74→    const hasStopsFilter = stopsFilter.nonstop || stopsFilter.oneStop || stopsFilter.twoPlusStops\n    75→    if (hasStopsFilter) {\n    76→      result = result.filter((f: FlightResult) => {\n    77→        const numStops = Number(f.num_legs) - 1\n    78→        if (numStops === 0 && stopsFilter.nonstop) return true\n    79→        if (numStops === 1 && stopsFilter.oneStop) return true\n    80→        if (numStops >= 2 && stopsFilter.twoPlusStops) return true\n    81→        return false\n    82→      })\n    83→    }\n    84→\n    85→    // Airlines filter\n    86→    if (airlinesFilter.length > 0) {\n    87→      result = result.filter((f: FlightResult) => airlinesFilter.includes(f.airline_code))\n    88→    }\n    89→\n    90→    // Price range filter\n    91→    result = result.filter((f: FlightResult) =>\n    92→      f.total_price_cents >= priceRange[0] && f.total_price_cents <= priceRange[1]\n    93→    )\n    94→\n    95→    // Duration range filter\n    96→    result = result.filter((f: FlightResult) =>\n    97→      f.duration_minutes >= durationRange[0] && f.duration_minutes <= durationRange[1]\n    98→    )\n    99→\n   100→    // Departure time filter"}]},"parent_tool_use_id":"toolu_01WHJyBsfTCpeu9AQnDHA24R","session_id":"755439b7-7306-4724-ae36-7d6e61e30f0f","uuid":"640ab5b0-18bf-49cf-8294-86d20c5d0787"}
