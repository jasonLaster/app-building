[2026-03-14T19:53:51.134Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DSH7XBYMyp83ECZ28ADvFS","type":"tool_result","content":"     1→import { useState } from 'react'\n     2→import { useSelector, useDispatch } from 'react-redux'\n     3→import { useNavigate, useSearchParams } from 'react-router-dom'\n     4→import type { RootState, AppDispatch } from '../store'\n     5→import type { FlightResult, FlightLeg } from '../slices/flightsSlice'\n     6→import { fetchFlightLegs } from '../slices/flightsSlice'\n     7→import './FlightResultCard.css'\n     8→\n     9→interface FlightResultCardProps {\n    10→  flight: FlightResult\n    11→}\n    12→\n    13→function formatTime(dateStr: string): string {\n    14→  const date = new Date(dateStr)\n    15→  return date.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true })\n    16→}\n    17→\n    18→function formatDuration(minutes: number): string {\n    19→  const h = Math.floor(minutes / 60)\n    20→  const m = minutes % 60\n    21→  return m > 0 ? `${h}h ${m}m` : `${h}h`\n    22→}\n    23→\n    24→function formatPrice(cents: number): string {\n    25→  return `$${Math.round(cents / 100)}`\n    26→}\n    27→\n    28→function getStopsLabel(numLegs: number): string {\n    29→  if (numLegs <= 1) return 'Nonstop'\n    30→  if (numLegs === 2) return '1 stop'\n    31→  return `${numLegs - 1} stops`\n    32→}\n    33→\n    34→function getAirlineInitials(name: string): string {\n    35→  return name.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase()\n    36→}\n    37→\n    38→function getDayDiff(dep: string, arr: string): number {\n    39→  const depDate = new Date(dep)\n    40→  const arrDate = new Date(arr)\n    41→  const depDay = new Date(depDate.getFullYear(), depDate.getMonth(), depDate.getDate())\n    42→  const arrDay = new Date(arrDate.getFullYear(), arrDate.getMonth(), arrDate.getDate())\n    43→  return Math.round((arrDay.getTime() - depDay.getTime()) / (1000 * 60 * 60 * 24))\n    44→}\n    45→\n    46→function FlightResultCard({ flight }: FlightResultCardProps) {\n    47→  const dispatch = useDispatch<AppDispatch>()\n    48→  const navigate = useNavigate()\n    49→  const [searchParams] = useSearchParams()\n    50→  const [expanded, setExpanded] = useState(false)\n    51→\n    52→  const legs = useSelector((state: RootState) => state.flights.expandedLegs[flight.id])\n    53→  const legsLoading = useSelector((state: RootState) => state.flights.expandedLegsLoading[flight.id])\n    54→  const passengers = useSelector((state: RootState) => state.search.passengers)\n    55→\n    56→  function handleToggleExpand() {\n    57→    if (!expanded && !legs && !legsLoading) {\n    58→      dispatch(fetchFlightLegs(flight.id))\n    59→    }\n    60→    setExpanded(!expanded)\n    61→  }\n    62→\n    63→  function handleSelect(e: React.MouseEvent) {\n    64→    e.stopPropagation()\n    65→    const cabinClass = searchParams.get('cabinClass') || 'economy'\n    66→    navigate(`/booking/${flight.id}?cabin=${encodeURIComponent(cabinClass)}&adults=${passengers.adults}&children=${passengers.children}&infants=${passengers.infants}`)\n    67→  }\n    68→\n    69→  const dayDiff = getDayDiff(flight.departure_time, flight.arrival_time)\n    70→\n    71→  return (\n    72→    <div\n    73→      className={`flight-card ${expanded ? 'flight-card--expanded' : ''}`}\n    74→      data-testid={`flight-card-${flight.id}`}\n    75→    >\n    76→      <div className=\"flight-card__main\" onClick={handleToggleExpand} data-testid={`flight-card-main-${flight.id}`}>\n    77→        <div className=\"flight-card__airline\">\n    78→          <div\n    79→            className=\"flight-card__airline-logo\"\n    80→            style={{ backgroundColor: flight.logo_color || '#1A73E8' }}\n    81→            data-testid={`flight-card-logo-${flight.id}`}\n    82→          >\n    83→            {getAirlineInitials(flight.airline_name)}\n    84→          </div>\n    85→          <span className=\"flight-card__airline-name\" data-testid={`flight-card-airline-${flight.id}`}>\n    86→            {flight.airline_name}\n    87→          </span>\n    88→        </div>\n    89→\n    90→        <div className=\"flight-card__times\">\n    91→          <div className=\"flight-card__time-display\">\n    92→            <span className=\"flight-card__time\" data-testid={`flight-card-departure-${flight.id}`}>\n    93→              {formatTime(flight.departure_time)}\n    94→            </span>\n    95→            <span className=\"flight-card__time-arrow\">→</span>\n    96→            <span className=\"flight-card__time\" data-testid={`flight-card-arrival-${flight.id}`}>\n    97→              {formatTime(flight.arrival_time)}\n    98→              {dayDiff > 0 && (\n    99→                <span className=\"flight-card__day-indicator\" data-testid={`flight-card-day-${flight.id}`}>\n   100→                  +{dayDiff}\n   101→                </span>\n   102→              )}\n   103→            </span>\n   104→          </div>\n   105→          <div className=\"flight-card__route-codes\">\n   106→            {flight.origin_code} – {flight.dest_code}\n   107→          </div>\n   108→        </div>\n   109→\n   110→        <div className=\"flight-card__duration\" data-testid={`flight-card-duration-${flight.id}`}>\n   111→          <span className=\"flight-card__duration-text\">{formatDuration(flight.duration_minutes)}</span>\n   112→          <span className=\"flight-card__stops\" data-testid={`flight-card-stops-${flight.id}`}>\n   113→            {getStopsLabel(Number(flight.num_legs))}\n   114→          </span>\n   115→        </div>\n   116→\n   117→        <div className=\"flight-card__co2\" data-testid={`flight-card-co2-${flight.id}`}>\n   118→          {flight.co2_kg} kg CO₂\n   119→        </div>\n   120→\n   121→        <div className=\"flight-card__price\" data-testid={`flight-card-price-${flight.id}`}>\n   122→          {formatPrice(flight.total_price_cents)}\n   123→        </div>\n   124→\n   125→        <div className=\"flight-card__expand-icon\">\n   126→          {expanded ? '▲' : '▼'}\n   127→        </div>\n   128→      </div>\n   129→\n   130→      {expanded && (\n   131→        <div className=\"flight-card__details\" data-testid={`flight-card-details-${flight.id}`}>\n   132→          {legsLoading ? (\n   133→            <div className=\"flight-card__details-loading\" data-testid={`flight-card-loading-${flight.id}`}>\n   134→              Loading flight details...\n   135→            </div>\n   136→          ) : legs && legs.length > 0 ? (\n   137→            <div className=\"flight-card__legs\">\n   138→              {legs.map((leg: FlightLeg, index: number) => (\n   139→                <div key={leg.id}>\n   140→                  {index > 0 && (\n   141→                    <div className=\"flight-card__layover\" data-testid={`flight-card-layover-${flight.id}-${index}`}>\n   142→                      <div className=\"flight-card__layover-line\" />\n   143→                      <span className=\"flight-card__layover-text\">\n   144→                        {formatLayover(legs[index - 1]!, leg)} layover at {leg.origin_code}\n   145→                      </span>\n   146→                      <div className=\"flight-card__layover-line\" />\n   147→                    </div>\n   148→                  )}\n   149→                  <div className=\"flight-card__leg\" data-testid={`flight-card-leg-${flight.id}-${leg.leg_order}`}>\n   150→                    <div className=\"flight-card__leg-timeline\">\n   151→                      <div className=\"flight-card__leg-dot\" />\n   152→                      <div className=\"flight-card__leg-line\" />\n   153→                      <div className=\"flight-card__leg-dot\" />\n   154→                    </div>\n   155→                    <div className=\"flight-card__leg-info\">\n   156→                      <div className=\"flight-card__leg-row\">\n   157→                        <span className=\"flight-card__leg-time\">{formatTime(leg.departure_time)}</span>\n   158→                        <span className=\"flight-card__leg-airport\">\n   159→                          {leg.origin_name} ({leg.origin_code})\n   160→                          {leg.terminal_departure && <span className=\"flight-card__leg-terminal\"> · Terminal {leg.terminal_departure}</span>}\n   161→                        </span>\n   162→                      </div>\n   163→                      <div className=\"flight-card__leg-meta\">\n   164→                        <span>{formatDuration(leg.duration_minutes)}</span>\n   165→                        <span className=\"flight-card__leg-flight-num\">\n   166→                          {leg.airline_name || flight.airline_name} · {leg.flight_number}\n   167→                        </span>\n   168→                        {leg.aircraft_type && (\n   169→                          <span className=\"flight-card__leg-aircraft\">{leg.aircraft_type}</span>\n   170→                        )}\n   171→                      </div>\n   172→                      <div className=\"flight-card__leg-row\">\n   173→                        <span className=\"flight-card__leg-time\">{formatTime(leg.arrival_time)}</span>\n   174→                        <span className=\"flight-card__leg-airport\">\n   175→                          {leg.dest_name} ({leg.dest_code})\n   176→                          {leg.terminal_arrival && <span className=\"flight-card__leg-terminal\"> · Terminal {leg.terminal_arrival}</span>}\n   177→                        </span>\n   178→                      </div>\n   179→                    </div>\n   180→                  </div>\n   181→                </div>\n   182→              ))}\n   183→            </div>\n   184→          ) : (\n   185→            <div className=\"flight-card__legs\">\n   186→              <div className=\"flight-card__leg\" data-testid={`flight-card-leg-${flight.id}-single`}>\n   187→                <div className=\"flight-card__leg-timeline\">\n   188→                  <div className=\"flight-card__leg-dot\" />\n   189→                  <div className=\"flight-card__leg-line\" />\n   190→                  <div className=\"flight-card__leg-dot\" />\n   191→                </div>\n   192→                <div className=\"flight-card__leg-info\">\n   193→                  <div className=\"flight-card__leg-row\">\n   194→                    <span className=\"flight-card__leg-time\">{formatTime(flight.departure_time)}</span>\n   195→                    <span className=\"flight-card__leg-airport\">{flight.origin_name} ({flight.origin_code})</span>\n   196→                  </div>\n   197→                  <div className=\"flight-card__leg-meta\">\n   198→                    <span>{formatDuration(flight.duration_minutes)}</span>\n   199→                    <span className=\"flight-card__leg-flight-num\">{flight.airline_name} · {flight.flight_number}</span>\n   200→                    {flight.aircraft_type && <span className=\"flight-card__leg-aircraft\">{flight.aircraft_type}</span>}\n   201→                  </div>\n   202→                  <div className=\"flight-card__leg-row\">\n   203→                    <span className=\"flight-card__leg-time\">{formatTime(flight.arrival_time)}</span>\n   204→                    <span className=\"flight-card__leg-airport\">{flight.dest_name} ({flight.dest_code})</span>\n   205→                  </div>\n   206→                </div>\n   207→              </div>\n   208→            </div>\n   209→          )}\n   210→\n   211→          <div className=\"flight-card__amenities\" data-testid={`flight-card-amenities-${flight.id}`}>\n   212→            {flight.has_wifi && (\n   213→              <span className=\"flight-card__amenity\" data-testid={`flight-card-wifi-${flight.id}`} title=\"Wi-Fi available\">\n   214→                📶 Wi-Fi\n   215→              </span>\n   216→            )}\n   217→            {flight.has_power && (\n   218→              <span className=\"flight-card__amenity\" data-testid={`flight-card-power-${flight.id}`} title=\"Power outlets available\">\n   219→                🔌 Power\n   220→              </span>\n   221→            )}\n   222→            {flight.has_entertainment && (\n   223→              <span className=\"flight-card__amenity\" data-testid={`flight-card-entertainment-${flight.id}`} title=\"In-flight entertainment\">\n   224→                🎬 Entertainment\n   225→              </span>\n   226→            )}\n   227→          </div>\n   228→\n   229→          <div className=\"flight-card__baggage\" data-testid={`flight-card-baggage-${flight.id}`}>\n   230→            <span className=\"flight-card__baggage-icon\">🧳</span>\n   231→            <span>\n   232→              {flight.cabin_class === 'economy'\n   233→                ? '1 carry-on bag, 1 personal item'\n   234→                : flight.cabin_class === 'premium_economy'\n   235→                  ? '1 carry-on bag, 1 checked bag included'\n   236→                  : '2 carry-on bags, 2 checked bags included'}\n   237→            </span>\n   238→          </div>\n   239→\n   240→          <div className=\"flight-card__actions\">\n   241→            <button\n   242→              className=\"flight-card__select-button\"\n   243→              onClick={handleSelect}\n   244→              data-testid={`flight-card-select-${flight.id}`}\n   245→            >\n   246→              Select flight · {formatPrice(flight.total_price_cents)}\n   247→            </button>\n   248→          </div>\n   249→        </div>\n   250→      )}\n   251→    </div>\n   252→  )\n   253→}\n   254→\n   255→function formatLayover(prevLeg: FlightLeg, nextLeg: FlightLeg): string {\n   256→  const prevArr = new Date(prevLeg.arrival_time).getTime()\n   257→  const nextDep = new Date(nextLeg.departure_time).getTime()\n   258→  const diffMinutes = Math.round((nextDep - prevArr) / (1000 * 60))\n   259→  return formatDuration(diffMinutes)\n   260→}\n   261→\n   262→export default FlightResultCard\n   263→"}]},"parent_tool_use_id":"toolu_01WHJyBsfTCpeu9AQnDHA24R","session_id":"755439b7-7306-4724-ae36-7d6e61e30f0f","uuid":"ddf31fa9-56b5-4a0e-981f-dfb25cd93327"}
