riginCode)}`)\n    61→    return res.json() as Promise<ExploreDestination[]>\n    62→  }\n    63→)\n    64→\n    65→export const fetchExploreDates = createAsyncThunk(\n    66→  'explore/fetchDates',\n    67→  async (params: { originCode: string; dateRange: DateRange }) => {\n    68→    const res = await fetch(\n    69→      `/api/explore-dates?origin=${encodeURIComponent(params.originCode)}&range=${params.dateRange}`\n    70→    )\n    71→    return res.json() as Promise<DatePrice[]>\n    72→  }\n    73→)\n    74→\n    75→export const fetchExploreDeals = createAsyncThunk(\n    76→  'explore/fetchDeals',\n    77→  async (originCode: string) => {\n    78→    const res = await fetch(`/api/explore-deals?origin=${encodeURIComponent(originCode)}`)\n    79→    return res.json() as Promise<Deal[]>\n    80→  }\n    81→)\n    82→\n    83→const exploreSlice = createSlice({\n    84→  name: 'explore',\n    85→  initialState,\n    86→  reducers: {\n    87→    setExploreOrigin(state, action: PayloadAction<Airport | null>) {\n    88→      state.origin = action.payload\n    89→    },\n    90→    setDateRange(state, action: PayloadAction<DateRange>) {\n    91→      state.dateRange = action.payload\n    92→    },\n    93→  },\n    94→  extraReducers: (builder) => {\n    95→    builder\n    96→      .addCase(fetchExploreDestinations.pending, (state) => {\n    97→        state.destinationsLoading = true\n    98→      })\n    99→      .addCase(fetchExploreDestinations.fulfilled, (state, action) => {\n   100→        state.destinations = action.payload\n   101→        state.destinationsLoading = false\n   102→      })\n   103→      .addCase(fetchExploreDestinations.rejected, (state) => {\n   104→        state.destinationsLoading = false\n   105→      })\n   106→      .addCase(fetchExploreDates.pending, (state) => {\n   107→        state.datePricesLoading = true\n   108→      })\n   109→      .addCase(fetchExploreDates.fulfilled, (state, action) => {\n   110→        state.datePrices = action.payload\n   111→        state.datePricesLoading = false\n   112→      })\n   113→      .addCase(fetchExploreDates.rejected, (state) => {\n   114→        state.datePricesLoading = false\n   115→      })\n   116→      .addCase(fetchExploreDeals.pending, (state) => {\n   117→        state.dealsLoading = true\n   118→      })\n   119→      .addCase(fetchExploreDeals.fulfilled, (state, action) => {\n   120→        state.deals = action.payload\n   121→        state.dealsLoading = false\n   122→      })\n   123→      .addCase(fetchExploreDeals.rejected, (state) => {\n   124→        state.dealsLoading = false\n   125→      })\n   126→  },\n   127→})\n   128→\n   129→export const { setExploreOrigin, setDateRange } = exploreSlice.actions\n   130→export default exploreSlice.reducer\n   131→"}]},"parent_tool_use_id":"toolu_01KeobCDh8fWJYJx3S5W95f3","session_id":"caed05c8-a48c-4a20-945a-0c006d1f37c2","uuid":"46dc7dc2-2e77-4fc7-9725-e9a3d611f7e3"}
