[2026-03-14T20:38:13.341Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FoWQR1dCrUP8F5Ft5CRfRE","type":"tool_result","content":"     1→import { useMemo } from 'react'\n     2→import { useNavigate } from 'react-router-dom'\n     3→import type { DatePrice, DateRange } from '../slices/exploreSlice'\n     4→import './FlexibleDatesGrid.css'\n     5→\n     6→interface FlexibleDatesGridProps {\n     7→  datePrices: DatePrice[]\n     8→  loading: boolean\n     9→  dateRange: DateRange\n    10→  onDateRangeChange: (range: DateRange) => void\n    11→  originCode: string | null\n    12→}\n    13→\n    14→const DATE_RANGE_OPTIONS: { value: DateRange; label: string }[] = [\n    15→  { value: 'weekend', label: 'Weekend trips' },\n    16→  { value: '1week', label: '1 week' },\n    17→  { value: '2weeks', label: '2 weeks' },\n    18→]\n    19→\n    20→function getReturnDaysForRange(range: DateRange): number {\n    21→  switch (range) {\n    22→    case 'weekend':\n    23→      return 2\n    24→    case '1week':\n    25→      return 7\n    26→    case '2weeks':\n    27→      return 14\n    28→  }\n    29→}\n    30→\n    31→function formatDate(dateStr: string): string {\n    32→  const d = new Date(dateStr + 'T12:00:00')\n    33→  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })\n    34→}\n    35→\n    36→function formatDayName(dateStr: string): string {\n    37→  const d = new Date(dateStr + 'T12:00:00')\n    38→  return d.toLocaleDateString('en-US', { weekday: 'short' })\n    39→}\n    40→\n    41→function FlexibleDatesGrid({ datePrices, loading, dateRange, onDateRangeChange, originCode }: FlexibleDatesGridProps) {\n    42→  const navigate = useNavigate()\n    43→\n    44→  const { minPrice, maxPrice } = useMemo(() => {\n    45→    const prices = datePrices.filter((dp) => dp.price !== null).map((dp) => dp.price!)\n    46→    if (prices.length === 0) return { minPrice: 0, maxPrice: 0 }\n    47→    return { minPrice: Math.min(...prices), maxPrice: Math.max(...prices) }\n    48→  }, [datePrices])\n    49→\n    50→  function getPriceLevel(price: number | null): string {\n    51→    if (price === null) return 'none'\n    52→    if (maxPrice === minPrice) return 'cheap'\n    53→    const ratio = (price - minPrice) / (maxPrice - minPrice)\n    54→    if (ratio < 0.33) return 'cheap'\n    55→    if (ratio < 0.66) return 'moderate'\n    56→    return 'expensive'\n    57→  }\n    58→\n    59→  function handleDateClick(dp: DatePrice) {\n    60→    if (!dp.price || !originCode) return\n    61→    const returnDays = getReturnDaysForRange(dateRange)\n    62→    const returnDate = new Date(dp.date + 'T12:00:00')\n    63→    returnDate.setDate(returnDate.getDate() + returnDays)\n    64→    const retStr = returnDate.toISOString().split('T')[0]\n    65→\n    66→    const params = new URLSearchParams({\n    67→      origin: originCode,\n    68→      departureDate: dp.date,\n    69→      returnDate: retStr!,\n    70→    })\n    71→    navigate(`/results?${params.toString()}`)\n    72→  }\n    73→\n    74→  return (\n    75→    <div className=\"flexible-dates-grid\" data-testid=\"flexible-dates-grid\">\n    76→      <div className=\"flexible-dates-grid__header\">\n    77→        <h3 className=\"flexible-dates-grid__title\">Flexible dates</h3>\n    78→        <div className=\"flexible-dates-grid__range-selector\" data-testid=\"flexible-dates-range-selector\">\n    79→          {DATE_RANGE_OPTIONS.map((opt) => (\n    80→            <button\n    81→              key={opt.value}\n    82→              className={`flexible-dates-grid__range-btn ${dateRange === opt.value ? 'flexible-dates-grid__range-btn--active' : ''}`}\n    83→              onClick={() => onDateRangeChange(opt.value)}\n    84→              data-testid={`date-range-${opt.value}`}\n    85→            >\n    86→              {opt.label}\n    87→            </button>\n    88→          ))}\n    89→        </div>\n    90→      </div>\n    91→\n    92→      <div className=\"flexible-dates-grid__legend\">\n    93→        <div className=\"flexible-dates-grid__legend-item\">\n    94→          <span className=\"flexible-dates-grid__legend-dot flexible-dates-grid__legend-dot--cheap\" />\n    95→          <span>Cheap</span>\n    96→        </div>\n    97→        <div className=\"flexible-dates-grid__legend-item\">\n    98→          <span className=\"flexible-dates-grid__legend-dot flexible-dates-grid__legend-dot--moderate\" />\n    99→          <span>Moderate</span>\n   100→        </div>\n   101→        <div className=\"flexible-dates-grid__legend-item\">\n   102→          <span className=\"flexible-dates-grid__legend-dot flexible-dates-grid__legend-dot--expensive\" />\n   103→          <span>Expensive</span>\n   104→        </div>\n   105→      </div>\n   106→\n   107→      {loading ? (\n   108→        <div className=\"flexible-dates-grid__loading\" data-testid=\"flexible-dates-loading\">\n   109→          <div className=\"flexible-dates-grid__skeleton-grid\">\n   110→            {Array.from({ length: 12 }).map((_, i) => (\n   111→              <div key={i} className=\"flexible-dates-grid__skeleton-cell\" />\n   112→            ))}\n   113→          </div>\n   114→        </div>\n   115→      ) : datePrices.length === 0 ? (\n   116→        <div className=\"flexible-dates-grid__empty\" data-testid=\"flexible-dates-empty\">\n   117→          No price data available for the selected dates\n   118→        </div>\n   119→      ) : (\n   120→        <div className=\"flexible-dates-grid__grid\" data-testid=\"flexible-dates-cells\">\n   121→          {datePrices.map((dp) => {\n   122→            const level = getPriceLevel(dp.price)\n   123→            return (\n   124→              <button\n   125→                key={dp.date}\n   126→                className={`flexible-dates-grid__cell flexible-dates-grid__cell--${level}`}\n   127→                onClick={() => handleDateClick(dp)}\n   128→                disabled={dp.price === null}\n   129→                data-testid={`date-cell-${dp.date}`}\n   130→                title={dp.price !== null ? `$${dp.price} on ${formatDate(dp.date)}` : 'No flights available'}\n   131→              >\n   132→                <span className=\"flexible-dates-grid__cell-day\">{formatDayName(dp.date)}</span>\n   133→                <span className=\"flexible-dates-grid__cell-date\">{formatDate(dp.date)}</span>\n   134→                <span className=\"flexible-dates-grid__cell-price\">\n   135→                  {dp.price !== null ? `$${dp.price}` : '—'}\n   136→                </span>\n   137→              </button>\n   138→            )\n   139→          })}\n   140→        </div>\n   141→      )}\n   142→    </div>\n   143→  )\n   144→}\n   145→\n   146→export default FlexibleDatesGrid\n   147→"}]},"parent_tool_use_id":"toolu_01KeobCDh8fWJYJx3S5W95f3","session_id":"caed05c8-a48c-4a20-945a-0c006d1f37c2","uuid":"c0199919-74f2-4d34-a649-c6f75ca2ebbd"}
