assName=\"flex gap-1 border-b border-border mb-6\">\n    48→        {tabs.map((tab) => (\n    49→          <button\n    50→            key={tab.key}\n    51→            data-testid={`tab-${tab.key}`}\n    52→            onClick={() => setActiveTab(tab.key)}\n    53→            className={`px-4 py-3 text-sm font-medium border-b-2 transition-colors ${\n    54→              activeTab === tab.key\n    55→                ? 'border-text text-text'\n    56→                : 'border-transparent text-text-secondary hover:text-text hover:border-border-dark'\n    57→            }`}\n    58→          >\n    59→            {tab.label}\n    60→          </button>\n    61→        ))}\n    62→      </div>\n    63→\n    64→      <div data-testid=\"trips-list\">\n    65→        {filtered.length === 0 ? (\n    66→          <div data-testid=\"trips-empty-state\" className=\"text-center py-12\">\n    67→            <p className=\"text-text-secondary text-lg\">\n    68→              {activeTab === 'upcoming' && 'No upcoming trips'}\n    69→              {activeTab === 'past' && 'No past trips'}\n    70→              {activeTab === 'cancelled' && 'No cancelled trips.'}\n    71→            </p>\n    72→            {activeTab === 'upcoming' && (\n    73→              <Link\n    74→                to=\"/\"\n    75→                className=\"inline-block mt-3 text-primary hover:text-primary-dark font-medium\"\n    76→              >\n    77→                Browse properties\n    78→              </Link>\n    79→            )}\n    80→          </div>\n    81→        ) : (\n    82→          <div className=\"grid gap-4\">\n    83→            {filtered.map((booking) => (\n    84→              <TripCard\n    85→                key={booking.id}\n    86→                booking={booking}\n    87→                onCancel={() => onCancelBooking(booking)}\n    88→              />\n    89→            ))}\n    90→          </div>\n    91→        )}\n    92→      </div>\n    93→    </div>\n    94→  )\n    95→}\n    96→"}]},"parent_tool_use_id":null,"session_id":"6c9eec15-4aa7-4280-9f57-4071abbe9889","uuid":"82eee535-3d9a-4313-8ce6-1e5a9c07192f","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/components/TripsTabs.tsx","content":"import { useState } from 'react'\nimport type { Booking } from '../slices/bookingsSlice'\nimport TripCard from './TripCard'\nimport { Link } from 'react-router-dom'\n\ntype TabKey = 'upcoming' | 'past' | 'cancelled'\n\ninterface TripsTabsProps {\n  bookings: Booking[]\n  onCancelBooking: (booking: Booking) => void\n}\n\nconst tabs: { key: TabKey; label: string }[] = [\n  { key: 'upcoming', label: 'Upcoming' },\n  { key: 'past', label: 'Past' },\n  { key: 'cancelled', label: 'Cancelled' },\n]\n\nfunction filterBookings(bookings: Booking[], tab: TabKey): Booking[] {\n  const today = new Date().toISOString().split('T')[0]\n  switch (tab) {\n    case 'upcoming':\n      return bookings\n        .filter(\n          (b) =>\n            (b.status === 'pending' || b.status === 'confirmed') &&\n            b.check_in.split('T')[0]! >= today!\n        )\n        .sort((a, b) => a.check_in.localeCompare(b.check_in))\n    case 'past':\n      return bookings\n        .filter((b) => b.status === 'completed')\n        .sort((a, b) => a.check_in.localeCompare(b.check_in))\n    case 'cancelled':\n      return bookings\n        .filter((b) => b.status === 'cancelled')\n        .sort((a, b) => a.check_in.localeCompare(b.check_in))\n  }\n}\n\nexport default function TripsTabs({ bookings, onCancelBooking }: TripsTabsProps) {\n  const [activeTab, setActiveTab] = useState<TabKey>('upcoming')\n  const filtered = filterBookings(bookings, activeTab)\n\n  return (\n    <div data-testid=\"trips-tabs\">\n      <div className=\"flex gap-1 border-b border-border mb-6\">\n        {tabs.map((tab) => (\n          <button\n            key={tab.key}\n            data-testid={`tab-${tab.key}`}\n            onClick={() => setActiveTab(tab.key)}\n            className={`px-4 py-3 text-sm font-medium border-b-2 transition-colors ${\n              activeTab === tab.key\n                ? 'border-text text-text'\n                : 'border-transparent text-text-secondary hover:text-text hover:border-border-dark'\n            }`}\n          >\n            {tab.label}\n          </button>\n        ))}\n      </div>\n\n      <div data-testid=\"trips-list\">\n        {filtered.length === 0 ? (\n          <div data-testid=\"trips-empty-state\" className=\"text-center py-12\">\n            <p className=\"text-text-secondary text-lg\">\n              {activeTab === 'upcoming' && 'No upcoming trips'}\n              {activeTab === 'past' && 'No past trips'}\n              {activeTab === 'cancelled' && 'No cancelled trips.'}\n            </p>\n            {activeTab === 'upcoming' && (\n              <Link\n                to=\"/\"\n                className=\"inline-block mt-3 text-primary hover:text-primary-dark font-medium\"\n              >\n                Browse properties\n              </Link>\n            )}\n          </div>\n        ) : (\n          <div className=\"grid gap-4\">\n            {filtered.map((booking) => (\n              <TripCard\n                key={booking.id}\n                booking={booking}\n                onCancel={() => onCancelBooking(booking)}\n              />\n            ))}\n          </div>\n        )}\n      </div>\n    </div>\n  )\n}\n","numLines":96,"startLine":1,"totalLines":96}}}
