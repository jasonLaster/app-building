[2026-03-16T03:17:33.942Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CkiVFEHRWj8HbmhKYtNwib","type":"tool_result","content":"     1→import { useState, useEffect, useCallback, useRef } from 'react'\n     2→import { useSelector, useDispatch } from 'react-redux'\n     3→import { useNavigate } from 'react-router-dom'\n     4→import { ChevronLeft, ChevronRight, ChevronDown } from 'lucide-react'\n     5→import type { RootState, AppDispatch } from '../store'\n     6→import type { Property } from '../slices/propertiesSlice'\n     7→import { createBooking, clearBookingError } from '../slices/bookingsSlice'\n     8→\n     9→interface BookingCardProps {\n    10→  property: Property\n    11→}\n    12→\n    13→interface BookedRange {\n    14→  check_in: string\n    15→  check_out: string\n    16→}\n    17→\n    18→function getDaysInMonth(year: number, month: number): number {\n    19→  return new Date(year, month + 1, 0).getDate()\n    20→}\n    21→\n    22→function getFirstDayOfWeek(year: number, month: number): number {\n    23→  return new Date(year, month, 1).getDay()\n    24→}\n    25→\n    26→function formatDateStr(year: number, month: number, day: number): string {\n    27→  return `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`\n    28→}\n    29→\n    30→function isDateBooked(dateStr: string, bookedRanges: BookedRange[]): boolean {\n    31→  for (const range of bookedRanges) {\n    32→    if (dateStr >= range.check_in && dateStr < range.check_out) {\n    33→      return true\n    34→    }\n    35→  }\n    36→  return false\n    37→}\n    38→\n    39→function isDateInPast(dateStr: string, todayStr: string): boolean {\n    40→  return dateStr < todayStr\n    41→}\n    42→\n    43→const MONTH_NAMES = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']\n    44→const DAY_NAMES = ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa']\n    45→\n    46→function CalendarMonth({\n    47→  year,\n    48→  month,\n    49→  todayStr,\n    50→  bookedRanges,\n    51→  checkIn,\n    52→  checkOut,\n    53→  onSelectDate,\n    54→}: {\n    55→  year: number\n    56→  month: number\n    57→  todayStr: string\n    58→  bookedRanges: BookedRange[]\n    59→  checkIn: string\n    60→  checkOut: string\n    61→  onSelectDate: (dateStr: string) => void\n    62→}) {\n    63→  const daysInMonth = getDaysInMonth(year, month)\n    64→  const firstDay = getFirstDayOfWeek(year, month)\n    65→\n    66→  const cells: (number | null)[] = []\n    67→  for (let i = 0; i < firstDay; i++) cells.push(null)\n    68→  for (let d = 1; d <= daysInMonth; d++) cells.push(d)\n    69→\n    70→  return (\n    71→    <div role=\"grid\" aria-label={`${MONTH_NAMES[month]} ${year}`}>\n    72→      <div className=\"text-center text-sm font-semibold text-text mb-3\">\n    73→        {MONTH_NAMES[month]} {year}\n    74→      </div>\n    75→      <div className=\"grid grid-cols-7 gap-0\">\n    76→        {DAY_NAMES.map((d) => (\n    77→          <div key={d} className=\"text-center text-xs font-semibold text-text-secondary py-1\" role=\"columnheader\">\n    78→            {d}\n    79→          </div>\n    80→        ))}\n    81→        {cells.map((day, idx) => {\n    82→          if (day === null) {\n    83→            return <div key={`empty-${idx}`} className=\"h-10\" />\n    84→          }\n    85→          const dateStr = formatDateStr(year, month, day)\n    86→          const isPast = isDateInPast(dateStr, todayStr)\n    87→          const booked = isDateBooked(dateStr, bookedRanges)\n    88→          const disabled = isPast || booked\n    89→          const isCheckIn = dateStr === checkIn\n    90→          const isCheckOut = dateStr === checkOut\n    91→          const isSelected = isCheckIn || isCheckOut\n    92→          const inRange = checkIn && checkOut && dateStr > checkIn && dateStr < checkOut\n    93→\n    94→          return (\n    95→            <button\n    96→              key={dateStr}\n    97→              data-testid={`calendar-day-${dateStr}`}\n    98→              disabled={disabled}\n    99→              onClick={() => !disabled && onSelectDate(dateStr)}\n   100→              aria-label={`${MONTH_NAMES[month]} ${day}, ${year}${isCheckIn ? ' (check-in)' : ''}${isCheckOut ? ' (checkout)' : ''}${booked ? ' (unavailable)' : ''}${isPast ? ' (past date)' : ''}`}\n   101→              aria-pressed={isSelected}\n   102→              className={`h-10 w-full text-sm rounded-full transition-colors cursor-pointer\n   103→                ${disabled ? 'text-border line-through cursor-not-allowed' : 'hover:bg-bg-secondary text-text'}\n   104→                ${isSelected ? 'bg-text text-white hover:bg-text' : ''}\n   105→                ${inRange ? 'bg-bg-secondary' : ''}\n   106→                ${booked ? 'bg-bg-secondary' : ''}\n   107→              `}\n   108→            >\n   109→              {day}\n   110→            </button>\n   111→          )\n   112→        })}\n   113→      </div>\n   114→    </div>\n   115→  )\n   116→}\n   117→\n   118→export default function BookingCard({ property }: BookingCardProps) {\n   119→  const dispatch = useDispatch<AppDispatch>()\n   120→  const navigate = useNavigate()\n   121→  const currentUser = useSelector((state: RootState) => state.auth.currentUser)\n   122→  const { loading, error } = useSelector((state: RootState) => state.bookings)\n   123→\n   124→  const [checkIn, setCheckIn] = useState('')\n   125→  const [checkOut, setCheckOut] = useState('')\n   126→  const [guests, setGuests] = useState(1)\n   127→  const [success, setSuccess] = useState(false)\n   128→  const [calendarOpen, setCalendarOpen] = useState(false)\n   129→  const [bookedRanges, setBookedRanges] = useState<BookedRange[]>([])\n   130→\n   131→  const now = new Date()\n   132→  const todayStr = formatDateStr(now.getFullYear(), now.getMonth(), now.getDate())\n   133→  const [calMonth, setCalMonth] = useState(now.getMonth())\n   134→  const [calYear, setCalYear] = useState(now.getFullYear())\n   135→  const [guestDropdownOpen, setGuestDropdownOpen] = useState(false)\n   136→  const guestDropdownRef = useRef<HTMLDivElement>(null)\n   137→\n   138→  useEffect(() => {\n   139→    function handleClickOutside(e: MouseEvent) {\n   140→      if (guestDropdownRef.current && !guestDropdownRef.current.contains(e.target as Node)) {\n   141→        setGuestDropdownOpen(false)\n   142→      }\n   143→    }\n   144→    document.addEventListener('mousedown', handleClickOutside)\n   145→    return () => document.removeEventListener('mousedown', handleClickOutside)\n   146→  }, [])\n   147→\n   148→  const isOwnProperty = currentUser?.id === property.host_id\n   149→\n   150→  useEffect(() => {\n   151→    fetch(`/api/bookings?property_id=${property.id}`)\n   152→      .then((r) => r.json())\n   153→      .then((data) => {\n   154→        if (Array.isArray(data)) {\n   155→          setBookedRanges(data.map((b: { check_in: string; check_out: string }) => ({\n   156→            check_in: b.check_in.slice(0, 10),\n   157→            check_out: b.check_out.slice(0, 10),\n   158→          })))\n   159→        }\n   160→      })\n   161→      .catch(() => {})\n   162→  }, [property.id])\n   163→\n   164→  const handleSelectDate = useCallback((dateStr: string) => {\n   165→    if (!checkIn || (checkIn && checkOut)) {\n   166→      setCheckIn(dateStr)\n   167→      setCheckOut('')\n   168→    } else {\n   169→      if (dateStr <= checkIn) {\n   170→        setCheckIn(dateStr)\n   171→        setCheckOut('')\n   172→      } else {\n   173→        // Check if any booked date is between checkIn and this date\n   174→        const hasBlockedInRange = bookedRanges.some(\n   175→          (r) => r.check_in < dateStr && r.check_out > checkIn\n   176→        )\n   177→        if (hasBlockedInRange) {\n   178→          setCheckIn(dateStr)\n   179→          setCheckOut('')\n   180→        } else {\n   181→          setCheckOut(dateStr)\n   182→        }\n   183→      }\n   184→    }\n   185→  }, [checkIn, checkOut, bookedRanges])\n   186→\n   187→  const handlePrevMonth = () => {\n   188→    if (calMonth === 0) {\n   189→      setCalMonth(11)\n   190→      setCalYear(calYear - 1)\n   191→    } else {\n   192→      setCalMonth(calMonth - 1)\n   193→    }\n   194→  }\n   195→\n   196→  const handleNextMonth = () => {\n   197→    if (calMonth === 11) {\n   198→      setCalMonth(0)\n   199→      setCalYear(calYear + 1)\n   200→    } else {\n   201→      setCalMonth(calMonth + 1)\n   202→    }\n   203→  }\n   204→\n   205→  const nextMonth = calMonth === 11 ? 0 : calMonth + 1\n   206→  const nextYear = calMonth === 11 ? calYear + 1 : calYear\n   207→\n   208→  const nights =\n   209→    checkIn && checkOut\n   210→      ? Math.max(0, Math.round((new Date(checkOut).getTime() - new Date(checkIn).getTime()) / (1000 * 60 * 60 * 24)))\n   211→      : 0\n   212→\n   213→  const nightlyTotal = nights * Number(property.price_per_night)\n   214→  const cleaningFee = Number(property.cleaning_fee)\n   215→  const total = nightlyTotal + cleaningFee\n   216→\n   217→  const canReserve = checkIn && checkOut && nights > 0 && !isOwnProperty && currentUser && !loading\n   218→\n   219→  const handleReserve = async () => {\n   220→    if (!currentUser) {\n   221→      navigate('/login')\n   222→      return\n   223→    }\n   224→    if (!checkIn || !checkOut || isOwnProperty) return\n   225→\n   226→    dispatch(clearBookingError())\n   227→    const result = await dispatch(\n   228→      createBooking({\n   229→        property_id: property.id,\n   230→        guest_id: currentUser.id,\n   231→        check_in: checkIn,\n   232→        check_out: checkOut,\n   233→        num_guests: guests,\n   234→        total_price: total,\n   235→      })\n   236→    )\n   237→    if (createBooking.fulfilled.match(result)) {\n   238→      setSuccess(true)\n   239→      setTimeout(() => navigate('/trips'), 1500)\n   240→    }\n   241→  }\n   242→\n   243→  const formatDisplayDate = (d: string) => {\n   244→    if (!d) return ''\n   245→    const date = new Date(d + 'T00:00:00')\n   246→    return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })\n   247→  }\n   248→\n   249→  return (\n   250→    <aside data-testid=\"booking-card\" className=\"border border-border rounded-xl p-6 shadow-lg sticky top-[96px]\" aria-label=\"Booking\">\n   251→      {nights > 0 ? (\n   252→        <div className=\"flex items-baseline gap-1 mb-5\">\n   253→          <span className=\"text-[22px] font-semibold text-text\">${Number(property.price_per_night).toFixed(0)}</span>\n   254→          <span className=\"text-text-secondary\">night</span>\n   255→        </div>\n   256→      ) : (\n   257→        <p className=\"text-[22px] font-semibold text-text mb-5\">Add dates for prices</p>\n   258→      )}\n   259→\n   260→      <div className=\"border border-border rounded-lg overflow-hidden mb-4\">\n   261→        <button\n   262→          type=\"button\"\n   263→          className=\"grid grid-cols-2 cursor-pointer w-full text-left bg-transparent border-0 p-0\"\n   264→          onClick={() => setCalendarOpen(!calendarOpen)}\n   265→          aria-expanded={calendarOpen}\n   266→          aria-label=\"Select check-in and checkout dates\"\n   267→        >\n   268→          <div className=\"p-3 border-r border-border\">\n   269→            <span className=\"block text-[10px] font-bold text-text uppercase tracking-wide\">Check-in</span>\n   270→            <p data-testid=\"booking-checkin\" className=\"text-sm text-text-secondary mt-0.5\">\n   271→              {checkIn ? formatDisplayDate(checkIn) : 'Add date'}\n   272→            </p>\n   273→          </div>\n   274→          <div className=\"p-3\">\n   275→            <span className=\"block text-[10px] font-bold text-text uppercase tracking-wide\">Checkout</span>\n   276→            <p data-testid=\"booking-checkout\" className=\"text-sm text-text-secondary mt-0.5\">\n   277→              {checkOut ? formatDisplayDate(checkOut) : 'Add date'}\n   278→            </p>\n   279→          </div>\n   280→        </button>\n   281→        <div className=\"border-t border-border p-3 relative\" ref={guestDropdownRef}>\n   282→          <span id=\"guests-label\" className=\"block text-[10px] font-bold text-text uppercase tracking-wide\">Guests</span>\n   283→          <button\n   284→            data-testid=\"booking-guests\"\n   285→            data-value={String(guests)}\n   286→            type=\"button\"\n   287→            onClick={() => setGuestDropdownOpen(!guestDropdownOpen)}\n   288→            aria-expanded={guestDropdownOpen}\n   289→            aria-haspopup=\"listbox\"\n   290→            aria-labelledby=\"guests-label\"\n   291→            className=\"w-full flex items-center justify-between text-sm text-text bg-transparent outline-none mt-0.5 cursor-pointer\"\n   292→          >\n   293→            <span>{guests} {guests === 1 ? 'guest' : 'guests'}</span>\n   294→            <ChevronDown size={16} aria-hidden=\"true\" className={`transition-transform ${guestDropdownOpen ? 'rotate-180' : ''}`} />\n   295→          </button>\n   296→          {guestDropdownOpen && (\n   297→            <div data-testid=\"booking-guests-dropdown\" role=\"listbox\" aria-label=\"Number of guests\" className=\"absolute left-0 right-0 top-full mt-1 bg-bg border border-border rounded-lg shadow-lg z-50 max-h-48 overflow-y-auto\">\n   298→              {Array.from({ length: property.max_guests }, (_, i) => i + 1).map((n) => (\n   299→                <button\n   300→                  key={n}\n   301→                  data-testid={`guest-option-${n}`}\n   302→                  type=\"button\"\n   303→                  role=\"option\"\n   304→                  aria-selected={guests === n}\n   305→                  onClick={() => { setGuests(n); setGuestDropdownOpen(false) }