, Washington, Jun 15-20, $1475\n    43→    await loginAs(page, 'emma@example.com')\n    44→    await page.goto('/trips')\n    45→\n    46→    await expect(page.getByTestId('my-trips-page')).toBeVisible({ timeout: 30000 })\n    47→\n    48→    const card = page.getByTestId('trip-card-e6666666-6666-6666-6666-666666666666')\n    49→    await expect(card).toBeVisible({ timeout: 30000 })\n    50→\n    51→    // Property title\n    52→    await expect(card).toContainText('Historic Townhouse in Georgetown')\n    53→    // City\n    54→    await expect(card).toContainText('Washington')\n    55→    // Date range (Jun 15, 2026 – Jun 20, 2026)\n    56→    await expect(card).toContainText('Jun 15, 2026')\n    57→    await expect(card).toContainText('Jun 20, 2026')\n    58→    // Status badge\n    59→    await expect(page.getByTestId('status-badge-e6666666-6666-6666-6666-666666666666')).toHaveText('Confirmed')\n    60→    // Total price\n    61→    await expect(card).toContainText('$1475')\n    62→    // Property image\n    63→    await expect(card.locator('img')).toBeVisible()\n    64→  })\n    65→\n    66→  test('Trip card displays correct status badge colors', async ({ page }) => {\n    67→    test.slow()\n    68→    // Emma has pending (e3333333) and confirmed (e6666666) in upcoming, completed (e1111111) in past\n    69→    await loginAs(page, 'emma@example.com')\n    70→    await page.goto('/trips')\n    71→\n    72→    await expect(page.getByTestId('my-trips-page')).toBeVisible({ timeout: 30000 })\n    73→\n    74→    // Pending badge - yellow\n    75→    const pendingBadge = page.getByTestId('status-badge-e3333333-3333-3333-3333-333333333333')\n    76→    await expect(pendingBadge).toBeVisible({ timeout: 30000 })\n    77→    await expect(pendingBadge).toHaveText('Pending')\n    78→    await expect(pendingBadge).toHaveClass(/text-status-pending/)\n    79→\n    80→    // Confirmed badge - green"}]},"parent_tool_use_id":"toolu_01C4PVCkM2PjJ1ydMSBaC6mJ","session_id":"6c9eec15