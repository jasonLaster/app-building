yTestId('team-settings-description-input');\n   247→    await expect(descInput).toBeVisible({ timeout: 10000 });\n   248→\n   249→    // Clear the description\n   250→    await descInput.fill('');\n   251→    await descInput.blur();\n   252→\n   253→    // Description should show placeholder/empty state\n   254→    await expect(page.getByTestId('team-settings-description-value')).toContainText(\n   255→      'No description',\n   256→      { timeout: 15000 }\n   257→    );\n   258→  });\n   259→\n   260→  test('Delete team button shows confirmation dialog', async ({ page, baseURL }) => {\n   261→    await loginAndNavigateToTeamSettings(page, baseURL!, 'ENG');\n   262→\n   263→    // Click Delete Team button\n   264→    await page.getByTestId('team-settings-delete-btn').click();\n   265→\n   266→    // Confirmation dialog should appear\n   267→    await expect(page.getByTestId('team-settings-delete-confirm')).toBeVisible({ timeout: 10000 });\n   268→\n   269→    // Dialog should mention the team name\n   270→    await expect(page.getByTestId('team-settings-delete-confirm')).toContainText('Engineering');\n   271→    await expect(page.getByTestId('team-settings-delete-confirm')).toContainText('cannot be undone');\n   272→\n   273→    // Confirm and Cancel buttons should be visible\n   274→    await expect(page.getByTestId('team-settings-confirm-delete-btn')).toBeVisible();\n   275→    await expect(page.getByTestId('team-settings-cancel-delete-btn')).toBeVisible();\n   276→\n   277→    // Team should NOT be deleted yet - cancel and verify\n   278→    await page.getByTestId('team-settings-cancel-delete-btn').click();\n   279→    await expect(page.getByTestId('team-settings-delete-confirm')).toHaveCount(0, { timeout: 10000 });\n   280→\n   281→    // Team settings should still be visible\n   282→    await expect(page.getByTestId('team-settings')).toBeVisible();\n   283→    await expect(page.getByTestId('team-settings-name-value')).toHaveText(/Engineering/);\n   284→  });\