[2026-03-14T23:16:41.358Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TfpjJLXDPAeqBNjK1fQ78e","type":"tool_result","content":"     1→import { createSlice, createAsyncThunk } from '@reduxjs/toolkit';\n     2→\n     3→export interface MemberTeam {\n     4→  id: string;\n     5→  name: string;\n     6→}\n     7→\n     8→export interface Member {\n     9→  id: string;\n    10→  name: string;\n    11→  email: string;\n    12→  role: string;\n    13→  teams: MemberTeam[];\n    14→}\n    15→\n    16→interface MembersState {\n    17→  items: Member[];\n    18→  currentUserId: string | null;\n    19→  loading: boolean;\n    20→  error: string | null;\n    21→}\n    22→\n    23→const initialState: MembersState = {\n    24→  items: [],\n    25→  currentUserId: null,\n    26→  loading: false,\n    27→  error: null,\n    28→};\n    29→\n    30→export const fetchMembers = createAsyncThunk(\n    31→  'members/fetchMembers',\n    32→  async (_, { getState, rejectWithValue }) => {\n    33→    const state = getState() as { auth: { token: string | null } };\n    34→    const token = state.auth.token;\n    35→    if (!token) return rejectWithValue('No token');\n    36→    const response = await fetch('/api/members', {\n    37→      headers: { Authorization: `Bearer ${token}` },\n    38→    });\n    39→    if (!response.ok) {\n    40→      return rejectWithValue('Failed to fetch members');\n    41→    }\n    42→    const data = await response.json();\n    43→    return data as { members: Member[]; currentUserId: string };\n    44→  }\n    45→);\n    46→\n    47→export const inviteMember = createAsyncThunk(\n    48→  'members/inviteMember',\n    49→  async (email: string, { getState, rejectWithValue }) => {\n    50→    const state = getState() as { auth: { token: string | null } };\n    51→    const token = state.auth.token;\n    52→    if (!token) return rejectWithValue('No token');\n    53→    const response = await fetch('/api/members', {\n    54→      method: 'POST',\n    55→      headers: {\n    56→        Authorization: `Bearer ${token}`,\n    57→        'Content-Type': 'application/json',\n    58→      },\n    59→      body: JSON.stringify({ email }),\n    60→    });\n    61→    const data = await response.json();\n    62→    if (!response.ok) {\n    63→      return rejectWithValue(data.error || 'Failed to invite member');\n    64→    }\n    65→    return data.member as Member;\n    66→  }\n    67→);\n    68→\n    69→export const updateMemberRole = createAsyncThunk(\n    70→  'members/updateMemberRole',\n    71→  async ({ memberId, role }: { memberId: string; role: string }, { getState, rejectWithValue }) => {\n    72→    const state = getState() as { auth: { token: string | null } };\n    73→    const token = state.auth.token;\n    74→    if (!token) return rejectWithValue('No token');\n    75→    const response = await fetch(`/api/members/${memberId}`, {\n    76→      method: 'PUT',\n    77→      headers: {\n    78→        Authorization: `Bearer ${token}`,\n    79→        'Content-Type': 'application/json',\n    80→      },\n    81→      body: JSON.stringify({ role }),\n    82→    });\n    83→    const data = await response.json();\n    84→    if (!response.ok) {\n    85→      return rejectWithValue(data.error || 'Failed to update role');\n    86→    }\n    87→    return { memberId, role };\n    88→  }\n    89→);\n    90→\n    91→export const removeMember = createAsyncThunk(\n    92→  'members/removeMember',\n    93→  async (memberId: string, { getState, rejectWithValue }) => {\n    94→    const state = getState() as { auth: { token: string | null } };\n    95→    const token = state.auth.token;\n    96→    if (!token) return rejectWithValue('No token');\n    97→    const response = await fetch(`/api/members/${memberId}`, {\n    98→      method: 'DELETE',\n    99→      headers: { Authorization: `Bearer ${token}` },\n   100→    });\n   101→    const data = await response.json();\n   102→    if (!response.ok) {\n   103→      return rejectWithValue(data.error || 'Failed to remove member');\n   104→    }\n   105→    return memberId;\n   106→  }\n   107→);\n   108→\n   109→const membersSlice = createSlice({\n   110→  name: 'members',\n   111→  initialState,\n   112→  reducers: {},\n   113→  extraReducers: (builder) => {\n   114→    builder\n   115→      .addCase(fetchMembers.pending, (state) => {\n   116→        if (state.items.length === 0) {\n   117→          state.loading = true;\n   118→        }\n   119→        state.error = null;\n   120→      })\n   121→      .addCase(fetchMembers.fulfilled, (state, action) => {\n   122→        state.loading = false;\n   123→        state.items = action.payload.members;\n   124→        state.currentUserId = action.payload.currentUserId;\n   125→      })\n   126→      .addCase(fetchMembers.rejected, (state, action) => {\n   127→        state.loading = false;\n   128→        state.error = action.payload as string;\n   129→      })\n   130→      .addCase(inviteMember.fulfilled, (state, action) => {\n   131→        state.items.push(action.payload);\n   132→      })\n   133→      .addCase(updateMemberRole.fulfilled, (state, action) => {\n   134→        const member = state.items.find((m) => m.id === action.payload.memberId);\n   135→        if (member) {\n   136→          member.role = action.payload.role;\n   137→        }\n   138→      })\n   139→      .addCase(removeMember.fulfilled, (state, action) => {\n   140→        state.items = state.items.filter((m) => m.id !== action.payload);\n   141→      });\n   142→  },\n   143→});\n   144→\n   145→export default membersSlice.reducer;\n   146→"}]},"parent_tool_use_id":"toolu_01Np1AN1fVGdaKZVvC39yjxs","session_id":"f9321a9c-0239-4074-b682-a2d2574835de","uuid":"8a03506b-bd29-4f29-aca2-a517d6d66e22"}
