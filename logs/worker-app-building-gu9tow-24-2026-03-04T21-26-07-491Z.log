gh\"\n    49→    await expect(todoItem.getByTestId('priority-badge')).toContainText('High')\n    50→\n    51→    // Due date shows \"Today\"\n    52→    await expect(todoItem.getByTestId('due-date')).toContainText('Today')\n    53→\n    54→    // Delete button is present (visible on hover)\n    55→    await todoItem.hover()\n    56→    await expect(todoItem.getByTestId('delete-button')).toBeVisible()\n    57→  })\n    58→\n    59→  test('Priority badge displays correct colors for each level', async ({ page }) => {\n    60→    const sql = getTestSql()\n    61→    if (sql) {\n    62→      await sql`TRUNCATE TABLE todos`\n    63→      await sql`\n    64→        INSERT INTO todos (title, completed, priority) VALUES\n    65→        ('Low priority task', false, 'low'),\n    66→        ('Medium priority task', false, 'medium'),\n    67→        ('High priority task', false, 'high')\n    68→      `\n    69→    }\n    70→    await page.goto('/')\n    71→\n    72→    const todoItems = page.getByTestId('todo-item')\n    73→    await expect(todoItems).toHaveCount(3, { timeout: 10000 })\n    74→\n    75→    // Each priority badge has distinct styling classes\n    76→    const lowItem = page.getByTestId('todo-item').filter({ hasText: 'Low priority task' })\n    77→    const medItem = page.getByTestId('todo-item').filter({ hasText: 'Medium priority task' })\n    78→    const highItem = page.getByTestId('todo-item').filter({ hasText: 'High priority task' })\n    79→\n    80→    const lowBadge = lowItem.getByTestId('priority-badge')\n    81→    const medBadge = medItem.getByTestId('priority-badge')\n    82→    const highBadge = highItem.getByTestId('priority-badge')\n    83→\n    84→    await expect(lowBadge).toContainText('Low')\n    85→    await expect(medBadge).toContainText('Medium')\n    86→    await expect(highBadge).toContainText('High')\n    87→\n    88→    // Verify they have distinct background colors\n    89→    const lowBg = await lowBadge.evaluate((el) => getComputedStyle(el).backgroundColor)\n    90→    const medBg = await medBadge.evaluate((el) => getComputedStyle(el).backgroundColor)\n    91→    const highBg = await highBadge.evaluate((el) => getComputedStyle(el).backgroundColor)\n    92→\n    93→    expect(lowBg).not.toBe(medBg)\n    94→    expect(medBg).not.toBe(highBg)\n    95→    expect(lowBg).not.toBe(highBg)\n    96→  })\n    97→\n    98→  test('Due date shows Today for todos due today', async ({ page }) => {\n    99→    const today = getTodayDate()\n   100→    const sql = getTestSql()\n   101→    if (sql) {\n   102→      await sql`TRUNCATE TABLE todos`\n   103→      await sql`\n   104→        INSERT INTO todos (title, completed, priority, due_date) VALUES\n   105→        ('Today task', false, 'medium', ${today})\n   106→      `\n   107→    }\n   108→    await page.goto('/')\n   109→\n   110→    const todoItem = page.getByTestId('todo-item').filter({ hasText: 'Today task' })\n   111→    await expect(todoItem).toBeVisible({ timeout: 10000 })\n   112→    await expect(todoItem.getByTestId('due-date')).toContainText('Today')\n   113→  })\n   114→\n   115→  test('Due date shows Tomorrow for todos due tomorrow', async ({ page }) => {\n   116→    const tomorrow = getTomorrowDate()\n   117→    const sql = getTestSql()\n   118→    if (sql) {\n   119→      await sql`TRUNCATE TABLE todos`\n   120→      await sql`\n   121→        INSERT INTO todos (title, completed, priority, due_date) VALUES\n   122→        ('Tomorrow task', false, 'medium', ${tomorrow})\n   123→      `\n   124→    }\n   125→    await page.goto('/')\n   126→\n   127→    const todoItem = page.getByTestId('todo-item').filter({ hasText: 'Tomorrow task' })\n   128→    await expect(todoItem).toBeVisible({ timeout: 10000 })\n   129→    await expect(todoItem.getByTestId('due-date')).toContainText('Tomorrow')\n   130→  })\n   131→\n   132→  test('Due date shows Overdue for todos past their due date', async ({ page }) => {\n   133→    const yesterday = getYesterdayDate()\n   