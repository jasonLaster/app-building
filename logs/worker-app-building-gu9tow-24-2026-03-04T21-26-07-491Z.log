edItem).toBeVisible({ timeout: 10000 })\n   221→\n   222→    // Check strikethrough on the text\n   223→    await expect(completedItem.getByTestId('todo-text')).toHaveClass(/line-through/)\n   224→\n   225→    // Check reduced opacity on the todo item container\n   226→    await expect(completedItem).toHaveClass(/opacity-60/)\n   227→  })\n   228→\n   229→  test('Delete button appears on hover', async ({ page }) => {\n   230→    // Seed data has 'Clean the house'\n   231→    await page.goto('/')\n   232→\n   233→    const todoItem = page.getByTestId('todo-item').filter({ hasText: 'Clean the house' })\n   234→    await expect(todoItem).toBeVisible({ timeout: 10000 })\n   235→\n   236→    // Delete button has opacity-0 by default (hidden via CSS)\n   237→    const deleteButton = todoItem.getByTestId('delete-button')\n   238→    await expect(deleteButton).toHaveCSS('opacity', '0')\n   239→\n   240→    // Hover over the todo item to reveal the delete button\n   241→    await todoItem.hover()\n   242→    await expect(deleteButton).toHaveCSS('opacity', '1', { timeout: 5000 })\n   243→  })\n   244→\n   245→  test('Delete a todo with confirmation', async ({ page }) => {\n   246→    const sql = getTestSql()\n   247→    if (sql) {\n   248→      await sql`TRUNCATE TABLE todos`\n   249→      await sql`\n   250→        INSERT INTO todos (title, completed, priority) VALUES\n   251→        ('Clean house', false, 'medium'),\n   252→        ('Task two', false, 'low'),\n   253→        ('Task three', false, 'high')\n   254→      `\n   255→    }\n   256→    await page.goto('/')\n   257→\n   258→    const todoItems = page.getByTestId('todo-item')\n   259→    await expect(todoItems).toHaveCount(3, { timeout: 10000 })\n   260→\n   261→    // Header shows 3 items left\n   262→    await expect(page.getByTestId('todo-count')).toContainText('3 items left', { timeout: 10000 })\n   263→\n   264→    // Set up dialog handler to accept confirmation\n   265→    page.on('dialog', (dialog) => dialog.accept())\n   266→\n   267→    // Hover and click delete\n   268→    const todoItem = page.getByTestId('todo-item').filter({ hasText: 'Clean house' })\n   269→    await todoItem.hover()\n   270→    await todoItem.getByTestId('delete-button').click()\n   271→\n   272→    // Todo should be removed from the list\n   273→    await expect(\n   274→      page.getByTestId('todo-item').filter({ hasText: 'Clean house' })\n   275→    ).toHaveCount(0, { timeout: 10000 })\n   276→\n   277→    // 2 todos remain\n   278→    await expect(todoItems).toHaveCount(2, { timeout: 10000 })\n   279→\n   280→    // Header count decreased\n   281→    await expect(page.getByTestId('todo-count')).toContainText('2 items left', { timeout: 10000 })\n   282→  })\n   283→\n   284→  test('Cancel todo deletion via confirmation prompt', async ({ page }) => {\n   285→    const sql = getTestSql()\n   286→    if (sql) {\n   287→      await sql`TRUNCATE TABLE todos`\n   288→      await sql`\n   289→        INSERT INTO todos (title, completed, priority) VALUES\n   290→        ('Clean house', false, 'medium'),\n   291→        ('Task two', false, 'low'),\n   292→        ('Task three', false, 'high')\n   293→      `\n   294→    }\n   295→    await page.goto('/')\n   296→\n   297→    const todoItems = page.getByTestId('todo-item')\n   298→    await expect(todoItems).toHaveCount(3, { timeout: 10000 })\n   299→\n   300→    // Set up dialog handler to dismiss/cancel confirmation\n   301→    page.on('dialog', (dialog) => dialog.dismiss())\n   302→\n   303→    // Hover and click delete\n   304→    const todoItem = page.getByTestId('todo-item').filter({ hasText: 'Clean house' })\n   305→    await todoItem.hover()\n   306→    await todoItem.getByTestId('delete-button').click()\n   307→\n   308→    // Todo should still be in the list\n   309→    await expect(\n   310→      page.getByTestId('todo-item').filter({ hasText: 'Clean house' })\n   311→    ).toBeVisible({ timeout: 10000 })\n   312→\n   313→    // All 3 todos