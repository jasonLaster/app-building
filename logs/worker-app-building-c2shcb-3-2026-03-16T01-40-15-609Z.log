f (!body.teamId || !body.name || !body.startDate || !body.endDate) {\n    94→        return new Response(JSON.stringify({ error: 'All fields are required' }), {\n    95→          status: 400,\n    96→          headers: { 'Content-Type': 'application/json' },\n    97→        });\n    98→      }\n    99→\n   100→      const result = await sql`\n   101→        INSERT INTO cycles (name, start_date, end_date, team_id)\n   102→        VALUES (${body.name}, ${body.startDate}, ${body.endDate}, ${body.teamId})\n   103→        RETURNING id, name, start_date, end_date, team_id\n   104→      `;\n   105→\n   106→      const cycle = result[0];\n   107→      if (!cycle) {\n   108→        return new Response(JSON.stringify({ error: 'Failed to create cycle' }), {\n   109→          status: 500,\n   110→          headers: { 'Content-Type': 'application/json' },\n   111→        });\n   112→      }\n   113→\n   114→      return new Response(JSON.stringify({\n   115→        id: cycle.id,\n   116→        name: cycle.name,\n   117→        startDate: cycle.start_date instanceof Date ? cycle.start_date.toISOString().split('T')[0] : String(cycle.start_date).split('T')[0],\n   118→        endDate: cycle.end_date instanceof Date ? cycle.end_date.toISOString().split('T')[0] : String(cycle.end_date).split('T')[0],\n   119→        teamId: cycle.team_id,\n   120→        issueCount: 0,\n   121→        doneCount: 0,\n   122→        inProgressCount: 0,\n   123→        isActive: false,\n   124→      }), {\n   125→        status: 201,\n   126→        headers: { 'Content-Type': 'application/json' },\n   127→      });\n   128→    }\n   129→\n   130→    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n   131→      status: 405,\n   132→      headers: { 'Content-Type': 'application/json' },\n   133→    });\n   134→  } catch (err) {\n   135→    console.error('Cycles error:', err);\n   136→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n   137→      status: