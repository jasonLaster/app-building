[2026-03-14T20:56:18.035Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RuVc7V7vtYTGfdLNT6LWqk","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test'\n     2→\n     3→async function loginAs(page: import('@playwright/test').Page, email: string) {\n     4→  await page.goto('/login')\n     5→  await page.getByTestId('login-email-input').fill(email)\n     6→  await page.getByTestId('login-submit-button').click()\n     7→  await expect(page).toHaveURL('/', { timeout: 30000 })\n     8→}\n     9→\n    10→test.describe('Host Dashboard - Auth & Stats', () => {\n    11→  test('Host Dashboard requires login — redirects unauthenticated users', async ({ page }) => {\n    12→    await page.goto('/hosting')\n    13→    await expect(page).toHaveURL(/\\/login/, { timeout: 30000 })\n    14→    await expect(page.getByTestId('host-dashboard')).not.toBeVisible()\n    15→  })\n    16→\n    17→  test('Host Dashboard requires host status — shows upgrade prompt for non-hosts', async ({ page }) => {\n    18→    // Emma is a non-host user\n    19→    await loginAs(page, 'emma@example.com')\n    20→    await page.goto('/hosting')\n    21→    await expect(page.getByTestId('host-dashboard')).toBeVisible({ timeout: 30000 })\n    22→    await expect(page.getByTestId('host-dashboard')).toContainText('You need to become a host to access this page')\n    23→    await expect(page.getByTestId('become-host-link')).toBeVisible()\n    24→\n    25→    // Click link and verify navigation to profile\n    26→    await page.getByTestId('become-host-link').click()\n    27→    await expect(page).toHaveURL(/\\/profile/, { timeout: 30000 })\n    28→  })\n    29→\n    30→  test('Stats overview displays total listings count', async ({ page }) => {\n    31→    // Sarah has 3 active properties (b1111111, b2222222, b5555555)\n    32→    await loginAs(page, 'sarah@example.com')\n    33→    await page.goto('/hosting')\n    34→    await expect(page.getByTestId('stats-overview')).toBeVisible({ timeout: 30000 })\n    35→\n    36→    const totalListings = page.getByTestId('stat-total-listings')\n    37→    await expect(totalListings).toBeVisible()\n    38→    await expect(totalListings).toContainText('Total Listings')\n    39→    await expect(totalListings).toContainText('3', { timeout: 15000 })\n    40→  })\n    41→\n    42→  test('Stats overview displays active bookings count', async ({ page }) => {\n    43→    // Sarah's properties have: e2222222 (confirmed), e6666666 (confirmed) = 2 active\n    44→    await loginAs(page, 'sarah@example.com')\n    45→    await page.goto('/hosting')\n    46→    await expect(page.getByTestId('stats-overview')).toBeVisible({ timeout: 30000 })\n    47→\n    48→    const activeBookings = page.getByTestId('stat-active-bookings')\n    49→    await expect(activeBookings).toBeVisible()\n    50→    await expect(activeBookings).toContainText('Active Bookings')\n    51→    await expect(activeBookings).toContainText('2', { timeout: 15000 })\n    52→  })\n    53→\n    54→  test('Stats overview displays total earnings', async ({ page }) => {\n    55→    // Sarah's completed bookings: e1111111 ($825) = $825 total\n    56→    await loginAs(page, 'sarah@example.com')\n    57→    await page.goto('/hosting')\n    58→    await expect(page.getByTestId('stats-overview')).toBeVisible({ timeout: 30000 })\n    59→\n    60→    const totalEarnings = page.getByTestId('stat-total-earnings')\n    61→    await expect(totalEarnings).toBeVisible()\n    62→    await expect(totalEarnings).toContainText('Total Earnings')\n    63→    await expect(totalEarnings).toContainText('$825', { timeout: 15000 })\n    64→  })\n    65→\n    66→  test('Stats overview displays average rating', async ({ page }) => {\n    67→    // Sarah's reviews: 1 review with rating 5 → avg 5.0\n    68→    await loginAs(page, 'sarah@example.com')\n    69→    await page.goto('/hosting')\n    70→    await expect(page.getByTestId('stats-overview')).toBeVisible({ timeout: 30000 })\n    71→\n    72→    const avgRating = page.getByTestId('stat-average-rating')\n    73→    await expect(avgRating).toBeVisible()\n    74→    await expect(avgRating).toContainText('Average Rating')\n    75→    await expect(avgRating).toContainText('5.0', { timeout: 15000 })\n    76→  })\n    77→\n    78→  test('Stats overview shows zeros for a new host with no data', async ({ page, request }) => {\n    79→    // Make emma a host via API first (she has no properties as host)\n    80→    await request.post('http://localhost:8888/api/users/a3333333-3333-3333-3333-333333333333/become-host')\n    81→\n    82→    // Now login — the login fetches fresh user data from DB with is_host=true\n    83→    await loginAs(page, 'emma@example.com')\n    84→    await page.goto('/hosting')\n    85→    await expect(page.getByTestId('stats-overview')).toBeVisible({ timeout: 30000 })\n    86→\n    87→    await expect(page.getByTestId('stat-total-listings')).toContainText('0', { timeout: 15000 })\n    88→    await expect(page.getByTestId('stat-active-bookings')).toContainText('0', { timeout: 15000 })\n    89→    await expect(page.getByTestId('stat-total-earnings')).toContainText('$0', { timeout: 15000 })\n    90→    await expect(page.getByTestId('stat-average-rating')).toContainText('—', { timeout: 15000 })\n    91→  })\n    92→\n    93→  test('Host Dashboard displays navigation tabs for Listings and Bookings', async ({ page }) => {\n    94→    await loginAs(page, 'sarah@example.com')\n    95→    await page.goto('/hosting')\n    96→    await expect(page.getByTestId('host-dashboard')).toBeVisible({ timeout: 30000 })\n    97→\n    98→    const listingsTab = page.getByTestId('tab-listings')\n    99→    const bookingsTab = page.getByTestId('tab-bookings')\n   100→\n   101→    await expect(listingsTab).toBeVisible()\n   102→    await expect(listingsTab).toHaveText('Listings')\n   103→    await expect(bookingsTab).toBeVisible()\n   104→    await expect(bookingsTab).toHaveText('Bookings')\n   105→\n   106→    // Listings tab should be active by default (has active styling)\n   107→    await expect(listingsTab).toHaveClass(/border-primary/)\n   108→  })\n   109→\n   110→  test('Switching between Listings and Bookings tabs', async ({ page }) => {\n   111→    await loginAs(page, 'sarah@example.com')\n   112→    await page.goto('/hosting')\n   113→    await expect(page.getByTestId('host-dashboard')).toBeVisible({ timeout: 30000 })\n   114→\n   115→    // Listings tab active by default\n   116→    await expect(page.getByTestId('listings-tab')).toBeVisible({ timeout: 30000 })\n   117→\n   118→    // Click Bookings tab\n   119→    await page.getByTestId('tab-bookings').click()\n   120→    await expect(page.getByTestId('bookings-tab')).toBeVisible({ timeout: 15000 })\n   121→    await expect(page.getByTestId('tab-bookings')).toHaveClass(/border-primary/)\n   122→\n   123→    // Click Listings tab again\n   124→    await page.getByTestId('tab-listings').click()\n   125→    await expect(page.getByTestId('listings-tab')).toBeVisible({ timeout: 15000 })\n   126→    await expect(page.getByTestId('tab-listings')).toHaveClass(/border-primary/)\n   127→  })\n   128→})\n   129→"}]},"parent_tool_use_id":"toolu_01APKfpic7rdpV7eEHiTedxh","session_id":"b1ebe240-ab8e-4ccc-a035-25792ffc73c0","uuid":"953a31bf-d0fd-4d90-8125-71b4faeb0ae3"}
