   50→  return (\n    51→    <div data-testid=\"stats-overview\" className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n    52→      {cards.map((card) => (\n    53→        <div\n    54→          key={card.testId}\n    55→          data-testid={card.testId}\n    56→          className=\"bg-white rounded-xl border border-border p-5 flex items-start gap-4\"\n    57→        >\n    58→          <div className=\"w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0\">\n    59→            <card.icon size={20} className=\"text-primary\" />\n    60→          </div>\n    61→          <div>\n    62→            <p className=\"text-sm text-text-secondary font-medium\">{card.label}</p>\n    63→            <p className=\"text-2xl font-bold text-text mt-0.5 flex items-center gap-1\">\n    64→              {card.label === 'Average Rating' && stats.reviewCount > 0 && (\n    65→                <Star size={18} className=\"fill-status-pending text-status-pending\" />\n    66→              )}\n    67→              {card.value}\n    68→            </p>\n    69→          </div>\n    70→        </div>\n    71→      ))}\n    72→    </div>\n    73→  )\n    74→}\n    75→"}]},"parent_tool_use_id":null,"session_id":"b1ebe240-ab8e-4ccc-a035-25792ffc73c0","uuid":"8953d9da-e8c4-44d6-9423-102220aa07bf","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/components/StatsOverview.tsx","content":"import { Home, Calendar, DollarSign, Star } from 'lucide-react'\nimport type { HostStats } from '../slices/hostSlice'\n\ninterface StatsOverviewProps {\n  stats: HostStats\n  loading: boolean\n}\n\nexport default function StatsOverview({ stats, loading }: StatsOverviewProps) {\n  const cards = [\n    {\n      label: 'Total Listings',\n      value: String(stats.totalListings),\n      icon: Home,\n      testId: 'stat-total-listings',\n    },\n    {\n      label: 'Active Bookings',\n      value: String(stats.activeBookings),\n      icon: Calendar,\n      testId: 'stat-active-bookings',\n    },\n    {\n      label: 'Total Earnings',\n      value: `$${stats.totalEarnings.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}`,\n      icon: DollarSign,\n      testId: 'stat-total-earnings',\n    },\n    {\n      label: 'Average Rating',\n      value: stats.reviewCount > 0 ? Number(stats.avgRating).toFixed(1) : '—',\n      icon: Star,\n      testId: 'stat-average-rating',\n    },\n  ]\n\n  if (loading) {\n    return (\n      <div data-testid=\"stats-overview\" className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n        {[1, 2, 3, 4].map((i) => (\n          <div key={i} className=\"bg-white rounded-xl border border-border p-5 animate-pulse\">\n            <div className=\"h-4 bg-bg-secondary rounded w-24 mb-3\" />\n            <div className=\"h-8 bg-bg-secondary rounded w-16\" />\n          </div>\n        ))}\n      </div>\n    )\n  }\n\n  return (\n    <div data-testid=\"stats-overview\" className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n      {cards.map((card) => (\n        <div\n          key={card.testId}\n          data-testid={card.testId}\n          className=\"bg-white rounded-xl border border-border p-5 flex items-start gap-4\"\n        >\n          <div className=\"w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0\">\n            <card.icon size={20} className=\"text-primary\" />\n          </div>\n          <div>\n            <p className=\"text-sm text-text-secondary font-medium\">{card.label}</p>\n            <p className=\"text-2xl font-bold text-text mt-0.5 flex items-center gap-1\">\n              {card.label === 'Average Rating' && stats.reviewCount > 0 && (\n                <Star size={18} className=\"fill-status-pending text-status-pending\" />\n              )}\n              {card.value}\n            </p>\n          </div>\n        </div>\n      ))}\n    </div>\n  )\n}\n","numLines":75,"startLine":1,"totalL