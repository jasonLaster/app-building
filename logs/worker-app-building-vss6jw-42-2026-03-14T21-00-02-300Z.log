[2026-03-14T20:56:20.420Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LK3hcA9kpuoBeESTpaHEUN","type":"tool_result","content":"     1→import { createSlice, createAsyncThunk } from '@reduxjs/toolkit'\n     2→import type { Property } from './propertiesSlice'\n     3→\n     4→export interface HostBooking {\n     5→  id: string\n     6→  property_id: string\n     7→  guest_id: string\n     8→  check_in: string\n     9→  check_out: string\n    10→  num_guests: number\n    11→  total_price: number\n    12→  status: 'pending' | 'confirmed' | 'cancelled' | 'completed'\n    13→  special_requests: string | null\n    14→  created_at: string\n    15→  property_title?: string\n    16→  property_city?: string\n    17→  property_country?: string\n    18→  property_image?: string | null\n    19→  guest_name?: string\n    20→  guest_email?: string\n    21→}\n    22→\n    23→export interface HostStats {\n    24→  totalListings: number\n    25→  activeBookings: number\n    26→  totalEarnings: number\n    27→  avgRating: number\n    28→  reviewCount: number\n    29→}\n    30→\n    31→interface HostState {\n    32→  stats: HostStats\n    33→  listings: Property[]\n    34→  bookings: HostBooking[]\n    35→  statsLoading: boolean\n    36→  listingsLoading: boolean\n    37→  bookingsLoading: boolean\n    38→  error: string | null\n    39→}\n    40→\n    41→const initialState: HostState = {\n    42→  stats: {\n    43→    totalListings: 0,\n    44→    activeBookings: 0,\n    45→    totalEarnings: 0,\n    46→    avgRating: 0,\n    47→    reviewCount: 0,\n    48→  },\n    49→  listings: [],\n    50→  bookings: [],\n    51→  statsLoading: false,\n    52→  listingsLoading: false,\n    53→  bookingsLoading: false,\n    54→  error: null,\n    55→}\n    56→\n    57→export const fetchHostStats = createAsyncThunk(\n    58→  'host/fetchHostStats',\n    59→  async (hostId: string, { rejectWithValue }) => {\n    60→    const response = await fetch(`/api/host-stats?host_id=${encodeURIComponent(hostId)}`)\n    61→    const data = await response.json()\n    62→    if (!response.ok) {\n    63→      return rejectWithValue(data.error || 'Failed to fetch host stats')\n    64→    }\n    65→    return data as HostStats\n    66→  }\n    67→)\n    68→\n    69→export const fetchHostListings = createAsyncThunk(\n    70→  'host/fetchHostListings',\n    71→  async (hostId: string, { rejectWithValue }) => {\n    72→    const response = await fetch(`/api/host-listings?host_id=${encodeURIComponent(hostId)}`)\n    73→    const data = await response.json()\n    74→    if (!response.ok) {\n    75→      return rejectWithValue(data.error || 'Failed to fetch host listings')\n    76→    }\n    77→    return data as Property[]\n    78→  }\n    79→)\n    80→\n    81→export const fetchHostBookings = createAsyncThunk(\n    82→  'host/fetchHostBookings',\n    83→  async (hostId: string, { rejectWithValue }) => {\n    84→    const response = await fetch(`/api/host-bookings?host_id=${encodeURIComponent(hostId)}`)\n    85→    const data = await response.json()\n    86→    if (!response.ok) {\n    87→      return rejectWithValue(data.error || 'Failed to fetch host bookings')\n    88→    }\n    89→    return data as HostBooking[]\n    90→  }\n    91→)\n    92→\n    93→export const createProperty = createAsyncThunk(\n    94→  'host/createProperty',\n    95→  async (data: {\n    96→    host_id: string\n    97→    title: string\n    98→    description: string\n    99→    property_type: string\n   100→    price_per_night: number\n   101→    cleaning_fee: number\n   102→    max_guests: number\n   103→    bedrooms: number\n   104→    beds: number\n   105→    bathrooms: number\n   106→    address: string\n   107→    city: string\n   108→    state: string | null\n   109→    country: string\n   110→    latitude: number | null\n   111→    longitude: number | null\n   112→    amenity_ids?: string[]\n   113→  }, { rejectWithValue }) => {\n   114→    const response = await fetch('/api/properties', {\n   115→      method: 'POST',\n   116→      headers: { 'Content-Type': 'application/json' },\n   117→      body: JSON.stringify(data),\n   118→    })\n   119→    const result = await response.json()\n   120→    if (!response.ok) {\n   121→      return rejectWithValue(result.error || 'Failed to create property')\n   122→    }\n   123→    return result as Property\n   124→  }\n   125→)\n   126→\n   127→export const deactivateProperty = createAsyncThunk(\n   128→  'host/deactivateProperty',\n   129→  async (propertyId: string, { rejectWithValue }) => {\n   130→    const response = await fetch(`/api/properties/${propertyId}`, {\n   131→      method: 'DELETE',\n   132→    })\n   133→    const result = await response.json()\n   134→    if (!response.ok) {\n   135→      return rejectWithValue(result.error || 'Failed to deactivate property')\n   136→    }\n   137→    return result as Property\n   138→  }\n   139→)\n   140→\n   141→export const activateProperty = createAsyncThunk(\n   142→  'host/activateProperty',\n   143→  async (propertyId: string, { rejectWithValue }) => {\n   144→    const response = await fetch(`/api/properties/${propertyId}`, {\n   145→      method: 'PUT',\n   146→      headers: { 'Content-Type': 'application/json' },\n   147→      body: JSON.stringify({ is_active: true }),\n   148→    })\n   149→    const result = await response.json()\n   150→    if (!response.ok) {\n   151→      return rejectWithValue(result.error || 'Failed to activate property')\n   152→    }\n   153→    return result as Property\n   154→  }\n   155→)\n   156→\n   157→export const updateHostBookingStatus = createAsyncThunk(\n   158→  'host/updateBookingStatus',\n   159→  async ({ bookingId, status }: { bookingId: string; status: string }, { rejectWithValue }) => {\n   160→    const response = await fetch(`/api/bookings/${bookingId}`, {\n   161→      method: 'PUT',\n   162→      headers: { 'Content-Type': 'application/json' },\n   163→      body: JSON.stringify({ status }),\n   164→    })\n   165→    const result = await response.json()\n   166→    if (!response.ok) {\n   167→      return rejectWithValue(result.error || 'Failed to update booking')\n   168→    }\n   169→    return result as HostBooking\n   170→  }\n   171→)\n   172→\n   173→const hostSlice = createSlice({\n   174→  name: 'host',\n   175→  initialState,\n   176→  reducers: {\n   177→    clearHostError(state) {\n   178→      state.error = null\n   179→    },\n   180→  },\n   181→  extraReducers: (builder) => {\n   182→    builder\n   183→      .addCase(fetchHostStats.pending, (state) => {\n   184→        state.statsLoading = true\n   185→        state.error = null\n   186→      })\n   187→      .addCase(fetchHostStats.fulfilled, (state, action) => {\n   188→        state.statsLoading = false\n   189→        state.stats = action.payload\n   190→      })\n   191→      .addCase(fetchHostStats.rejected, (state, action) => {\n   192→        state.statsLoading = false\n   193→        state.error = action.payload as string\n   194→      })\n   195→      .addCase(fetchHostListings.pending, (state) => {\n   196→        if (state.listings.length === 0) {\n   197→          state.listingsLoading = true\n   198→        }\n   199→        state.error = null\n   200→      })\n   201→      .addCase(fetchHostListings.fulfilled, (state, action) => {\n   202→        state.listingsLoading = false\n   203→        state.listings = action.payload\n   204→      })\n   205→      .addCase(fetchHostListings.rejected, (state, action) => {\n   206→        state.listingsLoading = false\n   207→        state.error = action.payload as string\n   208→      })\n   209→      .addCase(fetchHostBookings.pending, (state) => {\n   210→        if (state.bookings.length === 0) {\n   211→          state.bookingsLoading = true\n   212→        }\n   213→        state.error = null\n   214→      })\n   215→      .addCase(fetchHostBookings.fulfilled, (state, action) => {\n   216→        state.bookingsLoading = false\n   217→        state.bookings = action.payload\n   218→      })\n   219→      .addCase(fetchHostBookings.rejected, (state, action) => {\n   220→        state.bookingsLoading = false\n   221→        state.error = action.payload as string\n   222→      })\n   223→      .addCase(createProperty.fulfilled, (state, action) => {\n   224→        state.listings.unshift(action.payload)\n   225→        state.stats.totalListings += 1\n   226→      })\n   227→      .addCase(deactivateProperty.fulfilled, (state, action) => {\n   228→        const index = state.listings.findIndex((p) => p.id === action.payload.id)\n   229→        if (index !== -1) {\n   230→          const existing = state.listings[index]\n   231→          if (existing) {\n   232→            state.listings[index] = { ...existing, ...action.payload, is_active: false }\n   233→          }\n   234→        }\n   235→        state.stats.totalListings = Math.max(0, state.stats.totalListings - 1)\n   236→      })\n   237→      .addCase(activateProperty.fulfilled, (state, action) => {\n   238→        const index = state.listings.findIndex((p) => p.id === action.payload.id)\n   239→        if (index !== -1) {\n   240→          const existing = state.listings[index]\n   241→          if (existing) {\n   242→            state.listings[index] = { ...existing, ...action.payload, is_active: true }\n   243→          }\n   244→        }\n   245→        state.stats.totalListings += 1\n   246→      })\n   247→      .addCase(updateHostBookingStatus.fulfilled, (state, action) => {\n   248→        const index = state.bookings.findIndex((b) => b.id === action.payload.id)\n   249→        if (index !== -1) {\n   250→          const existing = state.bookings[index]\n   251→          if (existing) {\n   252→            const oldStatus = existing.status\n   253→            const newStatus = action.payload.status\n   254→            state.bookings[index] = { ...existing, ...action.payload }\n   255→            if (['pending', 'confirmed'].includes(oldStatus) && !['pending', 'confirmed'].includes(newStatus)) {\n   256→              state.stats.activeBookings = Math.max(0, state.stats.activeBookings - 1)\n   257→            } else if (!['pending', 'confirmed'].includes(oldStatus) && ['pending', 'confirmed'].includes(newStatus)) {\n   258→              state.stats.activeBookings += 1\n   259→            }\n   260→          }\n   261→        }\n   262→      })\n   263→  },\n   264→})\n   265→\n   266→export const { clearHostError } = hostSlice.actions\n   267→export default hostSlice.reducer\n   268→"}]},"parent_tool_use_id":"toolu_01APKfpic7rdpV7eEHiTedxh","session_id":"b1ebe240-ab8e-4ccc-a035-25792ffc73c0","uuid":"4c04e1c2-0879-4a66-99ef-854dff9dede8"}
