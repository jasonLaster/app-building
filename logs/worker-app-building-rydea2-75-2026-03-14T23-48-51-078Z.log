e test team\n  await page.getByText(testTeamName).click();\n  // Look for settings or delete option\n  const settingsBtn = page.getByRole('button', { name: /settings/i }).or(page.getByRole('link', { name: /settings/i }));\n  if (await settingsBtn.isVisible({ timeout: 3000 }).catch(() => false)) {\n    await settingsBtn.click();\n  }\n  const deleteBtn = page.getByRole('button', { name: /delete/i });\n  if (await deleteBtn.isVisible({ timeout: 3000 }).catch(() => false)) {\n    await deleteBtn.click();\n    // Confirm deletion if prompted\n    const confirmBtn = page.getByRole('button', { name: /confirm|delete/i }).last();\n    if (await confirmBtn.isVisible({ timeout: 2000 }).catch(() => false)) {\n      await confirmBtn.click();\n    }\n  }\n});\n","structuredPatch":[],"originalFile":null}}
