[2026-03-14T22:26:30.881Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01D1CfQUsdJj6Tdgs247NG82","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions';\n     2→import { getSql } from './db';\n     3→\n     4→export default async function handler(req: Request, _context: Context) {\n     5→  if (req.method !== 'GET') {\n     6→    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n     7→      status: 405,\n     8→      headers: { 'Content-Type': 'application/json' },\n     9→    });\n    10→  }\n    11→\n    12→  try {\n    13→    const authHeader = req.headers.get('Authorization');\n    14→    if (!authHeader?.startsWith('Bearer ')) {\n    15→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    16→        status: 401,\n    17→        headers: { 'Content-Type': 'application/json' },\n    18→      });\n    19→    }\n    20→\n    21→    const token = authHeader.slice(7);\n    22→    const sql = getSql();\n    23→\n    24→    const sessions = await sql`\n    25→      SELECT s.member_id FROM sessions s\n    26→      WHERE s.token = ${token} AND s.expires_at > NOW()\n    27→    `;\n    28→    const session = sessions[0];\n    29→    if (!session) {\n    30→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    31→        status: 401,\n    32→        headers: { 'Content-Type': 'application/json' },\n    33→      });\n    34→    }\n    35→\n    36→    const url = new URL(req.url);\n    37→    const cycleId = url.searchParams.get('cycleId');\n    38→    if (!cycleId) {\n    39→      return new Response(JSON.stringify({ error: 'cycleId is required' }), {\n    40→        status: 400,\n    41→        headers: { 'Content-Type': 'application/json' },\n    42→      });\n    43→    }\n    44→\n    45→    // Fetch cycle info\n    46→    const cycleRows = await sql`\n    47→      SELECT c.id, c.name, c.start_date, c.end_date, c.team_id\n    48→      FROM cycles c\n    49→      WHERE c.id = ${cycleId}\n    50→    `;\n    51→    const cycle = cycleRows[0];\n    52→    if (!cycle) {\n    53→      return new Response(JSON.stringify({ error: 'Cycle not found' }), {\n    54→        status: 404,\n    55→        headers: { 'Content-Type': 'application/json' },\n    56→      });\n    57→    }\n    58→\n    59→    // Fetch issues in this cycle\n    60→    const issues = await sql`\n    61→      SELECT\n    62→        i.id,\n    63→        i.title,\n    64→        i.description,\n    65→        i.status,\n    66→        i.priority,\n    67→        i.number,\n    68→        i.due_date,\n    69→        i.created_at,\n    70→        i.updated_at,\n    71→        i.team_id,\n    72→        i.assignee_id,\n    73→        i.project_id,\n    74→        i.cycle_id,\n    75→        i.parent_id,\n    76→        t.identifier AS team_identifier,\n    77→        t.name AS team_name,\n    78→        p.name AS project_name,\n    79→        m.name AS assignee_name,\n    80→        m.email AS assignee_email\n    81→      FROM issues i\n    82→      JOIN teams t ON t.id = i.team_id\n    83→      LEFT JOIN projects p ON p.id = i.project_id\n    84→      LEFT JOIN members m ON m.id = i.assignee_id\n    85→      WHERE i.cycle_id = ${cycleId}\n    86→      ORDER BY i.created_at DESC\n    87→    `;\n    88→\n    89→    const issueIds = issues.map((i) => i.id);\n    90→\n    91→    let issueLabels: Array<{ issue_id: string; label_id: string; label_name: string; label_color: string }> = [];\n    92→    if (issueIds.length > 0) {\n    93→      issueLabels = await sql`\n    94→        SELECT il.issue_id, l.id AS label_id, l.name AS label_name, l.color AS label_color\n    95→        FROM issue_labels il\n    96→        JOIN labels l ON l.id = il.label_id\n    97→        WHERE il.issue_id = ANY(${issueIds})\n    98→      `;\n    99→    }\n   100→\n   101→    const labelsByIssue: Record<string, Array<{ id: string; name: string; color: string }>> = {};\n   102→    for (const il of issueLabels) {\n   103→      if (!labelsByIssue[il.issue_id]) {\n   104→        labelsByIssue[il.issue_id] = [];\n   105→      }\n   106→      labelsByIssue[il.issue_id].push({\n   107→        id: il.label_id,\n   108→        name: il.label_name,\n   109→        color: il.label_color,\n   110→      });\n   111→    }\n   112→\n   113→    const enrichedIssues = issues.map((issue) => ({\n   114→      id: issue.id,\n   115→      title: issue.title,\n   116→      description: issue.description,\n   117→      status: issue.status,\n   118→      priority: issue.priority,\n   119→      identifier: `${issue.team_identifier}-${issue.number}`,\n   120→      number: issue.number,\n   121→      dueDate: issue.due_date ? String(issue.due_date).split('T')[0] : null,\n   122→      createdAt: issue.created_at,\n   123→      updatedAt: issue.updated_at,\n   124→      teamId: issue.team_id,\n   125→      teamName: issue.team_name,\n   126→      assigneeId: issue.assignee_id,\n   127→      assigneeName: issue.assignee_name,\n   128→      assigneeEmail: issue.assignee_email,\n   129→      projectId: issue.project_id,\n   130→      projectName: issue.project_name,\n   131→      cycleId: issue.cycle_id,\n   132→      cycleName: cycle.name,\n   133→      parentId: issue.parent_id,\n   134→      labels: labelsByIssue[issue.id] || [],\n   135→    }));\n   136→\n   137→    // Fetch burndown data: activity entries where status changed to 'done' for issues in this cycle\n   138→    const burndownData = await sql`\n   139→      SELECT DATE(a.created_at) AS completion_date, COUNT(*)::int AS count\n   140→      FROM activity a\n   141→      WHERE a.issue_id = ANY(${issueIds.length > 0 ? issueIds : ['__none__']})\n   142→        AND a.field = 'status'\n   143→        AND a.new_value = 'done'\n   144→        AND DATE(a.created_at) >= ${String(cycle.start_date).split('T')[0]}\n   145→        AND DATE(a.created_at) <= ${String(cycle.end_date).split('T')[0]}\n   146→      GROUP BY DATE(a.created_at)\n   147→      ORDER BY DATE(a.created_at) ASC\n   148→    `;\n   149→\n   150→    // Fetch team members for filters\n   151→    const members = await sql`\n   152→      SELECT m.id, m.name, m.email\n   153→      FROM members m\n   154→      JOIN team_members tm ON tm.member_id = m.id\n   155→      WHERE tm.team_id = ${cycle.team_id}\n   156→      ORDER BY m.name ASC\n   157→    `;\n   158→\n   159→    return new Response(JSON.stringify({\n   160→      cycle: {\n   161→        id: cycle.id,\n   162→        name: cycle.name,\n   163→        startDate: String(cycle.start_date).split('T')[0],\n   164→        endDate: String(cycle.end_date).split('T')[0],\n   165→        teamId: cycle.team_id,\n   166→      },\n   167→      issues: enrichedIssues,\n   168→      members,\n   169→      burndown: burndownData.map((d) => ({\n   170→        date: String(d.completion_date).split('T')[0],\n   171→        count: d.count,\n   172→      })),\n   173→    }), {\n   174→      status: 200,\n   175→      headers: { 'Content-Type': 'application/json' },\n   176→    });\n   177→  } catch (err) {\n   178→    console.error('Cycle issues error:', err);\n   179→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n   180→      status: 500,\n   181→      headers: { 'Content-Type': 'application/json' },\n   182→    });\n   183→  }\n   184→}\n   185→"}]},"parent_tool_use_id":"toolu_0129VysynLthoNVxkgaaq7jb","session_id":"6ee9f87d-051a-4e97-9b18-73c5fcdfaaeb","uuid":"22d7d8f8-85f9-4162-8282-cbfa20c739ac"}
