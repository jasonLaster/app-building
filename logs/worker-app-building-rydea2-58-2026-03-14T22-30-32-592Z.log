[2026-03-14T22:26:28.953Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01X8tNJf2Y353yKV2kiu9e55","type":"tool_result","content":"     1→import { useEffect, useState } from 'react';\n     2→import { useParams } from 'react-router-dom';\n     3→import { useSelector, useDispatch } from 'react-redux';\n     4→import type { RootState, AppDispatch } from '../store';\n     5→import {\n     6→  fetchCycles,\n     7→  fetchCycleIssues,\n     8→  setSelectedCycleId,\n     9→  createCycle,\n    10→} from '../slices/cyclesSlice';\n    11→import CycleList from '../components/CycleList';\n    12→import CycleDetail from '../components/CycleDetail';\n    13→import CreateCycle from '../components/CreateCycle';\n    14→import './ActiveCycle.css';\n    15→\n    16→export default function ActiveCycle() {\n    17→  const { teamId } = useParams<{ teamId: string }>();\n    18→  const dispatch = useDispatch<AppDispatch>();\n    19→  const { token } = useSelector((state: RootState) => state.auth);\n    20→  const { items: teams } = useSelector((state: RootState) => state.teams);\n    21→  const { cycles, loading, selectedCycleId, cycleDetail } = useSelector((state: RootState) => state.cycles);\n    22→\n    23→  const [createModalOpen, setCreateModalOpen] = useState(false);\n    24→\n    25→  const team = teams.find((t) => t.id === teamId);\n    26→\n    27→  useEffect(() => {\n    28→    if (token && teamId) {\n    29→      dispatch(fetchCycles(teamId));\n    30→    }\n    31→  }, [dispatch, token, teamId]);\n    32→\n    33→  // When cycles load, auto-select the active cycle if no cycle is selected\n    34→  useEffect(() => {\n    35→    if (cycles.length > 0 && !selectedCycleId) {\n    36→      const activeCycle = cycles.find((c) => c.isActive);\n    37→      if (activeCycle) {\n    38→        dispatch(setSelectedCycleId(activeCycle.id));\n    39→      }\n    40→    }\n    41→  }, [cycles, selectedCycleId, dispatch]);\n    42→\n    43→  // Clear selected cycle when team changes\n    44→  useEffect(() => {\n    45→    dispatch(setSelectedCycleId(null));\n    46→  }, [teamId, dispatch]);\n    47→\n    48→  // Fetch cycle issues when selected cycle changes\n    49→  useEffect(() => {\n    50→    if (selectedCycleId && token) {\n    51→      dispatch(fetchCycleIssues(selectedCycleId));\n    52→    }\n    53→  }, [selectedCycleId, token, dispatch]);\n    54→\n    55→  function handleSelectCycle(cycleId: string) {\n    56→    dispatch(setSelectedCycleId(cycleId));\n    57→  }\n    58→\n    59→  async function handleCreateCycle(data: { name: string; startDate: string; endDate: string }) {\n    60→    if (!teamId) return;\n    61→    await dispatch(createCycle({\n    62→      teamId,\n    63→      name: data.name,\n    64→      startDate: data.startDate,\n    65→      endDate: data.endDate,\n    66→    })).unwrap();\n    67→    setCreateModalOpen(false);\n    68→    // Refetch cycles to get updated data\n    69→    dispatch(fetchCycles(teamId));\n    70→  }\n    71→\n    72→  function handleBackToList() {\n    73→    dispatch(setSelectedCycleId(null));\n    74→  }\n    75→\n    76→  return (\n    77→    <div className=\"active-cycle-page\" data-testid=\"active-cycle-page\">\n    78→      <div className=\"active-cycle-header\">\n    79→        <div className=\"active-cycle-header-left\">\n    80→          {selectedCycleId && cycleDetail && (\n    81→            <button\n    82→              className=\"active-cycle-back-btn\"\n    83→              onClick={handleBackToList}\n    84→              data-testid=\"cycle-back-btn\"\n    85→            >\n    86→              <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n    87→                <polyline points=\"15 18 9 12 15 6\" />\n    88→              </svg>\n    89→            </button>\n    90→          )}\n    91→          <h1 className=\"active-cycle-title\" data-testid=\"active-cycle-title\">\n    92→            {team?.name || 'Team'} Cycles\n    93→          </h1>\n    94→        </div>\n    95→        <button\n    96→          className=\"active-cycle-new-btn\"\n    97→          onClick={() => setCreateModalOpen(true)}\n    98→          data-testid=\"new-cycle-btn\"\n    99→        >\n   100→          <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n   101→            <line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\" />\n   102→            <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\" />\n   103→          </svg>\n   104→          New Cycle\n   105→        </button>\n   106→      </div>\n   107→\n   108→      {selectedCycleId && cycleDetail ? (\n   109→        <CycleDetail />\n   110→      ) : (\n   111→        <CycleList\n   112→          cycles={cycles}\n   113→          loading={loading}\n   114→          selectedCycleId={selectedCycleId}\n   115→          onSelectCycle={handleSelectCycle}\n   116→        />\n   117→      )}\n   118→\n   119→      <CreateCycle\n   120→        open={createModalOpen}\n   121→        onClose={() => setCreateModalOpen(false)}\n   122→        onSubmit={handleCreateCycle}\n   123→      />\n   124→    </div>\n   125→  );\n   126→}\n   127→"}]},"parent_tool_use_id":"toolu_0129VysynLthoNVxkgaaq7jb","session_id":"6ee9f87d-051a-4e97-9b18-73c5fcdfaaeb","uuid":"2fd5d400-1831-407f-8ba0-e80effdb69cb"}
