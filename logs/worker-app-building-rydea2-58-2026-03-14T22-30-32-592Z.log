cles c\n    49→      WHERE c.id = ${cycleId}\n    50→    `;\n    51→    const cycle = cycleRows[0];\n    52→    if (!cycle) {\n    53→      return new Response(JSON.stringify({ error: 'Cycle not found' }), {\n    54→        status: 404,\n    55→        headers: { 'Content-Type': 'application/json' },\n    56→      });\n    57→    }\n    58→\n    59→    // Fetch issues in this cycle\n    60→    const issues = await sql`\n    61→      SELECT\n    62→        i.id,\n    63→        i.title,\n    64→        i.description,\n    65→        i.status,\n    66→        i.priority,\n    67→        i.number,\n    68→        i.due_date,\n    69→        i.created_at,\n    70→        i.updated_at,\n    71→        i.team_id,\n    72→        i.assignee_id,\n    73→        i.project_id,\n    74→        i.cycle_id,\n    75→        i.parent_id,\n    76→        t.identifier AS team_identifier,\n    77→        t.name AS team_name,\n    78→        p.name AS project_name,\n    79→        m.name AS assignee_name,\n    80→        m.email AS assignee_email\n    81→      FROM issues i\n    82→      JOIN teams t ON t.id = i.team_id\n    83→      LEFT JOIN projects p ON p.id = i.project_id\n    84→      LEFT JOIN members m ON m.id = i.assignee_id\n    85→      WHERE i.cycle_id = ${cycleId}\n    86→      ORDER BY i.created_at DESC\n    87→    `;\n    88→\n    89→    const issueIds = issues.map((i) => i.id);\n    90→\n    91→    let issueLabels: Array<{ issue_id: string; label_id: string; label_name: string; label_color: string }> = [];\n    92→    if (issueIds.length > 0) {\n    93→      issueLabels = await sql`\n    94→        SELECT il.issue_id, l.id AS label_id, l.name AS label_name, l.color AS label_color\n    95→        FROM issue_labels il\n    96→        JOIN labels l ON l.id = il.label_id\n    97→        WHERE il.issue_id = ANY(${issueIds})\n    98→      `;\n    99→    }\n   100→\n   101→    const labelsByIssue: Record<string, Array<{ id: string; name: string; color: string }>> = {};\n   10