[2026-03-14T22:26:46.684Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019FpRFPgtf2VPypZzXuuvZx","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test';\n     2→\n     3→// Helper to login via API and get token\n     4→async function loginViaApi(baseURL: string, email: string, password: string) {\n     5→  const response = await fetch(`${baseURL}/api/login`, {\n     6→    method: 'POST',\n     7→    headers: { 'Content-Type': 'application/json' },\n     8→    body: JSON.stringify({ email, password }),\n     9→  });\n    10→  return response.json();\n    11→}\n    12→\n    13→// Helper to get teams via API\n    14→async function getTeams(baseURL: string, token: string) {\n    15→  const response = await fetch(`${baseURL}/api/teams`, {\n    16→    headers: { Authorization: `Bearer ${token}` },\n    17→  });\n    18→  const data = await response.json();\n    19→  return data.teams;\n    20→}\n    21→\n    22→// Helper to login and open create issue modal from a team page\n    23→async function loginAndOpenCreateModal(\n    24→  page: import('@playwright/test').Page,\n    25→  baseURL: string,\n    26→  teamIdentifier = 'ENG',\n    27→  email = 'alice@acme.com',\n    28→  password = 'password123'\n    29→) {\n    30→  const data = await loginViaApi(baseURL, email, password);\n    31→  const teams = await getTeams(baseURL, data.token);\n    32→  const team = teams.find((t: { identifier: string }) => t.identifier === teamIdentifier);\n    33→\n    34→  await page.goto('/login');\n    35→  await page.evaluate((t) => localStorage.setItem('session_token', t), data.token);\n    36→  await page.goto(`/team/${team.id}/issues`);\n    37→  await expect(page.getByTestId('team-issues-page')).toBeVisible({ timeout: 30000 });\n    38→\n    39→  await page.getByTestId('new-issue-btn').click();\n    40→  await expect(page.getByTestId('create-issue-modal')).toBeVisible({ timeout: 30000 });\n    41→\n    42→  return { token: data.token, user: data.user, team, teams };\n    43→}\n    44→\n    45→test.describe('CreateIssueModalCyclesDates', () => {\n    46→  test('Cycle dropdown shows team\\'s available cycles', async ({ page, baseURL }) => {\n    47→    await loginAndOpenCreateModal(page, baseURL!);\n    48→\n    49→    // Click the cycle dropdown\n    50→    await page.getByTestId('create-issue-cycle-selector').click();\n    51→    await expect(page.getByTestId('create-issue-cycle-dropdown')).toBeVisible();\n    52→\n    53→    // Verify \"Sprint 12\" cycle is shown (seed data for ENG team)\n    54→    const cycleOptions = page.getByTestId('create-issue-cycle-dropdown').locator('button').filter({ hasText: /Sprint 12/ });\n    55→    await expect(cycleOptions).toHaveCount(1, { timeout: 10000 });\n    56→    await expect(cycleOptions).toContainText('Sprint 12');\n    57→\n    58→    // Verify the active badge is shown (Sprint 12 is active: 2026-03-10 to 2026-03-24)\n    59→    const activeBadge = page.getByTestId('create-issue-cycle-dropdown').locator('.cif-active-badge');\n    60→    await expect(activeBadge).toBeVisible();\n    61→  });\n    62→\n    63→  test('Cycle dropdown allows selecting a cycle', async ({ page, baseURL }) => {\n    64→    await loginAndOpenCreateModal(page, baseURL!);\n    65→\n    66→    // Verify cycle is initially empty\n    67→    await expect(page.getByTestId('create-issue-cycle-selector')).toContainText('No cycle');\n    68→\n    69→    // Click cycle dropdown and select \"Sprint 12\"\n    70→    await page.getByTestId('create-issue-cycle-selector').click();\n    71→    await expect(page.getByTestId('create-issue-cycle-dropdown')).toBeVisible();\n    72→\n    73→    const sprintOption = page.getByTestId('create-issue-cycle-dropdown').locator('button').filter({ hasText: /Sprint 12/ });\n    74→    await expect(sprintOption).toBeVisible({ timeout: 10000 });\n    75→    await sprintOption.click();\n    76→\n    77→    // Verify cycle field shows \"Sprint 12\"\n    78→    await expect(page.getByTestId('create-issue-cycle-selector')).toContainText('Sprint 12');\n    79→  });\n    80→\n    81→  test('Cycle dropdown updates when team is changed', async ({ page, baseURL }) => {\n    82→    await loginAndOpenCreateModal(page, baseURL!);\n    83→\n    84→    // Verify ENG team's Sprint 12 cycle is available\n    85→    await page.getByTestId('create-issue-cycle-selector').click();\n    86→    await expect(page.getByTestId('create-issue-cycle-dropdown')).toBeVisible();\n    87→    const engCycle = page.getByTestId('create-issue-cycle-dropdown').locator('button').filter({ hasText: /Sprint 12/ });\n    88→    await expect(engCycle).toHaveCount(1, { timeout: 10000 });\n    89→\n    90→    // Select Sprint 12 cycle\n    91→    await engCycle.click();\n    92→    await expect(page.getByTestId('create-issue-cycle-selector')).toContainText('Sprint 12');\n    93→\n    94→    // Change team to Design\n    95→    await page.getByTestId('create-issue-team-selector').click();\n    96→    await expect(page.getByTestId('create-issue-team-dropdown')).toBeVisible();\n    97→    const designOption = page.getByTestId('create-issue-team-dropdown').locator('button').filter({ hasText: /^Design$/ });\n    98→    await designOption.click();\n    99→\n   100→    // Verify team is now Design"}]},"parent_tool_use_id":"toolu_0129VysynLthoNVxkgaaq7jb","session_id":"6ee9f87d-051a-4e97-9b18-73c5fcdfaaeb","uuid":"829edd29-fb46-4429-82bf-ec77a783cc44"}
