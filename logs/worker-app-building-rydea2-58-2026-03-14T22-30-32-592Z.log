[2026-03-14T22:26:28.476Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01U4NustQ9HkicxKqkxiBHNz","type":"tool_result","content":"     1→import { useState, useMemo, useRef, useEffect } from 'react';\n     2→import { useSelector, useDispatch } from 'react-redux';\n     3→import type { RootState, AppDispatch } from '../store';\n     4→import type { CycleIssue } from '../slices/cyclesSlice';\n     5→import {\n     6→  setCycleGroupBy,\n     7→  setCycleSortBy,\n     8→  toggleCycleIssueSelection,\n     9→  selectCycleGroupIssues,\n    10→  clearCycleSelection,\n    11→} from '../slices/cyclesSlice';\n    12→import { bulkUpdateIssues } from '../slices/teamIssuesSlice';\n    13→import IssueRow from './IssueRow';\n    14→import { STATUS_ORDER, STATUS_CONFIG, StatusIcon, PriorityIcon, PRIORITY_CONFIG } from './IssueRow';\n    15→import BurndownChart from './BurndownChart';\n    16→import './CycleDetail.css';\n    17→\n    18→const PRIORITY_ORDER = ['urgent', 'high', 'medium', 'low', 'none'] as const;\n    19→const STATUS_SORT_MAP: Record<string, number> = {};\n    20→STATUS_ORDER.forEach((s, i) => { STATUS_SORT_MAP[s] = i; });\n    21→const PRIORITY_SORT_MAP: Record<string, number> = {};\n    22→PRIORITY_ORDER.forEach((p, i) => { PRIORITY_SORT_MAP[p] = i; });\n    23→\n    24→const GROUP_OPTIONS: Array<{ value: 'status' | 'priority' | 'assignee' | 'project' | 'label' | 'none'; label: string }> = [\n    25→  { value: 'status', label: 'Status' },\n    26→  { value: 'priority', label: 'Priority' },\n    27→  { value: 'assignee', label: 'Assignee' },\n    28→  { value: 'project', label: 'Project' },\n    29→  { value: 'label', label: 'Label' },\n    30→  { value: 'none', label: 'None' },\n    31→];\n    32→\n    33→const SORT_OPTIONS: Array<{ value: 'priority' | 'created' | 'updated' | 'status'; label: string }> = [\n    34→  { value: 'priority', label: 'Priority' },\n    35→  { value: 'created', label: 'Created date' },\n    36→  { value: 'updated', label: 'Updated date' },\n    37→  { value: 'status', label: 'Status' },\n    38→];\n    39→\n    40→function formatDateRange(startDate: string, endDate: string): string {\n    41→  const start = new Date(startDate + 'T00:00:00');\n    42→  const end = new Date(endDate + 'T00:00:00');\n    43→  const opts: Intl.DateTimeFormatOptions = { month: 'short', day: 'numeric' };\n    44→  return `${start.toLocaleDateString('en-US', opts)} – ${end.toLocaleDateString('en-US', opts)}`;\n    45→}\n    46→\n    47→function sortIssues(issues: CycleIssue[], sortBy: string): CycleIssue[] {\n    48→  return [...issues].sort((a, b) => {\n    49→    switch (sortBy) {\n    50→      case 'priority':\n    51→        return (PRIORITY_SORT_MAP[a.priority] ?? 4) - (PRIORITY_SORT_MAP[b.priority] ?? 4);\n    52→      case 'created':\n    53→        return new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();\n    54→      case 'updated':\n    55→        return new Date(b.updatedAt).getTime() - new Date(a.updatedAt).getTime();\n    56→      case 'status':\n    57→        return (STATUS_SORT_MAP[a.status] ?? 0) - (STATUS_SORT_MAP[b.status] ?? 0);\n    58→      default:\n    59→        return 0;\n    60→    }\n    61→  });\n    62→}\n    63→\n    64→function getInitials(name: string): string {\n    65→  return name.split(' ').map((n) => n[0]).join('').toUpperCase().slice(0, 2);\n    66→}\n    67→\n    68→interface IssueGroup {\n    69→  key: string;\n    70→  label: string;\n    71→  icon: React.ReactNode;\n    72→  issues: CycleIssue[];\n    73→}\n    74→\n    75→const ALL_STATUSES = ['backlog', 'todo', 'in_progress', 'in_review', 'done', 'cancelled'];\n    76→const STATUS_LABELS: Record<string, string> = {\n    77→  backlog: 'Backlog', todo: 'Todo', in_progress: 'In Progress',\n    78→  in_review: 'In Review', done: 'Done', cancelled: 'Cancelled',\n    79→};\n    80→export default function CycleDetail() {\n    81→  const dispatch = useDispatch<AppDispatch>();\n    82→  const {\n    83→    cycleDetail, cycleIssues, cycleMembers, burndown,\n    84→    detailLoading, groupBy, sortBy, selectedIds,\n    85→  } = useSelector((state: RootState) => state.cycles);\n    86→\n    87→  const [collapsedGroups, setCollapsedGroups] = useState<Record<string, boolean>>({});\n    88→  const [selectedStatuses, setSelectedStatuses] = useState<string[]>([]);\n    89→  const [statusFilterOpen, setStatusFilterOpen] = useState(false);\n    90→  const [groupDropdownOpen, setGroupDropdownOpen] = useState(false);\n    91→  const [sortDropdownOpen, setSortDropdownOpen] = useState(false);\n    92→  const [bulkStatusOpen, setBulkStatusOpen] = useState(false);\n    93→\n    94→  const statusFilterRef = useRef<HTMLDivElement>(null);\n    95→  const groupRef = useRef<HTMLDivElement>(null);\n    96→  const sortRef = useRef<HTMLDivElement>(null);\n    97→  const bulkRef = useRef<HTMLDivElement>(null);\n    98→\n    99→  useEffect(() => {\n   100→    function handleClickOutside(e: MouseEvent) {\n   101→      if (statusFilterRef.current && !statusFilterRef.current.contains(e.target as Node)) {\n   102→        setStatusFilterOpen(false);\n   103→      }\n   104→      if (groupRef.current && !groupRef.current.contains(e.target as Node)) {\n   105→        setGroupDropdownOpen(false);\n   106→      }\n   107→      if (sortRef.current && !sortRef.current.contains(e.target as Node)) {\n   108→        setSortDropdownOpen(false);\n   109→      }\n   110→      if (bulkRef.current && !bulkRef.current.contains(e.target as Node)) {\n   111→        setBulkStatusOpen(false);\n   112→      }\n   113→    }\n   114→    document.addEventListener('mousedown', handleClickOutside);\n   115→    return () => document.removeEventListener('mousedown', handleClickOutside);\n   116→  }, []);\n   117→\n   118→  const filteredIssues = useMemo(() => {\n   119→    if (selectedStatuses.length === 0) return cycleIssues;\n   120→    return cycleIssues.filter((i) => selectedStatuses.includes(i.status));\n   121→  }, [cycleIssues, selectedStatuses]);\n   122→\n   123→  const groups: IssueGroup[] = useMemo(() => {\n   124→    const sorted = sortIssues(filteredIssues, sortBy);\n   125→\n   126→    if (groupBy === 'none') {\n   127→      return [{ key: 'all', label: '', icon: null, issues: sorted }];\n   128→    }\n   129→\n   130→    if (groupBy === 'status') {\n   131→      const result: IssueGroup[] = [];\n   132→      for (const status of STATUS_ORDER) {\n   133→        const cfg = STATUS_CONFIG[status];\n   134→        const groupIssues = sorted.filter((i) => i.status === status);\n   135→        if (groupIssues.length > 0) {\n   136→          result.push({\n   137→            key: status,\n   138→            label: cfg.label,\n   139→            icon: <StatusIcon status={status} color={cfg.color} />,\n   140→            issues: groupIssues,\n   141→          });\n   142→        }\n   143→      }\n   144→      return result;\n   145→    }\n   146→\n   147→    if (groupBy === 'priority') {\n   148→      const result: IssueGroup[] = [];\n   149→      for (const priority of PRIORITY_ORDER) {\n   150→        const cfg = PRIORITY_CONFIG[priority];\n   151→        const groupIssues = sorted.filter((i) => i.priority === priority);\n   152→        if (groupIssues.length > 0) {\n   153→          result.push({\n   154→            key: priority,\n   155→            label: cfg.label,\n   156→            icon: <PriorityIcon priority={priority} />,\n   157→            issues: groupIssues,\n   158→          });\n   159→        }\n   160→      }\n   161→      return result;\n   162→    }\n   163→\n   164→    if (groupBy === 'assignee') {\n   165→      const result: IssueGroup[] = [];\n   166→      const assigneeMap = new Map<string, { name: string; issues: CycleIssue[] }>();\n   167→      for (const m of cycleMembers) {\n   168→        assigneeMap.set(m.id, { name: m.name, issues: [] });\n   169→      }\n   170→      assigneeMap.set('unassigned', { name: 'Unassigned', issues: [] });\n   171→      for (const issue of sorted) {\n   172→        const key = issue.assigneeId || 'unassigned';\n   173→        const entry = assigneeMap.get(key);\n   174→        if (entry) {\n   175→          entry.issues.push(issue);\n   176→        } else {\n   177→          assigneeMap.set(key, { name: issue.assigneeName || 'Unknown', issues: [issue] });\n   178→        }\n   179→      }\n   180→      for (const [key, entry] of assigneeMap.entries()) {\n   181→        if (entry.issues.length > 0) {\n   182→          result.push({\n   183→            key,\n   184→            label: entry.name,\n   185→            icon: key === 'unassigned'\n   186→              ? <span className=\"cycle-detail-avatar cycle-detail-avatar-empty\">?</span>\n   187→              : <span className=\"cycle-detail-avatar\">{getInitials(entry.name)}</span>,\n   188→            issues: entry.issues,\n   189→          });\n   190→        }\n   191→      }\n   192→      return result;\n   193→    }\n   194→\n   195→    if (groupBy === 'project') {\n   196→      const result: IssueGroup[] = [];\n   197→      const projectMap = new Map<string, { name: string; issues: CycleIssue[] }>();\n   198→      projectMap.set('none', { name: 'No Project', issues: [] });\n   199→      for (const issue of sorted) {\n   200→        const key = issue.projectId || 'none';\n   201→        const entry = projectMap.get(key);\n   202→        if (entry) {\n   203→          entry.issues.push(issue);\n   204→        } else {\n   205→          projectMap.set(key, { name: issue.projectName || 'Unknown', issues: [issue] });\n   206→        }\n   207→      }\n   208→      for (const [key, entry] of projectMap.entries()) {\n   209→        if (entry.issues.length > 0) {\n   210→          result.push({\n   211→            key,\n   212→            label: entry.name,\n   213→            icon: <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--color-text-tertiary)\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\"><path d=\"M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z\" /></svg>,\n   214→            issues: entry.issues,\n   215→          });\n   216→        }\n   217→      }\n   218→      return result;\n   219→    }\n   220→\n   221→    if (groupBy === 'label') {\n   222→      const result: IssueGroup[] = [];\n   223→      const labelMap = new Map<string, { name: string; color: string; issues: CycleIssue[] }>();\n   224→      labelMap.set('none', { name: 'No Label', color: 'var(--color-text-tertiary)', issues: [] });\n   225→      for (const issue of sorted) {\n   226→        if (issue.labels.length === 0) {\n   227→          labelMap.get('none')!.issues.push(issue);\n   228→        } else {\n   229→          for (const label of issue.labels) {\n   230→            const entry = labelMap.get(label.id);\n   231→            if (entry) {\n   232→              entry.issues.push(issue);\n   233→            } else {\n   234→              labelMap.set(label.id, { name: label.name, color: label.color, issues: [issue] });\n   235→            }\n   236→          }\n   237→        }\n   238→      }\n   239→      for (const [key, entry] of labelMap.entries()) {\n   240→        if (entry.issues.length > 0) {\n   241→          result.push({\n   242→            key,\n   243→            label: entry.name,\n   244→            icon: <span className=\"cycle-detail-label-dot\" style={{ backgroundColor: entry.color }} />,\n   245→            issues: entry.issues,\n   246→          });\n   247→        }\n   248→      }\n   249→      return result;\n   250→    }\n   251→\n   252→    return [];\n   253→  }, [filteredIssues, groupBy, sortBy, cycleMembers]);\n   254→\n   255→  if (!cycleDetail) return null;\n   256→\n   257→  if (detailLoading) {\n   258→    return (\n   259→      <div className=\"cycle-detail-loading\" data-testid=\"cycle-detail-loading\">\n   260→        Loading...\n   261→      </div>\n   262→    );\n   263→  }\n   264→\n   265→  const totalIssues = cycleIssues.length;\n   266→  const completedIssues = cycleIssues.filter((i) => i.status === 'done').length;\n   267→  const inProgressIssues = cycleIssues.filter((i) => i.status === 'in_progress' || i.status === 'in_review').length;\n   268→  const remainingIssues = totalIssues - completedIssues - inProgressIssues;\n   269→  const completionPct = totalIssues > 0 ? Math.round((completedIssues / totalIssues) * 1000) / 10 : 0;\n   270→\n   271→  const currentGroupLabel = GROUP_OPTIONS.find((o) => o.value === groupBy)?.label || 'Status';\n   272→  const currentSortLabel = SORT_OPTIONS.find((o) => o.value === sortBy)?.label || 'Priority';\n   273→\n   274→  function toggleGroup(key: string) {\n   275→    setCollapsedGroups((prev) => ({ ...prev, [key]: !prev[key] }));\n   276→  }\n   277→\n   278→  function handleCheckChange(issueId: string) {\n   279→    dispatch(toggleCycleIssueSelection(issueId));\n   280→  }\n   281→\n   282→  function handleGroupSelect(ids: string[]) {\n   283→    dispatch(selectCycleGroupIssues(ids));\n   284→  }\n   285→\n   286→  function toggleStatusFilter(status: string) {\n   287→    setSelectedStatuses((prev) =>\n   288→      prev.includes(status) ? prev.filter((s) => s !== status) : [...prev, status]\n   289→    );\n   290→  }\n   291→\n   292→  function handleBulkStatusChange(status: string) {\n   293→    if (cycleDetail) {\n   294→      dispatch(bulkUpdateIssues({\n   295→        issueIds: selectedIds,\n   296→        status,\n   297→        teamId: cycleDetail.teamId,\n   298→      }));\n   299→    }\n   300→    dispatch(clearCycleSelection());\n   301→    setBulkStatusOpen(false);\n   302→  }\n   303→\n   304→  return (\n   305→    <div className=\"cycle-detail\" data-testid=\"cycle-detail\">\n   306→      <div className=\"cycle-detail-header\" data-testid=\"cycle-detail-header\">\n   307→        <div className=\"cycle-detail-header-top\">\n   308→          <h2 className=\"cycle-detail-name\" data-testid=\"cycle-detail-name\">{cycleDetail.name}</h2>\n   309→          <span className=\"cycle-detail-date-range\" data-testid=\"cycle-detail-dates\">\n   310→            {formatDateRange(cycleDetail.startDate, cycleDetail.endDate)}\n   311→          </span>\n   312→        </div>\n   313→      </div>\n   314→\n   315→      <div className=\"cycle-detail-stats\" data-testid=\"cycle-detail-stats\">\n   316→        <div className=\"cycle-detail-stat\" data-testid=\"cycle-stat-total\">\n   317→          <span className=\"cycle-detail-stat-value\">{totalIssues}</span>\n   318→          <span className=\"cycle-detail-stat-label\">Total</span>\n   319→        </div>\n   320→        <div className=\"cycle-detail-stat cycle-detail-stat-done\" data-testid=\"cycle-stat-completed\">\n   321→          <span className=\"cycle-detail-stat-value\">{completedIssues}</span>\n   322→          <span className=\"cycle-detail-stat-label\">Completed</span>\n   323→        </div>\n   324→        <div className=\"cycle-detail-stat cycle-detail-stat-progress\" data-testid=\"cycle-stat-in-progress\">\n   325→          <span className=\"cycle-detail-stat-value\">{inProgressIssues}</span>\n   326→          <span className=\"cycle-detail-stat-label\">In Progress</span>\n   327→        </div>\n   328→        <div className=\"cycle-detail-stat\" data-testid=\"cycle-stat-remaining\">\n   329→          <span className=\"cycle-detail-stat-value\">{remainingIssues}</span>\n   330→          <span className=\"cycle-detail-stat-label\">Remaining</span>\n   331→        </div>\n   332→      </div>\n   333→\n   334→      <div className=\"cycle-detail-progress\" data-testid=\"cycle-detail-progress\">\n   335→        <div className=\"cycle-detail-progress-bar\">\n   336→          <div\n   337→            className=\"cycle-detail-progress-fill\"\n   338→            style={{ width: `${completionPct}%` }}\n   339→          />\n   340→        </div>\n   341→        <span className=\"cycle-detail-progress-text\">\n   342→          {completedIssues} of {totalIssues} ({completionPct}%)\n   343→        </span>\n   344→      </div>\n   345→\n   346→      <BurndownChart\n   347→        burndown={burndown}\n   348→        startDate={cycleDetail.startDate}\n   349→        endDate={cycleDetail.endDate}\n   350→      />\n   351→\n   352→      <div className=\"cycle-detail-toolbar\">\n   353→        <div className=\"cycle-detail-filters\">\n   354→          <div className=\"cycle-detail-filter-control\" ref={statusFilterRef}>\n   355→            <button\n   356→              className={`cycle-detail-filter-btn ${selectedStatuses.length > 0 ? 'cycle-detail-filter-btn-active' : ''}`}\n   357→              onClick={() => setStatusFilterOpen(!statusFilterOpen)}\n   358→              data-testid=\"cycle-status-filter-btn\"\n   359→            >\n   360→              Status{selectedStatuses.length > 0 ? ` (${selectedStatuses.length})` : ''}\n   361→            </button>\n   362→            {statusFilterOpen && (\n   363→              <div className=\"cycle-detail-filter-dropdown\" data-testid=\"cycle-status-filter-dropdown\">\n   364→                {ALL_STATUSES.map((status) => (\n   365→                  <label key={status} className=\"cycle-detail-filter-option\">\n   366→                    <input\n   367→                      type=\"checkbox\"\n   368→                      checked={selectedStatuses.includes(status)}\n   369→                      onChange={() => toggleStatusFilter(status)}\n   370→                      data-testid={`cycle-status-filter-${status}`}\n   371→                    />\n   372→                    <span>{STATUS_LABELS[status]}</span>\n   373→                  </label>\n   374→                ))}\n   375→              </div>\n   376→            )}\n   377→          </div>\n   378→        </div>\n   379→\n   380→        <div className=\"cycle-detail-group-sort\">\n   381→          <div className=\"cycle-detail-filter-control\" ref={groupRef}>\n   382→            <button\n   383→              className=\"cycle-detail-filter-btn\"\n   384→              onClick={() => setGroupDropdownOpen(!groupDropdownOpen)}\n   385→              data-testid=\"cycle-group-by-btn\"\n   386→            >\n   387→              <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n   388→                <line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\" />\n   389→                <line x1=\"3\" y1=\"12\" x2=\"15\" y2=\"12\" />\n   390→                <line x1=\"3\" y1=\"18\" x2=\"9\" y2=\"18\" />\n   391→              </svg>\n   392→              Group: {currentGroupLabel}\n   393→            </button>\n   394→            {groupDropdownOpen && (\n   395→              <div className=\"cycle-detail-filter-dropdown\" data-testid=\"cycle-group-by-dropdown\">\n   396→                {GROUP_OPTIONS.map((opt) => (\n   397→                  <button\n   398→                    key={opt.value}\n   399→                    className={`cycle-detail-dropdown-option ${groupBy === opt.value ? 'cycle-detail-dropdown-option-active' : ''}`}\n   400→                    onClick={() => {\n   401→                      dispatch(setCycleGroupBy(opt.value));\n   402→                      setGroupDropdownOpen(false);\n   403→                    }}\n   404→                    data-testid={`cycle-group-by-option-${opt.value}`}\n   405→                  >\n   406→                    {opt.label}\n   407→                  </button>\n   408→                ))}\n   409→              </div>\n   410→            )}\n   411→          </div>\n   412→          <div className=\"cycle-detail-filter-control\" ref={sortRef}>\n   413→            <button\n   414→              className=\"cycle-detail-filter-btn\"\n   415→              onClick={() => setSortDropdownOpen(!sortDropdownOpen)}\n   416→              data-testid=\"cycle-sort-by-btn\"\n   417→            >\n   418→              <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n   419→                <polyline points=\"3 6 9 6\" />\n   420→                <polyline points=\"3 12 15 12\" />\n   421→                <polyline points=\"3 18 21 18\" />\n   422→              </svg>\n   423→              Sort: {currentSortLabel}\n   424→            </button>\n   425→            {sortDropdownOpen && (\n   426→              <div className=\"cycle-detail-filter-dropdown\" data-testid=\"cycle-sort-by-dropdown\">\n   427→                {SORT_OPTIONS.map((opt) => (\n   428→                  <button\n   429→                    key={opt.value}\n   430→                    className={`cycle-detail-dropdown-option ${sortBy === opt.value ? 'cycle-detail-dropdown-option-active' : ''}`}\n   431→                    onClick={() => {\n   432→                      dispatch(setCycleSortBy(opt.value));\n   433→                      setSortDropdownOpen(false);\n   434→                    }}\n   435→                    data-testid={`cycle-sort-by-option-${opt.value}`}\n   436→                  >\n   437→                    {opt.label}\n   438→                  </button>\n   439→                ))}\n   440→              </div>\n   441→            )}\n   442→          </div>\n   443→        </div>\n   444→      </div>\n   445→\n   446→      {selectedIds.length > 0 && (\n   447→        <div className=\"cycle-detail-bulk-bar\" data-testid=\"cycle-bulk-actions\">\n   448→          <span className=\"cycle-detail-bulk-count\">{selectedIds.length} selected</span>\n   449→          <div className=\"cycle-detail-bulk-actions\" ref={bulkRef}>\n   450→            <button\n   451→              className=\"cycle-detail-bulk-btn\"\n   452→              onClick={() => setBulkStatusOpen(!bulkStatusOpen)}\n   453→              data-testid=\"cycle-bulk-status-btn\"\n   454→            >\n   455→              Set Status\n   456→            </button>\n   457→            {bulkStatusOpen && (\n   458→              <div className=\"cycle-detail-filter-dropdown\" data-testid=\"cycle-bulk-status-dropdown\">\n   459→                {ALL_STATUSES.map((status) => (\n   460→                  <button\n   461→                    key={status}\n   462→                    className=\"cycle-detail-dropdown-option\"\n   463→                    onClick={() => handleBulkStatusChange(status)}\n   464→                    data-testid={`cycle-bulk-status-${status}`}\n   465→                  >\n   466→                    {STATUS_LABELS[status]}\n   467→                  </button>\n   468→                ))}\n   469→              </div>\n   470→            )}\n   471→          </div>\n   472→          <button\n   473→            className=\"cycle-detail-bulk-btn cycle-detail-bulk-clear\"\n   474→            onClick={() => dispatch(clearCycleSelection())}\n   475→            data-testid=\"cycle-bulk-clear\"\n   476→          >\n   477→            Clear\n   478→          </button>\n   479→        </div>\n   480→      )}\n   481→\n   482→      <div className=\"cycle-detail-issues\" data-testid=\"cycle-detail-issues\">\n   483→        {filteredIssues.length === 0 ? (\n   484→          <div className=\"cycle-detail-no-issues\" data-testid=\"cycle-detail-no-issues\">\n   485→            <p>No issues in this cycle</p>\n   486→          </div>\n   487→        ) : groupBy === 'none' ? (\n   488→          groups[0]?.issues.map((issue) => (\n   489→            <IssueRow\n   490→              key={issue.id}\n   491→              issue={issue}\n   492→              showCheckbox\n   493→              checked={selectedIds.includes(issue.id)}\n   494→              onCheckChange={handleCheckChange}\n   495→            />\n   496→          ))\n   497→        ) : (\n   498→          groups.map((group) => {\n   499→            const isCollapsed = !!collapsedGroups[group.key];\n   500→            const groupIssueIds = group.issues.map((i) => i.id);\n   501→            const allSelected = groupIssueIds.length > 0 && groupIssueIds.every((id) => selectedIds.includes(id));\n   502→\n   503→            return (\n   504→              <div key={group.key} className=\"cycle-detail-group\" data-testid={`cycle-issue-group-${group.key}`}>\n   505→                <div className=\"cycle-detail-group-header\" data-testid={`cycle-issue-group-header-${group.key}`}>\n   506→                  <label className=\"cycle-detail-group-select\" onClick={(e) => e.stopPropagation()}>\n   507→                    <input\n   508→                      type=\"checkbox\"\n   509→                      className=\"cycle-detail-group-checkbox\"\n   510→                      checked={allSelected}\n   511→                      onChange={() => handleGroupSelect(groupIssueIds)}\n   512→                    />\n   513→                  </label>\n   514→                  <button\n   515→                    className=\"cycle-detail-group-toggle\"\n   516→                    onClick={() => toggleGroup(group.key)}\n   517→                  >\n   518→                    <svg\n   519→                      className={`cycle-detail-group-chevron ${isCollapsed ? '' : 'cycle-detail-group-chevron-expanded'}`}\n   520→                      width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\"\n   521→                    >\n   522→                      <polyline points=\"9 18 15 12 9 6\" />\n   523→                    </svg>\n   524→                    {group.icon}\n   525→                    <span className=\"cycle-detail-group-label\">{group.label}</span>\n   526→                    <span className=\"cycle-detail-group-count\">({group.issues.length})</span>\n   527→                  </button>\n   528→                </div>\n   529→                {!isCollapsed && (\n   530→                  <div className=\"cycle-detail-group-items\" data-testid={`cycle-issue-group-items-${group.key}`}>\n   531→                    {group.issues.map((issue) => (\n   532→                      <IssueRow\n   533→                        key={issue.id}\n   534→                        issue={issue}\n   535→                        showCheckbox\n   536→                        checked={selectedIds.includes(issue.id)}\n   537→                        onCheckChange={handleCheckChange}\n   538→                      />\n   539→                    ))}\n   540→                  </div>\n   541→                )}\n   542→              </div>\n   543→            );\n   544→          })\n   545→        )}\n   546→      </div>\n   547→    </div>\n   548→  );\n   549→}\n   550→"}]},"parent_tool_use_id":"toolu_0129VysynLthoNVxkgaaq7jb","session_id":"6ee9f87d-051a-4e97-9b18-73c5fcdfaaeb","uuid":"df519788-e852-43d8-aa20-6a5f50106b82"}
