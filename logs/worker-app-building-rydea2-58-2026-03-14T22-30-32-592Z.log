[2026-03-14T22:27:27.445Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01R2Zeeq9LwemMana4QTVfgo","type":"tool_result","content":"     1→import type { BurndownEntry } from '../slices/cyclesSlice';\n     2→import './BurndownChart.css';\n     3→\n     4→interface BurndownChartProps {\n     5→  burndown: BurndownEntry[];\n     6→  startDate: string;\n     7→  endDate: string;\n     8→}\n     9→\n    10→function getAllDates(startDate: string, endDate: string): string[] {\n    11→  const dates: string[] = [];\n    12→  const current = new Date(startDate + 'T00:00:00');\n    13→  const end = new Date(endDate + 'T00:00:00');\n    14→  while (current <= end) {\n    15→    const year = current.getFullYear();\n    16→    const month = String(current.getMonth() + 1).padStart(2, '0');\n    17→    const day = String(current.getDate()).padStart(2, '0');\n    18→    dates.push(`${year}-${month}-${day}`);\n    19→    current.setDate(current.getDate() + 1);\n    20→  }\n    21→  return dates;\n    22→}\n    23→\n    24→function formatDateLabel(dateStr: string): string {\n    25→  const date = new Date(dateStr + 'T00:00:00');\n    26→  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });\n    27→}\n    28→\n    29→export default function BurndownChart({ burndown, startDate, endDate }: BurndownChartProps) {\n    30→  const allDates = getAllDates(startDate, endDate);\n    31→  const burndownMap: Record<string, number> = {};\n    32→  for (const entry of burndown) {\n    33→    burndownMap[entry.date] = entry.count;\n    34→  }\n    35→\n    36→  const data = allDates.map((date) => ({\n    37→    date,\n    38→    count: burndownMap[date] || 0,\n    39→  }));\n    40→\n    41→  const maxCount = Math.max(1, ...data.map((d) => d.count));\n    42→  const showEveryNthLabel = allDates.length > 14 ? Math.ceil(allDates.length / 14) : 1;\n    43→  const hasCompletions = burndown.length > 0;\n    44→\n    45→  return (\n    46→    <div className=\"burndown-chart\" data-testid=\"burndown-chart\">\n    47→      <h3 className=\"burndown-chart-title\" data-testid=\"burndown-chart-title\">Issues Completed per Day</h3>\n    48→      {!hasCompletions ? (\n    49→        <div className=\"burndown-chart-empty\" data-testid=\"burndown-chart-empty\">\n    50→          <p>No issues completed yet</p>\n    51→        </div>\n    52→      ) : null}\n    53→      <div className=\"burndown-chart-container\" data-testid=\"burndown-chart-container\">\n    54→        <div className=\"burndown-chart-y-axis\">\n    55→          {Array.from({ length: maxCount + 1 }, (_, i) => maxCount - i).map((val) => (\n    56→            <span key={val} className=\"burndown-chart-y-label\">{val}</span>\n    57→          ))}\n    58→        </div>\n    59→        <div className=\"burndown-chart-bars-wrapper\">\n    60→          <div className=\"burndown-chart-bars\">\n    61→            {data.map((d, i) => (\n    62→              <div\n    63→                key={d.date}\n    64→                className=\"burndown-chart-bar-column\"\n    65→                data-testid={`burndown-bar-${d.date}`}\n    66→              >\n    67→                <div className=\"burndown-chart-bar-track\">\n    68→                  <div\n    69→                    className=\"burndown-chart-bar\"\n    70→                    style={{ height: `${(d.count / maxCount) * 100}%` }}\n    71→                    title={`${formatDateLabel(d.date)}: ${d.count} issue${d.count !== 1 ? 's' : ''}`}\n    72→                  />\n    73→                </div>\n    74→                {i % showEveryNthLabel === 0 && (\n    75→                  <span className=\"burndown-chart-x-label\">{formatDateLabel(d.date)}</span>\n    76→                )}\n    77→                {i % showEveryNthLabel !== 0 && (\n    78→                  <span className=\"burndown-chart-x-label burndown-chart-x-label-hidden\">&nbsp;</span>\n    79→                )}\n    80→              </div>\n    81→            ))}\n    82→          </div>\n    83→        </div>\n    84→      </div>\n    85→    </div>\n    86→  );\n    87→}\n    88→"}]},"parent_tool_use_id":null,"session_id":"6ee9f87d-051a-4e97-9b18-73c5fcdfaaeb","uuid":"77d631a3-b24b-4b86-a212-c49ee53dc984","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/src/components/BurndownChart.tsx","content":"import type { BurndownEntry } from '../slices/cyclesSlice';\nimport './BurndownChart.css';\n\ninterface BurndownChartProps {\n  burndown: BurndownEntry[];\n  startDate: string;\n  endDate: string;\n}\n\nfunction getAllDates(startDate: string, endDate: string): string[] {\n  const dates: string[] = [];\n  const current = new Date(startDate + 'T00:00:00');\n  const end = new Date(endDate + 'T00:00:00');\n  while (current <= end) {\n    const year = current.getFullYear();\n    const month = String(current.getMonth() + 1).padStart(2, '0');\n    const day = String(current.getDate()).padStart(2, '0');\n    dates.push(`${year}-${month}-${day}`);\n    current.setDate(current.getDate() + 1);\n  }\n  return dates;\n}\n\nfunction formatDateLabel(dateStr: string): string {\n  const date = new Date(dateStr + 'T00:00:00');\n  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });\n}\n\nexport default function BurndownChart({ burndown, startDate, endDate }: BurndownChartProps) {\n  const allDates = getAllDates(startDate, endDate);\n  const burndownMap: Record<string, number> = {};\n  for (const entry of burndown) {\n    burndownMap[entry.date] = entry.count;\n  }\n\n  const data = allDates.map((date) => ({\n    date,\n    count: burndownMap[date] || 0,\n  }));\n\n  const maxCount = Math.max(1, ...data.map((d) => d.count));\n  const showEveryNthLabel = allDates.length > 14 ? Math.ceil(allDates.length / 14) : 1;\n  const hasCompletions = burndown.length > 0;\n\n  return (\n    <div className=\"burndown-chart\" data-testid=\"burndown-chart\">\n      <h3 className=\"burndown-chart-title\" data-testid=\"burndown-chart-title\">Issues Completed per Day</h3>\n      {!hasCompletions ? (\n        <div className=\"burndown-chart-empty\" data-testid=\"burndown-chart-empty\">\n          <p>No issues completed yet</p>\n        </div>\n      ) : null}\n      <div className=\"burndown-chart-container\" data-testid=\"burndown-chart-container\">\n        <div className=\"burndown-chart-y-axis\">\n          {Array.from({ length: maxCount + 1 }, (_, i) => maxCount - i).map((val) => (\n            <span key={val} className=\"burndown-chart-y-label\">{val}</span>\n          ))}\n        </div>\n        <div className=\"burndown-chart-bars-wrapper\">\n          <div className=\"burndown-chart-bars\">\n            {data.map((d, i) => (\n              <div\n                key={d.date}\n                className=\"burndown-chart-bar-column\"\n                data-testid={`burndown-bar-${d.date}`}\n              >\n                <div className=\"burndown-chart-bar-track\">\n                  <div\n                    className=\"burndown-chart-bar\"\n                    style={{ height: `${(d.count / maxCount) * 100}%` }}\n                    title={`${formatDateLabel(d.date)}: ${d.count} issue${d.count !== 1 ? 's' : ''}`}\n                  />\n                </div>\n                {i % showEveryNthLabel === 0 && (\n                  <span className=\"burndown-chart-x-label\">{formatDateLabel(d.date)}</span>\n                )}\n                {i % showEveryNthLabel !== 0 && (\n                  <span className=\"burndown-chart-x-label burndown-chart-x-label-hidden\">&nbsp;</span>\n                )}\n              </div>\n            ))}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n","numLines":88,"startLine":1,"totalLines":88}}}
