[2026-03-14T22:11:34.274Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014BSBhvqiFN5zXgnrW189YH","type":"tool_result","content":"     1→import { useState, useEffect, useCallback } from 'react';\n     2→import { useSelector, useDispatch } from 'react-redux';\n     3→import { useNavigate, useParams } from 'react-router-dom';\n     4→import type { RootState, AppDispatch } from '../store';\n     5→import { closeCreateIssueModal } from '../slices/uiSlice';\n     6→import { createIssue } from '../slices/issuesSlice';\n     7→import { fetchTeamIssues } from '../slices/teamIssuesSlice';\n     8→import { fetchIssueDetail } from '../slices/issueDetailSlice';\n     9→import CreateIssueForm from './CreateIssueForm';\n    10→import type { CreateIssueFormData } from './CreateIssueForm';\n    11→import CreateIssueActions from './CreateIssueActions';\n    12→import './CreateIssueModal.css';\n    13→\n    14→const INITIAL_FORM_DATA: CreateIssueFormData = {\n    15→  teamId: '',\n    16→  title: '',\n    17→  description: '',\n    18→  status: 'backlog',\n    19→  priority: 'none',\n    20→  assigneeId: null,\n    21→  labelIds: [],\n    22→  projectId: null,\n    23→  cycleId: null,\n    24→  dueDate: null,\n    25→  parentId: null,\n    26→};\n    27→\n    28→export default function CreateIssueModal() {\n    29→  const dispatch = useDispatch<AppDispatch>();\n    30→  const navigate = useNavigate();\n    31→  const params = useParams<{ teamId?: string }>();\n    32→  const { createIssueModalOpen, createIssueDefaultParentId, createIssueDefaultTeamId } = useSelector((state: RootState) => state.ui);\n    33→  const { workspace } = useSelector((state: RootState) => state.workspace);\n    34→\n    35→  const [formData, setFormData] = useState<CreateIssueFormData>({ ...INITIAL_FORM_DATA });\n    36→  const [titleError, setTitleError] = useState<string | null>(null);\n    37→  const [submitting, setSubmitting] = useState(false);\n    38→  const [createdIdentifier, setCreatedIdentifier] = useState<string | null>(null);\n    39→\n    40→  // Reset form when modal opens\n    41→  useEffect(() => {\n    42→    if (createIssueModalOpen) {\n    43→      setFormData({\n    44→        ...INITIAL_FORM_DATA,\n    45→        parentId: createIssueDefaultParentId || null,\n    46→        teamId: createIssueDefaultTeamId || '',\n    47→      });\n    48→      setTitleError(null);\n    49→      setSubmitting(false);\n    50→      setCreatedIdentifier(null);\n    51→    }\n    52→  }, [createIssueModalOpen, createIssueDefaultParentId, createIssueDefaultTeamId]);\n    53→\n    54→  const handleClose = useCallback(() => {\n    55→    dispatch(closeCreateIssueModal());\n    56→  }, [dispatch]);\n    57→\n    58→  // Handle Escape key\n    59→  useEffect(() => {\n    60→    if (!createIssueModalOpen) return;\n    61→    function handleKeyDown(e: KeyboardEvent) {\n    62→      if (e.key === 'Escape') {\n    63→        handleClose();\n    64→      }\n    65→    }\n    66→    document.addEventListener('keydown', handleKeyDown);\n    67→    return () => document.removeEventListener('keydown', handleKeyDown);\n    68→  }, [createIssueModalOpen, handleClose]);\n    69→\n    70→  async function handleSubmit() {\n    71→    if (!formData.title.trim()) {\n    72→      setTitleError('Title is required');\n    73→      return;\n    74→    }\n    75→    setTitleError(null);\n    76→    setSubmitting(true);\n    77→\n    78→    try {\n    79→      const result = await dispatch(createIssue({\n    80→        teamId: formData.teamId,\n    81→        title: formData.title.trim(),\n    82→        description: formData.description,\n    83→        status: formData.status,\n    84→        priority: formData.priority,\n    85→        assigneeId: formData.assigneeId,\n    86→        labelIds: formData.labelIds,\n    87→        projectId: formData.projectId,\n    88→        cycleId: formData.cycleId,\n    89→        dueDate: formData.dueDate,\n    90→        parentId: formData.parentId,\n    91→      })).unwrap();\n    92→\n    93→      // Show created identifier briefly\n    94→      setCreatedIdentifier(result.identifier);\n    95→\n    96→      // Refetch team issues if on a team page\n    97→      if (formData.teamId) {\n    98→        dispatch(fetchTeamIssues(formData.teamId));\n    99→      }\n   100→"}]},"parent_tool_use_id":"toolu_01GXS8HpDfRJXx4TTExZu4wR","session_id":"76315a28-cc1e-49a3-a261-76be14759feb","uuid":"f3b2eece-8e2a-4b0e-9479-fd746e4416f4"}
