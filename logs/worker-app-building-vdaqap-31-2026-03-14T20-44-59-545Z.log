[2026-03-14T20:43:21.061Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WjR2Y2HKjmhR5KPCb3Ax2z","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test'\n     2→\n     3→/**\n     4→ * Helper to build a results page URL with search parameters.\n     5→ */\n     6→function buildResultsUrl(params?: {\n     7→  origin?: string\n     8→  destination?: string\n     9→  departureDate?: string\n    10→  cabinClass?: string\n    11→  adults?: string\n    12→  children?: string\n    13→  infants?: string\n    14→  returnDate?: string\n    15→}): string {\n    16→  const sp = new URLSearchParams({\n    17→    origin: params?.origin ?? 'LAX',\n    18→    destination: params?.destination ?? 'JFK',\n    19→    departureDate: params?.departureDate ?? '2026-04-01',\n    20→    tripType: 'round_trip',\n    21→    cabinClass: params?.cabinClass ?? 'economy',\n    22→    adults: params?.adults ?? '1',\n    23→    children: params?.children ?? '0',\n    24→    infants: params?.infants ?? '0',\n    25→    returnDate: params?.returnDate ?? '2026-04-08',\n    26→  })\n    27→  return `/results?${sp.toString()}`\n    28→}\n    29→\n    30→/**\n    31→ * Navigate to results, find a flight by flight number, extract its ID,\n    32→ * then navigate to the booking page for that flight.\n    33→ */\n    34→async function navigateToBookingPage(\n    35→  page: import('@playwright/test').Page,\n    36→  options: {\n    37→    origin?: string\n    38→    destination?: string\n    39→    departureDate?: string\n    40→    cabinClass?: string\n    41→    adults?: string\n    42→    children?: string\n    43→    infants?: string\n    44→    returnDate?: string\n    45→    flightNumber?: string\n    46→    returnFlightId?: string\n    47→  } = {}\n    48→) {\n    49→  // Navigate to search results to get a flight ID\n    50→  await page.goto(buildResultsUrl({\n    51→    origin: options.origin,\n    52→    destination: options.destination,\n    53→    departureDate: options.departureDate,\n    54→    cabinClass: options.cabinClass,\n    55→    adults: options.adults,\n    56→    children: options.children,\n    57→    infants: options.infants,\n    58→    returnDate: options.returnDate,\n    59→  }))\n    60→  await expect(page.getByTestId('search-results-page')).toBeVisible({ timeout: 15000 })\n    61→  await expect(page.getByTestId('results-list')).toBeVisible({ timeout: 15000 })\n    62→\n    63→  let flightId: string\n    64→\n    65→  if (options.flightNumber) {\n    66→    // Find the card containing the specified flight number\n    67→    const card = page.locator('[data-testid^=\"flight-card-\"]').filter({\n    68→      has: page.locator(`[data-testid^=\"flight-card-flightnum-\"]`, { hasText: new RegExp(`^${options.flightNumber}$`) })\n    69→    }).locator('[data-testid^=\"flight-card-main-\"]')\n    70→    await expect(card).toBeVisible({ timeout: 10000 })\n    71→    const testId = await card.getAttribute('data-testid')\n    72→    flightId = testId!.replace('flight-card-main-', '')\n    73→  } else {\n    74→    // Use first card\n    75→    const firstCard = page.locator('[data-testid^=\"flight-card-main-\"]').first()\n    76→    const testId = await firstCard.getAttribute('data-testid')\n    77→    flightId = testId!.replace('flight-card-main-', '')\n    78→  }\n    79→\n    80→  // Build booking URL\n    81→  const bookingParams = new URLSearchParams({\n    82→    cabin: options.cabinClass ?? 'economy',\n    83→    adults: options.adults ?? '1',\n    84→    children: options.children ?? '0',\n    85→    infants: options.infants ?? '0',\n    86→  })\n    87→  if (options.returnFlightId) {\n    88→    bookingParams.set('returnFlight', options.returnFlightId)\n    89→  }\n    90→\n    91→  await page.goto(`/booking/${flightId}?${bookingParams.toString()}`)\n    92→  await expect(page.getByTestId('flight-details-page')).toBeVisible({ timeout: 15000 })\n    93→  await expect(page.getByTestId('flight-summary')).toBeVisible({ timeout: 15000 })\n    94→\n    95→  return flightId\n    96→}\n    97→\n    98→test.describe('FlightSummary', () => {\n    99→  test('FlightSummary displays full outbound itinerary', async ({ page }) => {\n   100→    // Navigate to a nonstop LAX→JFK flight (DL200: Delta, 5h 30m)\n   101→    await navigateToBookingPage(page, { flightNumber: 'DL200' })\n   102→\n   103→    // Verify the flight summary header shows the route\n   104→    const header = page.getByTestId('flight-summary-header')\n   105→    await expect(header).toBeVisible()\n   106→    await expect(header).toContainText('LAX')\n   107→    await expect(header).toContainText('JFK')\n   108→\n   109→    // Verify duration\n   110→    await expect(page.getByTestId('flight-summary-duration')).toContainText('5h 30m')\n   111→\n   112→    // Verify stops (nonstop)\n   113→    await expect(page.getByTestId('flight-summary-stops')).toContainText('Nonstop')\n   114→\n   115→    // Verify the leg details\n   116→    const leg = page.getByTestId('flight-summary-leg-1')\n   117→    await expect(leg).toBeVisible()\n   118→\n   119→    // Airline name\n   120→    await expect(page.getByTestId('flight-summary-airline-1')).toContainText('Delta Air Lines')\n   121→\n   122→    // Flight number\n   123→    await expect(page.getByTestId('flight-summary-flightnum-1')).toContainText('DL200')\n   124→\n   125→    // Departure and arrival times should be visible and contain AM/PM\n   126→    await expect(page.getByTestId('flight-summary-dep-time-1')).toContainText(/[AP]M/)\n   127→    await expect(page.getByTestId('flight-summary-arr-time-1')).toContainText(/[AP]M/)\n   128→\n   129→    // Terminal info (seed data adds T1/T2 for single-leg flights)\n   130→    await expect(page.getByTestId('flight-summary-dep-terminal-1')).toContainText('Terminal')\n   131→    await expect(page.getByTestId('flight-summary-arr-terminal-1')).toContainText('Terminal')\n   132→\n   133→    // Label shows outbound\n   134→    await expect(page.getByTestId('flight-summary-label')).toContainText('Outbound')\n   135→    await expect(page.getByTestId('flight-summary-label')).toContainText('LAX → JFK')\n   136→  })\n   137→\n   138→  test('FlightSummary displays outbound and return flights for round trip', async ({ page }) => {\n   139→    // First, get a return flight ID from JFK→LAX results\n   140→    await page.goto(buildResultsUrl({\n   141→      origin: 'JFK',\n   142→      destination: 'LAX',\n   143→      departureDate: '2026-04-08',\n   144→    }))\n   145→    await expect(page.getByTestId('search-results-page')).toBeVisible({ timeout: 15000 })\n   146→    await expect(page.getByTestId('results-list')).toBeVisible({ timeout: 15000 })\n   147→\n   148→    const returnCard = page.locator('[data-testid^=\"flight-card-main-\"]').first()\n   149→    const returnTestId = await returnCard.getAttribute('data-testid')\n   150→    const returnFlightId = returnTestId!.replace('flight-card-main-', '')\n   151→\n   152→    // Now get an outbound flight ID from LAX→JFK results\n   153→    await page.goto(buildResultsUrl())\n   154→    await expect(page.getByTestId('search-results-page')).toBeVisible({ timeout: 15000 })\n   155→    await expect(page.getByTestId('results-list')).toBeVisible({ timeout: 15000 })\n   156→\n   157→    const outboundCard = page.locator('[data-testid^=\"flight-card-main-\"]').first()\n   158→    const outboundTestId = await outboundCard.getAttribute('data-testid')\n   159→    const outboundFlightId = outboundTestId!.replace('flight-card-main-', '')\n   160→\n   161→    // Navigate to booking page with both outbound and return flights\n   162→    const bookingParams = new URLSearchParams({\n   163→      cabin: 'economy',\n   164→      adults: '1',\n   165→      children: '0',\n   166→      infants: '0',\n   167→      returnFlight: returnFlightId,\n   168→    })\n   169→    await page.goto(`/booking/${outboundFlightId}?${bookingParams.toString()}`)\n   170→    await expect(page.getByTestId('flight-details-page')).toBeVisible({ timeout: 15000 })\n   171→\n   172→    // Wait for both flight summaries to appear\n   173→    const summaries = page.getByTestId('flight-summary')\n   174→    await expect(summaries).toHaveCount(2, { timeout: 15000 })\n   175→\n   176→    // First summary should be outbound (LAX→JFK)\n   177→    const labels = page.getByTestId('flight-summary-label')\n   178→    await expect(labels.first()).toContainText('Outbound')\n   179→    await expect(labels.first()).toContainText('LAX')\n   180→    await expect(labels.first()).toContainText('JFK')\n   181→\n   182→    // Second summary should be return (JFK→LAX)\n   183→    await expect(labels.nth(1)).toContainText('Return')\n   184→    await expect(labels.nth(1)).toContainText('JFK')\n   185→    await expect(labels.nth(1)).toContainText('LAX')\n   186→  })\n   187→\n   188→  test('FlightSummary displays connecting flight with multiple legs', async ({ page }) => {\n   189→    // AA101: LAX→DFW→JFK, 1 stop, 7h\n   190→    await navigateToBookingPage(page, { flightNumber: 'AA101' })\n   191→\n   192→    // Should show 1 stop\n   193→    await expect(page.getByTestId('flight-summary-stops')).toContainText('1 stop')\n   194→\n   195→    // Should show total duration 7h\n   196→    await expect(page.getByTestId('flight-summary-duration')).toContainText('7h')\n   197→\n   198→    // Leg 1: LAX → DFW\n   199→    const leg1 = page.getByTestId('flight-summary-leg-1')\n   200→    await expect(leg1).toBeVisible({ timeout: 10000 })\n   201→    await expect(leg1).toContainText('LAX')\n   202→    await expect(leg1).toContainText('DFW')\n   203→\n   204→    // Verify departure terminal on leg 1\n   205→    await expect(page.getByTestId('flight-summary-dep-terminal-1')).toContainText('T4')\n   206→    await expect(page.getByTestId('flight-summary-arr-terminal-1')).toContainText('TC')\n   207→\n   208→    // Layover indicator between legs\n   209→    const layover = page.getByTestId('flight-summary-layover-1')\n   210→    await expect(layover).toBeVisible()\n   211→    await expect(layover).toContainText('layover')\n   212→    await expect(layover).toContainText('DFW')\n   213→\n   214→    // Leg 2: DFW → JFK\n   215→    const leg2 = page.getByTestId('flight-summary-leg-2')\n   216→    await expect(leg2).toBeVisible()\n   217→    await expect(leg2).toContainText('DFW')\n   218→    await expect(leg2).toContainText('JFK')\n   219→\n   220→    // Verify terminals on leg 2\n   221→    await expect(page.getByTestId('flight-summary-dep-terminal-2')).toContainText('TC')\n   222→    await expect(page.getByTestId('flight-summary-arr-terminal-2')).toContainText('T8')\n   223→  })\n   224→\n   225→  test('FlightSummary shows total duration and stops count', async ({ page }) => {\n   226→    // Test with nonstop flight first\n   227→    await navigateToBookingPage(page, { flightNumber: 'AA100' })\n   228→\n   229→    await expect(page.getByTestId('flight-summary-duration')).toContainText('5h 30m')\n   230→    await expect(page.getByTestId('flight-summary-stops')).toContainText('Nonstop')\n   231→\n   232→    // Now test with 1-stop flight\n   233→    await navigateToBookingPage(page, { flightNumber: 'AA101' })\n   234→\n   235→    await expect(page.getByTestId('flight-summary-duration')).toContainText('7h')\n   236→    await expect(page.getByTestId('flight-summary-stops')).toContainText('1 stop')\n   237→  })\n   238→\n   239→  test('FlightSummary shows overnight arrival indicator', async ({ page }) => {\n   240→    // BA100: JFK→LHR departs 19:00, arrives 07:00 next day (+1)\n   241→    await navigateToBookingPage(page, {\n   242→      origin: 'JFK',\n   243→      destination: 'LHR',\n   244→      flightNumber: 'BA100',\n   245→    })\n   246→\n   247→    // Overnight indicator should be visible\n   248→    const overnightNote = page.getByTestId('flight-summary-overnight')\n   249→    await expect(overnightNote).toBeVisible()\n   250→    await expect(overnightNote).toContainText('+1')\n   251→\n   252→    // The +1 day indicator should also show on the leg arrival time\n   253→    const dayIndicator = page.getByTestId('flight-summary-day-1')\n   254→    await expect(dayIndicator).toBeVisible()\n   255→    await expect(dayIndicator).toContainText('+1')\n   256→  })\n   257→\n   258→  test('FlightSummary shows aircraft type and amenities', async ({ page }) => {\n   259→    // B6400: LAX→JFK, Airbus A321, wifi=true, power=true, entertainment=false\n   260→    await navigateToBookingPage(page, { flightNumber: 'B6400' })\n   261→\n   262→    // Aircraft type should be displayed\n   263→    await expect(page.getByTestId('flight-summary-aircraft-1')).toContainText('Airbus A321')\n   264→\n   265→    // Amenities section\n   266→    const amenities = page.getByTestId('flight-summary-amenities')\n   267→    await expect(amenities).toBeVisible()\n   268→\n   269→    // Wi-Fi should be shown\n   270→    await expect(page.getByTestId('flight-summary-wifi')).toBeVisible()\n   271→    await expect(page.getByTestId('flight-summary-wifi')).toContainText('Wi-Fi')\n   272→\n   273→    // Power should be shown\n   274→    await expect(page.getByTestId('flight-summary-power')).toBeVisible()\n   275→    await expect(page.getByTestId('flight-summary-power')).toContainText('Power')\n   276→\n   277→    // Entertainment should NOT be shown (has_entertainment=false)\n   278→    await expect(page.getByTestId('flight-summary-entertainment')).not.toBeVisible()\n   279→  })\n   280→\n   281→  test('FlightSummary shows baggage allowance', async ({ page }) => {\n   282→    // Economy flight: \"1 carry-on bag, 1 personal item\"\n   283→    await navigateToBookingPage(page, { cabinClass: 'economy' })\n   284→\n   285→    const baggage = page.getByTestId('flight-summary-baggage')\n   286→    await expect(baggage).toBeVisible()\n   287→    await expect(baggage).toContainText('1 carry-on bag, 1 personal item')\n   288→\n   289→    // Premium economy: \"1 carry-on bag, 1 checked bag included\"\n   290→    await navigateToBookingPage(page, { cabinClass: 'premium_economy' })\n   291→    await expect(page.getByTestId('flight-summary-baggage')).toContainText('1 carry-on bag, 1 checked bag included')\n   292→\n   293→    // Business: \"2 carry-on bags, 2 checked bags included\"\n   294→    await navigateToBookingPage(page, { cabinClass: 'business' })\n   295→    await expect(page.getByTestId('flight-summary-baggage')).toContainText('2 carry-on bags, 2 checked bags included')\n   296→  })\n   297→})\n   298→"}]},"parent_tool_use_id":"toolu_01ERVcquoLeJ2Zqv3Nicn9Ag","session_id":"070807e6-44c2-402e-bd72-2ebebd488457","uuid":"ff866329-0c35-4b5c-bb5f-18f71ec9732f"}
