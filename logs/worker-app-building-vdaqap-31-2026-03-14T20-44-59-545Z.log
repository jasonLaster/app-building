 79→  // Clear recent searches by clearing localStorage session token so a fresh one is created\n    80→  await page.evaluate(() => {\n    81→    localStorage.removeItem('gf_session_token')\n    82→  })\n    83→}\n    84→\n    85→test.describe('RecentSearches', () => {\n    86→  test.beforeEach(async ({ page }) => {\n    87→    await page.goto('/')\n    88→    await expect(page.getByTestId('search-page')).toBeVisible({ timeout: 10000 })\n    89→    // Clear session to start fresh with no recent searches\n    90→    await deleteAllRecentSearches(page)\n    91→    await page.reload()\n    92→    await expect(page.getByTestId('search-page')).toBeVisible({ timeout: 10000 })\n    93→  })\n    94→\n    95→  test('RecentSearches shows empty state when no searches exist', async ({ page }) => {\n    96→    // Wait for loading to finish and check empty state\n    97→    await expect(page.getByTestId('recent-searches-empty')).toBeVisible({ timeout: 10000 })\n    98→    await expect(page.getByTestId('recent-searches-empty')).toHaveText('No recent searches')\n    99→  })\n   100→\n   101→  test('RecentSearches displays a recent search entry', async ({ page }) => {\n   102→    // Perform a search: LAX → JFK\n   103→    await fillSearchForm(page, {\n   104→      originSearch: 'Los',\n   105→      originCode: 'LAX',\n   106→      destSearch: 'New',\n   107→      destCode: 'JFK',\n   108→    })\n   109→    await page.getByTestId('search-button').click()\n   110→    await expect(page).toHaveURL(/\\/results\\?/, { timeout: 10000 })\n   111→\n   112→    // Navigate back to search page\n   113→    await page.goto('/')\n   114→    await expect(page.getByTestId('search-page')).toBeVisible({ timeout: 10000 })\n   115→\n   116→    // Verify recent search entry is displayed\n   117→    const recentList = page.getByTestId('recent-searches-list')\n   118→    await expect(recentList).toBeVisible({ timeout: 10000 })\n   119→    await expect(recentList).toContainText('LAX')\n   120→    await expect(recentList).toContainText('JFK')\n   121→    await expect(recentList).toContainText('1 passenger')\n   122→  })\n   123→\n   124→  test('RecentSearches clicking a recent search re-populates the form', async ({ page }) => {\n   125→    // Perform a search: LAX → JFK with 2 adults, Business class\n   126→    await fillSearchForm(page, {\n   127→      originSearch: 'Los',\n   128→      originCode: 'LAX',\n   129→      destSearch: 'New',\n   130→      destCode: 'JFK',\n   131→      adults: 2,\n   132→      cabinClass: 'business',\n   133→    })\n   134→    await page.getByTestId('search-button').click()\n   135→    await expect(page).toHaveURL(/\\/results\\?/, { timeout: 10000 })\n   136→\n   137→    // Navigate back to search page\n   138→    await page.goto('/')\n   139→    await expect(page.getByTestId('search-page')).toBeVisible({ timeout: 10000 })\n   140→\n   141→    // Click the recent search entry\n   142→    const recentList = page.getByTestId('recent-searches-list')\n   143→    await expect(recentList).toBeVisible({ timeout: 10000 })\n   144→    const recentItem = recentList.locator('button').first()\n   145→    await recentItem.click()\n   146→\n   147→    // Should navigate to results with the search parameters\n   148→    await expect(page).toHaveURL(/\\/results\\?/, { timeout: 10000 })\n   149→    const url = page.url()\n   150→    expect(url).toContain('origin=LAX')\n   151→    expect(url).toContain('destination=JFK')\n   152→    expect(url).toContain('cabinClass=business')\n   153→    expect(url).toContain('adults=2')\n   154→  })\n   155→\n   156→  test('RecentSearches displays multiple recent searches in order', async ({ page }) => {\n   157→    test.slow()\n   158→\n   159→    // Search 1: LAX → JFK\n   160→    await fillSearchForm(page, {\n   161→      originSearch: 'Los',\n   162→      originCode: 'LAX',\n   163→      destSearch: 'New',\n   164→      destCode: 'JFK',\n   165→    })\n   166→    await page.getByTestId('search-button').click()\n   167→    await expect(page).toHaveURL(/\\/results\\?/, { timeout: 10000 })\n   168→\n   169→    // Go back\n   170→    await page.goto('/')\n   171→    await expect(page.getByTestId('search-page')).toBeVisible({ timeout: 10000 })\n   172→\n   173→    // Search 2: SFO → ORD\n   174→    await fillSearchForm(page, {\n   175→      originSearch: 'San Fran',\n   176→      originCode: 'SFO',\n   177→      destSearch: 'Chicago',\n   178→      destCode: 'ORD',\n   179→    })\n   180→    await page.getByTestId('search-button').click()\n   181→    await expect(page).toHaveURL(/\\/results\\?/, { timeout: 10000 })\n   182→\n   183→    // Go back\n   184→    await page.goto('/')\n   185→    await expect(page.getByTestId('search-page')).toBeVisible({ timeout: 10000 })\n   186→\n   187→    // Search 3: LAX → LHR\n   188→    await fillSearchForm(page, {\n   189→      originSearch: 'Los',\n   190→      originCode: 'LAX',\n   191→      destSearch: 'London',\n   192→      destCode: 'LHR',\n   193→    })\n   194→    await page.getByTestId('search-button').click()\n   195→    await expect(page).toHaveURL(/\\/results\\?/, { timeout: 10000 })\n   196→\n   197→    // Go back and check order\n   198→    await page.goto('/')\n   199→    await expect(page.getByTestId('search-page')).toBeVisible({ timeout: 10000 })\n   200→\n   201→    const recentList = page.getByTestId('recent-searches-list')\n   202→    await expect(recentList).toBeVisible({ timeout: 10000 })\n   203→\n   204→    // Should have 3 items\n   205→    const items = recentList.locator('button')\n   206→    await expect(items).toHaveCount(3, { timeout: 10000 })\n   207→\n   208→    // Most recent (LAX → LHR) should be first\n   209→    await expect(items.nth(0)).toContainText('LHR')\n   210→    // Second (SFO → ORD)\n   211→    await expect(items.nth(1)).toContainText('ORD')\n   212→    // Oldest (LAX → JFK)\n   213→    await expect(items.nth(2)).toContainText('JFK')\n   214→  })\n   215→\n   216→  test('RecentSearches updates after