[2026-03-14T20:43:26.137Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017UVqRzqpXDo9zCM2UnNUSR","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test'\n     2→\n     3→/**\n     4→ * Helper to fill a valid search form with specified origin/destination codes.\n     5→ */\n     6→async function fillSearchForm(page: import('@playwright/test').Page, options: {\n     7→  originSearch: string\n     8→  originCode: string\n     9→  destSearch: string\n    10→  destCode: string\n    11→  adults?: number\n    12→  cabinClass?: string\n    13→  oneWay?: boolean\n    14→}) {\n    15→  // Select One Way if needed\n    16→  if (options.oneWay) {\n    17→    await page.getByTestId('trip-type-selector-trigger').click()\n    18→    await page.getByTestId('trip-type-option-one_way').click()\n    19→    await expect(page.getByTestId('trip-type-selector-trigger')).toContainText('One way')\n    20→  }\n    21→\n    22→  // Set cabin class if specified\n    23→  if (options.cabinClass) {\n    24→    await page.getByTestId('cabin-class-trigger').click()\n    25→    await page.getByTestId(`cabin-class-option-${options.cabinClass}`).click()\n    26→  }\n    27→\n    28→  // Set passengers if specified\n    29→  if (options.adults && options.adults > 1) {\n    30→    await page.getByTestId('passenger-count-trigger').click()\n    31→    await expect(page.getByTestId('passenger-count-dropdown')).toBeVisible()\n    32→    for (let i = 1; i < options.adults; i++) {\n    33→      await page.getByTestId('adults-increment').click()\n    34→    }\n    35→    // Close dropdown by clicking trigger again\n    36→    await page.getByTestId('passenger-count-trigger').click()\n    37→  }\n    38→\n    39→  // Set origin\n    40→  const originInput = page.getByTestId('origin-input')\n    41→  await originInput.click()\n    42→  await originInput.fill(options.originSearch)\n    43→  await expect(page.getByTestId('origin-dropdown')).toBeVisible({