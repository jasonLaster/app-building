k((range: DateRange) => {\n    48→    dispatch(setDateRange(range))\n    49→  }, [dispatch])\n    50→\n    51→  return (\n    52→    <div className=\"explore-page\" data-testid=\"explore-page\">\n    53→      <div className=\"explore-page__header\">\n    54→        <h1 className=\"explore-page__title\">Explore destinations</h1>\n    55→        <p className=\"explore-page__subtitle\">Find cheap flights from your airport</p>\n    56→      </div>\n    57→\n    58→      <div className=\"explore-page__origin-selector\" data-testid=\"explore-origin-selector\">\n    59→        <label className=\"explore-page__origin-label\">From</label>\n    60→        <AirportAutocomplete\n    61→          value={origin}\n    62→          onChange={handleOriginChange}\n    63→          placeholder=\"Select origin airport\"\n    64→          testIdPrefix=\"explore-origin\"\n    65→        />\n    66→      </div>\n    67→\n    68→      <div className=\"explore-page__sections\">\n    69→        <section className=\"explore-page__map-section\">\n    70→          <DestinationMap\n    71→            destinations={destinations}\n    72→            loading={destinationsLoading}\n    73→            originCode={origin?.iata_code || null}\n    74→          />\n    75→        </section>\n    76→\n    77→        <section className=\"explore-page__dates-section\">\n    78→          <FlexibleDatesGrid\n    79→            datePrices={datePrices}\n    80→            loading={datePricesLoading}\n    81→            dateRange={dateRange}\n    82→            onDateRangeChange={handleDateRangeChange}\n    83→            originCode={origin?.iata_code || null}\n    84→          />\n    85→        </section>\n    86→\n    87→        <section className=\"explore-page__deals-section\">\n    88→          <DealsSection\n    89→            deals={deals}\n    90→            loading={dealsLoading}\n    91→            originCode={origin?.iata_code || null}\n    92→          />\n    93→        </section>\n    94→      </div>\n    95→    </div>\n    96→  )\n    97→}\n    98→\n    99→export default ExplorePage\n   100→"}]},"parent_tool_use_id":null,"session_id":"070807e6-44c2-402e-bd72-2ebebd488457","uuid":"67691809-7a58-4011-ac33-7a477abe122c","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/GoogleFlights/src/pages/ExplorePage.tsx","content":"import { useEffect, useCallback } from 'react'\nimport { useDispatch, useSelector } from 'react-redux'\nimport {\n  setExploreOrigin,\n  setDateRange,\n  fetchExploreDestinations,\n  fetchExploreDates,\n  fetchExploreDeals,\n} from '../slices/exploreSlice'\nimport type { DateRange } from '../slices/exploreSlice'\nimport type { Airport } from '../slices/searchSlice'\nimport type { RootState, AppDispatch } from '../store'\nimport AirportAutocomplete from '../components/AirportAutocomplete'\nimport DestinationMap from '../components/DestinationMap'\nimport FlexibleDatesGrid from '../components/FlexibleDatesGrid'\nimport DealsSection from '../components/DealsSection'\nimport './ExplorePage.css'\n\nfunction ExplorePage() {\n  const dispatch = useDispatch<AppDispatch>()\n  const {\n    origin,\n    destinations,\n    destinationsLoading,\n    datePrices,\n    datePricesLoading,\n    dateRange,\n    deals,\n    dealsLoading,\n  } = useSelector((state: RootState) => state.explore)\n\n  useEffect(() => {\n    if (!origin) return\n    dispatch(fetchExploreDestinations(origin.iata_code))\n    dispatch(fetchExploreDeals(origin.iata_code))\n  }, [dispatch, origin])\n\n  useEffect(() => {\n    if (!origin) return\n    dispatch(fetchExploreDates({ originCode: origin.iata_code, dateRange }))\n  }, [dispatch, origin, dateRange])\n\n  const handleOriginChange = useCallback((airport: Airport | null) => {\n    dispatch(setExploreOrigin(airport))\n  }, [dispatch])\n\n  const handleDateRangeChange = useCallback((range: DateRange) => {\n    dispatch(setDateRange(range))\n  }, [dispatch])\n\n  return (\n    <div className=\"explore-page\" data-testid=\"explore-page\">\n      <div className=\"explore-page__header\">\n        <h1 className=\"explore-page__title\">Explore destinations</h1>\n        <p className=\"explore-page__subtitle\">Find cheap flights from your airport</p>\n      </div>\n\n      <div className=\"explore-page__origin-selector\" data-testid=\"explore-origin-selector\">\n        <label className=\"explore-page__origin-label\">From</label>\n        <AirportAutocomplete\n          value={origin}\n          onChange={handleOriginChange}\n          placeholder=\"Select origin airport\"\n          testIdPrefix=\"explore-origin\"\n        />\n      </div>\n\n      <div className=\"explore-page__sections\">\n        <section className=\"explore-page__map-section\">\n          <DestinationMap\n            destinations={destinations}\n            loading={destinationsLoading}\n            originCode={origin?.iata_code || null}\n          />\n        </section>\n\n        <section className=\"explore-page__dates-section\">\n          <FlexibleDatesGrid\n            datePrices={datePrices}\n            loading={datePricesLoading}\n            dateRange={dateRange}\n            onDateRangeChange={handleDateRangeChange}\n            originCode={origin?.iata_code || null}\n          />\n        </section>\n\n        <section className=\"explore-page__deals-section\">\n          <DealsSection\n            deals={deals}\n            loading={dealsLoading}\n            originCode={origin?.iata_code || null}\n          />\n        </section>\n      </div>\n    </div>\n  )\n}\n\nexport default ExplorePage\n","numLines":100,"startLine":1,"totalLines":100}}}
