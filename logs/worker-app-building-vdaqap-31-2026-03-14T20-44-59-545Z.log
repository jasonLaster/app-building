uld show a day name, date, and price\n    39→    const firstCell = dateCells.first()\n    40→    const cellText = await firstCell.textContent()\n    41→    // Should contain a price ($ sign) or dash for no-price cells\n    42→    expect(cellText).toMatch(/(\\$\\d+|—)/)\n    43→  })\n    44→\n    45→  test('FlexibleDatesGrid cells are color-coded by price level', async ({ page }) => {\n    46→    await selectOrigin(page, 'LAX', 'LAX')\n    47→\n    48→    const cells = page.getByTestId('flexible-dates-cells')\n    49→    await expect(cells).toBeVisible({ timeout: 15000 })\n    50→\n    51→    const dateCells = page.locator('[data-testid^=\"date-cell-\"]')\n    52→    await expect(dateCells.first()).toBeVisible({ timeout: 10000 })\n    53→\n    54→    // Check that cells have color-coded CSS classes\n    55→    const allCells = await dateCells.all()\n    56→    const classNames = new Set<string>()\n    57→    for (const cell of allCells) {\n    58→      const cls = await cell.getAttribute('class')\n    59→      if (cls?.includes('--cheap')) classNames.add('cheap')\n    60→      if (cls?.includes('--moderate')) classNames.add('moderate')\n    61→      if (cls?.includes('--expensive')) classNames.add('expensive')\n    62→    }\n    63→\n    64→    // Should have at least one pricing level class applied\n    65→    expect(classNames.size).toBeGreaterThan(0)\n    66→  })\n    67→\n    68→  test('FlexibleDatesGrid date range selector Weekend trips', async ({ page }) => {\n    69→    await selectOrigin(page, 'LAX', 'LAX')\n    70→\n    71→    const grid = page.getByTestId('flexible-dates-grid')\n    72→    await expect(grid).toBeVisible({ timeout: 10000 })\n    73→\n    74→    // Click the Weekend trips button\n    75→    const weekendBtn = page.getByTestId('date-range-weekend')\n    76→    await expect(weekendBtn).toBeVisible()\n    77→    await weekendBtn.click()\n    78→\n    79→    // Weekend button should be active\n    80→    await expect(weekendBtn).toHaveClass(/--ac