[2026-03-14T20:43:55.809Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NRy4qdPJ5yx6JXYtWJ4GCb","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test'\n     2→\n     3→/** Helper: navigate to Explore page and select an origin airport */\n     4→async function selectOrigin(page: import('@playwright/test').Page, query: string, code: string) {\n     5→  const input = page.getByTestId('explore-origin-input')\n     6→  await input.click()\n     7→  await input.fill(query)\n     8→  const dropdown = page.getByTestId('explore-origin-dropdown')\n     9→  await expect(dropdown).toBeVisible({ timeout: 10000 })\n    10→  await page.getByTestId(`explore-origin-suggestion-${code}`).click()\n    11→  await expect(dropdown).not.toBeVisible()\n    12→}\n    13→\n    14→test.describe('DestinationMap', () => {\n    15→  test.beforeEach(async ({ page }) => {\n    16→    await page.goto('/explore')\n    17→    await expect(page.getByTestId('explore-page')).toBeVisible({ timeout: 10000 })\n    18→  })\n    19→\n    20→  test('DestinationMap displays interactive map on Explore page', async ({ page }) => {\n    21→    const map = page.getByTestId('destination-map')\n    22→    await expect(map).toBeVisible({ timeout: 10000 })\n    23→\n    24→    // Map SVG should be visible\n    25→    const svg = page.getByTestId('destination-map-svg')\n    26→    await expect(svg).toBeVisible()\n    27→\n    28→    // Zoom controls should be present\n    29→    const controls = page.getByTestId('destination-map-controls')\n    30→    await expect(controls).toBeVisible()\n    31→    await expect(page.getByTestId('destination-map-zoom-in')).toBeVisible()\n    32→    await expect(page.getByTestId('destination-map-zoom-out')).toBeVisible()\n    33→    await expect(page.getByTestId('destination-map-reset')).toBeVisible()\n    34→  })\n    35→\n    36→  test('DestinationMap shows origin airport selector', async ({ page }) => {\n    37→    const originSelector = page.getByTestId('explore-origin-selector')\n    38→    await expect(originSelector).toBeVisible({ timeout: 10000 })\n    39→\n    40→    const originInput = page.getByTestId('explore-origin-input')\n    41→    await expect(originInput).toBeVisible()\n    42→    await expect(originInput).toHaveAttribute('placeholder', 'Select origin airport')\n    43→  })\n    44→\n    45→  test('DestinationMap changing origin updates displayed destinations', async ({ page }) => {\n    46→    // Select LAX as origin\n    47→    await selectOrigin(page, 'LAX', 'LAX')\n    48→\n    49→    // Wait for markers to appear\n    50→    const markers = page.locator('[data-testid^=\"destination-marker-\"]')\n    51→    await expect(markers.first()).toBeVisible({ timeout: 15000 })\n    52→    const laxCount = await markers.count()\n    53→    expect(laxCount).toBeGreaterThan(0)\n    54→\n    55→    // Get the first marker's testid for LAX results\n    56→    const firstLaxMarkerId = await markers.first().getAttribute('data-testid')\n    57→\n    58→    // Change origin to SFO\n    59→    await selectOrigin(page, 'SFO', 'SFO')\n    60→\n    61→    // Wait for markers to update - new markers should appear\n    62→    await expect(markers.first()).toBeVisible({ timeout: 15000 })\n    63→    const sfoCount = await markers.count()\n    64→    expect(sfoCount).toBeGreaterThan(0)\n    65→  })\n    66→\n    67→  test('DestinationMap displays destination markers with prices', async ({ page }) => {\n    68→    // Select origin\n    69→    await selectOrigin(page, 'LAX', 'LAX')\n    70→\n    71→    // Wait for markers to appear\n    72→    const markers = page.locator('[data-testid^=\"destination-marker-\"]')\n    73→    await expect(markers.first()).toBeVisible({ timeout: 15000 })\n    74→\n    75→    const count = await markers.count()\n    76→    expect(count).toBeGreaterThan(0)\n    77→\n    78→    // Each marker should contain a price (text with $ sign)\n    79→    const firstMarker =