t const updateUser = createAsyncThunk(\n    59→  'auth/updateUser',\n    60→  async (\n    61→    { id, ...fields }: { id: string; name?: string; bio?: string | null; phone?: string | null; avatar_url?: string | null },\n    62→    { rejectWithValue }\n    63→  ) => {\n    64→    const response = await fetch(`/api/users/${id}`, {\n    65→      method: 'PUT',\n    66→      headers: { 'Content-Type': 'application/json' },\n    67→      body: JSON.stringify(fields),\n    68→    })\n    69→    const data = await response.json()\n    70→    if (!response.ok) {\n    71→      return rejectWithValue(data.error || 'Update failed')\n    72→    }\n    73→    return data as User\n    74→  }\n    75→)\n    76→\n    77→export const becomeHost = createAsyncThunk(\n    78→  'auth/becomeHost',\n    79→  async (userId: string, { rejectWithValue }) => {\n    80→    const response = await fetch(`/api/users/${userId}/become-host`, {\n    81→      method: 'POST',\n    82→      headers: { 'Content-Type': 'application/json' },\n    83→    })\n    84→    const data = await response.json()\n    85→    if (!response.ok) {\n    86→      return rejectWithValue(data.error || 'Failed to become host')\n    87→    }\n    88→    return data as User\n    89→  }\n    90→)\n    91→\n    92→const authSlice = createSlice({\n    93→  name: 'auth',\n    94→  initialState,\n    95→  reducers: {\n    96→    logout(state) {\n    97→      state.currentUser = null\n    98→      state.error = null\n    99→    },\n   100→    clearError(state) {\n   101→      state.error = null\n   102→    },\n   103→  },\n   104→  extraReducers: (builder) => {\n   105→    builder\n   106→      .addCase(loginUser.pending, (state) => {\n   107→        state.loading = true\n   108→        state.error = null\n   109→      })\n   110→      .addCase(loginUser.fulfilled, (state, action) => {\n   111→        state.loading = false\n   112→        state.currentUser = action.payload\n   113→        state.error = null\n   114→      })\n   11