[2026-03-14T19:40:23.189Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01W6vjuSnFo97PyW3yhiWswE","type":"tool_result","content":"     1→import { createSlice, createAsyncThunk } from '@reduxjs/toolkit'\n     2→\n     3→export interface Booking {\n     4→  id: string\n     5→  property_id: string\n     6→  guest_id: string\n     7→  check_in: string\n     8→  check_out: string\n     9→  num_guests: number\n    10→  total_price: number\n    11→  status: 'pending' | 'confirmed' | 'cancelled' | 'completed'\n    12→  special_requests: string | null\n    13→  created_at: string\n    14→  property_title?: string\n    15→  property_city?: string\n    16→  property_country?: string\n    17→  property_image?: string | null\n    18→  has_review?: boolean\n    19→}\n    20→\n    21→interface BookingsState {\n    22→  items: Booking[]\n    23→  loading: boolean\n    24→  error: string | null\n    25→}\n    26→\n    27→const initialState: BookingsState = {\n    28→  items: [],\n    29→  loading: false,\n    30→  error: null,\n    31→}\n    32→\n    33→export const createBooking = createAsyncThunk(\n    34→  'bookings/createBooking',\n    35→  async (\n    36→    data: {\n    37→      property_id: string\n    38→      guest_id: string\n    39→      check_in: string\n    40→      check_out: string\n    41→      num_guests: number\n    42→      total_price: number\n    43→    },\n    44→    { rejectWithValue }\n    45→  ) => {\n    46→    const response = await fetch('/api/bookings', {\n    47→      method: 'POST',\n    48→      headers: { 'Content-Type': 'application/json' },\n    49→      body: JSON.stringify(data),\n    50→    })\n    51→    const result = await response.json()\n    52→    if (!response.ok) {\n    53→      return rejectWithValue(result.error || 'Failed to create booking')\n    54→    }\n    55→    return result as Booking\n    56→  }\n    57→)\n    58→\n    59→export const fetchUserBookings = createAsyncThunk(\n    60→  'bookings/fetchUserBookings',\n    61→  async (guestId: string, { rejectWithValue }) => {\n    62→    const response = await fetch(`/api/bookings?guest_id=${encodeURIComponent(guestId)}`)\n    63→    const result = await response.json()\n    64→    if (!response.ok) {\n    65→      return rejectWithValue(result.error || 'Failed to fetch bookings')\n    66→    }\n    67→    return result as Booking[]\n    68→  }\n    69→)\n    70→\n    71→export const cancelBooking = createAsyncThunk(\n    72→  'bookings/cancelBooking',\n    73→  async (bookingId: string, { rejectWithValue }) => {\n    74→    const response = await fetch(`/api/bookings/${bookingId}`, {\n    75→      method: 'PUT',\n    76→      headers: { 'Content-Type': 'application/json' },\n    77→      body: JSON.stringify({ status: 'cancelled' }),\n    78→    })\n    79→    const result = await response.json()\n    80→    if (!response.ok) {\n    81→      return rejectWithValue(result.error || 'Failed to cancel booking')\n    82→    }\n    83→    return result as Booking\n    84→  }\n    85→)\n    86→\n    87→const bookingsSlice = createSlice({\n    88→  name: 'bookings',\n    89→  initialState,\n    90→  reducers: {\n    91→    clearBookingError(state) {\n    92→      state.error = null\n    93→    },\n    94→  },\n    95→  extraReducers: (builder) => {\n    96→    builder\n    97→      .addCase(createBooking.pending, (state) => {\n    98→        state.loading = true\n    99→        state.error = null\n   100→      })\n   101→      .addCase(createBooking.fulfilled, (state, action) => {\n   102→        state.loading = false\n   103→        state.items.push(action.payload)\n   104→      })\n   105→      .addCase(createBooking.rejected, (state, action) => {\n   106→        state.loading = false\n   107→        state.error = action.payload as string\n   108→      })\n   109→      .addCase(fetchUserBookings.pending, (state) => {\n   110→        if (state.items.length === 0) {\n   111→          state.loading = true\n   112→        }\n   113→        state.error = null\n   114→      })\n   115→      .addCase(fetchUserBookings.fulfilled, (state, action) => {\n   116→        state.loading = false\n   117→        state.items = action.payload\n   118→      })\n   119→      .addCase(fetchUserBookings.rejected, (state, action) => {\n   120→        state.loading = false\n   121→        state.error = action.payload as string\n   122→      })\n   123→      .addCase(cancelBooking.fulfilled, (state, action) => {\n   124→        const index = state.items.findIndex((b) => b.id === action.payload.id)\n   125→        if (index !== -1) {\n   126→          const existing = state.items[index]\n   127→          if (existing) {\n   128→            state.items[index] = { ...existing, ...action.payload }\n   129→          }\n   130→        }\n   131→      })\n   132→      .addCase(cancelBooking.rejected, (state, action) => {\n   133→        state.error = action.payload as string\n   134→      })\n   135→  },\n   136→})\n   137→\n   138→export const { clearBookingError } = bookingsSlice.actions\n   139→export default bookingsSlice.reducer\n   140→"}]},"parent_tool_use_id":null,"session_id":"e9cade60-94a4-4669-9ce9-af24d9b0f1dc","uuid":"775b7a34-9147-4327-bcb8-9be13aaa7f3c","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/slices/bookingsSlice.ts","content":"import { createSlice, createAsyncThunk } from '@reduxjs/toolkit'\n\nexport interface Booking {\n  id: string\n  property_id: string\n  guest_id: string\n  check_in: string\n  check_out: string\n  num_guests: number\n  total_price: number\n  status: 'pending' | 'confirmed' | 'cancelled' | 'completed'\n  special_requests: string | null\n  created_at: string\n  property_title?: string\n  property_city?: string\n  property_country?: string\n  property_image?: string | null\n  has_review?: boolean\n}\n\ninterface BookingsState {\n  items: Booking[]\n  loading: boolean\n  error: string | null\n}\n\nconst initialState: BookingsState = {\n  items: [],\n  loading: false,\n  error: null,\n}\n\nexport const createBooking = createAsyncThunk(\n  'bookings/createBooking',\n  async (\n    data: {\n      property_id: string\n      guest_id: string\n      check_in: string\n      check_out: string\n      num_guests: number\n      total_price: number\n    },\n    { rejectWithValue }\n  ) => {\n    const response = await fetch('/api/bookings', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify(data),\n    })\n    const result = await response.json()\n    if (!response.ok) {\n      return rejectWithValue(result.error || 'Failed to create booking')\n    }\n    return result as Booking\n  }\n)\n\nexport const fetchUserBookings = createAsyncThunk(\n  'bookings/fetchUserBookings',\n  async (guestId: string, { rejectWithValue }) => {\n    const response = await fetch(`/api/bookings?guest_id=${encodeURIComponent(guestId)}`)\n    const result = await response.json()\n    if (!response.ok) {\n      return rejectWithValue(result.error || 'Failed to fetch bookings')\n    }\n    return result as Booking[]\n  }\n)\n\nexport const cancelBooking = createAsyncThunk(\n  'bookings/cancelBooking',\n  async (bookingId: string, { rejectWithValue }) => {\n    const response = await fetch(`/api/bookings/${bookingId}`, {\n      method: 'PUT',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ status: 'cancelled' }),\n    })\n    const result = await response.json()\n    if (!response.ok) {\n      return rejectWithValue(result.error || 'Failed to cancel booking')\n    }\n    return result as Booking\n  }\n)\n\nconst bookingsSlice = createSlice({\n  name: 'bookings',\n  initialState,\n  reducers: {\n    clearBookingError(state) {\n      state.error = null\n    },\n  },\n  extraReducers: (builder) => {\n    builder\n      .addCase(createBooking.pending, (state) => {\n        state.loading = true\n        state.error = null\n      })\n      .addCase(createBooking.fulfilled, (state, action) => {\n        state.loading = false\n        state.items.push(action.payload)\n      })\n      .addCase(createBooking.rejected, (state, action) => {\n        state.loading = false\n        state.error = action.payload as string\n      })\n      .addCase(fetchUserBookings.pending, (state) => {\n        if (state.items.length === 0) {\n          state.loading = true\n        }\n        state.error = null\n      })\n      .addCase(fetchUserBookings.fulfilled, (state, action) => {\n        state.loading = false\n        state.items = action.payload\n      })\n      .addCase(fetchUserBookings.rejected, (state, action) => {\n        state.loading = false\n        state.error = action.payload as string\n      })\n      .addCase(cancelBooking.fulfilled, (state, action) => {\n        const index = state.items.findIndex((b) => b.id === action.payload.id)\n        if (index !== -1) {\n          const existing = state.items[index]\n          if (existing) {\n            state.items[index] = { ...existing, ...action.payload }\n          }\n        }\n      })\n      .addCase(cancelBooking.rejected, (state, action) => {\n        state.error = action.payload as string\n      })\n  },\n})\n\nexport const { clearBookingError } = bookingsSlice.actions\nexport default bookingsSlice.reducer\n","numLines":140,"startLine":1,"totalLines":140}}}
