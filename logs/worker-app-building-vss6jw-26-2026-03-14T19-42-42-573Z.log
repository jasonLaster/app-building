nChange={(e) => handleChange(key, parseInt(e.target.value, 10))}\n              data-testid={`rating-input-${key}`}\n              className=\"flex-1 h-2 rounded-full appearance-none cursor-pointer accent-primary\"\n              style={{\n                background: `linear-gradient(to right, var(--color-primary) ${((ratings[key] - 1) / 4) * 100}%, var(--color-bg-secondary) ${((ratings[key] - 1) / 4) * 100}%)`,\n              }}\n            />\n            <div className=\"flex items-center gap-0.5\">\n              {Array.from({ length: 5 }, (_, i) => (\n                <Star\n                  key={i}\n                  size={14}\n                  className={\n                    i < ratings[key]\n                      ? 'fill-primary text-primary'\n                      : 'text-border'\n                  }\n                />\n              ))}\n            </div>\n          </div>\n        </div>\n      ))}\n    </div>\n  )\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":436,"cache_read_input_tokens":52488,"cache_creation":{"ephemeral_5m_input_tokens":436,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"global"},"context_management":null},"parent_tool_use_id":null,"session_id":"e9cade60-94a4-4669-9ce9-af24d9b0f1dc","uuid":"688a9251-1ac6-4206-80f0-bb9325356396"}
