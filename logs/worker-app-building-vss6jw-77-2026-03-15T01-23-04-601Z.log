[2026-03-15T01:17:37.987Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014iii5woy4ugg2cQDittDTT","type":"tool_result","content":"     1→import { useState } from 'react'\n     2→import { useNavigate } from 'react-router-dom'\n     3→import { useDispatch, useSelector } from 'react-redux'\n     4→import type { RootState, AppDispatch } from '../store'\n     5→import { submitReview } from '../slices/reviewFormSlice'\n     6→import RatingSliders from './RatingSliders'\n     7→import type { Ratings } from './RatingSliders'\n     8→import type { BookingDetail } from '../slices/reviewFormSlice'\n     9→\n    10→interface ReviewFormProps {\n    11→  booking: BookingDetail\n    12→}\n    13→\n    14→const DEFAULT_RATINGS: Ratings = {\n    15→  rating: 0,\n    16→  cleanliness: 0,\n    17→  accuracy: 0,\n    18→  communication: 0,\n    19→  location: 0,\n    20→  value: 0,\n    21→}\n    22→\n    23→export default function ReviewForm({ booking }: ReviewFormProps) {\n    24→  const dispatch = useDispatch<AppDispatch>()\n    25→  const navigate = useNavigate()\n    26→  const { submitting, error } = useSelector((state: RootState) => state.reviewForm)\n    27→  const { currentUser } = useSelector((state: RootState) => state.auth)\n    28→\n    29→  const [ratings, setRatings] = useState<Ratings>(DEFAULT_RATINGS)\n    30→  const [comment, setComment] = useState('')\n    31→  const [validationError, setValidationError] = useState<string | null>(null)\n    32→\n    33→  const allUnset = Object.values(ratings).every(v => v === 0)\n    34→  const anyUnset = Object.values(ratings).some(v => v === 0)\n    35→\n    36→  const handleSubmit = async () => {\n    37→    if (!currentUser) return\n    38→\n    39→    setValidationError(null)\n    40→\n    41→    if (anyUnset) {\n    42→      setValidationError('Please rate all categories')\n    43→      return\n    44→    }\n    45→\n    46→    const result = await dispatch(\n    47→      submitReview({\n    48→        booking_id: booking.id,\n    49→        property_id: booking.property_id,\n    50→        guest_id: currentUser.id,\n    51→        rating: ratings.rating,\n    52→        cleanliness: ratings.cleanliness,\n    53→        accuracy: ratings.accuracy,\n    54→        communication: ratings.communication,\n    55→        location: ratings.location,\n    56→        value: ratings.value,\n    57→        comment: comment.trim() || undefined,\n    58→      })\n    59→    )\n    60→\n    61→    if (submitReview.fulfilled.match(result)) {\n    62→      // Success state is shown by parent WriteReview component\n    63→    }\n    64→  }\n    65→\n    66→  return (\n    67→    <div data-testid=\"review-form\" className=\"space-y-6\">\n    68→      <RatingSliders ratings={ratings} onChange={setRatings} />\n    69→\n    70→      <div className=\"space-y-2\">\n    71→        <label className=\"text-sm font-medium text-text\" htmlFor=\"review-comment\">\n    72→          Your review\n    73→        </label>\n    74→        <textarea\n    75→          id=\"review-comment\"\n    76→          data-testid=\"review-comment-textarea\"\n    77→          placeholder=\"Tell others about your experience\"\n    78→          value={comment}\n    79→          onChange={(e) => setComment(e.target.value)}\n    80→          rows={5}\n    81→          className=\"w-full rounded-lg border border-border px-3 py-2 text-sm text-text placeholder:text-text-secondary focus:outline-none focus:border-primary resize-y\"\n    82→        />\n    83→      </div>\n    84→\n    85→      {(error || validationError) && (\n    86→        <p data-testid=\"review-form-error\" className=\"text-sm text-error\">\n    87→          {validationError || error}\n    88→        </p>\n    89→      )}\n    90→\n    91→      <div className=\"flex items-center gap-3\">\n    92→        <button\n    93→          data-testid=\"submit-review-button\"\n    94→          onClick={handleSubmit}\n    95→          disabled={submitting || allUnset}\n    96→          className=\"px-6 py-2.5 rounded-lg bg-primary text-white font-semibold text-sm hover:bg-primary-dark transition-colors disabled:opacity-50 disabled:cursor-not-allowed\"\n    97→        >\n    98→          {submitting ? 'Submitting...' : 'Submit Review'}\n    99→        </button>\n   100→        <button\n   101→          data-testid=\"cancel-review-button\"\n   102→          onClick={() => navigate('/trips')}\n   103→          className=\"px-6 py-2.5 rounded-lg border border-border text-text font-medium text-sm hover:bg-bg-secondary transition-colors\"\n   104→        >\n   105→          Cancel\n   106→        </button>\n   107→      </div>\n   108→    </div>\n   109→  )\n   110→}\n   111→"}]},"parent_tool_use_id":"toolu_01GPf78icrErhceCjJG138Y2","session_id":"2919a3bc-31f3-44d1-8891-e67557ae62de","uuid":"3f2493c5-6fa4-4ac3-be50-6e551e94a552"}
