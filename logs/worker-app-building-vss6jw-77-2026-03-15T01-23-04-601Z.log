[2026-03-15T01:17:07.480Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015MDKWeT8PJSTCR2xyFEimK","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test'\n     2→\n     3→// Seed data references\n     4→const EMMA_EMAIL = 'emma@example.com'\n     5→const ALEX_EMAIL = 'alex@example.com'\n     6→const EMMA_ID = 'a3333333-3333-3333-3333-333333333333'\n     7→\n     8→// Emma's completed booking at Cozy Downtown Loft (has review in seed)\n     9→const EMMA_COMPLETED_BOOKING = 'e1111111-1111-1111-1111-111111111111'\n    10→const EMMA_COMPLETED_PROPERTY = 'b1111111-1111-1111-1111-111111111111'\n    11→\n    12→// Emma's pending booking\n    13→const EMMA_PENDING_BOOKING = 'e3333333-3333-3333-3333-333333333333'\n    14→\n    15→async function login(page: import('@playwright/test').Page, email: string) {\n    16→  await page.goto('/login')\n    17→  await page.getByTestId('login-email-input').fill(email)\n    18→  await page.getByTestId('login-submit-button').click()\n    19→  await expect(page).toHaveURL('/', { timeout: 30000 })\n    20→}\n    21→\n    22→async function deleteAllReviewsForGuest(page: import('@playwright/test').Page, guestId: string) {\n    23→  const res = await page.request.get(`/api/reviews?guest_id=${guestId}`)\n    24→  const reviews = await res.json()\n    25→  for (const review of reviews) {\n    26→    await page.request.delete(`/api/reviews/${review.id}`)\n    27→  }\n    28→}\n    29→\n    30→test.describe('Write Review - PropertyBookingContext', () => {\n    31→  test('Property info displays for the booking being reviewed', async ({ page }) => {\n    32→    await login(page, EMMA_EMAIL)\n    33→    // Delete Emma's review so the booking is reviewable\n    34→    await deleteAllReviewsForGuest(page, EMMA_ID)\n    35→\n    36→    await page.goto(`/trips/${EMMA_COMPLETED_BOOKING}/review`)\n    37→\n    38→    const context = page.getByTestId('property-booking-context')\n    39→    await expect(context).toBeVisible({ timeout: 30000 })\n    40→\n    41→    // Property title\n    42→    await expect(page.getByTestId('booking-context-title')).toHaveText('Cozy Downtown Loft with City Views')\n    43→\n    44→    // Location\n    45→    await expect(page.getByTestId('booking-context-location')).toContainText('New York')\n    46→    await expect(page.getByTestId('booking-context-location')).toContainText('United States')\n    47→\n    48→    // Dates and nights: Dec 15, 2025 – Dec 20, 2025 (5 nights)\n    49→    const datesEl = page.getByTestId('booking-context-dates')\n    50→    await expect(datesEl).toContainText('Dec 15, 2025')\n    51→    await expect(datesEl).toContainText('Dec 20, 2025')\n    52→    await expect(datesEl).toContainText('5 nights')\n    53→  })\n    54→\n    55→  test('Property booking context shows guest count', async ({ page }) => {\n    56→    await login(page, EMMA_EMAIL)\n    57→    await deleteAllReviewsForGuest(page, EMMA_ID)\n    58→\n    59→    await page.goto(`/trips/${EMMA_COMPLETED_BOOKING}/review`)\n    60→\n    61→    const guestsEl = page.getByTestId('booking-context-guests')\n    62→    await expect(guestsEl).toBeVisible({ timeout: 30000 })\n    63→    await expect(guestsEl).toContainText('2 guests')\n    64→  })\n    65→\n    66→  test('Property booking context shows total price paid', async ({ page }) => {\n    67→    await login(page, EMMA_EMAIL)\n    68→    await deleteAllReviewsForGuest(page, EMMA_ID)\n    69→\n    70→    await page.goto(`/trips/${EMMA_COMPLETED_BOOKING}/review`)\n    71→\n    72→    const priceEl = page.getByTestId('booking-context-price')\n    73→    await expect(priceEl).toBeVisible({ timeout: 30000 })\n    74→    await expect(priceEl).toContainText('$825')\n    75→  })\n    76→\n    77→  test('Redirect to login if not authenticated', async ({ page }) => {\n    78→    // Navigate directly without logging in\n    79→    await page.goto(`/trips/${EMMA_COMPLETED_BOOKING}/review`)\n    80→\n    81→    await expect(page).toHaveURL(/\\/login/, { timeout: 30000 })\n    82→    await expect(page.getByTestId('write-review-page')).not.toBeVisible()\n    83→  })\n    84→\n    85→  test('Error state when booking does not exist', async ({ page }) => {\n    86→    await login(page, EMMA_EMAIL)\n    87→\n    88→    await page.goto('/trips/nonexistent-booking-id/review')\n    89→\n    90→    const errorEl = page.getByTestId('review-page-error')\n    91→    await expect(errorEl).toBeVisible({ timeout: 30000 })\n    92→    await expect(errorEl).toContainText('Booking not found')\n    93→\n    94→    // Review form should not be visible\n    95→    await expect(page.getByTestId('review-form')).not.toBeVisible()\n    96→  })\n    97→\n    98→  test('Error state when booking belongs to another user', async ({ page }) => {\n    99→    // Log in as Alex and try to access Emma's booking\n   100→    await login(page, ALEX_EMAIL)\n   101→\n   102→    await page.goto(`/trips/${EMMA_COMPLETED_BOOKING}/review`)\n   103→\n   104→    const errorEl = page.getByTestId('review-page-error')\n   105→    await expect(errorEl).toBeVisible({ timeout: 30000 })\n   106→    await expect(errorEl).toContainText('Booking not found')\n   107→\n   108→    await expect(page.getByTestId('review-form')).not.toBeVisible()\n   109→  })\n   110→\n   111→  test('Error state when booking is not completed', async ({ page }) => {\n   112→    await login(page, EMMA_EMAIL)\n   113→\n   114→    // e3333333 is Emma's pending booking\n   115→    await page.goto(`/trips/${EMMA_PENDING_BOOKING}/review`)\n   116→\n   117→    const errorEl = page.getByTestId('review-page-error')\n   118→    await expect(errorEl).toBeVisible({ timeout: 30000 })\n   119→    await expect(errorEl).toContainText('You can only review completed bookings')\n   120→\n   121→    await expect(page.getByTestId('review-form')).not.toBeVisible()\n   122→  })\n   123→\n   124→  test('Error state when review already exists for booking', async ({ page }) => {\n   125→    await login(page, EMMA_EMAIL)\n   126→\n   127→    // e1111111 has a review in seed data — do NOT delete it\n   128→    await page.goto(`/trips/${EMMA_COMPLETED_BOOKING}/review`)\n   129→\n   130→    const errorEl = page.getByTestId('review-page-error')\n   131→    await expect(errorEl).toBeVisible({ timeout: 30000 })\n   132→    await expect(errorEl).toContainText('You have already reviewed this booking')\n   133→\n   134→    await expect(page.getByTestId('review-form')).not.toBeVisible()\n   135→  })\n   136→})\n   137→"}]},"parent_tool_use_id":null,"session_id":"2919a3bc-31f3-44d1-8891-e67557ae62de","uuid":"e378dcfc-699b-4fce-b4b8-8f00d750613b","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/tests/write-review-context.spec.ts","content":"import { test, expect } from '@playwright/test'\n\n// Seed data references\nconst EMMA_EMAIL = 'emma@example.com'\nconst ALEX_EMAIL = 'alex@example.com'\nconst EMMA_ID = 'a3333333-3333-3333-3333-333333333333'\n\n// Emma's completed booking at Cozy Downtown Loft (has review in seed)\nconst EMMA_COMPLETED_BOOKING = 'e1111111-1111-1111-1111-111111111111'\nconst EMMA_COMPLETED_PROPERTY = 'b1111111-1111-1111-1111-111111111111'\n\n// Emma's pending booking\nconst EMMA_PENDING_BOOKING = 'e3333333-3333-3333-3333-333333333333'\n\nasync function login(page: import('@playwright/test').Page, email: string) {\n  await page.goto('/login')\n  await page.getByTestId('login-email-input').fill(email)\n  await page.getByTestId('login-submit-button').click()\n  await expect(page).toHaveURL('/', { timeout: 30000 })\n}\n\nasync function deleteAllReviewsForGuest(page: import('@playwright/test').Page, guestId: string) {\n  const res = await page.request.get(`/api/reviews?guest_id=${guestId}`)\n  const reviews = await res.json()\n  for (const review of reviews) {\n    await page.request.delete(`/api/reviews/${review.id}`)\n  }\n}\n\ntest.describe('Write Review - PropertyBookingContext', () => {\n  test('Property info displays for the booking being reviewed', async ({ page }) => {\n    await login(page, EMMA_EMAIL)\n    // Delete Emma's review so the booking is reviewable\n    await deleteAllReviewsForGuest(page, EMMA_ID)\n\n    await page.goto(`/trips/${EMMA_COMPLETED_BOOKING}/review`)\n\n    const context = page.getByTestId('property-booking-context')\n    await expect(context).toBeVisible({ timeout: 30000 })\n\n    // Property title\n    await expect(page.getByTestId('booking-context-title')).toHaveText('Cozy Downtown Loft with City Views')\n\n    // Location\n    await expect(page.getByTestId('booking-context-location')).toContainText('New York')\n    await expect(page.getByTestId('booking-context-location')).toContainText('United States')\n\n    // Dates and nights: Dec 15, 2025 – Dec 20, 2025 (5 nights)\n    const datesEl = page.getByTestId('booking-context-dates')\n    await expect(datesEl).toContainText('Dec 15, 2025')\n    await expect(datesEl).toContainText('Dec 20, 2025')\n    await expect(datesEl).toContainText('5 nights')\n  })\n\n  test('Property booking context shows guest count', async ({ page }) => {\n    await login(page, EMMA_EMAIL)\n    await deleteAllReviewsForGuest(page, EMMA_ID)\n\n    await page.goto(`/trips/${EMMA_COMPLETED_BOOKING}/review`)\n\n    const guestsEl = page.getByTestId('booking-context-guests')\n    await expect(guestsEl).toBeVisible({ timeout: 30000 })\n    await expect(guestsEl).toContainText('2 guests')\n  })\n\n  test('Property booking context shows total price paid', async ({ page }) => {\n    await login(page, EMMA_EMAIL)\n    await deleteAllReviewsForGuest(page, EMMA_ID)\n\n    await page.goto(`/trips/${EMMA_COMPLETED_BOOKING}/review`)\n\n    const priceEl = page.getByTestId('booking-context-price')\n    await expect(priceEl).toBeVisible({ timeout: 30000 })\n    await expect(priceEl).toContainText('$825')\n  })\n\n  test('Redirect to login if not authenticated', async ({ page }) => {\n    // Navigate directly without logging in\n    await page.goto(`/trips/${EMMA_COMPLETED_BOOKING}/review`)\n\n    await expect(page).toHaveURL(/\\/login/, { timeout: 30000 })\n    await expect(page.getByTestId('write-review-page')).not.toBeVisible()\n  })\n\n  test('Error state when booking does not exist', async ({ page }) => {\n    await login(page, EMMA_EMAIL)\n\n    await page.goto('/trips/nonexistent-booking-id/review')\n\n    const errorEl = page.getByTestId('review-page-error')\n    await expect(errorEl).toBeVisible({ timeout: 30000 })\n    await expect(errorEl).toContainText('Booking not found')\n\n    // Review form should not be visible\n    await expect(page.getByTestId('review-form')).not.toBeVisible()\n  })\n\n  test('Error state when booking belongs to another user', async ({ page }) => {\n    // Log in as Alex and try to access Emma's booking\n    await login(page, ALEX_EMAIL)\n\n    await page.goto(`/trips/${EMMA_COMPLETED_BOOKING}/review`)\n\n    const errorEl = page.getByTestId('review-page-error')\n    await expect(errorEl).toBeVisible({ timeout: 30000 })\n    await expect(errorEl).toContainText('Booking not found')\n\n    await expect(page.getByTestId('review-form')).not.toBeVisible()\n  })\n\n  test('Error state when booking is not completed', async ({ page }) => {\n    await login(page, EMMA_EMAIL)\n\n    // e3333333 is Emma's pending booking\n    await page.goto(`/trips/${EMMA_PENDING_BOOKING}/review`)\n\n    const errorEl = page.getByTestId('review-page-error')\n    await expect(errorEl).toBeVisible({ timeout: 30000 })\n    await expect(errorEl).toContainText('You can only review completed bookings')\n\n    await expect(page.getByTestId('review-form')).not.toBeVisible()\n  })\n\n  test('Error state when review already exists for booking', async ({ page }) => {\n    await login(page, EMMA_EMAIL)\n\n    // e1111111 has a review in seed data — do NOT delete it\n    await page.goto(`/trips/${EMMA_COMPLETED_BOOKING}/review`)\n\n    const errorEl = page.getByTestId('review-page-error')\n    await expect(errorEl).toBeVisible({ timeout: 30000 })\n    await expect(errorEl).toContainText('You have already reviewed this booking')\n\n    await expect(page.getByTestId('review-form')).not.toBeVisible()\n  })\n})\n","numLines":137,"startLine":1,"totalLines":137}}}
