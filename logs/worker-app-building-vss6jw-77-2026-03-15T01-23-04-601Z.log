d, check_in, check_out, num_guests, total_price, status, special_requests, created_at)\n    44→      VALUES (gen_random_uuid(), ${property_id}, ${guest_id}, ${check_in}, ${check_out}, ${num_guests}, ${total_price}, 'pending', ${special_requests || null}, now())\n    45→      RETURNING *\n    46→    `\n    47→    const booking = result[0]\n    48→    return new Response(JSON.stringify(booking), { status: 201, headers })\n    49→  }\n    50→\n    51→  if (request.method === 'PUT' && bookingId) {\n    52→    const body = await request.json() as { status: string }\n    53→    const { status } = body\n    54→\n    55→    if (!['confirmed', 'cancelled'].includes(status)) {\n    56→      return new Response(JSON.stringify({ error: 'Invalid status' }), { status: 400, headers })\n    57→    }\n    58→\n    59→    const result = await sql`\n    60→      UPDATE bookings SET status = ${status} WHERE id = ${bookingId} RETURNING *\n    61→    `\n    62→    const booking = result[0]\n    63→    if (!booking) {\n    64→      return new Response(JSON.stringify({ error: 'Booking not found' }), { status: 404, headers })\n    65→    }\n    66→    return new Response(JSON.stringify(booking), { status: 200, headers })\n    67→  }\n    68→\n    69→  if (request.method === 'DELETE' && bookingId) {\n    70→    const result = await sql`\n    71→      DELETE FROM bookings WHERE id = ${bookingId} RETURNING *\n    72→    `\n    73→    const booking = result[0]\n    74→    if (!booking) {\n    75→      return new Response(JSON.stringify({ error: 'Booking not found' }), { status: 404, headers })\n    76→    }\n    77→    return new Response(JSON.stringify(booking), { status: 200, headers })\n    78→  }\n    79→\n    80→  if (request.method === 'DELETE' && !bookingId) {\n    81→    // Delete all non-seed bookings (seed IDs follow pattern e*-*-*-*-*)\n    82→    const seedIds = [\n    83→      'e1111111-1111-1111-1111-111111111111',\n    84→      'e2222222-2222-2222-2222-222222222222',\n    85→      'e3333333-3333-3333-3333-333333333333',\n    86→      'e4444444-4444-4444-4444-444444444444',\n    87→      'e5555555-5555-5555-5555-555555555555',\n    88→      'e6666666-6666-6666-6666-666666666666',\n    89→    ]\n    90→    await sql`DELETE FROM bookings WHERE id != ALL(${seedIds})`\n    91→    // Reset seed bookings to original statuses\n    92→    await sql`UPDATE bookings SET status = 'completed' WHERE id = 'e1111111-1111-1111-1111-111111111111'`\n    93→    await sql`UPDATE bookings SET status = 'confirmed' WHERE id = 'e2222222-2222-2222-2222-222222222222'`\n    94→    await sql`UPDATE bookings SET status = 'pending' WHERE id = 'e3333333-3333-3333-3333-333333333333'`\n    95→    await sql`UPDATE bookings SET status = 'completed' WHERE id = 'e4444444-4444-4444-4444-444444444444'`\n    96→    await sql`UPDATE bookings SET status = 'cancelled' WHERE id = 'e5555555-5555-5555-5555-555555555555'`\n    97→    await sql`UPDATE bookings SET status = 'confirmed' WHERE id = 'e6666666-6666-6666-6666-666666666666'`\n    98→    return new Response(JSON.stringify({ success: true }), { status: 200, headers })\n    99→  }\n   100→\n   101→  if (request.method === 'GET') {\n   102→    const guestId = url.searchParams.get('guest_id')\n   103→    if (!guestId) {\n   104→      return new Response(JSON.stringify({ error: 'guest_id is required' }), { status: 400, headers })\n   105→    }\n   106→\n   107→    const bookings = await sql`\n   108→      SELECT b.*,\n   109→        p.title as property_title, p.city as property_city, p.country as property_country,\n   110→        (SELECT url FROM property_images pi WHERE pi.property_id = p.id ORDER BY pi.display_order ASC LIMIT 1) as property_image,\n   111→        CASE WHEN EXISTS (SELECT 1 FROM reviews r WHERE r.booking_id = b.id) THEN true ELSE false END as has_review\n   112→      FROM bookings b\n   113→      JOIN properties p ON p.id = b.property_id\n   114→      WHERE b.guest_id = ${guestId}\n   115→      ORDER BY b.check_in ASC\n   116→    `\n   117→    return new Response(JSON.stringify(bookings), { status: 200, headers })\n   118→  }\n   119→\n   120→  return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers })\n   121→  } catch {\n   122→    return new Response(JSON.stringify({ error: 'Internal server error' }), { status: 500, headers })\n   123→  }\n   124→}\n   125→"}]},"parent_tool_use_id":null,"session_id":"2919a3bc-31f3-44d1-8891-e67557ae62de","uuid":"e5e1d833-613c-4f46-9510-2c2fbb950ef1","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/netlify/functions/bookings.ts","content":"import type { Context } from '@netlify/functions'\nimport { getSql } from './db.js'\n\nexport default async (request: Request, _context: Context) => {\n  const sql = getSql()\n  const url = new URL(request.url)\n  const segments = url.pathname.split('/').filter(Boolean)\n  const funcIdx = segments.indexOf('bookings')\n  const bookingId = funcIdx >= 0 ? segments[funcIdx + 1] : undefined\n\n  const headers = { 'Content-Type': 'application/json' }\n\n  try {\n  if (request.method === 'POST') {\n    const body = await request.json() as {\n      property_id: string\n      guest_id: string\n      check_in: string\n      check_out: string\n      num_guests: number\n      total_price: number\n      special_requests?: string\n    }\n\n    const { property_id, guest_id, check_in, check_out, num_guests, total_price, special_requests } = body\n\n    if (!property_id || !guest_id || !check_in || !check_out || !num_guests || !total_price) {\n      return new Response(JSON.stringify({ error: 'Missing required fields' }), { status: 400, headers })\n    }\n\n    const overlap = await sql`\n      SELECT id FROM bookings\n      WHERE property_id = ${property_id}\n      AND status IN ('confirmed', 'pending')\n      AND check_in < ${check_out}\n      AND check_out > ${check_in}\n    `\n    if (overlap.length > 0) {\n      return new Response(JSON.stringify({ error: 'Property is not available for the selected dates' }), { status: 409, headers })\n    }\n\n    const result = await sql`\n      INSERT INTO bookings (id, property_id, guest_id, check_in, check_out, num_guests, total_price, status, special_requests, created_at)\n      VALUES (gen_random_uuid(), ${property_id}, ${guest_id}, ${check_in}, ${check_out}, ${num_guests}, ${total_price}, 'pending', ${special_requests || null}, now())\n      RETURNING *\n    `\n    const booking = result[0]\n    return new Response(JSON.stringify(booking), { status: 201, headers })\n  }\n\n  if (request.method === 'PUT' && bookingId) {\n    const body = await request.json() as { status: string }\n    const { status } = body\n\n    if (!['confirmed', 'cancelled'].includes(status)) {\n      return new Response(JSON.stringify({ error: 'Invalid status' }), { status: 400, headers })\n    }\n\n    const result = await sql`\n      UPDATE bookings SET status = ${status} WHERE id = ${bookingId} RETURNING *\n    `\n    const booking = result[0]\n    if (!booking) {\n      return new Response(JSON.stringify({ error: 'Booking not found' }), { status: 404, headers })\n    }\n    return new Response(JSON.stringify(booking), { status: 200, headers })\n  }\n\n  if (request.method === 'DELETE' && bookingId) {\n    const result = await sql`\n      DELETE FROM bookings WHERE id = ${bookingId} RETURNING *\n    `\n    const booking = result[0]\n    if (!booking) {\n      return new Response(JSON.stringify({ error: 'Booking not found' }), { status: 404, headers })\n    }\n    return new Response(JSON.stringify(booking), { status: 200, headers })\n  }\n\n  if (request.method === 'DELETE' && !bookingId) {\n    // Delete all non-seed bookings (seed IDs follow pattern e*-*-*-*-*)\n    const seedIds = [\n      'e1111111-1111-1111-1111-111111111111',\n      'e2222222-2222-2222-2222-222222222222',\n      'e3333333-3333-3333-3333-333333333333',\n      'e4444444-4444-4444-4444-444444444444',\n      'e5555555-5555-5555-5555-555555555555',\n      'e6666666-6666-6666-6666-666666666666',\n    ]\n    await sql`DELETE FROM bookings WHERE id != ALL(${seedIds})`\n    // Reset seed bookings to original statuses\n    await sql`UPDATE bookings SET status = 'completed' WHERE id = 'e1111111-1111-1111-1111-111111111111'`\n    await sql`UPDATE bookings SET status = 'confirmed' WHERE id = 'e2222222-2222-2222-2222-222222222222'`\n    await sql`UPDATE bookings SET status = 'pending' WHERE id = 'e3333333-3333-3333-3333-333333333333'`\n    await sql`UPDATE bookings SET status = 'completed' WHERE id = 'e4444444-4444-4444-4444-444444444444'`\n    await sql`UPDATE bookings SET status = 'cancelled' WHERE id = 'e5555555-5555-5555-5555-555555555555'`\n    await sql`UPDATE bookings SET status = 'confirmed' WHERE id = 'e6666666-6666-6666-6666-666666666666'`\n    return new Response(JSON.stringify({ success: true }), { status: 200, headers })\n  }\n\n  if (request.method === 'GET') {\n    const guestId = url.searchParams.get('guest_id')\n    if (!guestId) {\n      return new Response(JSON.stringify({ error: 'guest_id is required' }), { status: 400, headers })\n    }\n\n    const bookings = await sql`\n      SELECT b.*,\n        p.title as property_title, p.city as property_city, p.country as property_country,\n        (SELECT url FROM property_images pi WHERE pi.property_id = p.id ORDER BY pi.display_order ASC LIMIT 1) as property_image,\n        CASE WHEN EXISTS (SELECT 1 FROM reviews r WHERE r.booking_id = b.id) THEN true ELSE false END as has_review\n      FROM bookings b\n      JOIN properties p ON p.id = b.property_id\n      WHERE b.guest_id = ${guestId}\n      ORDER BY b.check_in ASC\n    `\n    return new Response(JSON.stringify(bookings), { status: 200, headers })\n  }\n\n  return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers })\n  } catch {\n    return new Response(JSON.stringify({ error: 'Internal server error' }), { status: 500, headers })\n  }\n}\n","numLines":125,"startLine":1,"totalLines":125}}}
