});\n   135→      }\n   136→\n   137→      return new Response(JSON.stringify({\n   138→        milestone: {\n   139→          id: String(updated.id),\n   140→          name: String(updated.name),\n   141→          targetDate: updated.target_date ? String(updated.target_date).split('T')[0] : null,\n   142→          completed: Boolean(updated.completed),\n   143→        },\n   144→      }), {\n   145→        status: 200,\n   146→        headers: { 'Content-Type': 'application/json' },\n   147→      });\n   148→    }\n   149→\n   150→    if (req.method === 'DELETE') {\n   151→      const url = new URL(req.url);\n   152→      const milestoneId = url.searchParams.get('milestoneId');\n   153→      const projectId = url.searchParams.get('projectId');\n   154→\n   155→      if (!milestoneId) {\n   156→        return new Response(JSON.stringify({ error: 'milestoneId is required' }), {\n   157→          status: 400,\n   158→          headers: { 'Content-Type': 'application/json' },\n   159→        });\n   160→      }\n   161→\n   162→      // Fetch milestone name for activity\n   163→      const msRows = await sql`\n   164→        SELECT name, project_id FROM project_milestones WHERE id = ${milestoneId}\n   165→      `;\n   166→      const ms = msRows[0];\n   167→      if (!ms) {\n   168→        return new Response(JSON.stringify({ error: 'Milestone not found' }), {\n   169→          status: 404,\n   170→          headers: { 'Content-Type': 'application/json' },\n   171→        });\n   172→      }\n   173→\n   174→      await sql`DELETE FROM project_milestones WHERE id = ${milestoneId}`;\n   175→\n   176→      const pid = projectId || String(ms.project_id);\n   177→      await sql`\n   178→        INSERT INTO project_activity (project_id, member_id, action, created_at)\n   179→        VALUES (${pid}, ${session.member_id}, ${`deleted milestone \"${ms.name}\"`}, NOW())\n   180→      `;\n   181→\n   182→      return new Response(JSON.stringify({ success: true }), {\n   183→    