: {},\n    61→  bookingInProgress: false,\n    62→  bookingComplete: false,\n    63→  bookingReference: null,\n    64→  bookingError: null,\n    65→}\n    66→\n    67→export const fetchFlightForBooking = createAsyncThunk(\n    68→  'booking/fetchFlightForBooking',\n    69→  async (params: { flightId: string; cabinClass: string }) => {\n    70→    const qs = new URLSearchParams({\n    71→      flightId: params.flightId,\n    72→      cabinClass: params.cabinClass,\n    73→    })\n    74→    const res = await fetch(`/api/bookings?${qs}`)\n    75→    if (!res.ok) {\n    76→      throw new Error('Failed to fetch flight details')\n    77→    }\n    78→    return res.json() as Promise<{ flight: BookingFlightDetail; legs: FlightLeg[] }>\n    79→  }\n    80→)\n    81→\n    82→export const createBooking = createAsyncThunk(\n    83→  'booking/createBooking',\n    84→  async (params: {\n    85→    sessionToken: string\n    86→    flightId: string\n    87→    returnFlightId?: string\n    88→    cabinClass: string\n    89→    totalPriceCents: number\n    90→    passengers: Array<{\n    91→      firstName: string\n    92→      lastName: string\n    93→      dateOfBirth: string\n    94→      gender: string\n    95→      email?: string\n    96→      phone?: string\n    97→      passengerType: string\n    98→    }>\n    99→  }) => {\n   100→    const res = await fetch('/api/bookings', {\n   101→      method: 'POST',\n   102→      headers: { 'Content-Type': 'application/json' },\n   103→      body: JSON.stringify(params),\n   104→    })\n   105→    if (!res.ok) {\n   106→      throw new Error('Booking failed. Please try again.')\n   107→    }\n   108→    return res.json() as Promise<{\n   109→      id: string\n   110→      bookingReference: string\n   111→      status: string\n   112→      createdAt: string\n   113→    }>\n   114→  }\n   115→)\n   116→\n   117→const bookingSlice = createSlice({\n   118→  name: 'booking',\n   119→  initialState,\n   120→  reducers: {\n   121→    initializePassengers(state, action: PayloadAction<{ adults: number; children: number; infants: number }>) {\n   122→      const passengers: PassengerInfo[] = []\n   123→      for (let i = 0; i < action.payload.adults; i++) {\n   124→        passengers.push({\n   125→          firstName: '', lastName: '', dateOfBirth: '', gender: '',\n   126→          email: '', phone: '', passengerType: 'adult',\n   127→        })\n   128→      }\n   129→      for (let i = 0; i < action.payload.children; i++) {\n   130→        passengers.push({\n   131→          firstName: '', lastName: '', dateOfBirth: '', gender: '',\n   132→          email: '', phone: '', passengerType: 'child',\n   133→        })\n   134→      }\n   135→      for (let i = 0; i < action.payload.infants; i++) {\n   136→        passengers.push({\n   137→          firstName: '', lastName: '', dateOfBirth: '', gender: '',\n   138→          email: '', phone: '', passengerType: 'infant',\n   139→        })\n   140→      }\n   141→      state.passengers = passengers\n   142→      state.validationErrors = {}\n   143→      state.bookingComplete = false\n   144→      state.bookingReference = null\n   145→      state.bookingError = null\n   146→    },\n   147→    updatePassenger(state, action: PayloadAction<{ index: number; field: keyof PassengerInfo; value: string }>) {\n   148→      const p = state.passengers[action.payload.index]\n   149→      if (p) {\n   150→        ;(p[action.payload.field] as string) = action.payload.value\n   151→      }\n   152→      // Clear validation error for this field\n   153→      delete state.validationErrors[`${action.payload.index}-${action.payload.field}`]\n   154→    },\n   155→    setValidationErrors(state, action: PayloadAction<Record<string, string>>) {\n   156→      state.validationErrors = action.payload\n   157→    },\n   158→    resetBooking(state) {\n   159→      state.flight = null\n   160→      state.legs = []\n   161→      state.loading = false\n   162→      state.error = null\n   163→      state.passengers = []\n   164→      state.validationErrors = {}\n   165→      state.bookingInProgress = false\n   166→      state.bookingComplete = false\n   167→      state.bookingReference = null\n   168→      state.bookingError = null\n   169→    },\n   170→  },\n   171→  extraReducers: (builder) => {\n   172→    builder\n   173→      .addCase(fetchFlightForBooking.pending, (state) => {\n   174→        state.loading = true\n   175→        state.error = null\n   176→      })\n   177→      .addCase(fetchFlightForBooking.fulfilled, (state, action) => {\n   178→        state.flight = action.payload.flight\n   179→        state.legs = action.payload.legs\n   180→        state.loading = false\n   181→      })\n   182→      .addCase(fetchFlightForBooking.rejected, (state, action) => {\n   183→        state.loading = false\n   184→        state.error = action.error.message || 'Failed to load flight details'\n   185→      })\n   186→      .addCase(createBooking.pending, (state) => {\n   187→        state.bookingInProgress = true\n   188→        state.bookingError = null\n   189→      })\n   190→      .addCase(createBooking.fulfilled, (state, action) => {\n   191→        state.bookingInProgress = false\n   192→        state.bookingComplete = true\n   193→        state.bookingReference = action.payload.bookingReference\n   194→      })\n   195→      .addCase(createBooking.rejected, (state, action) => {\n   196→        state.bookingInProgress = false\n   197→        state.bookingError = action.error.message || 'Booking failed. Please try again.'\n   198→      })\n   199→  },\n   200→})\n   201→\n   202→export const {\n   203→  initializePassengers,\n   204→  updatePassenger,\n   205→  setValidationErrors,\n   206→  resetBooking,\n   207→} = bookingSlice.actions\n   208→\n   209→export default bookingSlice.reducer\n   210→"}]},"parent_tool_use_id":"toolu_01CCVrGFXy7g8tyXNoTwbgMk","session_id":"d7dfe303-0120-4a32-8236-28247a8b3d21","uuid":"45d0c4f0-e100-4505-9b4e-fa