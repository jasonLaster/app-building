[2026-03-14T19:30:25.312Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01D7mFadkydmpFK44HrWxxMM","type":"tool_result","content":"     1→import { useState, useRef, useEffect } from 'react'\n     2→import { useDispatch, useSelector } from 'react-redux'\n     3→import { setCabinClass, type CabinClass } from '../slices/searchSlice'\n     4→import type { RootState } from '../store'\n     5→import './CabinClassSelector.css'\n     6→\n     7→const cabinClasses: { value: CabinClass; label: string }[] = [\n     8→  { value: 'economy', label: 'Economy' },\n     9→  { value: 'premium_economy', label: 'Premium Economy' },\n    10→  { value: 'business', label: 'Business' },\n    11→  { value: 'first', label: 'First' },\n    12→]\n    13→\n    14→function CabinClassSelector() {\n    15→  const dispatch = useDispatch()\n    16→  const cabinClass = useSelector((state: RootState) => state.search.cabinClass)\n    17→  const [isOpen, setIsOpen] = useState(false)\n    18→  const ref = useRef<HTMLDivElement>(null)\n    19→\n    20→  useEffect(() => {\n    21→    function handleClickOutside(e: MouseEvent) {\n    22→      if (ref.current && !ref.current.contains(e.target as Node)) {\n    23→        setIsOpen(false)\n    24→      }\n    25→    }\n    26→    if (isOpen) {\n    27→      document.addEventListener('mousedown', handleClickOutside)\n    28→      return () => document.removeEventListener('mousedown', handleClickOutside)\n    29→    }\n    30→  }, [isOpen])\n    31→\n    32→  const selectedLabel = cabinClasses.find((c) => c.value === cabinClass)?.label || 'Economy'\n    33→\n    34→  return (\n    35→    <div className=\"cabin-class-selector\" ref={ref} data-testid=\"cabin-class-selector\">\n    36→      <button\n    37→        className=\"cabin-class-selector__trigger\"\n    38→        onClick={() => setIsOpen(!isOpen)}\n    39→        data-testid=\"cabin-class-trigger\"\n    40→      >\n    41→        <span>{selectedLabel}</span>\n    42→        <span className=\"cabin-class-selector__arrow\">{isOpen ? '▲' : '▼'}</span>\n    43→      </button>\n    44→      {isOpen && (\n    45→        <div className=\"cabin-class-selector__dropdown\" data-testid=\"cabin-class-dropdown\">\n    46→          {cabinClasses.map((cls) => (\n    47→            <button\n    48→              key={cls.value}\n    49→              className={`cabin-class-selector__option ${cabinClass === cls.value ? 'cabin-class-selector__option--selected' : ''}`}\n    50→              onClick={() => {\n    51→                dispatch(setCabinClass(cls.value))\n    52→                setIsOpen(false)\n    53→              }}\n    54→              data-testid={`cabin-class-option-${cls.value}`}\n    55→            >\n    56→              {cls.label}\n    57→            </button>\n    58→          ))}\n    59→        </div>\n    60→      )}\n    61→    </div>\n    62→  )\n    63→}\n    64→\n    65→export default CabinClassSelector\n    66→"}]},"parent_tool_use_id":"toolu_01CCVrGFXy7g8tyXNoTwbgMk","session_id":"d7dfe303-0120-4a32-8236-28247a8b3d21","uuid":"111ad712-3c21-44c7-8548-3760b939bb11"}
