[2026-03-15T07:44:12.606Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BUt9YZYmS8ejYPZDi8Q8hv","type":"tool_result","content":"     1→import { createServer } from 'http'\n     2→import { join, basename } from 'path'\n     3→import { readdirSync } from 'fs'\n     4→\n     5→const functionsDir = join(import.meta.dirname, '..', 'netlify', 'functions')\n     6→const port = parseInt(process.argv[2] || '9999')\n     7→\n     8→// Load all function modules\n     9→const functionModules: Record<string, { default: (req: Request, ctx: unknown) => Promise<Response> }> = {}\n    10→\n    11→const files = readdirSync(functionsDir).filter(f => f.endsWith('.ts') && f !== 'db.ts')\n    12→for (const file of files) {\n    13→  const name = basename(file, '.ts')\n    14→  functionModules[name] = await import(join(functionsDir, file))\n    15→}\n    16→\n    17→console.log(`Loaded ${Object.keys(functionModules).length} functions: ${Object.keys(functionModules).join(', ')}`)\n    18→\n    19→const server = createServer(async (req, res) => {\n    20→  const url = new URL(req.url || '/', `http://localhost:${port}`)\n    21→\n    22→  // Match /api/<function-name> or /.netlify/functions/<function-name>\n    23→  let funcName: string | null = null\n    24→  const apiMatch = url.pathname.match(/^\\/api\\/([^/]+)/)\n    25→  const netlifyMatch = url.pathname.match(/^\\/.netlify\\/functions\\/([^/]+)/)\n    26→\n    27→  if (apiMatch?.[1]) {\n    28→    funcName = apiMatch[1]\n    29→  } else if (netlifyMatch?.[1]) {\n    30→    funcName = netlifyMatch[1]\n    31→  }\n    32→\n    33→  if (!funcName || !functionModules[funcName]) {\n    34→    res.writeHead(404)\n    35→    res.end('Not found')\n    36→    return\n    37→  }\n    38→\n    39→  try {\n    40→    // Build a Request object from the incoming HTTP request\n    41→    const headers = new Headers()\n    42→    for (const [key, value] of Object.entries(req.headers)) {\n    43→      if (value) headers.set(key, Array.isArray(value) ? value[0]! : value)\n    44→    }\n    45→\n    46→    const requestUrl = `http://localhost:${port}${req.url}`\n    47→    const requestInit: RequestInit = {\n    48→      method: req.method,\n    49→      headers,\n    50→    }\n    51→\n    52→    if (req.method !== 'GET' && req.method !== 'HEAD') {\n    53→      const chunks: Buffer[] = []\n    54→      for await (const chunk of req) {\n    55→        chunks.push(chunk as Buffer)\n    56→      }\n    57→      requestInit.body = Buffer.concat(chunks)\n    58→    }\n    59→\n    60→    const request = new Request(requestUrl, requestInit)\n    61→    const response = await functionModules[funcName]!.default(request, {})\n    62→\n    63→    // Send response\n    64→    res.writeHead(response.status, {\n    65→      'Content-Type': response.headers.get('content-type') || 'application/json',\n    66→      'Access-Control-Allow-Origin': '*',\n    67→    })\n    68→    const body = await response.text()\n    69→    res.end(body)\n    70→  } catch (err: unknown) {\n    71→    const error = err as Error\n    72→    console.error(`Function ${funcName} error:`, error.message)\n    73→    res.writeHead(500)\n    74→    res.end(JSON.stringify({ error: error.message }))\n    75→  }\n    76→})\n    77→\n    78→server.listen(port, () => {\n    79→  console.log(`Functions server ready on port ${port}`)\n    80→})\n    81→"}]},"parent_tool_use_id":null,"session_id":"316ad367-1475-485a-a257-5843849f2a92","uuid":"a16b7463-f269-4e73-b3ec-2d282271eaf0","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/GoogleFlights/scripts/functions-server.ts","content":"import { createServer } from 'http'\nimport { join, basename } from 'path'\nimport { readdirSync } from 'fs'\n\nconst functionsDir = join(import.meta.dirname, '..', 'netlify', 'functions')\nconst port = parseInt(process.argv[2] || '9999')\n\n// Load all function modules\nconst functionModules: Record<string, { default: (req: Request, ctx: unknown) => Promise<Response> }> = {}\n\nconst files = readdirSync(functionsDir).filter(f => f.endsWith('.ts') && f !== 'db.ts')\nfor (const file of files) {\n  const name = basename(file, '.ts')\n  functionModules[name] = await import(join(functionsDir, file))\n}\n\nconsole.log(`Loaded ${Object.keys(functionModules).length} functions: ${Object.keys(functionModules).join(', ')}`)\n\nconst server = createServer(async (req, res) => {\n  const url = new URL(req.url || '/', `http://localhost:${port}`)\n\n  // Match /api/<function-name> or /.netlify/functions/<function-name>\n  let funcName: string | null = null\n  const apiMatch = url.pathname.match(/^\\/api\\/([^/]+)/)\n  const netlifyMatch = url.pathname.match(/^\\/.netlify\\/functions\\/([^/]+)/)\n\n  if (apiMatch?.[1]) {\n    funcName = apiMatch[1]\n  } else if (netlifyMatch?.[1]) {\n    funcName = netlifyMatch[1]\n  }\n\n  if (!funcName || !functionModules[funcName]) {\n    res.writeHead(404)\n    res.end('Not found')\n    return\n  }\n\n  try {\n    // Build a Request object from the incoming HTTP request\n    const headers = new Headers()\n    for (const [key, value] of Object.entries(req.headers)) {\n      if (value) headers.set(key, Array.isArray(value) ? value[0]! : value)\n    }\n\n    const requestUrl = `http://localhost:${port}${req.url}`\n    const requestInit: RequestInit = {\n      method: req.method,\n      headers,\n    }\n\n    if (req.method !== 'GET' && req.method !== 'HEAD') {\n      const chunks: Buffer[] = []\n      for await (const chunk of req) {\n        chunks.push(chunk as Buffer)\n      }\n      requestInit.body = Buffer.concat(chunks)\n    }\n\n    const request = new Request(requestUrl, requestInit)\n    const response = await functionModules[funcName]!.default(request, {})\n\n    // Send response\n    res.writeHead(response.status, {\n      'Content-Type': response.headers.get('content-type') || 'application/json',\n      'Access-Control-Allow-Origin': '*',\n    })\n    const body = await response.text()\n    res.end(body)\n  } catch (err: unknown) {\n    const error = err as Error\n    console.error(`Function ${funcName} error:`, error.message)\n    res.writeHead(500)\n    res.end(JSON.stringify({ error: error.message }))\n  }\n})\n\nserver.listen(port, () => {\n  console.log(`Functions server ready on port ${port}`)\n})\n","numLines":81,"startLine":1,"totalLines":81}}}
