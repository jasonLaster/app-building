k((range: DateRange) => {\n    48→    dispatch(setDateRange(range))\n    49→  }, [dispatch])\n    50→\n    51→  return (\n    52→    <div className=\"explore-page\" data-testid=\"explore-page\">\n    53→      <div className=\"explore-page__header\">\n    54→        <h1 className=\"explore-page__title\">Explore destinations</h1>\n    55→        <p className=\"explore-page__subtitle\">Find cheap flights from your airport</p>\n    56→      </div>\n    57→\n    58→      <div className=\"explore-page__origin-selector\" data-testid=\"explore-origin-selector\">\n    59→        <label className=\"explore-page__origin-label\">From</label>\n    60→        <AirportAutocomplete\n    61→          value={origin}\n    62→          onChange={handleOriginChange}\n    63→          placeholder=\"Select origin airport\"\n    64→          testIdPrefix=\"explore-origin\"\n    65→        />\n    66→      </div>\n    67→\n    68→      <div className=\"explore-page__sections\">\n    69→        <section className=\"explore-page__map-section\">\n    70→          <DestinationMap\n    71→            destinations={destinations}\n    72→            loading={destinationsLoading}\n    73→            originCode={origin?.iata_code || null}\n    74→          />\n    75→        </section>\n    76→\n    77→        <section className=\"explore-page__dates-section\">\n    78→          <FlexibleDatesGrid\n    79→            datePrices={datePrices}\n    80→            loading={datePricesLoading}\n    81→            dateRange={dateRange}\n    82→            onDateRangeChange={handleDateRangeChange}\n    83→            originCode={origin?.iata_code || null}\n    84→          />\n    85→        </section>\n    86→\n    87→        <section className=\"explore-page__deals-section\">\n    88→          <DealsSection\n    89→            deals={deals}\n    90→            loading={dealsLoading}\n    91→            originCode={origin?.iata_code || null}\n    92→          />\n    93→        </section>\n    94→      </div>\n    95→    </div>\n    96→  )\n    97→}\n    98→\n    99→export default ExplorePage\n   100→"}]},"parent_tool_use_id":"toolu_01M9KZ2CnYTycgniXA2cU92S","session_id":"316ad367-1475-485a-a257-5843849f2a92","uuid":"f326aa82-6970-4051-8b65-8fdbc583922b"}
