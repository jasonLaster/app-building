riginCode)}`)\n    61→    return res.json() as Promise<ExploreDestination[]>\n    62→  }\n    63→)\n    64→\n    65→export const fetchExploreDates = createAsyncThunk(\n    66→  'explore/fetchDates',\n    67→  async (params: { originCode: string; dateRange: DateRange }) => {\n    68→    const res = await fetch(\n    69→      `/api/explore-dates?origin=${encodeURIComponent(params.originCode)}&range=${params.dateRange}`\n    70→    )\n    71→    return res.json() as Promise<DatePrice[]>\n    72→  }\n    73→)\n    74→\n    75→export const fetchExploreDeals = createAsyncThunk(\n    76→  'explore/fetchDeals',\n    77→  async (originCode: string) => {\n    78→    const res = await fetch(`/api/explore-deals?origin=${encodeURIComponent(originCode)}`)\n    79→    return res.json() as Promise<Deal[]>\n    80→  }\n    81→)\n    82→\n    83→const exploreSlice = createSlice({\n    84→  name: 'explore',\n    85→  initialState,\n    86→  reducers: {\n    87→    setExploreOrigin(state, action: PayloadAction<Airport | null>) {\n    88→      state.origin = action.payload\n    89→    },\n    90→    setDateRange(state, action: PayloadAction<DateRange>) {\n    91→      state.dateRange = action.payload\n    92→    },\n    93→  },\n    94→  extraReducers: (builder) => {\n    95→    builder\n    96→      .addCase(fetchExploreDestinations.pending, (state) => {\n    97→        state.destinationsLoading = true\n    98→      })\n    99→      .addCase(fetchExploreDestinations.fulfilled, (state, action) => {\n   100→        state.destinations = action.payload\n   101→        state.destinationsLoading = false\n   102→      })\n   103→      .addCase(fetchExploreDestinations.rejected, (state) => {\n   104→        state.destinationsLoading = false\n   105→      })\n   106→      .addCase(fetchExploreDates.pending, (state) => {\n   107→        state.datePricesLoading = true\n   108→      })\n   109→      .addCase(fetchExploreDates.fulfilled, (state, action) => {\n   110→        state.datePrices = actio