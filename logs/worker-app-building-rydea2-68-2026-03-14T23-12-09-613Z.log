    40→          {team.active_cycle_name ? (\n    41→            <>\n    42→              <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n    43→                <polyline points=\"23 4 23 10 17 10\" />\n    44→                <polyline points=\"1 20 1 14 7 14\" />\n    45→                <path d=\"M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15\" />\n    46→              </svg>\n    47→              <span>{team.active_cycle_name}</span>\n    48→            </>\n    49→          ) : (\n    50→            <span className=\"team-card-no-cycle\">No active cycle</span>\n    51→          )}\n    52→        </div>\n    53→      </div>\n    54→    </div>\n    55→  );\n    56→}\n    57→"}]},"parent_tool_use_id":"toolu_01AmdR2s5MQnJFBCwwZ4P9wP","session_id":"64cf2708-249b-4134-8592-7c4f6164677a","uuid":"b95e7510-47e1-4a5a-8f7c-b530bb0d1e9e"}
