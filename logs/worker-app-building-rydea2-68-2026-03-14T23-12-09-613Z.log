      ) : (\n   343→          <div className=\"ts-members-list\" data-testid=\"team-settings-members-list\">\n   344→            {teamMembers.map((member) => (\n   345→              <div\n   346→                key={member.id}\n   347→                className=\"ts-member-row\"\n   348→                data-testid={`team-settings-member-${member.id}`}\n   349→              >\n   350→                <div className=\"ts-member-info\">\n   351→                  <span className=\"ts-member-avatar\">{getInitials(member.name)}</span>\n   352→                  <div className=\"ts-member-details\">\n   353→                    <span className=\"ts-member-name\">{member.name}</span>\n   354→                    <span className=\"ts-member-email\">{member.email}</span>\n   355→                  </div>\n   356→                </div>\n   357→\n   358→                {removingMemberId === member.id ? (\n   359→                  <div className=\"ts-member-confirm\">\n   360→                    <span className=\"ts-confirm-text\">Remove {member.name}?</span>\n   361→                    <button\n   362→                      className=\"ts-confirm-btn\"\n   363→                      onClick={() => handleRemoveMember(member.id)}\n   364→                      data-testid={`team-settings-confirm-remove-${member.id}`}\n   365→                    >\n   366→                      Confirm\n   367→                    </button>\n   368→                    <button\n   369→                      className=\"ts-cancel-confirm-btn\"\n   370→                      onClick={() => setRemovingMemberId(null)}\n   371→                      data-testid={`team-settings-cancel-remove-${member.id}`}\n   372→                    >\n   373→                      Cancel\n   374→                    </button>\n   375→                  </div>\n   376→                ) : (\n   377→                  <button\n   378→                    className=\"ts-remove-btn\"\n   379→                    onClick={() => setRemovingMembe