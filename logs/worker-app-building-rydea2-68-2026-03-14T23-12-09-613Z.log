[2026-03-14T23:09:01.123Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Vn6kg5JxVLzAfmjii18fGq","type":"tool_result","content":"     1→import { createSlice, createAsyncThunk } from '@reduxjs/toolkit';\n     2→\n     3→export interface Team {\n     4→  id: string;\n     5→  name: string;\n     6→  identifier: string;\n     7→  description: string;\n     8→  member_count: number;\n     9→  active_cycle_name: string | null;\n    10→}\n    11→\n    12→export interface TeamMember {\n    13→  id: string;\n    14→  name: string;\n    15→  email: string;\n    16→}\n    17→\n    18→export interface TeamDetail {\n    19→  id: string;\n    20→  name: string;\n    21→  identifier: string;\n    22→  description: string;\n    23→}\n    24→\n    25→interface TeamsState {\n    26→  items: Team[];\n    27→  selectedTeam: TeamDetail | null;\n    28→  teamMembers: TeamMember[];\n    29→  availableMembers: TeamMember[];\n    30→  loading: boolean;\n    31→  detailLoading: boolean;\n    32→  error: string | null;\n    33→}\n    34→\n    35→const initialState: TeamsState = {\n    36→  items: [],\n    37→  selectedTeam: null,\n    38→  teamMembers: [],\n    39→  availableMembers: [],\n    40→  loading: false,\n    41→  detailLoading: false,\n    42→  error: null,\n    43→};\n    44→\n    45→export const fetchTeams = createAsyncThunk(\n    46→  'teams/fetchTeams',\n    47→  async (_, { getState, rejectWithValue }) => {\n    48→    const state = getState() as { auth: { token: string | null } };\n    49→    const token = state.auth.token;\n    50→    if (!token) return rejectWithValue('No token');\n    51→    const response = await fetch('/api/teams', {\n    52→      headers: { Authorization: `Bearer ${token}` },\n    53→    });\n    54→    if (!response.ok) {\n    55→      return rejectWithValue('Failed to fetch teams');\n    56→    }\n    57→    const data = await response.json();\n    58→    return data.teams as Team[];\n    59→  }\n    60→);\n    61→\n    62→export const fetchTeamDetail = createAsyncThunk(\n    63→  'teams/fetchTeamDetail',\n    64→  async (teamId: string, { getState, rejectWithValue }) => {\n    65→    const state = getState() as { auth: { token: string | null } };\n    66→    const token = state.auth.token;\n    67→    if (!token) return rejectWithValue('No token');\n    68→    const response = await fetch(`/api/teams/${teamId}`, {\n    69→      headers: { Authorization: `Bearer ${token}` },\n    70→    });\n    71→    if (!response.ok) {\n    72→      return rejectWithValue('Failed to fetch team details');\n    73→    }\n    74→    const data = await response.json();\n    75→    return data as { team: TeamDetail; members: TeamMember[]; availableMembers: TeamMember[] };\n    76→  }\n    77→);\n    78→\n    79→export const createTeam = createAsyncThunk(\n    80→  'teams/createTeam',\n    81→  async (payload: { name: string; identifier: string; description: string }, { getState, rejectWithValue }) => {\n    82→    const state = getState() as { auth: { token: string | null } };\n    83→    const token = state.auth.token;\n    84→    if (!token) return rejectWithValue('No token');\n    85→    const response = await fetch('/api/teams', {\n    86→      method: 'POST',\n    87→      headers: {\n    88→        Authorization: `Bearer ${token}`,\n    89→        'Content-Type': 'application/json',\n    90→      },\n    91→      body: JSON.stringify(payload),\n    92→    });\n    93→    const data = await response.json();\n    94→    if (!response.ok) {\n    95→      return rejectWithValue(data.error || 'Failed to create team');\n    96→    }\n    97→    return data.team as Team;\n    98→  }\n    99→);\n   100→\n   101→export const updateTeam = createAsyncThunk(\n   102→  'teams/updateTeam',\n   103→  async (payload: { teamId: string; name?: string; identifier?: string; description?: string }, { getState, rejectWithValue }) => {\n   104→    const state = getState() as { auth: { token: string | null } };\n   105→    const token = state.auth.token;\n   106→    if (!token) return rejectWithValue('No token');\n   107→    const { teamId, ...updates } = payload;\n   108→    const response = await fetch(`/api/teams/${teamId}`, {\n   109→      method: 'PUT',\n   110→      headers: {\n   111→        Authorization: `Bearer ${token}`,\n   112→        'Content-Type': 'application/json',\n   113→      },\n   114→      body: JSON.stringify(updates),\n   115→    });\n   116→    const data = await response.json();\n   117→    if (!response.ok) {\n   118→      return rejectWithValue(data.error || 'Failed to update team');\n   119→    }\n   120→    return data.team as TeamDetail;\n   121→  }\n   122→);\n   123→\n   124→export const deleteTeam = createAsyncThunk(\n   125→  'teams/deleteTeam',\n   126→  async (teamId: string, { getState, rejectWithValue }) => {\n   127→    const state = getState() as { auth: { token: string | null } };\n   128→    const token = state.auth.token;\n   129→    if (!token) return rejectWithValue('No token');\n   130→    const response = await fetch(`/api/teams/${teamId}`, {\n   131→      method: 'DELETE',\n   132→      headers: { Authorization: `Bearer ${token}` },\n   133→    });\n   134→    if (!response.ok) {\n   135→      const data = await response.json();\n   136→      return rejectWithValue(data.error || 'Failed to delete team');\n   137→    }\n   138→    return teamId;\n   139→  }\n   140→);\n   141→\n   142→export const addTeamMember = createAsyncThunk(\n   143→  'teams/addTeamMember',\n   144→  async (payload: { teamId: string; memberIdToAdd: string }, { getState, rejectWithValue }) => {\n   145→    const state = getState() as { auth: { token: string | null } };\n   146→    const token = state.auth.token;\n   147→    if (!token) return rejectWithValue('No token');\n   148→    const response = await fetch('/api/team-members', {\n   149→      method: 'POST',\n   150→      headers: {\n   151→        Authorization: `Bearer ${token}`,\n   152→        'Content-Type': 'application/json',\n   153→      },\n   154→      body: JSON.stringify(payload),\n   155→    });\n   156→    const data = await response.json();\n   157→    if (!response.ok) {\n   158→      return rejectWithValue(data.error || 'Failed to add member');\n   159→    }\n   160→    return data.member as TeamMember;\n   161→  }\n   162→);\n   163→\n   164→export const removeTeamMember = createAsyncThunk(\n   165→  'teams/removeTeamMember',\n   166→  async (payload: { teamId: string; memberIdToRemove: string }, { getState, rejectWithValue }) => {\n   167→    const state = getState() as { auth: { token: string | null } };\n   168→    const token = state.auth.token;\n   169→    if (!token) return rejectWithValue('No token');\n   170→    const response = await fetch('/api/team-members', {\n   171→      method: 'DELETE',\n   172→      headers: {\n   173→        Authorization: `Bearer ${token}`,\n   174→        'Content-Type': 'application/json',\n   175→      },\n   176→      body: JSON.stringify(payload),\n   177→    });\n   178→    if (!response.ok) {\n   179→      const data = await response.json();\n   180→      return rejectWithValue(data.error || 'Failed to remove member');\n   181→    }\n   182→    return payload.memberIdToRemove;\n   183→  }\n   184→);\n   185→\n   186→const teamsSlice = createSlice({\n   187→  name: 'teams',\n   188→  initialState,\n   189→  reducers: {\n   190→    clearTeamDetail(state) {\n   191→      state.selectedTeam = null;\n   192→      state.teamMembers = [];\n   193→      state.availableMembers = [];\n   194→    },\n   195→  },\n   196→  extraReducers: (builder) => {\n   197→    builder\n   198→      .addCase(fetchTeams.pending, (state) => {\n   199→        if (state.items.length === 0) {\n   200→          state.loading = true;\n   201→        }\n   202→        state.error = null;\n   203→      })\n   204→      .addCase(fetchTeams.fulfilled, (state, action) => {\n   205→        state.loading = false;\n   206→        state.items = action.payload;\n   207→      })\n   208→      .addCase(fetchTeams.rejected, (state, action) => {\n   209→        state.loading = false;\n   210→        state.error = action.payload as string;\n   211→      })\n   212→      .addCase(fetchTeamDetail.pending, (state) => {\n   213→        state.detailLoading = true;\n   214→        state.error = null;\n   215→      })\n   216→      .addCase(fetchTeamDetail.fulfilled, (state, action) => {\n   217→        state.detailLoading = false;\n   218→        state.selectedTeam = action.payload.team;\n   219→        state.teamMembers = action.payload.members;\n   220→        state.availableMembers = action.payload.availableMembers;\n   221→      })\n   222→      .addCase(fetchTeamDetail.rejected, (state, action) => {\n   223→        state.detailLoading = false;\n   224→        state.error = action.payload as string;\n   225→      })\n   226→      .addCase(createTeam.fulfilled, (state, action) => {\n   227→        state.items.push(action.payload);\n   228→      })\n   229→      .addCase(updateTeam.fulfilled, (state, action) => {\n   230→        state.selectedTeam = action.payload;\n   231→        const idx = state.items.findIndex((t) => t.id === action.payload.id);\n   232→        if (idx !== -1) {\n   233→          const item = state.items[idx]!;\n   234→          item.name = action.payload.name;\n   235→          item.identifier = action.payload.identifier;\n   236→          item.description = action.payload.description;\n   237→        }\n   238→      })\n   239→      .addCase(deleteTeam.fulfilled, (state, action) => {\n   240→        state.items = state.items.filter((t) => t.id !== action.payload);\n   241→        state.selectedTeam = null;\n   242→      })\n   243→      .addCase(addTeamMember.fulfilled, (state, action) => {\n   244→        state.teamMembers.push(action.payload);\n   245→        state.availableMembers = state.availableMembers.filter((m) => m.id !== action.payload.id);\n   246→      })\n   247→      .addCase(removeTeamMember.fulfilled, (state, action) => {\n   248→        const removed = state.teamMembers.find((m) => m.id === action.payload);\n   249→        state.teamMembers = state.teamMembers.filter((m) => m.id !== action.payload);\n   250→        if (removed) {\n   251→          state.availableMembers.push(removed);\n   252→          state.availableMembers.sort((a, b) => a.name.localeCompare(b.name));\n   253→        }\n   254→      });\n   255→  },\n   256→});\n   257→\n   258→export const { clearTeamDetail } = teamsSlice.actions;\n   259→export default teamsSlice.reducer;\n   260→"}]},"parent_tool_use_id":"toolu_01AmdR2s5MQnJFBCwwZ4P9wP","session_id":"64cf2708-249b-4134-8592-7c4f6164677a","uuid":"4796e2d1-afa9-4ead-aade-0f01077c7afb"}
