    await loginAndNavigateToTeamIssues(page, baseURL!);\n    43→\n    44→    // Verify header with team name\n    45→    await expect(page.getByTestId('team-issues-title')).toBeVisible({ timeout: 30000 });\n    46→    await expect(page.getByTestId('team-issues-title')).toContainText('Engineering');\n    47→    await expect(page.getByTestId('team-issues-title')).toContainText('Issues');\n    48→\n    49→    // Verify New Issue button is visible\n    50→    await expect(page.getByTestId('new-issue-btn')).toBeVisible();\n    51→  });\n    52→\n    53→  test('Team Issues page shows issues grouped by status (default)', async ({ page, baseURL }) => {\n    54→    await loginAndNavigateToTeamIssues(page, baseURL!);\n    55→\n    56→    // Wait for issues to load\n    57→    await expect(page.getByTestId('team-issues-list')).toBeVisible({ timeout: 30000 });\n    58→\n    59→    // Seed data groups for ENG:\n    60→    // backlog: ENG-3, ENG-7 (2 issues)\n    61→    // todo: ENG-2, ENG-6 (2 issues)\n    62→    // in_progress: ENG-1, ENG-8 (2 issues)\n    63→    // in_review: ENG-4 (1 issue)\n    64→    // done: ENG-5 (1 issue)\n    65→\n    66→    // Verify backlog group\n    67→    await expect(page.getByTestId('team-issue-group-backlog')).toBeVisible();\n    68→    await expect(page.getByTestId('team-issue-group-header-backlog')).toContainText('Backlog');\n    69→    await expect(page.getByTestId('team-issue-group-header-backlog')).toContainText('(2)');\n    70→\n    71→    // Verify todo group\n    72→    await expect(page.getByTestId('team-issue-group-todo')).toBeVisible();\n    73→    await expect(page.getByTestId('team-issue-group-header-todo')).toContainText('Todo');\n    74→    await expect(page.getByTestId('team-issue-group-header-todo')).toContainText('(2)');\n    75→\n    76→    // Verify in_progress group\n    77→    await expect(page.getByTestId('team-issue-group-in_progress')).toBeVisible();\n    78→    await expect(page.getByTestId('team-issue-group-header-in_progress')).toContainText('In Progress');\n    79→    await expect(page.getByTestId('team-issue-group-header-in_progress')).toContainText('(2)');\n    80→\n    81→    // Verify in_review group\n    82→    await expect(page.getByTestId('team-issue-group-in_review')).toBeVisible();\n    83→    await expect(page.getByTestId('team-issue-group-header-in_review')).toContainText('In Review');\n    84→    await expect(page.getByTestId('team-issue-group-header-in_review')).toContainText('(1)');\n    85→\n    86→    // Verify done group\n    87→    await expect(page.getByTestId('team-issue-group-done')).toBeVisible();\n    88→    await expect(page.getByTestId('team-issue-group-header-done')).toContainText('Done');\n    89→    await expect(page.getByTestId('team-issue-group-header-done')).toContainText('(1)');\n    90→\n    91→    // Verify cancelled group is NOT displayed (no cancelled issues in seed)\n    92→    await expect(page.getByTestId('team-issue-group-cancelled')).toHaveCount(0);\n    93→\n    94→    // Verify groups appear in correct status order\n    95→    const backlogBox = await page.getByTestId('team-issue-group-backlog').boundingBox();\n    96→    const todoBox = await page.getByTestId('team-issue-group-todo').boundingBox();\n    97→    const inProgressBox = await page.getByTestId('team-issue-group-in_progress').boundingBox();\n    98→    const inReviewBox = await page.getByTestId('team-issue-group-in_review').boundingBox();\n    99→    const doneBox = await page.getByTestId('team-issue-group-done').boundingBox();\n   100→    expect(backlogBox!.y).toBeLessThan(todoBox!.y);\n   101→    expect(todoBox!.y).toBeLessThan(inProgressBox!.y);\n   102→    expect(inProgressBox!.y).toBeLessThan(inReviewBox!.y);\n   103→    expect(inReviewBox!.y).toBeLessThan(doneBox!.y);\n   104→  });\n   105→\n   106→  test('Team Issues page shows all team issues, not just current user\\'s', async ({ page, baseURL }) => {\n   107→    await loginAndNavigateToTeamIssues(page, baseURL!);\n 