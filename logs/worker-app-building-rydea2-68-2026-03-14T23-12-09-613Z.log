[2026-03-14T23:09:01.503Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Aaw3g26SgaVNfLtP2Xvk8k","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions';\n     2→import { getSql } from './db';\n     3→\n     4→async function authenticate(req: Request) {\n     5→  const authHeader = req.headers.get('Authorization');\n     6→  if (!authHeader?.startsWith('Bearer ')) return null;\n     7→  const token = authHeader.slice(7);\n     8→  const sql = getSql();\n     9→  const sessions = await sql`\n    10→    SELECT s.member_id FROM sessions s\n    11→    WHERE s.token = ${token} AND s.expires_at > NOW()\n    12→  `;\n    13→  const session = sessions[0];\n    14→  return session ? session.member_id as string : null;\n    15→}\n    16→\n    17→export default async function handler(req: Request, _context: Context) {\n    18→  try {\n    19→    const memberId = await authenticate(req);\n    20→    if (!memberId) {\n    21→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    22→        status: 401,\n    23→        headers: { 'Content-Type': 'application/json' },\n    24→      });\n    25→    }\n    26→\n    27→    const sql = getSql();\n    28→    const url = new URL(req.url);\n    29→    const pathParts = url.pathname.split('/').filter(Boolean);\n    30→    const teamId = pathParts[2] || null;\n    31→\n    32→    if (req.method === 'GET' && !teamId) {\n    33→      const teams = await sql`\n    34→        SELECT t.id, t.name, t.identifier, t.description,\n    35→          (SELECT COUNT(*)::int FROM team_members tm WHERE tm.team_id = t.id) AS member_count,\n    36→          (SELECT c.name FROM cycles c WHERE c.team_id = t.id AND c.status = 'active' LIMIT 1) AS active_cycle_name\n    37→        FROM teams t\n    38→        ORDER BY t.name ASC\n    39→      `;\n    40→      return new Response(JSON.stringify({ teams }), {\n    41→        status: 200,\n    42→        headers: { 'Content-Type': 'application/json' },\n    43→      });\n    44→    }\n    45→\n    46→    if (req.method === 'GET' && teamId) {\n    47→      const teams = await sql`\n    48→        SELECT t.id, t.name, t.identifier, t.description\n    49→        FROM teams t WHERE t.id = ${teamId}\n    50→      `;\n    51→      const team = teams[0];\n    52→      if (!team) {\n    53→        return new Response(JSON.stringify({ error: 'Team not found' }), {\n    54→          status: 404,\n    55→          headers: { 'Content-Type': 'application/json' },\n    56→        });\n    57→      }\n    58→\n    59→      const members = await sql`\n    60→        SELECT m.id, m.name, m.email\n    61→        FROM members m\n    62→        JOIN team_members tm ON tm.member_id = m.id\n    63→        WHERE tm.team_id = ${teamId}\n    64→        ORDER BY m.name ASC\n    65→      `;\n    66→\n    67→      const allMembers = await sql`\n    68→        SELECT m.id, m.name, m.email\n    69→        FROM members m\n    70→        WHERE m.id NOT IN (\n    71→          SELECT tm.member_id FROM team_members tm WHERE tm.team_id = ${teamId}\n    72→        )\n    73→        ORDER BY m.name ASC\n    74→      `;\n    75→\n    76→      return new Response(JSON.stringify({ team, members, availableMembers: allMembers }), {\n    77→        status: 200,\n    78→        headers: { 'Content-Type': 'application/json' },\n    79→      });\n    80→    }\n    81→\n    82→    if (req.method === 'POST') {\n    83→      const body = await req.json();\n    84→      const { name, identifier, description } = body as { name: string; identifier: string; description?: string };\n    85→\n    86→      if (!name?.trim()) {\n    87→        return new Response(JSON.stringify({ error: 'Name is required' }), {\n    88→          status: 400,\n    89→          headers: { 'Content-Type': 'application/json' },\n    90→        });\n    91→      }\n    92→      if (!identifier?.trim()) {\n    93→        return new Response(JSON.stringify({ error: 'Identifier prefix is required' }), {\n    94→          status: 400,\n    95→          headers: { 'Content-Type': 'application/json' },\n    96→        });\n    97→      }\n    98→\n    99→      const upperIdentifier = identifier.trim().toUpperCase();\n   100→      if (upperIdentifier.length < 2 || upperIdentifier.length > 5) {\n   101→        return new Response(JSON.stringify({ error: 'Identifier prefix must be 2-5 characters' }), {\n   102→          status: 400,\n   103→          headers: { 'Content-Type': 'application/json' },\n   104→        });\n   105→      }\n   106→\n   107→      const existing = await sql`\n   108→        SELECT id FROM teams WHERE UPPER(identifier) = ${upperIdentifier}\n   109→      `;\n   110→      if (existing.length > 0) {\n   111→        return new Response(JSON.stringify({ error: `A team with prefix '${upperIdentifier}' already exists` }), {\n   112→          status: 409,\n   113→          headers: { 'Content-Type': 'application/json' },\n   114→        });\n   115→      }\n   116→\n   117→      const newTeams = await sql`\n   118→        INSERT INTO teams (name, identifier, description)\n   119→        VALUES (${name.trim()}, ${upperIdentifier}, ${description?.trim() || ''})\n   120→        RETURNING id, name, identifier, description\n   121→      `;\n   122→      const newTeam = newTeams[0];\n   123→\n   124→      return new Response(JSON.stringify({ team: { ...newTeam, member_count: 0, active_cycle_name: null } }), {\n   125→        status: 201,\n   126→        headers: { 'Content-Type': 'application/json' },\n   127→      });\n   128→    }\n   129→\n   130→    if (req.method === 'PUT' && teamId) {\n   131→      const body = await req.json();\n   132→      const { name, identifier, description } = body as { name?: string; identifier?: string; description?: string };\n   133→\n   134→      if (name !== undefined && !name.trim()) {\n   135→        return new Response(JSON.stringify({ error: 'Team name cannot be empty' }), {\n   136→          status: 400,\n   137→          headers: { 'Content-Type': 'application/json' },\n   138→        });\n   139→      }\n   140→\n   141→      if (identifier !== undefined) {\n   142→        const upperIdentifier = identifier.trim().toUpperCase();\n   143→        if (upperIdentifier.length < 2 || upperIdentifier.length > 5) {\n   144→          return new Response(JSON.stringify({ error: 'Identifier prefix must be 2-5 characters' }), {\n   145→            status: 400,\n   146→            headers: { 'Content-Type': 'application/json' },\n   147→          });\n   148→        }\n   149→\n   150→        const existing = await sql`\n   151→          SELECT id FROM teams WHERE UPPER(identifier) = ${upperIdentifier} AND id != ${teamId}\n   152→        `;\n   153→        if (existing.length > 0) {\n   154→          return new Response(JSON.stringify({ error: `A team with prefix '${upperIdentifier}' already exists` }), {\n   155→            status: 409,\n   156→            headers: { 'Content-Type': 'application/json' },\n   157→          });\n   158→        }\n   159→      }\n   160→\n   161→      const nameVal = name !== undefined ? name.trim() : null;\n   162→      const identVal = identifier !== undefined ? identifier.trim().toUpperCase() : null;\n   163→      const descVal = description !== undefined ? description : null;\n   164→      const descProvided = description !== undefined;\n   165→\n   166→      const updatedTeams = await sql`\n   167→        UPDATE teams\n   168→        SET\n   169→          name = CASE WHEN ${nameVal} IS NOT NULL THEN ${nameVal} ELSE name END,\n   170→          identifier = CASE WHEN ${identVal} IS NOT NULL THEN ${identVal} ELSE identifier END,\n   171→          description = CASE WHEN ${descProvided} THEN ${descVal} ELSE description END\n   172→        WHERE id = ${teamId}\n   173→        RETURNING id, name, identifier, description\n   174→      `;\n   175→      const updated = updatedTeams[0];\n   176→      if (!updated) {\n   177→        return new Response(JSON.stringify({ error: 'Team not found' }), {\n   178→          status: 404,\n   179→          headers: { 'Content-Type': 'application/json' },\n   180→        });\n   181→      }\n   182→\n   183→      return new Response(JSON.stringify({ team: updated }), {\n   184→        status: 200,\n   185→        headers: { 'Content-Type': 'application/json' },\n   186→      });\n   187→    }\n   188→\n   189→    if (req.method === 'DELETE' && teamId) {\n   190→      await sql`DELETE FROM team_members WHERE team_id = ${teamId}`;\n   191→      await sql`UPDATE issues SET cycle_id = NULL WHERE cycle_id IN (SELECT id FROM cycles WHERE team_id = ${teamId})`;\n   192→      await sql`UPDATE issues SET team_id = NULL WHERE team_id = ${teamId}`;\n   193→      await sql`DELETE FROM cycles WHERE team_id = ${teamId}`;\n   194→      await sql`DELETE FROM teams WHERE id = ${teamId}`;\n   195→\n   196→      return new Response(JSON.stringify({ success: true }), {\n   197→        status: 200,\n   198→        headers: { 'Content-Type': 'application/json' },\n   199→      });\n   200→    }\n   201→\n   202→    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n   203→      status: 405,\n   204→      headers: { 'Content-Type': 'application/json' },\n   205→    });\n   206→  } catch (err) {\n   207→    console.error('Teams error:', err);\n   208→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n   209→      status: 500,\n   210→      headers: { 'Content-Type': 'application/json' },\n   211→    });\n   212→  }\n   213→}\n   214→"}]},"parent_tool_use_id":"toolu_01AmdR2s5MQnJFBCwwZ4P9wP","session_id":"64cf2708-249b-4134-8592-7c4f6164677a","uuid":"4f995da0-4c6b-495a-bf4f-883539680192"}
