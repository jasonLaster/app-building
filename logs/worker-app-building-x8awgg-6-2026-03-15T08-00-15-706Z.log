e ranges with new data\n   311→        if (state.flights.length > 0) {\n   312→          const prices = state.flights.map(f => f.total_price_cents)\n   313→          const durations = state.flights.map(f => f.duration_minutes)\n   314→          state.priceRangeMax = [Math.min(...prices), Math.max(...prices)]\n   315→          state.durationRangeMax = [Math.min(...durations), Math.max(...durations)]\n   316→        }\n   317→      })\n   318→      .addCase(loadMoreFlights.rejected, (state) => {\n   319→        state.loadingMore = false\n   320→      })\n   321→      .addCase(fetchFlightLegs.pending, (state, action) => {\n   322→        state.expandedLegsLoading[action.meta.arg] = true\n   323→      })\n   324→      .addCase(fetchFlightLegs.fulfilled, (state, action) => {\n   325→        state.expandedLegs[action.payload.flightId] = action.payload.legs\n   326→        state.expandedLegsLoading[action.payload.flightId] = false\n   327→      })\n   328→      .addCase(fetchFlightLegs.rejected, (state, action) => {\n   329→        state.expandedLegsLoading[action.meta.arg] = false\n   330→      })\n   331→      .addCase(checkTrackedRoute.pending, (state) => {\n   332→        state.isTrackedLoading = true\n   333→      })\n   334→      .addCase(checkTrackedRoute.fulfilled, (state, action) => {\n   335→        state.isTracked = action.payload\n   336→        state.isTrackedLoading = false\n   337→      })\n   338→      .addCase(checkTrackedRoute.rejected, (state) => {\n   339→        state.isTrackedLoading = false\n   340→      })\n   341→      .addCase(toggleTrackRoute.fulfilled, (state, action) => {\n   342→        state.isTracked = action.payload\n   343→      })\n   344→  },\n   345→})\n   346→\n   347→export const {\n   348→  setSortBy,\n   349→  setStopsFilter,\n   350→  setAirlinesFilter,\n   351→  setPriceRange,\n   352→  setDurationRange,\n   353→  setDepartureTimeFilter,\n   354→  setArrivalTimeFilter,\n   355→  resetFilters,\n   356→} = flightsSlice.actions\n   3