   <Route path=\"/team/:teamId/cycles\" element={<ActiveCycle />} />\n    40→          <Route path=\"/issue/:issueId\" element={<IssueDetail />} />\n    41→          <Route path=\"/projects\" element={<Projects />} />\n    42→          <Route path=\"/project/:projectId\" element={<ProjectDetail />} />\n    43→          <Route path=\"/settings/members\" element={<Members />} />\n    44→          <Route path=\"/settings/teams\" element={<Teams />} />\n    45→          <Route path=\"/settings/labels\" element={<Labels />} />\n    46→          <Route path=\"/settings\" element={<Settings />} />\n    47→          <Route path=\"*\" element={<Navigate to=\"/my-issues\" replace />} />\n    48→        </Routes>\n    49→      </main>\n    50→      <KeyboardShortcuts />\n    51→      <CreateIssueModal />\n    52→    </div>\n    53→  );\n    54→}\n    55→\n    56→export default function App() {\n    57→  const dispatch = useDispatch<AppDispatch>();\n    58→  const { token, user } = useSelector((state: RootState) => state.auth);\n    59→  const location = useLocation();\n    60→\n    61→  useEffect(() => {\n    62→    if (token) {\n    63→      dispatch(fetchCurrentUser());\n    64→    }\n    65→  }, [dispatch, token]);\n    66→\n    67→  const isAuthPage = location.pathname === '/login' || location.pathname === '/signup';\n    68→\n    69→  if (!token && !isAuthPage) {\n    70→    return <Navigate to=\"/login\" replace />;\n    71→  }\n    72→\n    73→  if (token && !user) {\n    74→    return (\n    75→      <div className=\"app-loading\" data-testid=\"app-loading\">\n    76→        <div className=\"loading-spinner\" />\n    77→      </div>\n    78→    );\n    79→  }\n    80→\n    81→  if (token && user && isAuthPage) {\n    82→    return <Navigate to=\"/my-issues\" replace />;\n    83→  }\n    84→\n    85→  return (\n    86→    <Routes>\n    87→      <Route path=\"/login\" element={<Login />} />\n    88→      <Route path=\"/signup\" element={<SignUp />} />\n    89→      <Route path=\"/*\" element={<AuthenticatedLayout />} />\n    90→    </Routes>\n    91→  );\n    92→}\n    93→"}]},"parent_tool_use_id":null,"session_id":"cea1a0db-f072-4eb0-98ad-c0869b93e80c","uuid":"8c3e9c97-5cb1-4256-9e14-bf7531cf097c","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/src/App.tsx","content":"import { useEffect } from 'react';\nimport { Routes, Route, Navigate, useLocation } from 'react-router-dom';\nimport { useSelector, useDispatch } from 'react-redux';\nimport type { RootState, AppDispatch } from './store';\nimport { fetchCurrentUser } from './slices/authSlice';\nimport { fetchTeams } from './slices/teamsSlice';\nimport { Sidebar } from './components/Sidebar';\nimport { KeyboardShortcuts } from './components/KeyboardShortcuts';\nimport { CreateIssueModal } from './components/CreateIssueModal';\nimport Login from './pages/Login';\nimport SignUp from './pages/SignUp';\nimport MyIssues from './pages/MyIssues';\nimport Inbox from './pages/Inbox';\nimport TeamIssues from './pages/TeamIssues';\nimport IssueDetail from './pages/IssueDetail';\nimport ActiveCycle from './pages/ActiveCycle';\nimport Projects from './pages/Projects';\nimport ProjectDetail from './pages/ProjectDetail';\nimport Members from './pages/Members';\nimport Teams from './pages/Teams';\nimport Labels from './pages/Labels';\nimport Settings from './pages/Settings';\n\nfunction AuthenticatedLayout() {\n  const dispatch = useDispatch<AppDispatch>();\n\n  useEffect(() => {\n    dispatch(fetchTeams());\n  }, [dispatch]);\n\n  return (\n    <div className=\"app-layout\" data-testid=\"app-layout\">\n      <Sidebar />\n      <main className=\"app-main\">\n        <Routes>\n          <Route path=\"/my-issues\" element={<MyIssues />} />\n          <Route path=\"/inbox\" element={<Inbox />} />\n          <Route path=\"/team/:teamId/issues\" element={<TeamIssues />} />\n          <Route path=\"/team/:teamId/cycles\" element={<ActiveCycle />} />\n          <Route path=\"/issue/:issueId\" element={<IssueDetail />} />\n          <Route path=\"/projects\" element={<Projects />} />\n          <Route path=\"/project/:projectId\" element={<ProjectDetail />} />\n          <Route path=\"/settings/members\" element={<Members />} />\n          <Route path=\"/settings/teams\" element={<Teams />} />\n          <Route path=\"/settings/labels\" element={<Labels />} />\n          <Route path=\"/settings\" element={<Settings />} />\n          <Route path=\"*\" element={<Navigate to=\"/my-issues\" replace />} />\n        </Routes>\n      </main>\n      <KeyboardShortcuts />\n      <CreateIssueModal />\n    </div>\n  );\n}\n\nexport default function App() {\n  const dispatch = useDispatch<AppDispatch>();\n  const { token, user } = useSelector((state: RootState) => state.auth);\n  const location = useLocation();\n\n  useEffect(() => {\n    if (token) {\n      dispatch(fetchCurrentUser());\n    }\n  }, [dispatch, token]);\n\n  const isAuthPage = location.pathname === '/login' || location.pathname === '/signup';\n\n  if (!token && !isAuthPage) {\n    return <Navigate to=\"/login\" replace />;\n  }\n\n  if (token && !user) {\n    return (\n      <div className=\"app-loading\" data-testid=\"app-loading\">\n        <div className=\"loading-spinner\" />\n      </div>\n    );\n  }\n\n  if (token && user && isAuthPage) {\n    return <Navigate to=\"/my-issues\" replace />;\n  }\n\n  return (\n    <Routes>\n      <Route path=\"/login\" element={<Login />} />\n      <Route path=\"/signup\" element={<SignUp />} />\n      <Route path=\"/*\" element={<AuthenticatedLayout />} />\n    </Routes>\n  );\n}\n","numLines":93,"startLine":1,"totalLines":93}}}
