f (!validate()) return;\n    49→\n    50→    dispatch(signup({ name: name.trim(), email: email.trim(), password }));\n    51→  }\n    52→\n    53→  return (\n    54→    <form className=\"signup-form\" onSubmit={handleSubmit} data-testid=\"signup-form\">\n    55→      <div className=\"signup-form-header\">\n    56→        <h1 className=\"signup-form-title\">Create your account</h1>\n    57→        <p className=\"signup-form-subtitle\">Get started with LinearClone</p>\n    58→      </div>\n    59→\n    60→      {error && (\n    61→        <div className=\"signup-form-error\" data-testid=\"signup-error\">\n    62→          {error}\n    63→        </div>\n    64→      )}\n    65→\n    66→      <div className=\"signup-form-field\">\n    67→        <label htmlFor=\"signup-name\" className=\"signup-form-label\">Name</label>\n    68→        <input\n    69→          id=\"signup-name\"\n    70→          type=\"text\"\n    71→          className={`signup-form-input ${validationErrors.name ? 'signup-form-input-error' : ''}`}\n    72→          placeholder=\"Your full name\"\n    73→          value={name}\n    74→          onChange={(e) => {\n    75→            setName(e.target.value);\n    76→            if (validationErrors.name) {\n    77→              setValidationErrors((prev) => ({ ...prev, name: undefined }));\n    78→            }\n    79→          }}\n    80→          data-testid=\"signup-name-input\"\n    81→          autoComplete=\"name\"\n    82→        />\n    83→        {validationErrors.name && (\n    84→          <span className=\"signup-form-field-error\" data-testid=\"signup-name-error\">\n    85→            {validationErrors.name}\n    86→          </span>\n    87→        )}\n    88→      </div>\n    89→\n    90→      <div className=\"signup-form-field\">\n    91→        <label htmlFor=\"signup-email\" className=\"signup-form-label\">Email</label>\n    92→        <input\n    93→          id=\"signup-email\"\n    94→          type=\"email\"\n    95→          className={`signup-form-input ${validationErrors.email ? 'signup-form-input-error' : ''}`}\n    96→          placeholder=\"you@example.com\"\n    97→          value={email}\n    98→          onChange={(e) => {\n    99→            setEmail(e.target.value);\n   100→            if (validationErrors.email) {\n   101→              setValidationErrors((prev) => ({ ...prev, email: undefined }));\n   102→            }\n   103→          }}\n   104→          data-testid=\"signup-email-input\"\n   105→          autoComplete=\"email\"\n   106→        />\n   107→        {validationErrors.email && (\n   108→          <span className=\"signup-form-field-error\" data-testid=\"signup-email-error\">\n   109→            {validationErrors.email}\n   110→          </span>\n   111→        )}\n   112→      </div>\n   113→\n   114→      <div className=\"signup-form-field\">\n   115→        <label htmlFor=\"signup-password\" className=\"signup-form-label\">Password</label>\n   116→        <input\n   117→          id=\"signup-password\"\n   118→          type=\"password\"\n   119→          className={`signup-form-input ${validationErrors.password ? 'signup-form-input-error' : ''}`}\n   120→          placeholder=\"Minimum 8 characters\"\n   121→          value={password}\n   122→          onChange={(e) => {\n   123→            setPassword(e.target.value);\n   124→            if (validationErrors.password) {\n   125→              setValidationErrors((prev) => ({ ...prev, password: undefined }));\n   126→            }\n   127→          }}\n   128→          data-testid=\"signup-password-input\"\n   129→          autoComplete=\"new-password\"\n   130→        />\n   131→        {validationErrors.password && (\n   132→          <span className=\"signup-form-field-error\" data-testid=\"signup-password-error\">\n   133→            {validationErrors.password}\n   134→          </span>\n   135→        )}\n   136→      </div>\n   137→\n   138→      <button\n   139→        type=\"submit\"\n   140→        cl