[2026-03-14T21:02:49.454Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EvprKkhAJUNWEtSDG44Cjh","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions';\n     2→import { getSql } from './db';\n     3→\n     4→export default async function handler(req: Request, _context: Context) {\n     5→  if (req.method !== 'GET') {\n     6→    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n     7→      status: 405,\n     8→      headers: { 'Content-Type': 'application/json' },\n     9→    });\n    10→  }\n    11→\n    12→  try {\n    13→    const authHeader = req.headers.get('Authorization');\n    14→    if (!authHeader?.startsWith('Bearer ')) {\n    15→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    16→        status: 401,\n    17→        headers: { 'Content-Type': 'application/json' },\n    18→      });\n    19→    }\n    20→\n    21→    const token = authHeader.slice(7);\n    22→    const sql = getSql();\n    23→\n    24→    const sessions = await sql`\n    25→      SELECT s.member_id, m.name, m.email\n    26→      FROM sessions s\n    27→      JOIN members m ON m.id = s.member_id\n    28→      WHERE s.token = ${token} AND s.expires_at > NOW()\n    29→    `;\n    30→    const session = sessions[0];\n    31→\n    32→    if (!session) {\n    33→      return new Response(JSON.stringify({ error: 'Session expired' }), {\n    34→        status: 401,\n    35→        headers: { 'Content-Type': 'application/json' },\n    36→      });\n    37→    }\n    38→\n    39→    return new Response(JSON.stringify({\n    40→      user: {\n    41→        id: session.member_id,\n    42→        name: session.name,\n    43→        email: session.email,\n    44→      },\n    45→    }), {\n    46→      status: 200,\n    47→      headers: { 'Content-Type': 'application/json' },\n    48→    });\n    49→  } catch (err) {\n    50→    console.error('Auth check error:', err);\n    51→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n    52→      status: 500,\n    53→      headers: { 'Content-Type': 'application/json' },\n    54→    });\n    55→  }\n    56→}\n    57→"}]},"parent_tool_use_id":"toolu_01WjMpzpkaoonEAv4tNVAEdb","session_id":"cea1a0db-f072-4eb0-98ad-c0869b93e80c","uuid":"bdc7b1b1-769b-47e0-8788-afe5faf18b4d"}
