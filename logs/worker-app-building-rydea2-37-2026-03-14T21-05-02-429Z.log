[2026-03-14T21:02:46.918Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HYQuSxmWuSQDBMURwUaS7T","type":"tool_result","content":"     1→import { neon } from '@neondatabase/serverless';\n     2→\n     3→export async function initSchema(databaseUrl: string) {\n     4→  const sql = neon(databaseUrl);\n     5→\n     6→  // Workspaces\n     7→  await sql`\n     8→    CREATE TABLE IF NOT EXISTS workspaces (\n     9→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    10→      name TEXT NOT NULL DEFAULT 'My Workspace',\n    11→      default_team_id UUID\n    12→    )\n    13→  `;\n    14→\n    15→  // Members\n    16→  await sql`\n    17→    CREATE TABLE IF NOT EXISTS members (\n    18→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    19→      name TEXT NOT NULL,\n    20→      email TEXT NOT NULL UNIQUE,\n    21→      password_hash TEXT NOT NULL,\n    22→      password_salt TEXT NOT NULL,\n    23→      role TEXT NOT NULL DEFAULT 'member',\n    24→      created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()\n    25→    )\n    26→  `;\n    27→\n    28→  // Sessions\n    29→  await sql`\n    30→    CREATE TABLE IF NOT EXISTS sessions (\n    31→      token TEXT PRIMARY KEY,\n    32→      member_id UUID NOT NULL REFERENCES members(id) ON DELETE CASCADE,\n    33→      expires_at TIMESTAMP WITH TIME ZONE NOT NULL\n    34→    )\n    35→  `;\n    36→\n    37→  // Teams\n    38→  await sql`\n    39→    CREATE TABLE IF NOT EXISTS teams (\n    40→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    41→      name TEXT NOT NULL,\n    42→      identifier TEXT NOT NULL UNIQUE,\n    43→      description TEXT\n    44→    )\n    45→  `;\n    46→\n    47→  // Add FK for workspace default_team_id after teams table exists\n    48→  await sql`\n    49→    DO $$ BEGIN\n    50→      ALTER TABLE workspaces\n    51→        ADD CONSTRAINT fk_workspaces_default_team\n    52→        FOREIGN KEY (default_team_id) REFERENCES teams(id) ON DELETE SET NULL;\n    53→    EXCEPTION WHEN duplicate_object THEN NULL;\n    54→    END $$\n    55→  `;\n    56→\n    57→  // Team members\n    58→  await sql`\n    59→    CREATE TABLE IF NOT EXISTS team_members (\n    60→      team_id UUID NOT NULL REFERENCES teams(id) ON DELETE CASCADE,\n    61→      member_id UUID NOT NULL REFERENCES members(id) ON DELETE CASCADE,\n    62→      PRIMARY KEY (team_id, member_id)\n    63→    )\n    64→  `;\n    65→\n    66→  // Labels\n    67→  await sql`\n    68→    CREATE TABLE IF NOT EXISTS labels (\n    69→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    70→      name TEXT NOT NULL UNIQUE,\n    71→      color TEXT NOT NULL\n    72→    )\n    73→  `;\n    74→\n    75→  // Projects\n    76→  await sql`\n    77→    CREATE TABLE IF NOT EXISTS projects (\n    78→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    79→      name TEXT NOT NULL,\n    80→      description TEXT,\n    81→      status TEXT NOT NULL DEFAULT 'planned',\n    82→      target_date DATE,\n    83→      lead_id UUID REFERENCES members(id) ON DELETE SET NULL,\n    84→      created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()\n    85→    )\n    86→  `;\n    87→\n    88→  // Cycles\n    89→  await sql`\n    90→    CREATE TABLE IF NOT EXISTS cycles (\n    91→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    92→      name TEXT NOT NULL,\n    93→      start_date DATE NOT NULL,\n    94→      end_date DATE NOT NULL,\n    95→      team_id UUID NOT NULL REFERENCES teams(id) ON DELETE CASCADE,\n    96→      status TEXT DEFAULT 'active'\n    97→    )\n    98→  `;\n    99→\n   100→  // Issues\n   101→  await sql`\n   102→    CREATE TABLE IF NOT EXISTS issues (\n   103→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n   104→      team_id UUID NOT NULL REFERENCES teams(id) ON DELETE CASCADE,\n   105→      title TEXT NOT NULL,\n   106→      description TEXT,\n   107→      status TEXT NOT NULL DEFAULT 'backlog',\n   108→      priority TEXT NOT NULL DEFAULT 'none',\n   109→      number INT NOT NULL,\n   110→      due_date DATE,\n   111→      assignee_id UUID REFERENCES members(id) ON DELETE SET NULL,\n   112→      project_id UUID REFERENCES projects(id) ON DELETE SET NULL,\n   113→      cycle_id UUID REFERENCES cycles(id) ON DELETE SET NULL,\n   114→      parent_id UUID REFERENCES issues(id) ON DELETE SET NULL,\n   115→      created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),\n   116→      updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()\n   117→    )\n   118→  `;\n   119→\n   120→  // Issue labels junction\n   121→  await sql`\n   122→    CREATE TABLE IF NOT EXISTS issue_labels (\n   123→      issue_id UUID NOT NULL REFERENCES issues(id) ON DELETE CASCADE,\n   124→      label_id UUID NOT NULL REFERENCES labels(id) ON DELETE CASCADE,\n   125→      PRIMARY KEY (issue_id, label_id)\n   126→    )\n   127→  `;\n   128→\n   129→  // Comments\n   130→  await sql`\n   131→    CREATE TABLE IF NOT EXISTS comments (\n   132→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n   133→      issue_id UUID NOT NULL REFERENCES issues(id) ON DELETE CASCADE,\n   134→      member_id UUID NOT NULL REFERENCES members(id) ON DELETE CASCADE,\n   135→      content TEXT NOT NULL,\n   136→      created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()\n   137→    )\n   138→  `;\n   139→\n   140→  // Activity log\n   141→  await sql`\n   142→    CREATE TABLE IF NOT EXISTS activity (\n   143→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n   144→      issue_id UUID NOT NULL REFERENCES issues(id) ON DELETE CASCADE,\n   145→      member_id UUID REFERENCES members(id) ON DELETE SET NULL,\n   146→      action TEXT NOT NULL,\n   147→      field TEXT,\n   148→      new_value TEXT,\n   149→      created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()\n   150→    )\n   151→  `;\n   152→\n   153→  // Notifications\n   154→  await sql`\n   155→    CREATE TABLE IF NOT EXISTS notifications (\n   156→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n   157→      member_id UUID NOT NULL REFERENCES members(id) ON DELETE CASCADE,\n   158→      type TEXT NOT NULL,\n   159→      message TEXT NOT NULL,\n   160→      issue_id UUID REFERENCES issues(id) ON DELETE CASCADE,\n   161→      read BOOLEAN NOT NULL DEFAULT false,\n   162→      archived BOOLEAN NOT NULL DEFAULT false,\n   163→      created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()\n   164→    )\n   165→  `;\n   166→\n   167→  // Project milestones\n   168→  await sql`\n   169→    CREATE TABLE IF NOT EXISTS project_milestones (\n   170→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n   171→      project_id UUID NOT NULL REFERENCES projects(id) ON DELETE CASCADE,\n   172→      name TEXT NOT NULL,\n   173→      target_date DATE,\n   174→      completed BOOLEAN NOT NULL DEFAULT false,\n   175→      created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()\n   176→    )\n   177→  `;\n   178→\n   179→  // Project activity\n   180→  await sql`\n   181→    CREATE TABLE IF NOT EXISTS project_activity (\n   182→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n   183→      project_id UUID NOT NULL REFERENCES projects(id) ON DELETE CASCADE,\n   184→      member_id UUID REFERENCES members(id) ON DELETE SET NULL,\n   185→      action TEXT NOT NULL,\n   186→      created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()\n   187→    )\n   188→  `;\n   189→\n   190→  // Migrations: add columns that CREATE TABLE IF NOT EXISTS can't detect\n   191→  await sql`DO $$ BEGIN ALTER TABLE issues ADD COLUMN parent_id UUID REFERENCES issues(id) ON DELETE SET NULL; EXCEPTION WHEN duplicate_column THEN NULL; END $$`;\n   192→  await sql`DO $$ BEGIN ALTER TABLE activity ADD COLUMN field TEXT; EXCEPTION WHEN duplicate_column THEN NULL; END $$`;\n   193→  await sql`DO $$ BEGIN ALTER TABLE activity ADD COLUMN new_value TEXT; EXCEPTION WHEN duplicate_column THEN NULL; END $$`;\n   194→  await sql`DO $$ BEGIN ALTER TABLE notifications ADD COLUMN archived BOOLEAN NOT NULL DEFAULT false; EXCEPTION WHEN duplicate_column THEN NULL; END $$`;\n   195→  await sql`DO $$ BEGIN ALTER TABLE members ADD COLUMN created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(); EXCEPTION WHEN duplicate_column THEN NULL; END $$`;\n   196→\n   197→  // Indexes for common queries\n   198→  await sql`CREATE INDEX IF NOT EXISTS idx_issues_team_id ON issues(team_id)`;\n   199→  await sql`CREATE INDEX IF NOT EXISTS idx_issues_assignee_id ON issues(assignee_id)`;\n   200→  await sql`CREATE INDEX IF NOT EXISTS idx_issues_project_id ON issues(project_id)`;\n   201→  await sql`CREATE INDEX IF NOT EXISTS idx_issues_cycle_id ON issues(cycle_id)`;\n   202→  await sql`CREATE INDEX IF NOT EXISTS idx_issues_parent_id ON issues(parent_id)`;\n   203→  await sql`CREATE INDEX IF NOT EXISTS idx_issue_labels_issue_id ON issue_labels(issue_id)`;\n   204→  await sql`CREATE INDEX IF NOT EXISTS idx_issue_labels_label_id ON issue_labels(label_id)`;\n   205→  await sql`CREATE INDEX IF NOT EXISTS idx_team_members_team_id ON team_members(team_id)`;\n   206→  await sql`CREATE INDEX IF NOT EXISTS idx_team_members_member_id ON team_members(member_id)`;\n   207→  await sql`CREATE INDEX IF NOT EXISTS idx_sessions_member_id ON sessions(member_id)`;\n   208→  await sql`CREATE INDEX IF NOT EXISTS idx_comments_issue_id ON comments(issue_id)`;\n   209→  await sql`CREATE INDEX IF NOT EXISTS idx_activity_issue_id ON activity(issue_id)`;\n   210→  await sql`CREATE INDEX IF NOT EXISTS idx_notifications_member_id ON notifications(member_id)`;\n   211→  await sql`CREATE INDEX IF NOT EXISTS idx_project_milestones_project_id ON project_milestones(project_id)`;\n   212→  await sql`CREATE INDEX IF NOT EXISTS idx_project_activity_project_id ON project_activity(project_id)`;\n   213→  await sql`CREATE INDEX IF NOT EXISTS idx_cycles_team_id ON cycles(team_id)`;\n   214→}\n   215→\n   216→// CLI: run schema with a database URL argument\n   217→const url = process.argv[2];\n   218→if (url) {\n   219→  initSchema(url).then(() => {\n   220→    console.log('Schema initialized successfully');\n   221→    process.exit(0);\n   222→  }).catch((err) => {\n   223→    console.error('Schema initialization failed:', err);\n   224→    process.exit(1);\n   225→  });\n   226→}\n   227→"}]},"parent_tool_use_id":"toolu_01WjMpzpkaoonEAv4tNVAEdb","session_id":"cea1a0db-f072-4eb0-98ad-c0869b93e80c","uuid":"2996059d-da4d-4f92-80cf-7a395f39f072"}
