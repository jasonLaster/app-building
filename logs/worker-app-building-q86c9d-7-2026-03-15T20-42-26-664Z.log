[2026-03-15T20:20:21.221Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M5uZr9kFh5xDGWZBUWVkri","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions'\n     2→import { getSql } from './db.js'\n     3→\n     4→export default async (request: Request, _context: Context) => {\n     5→  const sql = getSql()\n     6→  const url = new URL(request.url)\n     7→  const segments = url.pathname.split('/').filter(Boolean)\n     8→  const userIdx = segments.indexOf('users')\n     9→  const userId = userIdx >= 0 ? segments[userIdx + 1] : undefined\n    10→  const action = userIdx >= 0 ? segments[userIdx + 2] : undefined\n    11→\n    12→  const headers = { 'Content-Type': 'application/json' }\n    13→\n    14→  if (!userId) {\n    15→    return new Response(JSON.stringify({ error: 'User ID is required' }), { status: 400, headers })\n    16→  }\n    17→\n    18→  try {\n    19→  if (request.method === 'GET') {\n    20→    const result = await sql`SELECT * FROM users WHERE id = ${userId}`\n    21→    const user = result[0]\n    22→    if (!user) {\n    23→      return new Response(JSON.stringify({ error: 'User not found' }), { status: 404, headers })\n    24→    }\n    25→    return new Response(JSON.stringify(user), { status: 200, headers })\n    26→  }\n    27→\n    28→  if (request.method === 'POST' && action === 'become-host') {\n    29→    const result = await sql`\n    30→      UPDATE users SET is_host = true WHERE id = ${userId} RETURNING *\n    31→    `\n    32→    const user = result[0]\n    33→    if (!user) {\n    34→      return new Response(JSON.stringify({ error: 'User not found' }), { status: 404, headers })\n    35→    }\n    36→    return new Response(JSON.stringify(user), { status: 200, headers })\n    37→  }\n    38→\n    39→  if (request.method === 'POST' && action === 'reset-host') {\n    40→    const result = await sql`\n    41→      UPDATE users SET is_host = false WHERE id = ${userId} RETURNING *\n    42→    `\n    43→    const user = result[0]\n    44→    if (!user) {\n    45→      return new Response(JSON.stringify({ error: 'User not found' }), { status: 404, headers })\n    46→    }\n    47→    return new Response(JSON.stringify(user), { status: 200, headers })\n    48→  }\n    49→\n    50→  if (request.method === 'PUT') {\n    51→    const body = await request.json() as {\n    52→      name?: string\n    53→      bio?: string | null\n    54→      phone?: string | null\n    55→      avatar_url?: string | null\n    56→    }\n    57→\n    58→    const existing = await sql`SELECT * FROM users WHERE id = ${userId}`\n    59→    const existingUser = existing[0]\n    60→    if (!existingUser) {\n    61→      return new Response(JSON.stringify({ error: 'User not found' }), { status: 404, headers })\n    62→    }\n    63→\n    64→    const eu = existingUser as Record<string, unknown>\n    65→    const result = await sql`\n    66→      UPDATE users SET\n    67→        name = ${body.name !== undefined ? body.name : eu.name as string},\n    68→        bio = ${body.bio !== undefined ? (body.bio || null) : eu.bio as string | null},\n    69→        phone = ${body.phone !== undefined ? (body.phone || null) : eu.phone as string | null},\n    70→        avatar_url = ${body.avatar_url !== undefined ? (body.avatar_url || null) : eu.avatar_url as string | null}\n    71→      WHERE id = ${userId}\n    72→      RETURNING *\n    73→    `\n    74→    const user = result[0]\n    75→    return new Response(JSON.stringify(user), { status: 200, headers })\n    76→  }\n    77→\n    78→  return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers })\n    79→  } catch {\n    80→    return new Response(JSON.stringify({ error: 'Internal server error' }), { status: 500, headers })\n    81→  }\n    82→}\n    83→"}]},"parent_tool_use_id":null,"session_id":"7578dc23-09a2-46c9-ace4-1453e464055f","uuid":"365f4016-0eb1-4ad7-aab1-317b7aed3379","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/netlify/functions/users.ts","content":"import type { Context } from '@netlify/functions'\nimport { getSql } from './db.js'\n\nexport default async (request: Request, _context: Context) => {\n  const sql = getSql()\n  const url = new URL(request.url)\n  const segments = url.pathname.split('/').filter(Boolean)\n  const userIdx = segments.indexOf('users')\n  const userId = userIdx >= 0 ? segments[userIdx + 1] : undefined\n  const action = userIdx >= 0 ? segments[userIdx + 2] : undefined\n\n  const headers = { 'Content-Type': 'application/json' }\n\n  if (!userId) {\n    return new Response(JSON.stringify({ error: 'User ID is required' }), { status: 400, headers })\n  }\n\n  try {\n  if (request.method === 'GET') {\n    const result = await sql`SELECT * FROM users WHERE id = ${userId}`\n    const user = result[0]\n    if (!user) {\n      return new Response(JSON.stringify({ error: 'User not found' }), { status: 404, headers })\n    }\n    return new Response(JSON.stringify(user), { status: 200, headers })\n  }\n\n  if (request.method === 'POST' && action === 'become-host') {\n    const result = await sql`\n      UPDATE users SET is_host = true WHERE id = ${userId} RETURNING *\n    `\n    const user = result[0]\n    if (!user) {\n      return new Response(JSON.stringify({ error: 'User not found' }), { status: 404, headers })\n    }\n    return new Response(JSON.stringify(user), { status: 200, headers })\n  }\n\n  if (request.method === 'POST' && action === 'reset-host') {\n    const result = await sql`\n      UPDATE users SET is_host = false WHERE id = ${userId} RETURNING *\n    `\n    const user = result[0]\n    if (!user) {\n      return new Response(JSON.stringify({ error: 'User not found' }), { status: 404, headers })\n    }\n    return new Response(JSON.stringify(user), { status: 200, headers })\n  }\n\n  if (request.method === 'PUT') {\n    const body = await request.json() as {\n      name?: string\n      bio?: string | null\n      phone?: string | null\n      avatar_url?: string | null\n    }\n\n    const existing = await sql`SELECT * FROM users WHERE id = ${userId}`\n    const existingUser = existing[0]\n    if (!existingUser) {\n      return new Response(JSON.stringify({ error: 'User not found' }), { status: 404, headers })\n    }\n\n    const eu = existingUser as Record<string, unknown>\n    const result = await sql`\n      UPDATE users SET\n        name = ${body.name !== undefined ? body.name : eu.name as string},\n        bio = ${body.bio !== undefined ? (body.bio || null) : eu.bio as string | null},\n        phone = ${body.phone !== undefined ? (body.phone || null) : eu.phone as string | null},\n        avatar_url = ${body.avatar_url !== undefined ? (body.avatar_url || null) : eu.avatar_url as string | null}\n      WHERE id = ${userId}\n      RETURNING *\n    `\n    const user = result[0]\n    return new Response(JSON.stringify(user), { status: 200, headers })\n  }\n\n  return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers })\n  } catch {\n    return new Response(JSON.stringify({ error: 'Internal server error' }), { status: 500, headers })\n  }\n}\n","numLines":83,"startLine":1,"totalLines":83}}}
