       />\n    47→          {mainImage!.caption && (\n    48→            <span className=\"absolute bottom-2 left-2 bg-black/60 text-white text-xs px-2 py-1 rounded\">\n    49→              {mainImage!.caption}\n    50→            </span>\n    51→          )}\n    52→        </div>\n    53→        {thumbnails.slice(0, 4).map((img, i) => {\n    54→          const originalIndex = images.indexOf(img)\n    55→          return (\n    56→            <div\n    57→              key={img.id}\n    58→              data-testid={`thumbnail-${img.id}`}\n    59→              className={`relative cursor-pointer overflow-hidden hover:opacity-90 transition-opacity ${\n    60→                i === 1 ? 'rounded-tr-xl' : i === 3 ? 'rounded-br-xl' : ''\n    61→              }`}\n    62→              onClick={() => setMainIndex(originalIndex)}\n    63→            >\n    64→              <img\n    65→                src={img.url}\n    66→                alt={img.caption || 'Property image'}\n    67→                className=\"w-full h-full object-cover\"\n    68→              />\n    69→              {img.caption && (\n    70→                <span className=\"absolute bottom-1 left-1 bg-black/60 text-white text-[10px] px-1.5 py-0.5 rounded\">\n    71→                  {img.caption}\n    72→                </span>\n    73→              )}\n    74→            </div>\n    75→          )\n    76→        })}\n    77→      </div>\n    78→      {images.length > 5 && (\n    79→        <button className=\"absolute bottom-4 right-4 flex items-center gap-2 bg-white border border-text rounded-lg px-4 py-1.5 text-sm font-semibold text-text hover:bg-bg-secondary transition-colors cursor-pointer\">\n    80→          <Grid size={14} />\n    81→          Show all photos\n    82→        </button>\n    83→      )}\n    84→    </div>\n    85→  )\n    86→}\n    87→"}]},"parent_tool_use_id":"toolu_01L5CfgL9NasNJpJ75WRhPHX","session_id":"39b08d1b-a899-42d7-8ffa-0f5a92d0cf98","uuid":"d109fa79-8a10-44ce-a539-0555