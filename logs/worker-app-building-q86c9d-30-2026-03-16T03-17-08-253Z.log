tion CalendarMonth({\n    47→  year,\n    48→  month,\n    49→  todayStr,\n    50→  bookedRanges,\n    51→  checkIn,\n    52→  checkOut,\n    53→  onSelectDate,\n    54→}: {\n    55→  year: number\n    56→  month: number\n    57→  todayStr: string\n    58→  bookedRanges: BookedRange[]\n    59→  checkIn: string\n    60→  checkOut: string\n    61→  onSelectDate: (dateStr: string) => void\n    62→}) {\n    63→  const daysInMonth = getDaysInMonth(year, month)\n    64→  const firstDay = getFirstDayOfWeek(year, month)\n    65→\n    66→  const cells: (number | null)[] = []\n    67→  for (let i = 0; i < firstDay; i++) cells.push(null)\n    68→  for (let d = 1; d <= daysInMonth; d++) cells.push(d)\n    69→\n    70→  return (\n    71→    <div>\n    72→      <div className=\"text-center text-sm font-semibold text-text mb-3\">\n    73→        {MONTH_NAMES[month]} {year}\n    74→      </div>\n    75→      <div className=\"grid grid-cols-7 gap-0\">\n    76→        {DAY_NAMES.map((d) => (\n    77→          <div key={d} className=\"text-center text-xs font-semibold text-text-secondary py-1\">\n    78→            {d}\n    79→          </div>\n    80→        ))}\n    81→        {cells.map((day, idx) => {\n    82→          if (day === null) {\n    83→            return <div key={`empty-${idx}`} className=\"h-10\" />\n    84→          }\n    85→          const dateStr = formatDateStr(year, month, day)\n    86→          const isPast = isDateInPast(dateStr, todayStr)\n    87→          const booked = isDateBooked(dateStr, bookedRanges)\n    88→          const disabled = isPast || booked\n    89→          const isCheckIn = dateStr === checkIn\n    90→          const isCheckOut = dateStr === checkOut\n    91→          const isSelected = isCheckIn || isCheckOut\n    92→          const inRange = checkIn && checkOut && dateStr > checkIn && dateStr < checkOut\n    93→\n    94→          return (\n    95→            <button\n    96→              key={dateStr}\n    97→              data-testid={`c