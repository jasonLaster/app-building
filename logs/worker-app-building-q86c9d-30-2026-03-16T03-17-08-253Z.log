[2026-03-16T03:12:32.239Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JcrJhE6wian9Z1pFGNHX1b","type":"tool_result","content":"     1→import { useState } from 'react'\n     2→import { Wifi, Car, Tv, Flame, Wind, Waves, ShieldCheck, MapPin, Coffee, Utensils, WashingMachine, Snowflake, Check } from 'lucide-react'\n     3→import type { Amenity } from '../slices/propertiesSlice'\n     4→\n     5→interface AmenitiesListProps {\n     6→  amenities: Amenity[]\n     7→}\n     8→\n     9→const INITIAL_SHOW = 10\n    10→\n    11→// Priority amenities shown first within their category\n    12→const PRIORITY_AMENITIES = ['wifi', 'kitchen', 'pool', 'air conditioning', 'heating', 'tv', 'smoke alarm', 'beachfront']\n    13→\n    14→const iconMap: Record<string, React.ReactNode> = {\n    15→  wifi: <Wifi size={20} />,\n    16→  parking: <Car size={20} />,\n    17→  tv: <Tv size={20} />,\n    18→  heating: <Flame size={20} />,\n    19→  'air conditioning': <Snowflake size={20} />,\n    20→  pool: <Waves size={20} />,\n    21→  'smoke detector': <ShieldCheck size={20} />,\n    22→  'fire extinguisher': <ShieldCheck size={20} />,\n    23→  'first aid kit': <ShieldCheck size={20} />,\n    24→  'carbon monoxide detector': <ShieldCheck size={20} />,\n    25→  'near beach': <MapPin size={20} />,\n    26→  'near downtown': <MapPin size={20} />,\n    27→  coffee: <Coffee size={20} />,\n    28→  kitchen: <Utensils size={20} />,\n    29→  washer: <WashingMachine size={20} />,\n    30→  dryer: <Wind size={20} />,\n    31→}\n    32→\n    33→function getIcon(amenity: Amenity) {\n    34→  if (amenity.icon) {\n    35→    const mapped = iconMap[amenity.icon.toLowerCase()]\n    36→    if (mapped) return mapped\n    37→  }\n    38→  const mapped = iconMap[amenity.name.toLowerCase()]\n    39→  if (mapped) return mapped\n    40→  return <Check size={20} />\n    41→}\n    42→\n    43→export default function AmenitiesList({ amenities }: AmenitiesListProps) {\n    44→  const [showAll, setShowAll] = useState(false)\n    45→\n    46→  if (amenities.length === 0) {\n    47→    return (\n    48→      <div data-testid=\"amenities-list\" className=\"py-6 border-b border-border\">\n    49→        <h2 className=\"text-lg font-semibold text-text mb-3\">Amenities</h2>\n    50→        <p className=\"text-text-secondary\">No amenities listed</p>\n    51→      </div>\n    52→    )\n    53→  }\n    54→\n    55→  const categories = Array.from(new Set(amenities.map((a) => a.category)))\n    56→  const grouped = categories.map((cat) => ({\n    57→    category: cat,\n    58→    items: amenities.filter((a) => a.category === cat).sort((a, b) => {\n    59→      const aPri = PRIORITY_AMENITIES.indexOf(a.name.toLowerCase())\n    60→      const bPri = PRIORITY_AMENITIES.indexOf(b.name.toLowerCase())\n    61→      if (aPri !== -1 && bPri !== -1) return aPri - bPri\n    62→      if (aPri !== -1) return -1\n    63→      if (bPri !== -1) return 1\n    64→      return a.name.localeCompare(b.name)\n    65→    }),\n    66→  }))\n    67→\n    68→  let displayAmenities: Amenity[]\n    69→  if (showAll || amenities.length <= INITIAL_SHOW) {\n    70→    displayAmenities = amenities\n    71→  } else {\n    72→    // Distribute slots proportionally across categories so all are represented\n    73→    const selected = new Set<Amenity>()\n    74→    // First pass: give each category a proportional share\n    75→    let remaining = INITIAL_SHOW\n    76→    for (const g of grouped) {\n    77→      const share = Math.max(1, Math.round((g.items.length / amenities.length) * INITIAL_SHOW))\n    78→      const take = Math.min(share, g.items.length, remaining)\n    79→      for (let i = 0; i < take; i++) {\n    80→        selected.add(g.items[i]!)\n    81→      }\n    82→      remaining = INITIAL_SHOW - selected.size\n    83→    }\n    84→    // Fill any remaining slots\n    85→    for (const a of amenities) {\n    86→      if (selected.size >= INITIAL_SHOW) break\n    87→      selected.add(a)\n    88→    }\n    89→    displayAmenities = amenities.filter((a) => selected.has(a))\n    90→  }\n    91→  const displayCategories = (showAll ? grouped : grouped\n    92→        .map((g) => ({\n    93→          ...g,\n    94→          items: g.items.filter((a) => displayAmenities.includes(a)),\n    95→        }))\n    96→        .filter((g) => g.items.length > 0))\n    97→\n    98→  return (\n    99→    <div data-testid=\"amenities-list\" className=\"py-6 border-b border-border\">\n   100→      <h2 className=\"text-lg font-semibold text-text mb-4\">Amenities</h2>\n   101→      <div className=\"space-y-4\">\n   102→        {displayCategories.map((group) => (\n   103→          <div key={group.category}>\n   104→            <h3 className=\"text-sm font-semibold text-text-secondary uppercase tracking-wide mb-2\">\n   105→              {group.category}\n   106→            </h3>\n   107→            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2\">\n   108→              {group.items.map((amenity) => (\n   109→                <div\n   110→                  key={amenity.id}\n   111→                  data-testid={`amenity-${amenity.id}`}\n   112→                  className=\"flex items-center gap-3 text-text-secondary py-1\"\n   113→                >\n   114→                  <span className=\"text-text-secondary\">{getIcon(amenity)}</span>\n   115→                  <span>{amenity.name}</span>\n   116→                </div>\n   117→              ))}\n   118→            </div>\n   119→          </div>\n   120→        ))}\n   121→      </div>\n   122→      {amenities.length > INITIAL_SHOW && (\n   123→        <button\n   124→          data-testid=\"amenities-toggle\"\n   125→          className=\"mt-4 font-semibold text-text underline cursor-pointer\"\n   126→          onClick={() => setShowAll(!showAll)}\n   127→        >\n   128→          {showAll ? 'Show less' : `Show all ${amenities.length} amenities`}\n   129→        </button>\n   130→      )}\n   131→    </div>\n   132→  )\n   133→}\n   134→"}]},"parent_tool_use_id":"toolu_01L5CfgL9NasNJpJ75WRhPHX","session_id":"39b08d1b-a899-42d7-8ffa-0f5a92d0cf98","uuid":"fcd58f1d-6255-48a3-a785-13e64aac5b13"}
