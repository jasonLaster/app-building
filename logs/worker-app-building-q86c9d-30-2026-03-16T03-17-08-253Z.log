[2026-03-16T03:12:51.599Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DGjLyr6Y3KxSvDuAxeVd94","type":"tool_result","content":"     1→import { useState, useEffect, useCallback, useRef } from 'react'\n     2→import { useSelector, useDispatch } from 'react-redux'\n     3→import { useNavigate } from 'react-router-dom'\n     4→import { ChevronLeft, ChevronRight, ChevronDown } from 'lucide-react'\n     5→import type { RootState, AppDispatch } from '../store'\n     6→import type { Property } from '../slices/propertiesSlice'\n     7→import { createBooking, clearBookingError } from '../slices/bookingsSlice'\n     8→\n     9→interface BookingCardProps {\n    10→  property: Property\n    11→}\n    12→\n    13→interface BookedRange {\n    14→  check_in: string\n    15→  check_out: string\n    16→}\n    17→\n    18→function getDaysInMonth(year: number, month: number): number {\n    19→  return new Date(year, month + 1, 0).getDate()\n    20→}\n    21→\n    22→function getFirstDayOfWeek(year: number, month: number): number {\n    23→  return new Date(year, month, 1).getDay()\n    24→}\n    25→\n    26→function formatDateStr(year: number, month: number, day: number): string {\n    27→  return `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`\n    28→}\n    29→\n    30→function isDateBooked(dateStr: string, bookedRanges: BookedRange[]): boolean {\n    31→  for (const range of bookedRanges) {\n    32→    if (dateStr >= range.check_in && dateStr < range.check_out) {\n    33→      return true\n    34→    }\n    35→  }\n    36→  return false\n    37→}\n    38→\n    39→function isDateInPast(dateStr: string, todayStr: string): boolean {\n    40→  return dateStr < todayStr\n    41→}\n    42→\n    43→const MONTH_NAMES = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']\n    44→const DAY_NAMES = ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa']\n    45→\n    46→function CalendarMonth({\n    47→  year,\n    48→  month,\n    49→  todayStr,\n    50→  bookedRanges,\n    51→  checkIn,\n    52→  checkOut,\n    53→  onSelectDate,\n    54→}: {\n    55→  year: number\n    56→  month: number\n    57→  todayStr: string\n    58→  bookedRanges: BookedRange[]\n    59→  checkIn: string\n    60→  checkOut: string\n    61→  onSelectDate: (dateStr: string) => void\n    62→}) {\n    63→  const daysInMonth = getDaysInMonth(year, month)\n    64→  const firstDay = getFirstDayOfWeek(year, month)\n    65→\n    66→  const cells: (number | null)[] = []\n    67→  for (let i = 0; i < firstDay; i++) cells.push(null)\n    68→  for (let d = 1; d <= daysInMonth; d++) cells.push(d)\n    69→\n    70→  return (\n    71→    <div>\n    72→      <div className=\"text-center text-sm font-semibold text-text mb-3\">\n    73→        {MONTH_NAMES[month]} {year}\n    74→      </div>\n    75→      <div className=\"grid grid-cols-7 gap-0\">\n    76→        {DAY_NAMES.map((d) => (\n    77→          <div key={d} className=\"text-center text-xs font-semibold text-text-secondary py-1\">\n    78→            {d}\n    79→          </div>\n    80→        ))}\n    81→        {cells.map((day, idx) => {\n    82→          if (day === null) {\n    83→            return <div key={`empty-${idx}`} className=\"h-10\" />\n    84→          }\n    85→          const dateStr = formatDateStr(year, month, day)\n    86→          const isPast = isDateInPast(dateStr, todayStr)\n    87→          const booked = isDateBooked(dateStr, bookedRanges)\n    88→          const disabled = isPast || booked\n    89→          const isCheckIn = dateStr === checkIn\n    90→          const isCheckOut = dateStr === checkOut\n    91→          const isSelected = isCheckIn || isCheckOut\n    92→          const inRange = checkIn && checkOut && dateStr > checkIn && dateStr < checkOut\n    93→\n    94→          return (\n    95→            <button\n    96→              key={dateStr}\n    97→              data-testid={`calendar-day-${dateStr}`}\n    98→              disabled={disabled}\n    99→              onClick={() => !disabled && onSelectDate(dateStr)}\n   100→              className={`h-10 w-full text-sm rounded-full transition-colors cursor-pointer\n   101→                ${disabled ? 'text-border line-through cursor-not-allowed' : 'hover:bg-bg-secondary text-text'}\n   102→                ${isSelected ? 'bg-text text-white hover:bg-text' : ''}\n   103→                ${inRange ? 'bg-bg-secondary' : ''}\n   104→                ${booked ? 'bg-bg-secondary' : ''}\n   105→              `}\n   106→            >\n   107→              {day}\n   108→            </button>\n   109→          )\n   110→        })}\n   111→      </div>\n   112→    </div>\n   113→  )\n   114→}\n   115→\n   116→export default function BookingCard({ property }: BookingCardProps) {\n   117→  const dispatch = useDispatch<AppDispatch>()\n   118→  const navigate = useNavigate()\n   119→  const currentUser = useSelector((state: RootState) => state.auth.currentUser)\n   120→  const { loading, error } = useSelector((state: RootState) => state.bookings)\n   121→\n   122→  const [checkIn, setCheckIn] = useState('')\n   123→  const [checkOut, setCheckOut] = useState('')\n   124→  const [guests, setGuests] = useState(1)\n   125→  const [success, setSuccess] = useState(false)\n   126→  const [calendarOpen, setCalendarOpen] = useState(false)\n   127→  const [bookedRanges, setBookedRanges] = useState<BookedRange[]>([])\n   128→\n   129→  const now = new Date()\n   130→  const todayStr = formatDateStr(now.getFullYear(), now.getMonth(), now.getDate())\n   131→  const [calMonth, setCalMonth] = useState(now.getMonth())\n   132→  const [calYear, setCalYear] = useState(now.getFullYear())\n   133→  const [guestDropdownOpen, setGuestDropdownOpen] = useState(false)\n   134→  const guestDropdownRef = useRef<HTMLDivElement>(null)\n   135→\n   136→  useEffect(() => {\n   137→    function handleClickOutside(e: MouseEvent) {\n   138→      if (guestDropdownRef.current && !guestDropdownRef.current.contains(e.target as Node)) {\n   139→        setGuestDropdownOpen(false)\n   140→      }\n   141→    }\n   142→    document.addEventListener('mousedown', handleClickOutside)\n   143→    return () => document.removeEventListener('mousedown', handleClickOutside)\n   144→  }, [])\n   145→\n   146→  const isOwnProperty = currentUser?.id === property.host_id\n   147→\n   148→  useEffect(() => {\n   149→    fetch(`/api/bookings?property_id=${property.id}`)\n   150→      .then((r) => r.json())\n   151→      .then((data) => {\n   152→        if (Array.isArray(data)) {\n   153→          setBookedRanges(data.map((b: { check_in: string; check_out: string }) => ({\n   154→            check_in: b.check_in.slice(0, 10),\n   155→            check_out: b.check_out.slice(0, 10),\n   156→          })))\n   157→        }\n   158→      })\n   159→      .catch(() => {})\n   160→  }, [property.id])\n   161→\n   162→  const handleSelectDate = useCallback((dateStr: string) => {\n   163→    if (!checkIn || (checkIn && checkOut)) {\n   164→      setCheckIn(dateStr)\n   165→      setCheckOut('')\n   166→    } else {\n   167→      if (dateStr <= checkIn) {\n   168→        setCheckIn(dateStr)\n   169→        setCheckOut('')\n   170→      } else {\n   171→        // Check if any booked date is between checkIn and this date\n   172→        const hasBlockedInRange = bookedRanges.some(\n   173→          (r) => r.check_in < dateStr && r.check_out > checkIn\n   174→        )\n   175→        if (hasBlockedInRange) {\n   176→          setCheckIn(dateStr)\n   177→          setCheckOut('')\n   178→        } else {\n   179→          setCheckOut(dateStr)\n   180→        }\n   181→      }\n   182→    }\n   183→  }, [checkIn, checkOut, bookedRanges])\n   184→\n   185→  const handlePrevMonth = () => {\n   186→    if (calMonth === 0) {\n   187→      setCalMonth(11)\n   188→      setCalYear(calYear - 1)\n   189→    } else {\n   190→      setCalMonth(calMonth - 1)\n   191→    }\n   192→  }\n   193→\n   194→  const handleNextMonth = () => {\n   195→    if (calMonth === 11) {\n   196→      setCalMonth(0)\n   197→      setCalYear(calYear + 1)\n   198→    } else {\n   199→      setCalMonth(calMonth + 1)\n   200→    }\n   201→  }\n   202→\n   203→  const nextMonth = calMonth === 11 ? 0 : calMonth + 1\n   204→  const nextYear = calMonth === 11 ? calYear + 1 : calYear\n   205→\n   206→  const nights =\n   207→    checkIn && checkOut\n   208→      ? Math.max(0, Math.round((new Date(checkOut).getTime() - new Date(checkIn).getTime()) / (1000 * 60 * 60 * 24)))\n   209→      : 0\n   210→\n   211→  const nightlyTotal = nights * Number(property.price_per_night)\n   212→  const cleaningFee = Number(property.cleaning_fee)\n   213→  const total = nightlyTotal + cleaningFee\n   214→\n   215→  const canReserve = checkIn && checkOut && nights > 0 && !isOwnProperty && currentUser && !loading\n   216→\n   217→  const handleReserve = async () => {\n   218→    if (!currentUser) {\n   219→      navigate('/login')\n   220→      return\n   221→    }\n   222→    if (!checkIn || !checkOut || isOwnProperty) return\n   223→\n   224→    dispatch(clearBookingError())\n   225→    const result = await dispatch(\n   226→      createBooking({\n   227→        property_id: property.id,\n   228→        guest_id: currentUser.id,\n   229→        check_in: checkIn,\n   230→        check_out: checkOut,\n   231→        num_guests: guests,\n   232→        total_price: total,\n   233→      })\n   234→    )\n   235→    if (createBooking.fulfilled.match(result)) {\n   236→      setSuccess(true)\n   237→      setTimeout(() => navigate('/trips'), 1500)\n   238→    }\n   239→  }\n   240→\n   241→  const formatDisplayDate = (d: string) => {\n   242→    if (!d) return ''\n   243→    const date = new Date(d + 'T00:00:00')\n   244→    return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })\n   245→  }\n   246→\n   247→  return (\n   248→    <div data-testid=\"booking-card\" className=\"border border-border rounded-xl p-6 shadow-lg sticky top-[96px]\">\n   249→      {nights > 0 ? (\n   250→        <div className=\"flex items-baseline gap-1 mb-5\">\n   251→          <span className=\"text-[22px] font-semibold text-text\">${Number(property.price_per_night).toFixed(0)}</span>\n   252→          <span className=\"text-text-secondary\">night</span>\n   253→        </div>\n   254→      ) : (\n   255→        <p className=\"text-[22px] font-semibold text-text mb-5\">Add dates for prices</p>\n   256→      )}\n   257→\n   258→      <div className=\"border border-border rounded-lg overflow-hidden mb-4\">\n   259→        <div className=\"grid grid-cols-2 cursor-pointer\" onClick={() => setCalendarOpen(!calendarOpen)}>\n   260→          <div className=\"p-3 border-r border-border\">\n   261→            <label className=\"block text-[10px] font-bold text-text uppercase tracking-wide\">Check-in</label>\n   262→            <p data-testid=\"booking-checkin\" className=\"text-sm text-text-secondary mt-0.5\">\n   263→              {checkIn ? formatDisplayDate(checkIn) : 'Add date'}\n   264→            </p>\n   265→          </div>\n   266→          <div className=\"p-3\">\n   267→            <label className=\"block text-[10px] font-bold text-text uppercase tracking-wide\">Checkout</label>\n   268→            <p data-testid=\"booking-checkout\" className=\"text-sm text-text-secondary mt-0.5\">\n   269→              {checkOut ? formatDisplayDate(checkOut) : 'Add date'}\n   270→            </p>\n   271→          </div>\n   272→        </div>\n   273→        <div className=\"border-t border-border p-3 relative\" ref={guestDropdownRef}>\n   274→          <label className=\"block text-[10px] font-bold text-text uppercase tracking-wide\">Guests</label>\n   275→          <button\n   276→            data-testid=\"booking-guests\"\n   277→            data-value={String(guests)}\n   278→            type=\"button\"\n   279→            onClick={() => setGuestDropdownOpen(!guestDropdownOpen)}\n   280→            className=\"w-full flex items-center justify-between text-sm text-text bg-transparent outline-none mt-0.5 cursor-pointer\"\n   281→          >\n   282→            <span>{guests} {guests === 1 ? 'guest' : 'guests'}</span>\n   283→            <ChevronDown size={16} className={`transition-transform ${guestDropdownOpen ? 'rotate-180' : ''}`} />\n   284→          </button>\n   285→          {guestDropdownOpen && (\n   286→            <div data-testid=\"booking-guests-dropdown\" className=\"absolute left-0 right-0 top-full mt-1 bg-bg border border-border rounded-lg shadow-lg z-50 max-h-48 overflow-y-auto\">\n   287→              {Array.from({ length: property.max_guests }, (_, i) => i + 1).map((n) => (\n   288→                <button\n   289→                  key={n}\n   290→                  data-testid={`guest-option-${n}`}\n   291→                  type=\"button\"\n   292→                  onClick={() => { setGuests(n); setGuestDropdownOpen(false) }}\n   293→                  className={`w-full text-left px-3 py-2 text-sm cursor-pointer transition-colors\n   294→                    ${guests === n ? 'bg-bg-secondary font-semibold text-text' : 'text-text hover:bg-bg-secondary'}\n   295→                  `}\n   296→                >\n   297→                  {n} {n === 1 ? 'guest' : 'guests'}\n   298→                </button>\n   299→              ))}\n   300→            </div>\n   301→          )}\n   302→        </div>\n   303→      </div>\n   304→\n   305→      {calendarOpen && (\n   306→        <div className=\"mb-4 border border-border rounded-xl p-4 bg-bg shadow-sm\">\n   307→          <div className=\"mb-3\">\n   308→            <h3 className=\"text-base font-semibold text-text\">Select dates</h3>\n   309→            <p className=\"text-xs text-text-secondary\">Add your travel dates for exact pricing</p>\n   310→          </div>\n   311→          <div className=\"flex items-center justify-between mb-2\">\n   312→            <button\n   313→              data-testid=\"calendar-prev-month\"\n   314→              onClick={handlePrevMonth}\n   315→              className=\"p-1 rounded-full hover:bg-bg-secondary cursor-pointer\"\n   316→            >\n   317→              <ChevronLeft size={20} />\n   318→            </button>\n   319→            <div />\n   320→            <button\n   321→              data-testid=\"calendar-next-month\"\n   322→              onClick={handleNextMonth}\n   323→              className=\"p-1 rounded-full hover:bg-bg-secondary cursor-pointer\"\n   324→            >\n   325→              <ChevronRight size={20} />\n   326→            </button>\n   327→          </div>\n   328→          <div className=\"grid grid-cols-2 gap-6\">\n   329→            <CalendarMonth\n   330→              year={calYear}\n   331→              month={calMonth}\n   332→              todayStr={todayStr}\n   333→              bookedRanges={bookedRanges}\n   334→              checkIn={checkIn}\n   335→              checkOut={checkOut}\n   336→              onSelectDate={handleSelectDate}\n   337→            />\n   338→            <CalendarMonth\n   339→              year={nextYear}\n   340→              month={nextMonth}\n   341→              todayStr={todayStr}\n   342→              bookedRanges={bookedRanges}\n   343→              checkIn={checkIn}\n   344→              checkOut={checkOut}\n   345→              onSelectDate={handleSelectDate}\n   346→            />\n   347→          </div>\n   348→          <div className=\"flex items-center justify-end gap-3 mt-4 pt-3 border-t border-border\">\n   349→            <button\n   350→              onClick={() => { setCheckIn(''); setCheckOut('') }}\n   351→              className=\"text-sm font-semibold text-text underline hover:no-underline cursor-pointer\"\n   352→            >\n   353→              Clear dates\n   354→            </button>\n   355→            <button\n   356→              onClick={() => setCalendarOpen(false)}\n   357→              className=\"text-sm font-semibold text-white bg-text rounded-lg px-4 py-2 hover:opacity-90 cursor-pointer\"\n   358→            >\n   359→              Close\n   360→            </button>\n   361→          </div>\n   362→        </div>\n   363→      )}\n   364→\n   365→      {nights > 0 && (\n   366→        <div data-testid=\"price-breakdown\" className=\"mb-4 space-y-2 text-sm\">\n   367→          <div className=\"flex justify-between text-text-secondary\">\n   368→            <span className=\"underline\">${Number(property.price_per_night).toFixed(0)} x {nights} {nights === 1 ? 'night' : 'nights'}</span>\n   369→            <span>${nightlyTotal.toFixed(0)}</span>\n   370→          </div>\n   371→          <div className=\"flex justify-between text-text-secondary\">\n   372→            <span className=\"underline\">Cleaning fee</span>\n   373→            <span>${cleaningFee.toFixed(0)}</span>\n   374→          </div>\n   375→          <div className=\"flex justify-between font-semibold text-text pt-3 border-t border-border\">\n   376→            <span>Total</span>\n   377→            <span>${total.toFixed(0)}</span>\n   378→          </div>\n   379→        </div>\n   380→      )}\n   381→\n   382→      {isOwnProperty ? (\n   383→        <p data-testid=\"own-property-message\" className=\"text-center text-text-secondary text-sm mb-2\">\n   384→          You cannot book your own property\n   385→        </p>\n   386→      ) : !currentUser ? (\n   387→        <button\n   388→          data-testid=\"booking-login-prompt\"\n   389→          className=\"w-full py-3 rounded-lg bg-gradient-to-r from-primary to-[#E61E4D] text-white font-semibold hover:opacity-95 transition-opacity cursor-pointer text-base\"\n   390→          onClick={() => navigate('/login')}\n   391→        >\n   392→          Log in to reserve\n   393→        </button>\n   394→      ) : (\n   395→        <button\n   396→          data-testid=\"reserve-button\"\n   397→          className=\"w-full py-3 rounded-lg bg-gradient-to-r from-primary to-[#E61E4D] text-white font-semibold hover:opacity-95 transition-opacity disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer text-base\"\n   398→          disabled={!canReserve}\n   399→          onClick={handleReserve}\n   400→        >\n   401→          {loading ? 'Reserving...' : 'Reserve'}\n   402→        </button>\n   403→      )}\n   404→\n   405→      {!checkIn && !checkOut && currentUser && !isOwnProperty && (\n   406→        <p className=\"text-center text-text-secondary text-xs mt-3\">You won't be charged yet</p>\n   407→      )}\n   408→\n   409→      {error && (\n   410→        <p data-testid=\"booking-error\" className=\"text-error text-sm mt-2 text-center\">{error}</p>\n   411→      )}\n   412→\n   413→      {success && (\n   414→        <p data-testid=\"booking-success\" className=\"text-success text-sm mt-2 text-center font-semibold\">\n   415→          Booking confirmed! Redirecting...\n   416→        </p>\n   417→      )}\n   418→    </div>\n   419→  )\n   420→}\n   421→"}]},"parent_tool_use_id":null,"session_id":"39b08d1b-a899-42d7-8ffa-0f5a92d0cf98","uuid":"877deb5b-8f10-4038-b3c4-ceeb4af6fd72","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/components/BookingCard.tsx","content":"import { useState, useEffect, useCallback, useRef } from 'react'\nimport { useSelector, useDispatch } from 'react-redux'\nimport { useNavigate } from 'react-router-dom'\nimport { ChevronLeft, ChevronRight, ChevronDown } from 'lucide-react'\nimport type { RootState, AppDispatch } from '../store'\nimport type { Property } from '../slices/propertiesSlice'\nimport { createBooking, clearBookingError } from '../slices/bookingsSlice'\n\ninterface BookingCardProps {\n  property: Property\n}\n\ninterface BookedRange {\n  check_in: string\n  check_out: string\n}\n\nfunction getDaysInMonth(year: number, month: number): number {\n  return new Date(year, month + 1, 0).getDate()\n}\n\nfunction getFirstDayOfWeek(year: number, month: number): number {\n  return new Date(year, month, 1).getDay()\n}\n\nfunction formatDateStr(year: number, month: number, day: number): string {\n  return `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`\n}\n\nfunction isDateBooked(dateStr: string, bookedRanges: BookedRange[]): boolean {\n  for (const range of bookedRanges) {\n    if (dateStr >= range.check_in && dateStr < range.check_out) {\n      return true\n    }\n  }\n  return false\n}\n\nfunction isDateInPast(dateStr: string, todayStr: string): boolean {\n  return dateStr < todayStr\n}\n\nconst MONTH_NAMES = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']\nconst DAY_NAMES = ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa']\n\nfunction CalendarMonth({\n  year,\n  month,\n  todayStr,\n  bookedRanges,\n  checkIn,\n  checkOut,\n  onSelectDate,\n}: {\n  year: number\n  month: number\n  todayStr: string\n  bookedRanges: BookedRange[]\n  checkIn: string\n  checkOut: string\n  onSelectDate: (dateStr: string) => void\n}) {\n  const daysInMonth = getDaysInMonth(year, month)\n  const firstDay = getFirstDayOfWeek(year, month)\n\n  const cells: (number | null)[] = []\n  for (let i = 0; i < firstDay; i++) cells.push(null)\n  for (let d = 1; d <= daysInMonth; d++) cells.push(d)\n\n  return (\n    <div>\n      <div className=\"text-center text-sm font-semibold text-text mb-3\">\n        {MONTH_NAMES[month]} {year}\n      </div>\n      <div className=\"grid grid-cols-7 gap-0\">\n        {DAY_NAMES.map((d) => (\n          <div key={d} className=\"text-center text-xs font-semibold text-text-secondary py-1\">\n            {d}\n          </div>\n        ))}\n        {cells.map((day, idx) => {\n          if (day === null) {\n            return <div key={`empty-${idx}`} className=\"h-10\" />\n          }\n          const dateStr = formatDateStr(year, month, day)\n          const isPast = isDateInPast(dateStr, todayStr)\n          const booked = isDateBooked(dateStr, bookedRanges)\n          const disabled = isPast || booked\n          const isCheckIn = dateStr === checkIn\n          const isCheckOut = dateStr === checkOut\n          const isSelected = isCheckIn || isCheckOut\n          const inRange = checkIn && checkOut && dateStr > checkIn && dateStr < checkOut\n\n          return (\n            <button\n              key={dateStr}\n              data-testid={`calendar-day-${dateStr}`}\n              disabled={disabled}\n              onClick={() => !disabled && onSelectDate(dateStr)}\n              className={`h-10 w-full text-sm rounded-full transition-colors cursor-pointer\n                ${disabled ? 'text-border line-through cursor-not-allowed' : 'hover:bg-bg-secondary text-text'}\n                ${isSelected ? 'bg-text text-white hover:bg-text' : ''}\n                ${inRange ? 'bg-bg-secondary' : ''}\n                ${booked ? 'bg-bg-secondary' : ''}\n              `}\n            >\n              {day}\n            </button>\n          )\n        })}\n      </div>\n    </div>\n  )\n}\n\nexport default function BookingCard({ property }: BookingCardProps) {\n  const dispatch = useDispatch<AppDispatch>()\n  const navigate = useNavigate()\n  const currentUser = useSelector((state: RootState) => state.auth.currentUser)\n  const { loading, error } = useSelector((state: RootState) => state.bookings)\n\n  const [checkIn, setCheckIn] = useState('')\n  const [checkOut, setCheckOut] = useState('')\n  const [guests, setGuests] = useState(1)\n  const [success, setSuccess] = useState(false)\n  const [calendarOpen, setCalendarOpen] = useState(false)\n  const [bookedRanges, setBookedRanges] = useState<BookedRange[]>([])\n\n  const now = new Date()\n  const todayStr = formatDateStr(now.getFullYear(), now.getMonth(), now.getDate())\n  const [calMonth, setCalMonth] = useState(now.getMonth())\n  const [calYear, setCalYear] = useState(now.getFullYear())\n  const [guestDropdownOpen, setGuestDropdownOpen] = useState(false)\n  const guestDropdownRef = useRef<HTMLDivElement>(null)\n\n  useEffect(() => {\n    function handleClickOutside(e: MouseEvent) {\n      if (guestDropdownRef.current && !guestDropdownRef.current.contains(e.target as Node)) {\n        setGuestDropdownOpen(false)\n      }\n    }\n    document.addEventListener('mousedown', handleClickOutside)\n    return () => document.removeEventListener('mousedown', handleClickOutside)\n  }, [])\n\n  const isOwnProperty = currentUser?.id === property.host_id\n\n  useEffect(() => {\n    fetch(`/api/bookings?property_id=${property.id}`)\n      .then((r) => r.json())\n      .then((data) => {\n        if (Array.isArray(data)) {\n          setBookedRanges(data.map((b: { check_in: string; check_out: string }) => ({\n            check_in: b.check_in.slice(0, 10),\n            check_out: b.check_out.slice(0, 10),\n          })))\n        }\n      })\n      .catch(() => {})\n  }, [property.id])\n\n  const handleSelectDate = useCallback((dateStr: string) => {\n    if (!checkIn || (checkIn && checkOut)) {\n      setCheckIn(dateStr)\n      setCheckOut('')\n    } else {\n      if (dateStr <= checkIn) {\n        setCheckIn(dateStr)\n        setCheckOut('')\n      } else {\n        // Check if any booked date is between checkIn and this date\n        const hasBlockedInRange = bookedRanges.some(\n          (r) => r.check_in < dateStr && r.check_out > checkIn\n        )\n        if (hasBlockedInRange) {\n          setCheckIn(dateStr)\n          setCheckOut('')\n        } else {\n          setCheckOut(dateStr)\n        }\n      }\n    }\n  }, [checkIn, checkOut, bookedRanges])\n\n  const handlePrevMonth = () => {\n    if (calMonth === 0) {\n      setCalMonth(11)\n      setCalYear(calYear - 1)\n    } else {\n      setCalMonth(calMonth - 1)\n    }\n  }\n\n  const handleNextMonth = () => {\n    if (calMonth === 11) {\n      setCalMonth(0)\n      setCalYear(calYear + 1)\n    } else {\n      setCalMonth(calMonth + 1)\n    }\n  }\n\n  const nextMonth = calMonth === 11 ? 0 : calMonth + 1\n  const nextYear = calMonth === 11 ? calYear + 1 : calYear\n\n  const nights =\n    checkIn && checkOut\n      ? Math.max(0, Math.round((new Date(checkOut).getTime() - new Date(checkIn).getTime()) / (1000 * 60 * 60 * 24)))\n      : 0\n\n  const nightlyTotal = nights * Number(property.price_per_night)\n  const cleaningFee = Number(property.cleaning_fee)\n  const total = nightlyTotal + cleaningFee\n\n  const canReserve = checkIn && checkOut && nights > 0 && !isOwnProperty && currentUser && !loading\n\n  const handleReserve = async () => {\n    if (!currentUser) {\n      navigate('/login')\n      return\n    }\n    if (!checkIn || !checkOut || isOwnProperty) return\n\n    dispatch(clearBookingError())\n    const result = await dispatch(\n      createBooking({\n        property_id: property.id,\n        guest_id: currentUser.id,\n        check_in: checkIn,\n        check_out: checkOut,\n        num_guests: guests,\n        total_price: total,\n      })\n    )\n    if (createBooking.fulfilled.match(result)) {\n      setSuccess(true)\n      setTimeout(() => navigate('/trips'), 1500)\n    }\n  }\n\n  const formatDisplayDate = (d: string) => {\n    if (!d) return ''\n    const date = new Date(d + 'T00:00:00')\n    return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })\n  }\n\n  return (\n    <div data-testid=\"booking-card\" className=\"border border-border rounded-xl p-6 shadow-lg sticky top-[96px]\">\n      {nights > 0 ? (\n        <div className=\"flex items-baseline gap-1 mb-5\">\n          <span className=\"text-[22px] font-semibold text-text\">${Number(property.price_per_night).toFixed(0)}</span>\n          <span className=\"text-text-secondary\">night</span>\n        </div>\n      ) : (\n        <p className=\"text-[22px] font-semibold text-text mb-5\">Add dates for prices</p>\n      )}\n\n      <div className=\"border border-border rounded-lg overflow-hidden mb-4\">\n        <div className=\"grid grid-cols-2 cursor-pointer\" onClick={() => setCalendarOpen(!calendarOpen)}>\n          <div className=\"p-3 border-r border-border\">\n            <label className=\"block text-[10px] font-bold text-text uppercase tracking-wide\">Check-in</label>\n            <p data-testid=\"booking-checkin\" className=\"text-sm text-text-secondary mt-0.5\">\n              {checkIn ? formatDisplayDate(checkIn) : 'Add date'}\n            </p>\n          </div>\n          <div className=\"p-3\">\n            <label className=\"block text-[10px] font-bold text-text uppercase tracking-wide\">Checkout</label>\n            <p data-testid=\"booking-checkout\" className=\"text-sm text-text-secondary mt-0.5\">\n              {checkOut ? formatDisplayDate(checkOut) : 'Add date'}\n            </p>\n          </div>\n        </div>\n        <div className=\"border-t border-border p-3 relative\" ref={guestDropdownRef}>\n          <label className=\"block text-[10px] font-bold text-text uppercase tracking-wide\">Guests</label>\n          <button\n            data-testid=\"booking-guests\"\n            data-value={String(guests)}\n            type=\"button\"\n            onClick={() => setGuestDropdownOpen(!guestDropdownOpen)}\n            className=\"w-full flex items-center justify-between text-sm text-text bg-transparent outline-none mt-0.5 cursor-pointer\"\n          >\n            <span>{guests} {guests === 1 ? 'guest' : 'guests'}</span>\n            <ChevronDown size={16} className={`transition-transform ${guestDropdownOpen ? 'rotate-180' : ''}`} />\n          </button>\n          {guestDropdownOpen && (\n            <div data-testid=\"booking-guests-dropdown\" className=\"absolute left-0 right-0 top-full mt-1 bg-bg border border-border rounded-lg shadow-lg z-50 max-h-48 overflow-y-auto\">\n              {Array.from({ length: property.max_guests }, (_, i) => i + 1).map((n) => (\n                <button\n                  key={n}\n                  data-testid={`guest-option-${n}`}\n                  type=\"button\"\n                  onClick={() => { setGuests(n); setGuestDropdownOpen(false) }}\n                  className={`w-full text-left px-3 py-2 text-sm cursor-pointer transition-colors\n                    ${guests === n ? 'bg-bg-secondary font-semibold text-text' : 'text-text hover:bg-bg-secondary'}\n                  `}\n                >\n                  {n} {n === 1 ? 'guest' : 'guests'}\n                </button>\n              ))}\n            </div>\n          )}\n        </div>\n      </div>\n\n      {calendarOpen && (\n        <div className=\"mb-4 border border-border rounded-xl p-4 bg-bg shadow-sm\">\n          <div className=\"mb-3\">\n            <h3 className=\"text-base font-semibold text-text\">Select dates</h3>\n            <p className=\"text-xs text-text-secondary\">Add your travel dates for exact pricing</p>\n          </div>\n          <div className=\"flex items-center justify-between mb-2\">\n            <button\n              data-testid=\"calendar-prev-month\"\n              onClick={handlePrevMonth}\n              className=\"p-1 rounded-full hover:bg-bg-secondary cursor-pointer\"\n            >\n              <ChevronLeft size={20} />\n            </button>\n            <div />\n            <button\n              data-testid=\"calendar-next-month\"\n              onClick={handleNextMonth}\n              className=\"p-1 rounded-full hover:bg-bg-secondary cursor-pointer\"\n            >\n              <ChevronRight size={20} />\n            </button>\n          </div>\n          <div className=\"grid grid-cols-2 gap-6\">\n            <CalendarMonth\n              year={calYear}\n              month={calMonth}\n              todayStr={todayStr}\n              bookedRanges={bookedRanges}\n              checkIn={checkIn}\n              checkOut={checkOut}\n              onSelectDate={handleSelectDate}\n            />\n            <CalendarMonth\n              year={nextYear}\n              month={nextMonth}\n              todayStr={todayStr}\n              bookedRanges={bookedRanges}\n              checkIn={checkIn}\n              checkOut={checkOut}\n              onSelectDate={handleSelectDate}\n            />\n          </div>\n          <div className=\"flex items-center justify-end gap-3 mt-4 pt-3 border-t border-border\">\n            <button\n              onClick={() => { setCheckIn(''); setCheckOut('') }}\n              className=\"text-sm font-semibold text-text underline hover:no-underline cursor-pointer\"\n            >\n              Clear dates\n            </button>\n            <button\n              onClick={() => setCalendarOpen(false)}\n              className=\"text-sm font-semibold text-white bg-text rounded-lg px-4 py-2 hover:opacity-90 cursor-pointer\"\n            >\n              Close\n            </button>\n          </div>\n        </div>\n      )}\n\n      {nights > 0 && (\n        <div data-testid=\"price-breakdown\" className=\"mb-4 space-y-2 text-sm\">\n          <div className=\"flex justify-between text-text-secondary\">\n            <span className=\"underline\">${Number(property.price_per_night).toFixed(0)} x {nights} {nights === 1 ? 'night' : 'nights'}</span>\n            <span>${nightlyTotal.toFixed(0)}</span>\n          </div>\n          <div className=\"flex justify-between text-text-secondary\">\n            <span className=\"underline\">Cleaning fee</span>\n            <span>${cleaningFee.toFixed(0)}</span>\n          </div>\n          <div className=\"flex justify-between font-semibold text-text pt-3 border-t border-border\">\n            <span>Total</span>\n            <span>${total.toFixed(0)}</span>\n          </div>\n        </div>\n      )}\n\n      {isOwnProperty ? (\n        <p data-testid=\"own-property-message\" className=\"text-center text-text-secondary text-sm mb-2\">\n          You cannot book your own property\n        </p>\n      ) : !currentUser ? (\n        <button\n          data-testid=\"booking-login-prompt\"\n          className=\"w-full py-3 rounded-lg bg-gradient-to-r from-primary to-[#E61E4D] text-white font-semibold hover:opacity-95 transition-opacity cursor-pointer text-base\"\n          onClick={() => navigate('/login')}\n        >\n          Log in to reserve\n        </button>\n      ) : (\n        <button\n          data-testid=\"reserve-button\"\n          className=\"w-full py-3 rounded-lg bg-gradient-to-r from-primary to-[#E61E4D] text-white font-semibold hover:opacity-95 transition-opacity disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer text-base\"\n          disabled={!canReserve}\n          onClick={handleReserve}\n        >\n          {loading ? 'Reserving...' : 'Reserve'}\n        </button>\n      )}\n\n      {!checkIn && !checkOut && currentUser && !isOwnProperty && (\n        <p className=\"text-center text-text-secondary text-xs mt-3\">You won't be charged yet</p>\n      )}\n\n      {error && (\n        <p data-testid=\"booking-error\" className=\"text-error text-sm mt-2 text-center\">{error}</p>\n      )}\n\n      {success && (\n        <p data-testid=\"booking-success\" className=\"text-success text-sm mt-2 text-center font-semibold\">\n          Booking confirmed! Redirecting...\n        </p>\n      )}\n    </div>\n  )\n}\n","numLines":421,"startLine":1,"totalLines":421}}}
