[2026-03-16T03:12:30.138Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SSo6teBgrp2p6gmdahbJ6P","type":"tool_result","content":"     1→import { Star } from 'lucide-react'\n     2→import type { Property } from '../slices/propertiesSlice'\n     3→\n     4→interface PropertyHeaderProps {\n     5→  property: Property\n     6→}\n     7→\n     8→export default function PropertyHeader({ property }: PropertyHeaderProps) {\n     9→  const rating = Number(property.avg_rating) || 0\n    10→  const reviewCount = property.review_count || 0\n    11→\n    12→  const scrollToReviews = () => {\n    13→    const el = document.getElementById('reviews-section')\n    14→    if (el) {\n    15→      el.scrollIntoView({ behavior: 'smooth' })\n    16→    }\n    17→  }\n    18→\n    19→  const hostingSince = property.host_since ? new Date(property.host_since) : null\n    20→  const yearsHosting = hostingSince\n    21→    ? Math.max(1, Math.floor((Date.now() - hostingSince.getTime()) / (365.25 * 24 * 60 * 60 * 1000)))\n    22→    : null\n    23→\n    24→  return (\n    25→    <div data-testid=\"property-header\" className=\"pb-6 border-b border-border\">\n    26→      <div className=\"flex items-start justify-between gap-4\">\n    27→        <div className=\"flex-1\">\n    28→          <h1 className=\"text-[22px] font-semibold text-text\">\n    29→            {property.title}\n    30→          </h1>\n    31→          <p className=\"text-sm text-text-secondary mt-1\">\n    32→            {property.city}, {property.country}\n    33→          </p>\n    34→          <div className=\"flex items-center gap-1.5 mt-1 text-sm\">\n    35→            {reviewCount > 0 ? (\n    36→              <button\n    37→                data-testid=\"review-count-link\"\n    38→                className=\"flex items-center gap-1 hover:underline cursor-pointer\"\n    39→                onClick={scrollToReviews}\n    40→              >\n    41→                <Star size={14} className=\"fill-text text-text\" />\n    42→                <span className=\"font-semibold text-text\">{rating.toFixed(2)}</span>\n    43→                <span className=\"text-text-secondary\">·</span>\n    44→                <span className=\"text-text-secondary underline\">({reviewCount} {reviewCount === 1 ? 'review' : 'reviews'})</span>\n    45→              </button>\n    46→            ) : (\n    47→              <span className=\"text-text-secondary\">New</span>\n    48→            )}\n    49→          </div>\n    50→        </div>\n    51→      </div>\n    52→\n    53→      <div className=\"flex items-center gap-4 mt-6 pt-6 border-t border-border\">\n    54→        <button data-testid=\"host-info\" className=\"flex items-center gap-3 cursor-pointer\" onClick={() => {\n    55→          const el = document.getElementById('host-info-card')\n    56→          if (el) el.scrollIntoView({ behavior: 'smooth' })\n    57→        }}>\n    58→          {property.host_avatar ? (\n    59→            <img\n    60→              data-testid=\"host-avatar\"\n    61→              src={property.host_avatar}\n    62→              alt={property.host_name || 'Host'}\n    63→              className=\"w-10 h-10 rounded-full object-cover\"\n    64→            />\n    65→          ) : (\n    66→            <div data-testid=\"host-avatar\" className=\"w-10 h-10 rounded-full bg-text flex items-center justify-center text-sm font-semibold text-white\">\n    67→              {property.host_name?.charAt(0) || 'H'}\n    68→            </div>\n    69→          )}\n    70→          <div className=\"text-left\">\n    71→            <p className=\"text-sm font-semibold text-text\">Hosted by {property.host_name}</p>\n    72→            {yearsHosting && (\n    73→              <p className=\"text-xs text-text-secondary\">{yearsHosting} {yearsHosting === 1 ? 'year' : 'years'} hosting</p>\n    74→            )}\n    75→          </div>\n    76→        </button>\n    77→      </div>\n    78→    </div>\n    79→  )\n    80→}\n    81→"}]},"parent_tool_use_id":"toolu_01L5CfgL9NasNJpJ75WRhPHX","session_id":"39b08d1b-a899-42d7-8ffa-0f5a92d0cf98","uuid":"ea214ffd-31c9-4505-ba82-9fcb3d6399eb"}
