v>\n    40→        <span>·</span>\n    41→        <div className=\"flex items-center gap-1.5\">\n    42→          <Bath size={16} />\n    43→          <span>{property.bathrooms} {property.bathrooms === 1 ? 'bathroom' : 'bathrooms'}</span>\n    44→        </div>\n    45→      </div>\n    46→      <div className=\"flex items-center gap-4 text-sm text-text-secondary mt-3\">\n    47→        <div className=\"flex items-center gap-1.5\">\n    48→          <Clock size={16} />\n    49→          <span>Check-in: {formatTime(property.check_in_time)}</span>\n    50→        </div>\n    51→        <span>·</span>\n    52→        <div className=\"flex items-center gap-1.5\">\n    53→          <Clock size={16} />\n    54→          <span>Check-out: {formatTime(property.check_out_time)}</span>\n    55→        </div>\n    56→      </div>\n    57→    </div>\n    58→  )\n    59→}\n    60→"}]},"parent_tool_use_id":"toolu_01L5CfgL9NasNJpJ75WRhPHX","session_id":"39b08d1b-a899-42d7-8ffa-0f5a92d0cf98","uuid":"178fa709-2bea-427a-8dcb-7791537ee18e"}
