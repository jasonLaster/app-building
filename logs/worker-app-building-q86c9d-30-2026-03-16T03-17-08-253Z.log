unded-full object-cover\"\n    82→                />\n    83→              ) : (\n    84→                <div className=\"w-10 h-10 rounded-full bg-bg-secondary flex items-center justify-center text-sm font-semibold text-text-secondary\">\n    85→                  {review.guest_name.charAt(0)}\n    86→                </div>\n    87→              )}\n    88→              <div>\n    89→                <p className=\"font-medium text-text text-sm\">{review.guest_name}</p>\n    90→                <p className=\"text-text-secondary text-xs\">{formatDate(review.created_at)}</p>\n    91→              </div>\n    92→            </div>\n    93→            <div className=\"flex items-center gap-0.5\">\n    94→              {Array.from({ length: 5 }, (_, i) => (\n    95→                <Star\n    96→                  key={i}\n    97→                  size={12}\n    98→                  className={i < Number(review.rating) ? 'fill-text text-text' : 'text-border'}\n    99→                />\n   100→              ))}\n   101→            </div>\n   102→            {review.comment && (\n   103→              <p className=\"text-text-secondary text-sm leading-relaxed\">{review.comment}</p>\n   104→            )}\n   105→          </div>\n   106→        ))}\n   107→      </div>\n   108→\n   109→      {reviews.length > INITIAL_SHOW && (\n   110→        <button\n   111→          data-testid=\"reviews-toggle\"\n   112→          className=\"mt-6 font-semibold text-text underline cursor-pointer\"\n   113→          onClick={() => setShowAll(!showAll)}\n   114→        >\n   115→          {showAll ? 'Show less' : `Show all ${reviews.length} reviews`}\n   116→        </button>\n   117→      )}\n   118→    </div>\n   119→  )\n   120→}\n   121→"}]},"parent_tool_use_id":null,"session_id":"39b08d1b-a899-42d7-8ffa-0f5a92d0cf98","uuid":"8cc0bc4c-becc-4c4c-9ebd-5f68ce6af5c6","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/components/ReviewsSection.tsx","content":"import { useState } from 'react'\nimport { Star } from 'lucide-react'\nimport type { Review } from '../slices/propertiesSlice'\n\ninterface ReviewsSectionProps {\n  reviews: Review[]\n}\n\nconst INITIAL_SHOW = 6\n\nconst CATEGORIES: { key: keyof Review; label: string }[] = [\n  { key: 'cleanliness', label: 'Cleanliness' },\n  { key: 'accuracy', label: 'Accuracy' },\n  { key: 'communication', label: 'Communication' },\n  { key: 'location', label: 'Location' },\n  { key: 'value', label: 'Value' },\n]\n\nfunction formatDate(dateStr: string): string {\n  const date = new Date(dateStr)\n  return date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })\n}\n\nfunction avgRating(reviews: Review[], key: keyof Review): number {\n  const sum = reviews.reduce((acc, r) => acc + Number(r[key]), 0)\n  return sum / reviews.length\n}\n\nexport default function ReviewsSection({ reviews }: ReviewsSectionProps) {\n  const [showAll, setShowAll] = useState(false)\n\n  if (reviews.length === 0) {\n    return (\n      <div id=\"reviews-section\" data-testid=\"reviews-section\" className=\"py-6 border-b border-border\">\n        <h2 className=\"text-lg font-semibold text-text mb-3\">Reviews</h2>\n        <p className=\"text-text-secondary\">No reviews yet</p>\n      </div>\n    )\n  }\n\n  const overallAvg = reviews.reduce((acc, r) => acc + Number(r.rating), 0) / reviews.length\n  const displayReviews = showAll ? reviews : reviews.slice(0, INITIAL_SHOW)\n\n  return (\n    <div id=\"reviews-section\" data-testid=\"reviews-section\" className=\"py-6 border-b border-border\">\n      <div className=\"flex items-center gap-2 mb-4\">\n        <Star size={20} className=\"fill-text text-text\" />\n        <h2 className=\"text-lg font-semibold text-text\">\n          {overallAvg.toFixed(1)} · {reviews.length} {reviews.length === 1 ? 'review' : 'reviews'}\n        </h2>\n      </div>\n\n      <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-x-8 gap-y-3 mb-6\">\n        {CATEGORIES.map(({ key, label }) => {\n          const avg = avgRating(reviews, key)\n          return (\n            <div key={key} data-testid={`rating-category-${key}`} className=\"flex items-center justify-between text-sm\">\n              <span className=\"text-text-secondary\">{label}</span>\n              <div className=\"flex items-center gap-1\">\n                <div className=\"w-24 h-1 bg-bg-secondary rounded-full overflow-hidden\">\n                  <div\n                    className=\"h-full bg-text rounded-full\"\n                    style={{ width: `${(avg / 5) * 100}%` }}\n                  />\n                </div>\n                <span className=\"font-medium text-text text-xs w-6 text-right\">{avg.toFixed(1)}</span>\n              </div>\n            </div>\n          )\n        })}\n      </div>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n        {displayReviews.map((review) => (\n          <div key={review.id} data-testid={`review-card-${review.id}`} className=\"space-y-2\">\n            <div className=\"flex items-center gap-3\">\n              {review.guest_avatar ? (\n                <img\n                  src={review.guest_avatar}\n                  alt={review.guest_name}\n                  className=\"w-10 h-10 rounded-full object-cover\"\n                />\n              ) : (\n                <div className=\"w-10 h-10 rounded-full bg-bg-secondary flex items-center justify-center text-sm font-semibold text-text-secondary\">\n                  {review.guest_name.charAt(0)}\n                </div>\n              )}\n              <div>\n                <p className=\"font-medium text-text text-sm\">{review.guest_name}</p>\n                <p className=\"text-text-secondary text-xs\">{formatDate(review.created_at)}</p>\n              </div>\n            </div>\n            <div className=\"flex items-center gap-0.5\">\n              {Array.from({ length: 5 }, (_, i) => (\n                <Star\n                  key={i}\n                  size={12}\n                  className={i < Number(review.rating) ? 'fill-text text-text' : 'text-border'}\n                />\n              ))}\n            </div>\n            {review.comment && (\n              <p className=\"text-text-secondary text-sm leading-relaxed\">{review.comment}</p>\n            )}\n          </div>\n        ))}\n      </div>\n\n      {reviews.length > INITIAL_SHOW && (\n        <button\n          data-testid=\"reviews-toggle\"\n          className=\"mt-6 font-semibold text-text underline cursor-pointer\"\n          onClick={() => setShowAll(!showAll)}\n        >\n          {showAll ? 'Show less' : `Show all ${reviews.length} reviews`}\n        </button>\n      )}\n    </div>\n  )\n}\n","numLines":121,"startLine":1,"totalLines":121}}}
