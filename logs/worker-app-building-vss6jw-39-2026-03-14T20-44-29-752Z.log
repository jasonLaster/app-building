ot.toBeVisible()\n   151→  })\n   152→\n   153→  test('Write Review button appears on completed bookings without a review', async ({ page }) => {\n   154→    // Both seed completed bookings have reviews. Delete Alex's review for e4444444\n   155→    // to create a completed booking without a review.\n   156→    const reviewsRes = await page.request.get('/api/reviews?property_id=b4444444-4444-4444-4444-444444444444')\n   157→    const reviews = await reviewsRes.json()\n   158→    for (const review of reviews) {\n   159→      await page.request.delete(`/api/reviews/${review.id}`)\n   160→    }\n   161→\n   162→    await loginAs(page, 'alex@example.com')\n   163→    await page.goto('/trips')\n   164→    await expect(page.getByTestId('my-trips-page')).toBeVisible({ timeout: 30000 })\n   165→\n   166→    await page.getByTestId('tab-past').click()\n   167→\n   168→    // e4444444 is completed without a review now - Write Review button should appear\n   169→    await expect(page.getByTestId('trip-card-e4444444-4444-4444-4444-444444444444')).toBeVisible({ timeout: 30000 })\n   170→    await expect(page.getByTestId('review-button-e4444444-4444-4444-4444-444444444444')).toBeVisible({ timeout: 30000 })\n   171→  })\n   172→\n   173→  test('Write Review button does not appear on completed bookings that already have a review', async ({ page }) => {\n   174→    // Alex's completed booking e4444444 has a review in seed data\n   175→    await loginAs(page, 'alex@example.com')\n   176→    await page.goto('/trips')\n   177→\n   178→    await expect(page.getByTestId('my-trips-page')).toBeVisible({ timeout: 30000 })\n   179→\n   180→    await page.getByTestId('tab-past').click()\n   181→\n   182→    // e4444444 is completed with a review\n   183→    await expect(page.getByTestId('trip-card-e4444444-4444-4444-4444-444444444444')).toBeVisible({ timeout: 30000 })\n   184→\n   185→    // Write Review button should NOT be visible\n   186→    await expect(page.getByTestId('review-button-e444