      <div className=\"p-6 max-sm:p-4\">\n            <h1 id=\"login-title\" className=\"text-[22px] font-semibold text-text mb-2\" data-testid=\"login-title\">\n              {mode === 'login' ? 'Welcome to Airbnb' : 'Create your account'}\n            </h1>\n            <p className=\"text-text-secondary text-sm mb-6\">\n              {mode === 'login'\n                ? 'Enter your email to log in'\n                : 'Sign up to get started'}\n            </p>\n\n            {mode === 'login' ? <LoginForm key=\"login\" /> : <RegisterForm key=\"register\" />}\n\n            <div className=\"relative my-6\">\n              <div className=\"absolute inset-0 flex items-center\">\n                <div className=\"w-full border-t border-border\" />\n              </div>\n              <div className=\"relative flex justify-center text-xs\">\n                <span className=\"bg-bg px-4 text-text-secondary\">or</span>\n              </div>\n            </div>\n\n            <AuthToggle mode={mode} onToggle={handleToggle} />\n          </div>\n        </section>\n      </div>\n    </main>\n  )\n}\n\nexport default Login\n","structuredPatch":[{"oldStart":43,"oldLines":7,"newStart":43,"newLines":7,"lines":["           </div>"," ","           <div className=\"p-6 max-sm:p-4\">","-            <h1 id=\"login-title\" className=\"text-[22px] font-semibold text-text mb-2\" data-testid=\"login-title\">","+            <h1 id=\"login-title\" className=\"text-[22px] max-sm:text-[20px] font-semibold text-text mb-2\" data-testid=\"login-title\">","               {mode === 'login' ? 'Welcome to Airbnb' : 'Create your account'}","             </h1>","             <p className=\"text-text-secondary text-sm mb-6\">"]}],"userModified":false,"replaceAll":false}}
