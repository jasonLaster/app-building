[2026-03-14T21:01:11.125Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012AZxHtAHxq5sFEKK8qrNfx","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test'\n     2→\n     3→// Sarah's property IDs (host a1111111)\n     4→const PROP_LOFT = 'b1111111-1111-1111-1111-111111111111'\n     5→const PROP_VILLA = 'b2222222-2222-2222-2222-222222222222'\n     6→const PROP_TOWNHOUSE = 'b5555555-5555-5555-5555-555555555555'\n     7→\n     8→async function loginAsHost(page: import('@playwright/test').Page) {\n     9→  await page.goto('/login')\n    10→  await page.getByTestId('login-email-input').fill('sarah@example.com')\n    11→  await page.getByTestId('login-submit-button').click()\n    12→  await expect(page).toHaveURL('/', { timeout: 30000 })\n    13→}\n    14→\n    15→async function goToHostDashboard(page: import('@playwright/test').Page) {\n    16→  await loginAsHost(page)\n    17→  await page.goto('/hosting')\n    18→  await expect(page.getByTestId('listings-tab')).toBeVisible({ timeout: 30000 })\n    19→}\n    20→\n    21→test.describe('Host Dashboard - Listings Tab', () => {\n    22→  test('Listings tab displays host\\'s properties in a grid', async ({ page }) => {\n    23→    await goToHostDashboard(page)\n    24→\n    25→    // Sarah has 3 properties\n    26→    const cards = page.locator('[data-testid^=\"listing-card-\"]')\n    27→    await expect(cards).toHaveCount(3, { timeout: 15000 })\n    28→\n    29→    // Verify each property card is visible\n    30→    await expect(page.getByTestId(`listing-card-${PROP_LOFT}`)).toBeVisible()\n    31→    await expect(page.getByTestId(`listing-card-${PROP_VILLA}`)).toBeVisible()\n    32→    await expect(page.getByTestId(`listing-card-${PROP_TOWNHOUSE}`)).toBeVisible()\n    33→  })\n    34→\n    35→  test('Listing card shows property details', async ({ page }) => {\n    36→    await goToHostDashboard(page)\n    37→\n    38→    // Check the Loft card details: title, price, city, rating, review count, active badge\n    39→    const loftCard = page.getByTestId(`listing-card-${PROP_LOFT}`)\n    40→    await expect(loftCard).toBeVisible({ timeout: 15000 })\n    41→    await expect(loftCard).toContainText('Cozy Downtown Loft with City Views')\n    42→    await expect(loftCard).toContainText('$150')\n    43→    await expect(loftCard).toContainText('New York')\n    44→    await expect(loftCard).toContainText('5.0')\n    45→    await expect(loftCard).toContainText('1 reviews')\n    46→\n    47→    const statusBadge = page.getByTestId(`listing-status-${PROP_LOFT}`)\n    48→    await expect(statusBadge).toHaveText('Active')\n    49→  })\n    50→\n    51→  test('Listing card has Edit button that navigates to property detail', async ({ page }) => {\n    52→    await goToHostDashboard(page)\n    53→\n    54→    const editBtn = page.getByTestId(`listing-edit-${PROP_LOFT}`)\n    55→    await expect(editBtn).toBeVisible({ timeout: 15000 })\n    56→    await editBtn.click()\n    57→\n    58→    await expect(page).toHaveURL(`/properties/${PROP_LOFT}`, { timeout: 30000 })\n    59→  })\n    60→\n    61→  test('Listing card has Deactivate button for active properties', async ({ page }) => {\n    62→    await goToHostDashboard(page)\n    63→\n    64→    // Click Deactivate on the Loft\n    65→    const deactivateBtn = page.getByTestId(`listing-deactivate-${PROP_LOFT}`)\n    66→    await expect(deactivateBtn).toBeVisible({ timeout: 15000 })\n    67→    await deactivateBtn.click()\n    68→\n    69→    // Confirmation dialog should appear\n    70→    const dialog = page.getByTestId('deactivate-dialog')\n    71→    await expect(dialog).toBeVisible({ timeout: 15000 })\n    72→    await expect(dialog).toContainText('Are you sure you want to deactivate this listing?')\n    73→    await expect(dialog).toContainText('Cozy Downtown Loft with City Views')\n    74→  })\n    75→\n    76→  test('Confirming deactivation sets property to inactive', async ({ page }) => {\n    77→    await goToHostDashboard(page)\n    78→\n    79→    // Capture initial Total Listings count\n    80→    await expect(page.getByTestId('stat-total-listings')).toContainText('3', { timeout: 15000 })\n    81→\n    82→    // Deactivate the Loft\n    83→    await page.getByTestId(`listing-deactivate-${PROP_LOFT}`).click()\n    84→    await expect(page.getByTestId('deactivate-dialog')).toBeVisible({ timeout: 15000 })\n    85→    await page.getByTestId('deactivate-dialog-confirm').click()\n    86→\n    87→    // Dialog should close\n    88→    await expect(page.getByTestId('deactivate-dialog')).not.toBeVisible({ timeout: 15000 })\n    89→\n    90→    // Property status should change to Inactive\n    91→    await expect(page.getByTestId(`listing-status-${PROP_LOFT}`)).toHaveText('Inactive', { timeout: 15000 })\n    92→\n    93→    // Total Listings stat should decrease\n    94→    await expect(page.getByTestId('stat-total-listings')).toContainText('2', { timeout: 15000 })\n    95→  })\n    96→\n    97→  test('Dismissing deactivation dialog keeps property active', async ({ page }) => {\n    98→    await goToHostDashboard(page)\n    99→\n   100→    // Open deactivation dialog for the Loft\n   101→    await page.getByTestId(`listing-deactivate-${PROP_LOFT}`).click()\n   102→    await expect(page.getByTestId('deactivate-dialog')).toBeVisible({ timeout: 15000 })\n   103→\n   104→    // Cancel/dismiss the dialog\n   105→    await page.getByTestId('deactivate-dialog-cancel').click()\n   106→\n   107→    // Dialog should close\n   108→    await expect(page.getByTestId('deactivate-dialog')).not.toBeVisible({ timeout: 15000 })\n   109→\n   110→    // Property should still be active\n   111→    await expect(page.getByTestId(`listing-status-${PROP_LOFT}`)).toHaveText('Active')\n   112→  })\n   113→\n   114→  test('Listing card shows Activate button for inactive properties', async ({ page }) => {\n   115→    await goToHostDashboard(page)\n   116→\n   117→    // First deactivate the Loft via API to make it inactive\n   118→    await page.request.delete(`http://localhost:8888/api/properties/${PROP_LOFT}`)\n   119→\n   120→    // Reload to see updated state\n   121→    await page.goto('/hosting')\n   122→    await expect(page.getByTestId('listings-tab')).toBeVisible({ timeout: 30000 })\n   123→\n   124→    // Loft should now show Inactive status and Activate button\n   125→    await expect(page.getByTestId(`listing-status-${PROP_LOFT}`)).toHaveText('Inactive', { timeout: 15000 })\n   126→    const activateBtn = page.getByTestId(`listing-activate-${PROP_LOFT}`)\n   127→    await expect(activateBtn).toBeVisible()\n   128→\n   129→    // Click Activate\n   130→    await activateBtn.click()\n   131→\n   132→    // Property should become Active again\n   133→    await expect(page.getByTestId(`listing-status-${PROP_LOFT}`)).toHaveText('Active', { timeout: 15000 })\n   134→\n   135→    // Total Listings stat should update\n   136→    await expect(page.getByTestId('stat-total-listings')).toContainText('3', { timeout: 15000 })\n   137→  })\n   138→\n   139→  test('Listings tab shows empty state for host with no properties', async ({ page, request }) => {\n   140→    // Make emma a host via API (she has no properties)\n   141→    await request.post('http://localhost:8888/api/users/a3333333-3333-3333-3333-333333333333/become-host')\n   142→\n   143→    // Login as emma\n   144→    await page.goto('/login')\n   145→    await page.getByTestId('login-email-input').fill('emma@example.com')\n   146→    await page.getByTestId('login-submit-button').click()\n   147→    await expect(page).toHaveURL('/', { timeout: 30000 })\n   148→\n   149→    await page.goto('/hosting')\n   150→    await expect(page.getByTestId('listings-tab')).toBeVisible({ timeout: 30000 })\n   151→\n   152→    // Should show empty state\n   153→    await expect(page.getByTestId('listings-empty-state')).toBeVisible({ timeout: 15000 })\n   154→    await expect(page.getByTestId('listings-empty-state')).toContainText(\"You don't have any listings yet\")\n   155→  })\n   156→\n   157→  test('Add Listing button is visible on the Listings tab', async ({ page }) => {\n   158→    await goToHostDashboard(page)\n   159→\n   160→    const addBtn = page.getByTestId('add-listing-button')\n   161→    await expect(addBtn).toBeVisible({ timeout: 15000 })\n   162→    await expect(addBtn).toContainText('Add Listing')\n   163→  })\n   164→\n   165→  test('Deactivate and activate actions work on repeated use', async ({ page }) => {\n   166→    test.slow()\n   167→    await goToHostDashboard(page)\n   168→\n   169→    // Verify initial state: 3 active listings\n   170→    await expect(page.getByTestId('stat-total-listings')).toContainText('3', { timeout: 15000 })\n   171→\n   172→    // 1. Deactivate the Loft (first property)\n   173→    await page.getByTestId(`listing-deactivate-${PROP_LOFT}`).click()\n   174→    await expect(page.getByTestId('deactivate-dialog')).toBeVisible({ timeout: 15000 })\n   175→    await page.getByTestId('deactivate-dialog-confirm').click()\n   176→    await expect(page.getByTestId('deactivate-dialog')).not.toBeVisible({ timeout: 15000 })\n   177→    await expect(page.getByTestId(`listing-status-${PROP_LOFT}`)).toHaveText('Inactive', { timeout: 15000 })\n   178→    await expect(page.getByTestId('stat-total-listings')).toContainText('2', { timeout: 15000 })\n   179→\n   180→    // 2. Activate the Loft back\n   181→    await page.getByTestId(`listing-activate-${PROP_LOFT}`).click()\n   182→    await expect(page.getByTestId(`listing-status-${PROP_LOFT}`)).toHaveText('Active', { timeout: 15000 })\n   183→    await expect(page.getByTestId('stat-total-listings')).toContainText('3', { timeout: 15000 })\n   184→\n   185→    // 3. Deactivate the Villa (second property)\n   186→    await page.getByTestId(`listing-deactivate-${PROP_VILLA}`).click()\n   187→    await expect(page.getByTestId('deactivate-dialog')).toBeVisible({ timeout: 15000 })\n   188→    await page.getByTestId('deactivate-dialog-confirm').click()\n   189→    await expect(page.getByTestId('deactivate-dialog')).not.toBeVisible({ timeout: 15000 })\n   190→    await expect(page.getByTestId(`listing-status-${PROP_VILLA}`)).toHaveText('Inactive', { timeout: 15000 })\n   191→    await expect(page.getByTestId('stat-total-listings')).toContainText('2', { timeout: 15000 })\n   192→  })\n   193→})\n   194→"}]},"parent_tool_use_id":null,"session_id":"f2dc69e2-bd3d-45b0-ab90-8317c8b03401","uuid":"354df012-ddb6-493b-992e-e0355ef71be8","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/tests/host-dashboard-listings.spec.ts","content":"import { test, expect } from '@playwright/test'\n\n// Sarah's property IDs (host a1111111)\nconst PROP_LOFT = 'b1111111-1111-1111-1111-111111111111'\nconst PROP_VILLA = 'b2222222-2222-2222-2222-222222222222'\nconst PROP_TOWNHOUSE = 'b5555555-5555-5555-5555-555555555555'\n\nasync function loginAsHost(page: import('@playwright/test').Page) {\n  await page.goto('/login')\n  await page.getByTestId('login-email-input').fill('sarah@example.com')\n  await page.getByTestId('login-submit-button').click()\n  await expect(page).toHaveURL('/', { timeout: 30000 })\n}\n\nasync function goToHostDashboard(page: import('@playwright/test').Page) {\n  await loginAsHost(page)\n  await page.goto('/hosting')\n  await expect(page.getByTestId('listings-tab')).toBeVisible({ timeout: 30000 })\n}\n\ntest.describe('Host Dashboard - Listings Tab', () => {\n  test('Listings tab displays host\\'s properties in a grid', async ({ page }) => {\n    await goToHostDashboard(page)\n\n    // Sarah has 3 properties\n    const cards = page.locator('[data-testid^=\"listing-card-\"]')\n    await expect(cards).toHaveCount(3, { timeout: 15000 })\n\n    // Verify each property card is visible\n    await expect(page.getByTestId(`listing-card-${PROP_LOFT}`)).toBeVisible()\n    await expect(page.getByTestId(`listing-card-${PROP_VILLA}`)).toBeVisible()\n    await expect(page.getByTestId(`listing-card-${PROP_TOWNHOUSE}`)).toBeVisible()\n  })\n\n  test('Listing card shows property details', async ({ page }) => {\n    await goToHostDashboard(page)\n\n    // Check the Loft card details: title, price, city, rating, review count, active badge\n    const loftCard = page.getByTestId(`listing-card-${PROP_LOFT}`)\n    await expect(loftCard).toBeVisible({ timeout: 15000 })\n    await expect(loftCard).toContainText('Cozy Downtown Loft with City Views')\n    await expect(loftCard).toContainText('$150')\n    await expect(loftCard).toContainText('New York')\n    await expect(loftCard).toContainText('5.0')\n    await expect(loftCard).toContainText('1 reviews')\n\n    const statusBadge = page.getByTestId(`listing-status-${PROP_LOFT}`)\n    await expect(statusBadge).toHaveText('Active')\n  })\n\n  test('Listing card has Edit button that navigates to property detail', async ({ page }) => {\n    await goToHostDashboard(page)\n\n    const editBtn = page.getByTestId(`listing-edit-${PROP_LOFT}`)\n    await expect(editBtn).toBeVisible({ timeout: 15000 })\n    await editBtn.click()\n\n    await expect(page).toHaveURL(`/properties/${PROP_LOFT}`, { timeout: 30000 })\n  })\n\n  test('Listing card has Deactivate button for active properties', async ({ page }) => {\n    await goToHostDashboard(page)\n\n    // Click Deactivate on the Loft\n    const deactivateBtn = page.getByTestId(`listing-deactivate-${PROP_LOFT}`)\n    await expect(deactivateBtn).toBeVisible({ timeout: 15000 })\n    await deactivateBtn.click()\n\n    // Confirmation dialog should appear\n    const dialog = page.getByTestId('deactivate-dialog')\n    await expect(dialog).toBeVisible({ timeout: 15000 })\n    await expect(dialog).toContainText('Are you sure you want to deactivate this listing?')\n    await expect(dialog).toContainText('Cozy Downtown Loft with City Views')\n  })\n\n  test('Confirming deactivation sets property to inactive', async ({ page }) => {\n    await goToHostDashboard(page)\n\n    // Capture initial Total Listings count\n    await expect(page.getByTestId('stat-total-listings')).toContainText('3', { timeout: 15000 })\n\n    // Deactivate the Loft\n    await page.getByTestId(`listing-deactivate-${PROP_LOFT}`).click()\n    await expect(page.getByTestId('deactivate-dialog')).toBeVisible({ timeout: 15000 })\n    await page.getByTestId('deactivate-dialog-confirm').click()\n\n    // Dialog should close\n    await expect(page.getByTestId('deactivate-dialog')).not.toBeVisible({ timeout: 15000 })\n\n    // Property status should change to Inactive\n    await expect(page.getByTestId(`listing-status-${PROP_LOFT}`)).toHaveText('Inactive', { timeout: 15000 })\n\n    // Total Listings stat should decrease\n    await expect(page.getByTestId('stat-total-listings')).toContainText('2', { timeout: 15000 })\n  })\n\n  test('Dismissing deactivation dialog keeps property active', async ({ page }) => {\n    await goToHostDashboard(page)\n\n    // Open deactivation dialog for the Loft\n    await page.getByTestId(`listing-deactivate-${PROP_LOFT}`).click()\n    await expect(page.getByTestId('deactivate-dialog')).toBeVisible({ timeout: 15000 })\n\n    // Cancel/dismiss the dialog\n    await page.getByTestId('deactivate-dialog-cancel').click()\n\n    // Dialog should close\n    await expect(page.getByTestId('deactivate-dialog')).not.toBeVisible({ timeout: 15000 })\n\n    // Property should still be active\n    await expect(page.getByTestId(`listing-status-${PROP_LOFT}`)).toHaveText('Active')\n  })\n\n  test('Listing card shows Activate button for inactive properties', async ({ page }) => {\n    await goToHostDashboard(page)\n\n    // First deactivate the Loft via API to make it inactive\n    await page.request.delete(`http://localhost:8888/api/properties/${PROP_LOFT}`)\n\n    // Reload to see updated state\n    await page.goto('/hosting')\n    await expect(page.getByTestId('listings-tab')).toBeVisible({ timeout: 30000 })\n\n    // Loft should now show Inactive status and Activate button\n    await expect(page.getByTestId(`listing-status-${PROP_LOFT}`)).toHaveText('Inactive', { timeout: 15000 })\n    const activateBtn = page.getByTestId(`listing-activate-${PROP_LOFT}`)\n    await expect(activateBtn).toBeVisible()\n\n    // Click Activate\n    await activateBtn.click()\n\n    // Property should become Active again\n    await expect(page.getByTestId(`listing-status-${PROP_LOFT}`)).toHaveText('Active', { timeout: 15000 })\n\n    // Total Listings stat should update\n    await expect(page.getByTestId('stat-total-listings')).toContainText('3', { timeout: 15000 })\n  })\n\n  test('Listings tab shows empty state for host with no properties', async ({ page, request }) => {\n    // Make emma a host via API (she has no properties)\n    await request.post('http://localhost:8888/api/users/a3333333-3333-3333-3333-333333333333/become-host')\n\n    // Login as emma\n    await page.goto('/login')\n    await page.getByTestId('login-email-input').fill('emma@example.com')\n    await page.getByTestId('login-submit-button').click()\n    await expect(page).toHaveURL('/', { timeout: 30000 })\n\n    await page.goto('/hosting')\n    await expect(page.getByTestId('listings-tab')).toBeVisible({ timeout: 30000 })\n\n    // Should show empty state\n    await expect(page.getByTestId('listings-empty-state')).toBeVisible({ timeout: 15000 })\n    await expect(page.getByTestId('listings-empty-state')).toContainText(\"You don't have any listings yet\")\n  })\n\n  test('Add Listing button is visible on the Listings tab', async ({ page }) => {\n    await goToHostDashboard(page)\n\n    const addBtn = page.getByTestId('add-listing-button')\n    await expect(addBtn).toBeVisible({ timeout: 15000 })\n    await expect(addBtn).toContainText('Add Listing')\n  })\n\n  test('Deactivate and activate actions work on repeated use', async ({ page }) => {\n    test.slow()\n    await goToHostDashboard(page)\n\n    // Verify initial state: 3 active listings\n    await expect(page.getByTestId('stat-total-listings')).toContainText('3', { timeout: 15000 })\n\n    // 1. Deactivate the Loft (first property)\n    await page.getByTestId(`listing-deactivate-${PROP_LOFT}`).click()\n    await expect(page.getByTestId('deactivate-dialog')).toBeVisible({ timeout: 15000 })\n    await page.getByTestId('deactivate-dialog-confirm').click()\n    await expect(page.getByTestId('deactivate-dialog')).not.toBeVisible({ timeout: 15000 })\n    await expect(page.getByTestId(`listing-status-${PROP_LOFT}`)).toHaveText('Inactive', { timeout: 15000 })\n    await expect(page.getByTestId('stat-total-listings')).toContainText('2', { timeout: 15000 })\n\n    // 2. Activate the Loft back\n    await page.getByTestId(`listing-activate-${PROP_LOFT}`).click()\n    await expect(page.getByTestId(`listing-status-${PROP_LOFT}`)).toHaveText('Active', { timeout: 15000 })\n    await expect(page.getByTestId('stat-total-listings')).toContainText('3', { timeout: 15000 })\n\n    // 3. Deactivate the Villa (second property)\n    await page.getByTestId(`listing-deactivate-${PROP_VILLA}`).click()\n    await expect(page.getByTestId('deactivate-dialog')).toBeVisible({ timeout: 15000 })\n    await page.getByTestId('deactivate-dialog-confirm').click()\n    await expect(page.getByTestId('deactivate-dialog')).not.toBeVisible({ timeout: 15000 })\n    await expect(page.getByTestId(`listing-status-${PROP_VILLA}`)).toHaveText('Inactive', { timeout: 15000 })\n    await expect(page.getByTestId('stat-total-listings')).toContainText('2', { timeout: 15000 })\n  })\n})\n","numLines":194,"startLine":1,"totalLines":194}}}
