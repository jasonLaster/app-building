[2026-03-14T21:00:26.292Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TtsyQDjLjkxF5tJHN7jDzq","type":"tool_result","content":"     1→import { useState, useEffect, useCallback, useRef } from 'react'\n     2→import { useSelector, useDispatch } from 'react-redux'\n     3→import { X, Plus, Trash2, ChevronLeft, ChevronRight, Minus, Check, Loader2 } from 'lucide-react'\n     4→import type { RootState, AppDispatch } from '../store'\n     5→import type { Amenity } from '../slices/propertiesSlice'\n     6→import { fetchAmenities } from '../slices/amenitiesSlice'\n     7→import { createProperty } from '../slices/hostSlice'\n     8→\n     9→interface AddListingFormProps {\n    10→  hostId: string\n    11→  onClose: () => void\n    12→  onSuccess: () => void\n    13→}\n    14→\n    15→interface FormData {\n    16→  propertyType: string\n    17→  title: string\n    18→  address: string\n    19→  city: string\n    20→  state: string\n    21→  country: string\n    22→  latitude: number | null\n    23→  longitude: number | null\n    24→  maxGuests: number\n    25→  bedrooms: number\n    26→  beds: number\n    27→  bathrooms: number\n    28→  selectedAmenities: string[]\n    29→  photos: { url: string; caption: string }[]\n    30→  pricePerNight: string\n    31→  cleaningFee: string\n    32→  description: string\n    33→}\n    34→\n    35→const PROPERTY_TYPES = ['Apartment', 'House', 'Cabin', 'Villa', 'Condo', 'Loft', 'Cottage', 'Townhouse']\n    36→const TOTAL_STEPS = 7\n    37→\n    38→const initialFormData: FormData = {\n    39→  propertyType: '',\n    40→  title: '',\n    41→  address: '',\n    42→  city: '',\n    43→  state: '',\n    44→  country: '',\n    45→  latitude: null,\n    46→  longitude: null,\n    47→  maxGuests: 1,\n    48→  bedrooms: 1,\n    49→  beds: 1,\n    50→  bathrooms: 1,\n    51→  selectedAmenities: [],\n    52→  photos: [],\n    53→  pricePerNight: '',\n    54→  cleaningFee: '0',\n    55→  description: '',\n    56→}\n    57→\n    58→interface AddressSuggestion {\n    59→  display_name: string\n    60→  address?: {\n    61→    road?: string\n    62→    house_number?: string\n    63→    city?: string\n    64→    town?: string\n    65→    village?: string\n    66→    state?: string\n    67→    country?: string\n    68→  }\n    69→  lat: string\n    70→  lon: string\n    71→}\n    72→\n    73→export default function AddListingForm({ hostId, onClose, onSuccess }: AddListingFormProps) {\n    74→  const dispatch = useDispatch<AppDispatch>()\n    75→  const amenities = useSelector((state: RootState) => state.amenities.items)\n    76→  const [step, setStep] = useState(1)\n    77→  const [formData, setFormData] = useState<FormData>(initialFormData)\n    78→  const [errors, setErrors] = useState<Record<string, string>>({})\n    79→  const [showDiscardDialog, setShowDiscardDialog] = useState(false)\n    80→  const [publishing, setPublishing] = useState(false)\n    81→  const [photoUrl, setPhotoUrl] = useState('')\n    82→  const [addressSuggestions, setAddressSuggestions] = useState<AddressSuggestion[]>([])\n    83→  const [showSuggestions, setShowSuggestions] = useState(false)\n    84→  const [propertyTypeOpen, setPropertyTypeOpen] = useState(false)\n    85→  const debounceRef = useRef<ReturnType<typeof setTimeout> | null>(null)\n    86→\n    87→  useEffect(() => {\n    88→    if (amenities.length === 0) {\n    89→      dispatch(fetchAmenities())\n    90→    }\n    91→  }, [dispatch, amenities.length])\n    92→\n    93→  const fetchAddressSuggestions = useCallback(async (query: string) => {\n    94→    if (query.length < 3) {\n    95→      setAddressSuggestions([])\n    96→      return\n    97→    }\n    98→    try {\n    99→      const response = await fetch(\n   100→        `https://nominatim.openstreetmap.org/search?format=json&addressdetails=1&q=${encodeURIComponent(query)}&limit=5`\n   101→      )\n   102→      const data = await response.json() as AddressSuggestion[]\n   103→      setAddressSuggestions(data)\n   104→      setShowSuggestions(true)\n   105→    } catch {\n   106→      setAddressSuggestions([])\n   107→    }\n   108→  }, [])\n   109→\n   110→  const handleAddressChange = (value: string) => {\n   111→    setFormData((prev) => ({ ...prev, address: value }))\n   112→    if (debounceRef.current) clearTimeout(debounceRef.current)\n   113→    debounceRef.current = setTimeout(() => {\n   114→      fetchAddressSuggestions(value)\n   115→    }, 300)\n   116→  }\n   117→\n   118→  const handleSelectSuggestion = (suggestion: AddressSuggestion) => {\n   119→    const addr = suggestion.address\n   120→    const road = addr?.house_number ? `${addr.house_number} ${addr.road || ''}` : (addr?.road || '')\n   121→    setFormData((prev) => ({\n   122→      ...prev,\n   123→      address: road || suggestion.display_name,\n   124→      city: addr?.city || addr?.town || addr?.village || '',\n   125→      state: addr?.state || '',\n   126→      country: addr?.country || '',\n   127→      latitude: parseFloat(suggestion.lat),\n   128→      longitude: parseFloat(suggestion.lon),\n   129→    }))\n   130→    setShowSuggestions(false)\n   131→    setAddressSuggestions([])\n   132→  }\n   133→\n   134→  const validateStep = (): boolean => {\n   135→    const newErrors: Record<string, string> = {}\n   136→\n   137→    if (step === 1) {\n   138→      if (!formData.propertyType) newErrors.propertyType = 'Property type is required'\n   139→      if (!formData.title.trim()) newErrors.title = 'Title is required'\n   140→    } else if (step === 2) {\n   141→      if (!formData.city.trim()) newErrors.city = 'City is required'\n   142→      if (!formData.country.trim()) newErrors.country = 'Country is required'\n   143→    } else if (step === 3) {\n   144→      if (formData.maxGuests < 1) newErrors.maxGuests = 'Max guests must be at least 1'\n   145→      if (formData.bedrooms < 1) newErrors.bedrooms = 'At least 1 bedroom is required'\n   146→      if (formData.beds < 1) newErrors.beds = 'At least 1 bed is required'\n   147→      if (formData.bathrooms < 1) newErrors.bathrooms = 'At least 1 bathroom is required'\n   148→    } else if (step === 5) {\n   149→      if (formData.photos.length === 0) newErrors.photos = 'At least one photo is required'\n   150→    } else if (step === 6) {\n   151→      const price = parseFloat(formData.pricePerNight)\n   152→      if (!price || price <= 0) newErrors.pricePerNight = 'Price per night is required and must be greater than 0'\n   153→    }\n   154→\n   155→    setErrors(newErrors)\n   156→    return Object.keys(newErrors).length === 0\n   157→  }\n   158→\n   159→  const handleNext = () => {\n   160→    if (validateStep()) {\n   161→      setStep((s) => Math.min(s + 1, TOTAL_STEPS))\n   162→    }\n   163→  }\n   164→\n   165→  const handleBack = () => {\n   166→    setErrors({})\n   167→    setStep((s) => Math.max(s - 1, 1))\n   168→  }\n   169→\n   170→  const handleAddPhoto = () => {\n   171→    if (!photoUrl.trim()) return\n   172→    setFormData((prev) => ({\n   173→      ...prev,\n   174→      photos: [...prev.photos, { url: photoUrl.trim(), caption: '' }],\n   175→    }))\n   176→    setPhotoUrl('')\n   177→    setErrors((prev) => {\n   178→      const next = { ...prev }\n   179→      delete next.photos\n   180→      return next\n   181→    })\n   182→  }\n   183→\n   184→  const handleRemovePhoto = (index: number) => {\n   185→    setFormData((prev) => ({\n   186→      ...prev,\n   187→      photos: prev.photos.filter((_, i) => i !== index),\n   188→    }))\n   189→  }\n   190→\n   191→  const toggleAmenity = (amenityId: string) => {\n   192→    setFormData((prev) => ({\n   193→      ...prev,\n   194→      selectedAmenities: prev.selectedAmenities.includes(amenityId)\n   195→        ? prev.selectedAmenities.filter((id) => id !== amenityId)\n   196→        : [...prev.selectedAmenities, amenityId],\n   197→    }))\n   198→  }\n   199→\n   200→  const handlePublish = async () => {\n   201→    setPublishing(true)\n   202→    try {\n   203→      const result = await dispatch(createProperty({\n   204→        host_id: hostId,\n   205→        title: formData.title,\n   206→        description: formData.description,\n   207→        property_type: formData.propertyType,\n   208→        price_per_night: parseFloat(formData.pricePerNight),\n   209→        cleaning_fee: parseFloat(formData.cleaningFee) || 0,\n   210→        max_guests: formData.maxGuests,\n   211→        bedrooms: formData.bedrooms,\n   212→        beds: formData.beds,\n   213→        bathrooms: formData.bathrooms,\n   214→        address: formData.address,\n   215→        city: formData.city,\n   216→        state: formData.state || null,\n   217→        country: formData.country,\n   218→        latitude: formData.latitude,\n   219→        longitude: formData.longitude,\n   220→        amenity_ids: formData.selectedAmenities,\n   221→      })).unwrap()\n   222→\n   223→      const propertyId = result.id\n   224→\n   225→      for (let i = 0; i < formData.photos.length; i++) {\n   226→        const photo = formData.photos[i]\n   227→        if (photo) {\n   228→          await fetch('/api/property-images', {\n   229→            method: 'POST',\n   230→            headers: { 'Content-Type': 'application/json' },\n   231→            body: JSON.stringify({\n   232→              property_id: propertyId,\n   233→              url: photo.url,\n   234→              caption: photo.caption,\n   235→              display_order: i,\n   236→            }),\n   237→          })\n   238→        }\n   239→      }\n   240→\n   241→      onSuccess()\n   242→    } catch {\n   243→      setErrors({ publish: 'Failed to publish listing. Please try again.' })\n   244→    } finally {\n   245→      setPublishing(false)\n   246→    }\n   247→  }\n   248→\n   249→  const handleCancel = () => {\n   250→    setShowDiscardDialog(true)\n   251→  }\n   252→\n   253→  const incrementField = (field: 'maxGuests' | 'bedrooms' | 'beds' | 'bathrooms') => {\n   254→    setFormData((prev) => ({ ...prev, [field]: prev[field] + 1 }))\n   255→  }\n   256→\n   257→  const decrementField = (field: 'maxGuests' | 'bedrooms' | 'beds' | 'bathrooms') => {\n   258→    setFormData((prev) => ({ ...prev, [field]: Math.max(0, prev[field] - 1) }))\n   259→  }\n   260→\n   261→  const amenitiesByCategory = amenities.reduce<Record<string, Amenity[]>>((acc, amenity) => {\n   262→    const cat = amenity.category || 'Other'\n   263→    if (!acc[cat]) acc[cat] = []\n   264→    acc[cat].push(amenity)\n   265→    return acc\n   266→  }, {})\n   267→\n   268→  const renderStepIndicator = () => (\n   269→    <div data-testid=\"step-indicator\" className=\"flex items-center justify-center gap-2 mb-6\">\n   270→      {Array.from({ length: TOTAL_STEPS }, (_, i) => i + 1).map((s) => (\n   271→        <div\n   272→          key={s}\n   273→          className={`w-8 h-8 rounded-full flex items-center justify-center text-xs font-medium transition-colors ${\n   274→            s < step\n   275→              ? 'bg-primary text-white'\n   276→              : s === step\n   277→                ? 'bg-primary text-white'\n   278→                : 'bg-bg-secondary text-text-secondary'\n   279→          }`}\n   280→        >\n   281→          {s < step ? <Check size={14} /> : s}\n   282→        </div>\n   283→      ))}\n   284→      <span className=\"ml-2 text-sm text-text-secondary\">Step {step} of {TOTAL_STEPS}</span>\n   285→    </div>\n   286→  )\n   287→\n   288→  const renderStep1 = () => (\n   289→    <div data-testid=\"add-listing-step-1\">\n   290→      <h3 className=\"text-lg font-semibold text-text mb-4\">Property Type & Title</h3>\n   291→\n   292→      <div className=\"mb-4\">\n   293→        <label className=\"block text-sm font-medium text-text mb-1.5\">Property Type *</label>\n   294→        <div className=\"relative\">\n   295→          <button\n   296→            type=\"button\"\n   297→            data-testid=\"property-type-select\"\n   298→            onClick={() => setPropertyTypeOpen(!propertyTypeOpen)}\n   299→            className={`w-full text-left px-4 py-3 rounded-lg border ${\n   300→              errors.propertyType ? 'border-error' : 'border-border'\n   301→            } bg-white text-sm focus:outline-none focus:border-primary`}\n   302→          >\n   303→            {formData.propertyType || 'Select property type...'}\n   304→          </button>\n   305→          {propertyTypeOpen && (\n   306→            <div className=\"absolute top-full left-0 right-0 mt-1 bg-white border border-border rounded-lg shadow-lg z-10 max-h-60 overflow-y-auto\">\n   307→              {PROPERTY_TYPES.map((type) => (\n   308→                <button\n   309→                  key={type}\n   310→                  type=\"button\"\n   311→                  data-testid={`property-type-option-${type.toLowerCase()}`}\n   312→                  onClick={() => {\n   313→                    setFormData((prev) => ({ ...prev, propertyType: type }))\n   314→                    setPropertyTypeOpen(false)\n   315→                    setErrors((prev) => {\n   316→                      const next = { ...prev }\n   317→                      delete next.propertyType\n   318→                      return next\n   319→                    })\n   320→                  }}\n   321→                  className={`w-full text-left px-4 py-2.5 text-sm hover:bg-bg-secondary transition-colors ${\n   322→                    formData.propertyType === type ? 'bg-primary/10 text-primary font-medium' : 'text-text'\n   323→                  }`}\n   324→                >\n   325→                  {type}\n   326→                </button>\n   327→              ))}\n   328→            </div>\n   329→          )}\n   330→        </div>\n   331→        {errors.propertyType && <p className=\"text-error text-xs mt-1\">{errors.propertyType}</p>}\n   332→      </div>\n   333→\n   334→      <div className=\"mb-4\">\n   335→        <label className=\"block text-sm font-medium text-text mb-1.5\">Title *</label>\n   336→        <input\n   337→          data-testid=\"listing-title-input\"\n   338→          type=\"text\"\n   339→          value={formData.title}\n   340→          onChange={(e) => {\n   341→            setFormData((prev) => ({ ...prev, title: e.target.value }))\n   342→            if (errors.title) setErrors((prev) => { const n = { ...prev }; delete n.title; return n })\n   343→          }}\n   344→          placeholder=\"Give your place a catchy title\"\n   345→          className={`w-full px-4 py-3 rounded-lg border ${\n   346→            errors.title ? 'border-error' : 'border-border'\n   347→          } text-sm focus:outline-none focus:border-primary`}\n   348→        />\n   349→        {errors.title && <p className=\"text-error text-xs mt-1\">{errors.title}</p>}\n   350→      </div>\n   351→    </div>\n   352→  )\n   353→\n   354→  const renderStep2 = () => (\n   355→    <div data-testid=\"add-listing-step-2\">\n   356→      <h3 className=\"text-lg font-semibold text-text mb-4\">Location</h3>\n   357→\n   358→      <div className=\"mb-4 relative\">\n   359→        <label className=\"block text-sm font-medium text-text mb-1.5\">Address</label>\n   360→        <input\n   361→          data-testid=\"listing-address-input\"\n   362→          type=\"text\"\n   363→          value={formData.address}\n   364→          onChange={(e) => handleAddressChange(e.target.value)}\n   365→          onFocus={() => { if (addressSuggestions.length > 0) setShowSuggestions(true) }}\n   366→          placeholder=\"Start typing an address...\"\n   367→          className=\"w-full px-4 py-3 rounded-lg border border-border text-sm focus:outline-none focus:border-primary\"\n   368→        />\n   369→        {showSuggestions && addressSuggestions.length > 0 && (\n   370→          <div\n   371→            data-testid=\"address-suggestions\"\n   372→            className=\"absolute top-full left-0 right-0 mt-1 bg-white border border-border rounded-lg shadow-lg z-10 max-h-48 overflow-y-auto\"\n   373→          >\n   374→            {addressSuggestions.map((s, i) => (\n   375→              <button\n   376→                key={i}\n   377→                type=\"button\"\n   378→                onClick={() => handleSelectSuggestion(s)}\n   379→                className=\"w-full text-left px-4 py-2.5 text-sm hover:bg-bg-secondary transition-colors border-b border-border last:border-b-0\"\n   380→              >\n   381→                {s.display_name}\n   382→              </button>\n   383→            ))}\n   384→          </div>\n   385→        )}\n   386→      </div>\n   387→\n   388→      <div className=\"grid grid-cols-2 gap-4 mb-4\">\n   389→        <div>\n   390→          <label className=\"block text-sm font-medium text-text mb-1.5\">City *</label>\n   391→          <input\n   392→            data-testid=\"listing-city-input\"\n   393→            type=\"text\"\n   394→            value={formData.city}\n   395→            onChange={(e) => {\n   396→              setFormData((prev) => ({ ...prev, city: e.target.value }))\n   397→              if (errors.city) setErrors((prev) => { const n = { ...prev }; delete n.city; return n })\n   398→            }}\n   399→            placeholder=\"City\"\n   400→            className={`w-full px-4 py-3 rounded-lg border ${\n   401→              errors.city ? 'border-error' : 'border-border'\n   402→            } text-sm focus:outline-none focus:border-primary`}\n   403→          />\n   404→          {errors.city && <p className=\"text-error text-xs mt-1\">{errors.city}</p>}\n   405→        </div>\n   406→        <div>\n   407→          <label className=\"block text-sm font-medium text-text mb-1.5\">State</label>\n   408→          <input\n   409→            data-testid=\"listing-state-input\"\n   410→            type=\"text\"\n   411→            value={formData.state}\n   412→            onChange={(e) => setFormData((prev) => ({ ...prev, state: e.target.value }))}\n   413→            placeholder=\"State/Province\"\n   414→            className=\"w-full px-4 py-3 rounded-lg border border-border text-sm focus:outline-none focus:border-primary\"\n   415→          />\n   416→        </div>\n   417→      </div>\n   418→\n   419→      <div className=\"mb-4\">\n   420→        <label className=\"block text-sm font-medium text-text mb-1.5\">Country *</label>\n   421→        <input\n   422→          data-testid=\"listing-country-input\"\n   423→          type=\"text\"\n   424→          value={formData.country}\n   425→          onChange={(e) => {\n   426→            setFormData((prev) => ({ ...prev, country: e.target.value }))\n   427→            if (errors.country) setErrors((prev) => { const n = { ...prev }; delete n.country; return n })\n   428→          }}\n   429→          placeholder=\"Country\"\n   430→          className={`w-full px-4 py-3 rounded-lg border ${\n   431→            errors.country ? 'border-error' : 'border-border'\n   432→          } text-sm focus:outline-none focus:border-primary`}\n   433→        />\n   434→        {errors.country && <p className=\"text-error text-xs mt-1\">{errors.country}</p>}\n   435→      </div>\n   436→    </div>\n   437→  )\n   438→\n   439→  const renderStep3 = () => {\n   440→    const fields: { key: 'maxGuests' | 'bedrooms' | 'beds' | 'bathrooms'; label: string }[] = [\n   441→      { key: 'maxGuests', label: 'Max Guests' },\n   442→      { key: 'bedrooms', label: 'Bedrooms' },\n   443→      { key: 'beds', label: 'Beds' },\n   444→      { key: 'bathrooms', label: 'Bathrooms' },\n   445→    ]\n   446→\n   447→    return (\n   448→      <div data-testid=\"add-listing-step-3\">\n   449→        <h3 className=\"text-lg font-semibold text-text mb-4\">Property Details</h3>\n   450→        <div className=\"space-y-4\">\n   451→          {fields.map(({ key, label }) => (\n   452→            <div key={key} className=\"flex items-center justify-between\">\n   453→              <label className=\"text-sm font-medium text-text\">{label} *</label>\n   454→              <div className=\"flex items-center gap-3\">\n   455→                <button\n   456→                  type=\"button\"\n   457→                  data-testid={`${key}-decrement`}\n   458→                  onClick={() => decrementField(key)}\n   459→                  className=\"w-8 h-8 rounded-full border border-border flex items-center justify-center text-text-secondary hover:border-text transition-colors\"\n   460→                >\n   461→                  <Minus size={14} />\n   462→                </button>\n   463→                <span data-testid={`${key}-value`} className=\"text-lg font-medium text-text w-8 text-center\">\n   464→                  {formData[key]}\n   465→                </span>\n   466→                <button\n   467→                  type=\"button\"\n   468→                  data-testid={`${key}-increment`}\n   469→                  onClick={() => incrementField(key)}\n   470→                  className=\"w-8 h-8 rounded-full border border-border flex items-center justify-center text-text-secondary hover:border-text transition-colors\"\n   471→                >\n   472→                  <Plus size={14} />\n   473→                </button>\n   474→              </div>\n   475→              {errors[key] && <p className=\"text-error text-xs\">{errors[key]}</p>}\n   476→            </div>\n   477→          ))}\n   478→        </div>\n   479→      </div>\n   480→    )\n   481→  }\n   482→\n   483→  const renderStep4 = () => (\n   484→    <div data-testid=\"add-listing-step-4\">\n   485→      <h3 className=\"text-lg font-semibold text-text mb-4\">Amenities</h3>\n   486→      <p className=\"text-sm text-text-secondary mb-4\">Select the amenities your property offers (optional)</p>\n   487→      {Object.entries(amenitiesByCategory).map(([category, items]) => (\n   488→        <div key={category} className=\"mb-6\">\n   489→          <h4 className=\"text-sm font-semibold text-text mb-2 capitalize\">{category}</h4>\n   490→          <div className=\"grid grid-cols-2 gap-2\">\n   491→            {items.map((amenity) => (\n   492→              <label\n   493→                key={amenity.id}\n   494→                data-testid={`amenity-checkbox-${amenity.id}`}\n   495→                className={`flex items-center gap-2 px-3 py-2.5 rounded-lg border cursor-pointer transition-colors ${\n   496→                  formData.selectedAmenities.includes(amenity.id)\n   497→                    ? 'border-primary bg-primary/5'\n   498→                    : 'border-border hover:border-border-dark'\n   499→                }`}\n   500→              >\n   501→                <input\n   502→                  type=\"checkbox\"\n   503→                  checked={formData.selectedAmenities.includes(amenity.id)}\n   504→                  onChange={() => toggleAmenity(amenity.id)}\n   505→                  className=\"sr-only\"\n   506→                />\n   507→                <div\n   508→                  className={`w-4 h-4 rounded border flex items-center justify-center ${\n   509→                    formData.selectedAmenities.includes(amenity.id)\n   510→                      ? 'bg-primary border-primary'\n   511→                      : 'border-border-dark'\n   512→                  }`}\n   513→                >\n   514→                  {formData.selectedAmenities.includes(amenity.id) && (\n   515→                    <Check size={10} className=\"text-white\" />\n   516→                  )}\n   517→                </div>\n   518→                <span className=\"text-sm text-text\">{amenity.name}</span>\n   519→              </label>\n   520→            ))}\n   521→          </div>\n   522→        </div>\n   523→      ))}\n   524→    </div>\n   525→  )\n   526→\n   527→  const renderStep5 = () => (\n   528→    <div data-testid=\"add-listing-step-5\">\n   529→      <h3 className=\"text-lg font-semibold text-text mb-4\">Photos</h3>\n   530→\n   531→      <div className=\"flex gap-2 mb-4\">\n   532→        <input\n   533→          data-testid=\"photo-url-input\"\n   534→          type=\"text\"\n   535→          value={photoUrl}\n   536→          onChange={(e) => setPhotoUrl(e.target.value)}\n   537→          onKeyDown={(e) => { if (e.key === 'Enter') { e.preventDefault(); handleAddPhoto() } }}\n   538→          placeholder=\"Enter image URL...\"\n   539→          className=\"flex-1 px-4 py-3 rounded-lg border border-border text-sm focus:outline-none focus:border-primary\"\n   540→        />\n   541→        <button\n   542→          type=\"button\"\n   543→          data-testid=\"add-photo-button\"\n   544→          onClick={handleAddPhoto}\n   545→          className=\"px-4 py-3 bg-primary text-white rounded-lg text-sm font-medium hover:bg-primary-dark transition-colors\"\n   546→        >\n   547→          Add Photo\n   548→        </button>\n   549→      </div>\n   550→\n   551→      {errors.photos && <p className=\"text-error text-xs mb-3\">{errors.photos}</p>}\n   552→\n   553→      {formData.photos.length > 0 && (\n   554→        <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-3\">\n   555→          {formData.photos.map((photo, index) => (\n   556→            <div key={index} data-testid={`photo-item-${index}`} className=\"relative group\">\n   557→              <div className=\"aspect-[4/3] rounded-lg overflow-hidden border border-border\">\n   558→                <img\n   559→                  src={photo.url}\n   560→                  alt={`Photo ${index + 1}`}\n   561→                  className=\"w-full h-full object-cover\"\n   562→                  onError={(e) => {\n   563→                    (e.target as HTMLImageElement).src = ''\n   564→                    ;(e.target as HTMLImageElement).alt = 'Failed to load'\n   565→                  }}\n   566→                />\n   567→              </div>\n   568→              <button\n   569→                type=\"button\"\n   570→                data-testid={`remove-photo-${index}`}\n   571→                onClick={() => handleRemovePhoto(index)}\n   572→                className=\"absolute top-2 right-2 w-7 h-7 bg-white/90 rounded-full flex items-center justify-center shadow-sm opacity-0 group-hover:opacity-100 transition-opacity hover:bg-white\"\n   573→              >\n   574→                <Trash2 size={14} className=\"text-status-cancelled\" />\n   575→              </button>\n   576→            </div>\n   577→          ))}\n   578→        </div>\n   579→      )}\n   580→    </div>\n   581→  )\n   582→\n   583→  const renderStep6 = () => (\n   584→    <div data-testid=\"add-listing-step-6\">\n   585→      <h3 className=\"text-lg font-semibold text-text mb-4\">Pricing</h3>\n   586→\n   587→      <div className=\"mb-4\">\n   588→        <label className=\"block text-sm font-medium text-text mb-1.5\">Price per Night *</label>\n   589→        <div className=\"relative\">\n   590→          <span className=\"absolute left-4 top-1/2 -translate-y-1/2 text-text-secondary\">$</span>\n   591→          <input\n   592→            data-testid=\"price-per-night-input\"\n   593→            type=\"text\"\n   594→            inputMode=\"decimal\"\n   595→            value={formData.pricePerNight}\n   596→            onChange={(e) => {\n   597→              const val = e.target.value.replace(/[^0-9.]/g, '')\n   598→              setFormData((prev) => ({ ...prev, pricePerNight: val }))\n   599→              if (errors.pricePerNight) setErrors((prev) => { const n = { ...prev }; delete n.pricePerNight; return n })\n   600→            }}\n   601→            placeholder=\"0\"\n   602→            className={`w-full pl-8 pr-4 py-3 rounded-lg border ${\n   603→              errors.pricePerNight ? 'border-error' : 'border-border'\n   604→            } text-sm focus:outline-none focus:border-primary`}\n   605→          />\n   606→        </div>\n   607→        {errors.pricePerNight && <p className=\"text-error text-xs mt-1\">{errors.pricePerNight}</p>}\n   608→      </div>\n   609→\n   610→      <div className=\"mb-4\">\n   611→        <label className=\"block text-sm font-medium text-text mb-1.5\">Cleaning Fee</label>\n   612→        <div className=\"relative\">\n   613→          <span className=\"absolute left-4 top-1/2 -translate-y-1/2 text-text-secondary\">$</span>\n   614→          <input\n   615→            data-testid=\"cleaning-fee-input\"\n   616→            type=\"text\"\n   617→            inputMode=\"decimal\"\n   618→            value={formData.cleaningFee}\n   619→            onChange={(e) => {\n   620→              const val = e.target.value.replace(/[^0-9.]/g, '')\n   621→              setFormData((prev) => ({ ...prev, cleaningFee: val }))\n   622→            }}\n   623→            placeholder=\"0\"\n   624→            className=\"w-full pl-8 pr-4 py-3 rounded-lg border border-border text-sm focus:outline-none focus:border-primary\"\n   625→          />\n   626→        </div>\n   627→      </div>\n   628→    </div>\n   629→  )\n   630→\n   631→  const renderStep7 = () => {\n   632→    const selectedAmenityNames = amenities\n   633→      .filter((a) => formData.selectedAmenities.includes(a.id))\n   634→      .map((a) => a.name)\n   635→\n   636→    return (\n   637→      <div data-testid=\"add-listing-step-7\">\n   638→        <h3 className=\"text-lg font-semibold text-text mb-4\">Review & Publish</h3>\n   639→\n   640→        {errors.publish && (\n   641→          <div className=\"bg-error/10 text-error text-sm px-4 py-3 rounded-lg mb-4\">{errors.publish}</div>\n   642→        )}\n   643→\n   644→        <div className=\"space-y-4\">\n   645→          <div className=\"bg-bg-secondary rounded-lg p-4\">\n   646→            <h4 className=\"text-xs font-semibold text-text-secondary uppercase tracking-wide mb-2\">Property</h4>\n   647→            <p className=\"text-sm\"><strong>Type:</strong> {formData.propertyType}</p>\n   648→            <p className=\"text-sm\"><strong>Title:</strong> {formData.title}</p>\n   649→          </div>\n   650→\n   651→          <div className=\"bg-bg-secondary rounded-lg p-4\">\n   652→            <h4 className=\"text-xs font-semibold text-text-secondary uppercase tracking-wide mb-2\">Location</h4>\n   653→            <p className=\"text-sm\">\n   654→              {[formData.address, formData.city, formData.state, formData.country].filter(Boolean).join(', ')}\n   655→            </p>\n   656→          </div>\n   657→\n   658→          <div className=\"bg-bg-secondary rounded-lg p-4\">\n   659→            <h4 className=\"text-xs font-semibold text-text-secondary uppercase tracking-wide mb-2\">Details</h4>\n   660→            <div className=\"grid grid-cols-2 gap-2 text-sm\">\n   661→              <p><strong>Guests:</strong> {formData.maxGuests}</p>\n   662→              <p><strong>Bedrooms:</strong> {formData.bedrooms}</p>\n   663→              <p><strong>Beds:</strong> {formData.beds}</p>\n   664→              <p><strong>Bathrooms:</strong> {formData.bathrooms}</p>\n   665→            </div>\n   666→          </div>\n   667→\n   668→          {selectedAmenityNames.length > 0 && (\n   669→            <div className=\"bg-bg-secondary rounded-lg p-4\">\n   670→              <h4 className=\"text-xs font-semibold text-text-secondary uppercase tracking-wide mb-2\">Amenities</h4>\n   671→              <p className=\"text-sm\">{selectedAmenityNames.join(', ')}</p>\n   672→            </div>\n   673→          )}\n   674→\n   675→          {formData.photos.length > 0 && (\n   676→            <div className=\"bg-bg-secondary rounded-lg p-4\">\n   677→              <h4 className=\"text-xs font-semibold text-text-secondary uppercase tracking-wide mb-2\">Photos</h4>\n   678→              <div className=\"flex gap-2 overflow-x-auto\">\n   679→                {formData.photos.map((photo, i) => (\n   680→                  <div key={i} className=\"w-20 h-16 rounded-lg overflow-hidden shrink-0 border border-border\">\n   681→                    <img src={photo.url} alt={`Photo ${i + 1}`} className=\"w-full h-full object-cover\" />\n   682→                  </div>\n   683→                ))}\n   684→              </div>\n   685→            </div>\n   686→          )}\n   687→\n   688→          <div className=\"bg-bg-secondary rounded-lg p-4\">\n   689→            <h4 className=\"text-xs font-semibold text-text-secondary uppercase tracking-wide mb-2\">Pricing</h4>\n   690→            <p className=\"text-sm\"><strong>Price per night:</strong> ${formData.pricePerNight}</p>\n   691→            <p className=\"text-sm\"><strong>Cleaning fee:</strong> ${formData.cleaningFee || '0'}</p>\n   692→          </div>\n   693→        </div>\n   694→      </div>\n   695→    )\n   696→  }\n   697→\n   698→  return (\n   699→    <div\n   700→      data-testid=\"add-listing-form\"\n   701→      className=\"fixed inset-0 bg-black/50 flex items-center justify-center z-50\"\n   702→    >\n   703→      <div className=\"bg-white rounded-xl w-full max-w-2xl max-h-[90vh] overflow-y-auto mx-4 shadow-lg\">\n   704→        <div className=\"sticky top-0 bg-white border-b border-border px-6 py-4 flex items-center justify-between z-10\">\n   705→          <h2 className=\"text-lg font-semibold text-text\">Add New Listing</h2>\n   706→          <button\n   707→            data-testid=\"add-listing-close\"\n   708→            onClick={handleCancel}\n   709→            className=\"w-8 h-8 rounded-full hover:bg-bg-secondary flex items-center justify-center transition-colors\"\n   710→          >\n   711→            <X size={20} className=\"text-text-secondary\" />\n   712→          </button>\n   713→        </div>\n   714→\n   715→        <div className=\"px-6 py-6\">\n   716→          {renderStepIndicator()}\n   717→\n   718→          {step === 1 && renderStep1()}\n   719→          {step === 2 && renderStep2()}\n   720→          {step === 3 && renderStep3()}\n   721→          {step === 4 && renderStep4()}\n   722→          {step === 5 && renderStep5()}\n   723→          {step === 6 && renderStep6()}\n   724→          {step === 7 && renderStep7()}\n   725→        </div>\n   726→\n   727→        <div className=\"sticky bottom-0 bg-white border-t border-border px-6 py-4 flex items-center justify-between\">\n   728→          <button\n   729→            data-testid=\"add-listing-cancel\"\n   730→            onClick={handleCancel}\n   731→            className=\"px-4 py-2.5 text-sm font-medium text-text-secondary hover:text-text transition-colors\"\n   732→          >\n   733→            Cancel\n   734→          </button>\n   735→          <div className=\"flex gap-3\">\n   736→            {step > 1 && (\n   737→              <button\n   738→                data-testid=\"add-listing-back\"\n   739→                onClick={handleBack}\n   740→                className=\"flex items-center gap-1.5 px-4 py-2.5 text-sm font-medium text-text bg-bg-secondary rounded-lg hover:bg-border transition-colors\"\n   741→              >\n   742→                <ChevronLeft size={16} />\n   743→                Back\n   744→              </button>\n   745→            )}\n   746→            {step < TOTAL_STEPS ? (\n   747→              <button\n   748→                data-testid=\"add-listing-next\"\n   749→                onClick={handleNext}\n   750→                className=\"flex items-center gap-1.5 px-4 py-2.5 text-sm font-medium text-white bg-primary rounded-lg hover:bg-primary-dark transition-colors\"\n   751→              >\n   752→                Next\n   753→                <ChevronRight size={16} />\n   754→              </button>\n   755→            ) : (\n   756→              <button\n   757→                data-testid=\"add-listing-publish\"\n   758→                onClick={handlePublish}\n   759→                disabled={publishing}\n   760→                className=\"flex items-center gap-1.5 px-6 py-2.5 text-sm font-medium text-white bg-primary rounded-lg hover:bg-primary-dark transition-colors disabled:opacity-50\"\n   761→              >\n   762→                {publishing ? (\n   763→                  <>\n   764→                    <Loader2 size={16} className=\"animate-spin\" />\n   765→                    Publishing...\n   766→                  </>\n   767→                ) : (\n   768→                  'Publish'\n   769→                )}\n   770→              </button>\n   771→            )}\n   772→          </div>\n   773→        </div>\n   774→      </div>\n   775→\n   776→      {showDiscardDialog && (\n   777→        <div\n   778→          data-testid=\"discard-dialog\"\n   779→          className=\"fixed inset-0 bg-black/50 flex items-center justify-center z-[60]\"\n   780→          onClick={() => setShowDiscardDialog(false)}\n   781→        >\n   782→          <div\n   783→            className=\"bg-white rounded-xl p-6 max-w-md w-full mx-4 shadow-lg\"\n   784→            onClick={(e) => e.stopPropagation()}\n   785→          >\n   786→            <h3 className=\"text-lg font-semibold text-text mb-2\">Discard your listing?</h3>\n   787→            <p className=\"text-text-secondary mb-6\">All entered information will be lost.</p>\n   788→            <div className=\"flex gap-3 justify-end\">\n   789→              <button\n   790→                data-testid=\"discard-dialog-keep\"\n   791→                onClick={() => setShowDiscardDialog(false)}\n   792→                className=\"px-4 py-2 text-sm font-medium text-text bg-bg-secondary rounded-lg hover:bg-border transition-colors\"\n   793→              >\n   794→                Keep Editing\n   795→              </button>\n   796→              <button\n   797→                data-testid=\"discard-dialog-confirm\"\n   798→                onClick={onClose}\n   799→                className=\"px-4 py-2 text-sm font-medium text-white bg-status-cancelled rounded-lg hover:opacity-90 transition-opacity\"\n   800→              >\n   801→                Discard\n   802→              </button>\n   803→            </div>\n   804→          </div>\n   805→        </div>\n   806→      )}\n   807→    </div>\n   808→  )\n   809→}\n   810→"}]},"parent_tool_use_id":"toolu_01Pj9Z7o2XYGjwCjrWhWg5SM","session_id":"f2dc69e2-bd3d-45b0-ab90-8317c8b03401","uuid":"68aede9d-ff9b-4e1a-9142-60f8383db714"}
