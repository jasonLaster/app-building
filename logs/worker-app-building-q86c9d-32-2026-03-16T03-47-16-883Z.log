lassName=\"bg-primary text-white px-6 py-3 rounded-lg font-medium hover:bg-primary-dark transition-colors\"\n    91→          >\n    92→            Go to Profile\n    93→          </button>\n    94→        </div>\n    95→      </div>\n    96→    )\n    97→  }\n    98→\n    99→  return (\n   100→    <div data-testid=\"host-dashboard\" className=\"p-6 max-sm:p-3\">\n   101→      <div className=\"max-w-6xl mx-auto\">\n   102→        <h1 className=\"text-2xl font-bold text-text mb-6\">Host Dashboard</h1>\n   103→\n   104→        <StatsOverview stats={stats} loading={statsLoading} />\n   105→\n   106→        <div className=\"mt-8 mb-6\">\n   107→          <div className=\"flex border-b border-border\">\n   108→            <button\n   109→              data-testid=\"tab-listings\"\n   110→              onClick={() => setActiveTab('listings')}\n   111→              className={`px-6 py-3 text-sm font-medium border-b-2 transition-colors ${\n   112→                activeTab === 'listings'\n   113→                  ? 'border-primary text-primary'\n   114→                  : 'border-transparent text-text-secondary hover:text-text'\n   115→              }`}\n   116→            >\n   117→              Listings\n   118→            </button>\n   119→            <button\n   120→              data-testid=\"tab-bookings\"\n   121→              onClick={() => setActiveTab('bookings')}\n   122→              className={`px-6 py-3 text-sm font-medium border-b-2 transition-colors ${\n   123→                activeTab === 'bookings'\n   124→                  ? 'border-primary text-primary'\n   125→                  : 'border-transparent text-text-secondary hover:text-text'\n   126→              }`}\n   127→            >\n   128→              Bookings\n   129→            </button>\n   130→          </div>\n   131→        </div>\n   132→\n   133→        {activeTab === 'listings' && (\n   134→          <ListingsTab\n   135→            listings={listings}\n   136→            loading={listingsLoading}\n   137→            onDeactivate={handleDeactivate}\n   138→            onActivate={handleActivate}\n   139→            onAddListing={() => setShowAddForm(true)}\n   140→          />\n   141→        )}\n   142→\n   143→        {activeTab === 'bookings' && (\n   144→          <BookingsTab\n   145→            bookings={bookings}\n   146→            loading={bookingsLoading}\n   147→            onConfirm={handleConfirmBooking}\n   148→            onCancel={handleCancelBooking}\n   149→          />\n   150→        )}\n   151→\n   152→        {showAddForm && (\n   153→          <AddListingForm\n   154→            hostId={currentUser.id}\n   155→            onClose={() => setShowAddForm(false)}\n   156→            onSuccess={handleAddListingSuccess}\n   157→          />\n   158→        )}\n   159→      </div>\n   160→    </div>\n   161→  )\n   162→}\n   163→"}]},"parent_tool_use_id":null,"session_id":"7ad3c362-059b-401b-af91-0b063664010f","uuid":"608b2675-e302-4980-b89c-bc012d1c212d","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/pages/HostDashboard.tsx","content":"import { useState, useEffect, useCallback } from 'react'\nimport { useSelector, useDispatch } from 'react-redux'\nimport { useNavigate } from 'react-router-dom'\nimport type { RootState, AppDispatch } from '../store'\nimport {\n  fetchHostStats,\n  fetchHostListings,\n  fetchHostBookings,\n  deactivateProperty,\n  activateProperty,\n  updateHostBookingStatus,\n} from '../slices/hostSlice'\nimport type { Property } from '../slices/propertiesSlice'\nimport StatsOverview from '../components/StatsOverview'\nimport ListingsTab from '../components/ListingsTab'\nimport BookingsTab from '../components/BookingsTab'\nimport AddListingForm from '../components/AddListingForm'\n\ntype Tab = 'listings' | 'bookings'\n\nexport default function HostDashboard() {\n  const dispatch = useDispatch<AppDispatch>()\n  const navigate = useNavigate()\n  const currentUser = useSelector((state: RootState) => state.auth.currentUser)\n  const { stats, listings, bookings, statsLoading, listingsLoading, bookingsLoading } = useSelector(\n    (state: RootState) => state.host\n  )\n  const [activeTab, setActiveTab] = useState<Tab>('listings')\n  const [showAddForm, setShowAddForm] = useState(false)\n\n  useEffect(() => {\n    if (!currentUser) {\n      navigate('/login')\n    }\n  }, [currentUser, navigate])\n\n  useEffect(() => {\n    if (currentUser?.is_host) {\n      dispatch(fetchHostStats(currentUser.id))\n      dispatch(fetchHostListings(currentUser.id))\n      dispatch(fetchHostBookings(currentUser.id))\n    }\n  }, [dispatch, currentUser])\n\n  const handleDeactivate = useCallback(async (property: Property) => {\n    await dispatch(deactivateProperty(property.id))\n  }, [dispatch])\n\n  const handleActivate = useCallback(async (property: Property) => {\n    await dispatch(activateProperty(property.id))\n  }, [dispatch])\n\n  const handleConfirmBooking = useCallback(async (bookingId: string) => {\n    await dispatch(updateHostBookingStatus({ bookingId, status: 'confirmed' }))\n    if (currentUser) {\n      dispatch(fetchHostStats(currentUser.id))\n    }\n  }, [dispatch, currentUser])\n\n  const handleCancelBooking = useCallback(async (bookingId: string) => {\n    await dispatch(updateHostBookingStatus({ bookingId, status: 'cancelled' }))\n    if (currentUser) {\n      dispatch(fetchHostStats(currentUser.id))\n    }\n  }, [dispatch, currentUser])\n\n  const handleAddListingSuccess = useCallback(() => {\n    setShowAddForm(false)\n    if (currentUser) {\n      dispatch(fetchHostStats(currentUser.id))\n      dispatch(fetchHostListings(currentUser.id))\n    }\n  }, [dispatch, currentUser])\n\n  if (!currentUser) {\n    return null\n  }\n\n  if (!currentUser.is_host) {\n    return (\n      <div data-testid=\"host-dashboard\" className=\"p-6 max-sm:p-3\">\n        <div className=\"max-w-lg mx-auto text-center py-16\">\n          <h1 className=\"text-2xl font-bold text-text mb-4\">Become a Host</h1>\n          <p className=\"text-text-secondary mb-6\">\n            You need to become a host to access this page. Visit your profile to get started.\n          </p>\n          <button\n            data-testid=\"become-host-link\"\n            onClick={() => navigate('/profile')}\n            className=\"bg-primary text-white px-6 py-3 rounded-lg font-medium hover:bg-primary-dark transition-colors\"\n          >\n            Go to Profile\n          </button>\n        </div>\n      </div>\n    )\n  }\n\n  return (\n    <div data-testid=\"host-dashboard\" className=\"p-6 max-sm:p-3\">\n      <div className=\"max-w-6xl mx-auto\">\n        <h1 className=\"text-2xl font-bold text-text mb-6\">Host Dashboard</h1>\n\n        <StatsOverview stats={stats} loading={statsLoading} />\n\n        <div className=\"mt-8 mb-6\">\n          <div className=\"flex border-b border-border\">\n            <button\n              data-testid=\"tab-listings\"\n              onClick={() => setActiveTab('listings')}\n              className={`px-6 py-3 text-sm font-medium border-b-2 transition-colors ${\n                activeTab === 'listings'\n                  ? 'border-primary text-primary'\n                  : 'border-transparent text-text-secondary hover:text-text'\n              }`}\n            >\n              Listings\n            </button>\n            <button\n              data-testid=\"tab-bookings\"\n              onClick={() => setActiveTab('bookings')}\n              className={`px-6 py-3 text-sm font-medium border-b-2 transition-colors ${\n                activeTab === 'bookings'\n                  ? 'border-primary text-primary'\n                  : 'border-transparent text-text-secondary hover:text-text'\n              }`}\n            >\n              Bookings\n            </button>\n          </div>\n        </div>\n\n        {activeTab === 'listings' && (\n          <ListingsTab\n            listings={listings}\n            loading={listingsLoading}\n            onDeactivate={handleDeactivate}\n            onActivate={handleActivate}\n            onAddListing={() => setShowAddForm(true)}\n          />\n        )}\n\n        {activeTab === 'bookings' && (\n          <BookingsTab\n            bookings={bookings}\n            loading={bookingsLoading}\n            onConfirm={handleConfirmBooking}\n            onCancel={handleCancelBooking}\n          />\n        )}\n\n        {showAddForm && (\n          <AddListingForm\n            hostId={currentUser.id}\n            onClose={() => setShowAddForm(false)}\n            onSuccess={handleAddListingSuccess}\n          />\n        )}\n      </div>\n    </div>\n  )\n}\n","numLines":163,"startLine":1,"totalLines":163}}}
