ctionLoading(null)\n    40→  }\n    41→\n    42→  const handleCancelClick = (booking: HostBooking) => {\n    43→    setCancelDialog(booking)\n    44→  }\n    45→\n    46→  const handleConfirmCancel = async () => {\n    47→    if (!cancelDialog) return\n    48→    setActionLoading(cancelDialog.id)\n    49→    await onCancel(cancelDialog.id)\n    50→    setActionLoading(null)\n    51→    setCancelDialog(null)\n    52→  }\n    53→\n    54→  if (loading) {\n    55→    return (\n    56→      <div className=\"flex items-center justify-center py-16\">\n    57→        <Loader2 size={32} className=\"animate-spin text-primary\" />\n    58→      </div>\n    59→    )\n    60→  }\n    61→\n    62→  return (\n    63→    <div data-testid=\"bookings-tab\">\n    64→      <div className=\"flex items-center gap-2 mb-6 flex-wrap\">\n    65→        {STATUS_FILTERS.map((filter) => (\n    66→          <button\n    67→            key={filter}\n    68→            data-testid={`booking-filter-${filter.toLowerCase()}`}\n    69→            onClick={() => setActiveFilter(filter)}\n    70→            className={`px-4 py-2 rounded-full text-sm font-medium transition-colors ${\n    71→              activeFilter === filter\n    72→                ? 'bg-primary text-white'\n    73→                : 'bg-bg-secondary text-text-secondary hover:bg-border'\n    74→            }`}\n    75→          >\n    76→            {filter}\n    77→          </button>\n    78→        ))}\n    79→      </div>\n    80→\n    81→      {filteredBookings.length === 0 ? (\n    82→        <div data-testid=\"bookings-empty-state\" className=\"text-center py-16\">\n    83→          <Calendar size={48} className=\"mx-auto text-text-secondary mb-4 opacity-50\" />\n    84→          <p className=\"text-text-secondary text-lg\">\n    85→            {activeFilter === 'All' ? 'No bookings yet' : `No ${activeFilter.toLowerCase()} bookings`}\n    86→          </p>\n    87→        </div>\n    88→      ) : (\n    89→        <div classNam