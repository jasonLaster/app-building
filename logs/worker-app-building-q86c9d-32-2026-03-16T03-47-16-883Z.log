[2026-03-16T03:40:05.333Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01THuu7ghyN7LQWGJJyvWcwi","type":"tool_result","content":"     1→import { useState, useEffect, useCallback, useRef } from 'react'\n     2→import { useSelector, useDispatch } from 'react-redux'\n     3→import { X, Plus, Trash2, ChevronLeft, ChevronRight, Minus, Check, Loader2 } from 'lucide-react'\n     4→import type { RootState, AppDispatch } from '../store'\n     5→import type { Amenity } from '../slices/propertiesSlice'\n     6→import { fetchAmenities } from '../slices/amenitiesSlice'\n     7→import { createProperty } from '../slices/hostSlice'\n     8→\n     9→interface AddListingFormProps {\n    10→  hostId: string\n    11→  onClose: () => void\n    12→  onSuccess: () => void\n    13→}\n    14→\n    15→interface FormData {\n    16→  propertyType: string\n    17→  title: string\n    18→  address: string\n    19→  city: string\n    20→  state: string\n    21→  country: string\n    22→  latitude: number | null\n    23→  longitude: number | null\n    24→  maxGuests: number\n    25→  bedrooms: number\n    26→  beds: number\n    27→  bathrooms: number\n    28→  selectedAmenities: string[]\n    29→  photos: { url: string; caption: string }[]\n    30→  pricePerNight: string\n    31→  cleaningFee: string\n    32→  description: string\n    33→}\n    34→\n    35→const PROPERTY_TYPES = ['Apartment', 'House', 'Cabin', 'Villa', 'Condo', 'Loft', 'Cottage', 'Townhouse']\n    36→const TOTAL_STEPS = 7\n    37→\n    38→const initialFormData: FormData = {\n    39→  propertyType: '',\n    40→  title: '',\n    41→  address: '',\n    42→  city: '',\n    43→  state: '',\n    44→  country: '',\n    45→  latitude: null,\n    46→  longitude: null,\n    47→  maxGuests: 1,\n    48→  bedrooms: 1,\n    49→  beds: 1,\n    50→  bathrooms: 1,\n    51→  selectedAmenities: [],\n    52→  photos: [],\n    53→  pricePerNight: '',\n    54→  cleaningFee: '0',\n    55→  description: '',\n    56→}\n    57→\n    58→interface AddressSuggestion {\n    59→  display_name: string\n    60→  address?: {\n    61→    road?: string\n    62→    house_number?: string\n    63→    city?: string\n    64→    town?: string\n    65→    village?: string\n    66→    state?: string\n    67→    country?: string\n    68→  }\n    69→  lat: string\n    70→  lon: string\n    71→}\n    72→\n    73→export default function AddListingForm({ hostId, onClose, onSuccess }: AddListingFormProps) {\n    74→  const dispatch = useDispatch<AppDispatch>()\n    75→  const amenities = useSelector((state: RootState) => state.amenities.items)\n    76→  const [step, setStep] = useState(1)\n    77→  const [formData, setFormData] = useState<FormData>(initialFormData)\n    78→  const [errors, setErrors] = useState<Record<string, string>>({})\n    79→  const [showDiscardDialog, setShowDiscardDialog] = useState(false)\n    80→  const [publishing, setPublishing] = useState(false)\n    81→  const [photoUrl, setPhotoUrl] = useState('')\n    82→  const [addressSuggestions, setAddressSuggestions] = useState<AddressSuggestion[]>([])\n    83→  const [showSuggestions, setShowSuggestions] = useState(false)\n    84→  const [propertyTypeOpen, setPropertyTypeOpen] = useState(false)\n    85→  const propertyTypeRef = useRef<HTMLDivElement>(null)\n    86→  const debounceRef = useRef<ReturnType<typeof setTimeout> | null>(null)\n    87→\n    88→  useEffect(() => {\n    89→    if (amenities.length === 0) {\n    90→      dispatch(fetchAmenities())\n    91→    }\n    92→  }, [dispatch, amenities.length])\n    93→\n    94→  useEffect(() => {\n    95→    if (!propertyTypeOpen) return\n    96→    const handleClickOutside = (e: MouseEvent) => {\n    97→      if (propertyTypeRef.current && !propertyTypeRef.current.contains(e.target as Node)) {\n    98→        setPropertyTypeOpen(false)\n    99→      }\n   100→    }\n   101→    document.addEventListener('mousedown', handleClickOutside)\n   102→    return () => document.removeEventListener('mousedown', handleClickOutside)\n   103→  }, [propertyTypeOpen])\n   104→\n   105→  const fetchAddressSuggestions = useCallback(async (query: string) => {\n   106→    if (query.length < 3) {\n   107→      setAddressSuggestions([])\n   108→      return\n   109→    }\n   110→    try {\n   111→      const response = await fetch(\n   112→        `https://nominatim.openstreetmap.org/search?format=json&addressdetails=1&q=${encodeURIComponent(query)}&limit=5`\n   113→      )\n   114→      const data = await response.json() as AddressSuggestion[]\n   115→      setAddressSuggestions(data)\n   116→      setShowSuggestions(true)\n   117→    } catch {\n   118→      setAddressSuggestions([])\n   119→    }\n   120→  }, [])\n   121→\n   122→  const handleAddressChange = (value: string) => {\n   123→    setFormData((prev) => ({ ...prev, address: value }))\n   124→    if (debounceRef.current) clearTimeout(debounceRef.current)\n   125→    debounceRef.current = setTimeout(() => {\n   126→      fetchAddressSuggestions(value)\n   127→    }, 300)\n   128→  }\n   129→\n   130→  const handleSelectSuggestion = (suggestion: AddressSuggestion) => {\n   131→    const addr = suggestion.address\n   132→    const road = addr?.house_number ? `${addr.house_number} ${addr.road || ''}` : (addr?.road || '')\n   133→    setFormData((prev) => ({\n   134→      ...prev,\n   135→      address: road || suggestion.display_name,\n   136→      city: addr?.city || addr?.town || addr?.village || '',\n   137→      state: addr?.state || '',\n   138→      country: addr?.country || '',\n   139→      latitude: parseFloat(suggestion.lat),\n   140→      longitude: parseFloat(suggestion.lon),\n   141→    }))\n   142→    setShowSuggestions(false)\n   143→    setAddressSuggestions([])\n   144→  }\n   145→\n   146→  const validateStep = (): boolean => {\n   147→    const newErrors: Record<string, string> = {}\n   148→\n   149→    if (step === 1) {\n   150→      if (!formData.propertyType) newErrors.propertyType = 'Property type is required'\n   151→      if (!formData.title.trim()) newErrors.title = 'Title is required'\n   152→    } else if (step === 2) {\n   153→      if (!formData.city.trim()) newErrors.city = 'City is required'\n   154→      if (!formData.country.trim()) newErrors.country = 'Country is required'\n   155→    } else if (step === 3) {\n   156→      if (formData.maxGuests < 1) newErrors.maxGuests = 'Max guests must be at least 1'\n   157→      if (formData.bedrooms < 1) newErrors.bedrooms = 'At least 1 bedroom is required'\n   158→      if (formData.beds < 1) newErrors.beds = 'At least 1 bed is required'\n   159→      if (formData.bathrooms < 1) newErrors.bathrooms = 'At least 1 bathroom is required'\n   160→    } else if (step === 5) {\n   161→      if (formData.photos.length === 0) newErrors.photos = 'At least one photo is required'\n   162→    } else if (step === 6) {\n   163→      const price = parseFloat(formData.pricePerNight)\n   164→      if (!price || price <= 0) newErrors.pricePerNight = 'Price per night is required and must be greater than 0'\n   165→    }\n   166→\n   167→    setErrors(newErrors)\n   168→    return Object.keys(newErrors).length === 0\n   169→  }\n   170→\n   171→  const handleNext = () => {\n   172→    if (validateStep()) {\n   173→      setStep((s) => Math.min(s + 1, TOTAL_STEPS))\n   174→    }\n   175→  }\n   176→\n   177→  const handleBack = () => {\n   178→    setErrors({})\n   179→    setStep((s) => Math.max(s - 1, 1))\n   180→  }\n   181→\n   182→  const handleAddPhoto = () => {\n   183→    if (!photoUrl.trim()) return\n   184→    setFormData((prev) => ({\n   185→      ...prev,\n   186→      photos: [...prev.photos, { url: photoUrl.trim(), caption: '' }],\n   187→    }))\n   188→    setPhotoUrl('')\n   189→    setErrors((prev) => {\n   190→      const next = { ...prev }\n   191→      delete next.photos\n   192→      return next\n   193→    })\n   194→  }\n   195→\n   196→  const handleRemovePhoto = (index: number) => {\n   197→    setFormData((prev) => ({\n   198→      ...prev,\n   199→      photos: prev.photos.filter((_, i) => i !== index),\n   200→    }))\n   201→  }\n   202→\n   203→  const toggleAmenity = (amenityId: string) => {\n   204→    setFormData((prev) => ({\n   205→      ...prev,\n   206→      selectedAmenities: prev.selectedAmenities.includes(amenityId)\n   207→        ? prev.selectedAmenities.filter((id) => id !== amenityId)\n   208→        : [...prev.selectedAmenities, amenityId],\n   209→    }))\n   210→  }\n   211→\n   212→  const handlePublish = async () => {\n   213→    setPublishing(true)\n   214→    try {\n   215→      const result = await dispatch(createProperty({\n   216→        host_id: hostId,\n   217→        title: formData.title,\n   218→        description: formData.description,\n   219→        property_type: formData.propertyType,\n   220→        price_per_night: parseFloat(formData.pricePerNight),\n   221→        cleaning_fee: parseFloat(formData.cleaningFee) || 0,\n   222→        max_guests: formData.maxGuests,\n   223→        bedrooms: formData.bedrooms,\n   224→        beds: formData.beds,\n   225→        bathrooms: formData.bathrooms,\n   226→        address: formData.address,\n   227→        city: formData.city,\n   228→        state: formData.state || null,\n   229→        country: formData.country,\n   230→        latitude: formData.latitude,\n   231→        longitude: formData.longitude,\n   232→        amenity_ids: formData.selectedAmenities,\n   233→      })).unwrap()\n   234→\n   235→      const propertyId = result.id\n   236→\n   237→      for (let i = 0; i < formData.photos.length; i++) {\n   238→        const photo = formData.photos[i]\n   239→        if (photo) {\n   240→          await fetch('/api/property-images', {\n   241→            method: 'POST',\n   242→            headers: { 'Content-Type': 'application/json' },\n   243→            body: JSON.stringify({\n   244→              property_id: propertyId,\n   245→              url: photo.url,\n   246→              caption: photo.caption,\n   247→              display_order: i,\n   248→            }),\n   249→          })\n   250→        }\n   251→      }\n   252→\n   253→      onSuccess()\n   254→    } catch {\n   255→      setErrors({ publish: 'Failed to publish listing. Please try again.' })\n   256→    } finally {\n   257→      setPublishing(false)\n   258→    }\n   259→  }\n   260→\n   261→  const handleCancel = () => {\n   262→    setShowDiscardDialog(true)\n   263→  }\n   264→\n   265→  const incrementField = (field: 'maxGuests' | 'bedrooms' | 'beds' | 'bathrooms') => {\n   266→    setFormData((prev) => ({ ...prev, [field]: prev[field] + 1 }))\n   267→  }\n   268→\n   269→  const decrementField = (field: 'maxGuests' | 'bedrooms' | 'beds' | 'bathrooms') => {\n   270→    setFormData((prev) => ({ ...prev, [field]: Math.max(0, prev[field] - 1) }))\n   271→  }\n   272→\n   273→  const amenitiesByCategory = amenities.reduce<Record<string, Amenity[]>>((acc, amenity) => {\n   274→    const cat = amenity.category || 'Other'\n   275→    if (!acc[cat]) acc[cat] = []\n   276→    acc[cat].push(amenity)\n   277→    return acc\n   278→  }, {})\n   279→\n   280→  const renderStepIndicator = () => (\n   281→    <div data-testid=\"step-indicator\" className=\"flex items-center justify-center gap-2 mb-6\">\n   282→      {Array.from({ length: TOTAL_STEPS }, (_, i) => i + 1).map((s) => (\n   283→        <div\n   284→          key={s}\n   285→          className={`w-8 h-8 rounded-full flex items-center justify-center text-xs font-medium transition-colors ${\n   286→            s < step\n   287→              ? 'bg-primary text-white'\n   288→              : s === step\n   289→                ? 'bg-primary text-white'\n   290→                : 'bg-bg-secondary text-text-secondary'\n   291→          }`}\n   292→        >\n   293→          {s < step ? <Check size={14} /> : s}\n   294→        </div>\n   295→      ))}\n   296→      <span className=\"ml-2 text-sm text-text-secondary\">Step {step} of {TOTAL_STEPS}</span>\n   297→    </div>\n   298→  )\n   299→\n   300→  const renderStep1 = () => (\n   301→    <div data-testid=\"add-listing-step-1\">\n   302→      <h3 className=\"text-lg font-semibold text-text mb-4\">Property Type & Title</h3>\n   303→\n   304→      <div className=\"mb-4\">\n   305→        <label className=\"block text-sm font-medium text-text mb-1.5\">Property Type *</label>\n   306→        <div className=\"relative\" ref={propertyTypeRef}>\n   307→          <button\n   308→            type=\"button\"\n   309→            data-testid=\"property-type-select\"\n   310→            onClick={() => setPropertyTypeOpen(!propertyTypeOpen)}\n   311→            className={`w-full text-left px-4 py-3 rounded-lg border ${\n   312→              errors.propertyType ? 'border-error' : 'border-border'\n   313→            } bg-white text-sm focus:outline-none focus:border-primary`}\n   314→          >\n   315→            {formData.propertyType || 'Select property type...'}\n   316→          </button>\n   317→          {propertyTypeOpen && (\n   318→            <div className=\"absolute top-full left-0 right-0 mt-1 bg-white border border-border rounded-lg shadow-lg z-10 max-h-60 overflow-y-auto\">\n   319→              {PROPERTY_TYPES.map((type) => (\n   320→                <button\n   321→                  key={type}\n   322→                  type=\"button\"\n   323→                  data-testid={`property-type-option-${type.toLowerCase()}`}\n   324→                  onClick={() => {\n   325→                    setFormData((prev) => ({ ...prev, propertyType: type }))\n   326→                    setPropertyTypeOpen(false)\n   327→                    setErrors((prev) => {\n   328→                      const next = { ...prev }\n   329→                      delete next.propertyType\n   330→                      return next\n   331→                    })\n   332→                  }}\n   333→                  className={`w-full text-left px-4 py-2.5 text-sm hover:bg-bg-secondary transition-colors ${\n   334→                    formData.propertyType === type ? 'bg-primary/10 text-primary font-medium' : 'text-text'\n   335→                  }`}\n   336→                >\n   337→                  {type}\n   338→                </button>\n   339→              ))}\n   340→            </div>\n   341→          )}\n   342→        </div>\n   343→        {errors.propertyType && <p className=\"text-error text-xs mt-1\">{errors.propertyType}</p>}\n   344→      </div>\n   345→\n   346→      <div className=\"mb-4\">\n   347→        <label className=\"block text-sm font-medium text-text mb-1.5\">Title *</label>\n   348→        <input\n   349→          data-testid=\"listing-title-input\"\n   350→          type=\"text\"\n   351→          value={formData.title}\n   352→          onChange={(e) => {\n   353→            setFormData((prev) => ({ ...prev, title: e.target.value }))\n   354→            if (errors.title) setErrors((prev) => { const n = { ...prev }; delete n.title; return n })\n   355→          }}\n   356→          placeholder=\"Give your place a catchy title\"\n   357→          className={`w-full px-4 py-3 rounded-lg border ${\n   358→            errors.title ? 'border-error' : 'border-border'\n   359→          } text-sm focus:outline-none focus:border-primary`}\n   360→        />\n   361→        {errors.title && <p className=\"text-error text-xs mt-1\">{errors.title}</p>}\n   362→      </div>\n   363→    </div>\n   364→  )\n   365→\n   366→  const renderStep2 = () => (\n   367→    <div data-testid=\"add-listing-step-2\">\n   368→      <h3 className=\"text-lg font-semibold text-text mb-4\">Location</h3>\n   369→\n   370→      <div className=\"mb-4 relative\">\n   371→        <label className=\"block text-sm font-medium text-text mb-1.5\">Address</label>\n   372→        <input\n   373→          data-testid=\"listing-address-input\"\n   374→          type=\"text\"\n   375→          value={formData.address}\n   376→          onChange={(e) => handleAddressChange(e.target.value)}\n   377→          onFocus={() => { if (addressSuggestions.length > 0) setShowSuggestions(true) }}\n   378→          placeholder=\"Start typing an address...\"\n   379→          className=\"w-full px-4 py-3 rounded-lg border border-border text-sm focus:outline-none focus:border-primary\"\n   380→        />\n   381→        {showSuggestions && addressSuggestions.length > 0 && (\n   382→          <div\n   383→            data-testid=\"address-suggestions\"\n   384→            className=\"absolute top-full left-0 right-0 mt-1 bg-white border border-border rounded-lg shadow-lg z-10 max-h-48 overflow-y-auto\"\n   385→          >\n   386→            {addressSuggestions.map((s, i) => (\n   387→              <button\n   388→                key={i}\n   389→                type=\"button\"\n   390→                onClick={() => handleSelectSuggestion(s)}\n   391→                className=\"w-full text-left px-4 py-2.5 text-sm hover:bg-bg-secondary transition-colors border-b border-border last:border-b-0\"\n   392→              >\n   393→                {s.display_name}\n   394→              </button>\n   395→            ))}\n   396→          </div>\n   397→        )}\n   398→      </div>\n   399→\n   400→      <div className=\"grid grid-cols-2 gap-4 mb-4\">\n   401→        <div>\n   402→          <label className=\"block text-sm font-medium text-text mb-1.5\">City *</label>\n   403→          <input\n   404→            data-testid=\"listing-city-input\"\n   405→            type=\"text\"\n   406→            value={formData.city}\n   407→            onChange={(e) => {\n   408→              setFormData((prev) => ({ ...prev, city: e.target.value }))\n   409→              if (errors.city) setErrors((prev) => { const n = { ...prev }; delete n.city; return n })\n   410→            }}\n   411→            placeholder=\"City\"\n   412→            className={`w-full px-4 py-3 rounded-lg border ${\n   413→              errors.city ? 'border-error' : 'border-border'\n   414→            } text-sm focus:outline-none focus:border-primary`}\n   415→          />\n   416→          {errors.city && <p className=\"text-error text-xs mt-1\">{errors.city}</p>}\n   417→        </div>\n   418→        <div>\n   419→          <label className=\"block text-sm font-medium text-text mb-1.5\">State</label>\n   420→          <input\n   421→            data-testid=\"listing-state-input\"\n   422→            type=\"text\"\n   423→            value={formData.state}\n   424→            onChange={(e) => setFormData((prev) => ({ ...prev, state: e.target.value }))}\n   425→            placeholder=\"State/Province\"\n   426→            className=\"w-full px-4 py-3 rounded-lg border border-border text-sm focus:outline-none focus:border-primary\"\n   427→          />\n   428→        </div>\n   429→      </div>\n   430→\n   431→      <div className=\"mb-4\">\n   432→        <label className=\"block text-sm font-medium text-text mb-1.5\">Country *</label>\n   433→        <input\n   434→          data-testid=\"listing-country-input\"\n   435→          type=\"text\"\n   436→          value={formData.country}\n   437→          onChange={(e) => {\n   438→            setFormData((prev) => ({ ...prev, country: e.target.value }))\n   439→            if (errors.country) setErrors((prev) => { const n = { ...prev }; delete n.country; return n })\n   440→          }}\n   441→          placeholder=\"Country\"\n   442→          className={`w-full px-4 py-3 rounded-lg border ${\n   443→            errors.country ? 'border-error' : 'border-border'\n   444→          } text-sm focus:outline-none focus:border-primary`}\n   445→        />\n   446→        {errors.country && <p className=\"text-error text-xs mt-1\">{errors.country}</p>}\n   447→      </div>\n   448→    </div>\n   449→  )\n   450→\n   451→  const renderStep3 = () => {\n   452→    const fields: { key: 'maxGuests' | 'bedrooms' | 'beds' | 'bathrooms'; label: string }[] = [\n   453→      { key: 'maxGuests', label: 'Max Guests' },\n   454→      { key: 'bedrooms', label: 'Bedrooms' },\n   455→      { key: 'beds', label: 'Beds' },\n   456→      { key: 'bathrooms', label: 'Bathrooms' },\n   457→    ]\n   458→\n   459→    return (\n   460→      <div data-testid=\"add-listing-step-3\">\n   461→        <h3 className=\"text-lg font-semibold text-text mb-4\">Property Details</h3>\n   462→        <div className=\"space-y-4\">\n   463→          {fields.map(({ key, label }) => (\n   464→            <div key={key} className=\"flex items-center justify-between\">\n   465→              <label className=\"text-sm font-medium text-text\">{label} *</label>\n   466→              <div className=\"flex items-center gap-3\">\n   467→                <button\n   468→                  type=\"button\"\n   469→                  data-testid={`${key}-decrement`}\n   470→                  onClick={() => decrementField(key)}\n   471→                  className=\"w-8 h-8 rounded-full border border-border flex items-center justify-center text-text-secondary hover:border-text transition-colors\"\n   472→                >\n   473→                  <Minus size={14} />\n   474→                </button>\n   475→                <span data-testid={`${key}-value`} className=\"text-lg font-medium text-text w-8 text-center\">\n   476→                  {formData[key]}\n   477→                </span>\n   478→                <button\n   479→                  type=\"button\"\n   480→                  data-testid={`${key}-increment`}\n   481→                  onClick={() => incrementField(key)}\n   482→                  className=\"w-8 h-8 rounded-full border border-border flex items-center justify-center text-text-secondary hover:border-text transition-colors\"\n   483→                >\n   484→                  <Plus size={14} />\n   485→                </button>\n   486→              </div>\n   487→              {errors[key] && <p className=\"text-error text-xs\">{errors[key]}</p>}\n   488→            </div>\n   489→          ))}\n   490→        </div>\n   491→      </div>\n   492→    )\n   493→  }\n   494→\n   495→  const renderStep4 = () => (\n   496→    <div data-testid=\"add-listing-step-4\">\n   497→      <h3 className=\"text-lg font-semibold text-text mb-4\">Amenities</h3>\n   498→      <p className=\"text-sm text-text-secondary mb-4\">Select the amenities your property offers (optional)</p>\n   499→      {Object.entries(amenitiesByCategory).map(([category, items]) => (\n   500→        <div key={category} className=\"mb-6\">\n   501→          <h4 className=\"text-sm font-semibold text-text mb-2 capitalize\">{category}</h4>\n   502→          <div className=\"grid grid-cols-2 gap-2\">\n   503→            {items.map((amenity) => (\n   504→              <label\n   505→                key={amenity.id}\n   506→                data-testid={`amenity-checkbox-${amenity.id}`}\n   507→                className={`flex items-center gap-2 px-3 py-2.5 rounded-lg border cursor-pointer transition-colors ${\n   508→                  formData.selectedAmenities.includes(amenity.id)\n   509→                    ? 'border-primary bg-primary/5'\n   510→                    : 'border-border hover:border-border-dark'\n   511→                }`}\n   512→              >\n   513→                <input\n   514→                  type=\"checkbox\"\n   515→                  checked={formData.selectedAmenities.includes(amenity.id)}\n   516→                  onChange={() => toggleAmenity(amenity.id)}\n   517→                  className=\"sr-only\"\n   518→                />\n   519→                <div\n   520→                  className={`w-4 h-4 rounded border flex items-center justify-center ${\n   521→                    formData.selectedAmenities.includes(amenity.id)\n   522→                      ? 'bg-primary border-primary'\n   523→                      : 'border-border-dark'\n   524→                  }`}\n   525→                >\n   526→                  {formData.selectedAmenities.includes(amenity.id) && (\n   527→                    <Check size={10} className=\"text-white\" />\n   528→                  )}\n   529→                </div>\n   530→                <span className=\"text-sm text-text\">{amenity.name}</span>\n   531→              </label>\n   532→            ))}\n   533→          </div>\n   534→        </div>\n   535→      ))}\n   536→    </div>\n   537→  )\n   538→\n   539→  const renderStep5 = () => (\n   540→    <div data-testid=\"add-listing-step-5\">\n   541→      <h3 className=\"text-lg font-semibold text-text mb-4\">Photos</h3>\n   542→\n   543→      <div className=\"flex gap-2 mb-4\">\n   544→        <input\n   545→          data-testid=\"photo-url-input\"\n   546→          type=\"text\"\n   547→          value={photoUrl}\n   548→          onChange={(e) => setPhotoUrl(e.target.value)}\n   549→          onKeyDown={(e) => { if (e.key === 'Enter') { e.preventDefault(); handleAddPhoto() } }}\n   550→          placeholder=\"Enter image URL...\"\n   551→          className=\"flex-1 px-4 py-3 rounded-lg border border-border text-sm focus:outline-none focus:border-primary\"\n   552→        />\n   553→        <button\n   554→          type=\"button\"\n   555→          data-testid=\"add-photo-button\"\n   556→          onClick={handleAddPhoto}\n   557→          className=\"px-4 py-3 bg-primary text-white rounded-lg text-sm font-medium hover:bg-primary-dark transition-colors\"\n   558→        >\n   559→          Add Photo\n   560→        </button>\n   561→      </div>\n   562→\n   563→      {errors.photos && <p className=\"text-error text-xs mb-3\">{errors.photos}</p>}\n   564→\n   565→      {formData.photos.length > 0 && (\n   566→        <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-3\">\n   567→          {formData.photos.map((photo, index) => (\n   568→            <div key={index} data-testid={`photo-item-${index}`} className=\"relative group\">\n   569→              <div className=\"aspect-[4/3] rounded-lg overflow-hidden border border-border\">\n   570→                <img\n   571→                  src={photo.url}\n   572→                  alt={`Photo ${index + 1}`}\n   573→                  className=\"w-full h-full object-cover\"\n   574→                  onError={(e) => {\n   575→                    (e.target as HTMLImageElement).src = ''\n   576→                    ;(e.target as HTMLImageElement).alt = 'Failed to load'\n   577→                  }}\n   578→                />\n   579→              </div>\n   580→              <button\n   581→                type=\"button\"\n   582→                data-testid={`remove-photo-${index}`}\n   583→                onClick={() => handleRemovePhoto(index)}\n   584→                className=\"absolute top-2 right-2 w-7 h-7 bg-white/90 rounded-full flex items-center justify-center shadow-sm opacity-0 group-hover:opacity-100 transition-opacity hover:bg-white\"\n   585→              >\n   586→                <Trash2 size={14} className=\"text-status-cancelled\" />\n   587→              </button>\n   588→            </div>\n   589→          ))}\n   590→        </div>\n   591→      )}\n   592→    </div>\n   593→  )\n   594→\n   595→  const renderStep6 = () => (\n   596→    <div data-testid=\"add-listing-step-6\">\n   597→      <h3 className=\"text-lg font-semibold text-text mb-4\">Pricing</h3>\n   598→\n   599→      <div className=\"mb-4\">\n   600→        <label className=\"block text-sm font-medium text-text mb-1.5\">Price per Night *</label>\n   601→        <div className=\"relative\">\n   602→          <span className=\"absolute left-4 top-1/2 -translate-y-1/2 text-text-secondary\">$</span>\n   603→          <input\n   604→            data-testid=\"price-per-night-input\"\n   605→            type=\"text\"\n   606→            inputMode=\"decimal\"\n   607→            value={formData.pricePerNight}\n   608→            onChange={(e) => {\n   609→              const val = e.target.value.replace(/[^0-9.]/g, '')\n   610→              setFormData((prev) => ({ ...prev, pricePerNight: val }))\n   611→              if (errors.pricePerNight) setErrors((prev) => { const n = { ...prev }; delete n.pricePerNight; return n })\n   612→            }}\n   613→            placeholder=\"0\"\n   614→            className={`w-full pl-8 pr-4 py-3 rounded-lg border ${\n   615→              errors.pricePerNight ? 'border-error' : 'border-border'\n   616→            } text-sm focus:outline-none focus:border-primary`}\n   617→          />\n   618→        </div>\n   619→        {errors.pricePerNight && <p className=\"text-error text-xs mt-1\">{errors.pricePerNight}</p>}\n   620→      </div>\n   621→\n   622→      <div className=\"mb-4\">\n   623→        <label className=\"block text-sm font-medium text-text mb-1.5\">Cleaning Fee</label>\n   624→        <div className=\"relative\">\n   625→          <span className=\"absolute left-4 top-1/2 -translate-y-1/2 text-text-secondary\">$</span>\n   626→          <input\n   627→            data-testid=\"cleaning-fee-input\"\n   628→            type=\"text\"\n   629→            inputMode=\"decimal\"\n   630→            value={formData.cleaningFee}\n   631→            onChange={(e) => {\n   632→              const val = e.target.value.replace(/[^0-9.]/g, '')\n   633→              setFormData((prev) => ({ ...prev, cleaningFee: val }))\n   634→            }}\n   635→            placeholder=\"0\"\n   636→            className=\"w-full pl-8 pr-4 py-3 rounded-lg border border-border text-sm focus:outline-none focus:border-primary\"\n   637→          />\n   638→        </div>\n   639→      </div>\n   640→    </div>\n   641→  )\n   642→\n   643→  const renderStep7 = () => {\n   644→    const selectedAmenityNames = amenities\n   645→      .filter((a) => formData.selectedAmenities.includes(a.id))\n   646→      .map((a) => a.name)\n   647→\n   648→    return (\n   649→      <div data-testid=\"add-listing-step-7\">\n   650→        <h3 className=\"text-lg font-semibold text-text mb-4\">Review & Publish</h3>\n   651→\n   652→        {errors.publish && (\n   653→          <div className=\"bg-error/10 text-error text-sm px-4 py-3 rounded-lg mb-4\">{errors.publish}</div>\n   654→        )}\n   655→\n   656→        <div className=\"space-y-4\">\n   657→          <div className=\"bg-bg-secondary rounded-lg p-4\">\n   658→            <h4 className=\"text-xs font-semibold text-text-secondary uppercase tracking-wide mb-2\">Property</h4>\n   659→            <p className=\"text-sm\"><strong>Type:</strong> {formData.propertyType}</p>\n   660→            <p className=\"text-sm\"><strong>Title:</strong> {formData.title}</p>\n   661→          </div>\n   662→\n   663→          <div className=\"bg-bg-secondary rounded-lg p-4\">\n   664→            <h4 className=\"text-xs font-semibold text-text-secondary uppercase tracking-wide mb-2\">Location</h4>\n   665→            <p className=\"text-sm\">\n   666→              {[formData.address, formData.city, formData.state, formData.country].filter(Boolean).join(', ')}\n   667→            </p>\n   668→          </div>\n   669→\n   670→          <div className=\"bg-bg-secondary rounded-lg p-4\">\n   671→            <h4 className=\"text-xs font-semibold text-text-secondary uppercase tracking-wide mb-2\">Details</h4>\n   672→            <div className=\"grid grid-cols-2 gap-2 text-sm\">\n   673→              <p><strong>Guests:</strong> {formData.maxGuests}</p>\n   674→              <p><strong>Bedrooms:</strong> {formData.bedrooms}</p>\n   675→              <p><strong>Beds:</strong> {formData.beds}</p>\n   676→              <p><strong>Bathrooms:</strong> {formData.bathrooms}</p>\n   677→            </div>\n   678→          </div>\n   679→\n   680→          {selectedAmenityNames.length > 0 && (\n   681→            <div className=\"bg-bg-secondary rounded-lg p-4\">\n   682→              <h4 className=\"text-xs font-semibold text-text-secondary uppercase tracking-wide mb-2\">Amenities</h4>\n   683→              <p className=\"text-sm\">{selectedAmenityNames.join(', ')}</p>\n   684→            </div>\n   685→          )}\n   686→\n   687→          {formData.photos.length > 0 && (\n   688→            <div className=\"bg-bg-secondary rounded-lg p-4\">\n   689→              <h4 className=\"text-xs font-semibold text-text-secondary uppercase tracking-wide mb-2\">Photos</h4>\n   690→              <div className=\"flex gap-2 overflow-x-auto\">\n   691→                {formData.photos.map((photo, i) => (\n   692→                  <div key={i} className=\"w-20 h-16 rounded-lg overflow-hidden shrink-0 border border-border\">\n   693→                    <img src={photo.url} alt={`Photo ${i + 1}`} className=\"w-full h-full object-cover\" />\n   694→                  </div>\n   695→                ))}\n   696→              </div>\n   697→            </div>\n   698→          )}\n   699→\n   700→          <div className=\"bg-bg-secondary rounded-lg p-4\">\n   701→            <h4 className=\"text-xs font-semibold text-text-secondary uppercase tracking-wide mb-2\">Pricing</h4>\n   702→            <p className=\"text-sm\"><strong>Price per night:</strong> ${formData.pricePerNight}</p>\n   703→            <p className=\"text-sm\"><strong>Cleaning fee:</strong> ${formData.cleaningFee || '0'}</p>\n   704→          </div>\n   705→        </div>\n   706→      </div>\n   707→    )\n   708→  }\n   709→\n   710→  return (\n   711→    <div\n   712→      data-testid=\"add-listing-form\"\n   713→      className=\"fixed inset-0 bg-black/50 flex items-center justify-center z-50\"\n   714→    >\n   715→      <div className=\"bg-white rounded-xl w-full max-w-2xl max-h-[90vh] overflow-y-auto mx-4 shadow-lg\">\n   716→        <div className=\"sticky top-0 bg-white border-b border-border px-6 py-4 flex items-center justify-between z-10\">\n   717→          <h2 className=\"text-lg font-semibold text-text\">Add New Listing</h2>\n   718→          <button\n   719→            data-testid=\"add-listing-close\"\n   720→            onClick={handleCancel}\n   721→            className=\"w-8 h-8 rounded-full hover:bg-bg-secondary flex items-center justify-center transition-colors\"\n   722→          >\n   723→            <X size={20} className=\"text-text-secondary\" />\n   724→          </button>\n   725→        </div>\n   726→\n   727→        <div className=\"px-6 py-6\">\n   728→          {renderStepIndicator()}\n   729→\n   730→          {step === 1 && renderStep1()}\n   731→          {step === 2 && renderStep2()}\n   732→          {step === 3 && renderStep3()}\n   733→          {step === 4 && renderStep4()}\n   734→          {step === 5 && renderStep5()}\n   735→          {step === 6 && renderStep6()}\n   736→          {step === 7 && renderStep7()}\n   737→        </div>\n   738→\n   739→        <div className=\"sticky bottom-0 bg-white border-t border-border px-6 py-4 flex items-center justify-between\">\n   740→          <button\n   741→            data-testid=\"add-listing-cancel\"\n   742→            onClick={handleCancel}\n   743→            className=\"px-4 py-2.5 text-sm font-medium text-text-secondary hover:text-text transition-colors\"\n   744→          >\n   745→            Cancel\n   746→          </button>\n   747→          <div className=\"flex gap-3\">\n   748→            {step > 1 && (\n   749→              <button\n   750→                data-testid=\"add-listing-back\"\n   751→                onClick={handleBack}\n   752→                className=\"flex items-center gap-1.5 px-4 py-2.5 text-sm font-medium text-text bg-bg-secondary rounded-lg hover:bg-border transition-colors\"\n   753→              >\n   754→                <ChevronLeft size={16} />\n   755→                Back\n   756→              </button>\n   757→            )}\n   758→            {step < TOTAL_STEPS ? (\n   759→              <button\n   760→                data-testid=\"add-listing-next\"\n   761→                onClick={handleNext}\n   762→                className=\"flex items-center gap-1.5 px-4 py-2.5 text-sm font-medium text-white bg-primary rounded-lg hover:bg-primary-dark transition-colors\"\n   763→              >\n   764→                Next\n   765→                <ChevronRight size={16} />\n   766→              </button>\n   767→            ) : (\n   768→              <button\n   769→                data-testid=\"add-listing-publish\"\n   770→                onClick={handlePublish}\n   771→                disabled={publishing}\n   772→                className=\"flex items-center gap-1.5 px-6 py-2.5 text-sm font-medium text-white bg-primary rounded-lg hover:bg-primary-dark transition-colors disabled:opacity-50\"\n   773→              >\n   774→                {publishing ? (\n   775→                  <>\n   776→                    <Loader2 size={16} className=\"animate-spin\" />\n   777→                    Publishing...\n   778→                  </>\n   779→                ) : (\n   780→                  'Publish'\n   781→                )}\n   782→              </button>\n   783→            )}\n   784→          </div>\n   785→        </div>\n   786→      </div>\n   787→\n   788→      {showDiscardDialog && (\n   789→        <div\n   790→          data-testid=\"discard-dialog\"\n   791→          className=\"fixed inset-0 bg-black/50 flex items-center justify-center z-[60]\"\n   792→          onClick={() => setShowDiscardDialog(false)}\n   793→        >\n   794→          <div\n   795→            className=\"bg-white rounded-xl p-6 max-w-md w-full mx-4 shadow-lg\"\n   796→            onClick={(e) => e.stopPropagation()}\n   797→          >\n   798→            <h3 className=\"text-lg font-semibold text-text mb-2\">Discard your listing?</h3>\n   799→            <p className=\"text-text-secondary mb-6\">All entered information will be lost.</p>\n   800→            <div className=\"flex gap-3 justify-end\">\n   801→              <button\n   802→                data-testid=\"discard-dialog-keep\"\n   803→                onClick={() => setShowDiscardDialog(false)}\n   804→                className=\"px-4 py-2 text-sm font-medium text-text bg-bg-secondary rounded-lg hover:bg-border transition-colors\"\n   805→              >\n   806→                Keep Editing\n   807→              </button>\n   808→              <button\n   809→                data-testid=\"discard-dialog-confirm\"\n   810→                onClick={onClose}\n   811→                className=\"px-4 py-2 text-sm font-medium text-white bg-status-cancelled rounded-lg hover:opacity-90 transition-opacity\"\n   812→              >\n   813→                Discard\n   814→              </button>\n   815→            </div>\n   816→          </div>\n   817→        </div>\n   818→      )}\n   819→    </div>\n   820→  )\n   821→}\n   822→"}]},"parent_tool_use_id":null,"session_id":"7ad3c362-059b-401b-af91-0b063664010f","uuid":"dad9356d-a6e1-47d5-817b-e8beb1864145","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/components/AddListingForm.tsx","content":"import { useState, useEffect, useCallback, useRef } from 'react'\nimport { useSelector, useDispatch } from 'react-redux'\nimport { X, Plus, Trash2, ChevronLeft, ChevronRight, Minus, Check, Loader2 } from 'lucide-react'\nimport type { RootState, AppDispatch } from '../store'\nimport type { Amenity } from '../slices/propertiesSlice'\nimport { fetchAmenities } from '../slices/amenitiesSlice'\nimport { createProperty } from '../slices/hostSlice'\n\ninterface AddListingFormProps {\n  hostId: string\n  onClose: () => void\n  onSuccess: () => void\n}\n\ninterface FormData {\n  propertyType: string\n  title: string\n  address: string\n  city: string\n  state: string\n  country: string\n  latitude: number | null\n  longitude: number | null\n  maxGuests: number\n  bedrooms: number\n  beds: number\n  bathrooms: number\n  selectedAmenities: string[]\n  photos: { url: string; caption: string }[]\n  pricePerNight: string\n  cleaningFee: string\n  description: string\n}\n\nconst PROPERTY_TYPES = ['Apartment', 'House', 'Cabin', 'Villa', 'Condo', 'Loft', 'Cottage', 'Townhouse']\nconst TOTAL_STEPS = 7\n\nconst initialFormData: FormData = {\n  propertyType: '',\n  title: '',\n  address: '',\n  city: '',\n  state: '',\n  country: '',\n  latitude: null,\n  longitude: null,\n  maxGuests: 1,\n  bedrooms: 1,\n  beds: 1,\n  bathrooms: 1,\n  selectedAmenities: [],\n  photos: [],\n  pricePerNight: '',\n  cleaningFee: '0',\n  description: '',\n}\n\ninterface AddressSuggestion {\n  display_name: string\n  address?: {\n    road?: string\n    house_number?: string\n    city?: string\n    town?: string\n    village?: string\n    state?: string\n    country?: string\n  }\n  lat: string\n  lon: string\n}\n\nexport default function AddListingForm({ hostId, onClose, onSuccess }: AddListingFormProps) {\n  const dispatch = useDispatch<AppDispatch>()\n  const amenities = useSelector((state: RootState) => state.amenities.items)\n  const [step, setStep] = useState(1)\n  const [formData, setFormData] = useState<FormData>(initialFormData)\n  const [errors, setErrors] = useState<Record<string, string>>({})\n  const [showDiscardDialog, setShowDiscardDialog] = useState(false)\n  const [publishing, setPublishing] = useState(false)\n  const [photoUrl, setPhotoUrl] = useState('')\n  const [addressSuggestions, setAddressSuggestions] = useState<AddressSuggestion[]>([])\n  const [showSuggestions, setShowSuggestions] = useState(false)\n  const [propertyTypeOpen, setPropertyTypeOpen] = useState(false)\n  const propertyTypeRef = useRef<HTMLDivElement>(null)\n  const debounceRef = useRef<ReturnType<typeof setTimeout> | null>(null)\n\n  useEffect(() => {\n    if (amenities.length === 0) {\n      dispatch(fetchAmenities())\n    }\n  }, [dispatch, amenities.length])\n\n  useEffect(() => {\n    if (!propertyTypeOpen) return\n    const handleClickOutside = (e: MouseEvent) => {\n      if (propertyTypeRef.current && !propertyTypeRef.current.contains(e.target as Node)) {\n        setPropertyTypeOpen(false)\n      }\n    }\n    document.addEventListener('mousedown', handleClickOutside)\n    return () => document.removeEventListener('mousedown', handleClickOutside)\n  }, [propertyTypeOpen])\n\n  const fetchAddressSuggestions = useCallback(async (query: string) => {\n    if (query.length < 3) {\n      setAddressSuggestions([])\n      return\n    }\n    try {\n      const response = await fetch(\n        `https://nominatim.openstreetmap.org/search?format=json&addressdetails=1&q=${encodeURIComponent(query)}&limit=5`\n      )\n      const data = await response.json() as AddressSuggestion[]\n      setAddressSuggestions(data)\n      setShowSuggestions(true)\n    } catch {\n      setAddressSuggestions([])\n    }\n  }, [])\n\n  const handleAddressChange = (value: string) => {\n    setFormData((prev) => ({ ...prev, address: value }))\n    if (debounceRef.current) clearTimeout(debounceRef.current)\n    debounceRef.current = setTimeout(() => {\n      fetchAddressSuggestions(value)\n    }, 300)\n  }\n\n  const handleSelectSuggestion = (suggestion: AddressSuggestion) => {\n    const addr = suggestion.address\n    const road = addr?.house_number ? `${addr.house_number} ${addr.road || ''}` : (addr?.road || '')\n    setFormData((prev) => ({\n      ...prev,\n      address: road || suggestion.display_name,\n      city: addr?.city || addr?.town || addr?.village || '',\n      state: addr?.state || '',\n      country: addr?.country || '',\n      latitude: parseFloat(suggestion.lat),\n      longitude: parseFloat(suggestion.lon),\n    }))\n    setShowSuggestions(false)\n    setAddressSuggestions([])\n  }\n\n  const validateStep = (): boolean => {\n    const newErrors: Record<string, string> = {}\n\n    if (step === 1) {\n      if (!formData.propertyType) newErrors.propertyType = 'Property type is required'\n      if (!formData.title.trim()) newErrors.title = 'Title is required'\n    } else if (step === 2) {\n      if (!formData.city.trim()) newErrors.city = 'City is required'\n      if (!formData.country.trim()) newErrors.country = 'Country is required'\n    } else if (step === 3) {\n      if (formData.maxGuests < 1) newErrors.maxGuests = 'Max guests must be at least 1'\n      if (formData.bedrooms < 1) newErrors.bedrooms = 'At least 1 bedroom is required'\n      if (formData.beds < 1) newErrors.beds = 'At least 1 bed is required'\n      if (formData.bathrooms < 1) newErrors.bathrooms = 'At least 1 bathroom is required'\n    } else if (step === 5) {\n      if (formData.photos.length === 0) newErrors.photos = 'At least one photo is required'\n    } else if (step === 6) {\n      const price = parseFloat(formData.pricePerNight)\n      if (!price || price <= 0) newErrors.pricePerNight = 'Price per night is required and must be greater than 0'\n    }\n\n    setErrors(newErrors)\n    return Object.keys(newErrors).length === 0\n  }\n\n  const handleNext = () => {\n    if (validateStep()) {\n      setStep((s) => Math.min(s + 1, TOTAL_STEPS))\n    }\n  }\n\n  const handleBack = () => {\n    setErrors({})\n    setStep((s) => Math.max(s - 1, 1))\n  }\n\n  const handleAddPhoto = () => {\n    if (!photoUrl.trim()) return\n    setFormData((prev) => ({\n      ...prev,\n      photos: [...prev.photos, { url: photoUrl.trim(), caption: '' }],\n    }))\n    setPhotoUrl('')\n    setErrors((prev) => {\n      const next = { ...prev }\n      delete next.photos\n      return next\n    })\n  }\n\n  const handleRemovePhoto = (index: number) => {\n    setFormData((prev) => ({\n      ...prev,\n      photos: prev.photos.filter((_, i) => i !== index),\n    }))\n  }\n\n  const toggleAmenity = (amenityId: string) => {\n    setFormData((prev) => ({\n      ...prev,\n      selectedAmenities: prev.selectedAmenities.includes(amenityId)\n        ? prev.selectedAmenities.filter((id) => id !== amenityId)\n        : [...prev.selectedAmenities, amenityId],\n    }))\n  }\n\n  const handlePublish = async () => {\n    setPublishing(true)\n    try {\n      const result = await dispatch(createProperty({\n        host_id: hostId,\n        title: formData.title,\n        description: formData.description,\n        property_type: formData.propertyType,\n        price_per_night: parseFloat(formData.pricePerNight),\n        cleaning_fee: parseFloat(formData.cleaningFee) || 0,\n        max_guests: formData.maxGuests,\n        bedrooms: formData.bedrooms,\n        beds: formData.beds,\n        bathrooms: formData.bathrooms,\n        address: formData.address,\n        city: formData.city,\n        state: formData.state || null,\n        country: formData.country,\n        latitude: formData.latitude,\n        longitude: formData.longitude,\n        amenity_ids: formData.selectedAmenities,\n      })).unwrap()\n\n      const propertyId = result.id\n\n      for (let i = 0; i < formData.photos.length; i++) {\n        const photo = formData.photos[i]\n        if (photo) {\n          await fetch('/api/property-images', {\n            method: 'POST',\n            headers: { 'Content-Type': 'application/json' },\n            body: JSON.stringify({\n              property_id: propertyId,\n              url: photo.url,\n              caption: photo.caption,\n              display_order: i,\n            }),\n          })\n        }\n      }\n\n      onSuccess()\n    } catch {\n      setErrors({ publish: 'Failed to publish listing. Please try again.' })\n    } finally {\n      setPublishing(false)\n    }\n  }\n\n  const handleCancel = () => {\n    setShowDiscardDialog(true)\n  }\n\n  const incrementField = (field: 'maxGuests' | 'bedrooms' | 'beds' | 'bathrooms') => {\n    setFormData((prev) => ({ ...prev, [field]: prev[field] + 1 }))\n  }\n\n  const decrementField = (field: 'maxGuests' | 'bedrooms' | 'beds' | 'bathrooms') => {\n    setFormData((prev) => ({ ...prev, [field]: Math.max(0, prev[field] - 1) }))\n  }\n\n  const amenitiesByCategory = amenities.reduce<Record<string, Amenity[]>>((acc, amenity) => {\n    const cat = amenity.category || 'Other'\n    if (!acc[cat]) acc[cat] = []\n    acc[cat].push(amenity)\n    return acc\n  }, {})\n\n  const renderStepIndicator = () => (\n    <div data-testid=\"step-indicator\" className=\"flex items-center justify-center gap-2 mb-6\">\n      {Array.from({ length: TOTAL_STEPS }, (_, i) => i + 1).map((s) => (\n        <div\n          key={s}\n          className={`w-8 h-8 rounded-full flex items-center justify-center text-xs font-medium transition-colors ${\n            s < step\n              ? 'bg-primary text-white'\n              : s === step\n                ? 'bg-primary text-white'\n                : 'bg-bg-secondary text-text-secondary'\n          }`}\n        >\n          {s < step ? <Check size={14} /> : s}\n        </div>\n      ))}\n      <span className=\"ml-2 text-sm text-text-secondary\">Step {step} of {TOTAL_STEPS}</span>\n    </div>\n  )\n\n  const renderStep1 = () => (\n    <div data-testid=\"add-listing-step-1\">\n      <h3 className=\"text-lg font-semibold text-text mb-4\">Property Type & Title</h3>\n\n      <div className=\"mb-4\">\n        <label className=\"block text-sm font-medium text-text mb-1.5\">Property Type *</label>\n        <div className=\"relative\" ref={propertyTypeRef}>\n          <button\n            type=\"button\"\n            data-testid=\"property-type-select\"\n            onClick={() => setPropertyTypeOpen(!propertyTypeOpen)}\n            className={`w-full text-left px-4 py-3 rounded-lg border ${\n              errors.propertyType ? 'border-error' : 'border-border'\n            } bg-white text-sm focus:outline-none focus:border-primary`}\n          >\n            {formData.propertyType || 'Select property type...'}\n          </button>\n          {propertyTypeOpen && (\n            <div className=\"absolute top-full left-0 right-0 mt-1 bg-white border border-border rounded-lg shadow-lg z-10 max-h-60 overflow-y-auto\">\n              {PROPERTY_TYPES.map((type) => (\n                <button\n                  key={type}\n                  type=\"button\"\n                  data-testid={`property-type-option-${type.toLowerCase()}`}\n                  onClick={() => {\n                    setFormData((prev) => ({ ...prev, propertyType: type }))\n                    setPropertyTypeOpen(false)\n                    setErrors((prev) => {\n                      const next = { ...prev }\n                      delete next.propertyType\n                      return next\n                    })\n                  }}\n                  className={`w-full text-left px-4 py-2.5 text-sm hover:bg-bg-secondary transition-colors ${\n                    formData.propertyType === type ? 'bg-primary/10 text-primary font-medium' : 'text-text'\n                  }`}\n                >\n                  {type}\n                </button>\n              ))}\n            </div>\n          )}\n        </div>\n        {errors.propertyType && <p className=\"text-error text-xs mt-1\">{errors.propertyType}</p>}\n      </div>\n\n      <div className=\"mb-4\">\n        <label className=\"block text-sm font-medium text-text mb-1.5\">Title *</label>\n        <input\n          data-testid=\"listing-title-input\"\n          type=\"text\"\n          value={formData.title}\n          onChange={(e) => {\n            setFormData((prev) => ({ ...prev, title: e.target.value }))\n            if (errors.title) setErrors((prev) => { const n = { ...prev }; delete n.title; return n })\n          }}\n          placeholder=\"Give your place a catchy title\"\n          className={`w-full px-4 py-3 rounded-lg border ${\n            errors.title ? 'border-error' : 'border-border'\n          } text-sm focus:outline-none focus:border-primary`}\n        />\n        {errors.title && <p className=\"text-error text-xs mt-1\">{errors.title}</p>}\n      </div>\n    </div>\n  )\n\n  const renderStep2 = () => (\n    <div data-testid=\"add-listing-step-2\">\n      <h3 className=\"text-lg font-semibold text-text mb-4\">Location</h3>\n\n      <div className=\"mb-4 relative\">\n        <label className=\"block text-sm font-medium text-text mb-1.5\">Address</label>\n        <input\n          data-testid=\"listing-address-input\"\n          type=\"text\"\n          value={formData.address}\n          onChange={(e) => handleAddressChange(e.target.value)}\n          onFocus={() => { if (addressSuggestions.length > 0) setShowSuggestions(true) }}\n          placeholder=\"Start typing an address...\"\n          className=\"w-full px-4 py-3 rounded-lg border border-border text-sm focus:outline-none focus:border-primary\"\n        />\n        {showSuggestions && addressSuggestions.length > 0 && (\n          <div\n            data-testid=\"address-suggestions\"\n            className=\"absolute top-full left-0 right-0 mt-1 bg-white border border-border rounded-lg shadow-lg z-10 max-h-48 overflow-y-auto\"\n          >\n            {addressSuggestions.map((s, i) => (\n              <button\n                key={i}\n                type=\"button\"\n                onClick={() => handleSelectSuggestion(s)}\n                className=\"w-full text-left px-4 py-2.5 text-sm hover:bg-bg-secondary transition-colors border-b border-border last:border-b-0\"\n              >\n                {s.display_name}\n              </button>\n            ))}\n          </div>\n        )}\n      </div>\n\n      <div className=\"grid grid-cols-2 gap-4 mb-4\">\n        <div>\n          <label className=\"block text-sm font-medium text-text mb-1.5\">City *</label>\n          <input\n            data-testid=\"listing-city-input\"\n            type=\"text\"\n            value={formData.city}\n            onChange={(e) => {\n              setFormData((prev) => ({ ...prev, city: e.target.value }))\n              if (errors.city) setErrors((prev) => { const n = { ...prev }; delete n.city; return n })\n            }}\n            placeholder=\"City\"\n            className={`w-full px-4 py-3 rounded-lg border ${\n              errors.city ? 'border-error' : 'border-border'\n            } text-sm focus:outline-none focus:border-primary`}\n          />\n          {errors.city && <p className=\"text-error text-xs mt-1\">{errors.city}</p>}\n        </div>\n        <div>\n          <label className=\"block text-sm font-medium text-text mb-1.5\">State</label>\n          <input\n            data-testid=\"listing-state-input\"\n            type=\"text\"\n            value={formData.state}\n            onChange={(e) => setFormData((prev) => ({ ...prev, state: e.target.value }))}\n            placeholder=\"State/Province\"\n            className=\"w-full px-4 py-3 rounded-lg border border-border text-sm focus:outline-none focus:border-primary\"\n          />\n        </div>\n      </div>\n\n      <div className=\"mb-4\">\n        <label className=\"block text-sm font-medium text-text mb-1.5\">Country *</label>\n        <input\n          data-testid=\"listing-country-input\"\n          type=\"text\"\n          value={formData.country}\n          onChange={(e) => {\n            setFormData((prev) => ({ ...prev, country: e.target.value }))\n            if (errors.country) setErrors((prev) => { const n = { ...prev }; delete n.country; return n })\n          }}\n          placeholder=\"Country\"\n          className={`w-full px-4 py-3 rounded-lg border ${\n            errors.country ? 'border-error' : 'border-border'\n          } text-sm focus:outline-none focus:border-primary`}\n        />\n        {errors.country && <p className=\"text-error text-xs mt-1\">{errors.country}</p>}\n      </div>\n    </div>\n  )\n\n  const renderStep3 = () => {\n    const fields: { key: 'maxGuests' | 'bedrooms' | 'beds' | 'bathrooms'; label: string }[] = [\n      { key: 'maxGuests', label: 'Max Guests' },\n      { key: 'bedrooms', label: 'Bedrooms' },\n      { key: 'beds', label: 'Beds' },\n      { key: 'bathrooms', label: 'Bathrooms' },\n    ]\n\n    return (\n      <div data-testid=\"add-listing-step-3\">\n        <h3 className=\"text-lg font-semibold text-text mb-4\">Property Details</h3>\n        <div className=\"space-y-4\">\n          {fields.map(({ key, label }) => (\n            <div key={key} className=\"flex items-center justify-between\">\n              <label className=\"text-sm font-medium text-text\">{label} *</label>\n              <div className=\"flex items-center gap-3\">\n                <button\n                  type=\"button\"\n                  data-testid={`${key}-decrement`}\n                  onClick={() => decrementField(key)}\n                  className=\"w-8 h-8 rounded-full border border-border flex items-center justify-center text-text-secondary hover:border-text transition-colors\"\n                >\n                  <Minus size={14} />\n                </button>\n                <span data-testid={`${key}-value`} className=\"text-lg font-medium text-text w-8 text-center\">\n                  {formData[key]}\n                </span>\n                <button\n                  type=\"button\"\n                  data-testid={`${key}-increment`}\n                  onClick={() => incrementField(key)}\n                  className=\"w-8 h-8 rounded-full border border-border flex items-center justify-center text-text-secondary hover:border-text transition-colors\"\n                >\n                  <Plus size={14} />\n                </button>\n              </div>\n              {errors[key] && <p className=\"text-error text-xs\">{errors[key]}</p>}\n            </div>\n          ))}\n        </div>\n      </div>\n    )\n  }\n\n  const renderStep4 = () => (\n    <div data-testid=\"add-listing-step-4\">\n      <h3 className=\"text-lg font-semibold text-text mb-4\">Amenities</h3>\n      <p className=\"text-sm text-text-secondary mb-4\">Select the amenities your property offers (optional)</p>\n      {Object.entries(amenitiesByCategory).map(([category, items]) => (\n        <div key={category} className=\"mb-6\">\n          <h4 className=\"text-sm font-semibold text-text mb-2 capitalize\">{category}</h4>\n          <div className=\"grid grid-cols-2 gap-2\">\n            {items.map((amenity) => (\n              <label\n                key={amenity.id}\n                data-testid={`amenity-checkbox-${amenity.id}`}\n                className={`flex items-center gap-2 px-3 py-2.5 rounded-lg border cursor-pointer transition-colors ${\n                  formData.selectedAmenities.includes(amenity.id)\n                    ? 'border-primary bg-primary/5'\n                    : 'border-border hover:border-border-dark'\n                }`}\n              >\n                <input\n                  type=\"checkbox\"\n                  checked={formData.selectedAmenities.includes(amenity.id)}\n                  onChange={() => toggleAmenity(amenity.id)}\n                  className=\"sr-only\"\n                />\n                <div\n                  className={`w-4 h-4 rounded border flex items-center justify-center ${\n                    formData.selectedAmenities.includes(amenity.id)\n                      ? 'bg-primary border-primary'\n                      : 'border-border-dark'\n                  }`}\n                >\n                  {formData.selectedAmenities.includes(amenity.id) && (\n                    <Check size={10} className=\"text-white\" />\n                  )}\n                </div>\n                <span className=\"text-sm text-text\">{amenity.name}</span>\n              </label>\n            ))}\n          </div>\n        </div>\n      ))}\n    </div>\n  )\n\n  const renderStep5 = () => (\n    <div data-testid=\"add-listing-step-5\">\n      <h3 className=\"text-lg font-semibold text-text mb-4\">Photos</h3>\n\n      <div className=\"flex gap-2 mb-4\">\n        <input\n          data-testid=\"photo-url-input\"\n          type=\"text\"\n          value={photoUrl}\n          onChange={(e) => setPhotoUrl(e.target.value)}\n          onKeyDown={(e) => { if (e.key === 'Enter') { e.preventDefault(); handleAddPhoto() } }}\n          placeholder=\"Enter image URL...\"\n          className=\"flex-1 px-4 py-3 rounded-lg border border-border text-sm focus:outline-none focus:border-primary\"\n        />\n        <button\n          type=\"button\"\n          data-testid=\"add-photo-button\"\n          onClick={handleAddPhoto}\n          className=\"px-4 py-3 bg-primary text-white rounded-lg text-sm font-medium hover:bg-primary-dark transition-colors\"\n        >\n          Add Photo\n        </button>\n      </div>\n\n      {errors.photos && <p className=\"text-error text-xs mb-3\">{errors.photos}</p>}\n\n      {formData.photos.length > 0 && (\n        <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-3\">\n          {formData.photos.map((photo, index) => (\n            <div key={index} data-testid={`photo-item-${index}`} className=\"relative group\">\n              <div className=\"aspect-[4/3] rounded-lg overflow-hidden border border-border\">\n                <img\n                  src={photo.url}\n                  alt={`Photo ${index + 1}`}\n                  className=\"w-full h-full object-cover\"\n                  onError={(e) => {\n                    (e.target as HTMLImageElement).src = ''\n                    ;(e.target as HTMLImageElement).alt = 'Failed to load'\n                  }}\n                />\n              </div>\n              <button\n                type=\"button\"\n                data-testid={`remove-photo-${index}`}\n                onClick={() => handleRemovePhoto(index)}\n                className=\"absolute top-2 right-2 w-7 h-7 bg-white/90 rounded-full flex items-center justify-center shadow-sm opacity-0 group-hover:opacity-100 transition-opacity hover:bg-white\"\n              >\n                <Trash2 size={14} className=\"text-status-cancelled\" />\n              </button>\n            </div>\n          ))}\n        </div>\n      )}\n    </div>\n  )\n\n  const renderStep6 = () => (\n    <div data-testid=\"add-listing-step-6\">\n      <h3 className=\"text-lg font-semibold text-text mb-4\">Pricing</h3>\n\n      <div className=\"mb-4\">\n        <label className=\"block text-sm font-medium text-text mb-1.5\">Price per Night *</label>\n        <div className=\"relative\">\n          <span className=\"absolute left-4 top-1/2 -translate-y-1/2 text-text-secondary\">$</span>\n          <input\n            data-testid=\"price-per-night-input\"\n            type=\"text\"\n            inputMode=\"decimal\"\n            value={formData.pricePerNight}\n            onChange={(e) => {\n              const val = e.target.value.replace(/[^0-9.]/g, '')\n              setFormData((prev) => ({ ...prev, pricePerNight: val }))\n              if (errors.pricePerNight) setErrors((prev) => { const n = { ...prev }; delete n.pricePerNight; return n })\n            }}\n            placeholder=\"0\"\n            className={`w-full pl-8 pr-4 py-3 rounded-lg border ${\n              errors.pricePerNight ? 'border-error' : 'border-border'\n            } text-sm focus:outline-none focus:border-primary`}\n          />\n        </div>\n        {errors.pricePerNight && <p className=\"text-error text-xs mt-1\">{errors.pricePerNight}</p>}\n      </div>\n\n      <div className=\"mb-4\">\n        <label className=\"block text-sm font-medium text-text mb-1.5\">Cleaning Fee</label>\n        <div className=\"relative\">\n          <span className=\"absolute left-4 top-1/2 -translate-y-1/2 text-text-secondary\">$</span>\n          <input\n            data-testid=\"cleaning-fee-input\"\n            type=\"text\"\n            inputMode=\"decimal\"\n            value={formData.cleaningFee}\n            onChange={(e) => {\n              const val = e.target.value.replace(/[^0-9.]/g, '')\n              setFormData((prev) => ({ ...prev, cleaningFee: val }))\n            }}\n            placeholder=\"0\"\n            className=\"w-full pl-8 pr-4 py-3 rounded-lg border border-border text-sm focus:outline-none focus:border-primary\"\n          />\n        </div>\n      </div>\n    </div>\n  )\n\n  const renderStep7 = () => {\n    const selectedAmenityNames = amenities\n      .filter((a) => formData.selectedAmenities.includes(a.id))\n      .map((a) => a.name)\n\n    return (\n      <div data-testid=\"add-listing-step-7\">\n        <h3 className=\"text-lg font-semibold text-text mb-4\">Review & Publish</h3>\n\n        {errors.publish && (\n          <div className=\"bg-error/10 text-error text-sm px-4 py-3 rounded-lg mb-4\">{errors.publish}</div>\n        )}\n\n        <div className=\"space-y-4\">\n          <div className=\"bg-bg-secondary rounded-lg p-4\">\n            <h4 className=\"text-xs font-semibold text-text-secondary uppercase tracking-wide mb-2\">Property</h4>\n            <p className=\"text-sm\"><strong>Type:</strong> {formData.propertyType}</p>\n            <p className=\"text-sm\"><strong>Title:</strong> {formData.title}</p>\n          </div>\n\n          <div className=\"bg-bg-secondary rounded-lg p-4\">\n            <h4 className=\"text-xs font-semibold text-text-secondary uppercase tracking-wide mb-2\">Location</h4>\n            <p className=\"text-sm\">\n              {[formData.address, formData.city, formData.state, formData.country].filter(Boolean).join(', ')}\n            </p>\n          </div>\n\n          <div className=\"bg-bg-secondary rounded-lg p-4\">\n            <h4 className=\"text-xs font-semibold text-text-secondary uppercase tracking-wide mb-2\">Details</h4>\n            <div className=\"grid grid-cols-2 gap-2 text-sm\">\n              <p><strong>Guests:</strong> {formData.maxGuests}</p>\n              <p><strong>Bedrooms:</strong> {formData.bedrooms}</p>\n              <p><strong>Beds:</strong> {formData.beds}</p>\n              <p><strong>Bathrooms:</strong> {formData.bathrooms}</p>\n            </div>\n          </div>\n\n          {selectedAmenityNames.length > 0 && (\n            <div className=\"bg-bg-secondary rounded-lg p-4\">\n              <h4 className=\"text-xs font-semibold text-text-secondary uppercase tracking-wide mb-2\">Amenities</h4>\n              <p className=\"text-sm\">{selectedAmenityNames.join(', ')}</p>\n            </div>\n          )}\n\n          {formData.photos.length > 0 && (\n            <div className=\"bg-bg-secondary rounded-lg p-4\">\n              <h4 className=\"text-xs font-semibold text-text-secondary uppercase tracking-wide mb-2\">Photos</h4>\n              <div className=\"flex gap-2 overflow-x-auto\">\n                {formData.photos.map((photo, i) => (\n                  <div key={i} className=\"w-20 h-16 rounded-lg overflow-hidden shrink-0 border border-border\">\n                    <img src={photo.url} alt={`Photo ${i + 1}`} className=\"w-full h-full object-cover\" />\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n\n          <div className=\"bg-bg-secondary rounded-lg p-4\">\n            <h4 className=\"text-xs font-semibold text-text-secondary uppercase tracking-wide mb-2\">Pricing</h4>\n            <p className=\"text-sm\"><strong>Price per night:</strong> ${formData.pricePerNight}</p>\n            <p className=\"text-sm\"><strong>Cleaning fee:</strong> ${formData.cleaningFee || '0'}</p>\n          </div>\n        </div>\n      </div>\n    )\n  }\n\n  return (\n    <div\n      data-testid=\"add-listing-form\"\n      className=\"fixed inset-0 bg-black/50 flex items-center justify-center z-50\"\n    >\n      <div className=\"bg-white rounded-xl w-full max-w-2xl max-h-[90vh] overflow-y-auto mx-4 shadow-lg\">\n        <div className=\"sticky top-0 bg-white border-b border-border px-6 py-4 flex items-center justify-between z-10\">\n          <h2 className=\"text-lg font-semibold text-text\">Add New Listing</h2>\n          <button\n            data-testid=\"add-listing-close\"\n            onClick={handleCancel}\n            className=\"w-8 h-8 rounded-full hover:bg-bg-secondary flex items-center justify-center transition-colors\"\n          >\n            <X size={20} className=\"text-text-secondary\" />\n          </button>\n        </div>\n\n        <div className=\"px-6 py-6\">\n          {renderStepIndicator()}\n\n          {step === 1 && renderStep1()}\n          {step === 2 && renderStep2()}\n          {step === 3 && renderStep3()}\n          {step === 4 && renderStep4()}\n          {step === 5 && renderStep5()}\n          {step === 6 && renderStep6()}\n          {step === 7 && renderStep7()}\n        </div>\n\n        <div className=\"sticky bottom-0 bg-white border-t border-border px-6 py-4 flex items-center justify-between\">\n          <button\n            data-testid=\"add-listing-cancel\"\n            onClick={handleCancel}\n            className=\"px-4 py-2.5 text-sm font-medium text-text-secondary hover:text-text transition-colors\"\n          >\n            Cancel\n          </button>\n          <div className=\"flex gap-3\">\n            {step > 1 && (\n              <button\n                data-testid=\"add-listing-back\"\n                onClick={handleBack}\n                className=\"flex items-center gap-1.5 px-4 py-2.5 text-sm font-medium text-text bg-bg-secondary rounded-lg hover:bg-border transition-colors\"\n              >\n                <ChevronLeft size={16} />\n                Back\n              </button>\n            )}\n            {step < TOTAL_STEPS ? (\n              <button\n                data-testid=\"add-listing-next\"\n                onClick={handleNext}\n                className=\"flex items-center gap-1.5 px-4 py-2.5 text-sm font-medium text-white bg-primary rounded-lg hover:bg-primary-dark transition-colors\"\n              >\n                Next\n                <ChevronRight size={16} />\n              </button>\n            ) : (\n              <button\n                data-testid=\"add-listing-publish\"\n                onClick={handlePublish}\n                disabled={publishing}\n                className=\"flex items-center gap-1.5 px-6 py-2.5 text-sm font-medium text-white bg-primary rounded-lg hover:bg-primary-dark transition-colors disabled:opacity-50\"\n              >\n                {publishing ? (\n                  <>\n                    <Loader2 size={16} className=\"animate-spin\" />\n                    Publishing...\n                  </>\n                ) : (\n                  'Publish'\n                )}\n              </button>\n            )}\n          </div>\n        </div>\n      </div>\n\n      {showDiscardDialog && (\n        <div\n          data-testid=\"discard-dialog\"\n          className=\"fixed inset-0 bg-black/50 flex items-center justify-center z-[60]\"\n          onClick={() => setShowDiscardDialog(false)}\n        >\n          <div\n            className=\"bg-white rounded-xl p-6 max-w-md w-full mx-4 shadow-lg\"\n            onClick={(e) => e.stopPropagation()}\n          >\n            <h3 className=\"text-lg font-semibold text-text mb-2\">Discard your listing?</h3>\n            <p className=\"text-text-secondary mb-6\">All entered information will be lost.</p>\n            <div className=\"flex gap-3 justify-end\">\n              <button\n                data-testid=\"discard-dialog-keep\"\n                onClick={() => setShowDiscardDialog(false)}\n                className=\"px-4 py-2 text-sm font-medium text-text bg-bg-secondary rounded-lg hover:bg-border transition-colors\"\n              >\n                Keep Editing\n              </button>\n              <button\n                data-testid=\"discard-dialog-confirm\"\n                onClick={onClose}\n                className=\"px-4 py-2 text-sm font-medium text-white bg-status-cancelled rounded-lg hover:opacity-90 transition-opacity\"\n              >\n                Discard\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  )\n}\n","numLines":822,"startLine":1,"totalLines":822}}}
[2026-03-16T03:40:23.021Z] {"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01KeehbW6dE77sLXkKSFyBmx","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"Now I have a good understanding of all the components. Let me audit them for accessibility issues and fix them. Here's what I need to address:\n\n**HostDashboard.tsx:**\n1. Use `<main>` instead of outer `<div>`\n2. Tab buttons need `role=\"tablist\"`, `role=\"tab\"`, `aria-selected`, `aria-controls`\n3. Tab panels need `role=\"tabpanel\"`, `aria-labelledby`\n\n**StatsOverview.tsx:**\n1. Icons need `aria-hidden=\"true\"`\n2. Loading state needs `aria-live` or loading indicator label\n\n\n3. Wrap in `<section>` with aria-label\n\n**ListingsTab.tsx:**\n1. Empty state icon needs `aria-hidden`\n2. Deactivate dialog needs proper dialog semantics with role, aria-modal, aria-labelledby, and focus management\n3. Icons in buttons and the MapPin icon need `aria-hidden`\n4. Status badge is fine since text accompanies the color\n\n**BookingsTab.tsx:**\n1. Filter buttons need `aria-pressed` or similar state attributes\n2. Cancel dialog needs the same dialog semantics and focus trap implementation\n3. Empty state icon needs `aria-hidden`, table needs a caption or aria-label, and loading state needs a label\n\n**AddListingForm.tsx:**\nLooking at the form structure, I need to add dialog semantics to the main modal and discard confirmation, implement aria-label on the close button, improve the step indicator accessibility, add proper aria attributes to the property type dropdown, label the increment/decrement buttons, add aria-label to photo removal buttons, mark required fields with aria-required, connect error messages with aria-describedby, and ensure the visual checkbox div for amenities is hidden from screen readers while keeping the underlying input accessible.\n\nNow I'm going to work through each file and apply these fixes.","signature":""}],"stop_reason":null,"stop_sequence":null,