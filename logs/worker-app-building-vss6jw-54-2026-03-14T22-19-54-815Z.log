>\n    46→        <h2 className=\"text-lg font-semibold text-text mb-3\">Amenities</h2>\n    47→        <p className=\"text-text-secondary\">No amenities listed</p>\n    48→      </div>\n    49→    )\n    50→  }\n    51→\n    52→  const categories = Array.from(new Set(amenities.map((a) => a.category)))\n    53→  const grouped = categories.map((cat) => ({\n    54→    category: cat,\n    55→    items: amenities.filter((a) => a.category === cat),\n    56→  }))\n    57→\n    58→  const displayAmenities = showAll ? amenities : amenities.slice(0, INITIAL_SHOW)\n    59→  const displayCategories = showAll\n    60→    ? grouped\n    61→    : grouped\n    62→        .map((g) => ({\n    63→          ...g,\n    64→          items: g.items.filter((a) => displayAmenities.includes(a)),\n    65→        }))\n    66→        .filter((g) => g.items.length > 0)\n    67→\n    68→  return (\n    69→    <div data-testid=\"amenities-list\" className=\"py-6 border-b border-border\">\n    70→      <h2 className=\"text-lg font-semibold text-text mb-4\">Amenities</h2>\n    71→      <div className=\"space-y-4\">\n    72→        {displayCategories.map((group) => (\n    73→          <div key={group.category}>\n    74→            <h3 className=\"text-sm font-semibold text-text-secondary uppercase tracking-wide mb-2\">\n    75→              {group.category}\n    76→            </h3>\n    77→            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2\">\n    78→              {group.items.map((amenity) => (\n    79→                <div\n    80→                  key={amenity.id}\n    81→                  data-testid={`amenity-${amenity.id}`}\n    82→                  className=\"flex items-center gap-3 text-text-secondary py-1\"\n    83→                >\n    84→                  <span className=\"text-text-secondary\">{getIcon(amenity)}</span>\n    85→                  <span>{amenity.name}</span>\n    86→                </div>\n    87→              ))}\n    88→            </div>\n    89→          </div>\n    90→        ))}\n    91→      </div>\n    92→      {amenities.length > INITIAL_SHOW && (\n    93→        <button\n    94→          data-testid=\"amenities-toggle\"\n    95→          className=\"mt-4 font-semibold text-text underline cursor-pointer\"\n    96→          onClick={() => setShowAll(!showAll)}\n    97→        >\n    98→          {showAll ? 'Show less' : `Show all ${amenities.length} amenities`}\n    99→        </button>\n   100→      )}\n   101→    </div>\n   102→  )\n   103→}\n   104→"}]},"parent_tool_use_id":null,"session_id":"ad503268-e133-4807-8fc2-652411f1db75","uuid":"eac3b93b-6472-4afd-99e8-8bae1dbb01f0","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/components/AmenitiesList.tsx","content":"import { useState } from 'react'\nimport { Wifi, Car, Tv, Flame, Wind, Waves, ShieldCheck, MapPin, Coffee, Utensils, WashingMachine, Snowflake, Check } from 'lucide-react'\nimport type { Amenity } from '../slices/propertiesSlice'\n\ninterface AmenitiesListProps {\n  amenities: Amenity[]\n}\n\nconst INITIAL_SHOW = 10\n\nconst iconMap: Record<string, React.ReactNode> = {\n  wifi: <Wifi size={20} />,\n  parking: <Car size={20} />,\n  tv: <Tv size={20} />,\n  heating: <Flame size={20} />,\n  'air conditioning': <Snowflake size={20} />,\n  pool: <Waves size={20} />,\n  'smoke detector': <ShieldCheck size={20} />,\n  'fire extinguisher': <ShieldCheck size={20} />,\n  'first aid kit': <ShieldCheck size={20} />,\n  'carbon monoxide detector': <ShieldCheck size={20} />,\n  'near beach': <MapPin size={20} />,\n  'near downtown': <MapPin size={20} />,\n  coffee: <Coffee size={20} />,\n  kitchen: <Utensils size={20} />,\n  washer: <WashingMachine size={20} />,\n  dryer: <Wind size={20} />,\n}\n\nfunction getIcon(amenity: Amenity) {\n  if (amenity.icon) {\n    const mapped = iconMap[amenity.icon.toLowerCase()]\n    if (mapped) return mapped\n  }\n  const mapped = iconMap[amenity.name.toLowerCase()]\n  if (mapped) return mapped\n  return <Check size={20} />\n}\n\nexport default function AmenitiesList({ amenities }: AmenitiesListProps) {\n  const [showAll, setShowAll] = useState(false)\n\n  if (amenities.length === 0) {\n    return (\n      <div data-testid=\"amenities-list\" className=\"py-6 border-b border-border\">\n        <h2 className=\"text-lg font-semibold text-text mb-3\">Amenities</h2>\n        <p className=\"text-text-secondary\">No amenities listed</p>\n      </div>\n    )\n  }\n\n  const categories = Array.from(new Set(amenities.map((a) => a.category)))\n  const grouped = categories.map((cat) => ({\n    category: cat,\n    items: amenities.filter((a) => a.category === cat),\n  }))\n\n  const displayAmenities = showAll ? amenities : amenities.slice(0, INITIAL_SHOW)\n  const displayCategories = showAll\n    ? grouped\n    : grouped\n        .map((g) => ({\n          ...g,\n          items: g.items.filter((a) => displayAmenities.includes(a)),\n        }))\n        .filter((g) => g.items.length > 0)\n\n  return (\n    <div data-testid=\"amenities-list\" className=\"py-6 border-b border-border\">\n      <h2 className=\"text-lg font-semibold text-text mb-4\">Amenities</h2>\n      <div className=\"space-y-4\">\n        {displayCategories.map((group) => (\n          <div key={group.category}>\n            <h3 className=\"text-sm font-semibold text-text-secondary uppercase tracking-wide mb-2\">\n              {group.category}\n            </h3>\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2\">\n              {group.items.map((amenity) => (\n                <div\n                  key={amenity.id}\n                  data-testid={`amenity-${amenity.id}`}\n                  className=\"flex items-center gap-3 text-text-secondary py-1\"\n                >\n                  <span className=\"text-text-secondary\">{getIcon(amenity)}</span>\n                  <span>{amenity.name}</span>\n                </div>\n              ))}\n            </div>\n          </div>\n        ))}\n      </div>\n      {amenities.length > INITIAL_SHOW && (\n        <button\n          data-testid=\"amenities-toggle\"\n          className=\"mt-4 font-semibold text-text underline cursor-pointer\"\n          onClick={() => setShowAll(!showAll)}\n        >\n          {showAll ? 'Show less' : `Show all ${amenities.length} amenities`}\n        </button>\n      )}\n    </div>\n  )\n}\n","numLines":104,"startLine":1,"totalLines":104}}}
