nst hasDateFilter = checkIn !== '' && checkOut !== ''\n    75→    const hasAmenityFilter = amenityCount > 0\n    76→\n    77→    const countResult = await sql`\n    78→      SELECT count(*)::int as total\n    79→      FROM properties p\n    80→      WHERE p.is_active = true\n    81→        AND (${city} = '' OR LOWER(p.city) LIKE LOWER('%' || ${city} || '%'))\n    82→        AND (${guestsNum} = 0 OR p.max_guests >= ${guestsNum})\n    83→        AND (${propertyType} = '' OR p.property_type = ${propertyType})\n    84→        AND (${minPrice} = 0 OR p.price_per_night >= ${minPrice})\n    85→        AND (${maxPrice} = 0 OR p.price_per_night <= ${maxPrice})\n    86→        AND (${minBedrooms} = 0 OR p.bedrooms >= ${minBedrooms})\n    87→        AND (${minBeds} = 0 OR p.beds >= ${minBeds})\n    88→        AND (${minBathrooms} = 0 OR p.bathrooms >= ${minBathrooms})\n    89→        AND (${!hasDateFilter} OR NOT EXISTS (\n    90→          SELECT 1 FROM bookings b\n    91→          WHERE b.property_id = p.id\n    92→          AND b.status IN ('confirmed', 'pending')\n    93→          AND b.check_in < ${checkOut || '9999-12-31'}\n    94→          AND b.check_out > ${checkIn || '1970-01-01'}\n    95→        ))\n    96→        AND (${!hasAmenityFilter} OR (\n    97→          SELECT count(*) FROM property_amenities pa\n    98→          WHERE pa.property_id = p.id AND pa.amenity_id::text = ANY(${amenityIds})\n    99→        ) >= ${amenityCount})\n   100→    `\n   101→    const countRow = countResult[0]\n   102→    const total = countRow ? (countRow as Record<string, unknown>).total as number : 0\n   103→\n   104→    const properties = await sql`\n   105→      SELECT p.*,\n   106→        (SELECT url FROM property_images pi WHERE pi.property_id = p.id ORDER BY pi.display_order ASC LIMIT 1) as main_image,\n   107→        (SELECT COALESCE(AVG(r.rating)::numeric(10,1), 0) FROM reviews r WHERE r.property_id = p.id) as avg_rating,\n   108→        (SELECT count(*)::int FROM reviews r WHERE