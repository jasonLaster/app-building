[2026-03-16T02:52:29.581Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DX1sS4XohVL9r8z5S98LNK","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test'\n     2→\n     3→const EMMA_ID = 'a3333333-3333-3333-3333-333333333333'\n     4→const PROPERTY_VILLA = 'b2222222-2222-2222-2222-222222222222'\n     5→const PROPERTY_CABIN = 'b3333333-3333-3333-3333-333333333333'\n     6→const PROPERTY_APARTMENT = 'b4444444-4444-4444-4444-444444444444'\n     7→\n     8→async function login(page: import('@playwright/test').Page, email: string) {\n     9→  await page.goto('/login')\n    10→  await page.getByTestId('login-email-input').fill(email)\n    11→  await page.getByTestId('login-submit-button').click()\n    12→  await expect(page).toHaveURL('/', { timeout: 30000 })\n    13→}\n    14→\n    15→async function deleteAllReviewsForGuest(page: import('@playwright/test').Page, guestId: string) {\n    16→  const res = await page.request.get(`/api/reviews?guest_id=${guestId}`)\n    17→  const reviews = await res.json()\n    18→  for (const review of reviews) {\n    19→    await page.request.delete(`/api/reviews/${review.id}`)\n    20→  }\n    21→}\n    22→\n    23→async function resetHostStatus(page: import('@playwright/test').Page, userId: string) {\n    24→  await page.request.post(`/api/users/${userId}/reset-host`)\n    25→}\n    26→\n    27→async function deleteNonSeedBookings(page: import('@playwright/test').Page) {\n    28→  await page.request.delete('/api/bookings')\n    29→}\n    30→\n    31→async function resetEmmaReviewsToSeed(page: import('@playwright/test').Page) {\n    32→  await deleteAllReviewsForGuest(page, EMMA_ID)\n    33→  await deleteNonSeedBookings(page)\n    34→  // Re-create seed review for Emma's completed booking\n    35→  await page.request.post('/api/reviews', {\n    36→    data: {\n    37→      booking_id: 'e1111111-1111-1111-1111-111111111111',\n    38→      property_id: 'b1111111-1111-1111-1111-111111111111',\n    39→      guest_id: EMMA_ID,\n    40→      rating: 5,\n    41→      cleanliness: 5,\n    42→      accuracy: 5,\n    43→      communication: 5,\n    44→      location: 5,\n    45→      value: 4,\n    46→      comment: 'Absolutely loved this loft! The city views are even better than the photos. Sarah was a wonderful host. Would definitely stay again.',\n    47→    },\n    48→  })\n    49→}\n    50→\n    51→async function createBookingAndReview(\n    52→  page: import('@playwright/test').Page,\n    53→  propertyId: string,\n    54→  guestId: string,\n    55→  checkIn: string,\n    56→  checkOut: string,\n    57→  reviewData: { rating: number; cleanliness: number; accuracy: number; communication: number; location: number; value: number; comment: string; created_at?: string }\n    58→) {\n    59→  const bookingRes = await page.request.post('/api/bookings', {\n    60→    data: {\n    61→      property_id: propertyId,\n    62→      guest_id: guestId,\n    63→      check_in: checkIn,\n    64→      check_out: checkOut,\n    65→      num_guests: 2,\n    66→      total_price: 500,\n    67→    },\n    68→  })\n    69→  const booking = await bookingRes.json()\n    70→\n    71→  await page.request.post('/api/reviews', {\n    72→    data: {\n    73→      booking_id: booking.id,\n    74→      property_id: propertyId,\n    75→      guest_id: guestId,\n    76→      ...reviewData,\n    77→    },\n    78→  })\n    79→}\n    80→\n    81→test.describe('Profile Page - BecomeHostButton', () => {\n    82→  test('Become a Host button is visible for non-host users', async ({ page }) => {\n    83→    test.slow()\n    84→    await resetHostStatus(page, EMMA_ID)\n    85→    await login(page, 'emma@example.com')\n    86→    await page.goto('/profile')\n    87→\n    88→    await expect(page.getByTestId('become-host-button')).toBeVisible({ timeout: 30000 })\n    89→    await expect(page.getByTestId('become-host-button')).toContainText('Become a Host')\n    90→  })\n    91→\n    92→  test('Become a Host button is hidden for existing hosts', async ({ page }) => {\n    93→    test.slow()\n    94→    await login(page, 'sarah@example.com')\n    95→    await page.goto('/profile')\n    96→\n    97→    await expect(page.getByTestId('profile-page')).toBeVisible({ timeout: 30000 })\n    98→    await expect(page.getByTestId('become-host-button')).not.toBeVisible()\n    99→  })\n   100→\n   101→  test('Clicking Become a Host sets user as host', async ({ page }) => {\n   102→    test.slow()\n   103→    await resetHostStatus(page, EMMA_ID)\n   104→    await login(page, 'emma@example.com')\n   105→    await page.goto('/profile')\n   106→\n   107→    await expect(page.getByTestId('become-host-button')).toBeVisible({ timeout: 30000 })\n   108→    await page.getByTestId('become-host-button').click()\n   109→\n   110→    // Confirmation dialog appears\n   111→    await expect(page.getByTestId('become-host-dialog')).toBeVisible()\n   112→\n   113→    // Confirm\n   114→    await page.getByTestId('become-host-confirm').click()\n   115→\n   116→    // Button disappears and success message shown\n   117→    await expect(page.getByTestId('become-host-success')).toBeVisible({ timeout: 30000 })\n   118→    await expect(page.getByTestId('become-host-success')).toContainText('You are now a host!')\n   119→    await expect(page.getByTestId('become-host-button')).not.toBeVisible()\n   120→\n   121→    // Hosting link now visible in sidebar\n   122→    await expect(page.getByTestId('sidebar-link-hosting')).toBeVisible({ timeout: 30000 })\n   123→  })\n   124→\n   125→  test('Cancel Become a Host confirmation dialog', async ({ page }) => {\n   126→    test.slow()\n   127→    await resetHostStatus(page, EMMA_ID)\n   128→    await login(page, 'emma@example.com')\n   129→    await page.goto('/profile')\n   130→\n   131→    await expect(page.getByTestId('become-host-button')).toBeVisible({ timeout: 30000 })\n   132→    await page.getByTestId('become-host-button').click()\n   133→\n   134→    // Dialog appears\n   135→    await expect(page.getByTestId('become-host-dialog')).toBeVisible()\n   136→\n   137→    // Cancel\n   138→    await page.getByTestId('become-host-cancel').click()\n   139→\n   140→    // Dialog closes, button remains\n   141→    await expect(page.getByTestId('become-host-dialog')).not.toBeVisible()\n   142→    await expect(page.getByTestId('become-host-button')).toBeVisible()\n   143→  })\n   144→\n   145→  test('Become a Host button appearance', async ({ page }) => {\n   146→    test.slow()\n   147→    await resetHostStatus(page, EMMA_ID)\n   148→    await login(page, 'emma@example.com')\n   149→    await page.goto('/profile')\n   150→\n   151→    await expect(page.getByTestId('become-host-button')).toBeVisible({ timeout: 30000 })\n   152→    await expect(page.getByTestId('become-host-button')).toContainText('Become a Host')\n   153→\n   154→    const bgColor = await page.getByTestId('become-host-button').evaluate(\n   155→      (el) => getComputedStyle(el).backgroundColor\n   156→    )\n   157→    // #FF5A5F = rgb(255, 90, 95)\n   158→    expect(bgColor).toBe('rgb(255, 90, 95)')\n   159→  })\n   160→})\n   161→\n   162→test.describe('Profile Page - UserReviewsList', () => {\n   163→  test('Reviews list displays user\\'s written reviews', async ({ page }) => {\n   164→    test.slow()\n   165→    // Emma has 1 review for \"Cozy Downtown Loft with City Views\" rated 5\n   166→    await login(page, 'emma@example.com')\n   167→    await resetEmmaReviewsToSeed(page)\n   168→    await page.goto('/profile')\n   169→\n   170→    await expect(page.getByTestId('user-reviews-list')).toBeVisible({ timeout: 30000 })\n   171→    await expect(page.getByTestId('user-reviews-list')).toContainText('My Reviews')\n   172→\n   173→    // Emma has 1 review in the seed data\n   174→    const reviewCards = page.locator('[data-testid^=\"review-card-\"]')\n   175→    await expect(reviewCards).toHaveCount(1, { timeout: 30000 })\n   176→\n   177→    // Verify review card content\n   178→    const reviewCard = reviewCards.first()\n   179→    await expect(reviewCard).toContainText('Cozy Downtown Loft with City Views')\n   180→    await expect(reviewCard.getByTestId('star-rating')).toBeVisible()\n   181→    await expect(reviewCard).toContainText('Absolutely loved this loft!')\n   182→  })\n   183→\n   184→  test('Reviews list shows empty state for user with no reviews', async ({ page }) => {\n   185→    test.slow()\n   186→    // Register a new user who has no reviews\n   187→    const uniqueEmail = `noreview-${Date.now()}@example.com`\n   188→    await page.goto('/login')\n   189→    await page.getByTestId('auth-toggle-link').click()\n   190→    await expect(page.getByTestId('register-form')).toBeVisible()\n   191→    await page.getByTestId('register-name-input').fill('No Review User')\n   192→    await page.getByTestId('register-email-input').fill(uniqueEmail)\n   193→    await page.getByTestId('register-submit-button').click()\n   194→    await expect(page).toHaveURL('/', { timeout: 30000 })\n   195→\n   196→    await page.goto('/profile')\n   197→    await expect(page.getByTestId('user-reviews-list')).toBeVisible({ timeout: 30000 })\n   198→    await expect(page.getByTestId('reviews-empty-state')).toBeVisible()\n   199→    await expect(page.getByTestId('reviews-empty-state')).toContainText(\"You haven't written any reviews yet\")\n   200→  })\n   201→\n   202→  test('Review card shows rating with star display', async ({ page }) => {\n   203→    test.slow()\n   204→    // Emma's review has rating 5\n   205→    await login(page, 'emma@example.com')\n   206→    await resetEmmaReviewsToSeed(page)\n   207→    await page.goto('/profile')\n   208→\n   209→    await expect(page.getByTestId('user-reviews-list')).toBeVisible({ timeout: 30000 })\n   210→    const reviewCards = page.locator('[data-testid^=\"review-card-\"]')\n   211→    await expect(reviewCards).toHaveCount(1, { timeout: 30000 })\n   212→\n   213→    const starRating = reviewCards.first().getByTestId('star-rating')\n   214→    await expect(starRating).toBeVisible()\n   215→\n   216→    // Rating 5: all 5 stars should be filled (have fill=\"currentColor\")\n   217→    const filledStars = starRating.locator('svg[fill=\"currentColor\"]')\n   218→    await expect(filledStars).toHaveCount(5)\n   219→  })\n   220→\n   221→  test('Review card links to the reviewed property', async ({ page }) => {\n   222→    test.slow()\n   223→    // Emma's review is for property b1111111-1111-1111-1111-111111111111\n   224→    await login(page, 'emma@example.com')\n   225→    await resetEmmaReviewsToSeed(page)\n   226→    await page.goto('/profile')\n   227→\n   228→    await expect(page.getByTestId('user-reviews-list')).toBeVisible({ timeout: 30000 })\n   229→    const reviewCards = page.locator('[data-testid^=\"review-card-\"]')\n   230→    await expect(reviewCards).toHaveCount(1, { timeout: 30000 })\n   231→\n   232→    // Click the property link in the review card\n   233→    const propertyLink = reviewCards.first().locator('[data-testid^=\"review-property-link-\"]')\n   234→    await expect(propertyLink).toContainText('Cozy Downtown Loft with City Views')\n   235→    await propertyLink.click()\n   236→\n   237→    await expect(page).toHaveURL(/\\/properties\\/b1111111-1111-1111-1111-111111111111/, { timeout: 30000 })\n   238→  })\n   239→\n   240→  test('Reviews list shows review details correctly', async ({ page }) => {\n   241→    test.slow()\n   242→    // Set up: delete existing reviews for Emma and non-seed bookings, create one with specific details\n   243→    await login(page, 'emma@example.com')\n   244→\n   245→    await deleteAllReviewsForGuest(page, EMMA_ID)\n   246→    await deleteNonSeedBookings(page)\n   247→    await createBookingAndReview(page, PROPERTY_VILLA, EMMA_ID, '2025-07-01', '2025-07-05', {\n   248→      rating: 5,\n   249→      cleanliness: 5,\n   250→      accuracy: 5,\n   251→      communication: 5,\n   252→      location: 5,\n   253→      value: 5,\n   254→      comment: 'Amazing stay! The host was very welcoming.',\n   255→      created_at: '2026-01-15T12:00:00.000Z',\n   256→    })\n   257→\n   258→    await page.goto('/profile')\n   259→    await expect(page.getByTestId('user-reviews-list')).toBeVisible({ timeout: 30000 })\n   260→\n   261→    const reviewCards = page.locator('[data-testid^=\"review-card-\"]')\n   262→    await expect(reviewCards).toHaveCount(1, { timeout: 30000 })\n   263→\n   264→    const card = reviewCards.first()\n   265→\n   266→    // Verify property title\n   267→    await expect(card).toContainText('Beachfront Villa with Private Pool')\n   268→\n   269→    // Verify 5 filled stars\n   270→    const starRating = card.getByTestId('star-rating')\n   271→    await expect(starRating).toBeVisible()\n   272→    const filledStars = starRating.locator('svg[fill=\"currentColor\"]')\n   273→    await expect(filledStars).toHaveCount(5)\n   274→\n   275→    // Verify comment text\n   276→    await expect(card).toContainText('Amazing stay! The host was very welcoming.')\n   277→\n   278→    // Verify formatted date \"Jan 15, 2026\"\n   279→    await expect(card).toContainText('Jan 15, 2026')\n   280→  })\n   281→\n   282→  test('Reviews list updates after writing a new review', async ({ page }) => {\n   283→    test.slow()\n   284→    // Set up: delete all of Emma's reviews and non-seed bookings, create 2 new reviews via API\n   285→    await login(page, 'emma@example.com')\n   286→\n   287→    await deleteAllReviewsForGuest(page, EMMA_ID)\n   288→    await deleteNonSeedBookings(page)\n   289→\n   290→    // Create 2 reviews for Emma on different properties\n   291→    await createBookingAndReview(page, PROPERTY_VILLA, EMMA_ID, '2025-06-01', '2025-06-05', {\n   292→      rating: 4,\n   293→      cleanliness: 4,\n   294→      accuracy: 4,\n   295→      communication: 4,\n   296→      location: 4,\n   297→      value: 4,\n   298→      comment: 'Great villa stay',\n   299→    })\n   300→    await createBookingAndReview(page, PROPERTY_CABIN, EMMA_ID, '2025-07-01', '2025-07-05', {\n   301→      rating: 5,\n   302→      cleanliness: 5,\n   303→      accuracy: 5,\n   304→      communication: 5,\n   305→      location: 5,\n   306→      value: 5,\n   307→      comment: 'Wonderful cabin retreat',\n   308→    })\n   309→\n   310→    // Navigate to profile and verify 2 existing reviews\n   311→    await page.goto('/profile')\n   312→    await expect(page.getByTestId('user-reviews-list')).toBeVisible({ timeout: 30000 })\n   313→    const reviewCards = page.locator('[data-testid^=\"review-card-\"]')\n   314→    await expect(reviewCards).toHaveCount(2, { timeout: 30000 })\n   315→\n   316→    // Emma's seed booking e1111111 is 'completed' for Cozy Downtown Loft.\n   317→    // Its review was deleted above, so \"Write Review\" should be available.\n   318→    // Navigate to write a review for that booking\n   319→    await page.goto('/trips/e1111111-1111-1111-1111-111111111111/review')\n   320→    await expect(page.getByTestId('review-form')).toBeVisible({ timeout: 30000 })\n   321→\n   322→    // Fill in the review - set all ratings first\n   323→    for (const key of ['rating', 'cleanliness', 'accuracy', 'communication', 'location', 'value']) {\n   324→      await page.getByTestId(`rating-input-${key}`).fill('5')\n   325→    }\n   326→    await page.getByTestId('review-comment-textarea').fill('Fantastic loft with amazing views!')\n   327→    await page.getByTestId('submit-review-button').click()\n   328→\n   329→    // Wait for success\n   330→    await expect(page.getByTestId('review-success-message')).toBeVisible({ timeout: 30000 })\n   331→\n   332→    // Navigate back to profile\n   333→    await page.goto('/profile')\n   334→    await expect(page.getByTestId('user-reviews-list')).toBeVisible({ timeout: 30000 })\n   335→\n   336→    // Should now show 3 reviews\n   337→    await expect(reviewCards).toHaveCount(3, { timeout: 30000 })\n   338→\n   339→    // Verify the newly written review is present with correct property title and comment\n   340→    const newReviewCard = reviewCards.filter({\n   341→      has: page.locator('[data-testid^=\"review-property-link-\"]', { hasText: 'Cozy Downtown Loft with City Views' }),\n   342→    })\n   343→    await expect(newReviewCard).toHaveCount(1)\n   344→    await expect(newReviewCard).toContainText('Fantastic loft with amazing views!')\n   345→  })\n   346→\n   347→  test('Reviews list shows multiple reviews in chronological order', async ({ page }) => {\n   348→    test.slow()\n   349→    // Set up: delete all of Emma's reviews and non-seed bookings, create 3 with specific dates\n   350→    await login(page, 'emma@example.com')\n   351→\n   352→    await deleteAllReviewsForGuest(page, EMMA_ID)\n   353→    await deleteNonSeedBookings(page)\n   354→\n   355→    // Create 3 reviews with different dates (inserted in non-chronological order to test sorting)\n   356→    await createBookingAndReview(page, PROPERTY_VILLA, EMMA_ID, '2025-06-01', '2025-06-05', {\n   357→      rating: 4,\n   358→      cleanliness: 4,\n   359→      accuracy: 4,\n   360→      communication: 4,\n   361→      location: 4,\n   362→      value: 4,\n   363→      comment: 'Great beachfront villa',\n   364→      created_at: '2026-01-15T12:00:00.000Z',\n   365→    })\n   366→    await createBookingAndReview(page, PROPERTY_APARTMENT, EMMA_ID, '2025-07-01', '2025-07-05', {\n   367→      rating: 4,\n   368→      cleanliness: 4,\n   369→      accuracy: 4,\n   370→      communication: 4,\n   371→      location: 4,\n   372→      value: 4,\n   373→      comment: 'Nice Austin apartment',\n   374→      created_at: '2026-02-10T12:00:00.000Z',\n   375→    })\n   376→    await createBookingAndReview(page, PROPERTY_CABIN, EMMA_ID, '2025-08-01', '2025-08-05', {\n   377→      rating: 5,\n   378→      cleanliness: 5,\n   379→      accuracy: 5,\n   380→      communication: 5,\n   381→      location: 5,\n   382→      value: 5,\n   383→      comment: 'Amazing cabin retreat',\n   384→      created_at: '2026-03-05T12:00:00.000Z',\n   385→    })\n   386→\n   387→    await page.goto('/profile')\n   388→    await expect(page.getByTestId('user-reviews-list')).toBeVisible({ timeout: 30000 })\n   389→\n   390→    const reviewCards = page.locator('[data-testid^=\"review-card-\"]')\n   391→    await expect(reviewCards).toHaveCount(3, { timeout: 30000 })\n   392→\n   393→    // Reviews should be in reverse chronological order (newest first):\n   394→    // 1. Mountain Cabin Retreat (Mar 5, 2026)\n   395→    // 2. Modern Austin Apartment (Feb 10, 2026)\n   396→    // 3. Beachfront Villa with Private Pool (Jan 15, 2026)\n   397→    const firstCard = reviewCards.nth(0)\n   398→    await expect(firstCard).toContainText('Mountain Cabin Retreat')\n   399→    await expect(firstCard).toContainText('Mar 5, 2026')\n   400→\n   401→    const secondCard = reviewCards.nth(1)\n   402→    await expect(secondCard).toContainText('Modern Austin Apartment')\n   403→    await expect(secondCard).toContainText('Feb 10, 2026')\n   404→\n   405→    const thirdCard = reviewCards.nth(2)\n   406→    await expect(thirdCard).toContainText('Beachfront Villa with Private Pool')\n   407→    await expect(thirdCard).toContainText('Jan 15, 2026')\n   408→  })\n   409→})\n   410→"}]},"parent_tool_use_id":null,"session_id":"359070a2-ef16-4ece-aef2-9a71cffe91e8","uuid":"5fd9e922-0edf-4cdc-9fbd-5654f4c0ae84","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/tests/profile-host-reviews.spec.ts","content":"import { test, expect } from '@playwright/test'\n\nconst EMMA_ID = 'a3333333-3333-3333-3333-333333333333'\nconst PROPERTY_VILLA = 'b2222222-2222-2222-2222-222222222222'\nconst PROPERTY_CABIN = 'b3333333-3333-3333-3333-333333333333'\nconst PROPERTY_APARTMENT = 'b4444444-4444-4444-4444-444444444444'\n\nasync function login(page: import('@playwright/test').Page, email: string) {\n  await page.goto('/login')\n  await page.getByTestId('login-email-input').fill(email)\n  await page.getByTestId('login-submit-button').click()\n  await expect(page).toHaveURL('/', { timeout: 30000 })\n}\n\nasync function deleteAllReviewsForGuest(page: import('@playwright/test').Page, guestId: string) {\n  const res = await page.request.get(`/api/reviews?guest_id=${guestId}`)\n  const reviews = await res.json()\n  for (const review of reviews) {\n    await page.request.delete(`/api/reviews/${review.id}`)\n  }\n}\n\nasync function resetHostStatus(page: import('@playwright/test').Page, userId: string) {\n  await page.request.post(`/api/users/${userId}/reset-host`)\n}\n\nasync function deleteNonSeedBookings(page: import('@playwright/test').Page) {\n  await page.request.delete('/api/bookings')\n}\n\nasync function resetEmmaReviewsToSeed(page: import('@playwright/test').Page) {\n  await deleteAllReviewsForGuest(page, EMMA_ID)\n  await deleteNonSeedBookings(page)\n  // Re-create seed review for Emma's completed booking\n  await page.request.post('/api/reviews', {\n    data: {\n      booking_id: 'e1111111-1111-1111-1111-111111111111',\n      property_id: 'b1111111-1111-1111-1111-111111111111',\n      guest_id: EMMA_ID,\n      rating: 5,\n      cleanliness: 5,\n      accuracy: 5,\n      communication: 5,\n      location: 5,\n      value: 4,\n      comment: 'Absolutely loved this loft! The city views are even better than the photos. Sarah was a wonderful host. Would definitely stay again.',\n    },\n  })\n}\n\nasync function createBookingAndReview(\n  page: import('@playwright/test').Page,\n  propertyId: string,\n  guestId: string,\n  checkIn: string,\n  checkOut: string,\n  reviewData: { rating: number; cleanliness: number; accuracy: number; communication: number; location: number; value: number; comment: string; created_at?: string }\n) {\n  const bookingRes = await page.request.post('/api/bookings', {\n    data: {\n      property_id: propertyId,\n      guest_id: guestId,\n      check_in: checkIn,\n      check_out: checkOut,\n      num_guests: 2,\n      total_price: 500,\n    },\n  })\n  const booking = await bookingRes.json()\n\n  await page.request.post('/api/reviews', {\n    data: {\n      booking_id: booking.id,\n      property_id: propertyId,\n      guest_id: guestId,\n      ...reviewData,\n    },\n  })\n}\n\ntest.describe('Profile Page - BecomeHostButton', () => {\n  test('Become a Host button is visible for non-host users', async ({ page }) => {\n    test.slow()\n    await resetHostStatus(page, EMMA_ID)\n    await login(page, 'emma@example.com')\n    await page.goto('/profile')\n\n    await expect(page.getByTestId('become-host-button')).toBeVisible({ timeout: 30000 })\n    await expect(page.getByTestId('become-host-button')).toContainText('Become a Host')\n  })\n\n  test('Become a Host button is hidden for existing hosts', async ({ page }) => {\n    test.slow()\n    await login(page, 'sarah@example.com')\n    await page.goto('/profile')\n\n    await expect(page.getByTestId('profile-page')).toBeVisible({ timeout: 30000 })\n    await expect(page.getByTestId('become-host-button')).not.toBeVisible()\n  })\n\n  test('Clicking Become a Host sets user as host', async ({ page }) => {\n    test.slow()\n    await resetHostStatus(page, EMMA_ID)\n    await login(page, 'emma@example.com')\n    await page.goto('/profile')\n\n    await expect(page.getByTestId('become-host-button')).toBeVisible({ timeout: 30000 })\n    await page.getByTestId('become-host-button').click()\n\n    // Confirmation dialog appears\n    await expect(page.getByTestId('become-host-dialog')).toBeVisible()\n\n    // Confirm\n    await page.getByTestId('become-host-confirm').click()\n\n    // Button disappears and success message shown\n    await expect(page.getByTestId('become-host-success')).toBeVisible({ timeout: 30000 })\n    await expect(page.getByTestId('become-host-success')).toContainText('You are now a host!')\n    await expect(page.getByTestId('become-host-button')).not.toBeVisible()\n\n    // Hosting link now visible in sidebar\n    await expect(page.getByTestId('sidebar-link-hosting')).toBeVisible({ timeout: 30000 })\n  })\n\n  test('Cancel Become a Host confirmation dialog', async ({ page }) => {\n    test.slow()\n    await resetHostStatus(page, EMMA_ID)\n    await login(page, 'emma@example.com')\n    await page.goto('/profile')\n\n    await expect(page.getByTestId('become-host-button')).toBeVisible({ timeout: 30000 })\n    await page.getByTestId('become-host-button').click()\n\n    // Dialog appears\n    await expect(page.getByTestId('become-host-dialog')).toBeVisible()\n\n    // Cancel\n    await page.getByTestId('become-host-cancel').click()\n\n    // Dialog closes, button remains\n    await expect(page.getByTestId('become-host-dialog')).not.toBeVisible()\n    await expect(page.getByTestId('become-host-button')).toBeVisible()\n  })\n\n  test('Become a Host button appearance', async ({ page }) => {\n    test.slow()\n    await resetHostStatus(page, EMMA_ID)\n    await login(page, 'emma@example.com')\n    await page.goto('/profile')\n\n    await expect(page.getByTestId('become-host-button')).toBeVisible({ timeout: 30000 })\n    await expect(page.getByTestId('become-host-button')).toContainText('Become a Host')\n\n    const bgColor = await page.getByTestId('become-host-button').evaluate(\n      (el) => getComputedStyle(el).backgroundColor\n    )\n    // #FF5A5F = rgb(255, 90, 95)\n    expect(bgColor).toBe('rgb(255, 90, 95)')\n  })\n})\n\ntest.describe('Profile Page - UserReviewsList', () => {\n  test('Reviews list displays user\\'s written reviews', async ({ page }) => {\n    test.slow()\n    // Emma has 1 review for \"Cozy Downtown Loft with City Views\" rated 5\n    await login(page, 'emma@example.com')\n    await resetEmmaReviewsToSeed(page)\n    await page.goto('/profile')\n\n    await expect(page.getByTestId('user-reviews-list')).toBeVisible({ timeout: 30000 })\n    await expect(page.getByTestId('user-reviews-list')).toContainText('My Reviews')\n\n    // Emma has 1 review in the seed data\n    const reviewCards = page.locator('[data-testid^=\"review-card-\"]')\n    await expect(reviewCards).toHaveCount(1, { timeout: 30000 })\n\n    // Verify review card content\n    const reviewCard = reviewCards.first()\n    await expect(reviewCard).toContainText('Cozy Downtown Loft with City Views')\n    await expect(reviewCard.getByTestId('star-rating')).toBeVisible()\n    await expect(reviewCard).toContainText('Absolutely loved this loft!')\n  })\n\n  test('Reviews list shows empty state for user with no reviews', async ({ page }) => {\n    test.slow()\n    // Register a new user who has no reviews\n    const uniqueEmail = `noreview-${Date.now()}@example.com`\n    await page.goto('/login')\n    await page.getByTestId('auth-toggle-link').click()\n    await expect(page.getByTestId('register-form')).toBeVisible()\n    await page.getByTestId('register-name-input').fill('No Review User')\n    await page.getByTestId('register-email-input').fill(uniqueEmail)\n    await page.getByTestId('register-submit-button').click()\n    await expect(page).toHaveURL('/', { timeout: 30000 })\n\n    await page.goto('/profile')\n    await expect(page.getByTestId('user-reviews-list')).toBeVisible({ timeout: 30000 })\n    await expect(page.getByTestId('reviews-empty-state')).toBeVisible()\n    await expect(page.getByTestId('reviews-empty-state')).toContainText(\"You haven't written any reviews yet\")\n  })\n\n  test('Review card shows rating with star display', async ({ page }) => {\n    test.slow()\n    // Emma's review has rating 5\n    await login(page, 'emma@example.com')\n    await resetEmmaReviewsToSeed(page)\n    await page.goto('/profile')\n\n    await expect(page.getByTestId('user-reviews-list')).toBeVisible({ timeout: 30000 })\n    const reviewCards = page.locator('[data-testid^=\"review-card-\"]')\n    await expect(reviewCards).toHaveCount(1, { timeout: 30000 })\n\n    const starRating = reviewCards.first().getByTestId('star-rating')\n    await expect(starRating).toBeVisible()\n\n    // Rating 5: all 5 stars should be filled (have fill=\"currentColor\")\n    const filledStars = starRating.locator('svg[fill=\"currentColor\"]')\n    await expect(filledStars).toHaveCount(5)\n  })\n\n  test('Review card links to the reviewed property', async ({ page }) => {\n    test.slow()\n    // Emma's review is for property b1111111-1111-1111-1111-111111111111\n    await login(page, 'emma@example.com')\n    await resetEmmaReviewsToSeed(page)\n    await page.goto('/profile')\n\n    await expect(page.getByTestId('user-reviews-list')).toBeVisible({ timeout: 30000 })\n    const reviewCards = page.locator('[data-testid^=\"review-card-\"]')\n    await expect(reviewCards).toHaveCount(1, { timeout: 30000 })\n\n    // Click the property link in the review card\n    const propertyLink = reviewCards.first().locator('[data-testid^=\"review-property-link-\"]')\n    await expect(propertyLink).toContainText('Cozy Downtown Loft with City Views')\n    await propertyLink.click()\n\n    await expect(page).toHaveURL(/\\/properties\\/b1111111-1111-1111-1111-111111111111/, { timeout: 30000 })\n  })\n\n  test('Reviews list shows review details correctly', async ({ page }) => {\n    test.slow()\n    // Set up: delete existing reviews for Emma and non-seed bookings, create one with specific details\n    await login(page, 'emma@example.com')\n\n    await deleteAllReviewsForGuest(page, EMMA_ID)\n    await deleteNonSeedBookings(page)\n    await createBookingAndReview(page, PROPERTY_VILLA, EMMA_ID, '2025-07-01', '2025-07-05', {\n      rating: 5,\n      cleanliness: 5,\n      accuracy: 5,\n      communication: 5,\n      location: 5,\n      value: 5,\n      comment: 'Amazing stay! The host was very welcoming.',\n      created_at: '2026-01-15T12:00:00.000Z',\n    })\n\n    await page.goto('/profile')\n    await expect(page.getByTestId('user-reviews-list')).toBeVisible({ timeout: 30000 })\n\n    const reviewCards = page.locator('[data-testid^=\"review-card-\"]')\n    await expect(reviewCards).toHaveCount(1, { timeout: 30000 })\n\n    const card = reviewCards.first()\n\n    // Verify property title\n    await expect(card).toContainText('Beachfront Villa with Private Pool')\n\n    // Verify 5 filled stars\n    const starRating = card.getByTestId('star-rating')\n    await expect(starRating).toBeVisible()\n    const filledStars = starRating.locator('svg[fill=\"currentColor\"]')\n    await expect(filledStars).toHaveCount(5)\n\n    // Verify comment text\n    await expect(card).toContainText('Amazing stay! The host was very welcoming.')\n\n    // Verify formatted date \"Jan 15, 2026\"\n    await expect(card).toContainText('Jan 15, 2026')\n  })\n\n  test('Reviews list updates after writing a new review', async ({ page }) => {\n    test.slow()\n    // Set up: delete all of Emma's reviews and non-seed bookings, create 2 new reviews via API\n    await login(page, 'emma@example.com')\n\n    await deleteAllReviewsForGuest(page, EMMA_ID)\n    await deleteNonSeedBookings(page)\n\n    // Create 2 reviews for Emma on different properties\n    await createBookingAndReview(page, PROPERTY_VILLA, EMMA_ID, '2025-06-01', '2025-06-05', {\n      rating: 4,\n      cleanliness: 4,\n      accuracy: 4,\n      communication: 4,\n      location: 4,\n      value: 4,\n      comment: 'Great villa stay',\n    })\n    await createBookingAndReview(page, PROPERTY_CABIN, EMMA_ID, '2025-07-01', '2025-07-05', {\n      rating: 5,\n      cleanliness: 5,\n      accuracy: 5,\n      communication: 5,\n      location: 5,\n      value: 5,\n      comment: 'Wonderful cabin retreat',\n    })\n\n    // Navigate to profile and verify 2 existing reviews\n    await page.goto('/profile')\n    await expect(page.getByTestId('user-reviews-list')).toBeVisible({ timeout: 30000 })\n    const reviewCards = page.locator('[data-testid^=\"review-card-\"]')\n    await expect(reviewCards).toHaveCount(2, { timeout: 30000 })\n\n    // Emma's seed booking e1111111 is 'completed' for Cozy Downtown Loft.\n    // Its review was deleted above, so \"Write Review\" should be available.\n    // Navigate to write a review for that booking\n    await page.goto('/trips/e1111111-1111-1111-1111-111111111111/review')\n    await expect(page.getByTestId('review-form')).toBeVisible({ timeout: 30000 })\n\n    // Fill in the review - set all ratings first\n    for (const key of ['rating', 'cleanliness', 'accuracy', 'communication', 'location', 'value']) {\n      await page.getByTestId(`rating-input-${key}`).fill('5')\n    }\n    await page.getByTestId('review-comment-textarea').fill('Fantastic loft with amazing views!')\n    await page.getByTestId('submit-review-button').click()\n\n    // Wait for success\n    await expect(page.getByTestId('review-success-message')).toBeVisible({ timeout: 30000 })\n\n    // Navigate back to profile\n    await page.goto('/profile')\n    await expect(page.getByTestId('user-reviews-list')).toBeVisible({ timeout: 30000 })\n\n    // Should now show 3 reviews\n    await expect(reviewCards).toHaveCount(3, { timeout: 30000 })\n\n    // Verify the newly written review is present with correct property title and comment\n    const newReviewCard = reviewCards.filter({\n      has: page.locator('[data-testid^=\"review-property-link-\"]', { hasText: 'Cozy Downtown Loft with City Views' }),\n    })\n    await expect(newReviewCard).toHaveCount(1)\n    await expect(newReviewCard).toContainText('Fantastic loft with amazing views!')\n  })\n\n  test('Reviews list shows multiple reviews in chronological order', async ({ page }) => {\n    test.slow()\n    // Set up: delete all of Emma's reviews and non-seed bookings, create 3 with specific dates\n    await login(page, 'emma@example.com')\n\n    await deleteAllReviewsForGuest(page, EMMA_ID)\n    await deleteNonSeedBookings(page)\n\n    // Create 3 reviews with different dates (inserted in non-chronological order to test sorting)\n    await createBookingAndReview(page, PROPERTY_VILLA, EMMA_ID, '2025-06-01', '2025-06-05', {\n      rating: 4,\n      cleanliness: 4,\n      accuracy: 4,\n      communication: 4,\n      location: 4,\n      value: 4,\n      comment: 'Great beachfront villa',\n      created_at: '2026-01-15T12:00:00.000Z',\n    })\n    await createBookingAndReview(page, PROPERTY_APARTMENT, EMMA_ID, '2025-07-01', '2025-07-05', {\n      rating: 4,\n      cleanliness: 4,\n      accuracy: 4,\n      communication: 4,\n      location: 4,\n      value: 4,\n      comment: 'Nice Austin apartment',\n      created_at: '2026-02-10T12:00:00.000Z',\n    })\n    await createBookingAndReview(page, PROPERTY_CABIN, EMMA_ID, '2025-08-01', '2025-08-05', {\n      rating: 5,\n      cleanliness: 5,\n      accuracy: 5,\n      communication: 5,\n      location: 5,\n      value: 5,\n      comment: 'Amazing cabin retreat',\n      created_at: '2026-03-05T12:00:00.000Z',\n    })\n\n    await page.goto('/profile')\n    await expect(page.getByTestId('user-reviews-list')).toBeVisible({ timeout: 30000 })\n\n    const reviewCards = page.locator('[data-testid^=\"review-card-\"]')\n    await expect(reviewCards).toHaveCount(3, { timeout: 30000 })\n\n    // Reviews should be in reverse chronological order (newest first):\n    // 1. Mountain Cabin Retreat (Mar 5, 2026)\n    // 2. Modern Austin Apartment (Feb 10, 2026)\n    // 3. Beachfront Villa with Private Pool (Jan 15, 2026)\n    const firstCard = reviewCards.nth(0)\n    await expect(firstCard).toContainText('Mountain Cabin Retreat')\n    await expect(firstCard).toContainText('Mar 5, 2026')\n\n    const secondCard = reviewCards.nth(1)\n    await expect(secondCard).toContainText('Modern Austin Apartment')\n    await expect(secondCard).toContainText('Feb 10, 2026')\n\n    const thirdCard = reviewCards.nth(2)\n    await expect(thirdCard).toContainText('Beachfront Villa with Private Pool')\n    await expect(thirdCard).toContainText('Jan 15, 2026')\n  })\n})\n","numLines":410,"startLine":1,"totalLines":410}}}
