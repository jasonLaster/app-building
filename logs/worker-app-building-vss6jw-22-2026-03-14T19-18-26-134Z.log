[2026-03-14T19:13:16.570Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Nk8jqteb9cotZn1APcn7js","type":"tool_result","content":"     1→import { createSlice, createAsyncThunk } from '@reduxjs/toolkit'\n     2→\n     3→export interface User {\n     4→  id: string\n     5→  email: string\n     6→  name: string\n     7→  avatar_url: string | null\n     8→  bio: string | null\n     9→  phone: string | null\n    10→  is_host: boolean\n    11→  created_at: string\n    12→}\n    13→\n    14→interface AuthState {\n    15→  currentUser: User | null\n    16→  loading: boolean\n    17→  error: string | null\n    18→}\n    19→\n    20→const initialState: AuthState = {\n    21→  currentUser: null,\n    22→  loading: false,\n    23→  error: null,\n    24→}\n    25→\n    26→export const loginUser = createAsyncThunk(\n    27→  'auth/loginUser',\n    28→  async (email: string, { rejectWithValue }) => {\n    29→    const response = await fetch('/api/auth', {\n    30→      method: 'POST',\n    31→      headers: { 'Content-Type': 'application/json' },\n    32→      body: JSON.stringify({ email }),\n    33→    })\n    34→    const data = await response.json()\n    35→    if (!response.ok) {\n    36→      return rejectWithValue(data.error || 'Login failed')\n    37→    }\n    38→    return data as User\n    39→  }\n    40→)\n    41→\n    42→export const registerUser = createAsyncThunk(\n    43→  'auth/registerUser',\n    44→  async ({ name, email }: { name: string; email: string }, { rejectWithValue }) => {\n    45→    const response = await fetch('/api/auth', {\n    46→      method: 'POST',\n    47→      headers: { 'Content-Type': 'application/json' },\n    48→      body: JSON.stringify({ name, email }),\n    49→    })\n    50→    const data = await response.json()\n    51→    if (!response.ok) {\n    52→      return rejectWithValue(data.error || 'Registration failed')\n    53→    }\n    54→    return data as User\n    55→  }\n    56→)\n    57→\n    58→const authSlice = createSlice({\n    59→  name: 'auth',\n    60→  initialState,\n    61→  reducers: {\n    62→    logout(state) {\n    63→      state.currentUser = null\n    64→      state.error = null\n    65→    },\n    66→    clearError(state) {\n    67→      state.error = null\n    68→    },\n    69→  },\n    70→  extraReducers: (builder) => {\n    71→    builder\n    72→      .addCase(loginUser.pending, (state) => {\n    73→        state.loading = true\n    74→        state.error = null\n    75→      })\n    76→      .addCase(loginUser.fulfilled, (state, action) => {\n    77→        state.loading = false\n    78→        state.currentUser = action.payload\n    79→        state.error = null\n    80→      })\n    81→      .addCase(loginUser.rejected, (state, action) => {\n    82→        state.loading = false\n    83→        state.error = action.payload as string\n    84→      })\n    85→      .addCase(registerUser.pending, (state) => {\n    86→        state.loading = true\n    87→        state.error = null\n    88→      })\n    89→      .addCase(registerUser.fulfilled, (state, action) => {\n    90→        state.loading = false\n    91→        state.currentUser = action.payload\n    92→        state.error = null\n    93→      })\n    94→      .addCase(registerUser.rejected, (state, action) => {\n    95→        state.loading = false\n    96→        state.error = action.payload as string\n    97→      })\n    98→  },\n    99→})\n   100→\n   101→export const { logout, clearError } = authSlice.actions\n   102→export default authSlice.reducer\n   103→"}]},"parent_tool_use_id":"toolu_017aQPysC4TihaQS6XLgibos","session_id":"97722ae6-646d-4e72-bb5f-9045753eda3a","uuid":"31e5349a-90f0-4dda-ab20-6e0a583a9f3d"}
