40→\n    41→  const handleApplyFilters = useCallback((panelFilters: {\n    42→    minPrice: number\n    43→    maxPrice: number\n    44→    minBedrooms: number\n    45→    minBeds: number\n    46→    minBathrooms: number\n    47→    amenityIds: string[]\n    48→  }) => {\n    49→    dispatch(setFilters({ ...panelFilters, page: 1 }))\n    50→  }, [dispatch])\n    51→\n    52→  const handleResetFilters = useCallback(() => {\n    53→    dispatch(resetFilters())\n    54→  }, [dispatch])\n    55→\n    56→  const handlePageChange = useCallback((page: number) => {\n    57→    dispatch(setPage(page))\n    58→    window.scrollTo({ top: 0, behavior: 'smooth' })\n    59→  }, [dispatch])\n    60→\n    61→  return (\n    62→    <div data-testid=\"home-page\" className=\"p-6 max-sm:p-3 max-w-7xl mx-auto\">\n    63→      <div className=\"mb-4\">\n    64→        <SearchBar\n    65→          onSearch={handleSearch}\n    66→          initialCity={filters.city}\n    67→          initialCheckIn={filters.checkIn}\n    68→          initialCheckOut={filters.checkOut}\n    69→          initialGuests={filters.guests}\n    70→        />\n    71→      </div>\n    72→\n    73→      <div className=\"flex items-center gap-3 mb-4\">\n    74→        <div className=\"flex-1 overflow-hidden\">\n    75→          <CategoryFilter\n    76→            selectedType={filters.propertyType}\n    77→            onSelectType={handleCategorySelect}\n    78→          />\n    79→        </div>\n    80→        <FiltersPanel\n    81→          minPrice={filters.minPrice}\n    82→          maxPrice={filters.maxPrice}\n    83→          minBedrooms={filters.minBedrooms}\n    84→          minBeds={filters.minBeds}\n    85→          minBathrooms={filters.minBathrooms}\n    86→          selectedAmenityIds={filters.amenityIds}\n    87→          onApplyFilters={handleApplyFilters}\n    88→          onReset={handleResetFilters}\n    89→        />\n    90→      </div>\n    91→\n    92→      <PropertyGrid properties={items} loading={loading} />\n    93→\n    94→      <Pagination\n    95→        currentPage={filters.page}\n    96→        totalPages={totalPages}\n    97→        onPageChange={handlePageChange}\n    98→      />\n    99→    </div>\n   100→  )\n   101→}\n   102→"}]},"parent_tool_use_id":null,"session_id":"97722ae6-646d-4e72-bb5f-9045753eda3a","uuid":"831dddea-e98d-45ad-b000-49b24cb690dd","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/pages/Home.tsx","content":"import { useEffect, useCallback } from 'react'\nimport { useSelector, useDispatch } from 'react-redux'\nimport type { RootState, AppDispatch } from '../store'\nimport { fetchProperties, setFilters, resetFilters, setPage } from '../slices/propertiesSlice'\nimport { fetchFavorites } from '../slices/favoritesSlice'\nimport SearchBar from '../components/SearchBar'\nimport CategoryFilter from '../components/CategoryFilter'\nimport PropertyGrid from '../components/PropertyGrid'\nimport FiltersPanel from '../components/FiltersPanel'\nimport Pagination from '../components/Pagination'\n\nexport default function Home() {\n  const dispatch = useDispatch<AppDispatch>()\n  const { items, loading, totalPages, filters } = useSelector((state: RootState) => state.properties)\n  const currentUser = useSelector((state: RootState) => state.auth.currentUser)\n\n  useEffect(() => {\n    dispatch(fetchProperties(filters))\n  }, [dispatch, filters])\n\n  useEffect(() => {\n    if (currentUser) {\n      dispatch(fetchFavorites(currentUser.id))\n    }\n  }, [dispatch, currentUser])\n\n  const handleSearch = useCallback((searchFilters: { city: string; checkIn: string; checkOut: string; guests: number }) => {\n    dispatch(setFilters({\n      city: searchFilters.city,\n      checkIn: searchFilters.checkIn,\n      checkOut: searchFilters.checkOut,\n      guests: searchFilters.guests,\n      page: 1,\n    }))\n  }, [dispatch])\n\n  const handleCategorySelect = useCallback((type: string) => {\n    dispatch(setFilters({ propertyType: type, page: 1 }))\n  }, [dispatch])\n\n  const handleApplyFilters = useCallback((panelFilters: {\n    minPrice: number\n    maxPrice: number\n    minBedrooms: number\n    minBeds: number\n    minBathrooms: number\n    amenityIds: string[]\n  }) => {\n    dispatch(setFilters({ ...panelFilters, page: 1 }))\n  }, [dispatch])\n\n  const handleResetFilters = useCallback(() => {\n    dispatch(resetFilters())\n  }, [dispatch])\n\n  const handlePageChange = useCallback((page: number) => {\n    dispatch(setPage(page))\n    window.scrollTo({ top: 0, behavior: 'smooth' })\n  }, [dispatch])\n\n  return (\n    <div data-testid=\"home-page\" className=\"p-6 max-sm:p-3 max-w-7xl mx-auto\">\n      <div className=\"mb-4\">\n        <SearchBar\n          onSearch={handleSearch}\n          initialCity={filters.city}\n          initialCheckIn={filters.checkIn}\n          initialCheckOut={filters.checkOut}\n          initialGuests={filters.guests}\n        />\n      </div>\n\n      <div className=\"flex items-center gap-3 mb-4\">\n        <div className=\"flex-1 overflow-hidden\">\n          <CategoryFilter\n            selectedType={filters.propertyType}\n            onSelectType={handleCategorySelect}\n          />\n        </div>\n        <FiltersPanel\n          minPrice={filters.minPrice}\n          maxPrice={filters.maxPrice}\n          minBedrooms={filters.minBedrooms}\n          minBeds={filters.minBeds}\n          minBathrooms={filters.minBathrooms}\n          selectedAmenityIds={filters.amenityIds}\n          onApplyFilters={handleApplyFilters}\n          onReset={handleResetFilters}\n        />\n      </div>\n\n      <PropertyGrid properties={items} loading={loading} />\n\n      <Pagination\n        currentPage={filters.page}\n        totalPages={totalPages}\n        onPageChange={handlePageChange}\n      />\n    </div>\n  )\n}\n","numLines":102,"startLine":1,"totalLines":102}}}
