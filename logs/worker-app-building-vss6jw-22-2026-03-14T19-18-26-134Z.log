    <div className=\"flex items-center justify-between\">\n    43→          <h3 className=\"font-semibold text-text text-sm truncate\">{property.title}</h3>\n    44→          {reviewCount > 0 ? (\n    45→            <div className=\"flex items-center gap-1 shrink-0 ml-2\">\n    46→              <Star size={14} className=\"fill-text text-text\" />\n    47→              <span className=\"text-sm font-medium text-text\">{rating.toFixed(1)}</span>\n    48→              <span className=\"text-sm text-text-secondary\">({reviewCount})</span>\n    49→            </div>\n    50→          ) : (\n    51→            <span className=\"text-sm text-text-secondary shrink-0 ml-2\">New</span>\n    52→          )}\n    53→        </div>\n    54→        <p className=\"text-text-secondary text-sm mt-0.5\">\n    55→          {property.city}, {property.country}\n    56→        </p>\n    57→        <p className=\"mt-1 text-sm\">\n    58→          <span className=\"font-semibold text-text\">${Number(property.price_per_night).toFixed(0)}</span>\n    59→          <span className=\"text-text-secondary\"> / night</span>\n    60→        </p>\n    61→      </div>\n    62→    </div>\n    63→  )\n    64→}\n    65→"}]},"parent_tool_use_id":null,"session_id":"97722ae6-646d-4e72-bb5f-9045753eda3a","uuid":"3ed5fe30-8293-496f-86f5-ad5fc6cf2255","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/components/PropertyCard.tsx","content":"import { useNavigate } from 'react-router-dom'\nimport { Star } from 'lucide-react'\nimport type { Property } from '../slices/propertiesSlice'\nimport FavoriteButton from './FavoriteButton'\n\ninterface PropertyCardProps {\n  property: Property\n}\n\nexport default function PropertyCard({ property }: PropertyCardProps) {\n  const navigate = useNavigate()\n  const rating = Number(property.avg_rating) || 0\n  const reviewCount = property.review_count || 0\n\n  return (\n    <div\n      data-testid={`property-card-${property.id}`}\n      className=\"cursor-pointer rounded-xl overflow-visible group\"\n      onClick={() => navigate(`/properties/${property.id}`)}\n    >\n      <div className=\"relative aspect-[4/3] overflow-hidden rounded-xl\">\n        {property.main_image ? (\n          <img\n            src={property.main_image}\n            alt={property.title}\n            className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-300\"\n          />\n        ) : (\n          <div className=\"w-full h-full bg-bg-secondary flex items-center justify-center text-text-secondary text-sm\">\n            No image\n          </div>\n        )}\n        <span\n          data-testid={`property-type-badge-${property.id}`}\n          className=\"absolute top-3 left-3 bg-white/90 text-text text-xs font-semibold px-2.5 py-1 rounded-full\"\n        >\n          {property.property_type}\n        </span>\n        <FavoriteButton propertyId={property.id} />\n      </div>\n      <div className=\"mt-2.5\">\n        <div className=\"flex items-center justify-between\">\n          <h3 className=\"font-semibold text-text text-sm truncate\">{property.title}</h3>\n          {reviewCount > 0 ? (\n            <div className=\"flex items-center gap-1 shrink-0 ml-2\">\n              <Star size={14} className=\"fill-text text-text\" />\n              <span className=\"text-sm font-medium text-text\">{rating.toFixed(1)}</span>\n              <span className=\"text-sm text-text-secondary\">({reviewCount})</span>\n            </div>\n          ) : (\n            <span className=\"text-sm text-text-secondary shrink-0 ml-2\">New</span>\n          )}\n        </div>\n        <p className=\"text-text-secondary text-sm mt-0.5\">\n          {property.city}, {property.country}\n        </p>\n        <p className=\"mt-1 text-sm\">\n          <span className=\"font-semibold text-text\">${Number(property.price_per_night).toFixed(0)}</span>\n          <span className=\"text-text-secondary\"> / night</span>\n        </p>\n      </div>\n    </div>\n  )\n}\n","numLines":65,"startLine":1,"totalLines":65}}}
