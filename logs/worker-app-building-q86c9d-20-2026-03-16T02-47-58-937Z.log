[2026-03-16T01:58:52.470Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DmGJjxvKqHmnHWZQrQTQBg","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test'\n     2→\n     3→// Sarah's property IDs (host a1111111)\n     4→const PROP_LOFT = 'b1111111-1111-1111-1111-111111111111'\n     5→const PROP_VILLA = 'b2222222-2222-2222-2222-222222222222'\n     6→const PROP_TOWNHOUSE = 'b5555555-5555-5555-5555-555555555555'\n     7→\n     8→const BASE = 'http://localhost:8888'\n     9→\n    10→async function loginAsHost(page: import('@playwright/test').Page) {\n    11→  await page.goto('/login')\n    12→  await page.getByTestId('login-email-input').fill('sarah@example.com')\n    13→  await page.getByTestId('login-submit-button').click()\n    14→  await expect(page).toHaveURL('/', { timeout: 30000 })\n    15→}\n    16→\n    17→async function goToHostDashboard(page: import('@playwright/test').Page) {\n    18→  await loginAsHost(page)\n    19→  await page.goto('/hosting')\n    20→  await expect(page.getByTestId('listings-tab')).toBeVisible({ timeout: 30000 })\n    21→}\n    22→\n    23→test.describe('Host Dashboard - Listings Tab', () => {\n    24→  test.beforeEach(async ({ request }) => {\n    25→    // Reset all properties to active state before each test\n    26→    await request.put(`${BASE}/api/properties/${PROP_LOFT}`, { data: { is_active: true } })\n    27→    await request.put(`${BASE}/api/properties/${PROP_VILLA}`, { data: { is_active: true } })\n    28→    await request.put(`${BASE}/api/properties/${PROP_TOWNHOUSE}`, { data: { is_active: true } })\n    29→  })\n    30→  test('Listings tab displays host\\'s properties in a grid', async ({ page }) => {\n    31→    await goToHostDashboard(page)\n    32→\n    33→    // Sarah has 3 properties\n    34→    const cards = page.locator('[data-testid^=\"listing-card-\"]')\n    35→    await expect(cards).toHaveCount(3, { timeout: 15000 })\n    36→\n    37→    // Verify each property card is visible\n    38→    await expect(page.getByTestId(`listing-card-${PROP_LOFT}`)).toBeVisible()\n    39→    await expect(page.getByTestId(`listing-card-${PROP_VILLA}`)).toBeVisible()\n    40→    await expect(page.getByTestId(`listing-card-${PROP_TOWNHOUSE}`)).toBeVisible()\n    41→  })\n    42→\n    43→  test('Listing card shows property details', async ({ page }) => {\n    44→    await goToHostDashboard(page)\n    45→\n    46→    // Check the Loft card details: title, price, city, rating, review count, active badge\n    47→    const loftCard = page.getByTestId(`listing-card-${PROP_LOFT}`)\n    48→    await expect(loftCard).toBeVisible({ timeout: 15000 })\n    49→    await expect(loftCard).toContainText('Cozy Downtown Loft with City Views')\n    50→    await expect(loftCard).toContainText('$150')\n    51→    await expect(loftCard).toContainText('New York')\n    52→    await expect(loftCard).toContainText('5.0')\n    53→    await expect(loftCard).toContainText('1 reviews')\n    54→\n    55→    const statusBadge = page.getByTestId(`listing-status-${PROP_LOFT}`)\n    56→    await expect(statusBadge).toHaveText('Active')\n    57→  })\n    58→\n    59→  test('Listing card has Edit button that navigates to property detail', async ({ page }) => {\n    60→    await goToHostDashboard(page)\n    61→\n    62→    const editBtn = page.getByTestId(`listing-edit-${PROP_LOFT}`)\n    63→    await expect(editBtn).toBeVisible({ timeout: 15000 })\n    64→    await editBtn.click()\n    65→\n    66→    await expect(page).toHaveURL(`/properties/${PROP_LOFT}`, { timeout: 30000 })\n    67→  })\n    68→\n    69→  test('Listing card has Deactivate button for active properties', async ({ page }) => {\n    70→    await goToHostDashboard(page)\n    71→\n    72→    // Click Deactivate on the Loft\n    73→    const deactivateBtn = page.getByTestId(`listing-deactivate-${PROP_LOFT}`)\n    74→    await expect(deactivateBtn).toBeVisible({ timeout: 15000 })\n    75→    await deactivateBtn.click()\n    76→\n    77→    // Confirmation dialog should appear\n    78→    const dialog = page.getByTestId('deactivate-dialog')\n    79→    await expect(dialog).toBeVisible({ timeout: 15000 })\n    80→    await expect(dialog).toContainText('Are you sure you want to deactivate this listing?')\n    81→    await expect(dialog).toContainText('Cozy Downtown Loft with City Views')\n    82→  })\n    83→\n    84→  test('Confirming deactivation sets property to inactive', async ({ page }) => {\n    85→    await goToHostDashboard(page)\n    86→\n    87→    // Capture initial Total Listings count\n    88→    await expect(page.getByTestId('stat-total-listings')).toContainText('3', { timeout: 15000 })\n    89→\n    90→    // Deactivate the Loft\n    91→    await page.getByTestId(`listing-deactivate-${PROP_LOFT}`).click()\n    92→    await expect(page.getByTestId('deactivate-dialog')).toBeVisible({ timeout: 15000 })\n    93→    await page.getByTestId('deactivate-dialog-confirm').click()\n    94→\n    95→    // Dialog should close\n    96→    await expect(page.getByTestId('deactivate-dialog')).not.toBeVisible({ timeout: 15000 })\n    97→\n    98→    // Property status should change to Inactive\n    99→    await expect(page.getByTestId(`listing-status-${PROP_LOFT}`)).toHaveText('Inactive', { timeout: 15000 })\n   100→\n   101→    // Total Listings stat should decrease\n   102→    await expect(page.getByTestId('stat-total-listings')).toContainText('2', { timeout: 15000 })\n   103→  })\n   104→\n   105→  test('Dismissing deactivation dialog keeps property active', async ({ page }) => {\n   106→    await goToHostDashboard(page)\n   107→\n   108→    // Open deactivation dialog for the Loft\n   109→    await page.getByTestId(`listing-deactivate-${PROP_LOFT}`).click()\n   110→    await expect(page.getByTestId('deactivate-dialog')).toBeVisible({ timeout: 15000 })\n   111→\n   112→    // Cancel/dismiss the dialog\n   113→    await page.getByTestId('deactivate-dialog-cancel').click()\n   114→\n   115→    // Dialog should close\n   116→    await expect(page.getByTestId('deactivate-dialog')).not.toBeVisible({ timeout: 15000 })\n   117→\n   118→    // Property should still be active\n   119→    await expect(page.getByTestId(`listing-status-${PROP_LOFT}`)).toHaveText('Active')\n   120→  })\n   121→\n   122→  test('Listing card shows Activate button for inactive properties', async ({ page }) => {\n   123→    await goToHostDashboard(page)\n   124→\n   125→    // First deactivate the Loft via API to make it inactive\n   126→    await page.request.delete(`http://localhost:8888/api/properties/${PROP_LOFT}`)\n   127→\n   128→    // Reload to see updated state\n   129→    await page.goto('/hosting')\n   130→    await expect(page.getByTestId('listings-tab')).toBeVisible({ timeout: 30000 })\n   131→\n   132→    // Loft should now show Inactive status and Activate button\n   133→    await expect(page.getByTestId(`listing-status-${PROP_LOFT}`)).toHaveText('Inactive', { timeout: 15000 })\n   134→    const activateBtn = page.getByTestId(`listing-activate-${PROP_LOFT}`)\n   135→    await expect(activateBtn).toBeVisible()\n   136→\n   137→    // Click Activate\n   138→    await activateBtn.click()\n   139→\n   140→    // Property should become Active again\n   141→    await expect(page.getByTestId(`listing-status-${PROP_LOFT}`)).toHaveText('Active', { timeout: 15000 })\n   142→\n   143→    // Total Listings stat should update\n   144→    await expect(page.getByTestId('stat-total-listings')).toContainText('3', { timeout: 15000 })\n   145→  })\n   146→\n   147→  test('Listings tab shows empty state for host with no properties', async ({ page, request }) => {\n   148→    // Make emma a host via API (she has no properties)\n   149→    await request.post('http://localhost:8888/api/users/a3333333-3333-3333-3333-333333333333/become-host')\n   150→\n   151→    // Login as emma\n   152→    await page.goto('/login')\n   153→    await page.getByTestId('login-email-input').fill('emma@example.com')\n   154→    await page.getByTestId('login-submit-button').click()\n   155→    await expect(page).toHaveURL('/', { timeout: 30000 })\n   156→\n   157→    await page.goto('/hosting')\n   158→    await expect(page.getByTestId('listings-tab')).toBeVisible({ timeout: 30000 })\n   159→\n   160→    // Should show empty state\n   161→    await expect(page.getByTestId('listings-empty-state')).toBeVisible({ timeout: 15000 })\n   162→    await expect(page.getByTestId('listings-empty-state')).toContainText(\"You don't have any listings yet\")\n   163→  })\n   164→\n   165→  test('Add Listing button is visible on the Listings tab', async ({ page }) => {\n   166→    await goToHostDashboard(page)\n   167→\n   168→    const addBtn = page.getByTestId('add-listing-button')\n   169→    await expect(addBtn).toBeVisible({ timeout: 15000 })\n   170→    await expect(addBtn).toContainText('Add Listing')\n   171→  })\n   172→\n   173→  test('Deactivate and activate actions work on repeated use', async ({ page }) => {\n   174→    test.slow()\n   175→    await goToHostDashboard(page)\n   176→\n   177→    // Verify initial state: 3 active listings\n   178→    await expect(page.getByTestId('stat-total-listings')).toContainText('3', { timeout: 15000 })\n   179→\n   180→    // 1. Deactivate the Loft (first property)\n   181→    await page.getByTestId(`listing-deactivate-${PROP_LOFT}`).click()\n   182→    await expect(page.getByTestId('deactivate-dialog')).toBeVisible({ timeout: 15000 })\n   183→    await page.getByTestId('deactivate-dialog-confirm').click()\n   184→    await expect(page.getByTestId('deactivate-dialog')).not.toBeVisible({ timeout: 15000 })\n   185→    await expect(page.getByTestId(`listing-status-${PROP_LOFT}`)).toHaveText('Inactive', { timeout: 15000 })\n   186→    await expect(page.getByTestId('stat-total-listings')).toContainText('2', { timeout: 15000 })\n   187→\n   188→    // 2. Activate the Loft back\n   189→    await page.getByTestId(`listing-activate-${PROP_LOFT}`).click()\n   190→    await expect(page.getByTestId(`listing-status-${PROP_LOFT}`)).toHaveText('Active', { timeout: 15000 })\n   191→    await expect(page.getByTestId('stat-total-listings')).toContainText('3', { timeout: 15000 })\n   192→\n   193→    // 3. Deactivate the Villa (second property)\n   194→    await page.getByTestId(`listing-deactivate-${PROP_VILLA}`).click()\n   195→    await expect(page.getByTestId('deactivate-dialog')).toBeVisible({ timeout: 15000 })\n   196→    await page.getByTestId('deactivate-dialog-confirm').click()\n   197→    await expect(page.getByTestId('deactivate-dialog')).not.toBeVisible({ timeout: 15000 })\n   198→    await expect(page.getByTestId(`listing-status-${PROP_VILLA}`)).toHaveText('Inactive', { timeout: 15000 })\n   199→    await expect(page.getByTestId('stat-total-listings')).toContainText('2', { timeout: 15000 })\n   200→  })\n   201→})\n   202→"}]},"parent_tool_use_id":null,"session_id":"de9cf088-76c1-4b0c-9c3c-ee899a3d3836","uuid":"21a7c851-3a3a-4d78-8641-a88a156810ef","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/tests/host-dashboard-listings.spec.ts","content":"import { test, expect } from '@playwright/test'\n\n// Sarah's property IDs (host a1111111)\nconst PROP_LOFT = 'b1111111-1111-1111-1111-111111111111'\nconst PROP_VILLA = 'b2222222-2222-2222-2222-222222222222'\nconst PROP_TOWNHOUSE = 'b5555555-5555-5555-5555-555555555555'\n\nconst BASE = 'http://localhost:8888'\n\nasync function loginAsHost(page: import('@playwright/test').Page) {\n  await page.goto('/login')\n  await page.getByTestId('login-email-input').fill('sarah@example.com')\n  await page.getByTestId('login-submit-button').click()\n  await expect(page).toHaveURL('/', { timeout: 30000 })\n}\n\nasync function goToHostDashboard(page: import('@playwright/test').Page) {\n  await loginAsHost(page)\n  await page.goto('/hosting')\n  await expect(page.getByTestId('listings-tab')).toBeVisible({ timeout: 30000 })\n}\n\ntest.describe('Host Dashboard - Listings Tab', () => {\n  test.beforeEach(async ({ request }) => {\n    // Reset all properties to active state before each test\n    await request.put(`${BASE}/api/properties/${PROP_LOFT}`, { data: { is_active: true } })\n    await request.put(`${BASE}/api/properties/${PROP_VILLA}`, { data: { is_active: true } })\n    await request.put(`${BASE}/api/properties/${PROP_TOWNHOUSE}`, { data: { is_active: true } })\n  })\n  test('Listings tab displays host\\'s properties in a grid', async ({ page }) => {\n    await goToHostDashboard(page)\n\n    // Sarah has 3 properties\n    const cards = page.locator('[data-testid^=\"listing-card-\"]')\n    await expect(cards).toHaveCount(3, { timeout: 15000 })\n\n    // Verify each property card is visible\n    await expect(page.getByTestId(`listing-card-${PROP_LOFT}`)).toBeVisible()\n    await expect(page.getByTestId(`listing-card-${PROP_VILLA}`)).toBeVisible()\n    await expect(page.getByTestId(`listing-card-${PROP_TOWNHOUSE}`)).toBeVisible()\n  })\n\n  test('Listing card shows property details', async ({ page }) => {\n    await goToHostDashboard(page)\n\n    // Check the Loft card details: title, price, city, rating, review count, active badge\n    const loftCard = page.getByTestId(`listing-card-${PROP_LOFT}`)\n    await expect(loftCard).toBeVisible({ timeout: 15000 })\n    await expect(loftCard).toContainText('Cozy Downtown Loft with City Views')\n    await expect(loftCard).toContainText('$150')\n    await expect(loftCard).toContainText('New York')\n    await expect(loftCard).toContainText('5.0')\n    await expect(loftCard).toContainText('1 reviews')\n\n    const statusBadge = page.getByTestId(`listing-status-${PROP_LOFT}`)\n    await expect(statusBadge).toHaveText('Active')\n  })\n\n  test('Listing card has Edit button that navigates to property detail', async ({ page }) => {\n    await goToHostDashboard(page)\n\n    const editBtn = page.getByTestId(`listing-edit-${PROP_LOFT}`)\n    await expect(editBtn).toBeVisible({ timeout: 15000 })\n    await editBtn.click()\n\n    await expect(page).toHaveURL(`/properties/${PROP_LOFT}`, { timeout: 30000 })\n  })\n\n  test('Listing card has Deactivate button for active properties', async ({ page }) => {\n    await goToHostDashboard(page)\n\n    // Click Deactivate on the Loft\n    const deactivateBtn = page.getByTestId(`listing-deactivate-${PROP_LOFT}`)\n    await expect(deactivateBtn).toBeVisible({ timeout: 15000 })\n    await deactivateBtn.click()\n\n    // Confirmation dialog should appear\n    const dialog = page.getByTestId('deactivate-dialog')\n    await expect(dialog).toBeVisible({ timeout: 15000 })\n    await expect(dialog).toContainText('Are you sure you want to deactivate this listing?')\n    await expect(dialog).toContainText('Cozy Downtown Loft with City Views')\n  })\n\n  test('Confirming deactivation sets property to inactive', async ({ page }) => {\n    await goToHostDashboard(page)\n\n    // Capture initial Total Listings count\n    await expect(page.getByTestId('stat-total-listings')).toContainText('3', { timeout: 15000 })\n\n    // Deactivate the Loft\n    await page.getByTestId(`listing-deactivate-${PROP_LOFT}`).click()\n    await expect(page.getByTestId('deactivate-dialog')).toBeVisible({ timeout: 15000 })\n    await page.getByTestId('deactivate-dialog-confirm').click()\n\n    // Dialog should close\n    await expect(page.getByTestId('deactivate-dialog')).not.toBeVisible({ timeout: 15000 })\n\n    // Property status should change to Inactive\n    await expect(page.getByTestId(`listing-status-${PROP_LOFT}`)).toHaveText('Inactive', { timeout: 15000 })\n\n    // Total Listings stat should decrease\n    await expect(page.getByTestId('stat-total-listings')).toContainText('2', { timeout: 15000 })\n  })\n\n  test('Dismissing deactivation dialog keeps property active', async ({ page }) => {\n    await goToHostDashboard(page)\n\n    // Open deactivation dialog for the Loft\n    await page.getByTestId(`listing-deactivate-${PROP_LOFT}`).click()\n    await expect(page.getByTestId('deactivate-dialog')).toBeVisible({ timeout: 15000 })\n\n    // Cancel/dismiss the dialog\n    await page.getByTestId('deactivate-dialog-cancel').click()\n\n    // Dialog should close\n    await expect(page.getByTestId('deactivate-dialog')).not.toBeVisible({ timeout: 15000 })\n\n    // Property should still be active\n    await expect(page.getByTestId(`listing-status-${PROP_LOFT}`)).toHaveText('Active')\n  })\n\n  test('Listing card shows Activate button for inactive properties', async ({ page }) => {\n    await goToHostDashboard(page)\n\n    // First deactivate the Loft via API to make it inactive\n    await page.request.delete(`http://localhost:8888/api/properties/${PROP_LOFT}`)\n\n    // Reload to see updated state\n    await page.goto('/hosting')\n    await expect(page.getByTestId('listings-tab')).toBeVisible({ timeout: 30000 })\n\n    // Loft should now show Inactive status and Activate button\n    await expect(page.getByTestId(`listing-status-${PROP_LOFT}`)).toHaveText('Inactive', { timeout: 15000 })\n    const activateBtn = page.getByTestId(`listing-activate-${PROP_LOFT}`)\n    await expect(activateBtn).toBeVisible()\n\n    // Click Activate\n    await activateBtn.click()\n\n    // Property should become Active again\n    await expect(page.getByTestId(`listing-status-${PROP_LOFT}`)).toHaveText('Active', { timeout: 15000 })\n\n    // Total Listings stat should update\n    await expect(page.getByTestId('stat-total-listings')).toContainText('3', { timeout: 15000 })\n  })\n\n  test('Listings tab shows empty state for host with no properties', async ({ page, request }) => {\n    // Make emma a host via API (she has no properties)\n    await request.post('http://localhost:8888/api/users/a3333333-3333-3333-3333-333333333333/become-host')\n\n    // Login as emma\n    await page.goto('/login')\n    await page.getByTestId('login-email-input').fill('emma@example.com')\n    await page.getByTestId('login-submit-button').click()\n    await expect(page).toHaveURL('/', { timeout: 30000 })\n\n    await page.goto('/hosting')\n    await expect(page.getByTestId('listings-tab')).toBeVisible({ timeout: 30000 })\n\n    // Should show empty state\n    await expect(page.getByTestId('listings-empty-state')).toBeVisible({ timeout: 15000 })\n    await expect(page.getByTestId('listings-empty-state')).toContainText(\"You don't have any listings yet\")\n  })\n\n  test('Add Listing button is visible on the Listings tab', async ({ page }) => {\n    await goToHostDashboard(page)\n\n    const addBtn = page.getByTestId('add-listing-button')\n    await expect(addBtn).toBeVisible({ timeout: 15000 })\n    await expect(addBtn).toContainText('Add Listing')\n  })\n\n  test('Deactivate and activate actions work on repeated use', async ({ page }) => {\n    test.slow()\n    await goToHostDashboard(page)\n\n    // Verify initial state: 3 active listings\n    await expect(page.getByTestId('stat-total-listings')).toContainText('3', { timeout: 15000 })\n\n    // 1. Deactivate the Loft (first property)\n    await page.getByTestId(`listing-deactivate-${PROP_LOFT}`).click()\n    await expect(page.getByTestId('deactivate-dialog')).toBeVisible({ timeout: 15000 })\n    await page.getByTestId('deactivate-dialog-confirm').click()\n    await expect(page.getByTestId('deactivate-dialog')).not.toBeVisible({ timeout: 15000 })\n    await expect(page.getByTestId(`listing-status-${PROP_LOFT}`)).toHaveText('Inactive', { timeout: 15000 })\n    await expect(page.getByTestId('stat-total-listings')).toContainText('2', { timeout: 15000 })\n\n    // 2. Activate the Loft back\n    await page.getByTestId(`listing-activate-${PROP_LOFT}`).click()\n    await expect(page.getByTestId(`listing-status-${PROP_LOFT}`)).toHaveText('Active', { timeout: 15000 })\n    await expect(page.getByTestId('stat-total-listings')).toContainText('3', { timeout: 15000 })\n\n    // 3. Deactivate the Villa (second property)\n    await page.getByTestId(`listing-deactivate-${PROP_VILLA}`).click()\n    await expect(page.getByTestId('deactivate-dialog')).toBeVisible({ timeout: 15000 })\n    await page.getByTestId('deactivate-dialog-confirm').click()\n    await expect(page.getByTestId('deactivate-dialog')).not.toBeVisible({ timeout: 15000 })\n    await expect(page.getByTestId(`listing-status-${PROP_VILLA}`)).toHaveText('Inactive', { timeout: 15000 })\n    await expect(page.getByTestId('stat-total-listings')).toContainText('2', { timeout: 15000 })\n  })\n})\n","numLines":202,"startLine":1,"totalLines":202}}}
