[2026-03-14T19:33:45.173Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EW32FuDWFbQKhPSsWJBNiy","type":"tool_result","content":"     1→import { useEffect, useCallback } from 'react'\n     2→import { useSelector, useDispatch } from 'react-redux'\n     3→import type { RootState, AppDispatch } from '../store'\n     4→import { fetchProperties, setFilters, resetFilters, setPage } from '../slices/propertiesSlice'\n     5→import { fetchFavorites } from '../slices/favoritesSlice'\n     6→import SearchBar from '../components/SearchBar'\n     7→import CategoryFilter from '../components/CategoryFilter'\n     8→import PropertyGrid from '../components/PropertyGrid'\n     9→import FiltersPanel from '../components/FiltersPanel'\n    10→import Pagination from '../components/Pagination'\n    11→\n    12→export default function Home() {\n    13→  const dispatch = useDispatch<AppDispatch>()\n    14→  const { items, loading, totalPages, filters } = useSelector((state: RootState) => state.properties)\n    15→  const currentUser = useSelector((state: RootState) => state.auth.currentUser)\n    16→\n    17→  useEffect(() => {\n    18→    dispatch(fetchProperties(filters))\n    19→  }, [dispatch, filters])\n    20→\n    21→  useEffect(() => {\n    22→    if (currentUser) {\n    23→      dispatch(fetchFavorites(currentUser.id))\n    24→    }\n    25→  }, [dispatch, currentUser])\n    26→\n    27→  const handleSearch = useCallback((searchFilters: { city: string; checkIn: string; checkOut: string; guests: number }) => {\n    28→    dispatch(setFilters({\n    29→      city: searchFilters.city,\n    30→      checkIn: searchFilters.checkIn,\n    31→      checkOut: searchFilters.checkOut,\n    32→      guests: searchFilters.guests,\n    33→      page: 1,\n    34→    }))\n    35→  }, [dispatch])\n    36→\n    37→  const handleCategorySelect = useCallback((type: string) => {\n    38→    dispatch(setFilters({ propertyType: type, page: 1 }))\n    39→  }, [dispatch])\n    40→\n    41→  const handleApplyFilters = useCallback((panelFilters: {\n    42→    minPrice: number\n    43→    maxPrice: number\n    44→    minBedrooms: number\n    45→    minBeds: number\n    46→    minBathrooms: number\n    47→    amenityIds: string[]\n    48→  }) => {\n    49→    dispatch(setFilters({ ...panelFilters, page: 1 }))\n    50→  }, [dispatch])\n    51→\n    52→  const handleResetFilters = useCallback(() => {\n    53→    dispatch(resetFilters())\n    54→  }, [dispatch])\n    55→\n    56→  const handlePageChange = useCallback((page: number) => {\n    57→    dispatch(setPage(page))\n    58→    window.scrollTo({ top: 0, behavior: 'smooth' })\n    59→  }, [dispatch])\n    60→\n    61→  return (\n    62→    <div data-testid=\"home-page\" className=\"p-6 max-sm:p-3 max-w-7xl mx-auto\">\n    63→      <div className=\"mb-4\">\n    64→        <SearchBar\n    65→          onSearch={handleSearch}\n    66→          initialCity={filters.city}\n    67→          initialCheckIn={filters.checkIn}\n    68→          initialCheckOut={filters.checkOut}\n    69→          initialGuests={filters.guests}\n    70→        />\n    71→      </div>\n    72→\n    73→      <div className=\"flex items-center gap-3 mb-4\">\n    74→        <div className=\"flex-1 overflow-hidden\">\n    75→          <CategoryFilter\n    76→            selectedType={filters.propertyType}\n    77→            onSelectType={handleCategorySelect}\n    78→          />\n    79→        </div>\n    80→        <FiltersPanel\n    81→          minPrice={filters.minPrice}\n    82→          maxPrice={filters.maxPrice}\n    83→          minBedrooms={filters.minBedrooms}\n    84→          minBeds={filters.minBeds}\n    85→          minBathrooms={filters.minBathrooms}\n    86→          selectedAmenityIds={filters.amenityIds}\n    87→          onApplyFilters={handleApplyFilters}\n    88→          onReset={handleResetFilters}\n    89→        />\n    90→      </div>\n    91→\n    92→      <PropertyGrid properties={items} loading={loading} />\n    93→\n    94→      <Pagination\n    95→        currentPage={filters.page}\n    96→        totalPages={totalPages}\n    97→        onPageChange={handlePageChange}\n    98→      />\n    99→    </div>\n   100→  )\n   101→}\n   102→"}]},"parent_tool_use_id":"toolu_01XeEJo91zX1zVTTDE8kgZQi","session_id":"428f3191-9775-460c-8316-8366502bc989","uuid":"7ec23c56-0841-4039-8895-85252e3d5949"}
