→    </div>\n   132→  )\n   133→}\n   134→"}]},"parent_tool_use_id":null,"session_id":"40a51b1f-3249-44ca-a03e-506c11f5118e","uuid":"bd8dc2ad-eaad-43ca-92bf-bafdb601dd47","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/components/AmenitiesList.tsx","content":"import { useState } from 'react'\nimport { Wifi, Car, Tv, Flame, Wind, Waves, ShieldCheck, MapPin, Coffee, Utensils, WashingMachine, Snowflake, Check } from 'lucide-react'\nimport type { Amenity } from '../slices/propertiesSlice'\n\ninterface AmenitiesListProps {\n  amenities: Amenity[]\n}\n\nconst INITIAL_SHOW = 10\n\n// Priority amenities shown first within their category\nconst PRIORITY_AMENITIES = ['wifi', 'kitchen', 'pool', 'air conditioning', 'heating', 'tv', 'smoke alarm', 'beachfront']\n\nconst iconMap: Record<string, React.ReactNode> = {\n  wifi: <Wifi size={20} />,\n  parking: <Car size={20} />,\n  tv: <Tv size={20} />,\n  heating: <Flame size={20} />,\n  'air conditioning': <Snowflake size={20} />,\n  pool: <Waves size={20} />,\n  'smoke detector': <ShieldCheck size={20} />,\n  'fire extinguisher': <ShieldCheck size={20} />,\n  'first aid kit': <ShieldCheck size={20} />,\n  'carbon monoxide detector': <ShieldCheck size={20} />,\n  'near beach': <MapPin size={20} />,\n  'near downtown': <MapPin size={20} />,\n  coffee: <Coffee size={20} />,\n  kitchen: <Utensils size={20} />,\n  washer: <WashingMachine size={20} />,\n  dryer: <Wind size={20} />,\n}\n\nfunction getIcon(amenity: Amenity) {\n  if (amenity.icon) {\n    const mapped = iconMap[amenity.icon.toLowerCase()]\n    if (mapped) return mapped\n  }\n  const mapped = iconMap[amenity.name.toLowerCase()]\n  if (mapped) return mapped\n  return <Check size={20} />\n}\n\nexport default function AmenitiesList({ amenities }: AmenitiesListProps) {\n  const [showAll, setShowAll] = useState(false)\n\n  if (amenities.length === 0) {\n    return (\n      <div data-testid=\"amenities-list\" className=\"py-6 border-b border-border\">\n        <h2 className=\"text-lg font-semibold text-text mb-3\">Amenities</h2>\n        <p className=\"text-text-secondary\">No amenities listed</p>\n      </div>\n    )\n  }\n\n  const categories = Array.from(new Set(amenities.map((a) => a.category)))\n  const grouped = categories.map((cat) => ({\n    category: cat,\n    items: amenities.filter((a) => a.category === cat).sort((a, b) => {\n      const aPri = PRIORITY_AMENITIES.indexOf(a.name.toLowerCase())\n      const bPri = PRIORITY_AMENITIES.indexOf(b.name.toLowerCase())\n      if (aPri !== -1 && bPri !== -1) return aPri - bPri\n      if (aPri !== -1) return -1\n      if (bPri !== -1) return 1\n      return a.name.localeCompare(b.name)\n    }),\n  }))\n\n  let displayAmenities: Amenity[]\n  if (showAll || amenities.length <= INITIAL_SHOW) {\n    displayAmenities = amenities\n  } else {\n    // Distribute slots proportionally across categories so all are represented\n    const selected = new Set<Amenity>()\n    // First pass: give each category a proportional share\n    let remaining = INITIAL_SHOW\n    for (const g of grouped) {\n      const share = Math.max(1, Math.round((g.items.length / amenities.length) * INITIAL_SHOW))\n      const take = Math.min(share, g.items.length, remaining)\n      for (let i = 0; i < take; i++) {\n        selected.add(g.items[i]!)\n      }\n      remaining = INITIAL_SHOW - selected.size\n    }\n    // Fill any remaining slots\n    for (const a of amenities) {\n      if (selected.size >= INITIAL_SHOW) break\n      selected.add(a)\n    }\n    displayAmenities = amenities.filter((a) => selected.has(a))\n  }\n  const displayCategories = (showAll ? grouped : grouped\n        .map((g) => ({\n          ...g,\n          items: g.items.filter((a) => displayAmenities.includes(a)),\n        }))\n        .filter((g) => g.items.length > 0))\n\n  return (\n    <div data-testid=\"amenities-list\" className=\"py-6 border-b border-border\">\n      <h2 className=\"text-lg font-semibold text-text mb-4\">Amenities</h2>\n      <div className=\"space-y-4\">\n        {displayCategories.map((group) => (\n          <div key={group.category}>\n            <h3 className=\"text-sm font-semibold text-text-secondary uppercase tracking-wide mb-2\">\n              {group.category}\n            </h3>\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2\">\n              {group.items.map((amenity) => (\n                <div\n                  key={amenity.id}\n                  data-testid={`amenity-${amenity.id}`}\n                  className=\"flex items-center gap-3 text-text-secondary py-1\"\n                >\n                  <span className=\"text-text-secondary\">{getIcon(amenity)}</span>\n                  <span>{amenity.name}</span>\n                </div>\n              ))}\n            </div>\n          </div>\n        ))}\n      </div>\n      {amenities.length > INITIAL_SHOW && (\n        <button\n          data-testid=\"amenities-toggle\"\n          className=\"mt-4 font-semibold text-text underline cursor-pointer\"\n          onClick={() => setShowAll(!showAll)}\n        >\n          {showAll ? 'Show less' : `Show all ${amenities.length} amenities`}\n        </button>\n      )}\n    </div>\n  )\n}\n","numLines":134,"startLine":1,"totalLines":134}}}
