 = page.getByTestId('booking-guests')\n   267→\n   268→    // First option should be \"1 guest\" (minimum)\n   269→    const options = guestsSelect.locator('option')\n   270→    await expect(options.first()).toHaveText('1 guest')\n   271→\n   272→    // Default value should be 1\n   273→    await expect(guestsSelect).toHaveValue('1')\n   274→  })\n   275→\n   276→  test('Reserve button shows error for unavailable dates', async ({ page }) => {\n   277→    test.slow()\n   278→    await loginAs(page, GUEST_EMAIL)\n   279→\n   280→    // b2222222 has a confirmed booking for 2026-04-01 to 2026-04-07 (by Alex)\n   281→    await page.goto('/properties/b2222222-2222-2222-2222-222222222222')\n   282→\n   283→    const card = page.getByTestId('booking-card')\n   284→    await expect(card).toBeVisible({ timeout: 30000 })\n   285→\n   286→    // Select overlapping dates\n   287→    await page.getByTestId('booking-checkin').fill('2026-04-02')\n   288→    await page.getByTestId('booking-checkout').fill('2026-04-06')\n   289→    await page.getByTestId('booking-guests').selectOption('2')\n   290→\n   291→    // Click Reserve\n   292→    const reserveBtn = page.getByTestId('reserve-button')\n   293→    await expect(reserveBtn).toBeEnabled()\n   294→    await reserveBtn.click()\n   295→\n   296→    // Should show error about unavailable dates\n   297→    const errorMsg = page.getByTestId('booking-error')\n   298→    await expect(errorMsg).toBeVisible({ timeout: 30000 })\n   299→    await expect(errorMsg).toContainText('not available')\n   300→  })\n   301→\n   302→  test('Booking card date pickers and guest selector are functional on repeated use', async ({ page }) => {\n   303→    // b1111111: $150/night, $75 cleaning fee, 4 max guests\n   304→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   305→\n   306→    const card = page.getByTestId('booking-card')\n   307→    await expect(card).toBeVisible({ timeout: 30000 })\n   308→\n   309→    const checkin = page.getByTestId('booking-checkin')\n   310→    const checkout = page.getByTestId('booking-checkout')\n   311→    const guestsSelect = page.getByTestId('booking-guests')\n   312→    const breakdown = page.getByTestId('price-breakdown')\n   313→\n   314→    // First selection: 2026-05-01 to 2026-05-04 (3 nights), 2 guests\n   315→    await checkin.fill('2026-05-01')\n   316→    await checkout.fill('2026-05-04')\n   317→    await guestsSelect.selectOption('2')\n   318→\n   319→    // $150 x 3 = $450 + $75 = $525\n   320→    await expect(breakdown).toContainText('$150 x 3 nights')\n   321→    await expect(breakdown).toContainText('$525')\n   322→\n   323→    // Change dates: 2026-06-01 to 2026-06-05 (4 nights)\n   324→    await checkin.fill('2026-06-01')\n   325→    await checkout.fill('2026-06-05')\n   326→\n   327→    // $150 x 4 = $600 + $75 = $675\n   328→    await expect(breakdown).toContainText('$150 x 4 nights')\n   329→    await expect(breakdown).toContainText('$675')\n   330→\n   331→    // Change guests: 2 -> 4 -> 2\n   332→    await guestsSelect.selectOption('4')\n   333→    await expect(guestsSelect).toHaveValue('4')\n   334→    await guestsSelect.selectOption('2')\n   335→    await expect(guestsSelect).toHaveValue('2')\n   336→\n   337→    // Price breakdown should still be correct after guest changes\n   338→    await expect(breakdown).toContainText('$150 x 4 nights')\n   339→    await expect(breakdown).toContainText('$675')\n   340→\n   341→    // Final state verification\n   342→    await expect(checkin).toHaveValue('2026-06-01')\n   343→    await expect(checkout).toHaveValue('2026-06-05')\n   344→    await expect(guestsSelect).toHaveValue('2')\n   345→  })\n   346→\n   347→  test('Booking card is sticky on desktop viewport', async ({ page }) => {\n   348→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   349→\n   350→    const card = page.getByTestId('booking-card')\n   351→    await expect(card).toBeVisible({ timeout: 30000 })\n   352→\n   353→    // Verify the card has