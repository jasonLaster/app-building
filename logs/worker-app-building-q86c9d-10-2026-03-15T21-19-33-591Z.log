toggleBtn = page.getByTestId('reviews-toggle')\n   257→    await toggleBtn.click()\n   258→\n   259→    // All 8 cards visible\n   260→    await expect(reviewCards).toHaveCount(8, { timeout: 10000 })\n   261→\n   262→    // Button changes to \"Show less\"\n   263→    await expect(toggleBtn).toHaveText('Show less')\n   264→  })\n   265→\n   266→  test('Reviews are ordered by most recent first', async ({ page }) => {\n   267→    test.slow()\n   268→\n   269→    // Create 2 reviews with different dates on b2222222 to verify ordering\n   270→    await page.goto(`/properties/${PROPERTY_NO_REVIEWS}`)\n   271→    await expect(page.getByTestId('reviews-section')).toBeVisible({ timeout: 30000 })\n   272→\n   273→    await deleteAllReviewsForProperty(page, PROPERTY_NO_REVIEWS)\n   274→    await deleteNonSeedBookingsForProperty(page, PROPERTY_NO_REVIEWS)\n   275→\n   276→    // Older review from Emma (January 2025)\n   277→    await createBookingAndReview(page, PROPERTY_NO_REVIEWS, GUEST_EMMA_ID, '2025-01-01', '2025-01-05', {\n   278→      rating: 3,\n   279→      cleanliness: 3,\n   280→      accuracy: 3,\n   281→      communication: 3,\n   282→      location: 3,\n   283→      value: 3,\n   284→      comment: 'Older review from Emma',\n   285→    })\n   286→\n   287→    // Small delay to ensure different created_at timestamps\n   288→    await page.waitForTimeout(1000)\n   289→\n   290→    // Newer review from Alex (February 2025)\n   291→    await createBookingAndReview(page, PROPERTY_NO_REVIEWS, GUEST_ALEX_ID, '2025-02-01', '2025-02-05', {\n   292→      rating: 5,\n   293→      cleanliness: 5,\n   294→      accuracy: 5,\n   295→      communication: 5,\n   296→      location: 5,\n   297→      value: 5,\n   298→      comment: 'Newer review from Alex',\n   299→    })\n   300→\n   301→    await page.reload()\n   302→    const section = page.getByTestId('reviews-section')\n   303→    await expect(section).toBeVisible({ timeout: 30000 })\n   304→\n   305→    const reviewCards = s