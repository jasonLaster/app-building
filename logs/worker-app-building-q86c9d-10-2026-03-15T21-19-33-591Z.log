on()\n    36→  for (const b of alexBookings) {\n    37→    if (b.property_id === propertyId && !seedIds.includes(b.id)) {\n    38→      await page.request.delete(`/api/bookings/${b.id}`)\n    39→    }\n    40→  }\n    41→}\n    42→\n    43→async function createBookingAndReview(\n    44→  page: import('@playwright/test').Page,\n    45→  propertyId: string,\n    46→  guestId: string,\n    47→  checkIn: string,\n    48→  checkOut: string,\n    49→  reviewData: { rating: number; cleanliness: number; accuracy: number; communication: number; location: number; value: number; comment: string }\n    50→) {\n    51→  const bookingRes = await page.request.post('/api/bookings', {\n    52→    data: {\n    53→      property_id: propertyId,\n    54→      guest_id: guestId,\n    55→      check_in: checkIn,\n    56→      check_out: checkOut,\n    57→      num_guests: 2,\n    58→      total_price: 500,\n    59→    },\n    60→  })\n    61→  const booking = await bookingRes.json()\n    62→\n    63→  await page.request.post('/api/reviews', {\n    64→    data: {\n    65→      booking_id: booking.id,\n    66→      property_id: propertyId,\n    67→      guest_id: guestId,\n    68→      ...reviewData,\n    69→    },\n    70→  })\n    71→}\n    72→\n    73→test.describe('Property Detail - ReviewsSection', () => {\n    74→  test('Reviews section displays average ratings by category', async ({ page }) => {\n    75→    // b1111111 has 1 seed review: cleanliness 5, accuracy 5, communication 5, location 5, value 4\n    76→    await page.goto(`/properties/${PROPERTY_WITH_REVIEW}`)\n    77→\n    78→    const section = page.getByTestId('reviews-section')\n    79→    await expect(section).toBeVisible({ timeout: 30000 })\n    80→\n    81→    const cleanliness = page.getByTestId('rating-category-cleanliness')\n    82→    await expect(cleanliness).toContainText('Cleanliness')\n    83→    await expect(cleanliness).toContainText('5.0')\n    84→\n    85→    const accuracy = page.getByTestId('rating-categor