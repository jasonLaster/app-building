→\n    65→export const fetchProjectDetail = createAsyncThunk(\n    66→  'projectDetail/fetchProjectDetail',\n    67→  async (projectId: string, { getState, rejectWithValue }) => {\n    68→    const state = getState() as { auth: { token: string | null } };\n    69→    const token = state.auth.token;\n    70→    if (!token) return rejectWithValue('No token');\n    71→    const response = await fetch(`/api/project-detail?projectId=${projectId}`, {\n    72→      headers: { Authorization: `Bearer ${token}` },\n    73→    });\n    74→    if (!response.ok) {\n    75→      return rejectWithValue('Failed to fetch project');\n    76→    }\n    77→    return await response.json();\n    78→  }\n    79→);\n    80→\n    81→export const updateProjectField = createAsyncThunk(\n    82→  'projectDetail/updateProjectField',\n    83→  async (\n    84→    payload: { projectId: string; field: string; value: string | null },\n    85→    { getState, rejectWithValue }\n    86→  ) => {\n    87→    const state = getState() as { auth: { token: string | null } };\n    88→    const token = state.auth.token;\n    89→    if (!token) return rejectWithValue('No token');\n    90→    const response = await fetch('/api/update-project', {\n    91→      method: 'PUT',\n    92→      headers: {\n    93→        'Content-Type': 'application/json',\n    94→        Authorization: `Bearer ${token}`,\n    95→      },\n    96→      body: JSON.stringify(payload),\n    97→    });\n    98→    if (!response.ok) {\n    99→      return rejectWithValue('Failed to update project');\n   100→    }\n   101→    return await response.json() as {\n   102→      project: ProjectDetail;\n   103→      activity: ProjectActivityEntry | null;\n   104→    };\n   105→  }\n   106→);\n   107→\n   108→export const createMilestone = createAsyncThunk(\n   109→  'projectDetail/createMilestone',\n   110→  async (\n   111→    payload: { projectId: string; name: string; targetDate: string | null },\n   112→    { getState, rejectWithValue }\n   113→  ) => {\n   114→    const state = getState() as { auth: { token: string | null } };\n   115→    const token = state.auth.token;\n   116→    if (!token) return rejectWithValue('No token');\n   117→    const response = await fetch('/api/project-milestones', {\n   118→      method: 'POST',\n   119→      headers: {\n   120→        'Content-Type': 'application/json',\n   121→        Authorization: `Bearer ${token}`,\n   122→      },\n   123→      body: JSON.stringify(payload),\n   124→    });\n   125→    if (!response.ok) {\n   126→      return rejectWithValue('Failed to create milestone');\n   127→    }\n   128→    return await response.json() as { milestone: ProjectMilestone };\n   129→  }\n   130→);\n   131→\n   132→export const updateMilestone = createAsyncThunk(\n   133→  'projectDetail/updateMilestone',\n   134→  async (\n   135→    payload: { milestoneId: string; projectId: string; name?: string; targetDate?: string | null; completed?: boolean },\n   136→    { getState, rejectWithValue }\n   137→  ) => {\n   138→    const state = getState() as { auth: { token: string | null } };\n   139→    const token = state.auth.token;\n   140→    if (!token) return rejectWithValue('No token');\n   141→    const response = await fetch('/api/project-milestones', {\n   142→      method: 'PUT',\n   143→      headers: {\n   144→        'Content-Type': 'application/json',\n   145→        Authorization: `Bearer ${token}`,\n   146→      },\n   147→      body: JSON.stringify(payload),\n   148→    });\n   149→    if (!response.ok) {\n   150→      return rejectWithValue('Failed to update milestone');"}]},"parent_tool_use_id":"toolu_019JuAqhnvU9KW4kFSamcC4c","session_id":"9d79f14e-e24f-460a-9e3f-21530b576549","uuid":"0cb2ae3d-2a05-4015-925f-4e03b044d54a"}
