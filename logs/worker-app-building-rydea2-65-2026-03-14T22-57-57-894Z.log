[2026-03-14T22:57:18.229Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Bc8z6p4SKQm2qz7ejYqUDY","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions';\n     2→import { getSql } from './db';\n     3→\n     4→export default async function handler(req: Request, _context: Context) {\n     5→  if (req.method !== 'GET') {\n     6→    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n     7→      status: 405,\n     8→      headers: { 'Content-Type': 'application/json' },\n     9→    });\n    10→  }\n    11→\n    12→  try {\n    13→    const authHeader = req.headers.get('Authorization');\n    14→    if (!authHeader?.startsWith('Bearer ')) {\n    15→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    16→        status: 401,\n    17→        headers: { 'Content-Type': 'application/json' },\n    18→      });\n    19→    }\n    20→\n    21→    const token = authHeader.slice(7);\n    22→    const sql = getSql();\n    23→\n    24→    const sessions = await sql`\n    25→      SELECT s.member_id FROM sessions s\n    26→      WHERE s.token = ${token} AND s.expires_at > NOW()\n    27→    `;\n    28→    const session = sessions[0];\n    29→    if (!session) {\n    30→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    31→        status: 401,\n    32→        headers: { 'Content-Type': 'application/json' },\n    33→      });\n    34→    }\n    35→\n    36→    const url = new URL(req.url);\n    37→    const projectId = url.searchParams.get('projectId');\n    38→    if (!projectId) {\n    39→      return new Response(JSON.stringify({ error: 'projectId is required' }), {\n    40→        status: 400,\n    41→        headers: { 'Content-Type': 'application/json' },\n    42→      });\n    43→    }\n    44→\n    45→    // Fetch project with lead info and issue counts\n    46→    const projectRows = await sql`\n    47→      SELECT\n    48→        p.id, p.name, p.description, p.status, p.target_date, p.lead_id,\n    49→        m.name AS lead_name, m.email AS lead_email,\n    50→        COUNT(i.id)::int AS total_issues,\n    51→        COUNT(CASE WHEN i.status = 'done' THEN 1 END)::int AS completed_issues,\n    52→        COUNT(CASE WHEN i.status = 'in_progress' THEN 1 END)::int AS in_progress_issues\n    53→      FROM projects p\n    54→      LEFT JOIN members m ON m.id = p.lead_id\n    55→      LEFT JOIN issues i ON i.project_id = p.id\n    56→      WHERE p.id = ${projectId}\n    57→      GROUP BY p.id, p.name, p.description, p.status, p.target_date, p.lead_id, m.name, m.email\n    58→    `;\n    59→    const project = projectRows[0];\n    60→    if (!project) {\n    61→      return new Response(JSON.stringify({ error: 'Project not found' }), {\n    62→        status: 404,\n    63→        headers: { 'Content-Type': 'application/json' },\n    64→      });\n    65→    }\n    66→\n    67→    // Fetch project issues with full details, grouped by team\n    68→    const issues = await sql`\n    69→      SELECT\n    70→        i.id, i.title, i.description, i.status, i.priority, i.number,\n    71→        i.due_date, i.created_at, i.updated_at, i.team_id, i.assignee_id,\n    72→        i.project_id, i.cycle_id, i.parent_id,\n    73→        t.identifier AS team_identifier, t.name AS team_name, t.id AS tid,\n    74→        ma.name AS assignee_name, ma.email AS assignee_email,\n    75→        p2.name AS project_name\n    76→      FROM issues i\n    77→      JOIN teams t ON t.id = i.team_id\n    78→      LEFT JOIN members ma ON ma.id = i.assignee_id\n    79→      LEFT JOIN projects p2 ON p2.id = i.project_id\n    80→      WHERE i.project_id = ${projectId}\n    81→      ORDER BY t.name ASC, i.created_at DESC\n    82→    `;\n    83→\n    84→    // Fetch labels for all project issues\n    85→    const issueIds = issues.map((i) => String(i.id));\n    86→    const issueLabelsMap = new Map<string, Array<{ id: string; name: string; color: string }>>();\n    87→    if (issueIds.length > 0) {\n    88→      const allLabels = await sql`\n    89→        SELECT il.issue_id, l.id, l.name, l.color\n    90→        FROM issue_labels il\n    91→        JOIN labels l ON l.id = il.label_id\n    92→        WHERE il.issue_id = ANY(${issueIds})\n    93→      `;\n    94→      for (const row of allLabels) {\n    95→        const iid = String(row.issue_id);\n    96→        if (!issueLabelsMap.has(iid)) {\n    97→          issueLabelsMap.set(iid, []);\n    98→        }\n    99→        issueLabelsMap.get(iid)!.push({\n   100→          id: String(row.id),\n   101→          name: String(row.name),\n   102→          color: String(row.color),\n   103→        });\n   104→      }\n   105→    }\n   106→\n   107→    const enrichedIssues = issues.map((i) => ({\n   108→      id: String(i.id),\n   109→      title: String(i.title),\n   110→      description: i.description ? String(i.description) : '',\n   111→      status: String(i.status),\n   112→      priority: String(i.priority),\n   113→      identifier: `${i.team_identifier}-${i.number}`,\n   114→      number: i.number,\n   115→      dueDate: i.due_date ? String(i.due_date).split('T')[0] : null,\n   116→      createdAt: String(i.created_at),\n   117→      updatedAt: String(i.updated_at),\n   118→      teamId: String(i.team_id),\n   119→      teamName: String(i.team_name),\n   120→      assigneeId: i.assignee_id ? String(i.assignee_id) : null,\n   121→      assigneeName: i.assignee_name ? String(i.assignee_name) : null,\n   122→      assigneeEmail: i.assignee_email ? String(i.assignee_email) : null,\n   123→      projectId: i.project_id ? String(i.project_id) : null,\n   124→      projectName: i.project_name ? String(i.project_name) : null,\n   125→      cycleId: i.cycle_id ? String(i.cycle_id) : null,\n   126→      parentId: i.parent_id ? String(i.parent_id) : null,\n   127→      labels: issueLabelsMap.get(String(i.id)) || [],\n   128→    }));\n   129→\n   130→    // Fetch milestones\n   131→    const milestones = await sql`\n   132→      SELECT id, name, target_date, completed, created_at\n   133→      FROM project_milestones\n   134→      WHERE project_id = ${projectId}\n   135→      ORDER BY target_date ASC NULLS LAST, created_at ASC\n   136→    `;\n   137→\n   138→    // Fetch all members for lead selector\n   139→    const allMembers = await sql`\n   140→      SELECT id, name, email FROM members ORDER BY name ASC\n   141→    `;\n   142→\n   143→    // Fetch all labels\n   144→    const labels = await sql`\n   145→      SELECT id, name, color FROM labels ORDER BY name ASC\n   146→    `;\n   147→\n   148→    // Fetch project activity\n   149→    const activity = await sql`\n   150→      SELECT pa.id, pa.action, pa.created_at, pa.member_id, m2.name AS member_name, m2.email AS member_email\n   151→      FROM project_activity pa\n   152→      LEFT JOIN members m2 ON m2.id = pa.member_id\n   153→      WHERE pa.project_id = ${projectId}\n   154→      ORDER BY pa.created_at DESC\n   155→      LIMIT 50\n   156→    `;\n   157→\n   158→    return new Response(JSON.stringify({\n   159→      project: {\n   160→        id: String(project.id),\n   161→        name: String(project.name),\n   162→        description: project.description ? String(project.description) : null,\n   163→        status: String(project.status),\n   164→        targetDate: project.target_date ? String(project.target_date).split('T')[0] : null,\n   165→        leadId: project.lead_id ? String(project.lead_id) : null,\n   166→        leadName: project.lead_name ? String(project.lead_name) : null,\n   167→        leadEmail: project.lead_email ? String(project.lead_email) : null,\n   168→        totalIssues: project.total_issues,\n   169→        completedIssues: project.completed_issues,\n   170→        inProgressIssues: project.in_progress_issues,\n   171→      },\n   172→      issues: enrichedIssues,\n   173→      milestones: milestones.map((ms) => ({\n   174→        id: String(ms.id),\n   175→        name: String(ms.name),\n   176→        targetDate: ms.target_date ? String(ms.target_date).split('T')[0] : null,\n   177→        completed: Boolean(ms.completed),\n   178→      })),\n   179→      members: allMembers.map((m) => ({\n   180→        id: String(m.id),\n   181→        name: String(m.name),\n   182→        email: String(m.email),\n   183→      })),\n   184→      labels: labels.map((l) => ({\n   185→        id: String(l.id),\n   186→        name: String(l.name),\n   187→        color: String(l.color),\n   188→      })),\n   189→      activity: activity.map((a) => ({\n   190→        id: String(a.id),\n   191→        action: String(a.action),\n   192→        createdAt: String(a.created_at),\n   193→        memberId: String(a.member_id),\n   194→        memberName: a.member_name ? String(a.member_name) : null,\n   195→        memberEmail: a.member_email ? String(a.member_email) : null,\n   196→      })),\n   197→    }), {\n   198→      status: 200,\n   199→      headers: { 'Content-Type': 'application/json' },\n   200→    });\n   201→  } catch (err) {\n   202→    console.error('Project detail error:', err);\n   203→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n   204→      status: 500,\n   205→      headers: { 'Content-Type': 'application/json' },\n   206→    });\n   207→  }\n   208→}\n   209→"}]},"parent_tool_use_id":"toolu_01GXHbC41TibDdS7R2SwdSxQ","session_id":"9d79f14e-e24f-460a-9e3f-21530b576549","uuid":"0370cc22-489c-4f59-b21e-644ef89bebfe"}
