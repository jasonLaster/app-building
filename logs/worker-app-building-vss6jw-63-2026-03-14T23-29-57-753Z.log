\n    58→interface AddressSuggestion {\n    59→  display_name: string\n    60→  address?: {\n    61→    road?: string\n    62→    house_number?: string\n    63→    city?: string\n    64→    town?: string\n    65→    village?: string\n    66→    state?: string\n    67→    country?: string\n    68→  }\n    69→  lat: string\n    70→  lon: string\n    71→}\n    72→\n    73→export default function AddListingForm({ hostId, onClose, onSuccess }: AddListingFormProps) {\n    74→  const dispatch = useDispatch<AppDispatch>()\n    75→  const amenities = useSelector((state: RootState) => state.amenities.items)\n    76→  const [step, setStep] = useState(1)\n    77→  const [formData, setFormData] = useState<FormData>(initialFormData)\n    78→  const [errors, setErrors] = useState<Record<string, string>>({})\n    79→  const [showDiscardDialog, setShowDiscardDialog] = useState(false)\n    80→  const [publishing, setPublishing] = useState(false)\n    81→  const [photoUrl, setPhotoUrl] = useState('')\n    82→  const [addressSuggestions, setAddressSuggestions] = useState<AddressSuggestion[]>([])\n    83→  const [showSuggestions, setShowSuggestions] = useState(false)\n    84→  const [propertyTypeOpen, setPropertyTypeOpen] = useState(false)\n    85→  const propertyTypeRef = useRef<HTMLDivElement>(null)\n    86→  const debounceRef = useRef<ReturnType<typeof setTimeout> | null>(null)\n    87→\n    88→  useEffect(() => {\n    89→    if (amenities.length === 0) {\n    90→      dispatch(fetchAmenities())\n    91→    }\n    92→  }, [dispatch, amenities.length])\n    93→\n    94→  useEffect(() => {\n    95→    if (!propertyTypeOpen) return\n    96→    const handleClickOutside = (e: MouseEvent) => {\n    97→      if (propertyTypeRef.current && !propertyTypeRef.current.contains(e.target as Node)) {\n    98→        setPropertyTypeOpen(false)\n    99→      }\n   100→    }\n   101→    document.addEventListener('mousedown', handleClickOutside)\n   102→    return () => document.removeEventListener('mousedown', handleClickOutside)\n   103→  }, [propertyTypeOpen])\n   104→\n   105→  const fetchAddressSuggestions = useCallback(async (query: string) => {\n   106→    if (query.length < 3) {\n   107→      setAddressSuggestions([])\n   108→      return\n   109→    }\n   110→    try {\n   111→      const response = await fetch(\n   112→        `https://nominatim.openstreetmap.org/search?format=json&addressdetails=1&q=${encodeURIComponent(query)}&limit=5`\n   113→      )\n   114→      const data = await response.json() as AddressSuggestion[]\n   115→      setAddressSuggestions(data)\n   116→      setShowSuggestions(true)\n   117→    } catch {\n   118→      setAddressSuggestions([])\n   119→    }\n   120→  }, [])\n   121→\n   122→  const handleAddressChange = (value: string) => {\n   123→    setFormData((prev) => ({ ...prev, address: value }))\n   124→    if (debounceRef.current) clearTimeout(debounceRef.current)\n   125→    debounceRef.current = setTimeout(() => {\n   126→      fetchAddressSuggestions(value)\n   127→    }, 300)\n   128→  }\n   129→\n   130→  const handleSelectSuggestion = (suggestion: AddressSuggestion) => {\n   131→    const addr = suggestion.address\n   132→    const road = addr?.house_number ? `${addr.house_number} ${addr.road || ''}` : (addr?.road || '')\n   133→    setFormData((prev) => ({\n   134→      ...prev,\n   135→      address: road || suggestion.display_name,\n   136→      city: addr?.city || addr?.town || addr?.village || '',\n   137→      state: addr?.state || '',\n   138→      country: addr?.country || '',\n   139→      latitude: parseFloat(suggestion.lat),\n   140→      longitude: parseFloat(suggestion.lon),\n   141→    }))\n   142→    setShowSuggestions(false)\n   143→    setAddressSuggestions([])\n   144→  }\n   145→\n   146→  const validateStep = (): boolean => {\n   147→    const newErrors: Record<string, string> = {}\n   148→\n   149→    if (step === 1) {\n   150→      if (!formData.propertyType) newErrors.propertyType = 'Property type is required'\n   151→      if (!formData.title.trim()) newErrors.title = 'Title is required'\n   152→    } else if (step === 2) {\n   153→      if (!formData.city.trim()) newErrors.city = 'City is required'\n   154→      if (!formData.country.trim()) newErrors.country = 'Country is required'\n   155→    } else if (step === 3) {\n   156→      if (formData.maxGuests < 1) newErrors.maxGuests = 'Max guests must be at least 1'\n   157→      if (formData.bedrooms < 1) newErrors.bedrooms = 'At least 1 bedroom is required'\n   158→      if (formData.beds < 1) newErrors.beds = 'At least 1 bed is required'\n   159→      if (formData.bathrooms < 1) newErrors.bathrooms = 'At least 1 bathroom is required'\n   160→    } else if (step === 5) {\n   161→      if (formData.photos.length === 0) newErrors.photos = 'At least one photo is required'\n   162→    } else if (step === 6) {\n   163→      const price = parseFloat(formData.pricePerNight)\n   164→      if (!price || price <= 0) newErrors.pricePerNight = 'Price per night is required and must be greater than 0'\n   165→    }\n   166→\n   167→    setErrors(newErrors)\n   168→    return Object.keys(newErrors).length === 0\n   169→  }\n   170→\n   171→  const handleNext = () => {\n   172→    if (validateStep()) {\n   173→      setStep((s) => Math.min(s + 1, TOTAL_STEPS))\n   174→    }\n   175→  }\n   176→\n   177→  const handleBack = () => {\n   178→    setErrors({})\n   179→    setStep((s) => Math.max(s - 1, 1))\n   180→  }\n   181→\n   182→  const handleAddPhoto = () => {\n   183→    if (!photoUrl.trim()) return\n   184→    setFormData((prev) => ({\n   185→      ...prev,\n   186→      photos: [...prev.photos, { url: photoUrl.trim(), caption: '' }],\n   187→    }))\n   188→    setPhotoUrl('')\n   189→    setErrors((prev) => {\n   190→      const next = { ...prev }\n   191→      delete next.photos\n   192→      return next\n   193→    })\n   194→  }\n   195→\n   196→  const handleRemovePhoto = (index: number) => {\n   197→    setFormData((prev) => ({\n   198→      ...prev,\n   199→      photos: prev.photos.filter((_, i) => i !== index),\n   200→    }))\n   201→  }\n   202→\n   203→  const toggleAmenity = (amenityId: string) => {\n   204→    setFormData((prev) => ({\n   205→      ...prev,\n   206→      selectedAmenities: prev.selectedAmenities.includes(amenityId)\n   207→        ? prev.selectedAmenities.filter((id) => id !== amenityId)\n   208→        : [...prev.selectedAmenities, amenityId],\n   209→    }))\n   210→  }\n   211→\n   212→  const handlePublish = async () => {\n   213→    setPublishing(true)\n   214→    try {\n   215→      const result = await dispatch(createProperty({\n   216→        host_id: hostId,\n   217→        title: formData.title,\n   218→        description: formData.description,\n   219→        property_type: formData.propertyType,\n   220→        price_per_night: parseFloat(formData.pricePerNight),\n   221→        cleaning_fee: parseFloat(formData.cleaningFee) || 0,\n   222→        max_guests: formData.maxGuests,\n   223→        bedrooms: formData.bedrooms,\n   224→        beds: formData.beds,\n   225→        bathrooms: formData.bathrooms,\n   226→        address: formData.address,\n   227→        city: formData.city,\n   228→        state: formData.state || null,\n   229→        country: formData.country,\n   230→        latitude: formData.latitude,\n   231→        longitude: formData.longitude,\n   232→        amenity_ids: formData.selectedAmenities,\n   233→      })).unwrap()\n   234→\n   235→      const propertyId = result.id\n   236→\n   237→      for (let i = 0; i < formData.photos.length; i++) {\n   238→        const photo = formData.photos[i]\n   239→        if (photo) {\n   240→          await fetch('/api/property-images', {\n   241→            method: 'POST',\n   242→            headers: { 'Content-Type': 'application/json' },\n   243→            body: JSON.stringify({\n   244→              property_id: propertyId,\n   245→              url: photo.url,\n   246→              caption: photo.caption,\n   247→              display_order: i,\n   248→            }),\n   249→          })\n   250→        }\n   251→      }\n   252→\n   253→      onSuccess()\n   254→    } catch {\n   255→      setErrors({ publish: 'Failed to publish listing. Please try again.' })\n   256→    } finally {\n   257→      setPublishing(false)\n   258→    }\n   259→  }\n   260→\n   261→  const handleCancel = () => {\n   262→    setShowDiscardDialog(true)\n   263→  }\n   264→\n   265→  const incrementField = (field: 'maxGuests' | 'bedrooms' | 'beds' | 'bathrooms') => {\n   266→    setFormData((prev) => ({ ...prev, [field]: prev[field] + 1 }))\n   267→  }\n   268→\n   269→  const decrementField = (field: 'maxGuests' | 'bedrooms' | 'beds' | 'bathrooms') => {\n   270→    setFormData((prev) => ({ ...prev, [field]: Math.max(0, prev[field] - 1) }))\n   271→  }\n   272→\n   273→  const amenitiesByCategory = amenities.reduce<Record<string, Amenity[]>>((acc, amenity) => {\n   274→    const cat = amenity.category || 'Other'\n   275→    if (!acc[cat]) acc[cat] = []\n   276→    acc[cat].push(amenity)\n   277→    return acc\n   278→  }, {})\n   279→\n   280→  const renderStepIndicator = () => (\n   281→    <div data-testid=\"step-indicator\" className=\"flex items-center justify-center gap-2 mb-6\">\n   282→      {Array.from({ length: TOTAL_STEPS }, (_, i) => i + 1).map((s) => (\n   283→        <div\n   284→          key={s}\n   285→          className={`w-8 h-8 rounded-full flex items-center justify-center text-xs font-medium transition-colors ${\n   286→            s < step\n   287→              ? 'bg-primary text-white'\n   288→              : s === step\n   289→                ? 'bg-primary text-white'\n   290→                : 'bg-bg-secondary text-text-secondary'\n   291→          }`}\n   292→        >\n   293→          {s < step ? <Check size={14} /> : s}\n   294→        </div>\n   295→      ))}\n   296→      <span className=\"ml-2 text-sm text-text-secondary\">Step {step} of {TOTAL_STEPS}</span>\n   297→    </div>\n   298→  )\n   299→\n   300→  const renderStep1 = () => (\n   301→    <div data-testid=\"add-listing-step-1\">\n   302→      <h3 className=\"text-lg font-semibold text-text mb-4\">Property Type & Title</h3>\n   303→\n   304→      <div className=\"mb-4\">\n   305→        <label className=\"block text-sm font-medium text-text mb-1.5\">Property Type *</label>\n   306→        <div className=\"relative\" ref={propertyTypeRef}>\n   307→          <button\n   308→            type=\"button\"\n   309→            data-testid=\"property-type-select\"\n   310→            onClick={() => setPropertyTypeOpen(!propertyTypeOpen)}\n   311→            className={`w-full text-left px-4 py-3 rounded-lg border ${\n   312→              errors.propertyType ? 'border-error' : 'border-border'\n   313→            } bg-white text-sm focus:outline-none focus:border-primary`}\n   314→          >\n   315→            {formData.propertyType || 'Select property type...'}\n   316→          </button>\n   317→          {propertyTypeOpen && (\n   318→            <div className=\"absolute top-full left-0 right-0 mt-1 bg-white border border-border rounded-lg shadow-lg z-10 max-h-60 overflow-y-auto\">\n   319→              {PROPERTY_TYPES.map((type) => (\n   320→                <button\n   321→                  key={type}\n   322→                  type=\"button\"\n   323→                  data-testid={`property-type-option-${type.toLowerCase()}`}\n   324→                  onClick={() => {\n   325→                    setFormData((prev) => ({ ...prev, propertyType: type }))\n   326→                    setPropertyTypeOpen(false)\n   327→                    setErrors((prev) => {\n   328→                      const next = { ...prev }\n   329→                      delete next.propertyType\n   330→                      return next\n   331→                    })\n   332→                  }}\n   333→                  className={`w-full text-left px-4 py-2.