[2026-03-14T23:24:11.800Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VBVxkTH4bVqopXn24GkhJn","type":"tool_result","content":"     1→import { useState } from 'react'\n     2→import { useNavigate } from 'react-router-dom'\n     3→import { Star, Edit, Power, Plus, Loader2, MapPin } from 'lucide-react'\n     4→import type { Property } from '../slices/propertiesSlice'\n     5→\n     6→interface ListingsTabProps {\n     7→  listings: Property[]\n     8→  loading: boolean\n     9→  onDeactivate: (property: Property) => Promise<void>\n    10→  onActivate: (property: Property) => Promise<void>\n    11→  onAddListing: () => void\n    12→}\n    13→\n    14→export default function ListingsTab({ listings, loading, onDeactivate, onActivate, onAddListing }: ListingsTabProps) {\n    15→  const navigate = useNavigate()\n    16→  const [confirmDialog, setConfirmDialog] = useState<Property | null>(null)\n    17→  const [actionLoading, setActionLoading] = useState<string | null>(null)\n    18→\n    19→  const handleDeactivateClick = (property: Property) => {\n    20→    setConfirmDialog(property)\n    21→  }\n    22→\n    23→  const handleConfirmDeactivate = async () => {\n    24→    if (!confirmDialog) return\n    25→    setActionLoading(confirmDialog.id)\n    26→    await onDeactivate(confirmDialog)\n    27→    setActionLoading(null)\n    28→    setConfirmDialog(null)\n    29→  }\n    30→\n    31→  const handleActivate = async (property: Property) => {\n    32→    setActionLoading(property.id)\n    33→    await onActivate(property)\n    34→    setActionLoading(null)\n    35→  }\n    36→\n    37→  if (loading) {\n    38→    return (\n    39→      <div className=\"flex items-center justify-center py-16\">\n    40→        <Loader2 size={32} className=\"animate-spin text-primary\" />\n    41→      </div>\n    42→    )\n    43→  }\n    44→\n    45→  return (\n    46→    <div data-testid=\"listings-tab\">\n    47→      <div className=\"flex items-center justify-between mb-6\">\n    48→        <h2 className=\"text-lg font-semibold text-text\">Your Listings</h2>\n    49→        <button\n    50→          data-testid=\"add-listing-button\"\n    51→          onClick={onAddListing}\n    52→          className=\"flex items-center gap-2 bg-primary text-white px-4 py-2.5 rounded-lg font-medium hover:bg-primary-dark transition-colors\"\n    53→        >\n    54→          <Plus size={18} />\n    55→          Add Listing\n    56→        </button>\n    57→      </div>\n    58→\n    59→      {listings.length === 0 ? (\n    60→        <div data-testid=\"listings-empty-state\" className=\"text-center py-16\">\n    61→          <Home size={48} className=\"mx-auto text-text-secondary mb-4 opacity-50\" />\n    62→          <p className=\"text-text-secondary text-lg mb-4\">You don&apos;t have any listings yet</p>\n    63→          <button\n    64→            onClick={onAddListing}\n    65→            className=\"bg-primary text-white px-6 py-3 rounded-lg font-medium hover:bg-primary-dark transition-colors\"\n    66→          >\n    67→            Add Your First Listing\n    68→          </button>\n    69→        </div>\n    70→      ) : (\n    71→        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6\">\n    72→          {listings.map((property) => {\n    73→            const rating = Number(property.avg_rating) || 0\n    74→            const reviewCount = property.review_count || 0\n    75→            const isLoading = actionLoading === property.id\n    76→\n    77→            return (\n    78→              <div\n    79→                key={property.id}\n    80→                data-testid={`listing-card-${property.id}`}\n    81→                className=\"bg-white rounded-xl border border-border overflow-visible\"\n    82→              >\n    83→                <div className=\"relative aspect-[4/3] overflow-hidden rounded-t-xl\">\n    84→                  {property.main_image ? (\n    85→                    <img\n    86→                      src={property.main_image}\n    87→                      alt={property.title}\n    88→                      className=\"w-full h-full object-cover\"\n    89→                    />\n    90→                  ) : (\n    91→                    <div className=\"w-full h-full bg-bg-secondary flex items-center justify-center text-text-secondary text-sm\">\n    92→                      No image\n    93→                    </div>\n    94→                  )}\n    95→                  <span\n    96→                    data-testid={`listing-status-${property.id}`}\n    97→                    className={`absolute top-3 left-3 text-xs font-semibold px-2.5 py-1 rounded-full ${\n    98→                      property.is_active\n    99→                        ? 'bg-status-confirmed/20 text-status-confirmed'\n   100→                        : 'bg-border text-text-secondary'\n   101→                    }`}\n   102→                  >\n   103→                    {property.is_active ? 'Active' : 'Inactive'}\n   104→                  </span>\n   105→                </div>\n   106→\n   107→                <div className=\"p-4\">\n   108→                  <h3 className=\"font-semibold text-text truncate\">{property.title}</h3>\n   109→                  <div className=\"flex items-center gap-1 text-sm text-text-secondary mt-1\">\n   110→                    <MapPin size={14} />\n   111→                    <span>{property.city}</span>\n   112→                  </div>\n   113→                  <div className=\"flex items-center justify-between mt-2\">\n   114→                    <p className=\"text-sm\">\n   115→                      <span className=\"font-semibold text-text\">${Number(property.price_per_night).toFixed(0)}</span>\n   116→                      <span className=\"text-text-secondary\"> / night</span>\n   117→                    </p>\n   118→                    {reviewCount > 0 ? (\n   119→                      <div className=\"flex items-center gap-1\">\n   120→                        <Star size={14} className=\"fill-text text-text\" />\n   121→                        <span className=\"text-sm font-medium\">{rating.toFixed(1)}</span>\n   122→                        <span className=\"text-sm text-text-secondary\">({reviewCount} reviews)</span>\n   123→                      </div>\n   124→                    ) : (\n   125→                      <span className=\"text-sm text-text-secondary\">No reviews</span>\n   126→                    )}\n   127→                  </div>\n   128→\n   129→                  <div className=\"flex gap-2 mt-4\">\n   130→                    <button\n   131→                      data-testid={`listing-edit-${property.id}`}\n   132→                      onClick={() => navigate(`/properties/${property.id}`)}\n   133→                      className=\"flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-text bg-bg-secondary rounded-lg hover:bg-border transition-colors\"\n   134→                    >\n   135→                      <Edit size={14} />\n   136→                      Edit\n   137→                    </button>\n   138→                    {property.is_active ? (\n   139→                      <button\n   140→                        data-testid={`listing-deactivate-${property.id}`}\n   141→                        onClick={() => handleDeactivateClick(property)}\n   142→                        disabled={isLoading}\n   143→                        className=\"flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-status-cancelled bg-status-cancelled/10 rounded-lg hover:bg-status-cancelled/20 transition-colors disabled:opacity-50\"\n   144→                      >\n   145→                        <Power size={14} />\n   146→                        {isLoading ? 'Deactivating...' : 'Deactivate'}\n   147→                      </button>\n   148→                    ) : (\n   149→                      <button\n   150→                        data-testid={`listing-activate-${property.id}`}\n   151→                        onClick={() => handleActivate(property)}\n   152→                        disabled={isLoading}\n   153→                        className=\"flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-status-confirmed bg-status-confirmed/10 rounded-lg hover:bg-status-confirmed/20 transition-colors disabled:opacity-50\"\n   154→                      >\n   155→                        <Power size={14} />\n   156→                        {isLoading ? 'Activating...' : 'Activate'}\n   157→                      </button>\n   158→                    )}\n   159→                  </div>\n   160→                </div>\n   161→              </div>\n   162→            )\n   163→          })}\n   164→        </div>\n   165→      )}\n   166→\n   167→      {confirmDialog && (\n   168→        <div\n   169→          data-testid=\"deactivate-dialog\"\n   170→          className=\"fixed inset-0 bg-black/50 flex items-center justify-center z-50\"\n   171→          onClick={() => setConfirmDialog(null)}\n   172→        >\n   173→          <div\n   174→            className=\"bg-white rounded-xl p-6 max-w-md w-full mx-4 shadow-lg\"\n   175→            onClick={(e) => e.stopPropagation()}\n   176→          >\n   177→            <h3 className=\"text-lg font-semibold text-text mb-2\">Deactivate Listing</h3>\n   178→            <p className=\"text-text-secondary mb-6\">\n   179→              Are you sure you want to deactivate this listing? <strong>&quot;{confirmDialog.title}&quot;</strong> will\n   180→              no longer be visible to guests.\n   181→            </p>\n   182→            <div className=\"flex gap-3 justify-end\">\n   183→              <button\n   184→                data-testid=\"deactivate-dialog-cancel\"\n   185→                onClick={() => setConfirmDialog(null)}\n   186→                className=\"px-4 py-2 text-sm font-medium text-text bg-bg-secondary rounded-lg hover:bg-border transition-colors\"\n   187→              >\n   188→                Cancel\n   189→              </button>\n   190→              <button\n   191→                data-testid=\"deactivate-dialog-confirm\"\n   192→                onClick={handleConfirmDeactivate}\n   193→                disabled={actionLoading === confirmDialog.id}\n   194→                className=\"px-4 py-2 text-sm font-medium text-white bg-status-cancelled rounded-lg hover:opacity-90 transition-opacity disabled:opacity-50\"\n   195→              >\n   196→                {actionLoading === confirmDialog.id ? 'Deactivating...' : 'Yes, Deactivate'}\n   197→              </button>\n   198→            </div>\n   199→          </div>\n   200→        </div>\n   201→      )}\n   202→    </div>\n   203→  )\n   204→}\n   205→\n   206→function Home(props: { size: number; className: string }) {\n   207→  return (\n   208→    <svg\n   209→      xmlns=\"http://www.w3.org/2000/svg\"\n   210→      width={props.size}\n   211→      height={props.size}\n   212→      viewBox=\"0 0 24 24\"\n   213→      fill=\"none\"\n   214→      stroke=\"currentColor\"\n   215→      strokeWidth=\"2\"\n   216→      strokeLinecap=\"round\"\n   217→      strokeLinejoin=\"round\"\n   218→      className={props.className}\n   219→    >\n   220→      <path d=\"m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\" />\n   221→      <polyline points=\"9 22 9 12 15 12 15 22\" />\n   222→    </svg>\n   223→  )\n   224→}\n   225→"}]},"parent_tool_use_id":"toolu_01QCiTUc6Sm9cvzrHgK9iQmG","session_id":"e29039f7-9bfa-4d98-aa1e-c59811d98508","uuid":"22eb7e80-7faa-4c9c-8ad9-799363c5bcee"}
