   44→\n    45→  const handleDeactivate = useCallback(async (property: Property) => {\n    46→    await dispatch(deactivateProperty(property.id))\n    47→  }, [dispatch])\n    48→\n    49→  const handleActivate = useCallback(async (property: Property) => {\n    50→    await dispatch(activateProperty(property.id))\n    51→  }, [dispatch])\n    52→\n    53→  const handleConfirmBooking = useCallback(async (bookingId: string) => {\n    54→    await dispatch(updateHostBookingStatus({ bookingId, status: 'confirmed' }))\n    55→    if (currentUser) {\n    56→      dispatch(fetchHostStats(currentUser.id))\n    57→    }\n    58→  }, [dispatch, currentUser])\n    59→\n    60→  const handleCancelBooking = useCallback(async (bookingId: string) => {\n    61→    await dispatch(updateHostBookingStatus({ bookingId, status: 'cancelled' }))\n    62→    if (currentUser) {\n    63→      dispatch(fetchHostStats(currentUser.id))\n    64→    }\n    65→  }, [dispatch, currentUser])\n    66→\n    67→  const handleAddListingSuccess = useCallback(() => {\n    68→    setShowAddForm(false)\n    69→    if (currentUser) {\n    70→      dispatch(fetchHostStats(currentUser.id))\n    71→      dispatch(fetchHostListings(currentUser.id))\n    72→    }\n    73→  }, [dispatch, currentUser])\n    74→\n    75→  if (!currentUser) {\n    76→    return null\n    77→  }\n    78→\n    79→  if (!currentUser.is_host) {\n    80→    return (\n    81→<<<<<<< HEAD\n    82→      <main data-testid=\"host-dashboard\" className=\"p-6 max-sm:p-3\">\n    83→=======\n    84→      <div data-testid=\"host-dashboard\" className=\"max-w-[1120px] mx-auto px-6 max-sm:px-3 py-8\">\n    85→>>>>>>> origin/feature/airbnb-clone\n    86→        <div className=\"max-w-lg mx-auto text-center py-16\">\n    87→          <h1 className=\"text-[32px] font-bold text-text mb-4\">Become a Host</h1>\n    88→          <p className=\"text-text-secondary mb-6 text-lg\">\n    89→            You need to become a host to access this page. Visit your p