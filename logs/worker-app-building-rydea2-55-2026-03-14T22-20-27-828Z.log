[2026-03-14T22:14:50.167Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015jby8yXmT25oRgqjNpBmtn","type":"tool_result","content":"     1→import { useState, useRef, useEffect } from 'react';\n     2→import { useDispatch } from 'react-redux';\n     3→import type { AppDispatch } from '../store';\n     4→import type { Issue, IssueLabel } from '../slices/issuesSlice';\n     5→import type { TeamMember, TeamProject, TeamCycle } from '../slices/issueDetailSlice';\n     6→import { updateIssueField } from '../slices/issueDetailSlice';\n     7→import { StatusIcon, PriorityIcon, STATUS_CONFIG, PRIORITY_CONFIG, STATUS_ORDER } from './IssueRow';\n     8→import './IssueSidebar.css';\n     9→\n    10→const PRIORITY_ORDER = ['urgent', 'high', 'medium', 'low', 'none'] as const;\n    11→\n    12→interface IssueSidebarProps {\n    13→  issue: Issue;\n    14→  members: TeamMember[];\n    15→  projects: TeamProject[];\n    16→  cycles: TeamCycle[];\n    17→  allLabels: IssueLabel[];\n    18→}\n    19→\n    20→type DropdownType = 'status' | 'priority' | 'assignee' | 'labels' | 'project' | 'cycle' | 'dueDate' | null;\n    21→\n    22→function getInitials(name: string): string {\n    23→  return name\n    24→    .split(' ')\n    25→    .map((n) => n[0])\n    26→    .join('')\n    27→    .toUpperCase()\n    28→    .slice(0, 2);\n    29→}\n    30→\n    31→function formatDate(dateStr: string): string {\n    32→  const date = new Date(dateStr);\n    33→  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });\n    34→}\n    35→\n    36→function formatDueDate(dateStr: string): string {\n    37→  const d = new Date(dateStr + 'T00:00:00');\n    38→  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });\n    39→}\n    40→\n    41→export default function IssueSidebar({ issue, members, projects, cycles, allLabels }: IssueSidebarProps) {\n    42→  const dispatch = useDispatch<AppDispatch>();\n    43→  const [openDropdown, setOpenDropdown] = useState<DropdownType>(null);\n    44→  const [assigneeSearch, setAssigneeSearch] = useState('');\n    45→  const [projectSearch, setProjectSearch] = useState('');\n    46→  const sidebarRef = useRef<HTMLDivElement>(null);\n    47→\n    48→  useEffect(() => {\n    49→    function handleClickOutside(e: MouseEvent) {\n    50→      if (sidebarRef.current && !sidebarRef.current.contains(e.target as Node)) {\n    51→        setOpenDropdown(null);\n    52→      }\n    53→    }\n    54→    if (openDropdown) {\n    55→      document.addEventListener('mousedown', handleClickOutside);\n    56→    }\n    57→    return () => document.removeEventListener('mousedown', handleClickOutside);\n    58→  }, [openDropdown]);\n    59→\n    60→  function toggleDropdown(type: DropdownType) {\n    61→    setOpenDropdown(openDropdown === type ? null : type);\n    62→    if (type === 'assignee') setAssigneeSearch('');\n    63→    if (type === 'project') setProjectSearch('');\n    64→  }\n    65→\n    66→  function handleStatusChange(status: string) {\n    67→    dispatch(updateIssueField({ issueId: issue.id, field: 'status', value: status }));\n    68→    setOpenDropdown(null);\n    69→  }\n    70→\n    71→  function handlePriorityChange(priority: string) {\n    72→    dispatch(updateIssueField({ issueId: issue.id, field: 'priority', value: priority }));\n    73→    setOpenDropdown(null);\n    74→  }\n    75→\n    76→  function handleAssigneeChange(assigneeId: string | null) {\n    77→    dispatch(updateIssueField({ issueId: issue.id, field: 'assigneeId', value: assigneeId }));\n    78→    setOpenDropdown(null);\n    79→  }\n    80→\n    81→  function handleLabelToggle(labelId: string) {\n    82→    const currentIds = issue.labels.map((l) => l.id);\n    83→    let newIds: string[];\n    84→    if (currentIds.includes(labelId)) {\n    85→      newIds = currentIds.filter((id) => id !== labelId);\n    86→    } else {\n    87→      newIds = [...currentIds, labelId];\n    88→    }\n    89→    dispatch(updateIssueField({ issueId: issue.id, field: 'labels', value: null, labelIds: newIds }));\n    90→  }\n    91→\n    92→  function handleProjectChange(projectId: string | null) {\n    93→    dispatch(updateIssueField({ issueId: issue.id, field: 'projectId', value: projectId }));\n    94→    setOpenDropdown(null);\n    95→  }\n    96→\n    97→  function handleCycleChange(cycleId: string | null) {\n    98→    dispatch(updateIssueField({ issueId: issue.id, field: 'cycleId', value: cycleId }));\n    99→    setOpenDropdown(null);\n   100→  }\n   101→\n   102→  function handleDueDateChange(e: React.ChangeEvent<HTMLInputElement>) {\n   103→    const val = e.target.value || null;\n   104→    dispatch(updateIssueField({ issueId: issue.id, field: 'dueDate', value: val }));\n   105→  }\n   106→\n   107→  function handleClearDueDate() {\n   108→    dispatch(updateIssueField({ issueId: issue.id, field: 'dueDate', value: null }));\n   109→  }\n   110→\n   111→  const statusConfig = STATUS_CONFIG[issue.status] || STATUS_CONFIG.todo;\n   112→  const priorityConfig = PRIORITY_CONFIG[issue.priority] || PRIORITY_CONFIG.none;\n   113→  const filteredMembers = members.filter((m) =>\n   114→    m.name.toLowerCase().includes(assigneeSearch.toLowerCase())\n   115→  );\n   116→  const filteredProjects = projects.filter((p) =>\n   117→    p.name.toLowerCase().includes(projectSearch.toLowerCase())\n   118→  );\n   119→  const issueLabelIds = issue.labels.map((l) => l.id);\n   120→\n   121→  return (\n   122→    <div className=\"issue-sidebar\" ref={sidebarRef} data-testid=\"issue-sidebar\">\n   123→      {/* Status */}\n   124→      <div className=\"sidebar-field\" data-testid=\"sidebar-status-field\">\n   125→        <label className=\"sidebar-label\">Status</label>\n   126→        <div className=\"sidebar-dropdown-wrapper\">\n   127→          <button\n   128→            className=\"sidebar-select-btn\"\n   129→            onClick={() => toggleDropdown('status')}\n   130→            data-testid=\"sidebar-status-btn\"\n   131→          >\n   132→            <StatusIcon status={issue.status} color={statusConfig.color} />\n   133→            <span>{statusConfig.label}</span>\n   134→          </button>\n   135→          {openDropdown === 'status' && (\n   136→            <div className=\"sidebar-dropdown\" data-testid=\"sidebar-status-dropdown\">\n   137→              {STATUS_ORDER.map((s) => {\n   138→                const cfg = STATUS_CONFIG[s];\n   139→                return (\n   140→                  <button\n   141→                    key={s}\n   142→                    className={`sidebar-dropdown-option ${issue.status === s ? 'sidebar-dropdown-option-active' : ''}`}\n   143→                    onClick={() => handleStatusChange(s)}\n   144→                    data-testid={`sidebar-status-option-${s}`}\n   145→                  >\n   146→                    <StatusIcon status={s} color={cfg.color} />\n   147→                    <span>{cfg.label}</span>\n   148→                  </button>\n   149→                );\n   150→              })}\n   151→            </div>\n   152→          )}\n   153→        </div>\n   154→      </div>\n   155→\n   156→      {/* Priority */}\n   157→      <div className=\"sidebar-field\" data-testid=\"sidebar-priority-field\">\n   158→        <label className=\"sidebar-label\">Priority</label>\n   159→        <div className=\"sidebar-dropdown-wrapper\">\n   160→          <button\n   161→            className=\"sidebar-select-btn\"\n   162→            onClick={() => toggleDropdown('priority')}\n   163→            data-testid=\"sidebar-priority-btn\"\n   164→          >\n   165→            <PriorityIcon priority={issue.priority} />\n   166→            <span>{priorityConfig.label}</span>\n   167→          </button>\n   168→          {openDropdown === 'priority' && (\n   169→            <div className=\"sidebar-dropdown\" data-testid=\"sidebar-priority-dropdown\">\n   170→              {PRIORITY_ORDER.map((p) => {\n   171→                const cfg = PRIORITY_CONFIG[p] || PRIORITY_CONFIG.none;\n   172→                return (\n   173→                  <button\n   174→                    key={p}\n   175→                    className={`sidebar-dropdown-option ${issue.priority === p ? 'sidebar-dropdown-option-active' : ''}`}\n   176→                    onClick={() => handlePriorityChange(p)}\n   177→                    data-testid={`sidebar-priority-option-${p}`}\n   178→                  >\n   179→                    <PriorityIcon priority={p} />\n   180→                    <span>{cfg.label}</span>\n   181→                  </button>\n   182→                );\n   183→              })}\n   184→            </div>\n   185→          )}\n   186→        </div>\n   187→      </div>\n   188→\n   189→      {/* Assignee */}\n   190→      <div className=\"sidebar-field\" data-testid=\"sidebar-assignee-field\">\n   191→        <label className=\"sidebar-label\">Assignee</label>\n   192→        <div className=\"sidebar-dropdown-wrapper\">\n   193→          <button\n   194→            className=\"sidebar-select-btn\"\n   195→            onClick={() => toggleDropdown('assignee')}\n   196→            data-testid=\"sidebar-assignee-btn\"\n   197→          >\n   198→            {issue.assigneeName ? (\n   199→              <>\n   200→                <span className=\"sidebar-avatar\">{getInitials(issue.assigneeName)}</span>\n   201→                <span>{issue.assigneeName}</span>\n   202→              </>\n   203→            ) : (\n   204→              <span className=\"sidebar-placeholder\">No assignee</span>\n   205→            )}\n   206→          </button>\n   207→          {openDropdown === 'assignee' && (\n   208→            <div className=\"sidebar-dropdown sidebar-dropdown-searchable\" data-testid=\"sidebar-assignee-dropdown\">\n   209→              <input\n   210→                className=\"sidebar-search-input\"\n   211→                placeholder=\"Search members...\"\n   212→                value={assigneeSearch}\n   213→                onChange={(e) => setAssigneeSearch(e.target.value)}\n   214→                autoFocus\n   215→                data-testid=\"sidebar-assignee-search\"\n   216→              />\n   217→              <button\n   218→                className=\"sidebar-dropdown-option\"\n   219→                onClick={() => handleAssigneeChange(null)}\n   220→                data-testid=\"sidebar-assignee-option-none\"\n   221→              >\n   222→                <span className=\"sidebar-avatar sidebar-avatar-empty\">?</span>\n   223→                <span>Unassign</span>\n   224→              </button>\n   225→              {filteredMembers.map((m) => (\n   226→                <button\n   227→                  key={m.id}\n   228→                  className={`sidebar-dropdown-option ${issue.assigneeId === m.id ? 'sidebar-dropdown-option-active' : ''}`}\n   229→                  onClick={() => handleAssigneeChange(m.id)}\n   230→                  data-testid={`sidebar-assignee-option-${m.id}`}\n   231→                >\n   232→                  <span className=\"sidebar-avatar\">{getInitials(m.name)}</span>\n   233→                  <span>{m.name}</span>\n   234→                </button>\n   235→              ))}\n   236→            </div>\n   237→          )}\n   238→        </div>\n   239→      </div>\n   240→\n   241→      {/* Labels */}\n   242→      <div className=\"sidebar-field\" data-testid=\"sidebar-labels-field\">\n   243→        <label className=\"sidebar-label\">Labels</label>\n   244→        {issue.labels.length > 0 && (\n   245→          <div className=\"sidebar-labels-list\" data-testid=\"sidebar-labels-list\">\n   246→            {issue.labels.map((label) => (\n   247→              <span\n   248→                key={label.id}\n   249→                className=\"sidebar-label-badge\"\n   250→                style={{ borderColor: label.color }}\n   251→                data-testid={`sidebar-label-badge-${label.id}`}\n   252→              >\n   253→                <span className=\"sidebar-label-dot\" style={{ backgroundColor: label.color }} />\n   254→                {label.name}\n   255→              </span>\n   256→            ))}\n   257→          </div>\n   258→        )}\n   259→        <div className=\"sidebar-dropdown-wrapper\">\n   260→          <button\n   261→            className=\"sidebar-select-btn\"\n   262→            onClick={() => toggleDropdown('labels')}\n   263→            data-testid=\"sidebar-labels-btn\"\n   264→          >\n   265→            <span className=\"sidebar-placeholder\">\n   266→              {issue.labels.length === 0 ? 'No labels' : 'Edit labels'}\n   267→            </span>\n   268→          </button>\n   269→          {openDropdown === 'labels' && (\n   270→            <div className=\"sidebar-dropdown\" data-testid=\"sidebar-labels-dropdown\">\n   271→              {allLabels.map((label) => (\n   272→                <button\n   273→                  key={label.id}\n   274→                  className={`sidebar-dropdown-option ${issueLabelIds.includes(label.id) ? 'sidebar-dropdown-option-active' : ''}`}\n   275→                  onClick={() => handleLabelToggle(label.id)}\n   276→                  data-testid={`sidebar-label-option-${label.id}`}\n   277→                >\n   278→                  <span className=\"sidebar-label-dot\" style={{ backgroundColor: label.color }} />\n   279→                  <span>{label.name}</span>\n   280→                  {issueLabelIds.includes(label.id) && (\n   281→                    <svg className=\"sidebar-check\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"20 6 9 17 4 12\" /></svg>\n   282→                  )}\n   283→                </button>\n   284→              ))}\n   285→              {allLabels.length === 0 && (\n   286→                <div className=\"sidebar-dropdown-empty\">No labels available</div>\n   287→              )}\n   288→            </div>\n   289→          )}\n   290→        </div>\n   291→      </div>\n   292→\n   293→      {/* Project */}\n   294→      <div className=\"sidebar-field\" data-testid=\"sidebar-project-field\">\n   295→        <label className=\"sidebar-label\">Project</label>\n   296→        <div className=\"sidebar-dropdown-wrapper\">\n   297→          <button\n   298→            className=\"sidebar-select-btn\"\n   299→            onClick={() => toggleDropdown('project')}\n   300→            data-testid=\"sidebar-project-btn\"\n   301→          >\n   302→            <span className={issue.projectName ? '' : 'sidebar-placeholder'}>\n   303→              {issue.projectName || 'No project'}\n   304→            </span>\n   305→          </button>\n   306→          {openDropdown === 'project' && (\n   307→            <div className=\"sidebar-dropdown sidebar-dropdown-searchable\" data-testid=\"sidebar-project-dropdown\">\n   308→              <input\n   309→                className=\"sidebar-search-input\"\n   310→                placeholder=\"Search projects...\"\n   311→                value={projectSearch}\n   312→                onChange={(e) => setProjectSearch(e.target.value)}\n   313→                autoFocus\n   314→                data-testid=\"sidebar-project-search\"\n   315→              />\n   316→              <button\n   317→                className=\"sidebar-dropdown-option\"\n   318→                onClick={() => handleProjectChange(null)}\n   319→                data-testid=\"sidebar-project-option-none\"\n   320→              >\n   321→                <span>No project</span>\n   322→              </button>\n   323→              {filteredProjects.map((p) => (\n   324→                <button\n   325→                  key={p.id}\n   326→                  className={`sidebar-dropdown-option ${issue.projectId === p.id ? 'sidebar-dropdown-option-active' : ''}`}\n   327→                  onClick={() => handleProjectChange(p.id)}\n   328→                  data-testid={`sidebar-project-option-${p.id}`}\n   329→                >\n   330→                  <span>{p.name}</span>\n   331→                </button>\n   332→              ))}\n   333→            </div>\n   334→          )}\n   335→        </div>\n   336→      </div>\n   337→\n   338→      {/* Cycle */}\n   339→      <div className=\"sidebar-field\" data-testid=\"sidebar-cycle-field\">\n   340→        <label className=\"sidebar-label\">Cycle</label>\n   341→        <div className=\"sidebar-dropdown-wrapper\">\n   342→          <button\n   343→            className=\"sidebar-select-btn\"\n   344→            onClick={() => toggleDropdown('cycle')}\n   345→            data-testid=\"sidebar-cycle-btn\"\n   346→          >\n   347→            <span className={issue.cycleId ? '' : 'sidebar-placeholder'}>\n   348→              {issue.cycleId\n   349→                ? cycles.find((c) => c.id === issue.cycleId)?.name || 'Unknown cycle'\n   350→                : 'No cycle'}\n   351→            </span>\n   352→          </button>\n   353→          {openDropdown === 'cycle' && (\n   354→            <div className=\"sidebar-dropdown\" data-testid=\"sidebar-cycle-dropdown\">\n   355→              <button\n   356→                className=\"sidebar-dropdown-option\"\n   357→                onClick={() => handleCycleChange(null)}\n   358→                data-testid=\"sidebar-cycle-option-none\"\n   359→              >\n   360→                <span>No cycle</span>\n   361→              </button>\n   362→              {cycles.map((c) => (\n   363→                <button\n   364→                  key={c.id}\n   365→                  className={`sidebar-dropdown-option ${issue.cycleId === c.id ? 'sidebar-dropdown-option-active' : ''}`}\n   366→                  onClick={() => handleCycleChange(c.id)}\n   367→                  data-testid={`sidebar-cycle-option-${c.id}`}\n   368→                >\n   369→                  <span>{c.name}</span>\n   370→                </button>\n   371→              ))}\n   372→            </div>\n   373→          )}\n   374→        </div>\n   375→      </div>\n   376→\n   377→      {/* Due Date */}\n   378→      <div className=\"sidebar-field\" data-testid=\"sidebar-due-date-field\">\n   379→        <label className=\"sidebar-label\">Due date</label>\n   380→        <div className=\"sidebar-date-wrapper\">\n   381→          <input\n   382→            type=\"date\"\n   383→            className=\"sidebar-date-input\"\n   384→            value={issue.dueDate || ''}\n   385→            onChange={handleDueDateChange}\n   386→            data-testid=\"sidebar-due-date-input\"\n   387→          />\n   388→          {issue.dueDate && (\n   389→            <div className=\"sidebar-date-display\">\n   390→              <span data-testid=\"sidebar-due-date-display\">{formatDueDate(issue.dueDate)}</span>\n   391→              <button\n   392→                className=\"sidebar-date-clear\"\n   393→                onClick={handleClearDueDate}\n   394→                data-testid=\"sidebar-due-date-clear\"\n   395→              >\n   396→                &times;\n   397→              </button>\n   398→            </div>\n   399→          )}\n   400→        </div>\n   401→      </div>\n   402→\n   403→      {/* Created */}\n   404→      <div className=\"sidebar-field sidebar-field-readonly\" data-testid=\"sidebar-created-field\">\n   405→        <label className=\"sidebar-label\">Created</label>\n   406→        <span className=\"sidebar-readonly-value\" data-testid=\"sidebar-created-value\">\n   407→          {formatDate(issue.createdAt)}\n   408→        </span>\n   409→      </div>\n   410→\n   411→      {/* Updated */}\n   412→      <div className=\"sidebar-field sidebar-field-readonly\" data-testid=\"sidebar-updated-field\">\n   413→        <label className=\"sidebar-label\">Updated</label>\n   414→        <span className=\"sidebar-readonly-value\" data-testid=\"sidebar-updated-value\">\n   415→          {formatDate(issue.updatedAt)}\n   416→        </span>\n   417→      </div>\n   418→    </div>\n   419→  );\n   420→}\n   421→"}]},"parent_tool_use_id":"toolu_015nVmCsdVEaPP37ivBydGFc","session_id":"1c91b507-8d26-43b3-bb1c-ff396945621b","uuid":"06a2c6d3-7829-4816-aec5-50034a8dbe2f"}
