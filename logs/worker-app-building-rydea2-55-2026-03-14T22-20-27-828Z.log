ect(page.getByTestId('comment-input')).toHaveValue('');\n   393→  });\n   394→\n   395→  test('Comment displays long text properly', async ({ page, baseURL }) => {\n   396→    // Use ENG-3\n   397→    const { token, issue } = await loginAndNavigateToIssue(page, baseURL!, 3);\n   398→\n   399→    // Switch to Comments tab\n   400→    await page.getByTestId('comments-tab').click();\n   401→\n   402→    // Type a long multi-paragraph comment\n   403→    const longComment = 'This is a very long comment that spans multiple paragraphs. ' +\n   404→      'It includes detailed technical analysis of the issue at hand. ' +\n   405→      'The root cause appears to be related to the session management layer ' +\n   406→      'where tokens are not being properly refreshed upon expiration. ' +\n   407→      'We need to implement a token refresh mechanism that handles edge cases ' +\n   408→      'such as concurrent requests, network failures, and race conditions. ' +\n   409→      'Additionally, we should add comprehensive logging to track token lifecycle events.';\n   410→\n   411→    await page.getByTestId('comment-input').fill(longComment);\n   412→    await page.getByTestId('comment-submit-btn').click();\n   413→\n   414→    // Verify comment appears with full text\n   415→    const commentEntries = page.locator('[data-testid^=\"comment-entry-\"]');\n   416→    await expect(commentEntries).toHaveCount(1, { timeout: 30000 });\n   417→\n   418→    // Verify the full text is displayed (not truncated)\n   419→    const commentContent = page.locator('[data-testid^=\"comment-content-\"]').first();\n   420→    await expect(commentContent).toContainText('This is a very long comment');\n   421→    await expect(commentContent).toContainText('comprehensive logging to track token lifecycle events');\n   422→\n   423→    // Verify the comment element is visible and not overflowing (content accessible)\n   424→    await expect(commentContent).toBeVisible();\n   425→\n   426→    // Verify i