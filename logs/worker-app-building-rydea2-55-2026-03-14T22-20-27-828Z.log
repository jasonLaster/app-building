[2026-03-14T22:15:37.611Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BzkvdwbbP344mmUxcRKiK9","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test';\n     2→\n     3→// Helper to login via API and get token\n     4→async function loginViaApi(baseURL: string, email: string, password: string) {\n     5→  const response = await fetch(`${baseURL}/api/login`, {\n     6→    method: 'POST',\n     7→    headers: { 'Content-Type': 'application/json' },\n     8→    body: JSON.stringify({ email, password }),\n     9→  });\n    10→  return response.json();\n    11→}\n    12→\n    13→// Helper to get teams via API\n    14→async function getTeams(baseURL: string, token: string) {\n    15→  const response = await fetch(`${baseURL}/api/teams`, {\n    16→    headers: { Authorization: `Bearer ${token}` },\n    17→  });\n    18→  const data = await response.json();\n    19→  return data.teams;\n    20→}\n    21→\n    22→// Helper to login and open create issue modal from ENG team page\n    23→async function loginAndOpenCreateModal(\n    24→  page: import('@playwright/test').Page,\n    25→  baseURL: string,\n    26→  teamIdentifier = 'ENG',\n    27→  email = 'alice@acme.com',\n    28→  password = 'password123'\n    29→) {\n    30→  const data = await loginViaApi(baseURL, email, password);\n    31→  const teams = await getTeams(baseURL, data.token);\n    32→  const team = teams.find((t: { identifier: string }) => t.identifier === teamIdentifier);\n    33→\n    34→  await page.goto('/login');\n    35→  await page.evaluate((t) => localStorage.setItem('session_token', t), data.token);\n    36→  await page.goto(`/team/${team.id}/issues`);\n    37→  await expect(page.getByTestId('team-issues-page')).toBeVisible({ timeout: 30000 });\n    38→\n    39→  // Open create issue modal\n    40→  await page.getByTestId('new-issue-btn').click();\n    41→  await expect(page.getByTestId('create-issue-modal')).toBeVisible({ timeout: 30000 });\n    42→\n    43→  return { token: data.token, user: data.user, team, teams };\n    44→}\n    45→\n    46→test.describe('CreateIssueModalSelectors', () => {\n    47→  test('Priority dropdown defaults to No Priority', async ({ page, baseURL }) => {\n    48→    await loginAndOpenCreateModal(page, baseURL!);\n    49→\n    50→    // Verify priority shows \"No Priority\" as default\n    51→    await expect(page.getByTestId('create-issue-priority-selector')).toContainText('No Priority');\n    52→\n    53→    // Verify the priority selector has an SVG icon\n    54→    const priorityIcon = page.getByTestId('create-issue-priority-selector').locator('svg').first();\n    55→    await expect(priorityIcon).toBeVisible();\n    56→  });\n    57→\n    58→  test('Priority dropdown shows all priority options with icons', async ({ page, baseURL }) => {\n    59→    await loginAndOpenCreateModal(page, baseURL!);\n    60→\n    61→    // Click the priority dropdown\n    62→    await page.getByTestId('create-issue-priority-selector').click();\n    63→    await expect(page.getByTestId('create-issue-priority-dropdown')).toBeVisible();\n    64→\n    65→    // Verify all 5 priority options are visible with correct labels\n    66→    await expect(page.getByTestId('create-issue-priority-option-urgent')).toBeVisible();\n    67→    await expect(page.getByTestId('create-issue-priority-option-urgent')).toContainText('Urgent');\n    68→\n    69→    await expect(page.getByTestId('create-issue-priority-option-high')).toBeVisible();\n    70→    await expect(page.getByTestId('create-issue-priority-option-high')).toContainText('High');\n    71→\n    72→    await expect(page.getByTestId('create-issue-priority-option-medium')).toBeVisible();\n    73→    await expect(page.getByTestId('create-issue-priority-option-medium')).toContainText('Medium');\n    74→\n    75→    await expect(page.getByTestId('create-issue-priority-option-low')).toBeVisible();\n    76→    await expect(page.getByTestId('create-issue-priority-option-low')).toContainText('Low');\n    77→\n    78→    await expect(page.getByTestId('create-issue-priority-option-none')).toBeVisible();\n    79→    await expect(page.getByTestId('create-issue-priority-option-none')).toContainText('No Priority');\n    80→\n    81→    // Verify each option has an icon (SVG)\n    82→    for (const priority of ['urgent', 'high', 'medium', 'low', 'none']) {\n    83→      const option = page.getByTestId(`create-issue-priority-option-${priority}`);\n    84→      await expect(option.locator('svg').first()).toBeVisible();\n    85→    }\n    86→  });\n    87→\n    88→  test('Priority dropdown allows selecting a priority', async ({ page, baseURL }) => {\n    89→    await loginAndOpenCreateModal(page, baseURL!);\n    90→\n    91→    // Verify initial priority is \"No Priority\"\n    92→    await expect(page.getByTestId('create-issue-priority-selector')).toContainText('No Priority');\n    93→\n    94→    // Click priority dropdown and select \"High\"\n    95→    await page.getByTestId('create-issue-priority-selector').click();\n    96→    await expect(page.getByTestId('create-issue-priority-dropdown')).toBeVisible();\n    97→    await page.getByTestId('create-issue-priority-option-high').click();\n    98→\n    99→    // Verify priority now shows \"High\"\n   100→    await expect(page.getByTestId('create-issue-priority-selector')).toContainText('High');\n   101→\n   102→    // Verify the priority selector has an icon\n   103→    const priorityIcon = page.getByTestId('create-issue-priority-selector').locator('svg').first();\n   104→    await expect(priorityIcon).toBeVisible();\n   105→  });\n   106→\n   107→  test('Assignee selector is searchable', async ({ page, baseURL }) => {\n   108→    await loginAndOpenCreateModal(page, baseURL!);\n   109→\n   110→    // Click the assignee selector\n   111→    await page.getByTestId('create-issue-assignee-selector').click();\n   112→    await expect(page.getByTestId('create-issue-assignee-dropdown')).toBeVisible();\n   113→\n   114→    // Type search text \"Ali\"\n   115→    await page.getByTestId('create-issue-assignee-search').fill('Ali');\n   116→\n   117→    // Verify only Alice Johnson is shown (filtered results)\n   118→    const options = page.getByTestId('create-issue-assignee-dropdown').locator('button').filter({ hasText: /Johnson/ });\n   119→    await expect(options).toHaveCount(1, { timeout: 10000 });\n   120→    await expect(options).toContainText('Alice Johnson');\n   121→\n   122→    // Verify Bob Smith is not shown\n   123→    await expect(\n   124→      page.getByTestId('create-issue-assignee-dropdown').locator('button').filter({ hasText: /Bob Smith/ })\n   125→    ).toHaveCount(0);\n   126→  });\n   127→\n   128→  test('Assignee selector allows selecting a member', async ({ page, baseURL }) => {\n   129→    await loginAndOpenCreateModal(page, baseURL!);\n   130→\n   131→    // Verify assignee is initially empty\n   132→    await expect(page.getByTestId('create-issue-assignee-selector')).toContainText('No assignee');\n   133→\n   134→    // Click assignee selector\n   135→    await page.getByTestId('create-issue-assignee-selector').click();\n   136→    await expect(page.getByTestId('create-issue-assignee-dropdown')).toBeVisible();\n   137→\n   138→    // Type \"Bob\" to search\n   139→    await page.getByTestId('create-issue-assignee-search').fill('Bob');\n   140→\n   141→    // Click Bob Smith\n   142→    const bobOption = page.getByTestId('create-issue-assignee-dropdown').locator('button').filter({ hasText: /Bob Smith/ });\n   143→    await expect(bobOption).toBeVisible({ timeout: 10000 });\n   144→    await bobOption.click();\n   145→\n   146→    // Verify assignee shows \"Bob Smith\"\n   147→    await expect(page.getByTestId('create-issue-assignee-selector')).toContainText('Bob Smith');\n   148→  });\n   149→\n   150→  test('Labels multi-select allows selecting multiple labels', async ({ page, baseURL }) => {\n   151→    await loginAndOpenCreateModal(page, baseURL!);\n   152→\n   153→    // Click labels selector\n   154→    await page.getByTestId('create-issue-labels-selector').click();\n   155→    await expect(page.getByTestId('create-issue-labels-dropdown')).toBeVisible();\n   156→\n   157→    // Select \"Bug\" label\n   158→    const bugOption = page.getByTestId('create-issue-labels-dropdown').locator('button').filter({ hasText: /^Bug$/ });\n   159→    await bugOption.click();\n   160→\n   161→    // Select \"Feature\" label\n   162→    const featureOption = page.getByTestId('create-issue-labels-dropdown').locator('button').filter({ hasText: /^Feature$/ });\n   163→    await featureOption.click();\n   164→\n   165→    // Verify both labels appear as badges\n   166→    const selectedLabels = page.getByTestId('create-issue-selected-labels');\n   167→    await expect(selectedLabels).toBeVisible();\n   168→    await expect(selectedLabels).toContainText('Bug');\n   169→    await expect(selectedLabels).toContainText('Feature');\n   170→  });\n   171→\n   172→  test('Labels multi-select allows removing a selected label', async ({ page, baseURL }) => {\n   173→    await loginAndOpenCreateModal(page, baseURL!);\n   174→\n   175→    // Select \"Bug\" and \"Feature\" labels\n   176→    await page.getByTestId('create-issue-labels-selector').click();\n   177→    await expect(page.getByTestId('create-issue-labels-dropdown')).toBeVisible();\n   178→\n   179→    const bugOption = page.getByTestId('create-issue-labels-dropdown').locator('button').filter({ hasText: /^Bug$/ });\n   180→    await bugOption.click();\n   181→\n   182→    const featureOption = page.getByTestId('create-issue-labels-dropdown').locator('button').filter({ hasText: /^Feature$/ });\n   183→    await featureOption.click();\n   184→\n   185→    // Close dropdown by clicking elsewhere on the form\n   186→    await page.getByTestId('create-issue-title-input').click();\n   187→\n   188→    // Verify both labels are selected\n   189→    const selectedLabels = page.getByTestId('create-issue-selected-labels');\n   190→    await expect(selectedLabels).toContainText('Bug');\n   191→    await expect(selectedLabels).toContainText('Feature');\n   192→\n   193→    // Find the Bug label badge and click its remove button\n   194→    const bugBadges = selectedLabels.locator('.cif-label-badge').filter({ hasText: /^Bug/ });\n   195→    await bugBadges.locator('.cif-label-remove').click();\n   196→\n   197→    // Verify only \"Feature\" remains\n   198→    await expect(selectedLabels).toContainText('Feature');\n   199→    await expect(selectedLabels).not.toContainText('Bug');\n   200→  });\n   201→\n   202→  test('Project selector is searchable', async ({ page, baseURL }) => {\n   203→    await loginAndOpenCreateModal(page, baseURL!);\n   204→\n   205→    // Click the project selector\n   206→    await page.getByTestId('create-issue-project-selector').click();\n   207→    await expect(page.getByTestId('create-issue-project-dropdown')).toBeVisible();\n   208→\n   209→    // Verify search input is present\n   210→    await expect(page.getByTestId('create-issue-project-search')).toBeVisible();\n   211→\n   212→    // Type search text — seed data has \"V2 Launch\" project\n   213→    await page.getByTestId('create-issue-project-search').fill('V2');\n   214→\n   215→    // Verify \"V2 Launch\" is visible in the filtered results\n   216→    const projectOptions = page.getByTestId('create-issue-project-dropdown').locator('button').filter({ hasText: /V2 Launch/ });\n   217→    await expect(projectOptions).toHaveCount(1, { timeout: 10000 });\n   218→  });\n   219→\n   220→  test('Project selector allows selecting a project', async ({ page, baseURL }) => {\n   221→    await loginAndOpenCreateModal(page, baseURL!);\n   222→\n   223→    // Verify project is initially empty\n   224→    await expect(page.getByTestId('create-issue-project-selector')).toContainText('No project');\n   225→\n   226→    // Click project selector\n   227→    await page.getByTestId('create-issue-project-selector').click();\n   228→    await expect(page.getByTestId('create-issue-project-dropdown')).toBeVisible();\n   229→\n   230→    // Select \"V2 Launch\" project\n   231→    const projectOption = page.getByTestId('create-issue-project-dropdown').locator('button').filter({ hasText: /V2 Launch/ });\n   232→    await expect(projectOption).toBeVisible({ timeout: 10000 });\n   233→    await projectOption.click();\n   234→\n   235→    // Verify project field shows \"V2 Launch\"\n   236→    await expect(page.getByTestId('create-issue-project-selector')).toContainText('V2 Launch');\n   237→  });\n   238→});\n   239→"}]},"parent_tool_use_id":"toolu_01FZy3wn4Xei6yUiHmBNh6qV","session_id":"1c91b507-8d26-43b3-bb1c-ff396945621b","uuid":"a8421b1a-62f5-4afc-b6cf-0599f01e52be"}
