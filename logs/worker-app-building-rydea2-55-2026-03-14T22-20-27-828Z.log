[2026-03-14T22:16:33.787Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018pb9sh5VpKWRPQaNsdmBWe","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test';\n     2→\n     3→// Helper to login as Alice and return token\n     4→async function loginAsAlice(baseURL: string): Promise<string> {\n     5→  const response = await fetch(`${baseURL}/api/login`, {\n     6→    method: 'POST',\n     7→    headers: { 'Content-Type': 'application/json' },\n     8→    body: JSON.stringify({ email: 'alice@acme.com', password: 'password123' }),\n     9→  });\n    10→  const data = await response.json();\n    11→  return data.token;\n    12→}\n    13→\n    14→// Helper to get notifications via API\n    15→async function getNotifications(baseURL: string, token: string) {\n    16→  const response = await fetch(`${baseURL}/api/notifications`, {\n    17→    headers: { Authorization: `Bearer ${token}` },\n    18→  });\n    19→  const data = await response.json();\n    20→  return data.notifications as Array<{\n    21→    id: string;\n    22→    type: string;\n    23→    issue_id: string;\n    24→    description: string;\n    25→    read: boolean;\n    26→    issue_identifier: string;\n    27→    created_at: string;\n    28→  }>;\n    29→}\n    30→\n    31→// Helper to archive notification via API\n    32→async function archiveNotificationAPI(baseURL: string, token: string, id: string) {\n    33→  await fetch(`${baseURL}/api/notifications/${id}/archive`, {\n    34→    method: 'PUT',\n    35→    headers: { Authorization: `Bearer ${token}` },\n    36→  });\n    37→}\n    38→\n    39→// Helper to authenticate page as Alice\n    40→async function authenticatePage(page: any, baseURL: string): Promise<string> {\n    41→  const token = await loginAsAlice(baseURL);\n    42→  await page.goto('/login');\n    43→  await page.evaluate((t: string) => localStorage.setItem('session_token', t), token);\n    44→  return token;\n    45→}\n    46→\n    47→// Cleanup: archive all notifications before each test so we start from seed state\n    48→async function archiveAllNotifications(baseURL: string, token: string) {\n    49→  const notifications = await getNotifications(baseURL, token);\n    50→  for (const n of notifications) {\n    51→    await archiveNotificationAPI(baseURL, token, n.id);\n    52→  }\n    53→}\n    54→\n    55→test.describe('Inbox List', () => {\n    56→  test('Inbox page renders with list of notifications', async ({ page, baseURL }) => {\n    57→    const token = await authenticatePage(page, baseURL!);\n    58→    await page.goto('/inbox');\n    59→\n    60→    await expect(page.getByTestId('inbox-page')).toBeVisible({ timeout: 30000 });\n    61→    await expect(page.getByTestId('notification-list')).toBeVisible({ timeout: 30000 });\n    62→\n    63→    // Alice has 3 notifications in seed (assignment, update, mention)\n    64→    const notifications = await getNotifications(baseURL!, token);\n    65→    const rows = page.locator('[data-testid^=\"notification-row-\"]');\n    66→    await expect(rows).toHaveCount(notifications.length, { timeout: 15000 });\n    67→\n    68→    // Each notification is a distinct row\n    69→    for (const n of notifications) {\n    70→      await expect(page.getByTestId(`notification-row-${n.id}`)).toBeVisible();\n    71→    }\n    72→  });\n    73→\n    74→  test('Inbox page shows empty state when no notifications', async ({ page, baseURL }) => {\n    75→    const token = await authenticatePage(page, baseURL!);\n    76→\n    77→    // Archive all notifications via API\n    78→    await archiveAllNotifications(baseURL!, token);\n    79→\n    80→    await page.goto('/inbox');\n    81→    await expect(page.getByTestId('inbox-page')).toBeVisible({ timeout: 30000 });\n    82→\n    83→    // Empty state should be shown\n    84→    await expect(page.getByTestId('notification-list-empty')).toBeVisible({ timeout: 15000 });\n    85→    await expect(page.getByTestId('notification-list-empty')).toContainText(\"You're all caught up!\");\n    86→  });\n    87→\n    88→  test('Inbox shows unread notifications visually distinct from read', async ({ page, baseURL }) => {\n    89→    const token = await authenticatePage(page, baseURL!);\n    90→    await page.goto('/inbox');\n    91→    await expect(page.getByTestId('notification-list')).toBeVisible({ timeout: 30000 });\n    92→\n    93→    const notifications = await getNotifications(baseURL!, token);\n    94→    const unreadNotifications = notifications.filter((n) => !n.read);\n    95→    const readNotifications = notifications.filter((n) => n.read);\n    96→\n    97→    // Unread notifications should have the unread class (bold text, left border accent)\n    98→    for (const n of unreadNotifications) {\n    99→      await expect(page.getByTestId(`notification-row-${n.id}`)).toHaveClass(/notification-row-unread/, { timeout: 10000 });\n   100→    }\n   101→\n   102→    // Read notifications should NOT have the unread class\n   103→    for (const n of readNotifications) {\n   104→      await expect(page.getByTestId(`notification-row-${n.id}`)).not.toHaveClass(/notification-row-unread/, { timeout: 10000 });\n   105→    }\n   106→  });\n   107→\n   108→  test('Inbox page shows notification count in header', async ({ page, baseURL }) => {\n   109→    const token = await authenticatePage(page, baseURL!);\n   110→    await page.goto('/inbox');\n   111→    await expect(page.getByTestId('inbox-page')).toBeVisible({ timeout: 30000 });\n   112→\n   113→    // Get unread count from API\n   114→    const notifications = await getNotifications(baseURL!, token);\n   115→    const unreadCount = notifications.filter((n) => !n.read).length;\n   116→\n   117→    // Header should show count\n   118→    await expect(page.getByTestId('inbox-title')).toBeVisible({ timeout: 15000 });\n   119→    await expect(page.getByTestId('inbox-title-count')).toContainText(`(${unreadCount})`, { timeout: 15000 });\n   120→  });\n   121→\n   122→  test('Inbox notification list updates sidebar badge when notifications change', async ({ page, baseURL }) => {\n   123→    const token = await authenticatePage(page, baseURL!);\n   124→    await page.goto('/inbox');\n   125→    await expect(page.getByTestId('notification-list')).toBeVisible({ timeout: 30000 });\n   126→\n   127→    // Sidebar badge should show initial unread count\n   128→    const notifications = await getNotifications(baseURL!, token);\n   129→    const unreadCount = notifications.filter((n) => !n.read).length;\n   130→    await expect(page.getByTestId('sidebar-inbox-badge')).toHaveText(String(unreadCount), { timeout: 15000 });\n   131→\n   132→    // Click an unread notification to mark it as read\n   133→    const unreadNotification = notifications.find((n) => !n.read);\n   134→    if (unreadNotification) {\n   135→      await page.getByTestId(`notification-row-${unreadNotification.id}`).click();\n   136→      // Navigate back to inbox\n   137→      await page.getByTestId('sidebar-link-inbox').click();\n   138→      await expect(page).toHaveURL(/\\/inbox/, { timeout: 30000 });\n   139→\n   140→      // Badge should decrement\n   141→      await expect(page.getByTestId('sidebar-inbox-badge')).toHaveText(String(unreadCount - 1), { timeout: 15000 });\n   142→    }\n   143→  });\n   144→\n   145→  test('Inbox notifications are ordered by newest first', async ({ page, baseURL }) => {\n   146→    const token = await authenticatePage(page, baseURL!);\n   147→    await page.goto('/inbox');\n   148→    await expect(page.getByTestId('notification-list')).toBeVisible({ timeout: 30000 });\n   149→\n   150→    // API returns newest first (ORDER BY created_at DESC)\n   151→    const notifications = await getNotifications(baseURL!, token);\n   152→\n   153→    // Verify order by checking rows appear in same order as API response\n   154→    const rows = page.locator('[data-testid^=\"notification-row-\"]');\n   155→    const rowCount = await rows.count();\n   156→    expect(rowCount).toBe(notifications.length);\n   157→\n   158→    for (let i = 0; i < notifications.length; i++) {\n   159→      const rowTestId = await rows.nth(i).getAttribute('data-testid');\n   160→      expect(rowTestId).toBe(`notification-row-${notifications[i].id}`);\n   161→    }\n   162→  });\n   163→\n   164→  test('Archiving a notification removes it from the list', async ({ page, baseURL }) => {\n   165→    const token = await authenticatePage(page, baseURL!);\n   166→    await page.goto('/inbox');\n   167→    await expect(page.getByTestId('notification-list')).toBeVisible({ timeout: 30000 });\n   168→\n   169→    const notifications = await getNotifications(baseURL!, token);\n   170→    const initialCount = notifications.length;\n   171→    const targetNotification = notifications[0];\n   172→\n   173→    // Archive the first notification\n   174→    await page.getByTestId(`notification-archive-btn-${targetNotification.id}`).click({ force: true });\n   175→\n   176→    // Notification should be removed\n   177→    await expect(page.getByTestId(`notification-row-${targetNotification.id}`)).not.toBeVisible({ timeout: 15000 });\n   178→\n   179→    // List should have one fewer item\n   180→    const rows = page.locator('[data-testid^=\"notification-row-\"]');\n   181→    await expect(rows).toHaveCount(initialCount - 1, { timeout: 15000 });\n   182→  });\n   183→\n   184→  test('Archiving multiple notifications works in sequence', async ({ page, baseURL }) => {\n   185→    const token = await authenticatePage(page, baseURL!);\n   186→    await page.goto('/inbox');\n   187→    await expect(page.getByTestId('notification-list')).toBeVisible({ timeout: 30000 });\n   188→\n   189→    const notifications = await getNotifications(baseURL!, token);\n   190→    const initialCount = notifications.length;\n   191→    expect(initialCount).toBeGreaterThanOrEqual(2);\n   192→\n   193→    // Archive first notification\n   194→    await page.getByTestId(`notification-archive-btn-${notifications[0].id}`).click({ force: true });\n   195→    await expect(page.getByTestId(`notification-row-${notifications[0].id}`)).not.toBeVisible({ timeout: 15000 });\n   196→\n   197→    // Archive second notification (now it's still identifiable by its ID)\n   198→    await page.getByTestId(`notification-archive-btn-${notifications[1].id}`).click({ force: true });\n   199→    await expect(page.getByTestId(`notification-row-${notifications[1].id}`)).not.toBeVisible({ timeout: 15000 });\n   200→\n   201→    // Remaining count\n   202→    const rows = page.locator('[data-testid^=\"notification-row-\"]');\n   203→    await expect(rows).toHaveCount(initialCount - 2, { timeout: 15000 });\n   204→  });\n   205→\n   206→  test('All notifications can be archived to reach empty state', async ({ page, baseURL }) => {\n   207→    const token = await authenticatePage(page, baseURL!);\n   208→    await page.goto('/inbox');\n   209→    await expect(page.getByTestId('notification-list')).toBeVisible({ timeout: 30000 });\n   210→\n   211→    const notifications = await getNotifications(baseURL!, token);\n   212→\n   213→    // Archive all notifications one by one\n   214→    for (const n of notifications) {\n   215→      await page.getByTestId(`notification-archive-btn-${n.id}`).click({ force: true });\n   216→      await expect(page.getByTestId(`notification-row-${n.id}`)).not.toBeVisible({ timeout: 15000 });\n   217→    }\n   218→\n   219→    // Empty state should appear\n   220→    await expect(page.getByTestId('notification-list-empty')).toBeVisible({ timeout: 15000 });\n   221→\n   222→    // Sidebar badge should disappear\n   223→    await expect(page.getByTestId('sidebar-inbox-badge')).not.toBeVisible({ timeout: 15000 });\n   224→  });\n   225→});\n   226→"}]},"parent_tool_use_id":"toolu_01YLiWbMzcKSgkkX7AbPkpSd","session_id":"1c91b507-8d26-43b3-bb1c-ff396945621b","uuid":"be66aa3c-8655-4175-9f53-50b6c4332175"}
