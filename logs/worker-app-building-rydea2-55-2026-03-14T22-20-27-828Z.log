h: { token: string | null } };\n   121→    const token = state.auth.token;\n   122→    if (!token) return rejectWithValue('No token');\n   123→    const response = await fetch('/api/add-comment', {\n   124→      method: 'POST',\n   125→      headers: {\n   126→        'Content-Type': 'application/json',\n   127→        Authorization: `Bearer ${token}`,\n   128→      },\n   129→      body: JSON.stringify(payload),\n   130→    });\n   131→    if (!response.ok) {\n   132→      return rejectWithValue('Failed to add comment');\n   133→    }\n   134→    return await response.json() as { comment: Comment };\n   135→  }\n   136→);\n   137→\n   138→const issueDetailSlice = createSlice({\n   139→  name: 'issueDetail',\n   140→  initialState,\n   141→  reducers: {\n   142→    clearIssueDetail(state) {\n   143→      state.issue = null;\n   144→      state.subIssues = [];\n   145→      state.activity = [];\n   146→      state.comments = [];\n   147→      state.members = [];\n   148→      state.projects = [];\n   149→      state.cycles = [];\n   150→      state.allLabels = [];\n   151→      state.loading = false;\n   152→      state.error = null;\n   153→    },\n   154→  },\n   155→  extraReducers: (builder) => {\n   156→    builder\n   157→      .addCase(fetchIssueDetail.pending, (state) => {\n   158→        if (!state.issue) {\n   159→          state.loading = true;\n   160→        }\n   161→        state.error = null;\n   162→      })\n   163→      .addCase(fetchIssueDetail.fulfilled, (state, action) => {\n   164→        state.loading = false;\n   165→        state.issue = action.payload.issue;\n   166→        state.subIssues = action.payload.subIssues;\n   167→        state.activity = action.payload.activity;\n   168→        state.comments = action.payload.comments;\n   169→        state.members = action.payload.members;\n   170→        state.projects = action.payload.projects;\n   171→        state.cycles = action.payload.cycles;\n   172→        state.allLabels = action.payl