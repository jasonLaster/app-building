 58→      headers: { Authorization: `Bearer ${token}` },\n    59→    });\n    60→    if (!response.ok) {\n    61→      return rejectWithValue('Failed to fetch team issues');\n    62→    }\n    63→    return await response.json() as {\n    64→      issues: TeamIssue[];\n    65→      members: TeamMember[];\n    66→      projects: TeamProject[];\n    67→      cycles: TeamCycle[];\n    68→    };\n    69→  }\n    70→);\n    71→\n    72→export const bulkUpdateIssues = createAsyncThunk(\n    73→  'teamIssues/bulkUpdateIssues',\n    74→  async (\n    75→    payload: {\n    76→      issueIds: string[];\n    77→      status?: string;\n    78→      priority?: string;\n    79→      assigneeId?: string | null;\n    80→      labelId?: string;\n    81→      teamId: string;\n    82→    },\n    83→    { getState, dispatch, rejectWithValue }\n    84→  ) => {\n    85→    const state = getState() as { auth: { token: string | null } };\n    86→    const token = state.auth.token;\n    87→    if (!token) return rejectWithValue('No token');\n    88→    const { teamId, ...body } = payload;\n    89→    const response = await fetch('/api/bulk-update-issues', {\n    90→      method: 'PUT',\n    91→      headers: {\n    92→        'Content-Type': 'application/json',\n    93→        Authorization: `Bearer ${token}`,\n    94→      },\n    95→      body: JSON.stringify(body),\n    96→    });\n    97→    if (!response.ok) {\n    98→      return rejectWithValue('Failed to bulk update issues');\n    99→    }\n   100→    // Refetch team issues to get updated data\n   101→    dispatch(fetchTeamIssues(teamId));\n   102→    return payload;\n   103→  }\n   104→);\n   105→\n   106→const teamIssuesSlice = createSlice({\n   107→  name: 'teamIssues',\n   108→  initialState,\n   109→  reducers: {\n   110→    toggleIssueSelection(state, action: { payload: string }) {\n   111→      const id = action.payload;\n   112→      const idx = state.selectedIds.indexOf(id);\n   113→      if (idx >= 0) {\n   114→        state.selectedIds.splice(idx, 1);\n   115→      } else {\n   116→        state.selectedIds.push(id);\n   117→      }\n   118→    },\n   119→    selectGroupIssues(state, action: { payload: string[] }) {\n   120→      const ids = action.payload;\n   121→      const allSelected = ids.every((id) => state.selectedIds.includes(id));\n   122→      if (allSelected) {\n   123→        state.selectedIds = state.selectedIds.filter((id) => !ids.includes(id));\n   124→      } else {\n   125→        const newIds = ids.filter((id) => !state.selectedIds.includes(id));\n   126→        state.selectedIds.push(...newIds);\n   127→      }\n   128→    },\n   129→    clearSelection(state) {\n   130→      state.selectedIds = [];\n   131→    },\n   132→    setGroupBy(state, action: { payload: TeamIssuesState['groupBy'] }) {\n   133→      state.groupBy = action.payload;\n   134→    },\n   135→    setSortBy(state, action: { payload: TeamIssuesState['sortBy'] }) {\n   136→      state.sortBy = action.payload;\n   137→    },\n   138→  },\n   139→  extraReducers: (builder) => {\n   140→    builder\n   141→      .addCase(fetchTeamIssues.pending, (state) => {\n   142→        if (state.items.length === 0) {\n   143→          state.loading = true;\n   144→        }\n   145→        state.error = null;\n   146→      })\n   147→      .addCase(fetchTeamIssues.fulfilled, (state, action) => {\n   148→        state.loading = false;\n   149→        state.items = action.payload.issues;\n   150→        state.members = action.payload.members;\n   151→        state.projects = action.payload.projects;\n   152→        state.cycles = action.payload.cycles;\n   153→      })\n   154→      .addCase(fetchTeamIssues.rejected, (state, action) => {\n   155→        state.loading = false;\n   156→        state.error = action.payload as string;\n   157→      })\n   158→      .addCase(bulkUpdateIssues.fulfilled, (state) => {\n   159→        state.selectedIds = [];\n   160→      })\n   161→      .addCase(updateIssueStatus.fulfilled, (state, action) => {\n   162→        const { issueId, status } = action.payload;\n   163→        const issue = state.items.find((i) => i.id === issueId);\n   164→        if (issue) {\n   165→          issue.status = status;\n   166→        }\n   167→      });\n   168→  },\n   169→});\n   170→\n   171→export const {\n   172→  toggleIssueSelection,\n   173→  selectGroupIssues,\n   174→  clearSelection,\n   175→  setGroupBy,\n   176→  setSortBy,\n   177→} = teamIssuesSlice.actions;\n   178→\n   179→export default teamIssuesSlice.reducer;\n   180→"}]},"parent_tool_use_id":"toolu_01YLiWbMzcKSgkkX7AbPkpSd","session_id":"1c91b507-8d26-43b3-bb1c-ff396945621b","uuid":"ea236121-eb33-45d3-b190-77a4bee50642"}
