nreadCount})\n    40→            </span>\n    41→          )}\n    42→        </span>\n    43→      </div>\n    44→      <div className=\"notification-list-items\" data-testid=\"notification-list-items\">\n    45→        {notifications.map((notification) => (\n    46→          <NotificationRow key={notification.id} notification={notification} />\n    47→        ))}\n    48→      </div>\n    49→    </div>\n    50→  );\n    51→}\n    52→"}]},"parent_tool_use_id":"toolu_01YLiWbMzcKSgkkX7AbPkpSd","session_id":"1c91b507-8d26-43b3-bb1c-ff396945621b","uuid":"48a6a9d4-07b6-48e4-b7cf-dcdaefe16179"}
