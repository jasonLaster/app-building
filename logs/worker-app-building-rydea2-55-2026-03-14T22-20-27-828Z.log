         ${issue.assigneeId}, ${projectId})\n   144→      RETURNING id\n   145→    `;\n   146→    const issueId = rows[0]?.id;\n   147→    if (issueId && issue.labelId) {\n   148→      await sql`INSERT INTO issue_labels (issue_id, label_id) VALUES (${issueId}, ${issue.labelId})`;\n   149→    }\n   150→  }\n   151→\n   152→  // Create project milestones\n   153→  await sql`\n   154→    INSERT INTO project_milestones (project_id, name, target_date, completed)\n   155→    VALUES (${projectId}, 'API Complete', '2026-04-15', false)\n   156→  `;\n   157→  await sql`\n   158→    INSERT INTO project_milestones (project_id, name, target_date, completed)\n   159→    VALUES (${projectId}, 'Beta Launch', '2026-05-30', false)\n   160→  `;\n   161→\n   162→  // Create some notifications for Alice\n   163→  const firstEngIssueRows = await sql`SELECT id FROM issues WHERE team_id = ${engId} AND number = 2 LIMIT 1`;\n   164→  const notifIssueId = firstEngIssueRows[0]?.id;\n   165→\n   166→  if (notifIssueId) {\n   167→    await sql`\n   168→      INSERT INTO notifications (member_id, type, message, issue_id, read, archived, created_at)\n   169→      VALUES (${aliceId}, 'assignment', 'You were assigned to this issue', ${notifIssueId}, false, false, NOW() - INTERVAL '5 minutes')\n   170→    `;\n   171→    await sql`\n   172→      INSERT INTO notifications (member_id, type, message, issue_id, read, archived, created_at)\n   173→      VALUES (${aliceId}, 'update', 'Status changed to In Progress', ${notifIssueId}, false, false, NOW() - INTERVAL '1 hour')\n   174→    `;\n   175→    await sql`\n   176→      INSERT INTO notifications (member_id, type, message, issue_id, read, archived, created_at)\n   177→      VALUES (${aliceId}, 'mention', 'Carol mentioned you in a comment', ${notifIssueId}, true, false, NOW() - INTERVAL '1 day')\n   178→    `;\n   179→  }\n   180→\n   181→  console.log('Database seeded successfully');\n   182→}\n   183→\n   184→export async function resetDatabase(database