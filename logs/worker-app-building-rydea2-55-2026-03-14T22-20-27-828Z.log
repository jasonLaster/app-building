ation/json' },\n    97→      });\n    98→    }\n    99→\n   100→    // Insert labels\n   101→    const labels: Array<{ id: string; name: string; color: string }> = [];\n   102→    if (labelIds && Array.isArray(labelIds) && labelIds.length > 0) {\n   103→      for (const labelId of labelIds) {\n   104→        await sql`\n   105→          INSERT INTO issue_labels (issue_id, label_id)\n   106→          VALUES (${newIssue.id}, ${labelId})\n   107→        `;\n   108→      }\n   109→      const labelRows = await sql`\n   110→        SELECT id, name, color FROM labels WHERE id = ANY(${labelIds})\n   111→      `;\n   112→      labels.push(...labelRows.map((l) => ({ id: String(l.id), name: String(l.name), color: String(l.color) })));\n   113→    }\n   114→\n   115→    // Create activity history entry\n   116→    await sql`\n   117→      INSERT INTO activity (issue_id, member_id, action, created_at)\n   118→      VALUES (${newIssue.id}, ${session.member_id}, 'created this issue', NOW())\n   119→    `;\n   120→\n   121→    // Create notification for assignee if different from creator\n   122→    if (issueAssigneeId && issueAssigneeId !== session.member_id) {\n   123→      const creatorResult = await sql`\n   124→        SELECT name FROM members WHERE id = ${session.member_id}\n   125→      `;\n   126→      const creator = creatorResult[0];\n   127→      const creatorName = creator ? String(creator.name) : 'Someone';\n   128→      const identifier = `${team.identifier}-${nextNumber}`;\n   129→\n   130→      await sql`\n   131→        INSERT INTO notifications (member_id, type, message, issue_id, created_at)\n   132→        VALUES (${issueAssigneeId}, 'assigned', ${`${creatorName} assigned you to ${identifier}: ${title}`}, ${newIssue.id}, NOW())\n   133→      `;\n   134→    }\n   135→\n   136→    // Fetch assignee name if set\n   137→    let assigneeName: string | null = null;\n   138→    let assigneeEmail: string | null = null;\n   139→    if (issueAssigneeId) {\n   140→      c