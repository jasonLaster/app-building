[2026-03-14T22:16:33.685Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AutTyxBv6NXm1S2tJa9jfw","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test';\n     2→\n     3→// Helper to login via API and get token\n     4→async function loginViaApi(baseURL: string, email: string, password: string) {\n     5→  const response = await fetch(`${baseURL}/api/login`, {\n     6→    method: 'POST',\n     7→    headers: { 'Content-Type': 'application/json' },\n     8→    body: JSON.stringify({ email, password }),\n     9→  });\n    10→  return response.json();\n    11→}\n    12→\n    13→// Helper to get teams via API\n    14→async function getTeams(baseURL: string, token: string) {\n    15→  const response = await fetch(`${baseURL}/api/teams`, {\n    16→    headers: { Authorization: `Bearer ${token}` },\n    17→  });\n    18→  const data = await response.json();\n    19→  return data.teams;\n    20→}\n    21→\n    22→// Helper to get team issues via API\n    23→async function getTeamIssues(baseURL: string, token: string, teamId: string) {\n    24→  const response = await fetch(`${baseURL}/api/team-issues?teamId=${teamId}`, {\n    25→    headers: { Authorization: `Bearer ${token}` },\n    26→  });\n    27→  const data = await response.json();\n    28→  return data.issues;\n    29→}\n    30→\n    31→// Helper to update issue field via API\n    32→async function updateIssueField(\n    33→  baseURL: string,\n    34→  token: string,\n    35→  issueId: string,\n    36→  field: string,\n    37→  value: string | null\n    38→) {\n    39→  const response = await fetch(`${baseURL}/api/update-issue`, {\n    40→    method: 'PUT',\n    41→    headers: {\n    42→      'Content-Type': 'application/json',\n    43→      Authorization: `Bearer ${token}`,\n    44→    },\n    45→    body: JSON.stringify({ issueId, field, value }),\n    46→  });\n    47→  return response.json();\n    48→}\n    49→\n    50→// Helper to add comment via API\n    51→async function addCommentViaApi(\n    52→  baseURL: string,\n    53→  token: string,\n    54→  issueId: string,\n    55→  content: string\n    56→) {\n    57→  const response = await fetch(`${baseURL}/api/add-comment`, {\n    58→    method: 'POST',\n    59→    headers: {\n    60→      'Content-Type': 'application/json',\n    61→      Authorization: `Bearer ${token}`,\n    62→    },\n    63→    body: JSON.stringify({ issueId, content }),\n    64→  });\n    65→  return response.json();\n    66→}\n    67→\n    68→// Helper to login and navigate to an issue detail page\n    69→async function loginAndNavigateToIssue(\n    70→  page: import('@playwright/test').Page,\n    71→  baseURL: string,\n    72→  issueNumber: number,\n    73→  email = 'alice@acme.com',\n    74→  password = 'password123'\n    75→) {\n    76→  const data = await loginViaApi(baseURL, email, password);\n    77→  const teams = await getTeams(baseURL, data.token);\n    78→  const engTeam = teams.find((t: { identifier: string }) => t.identifier === 'ENG');\n    79→  const issues = await getTeamIssues(baseURL, data.token, engTeam.id);\n    80→  const issue = issues.find((i: { number: number }) => i.number === issueNumber);\n    81→\n    82→  await page.goto('/login');\n    83→  await page.evaluate((t) => localStorage.setItem('session_token', t), data.token);\n    84→  await page.goto(`/issue/${issue.id}`);\n    85→  await expect(page.getByTestId('issue-detail-page')).toBeVisible({ timeout: 30000 });\n    86→  await expect(page.getByTestId('activity-comments')).toBeVisible({ timeout: 30000 });\n    87→  return { token: data.token, user: data.user, engTeam, issue };\n    88→}\n    89→\n    90→test.describe('IssueDetailActivityComments', () => {\n    91→  test('Activity/Comments section renders with tab toggle', async ({ page, baseURL }) => {\n    92→    await loginAndNavigateToIssue(page, baseURL!, 1);\n    93→\n    94→    // Verify the section is visible\n    95→    await expect(page.getByTestId('activity-comments')).toBeVisible();\n    96→\n    97→    // Verify both tab buttons exist\n    98→    await expect(page.getByTestId('activity-tab')).toBeVisible();\n    99→    await expect(page.getByTestId('activity-tab')).toHaveText('Activity');\n   100→    await expect(page.getByTestId('comments-tab')).toBeVisible();\n   101→    await expect(page.getByTestId('comments-tab')).toHaveText('Comments');\n   102→\n   103→    // Verify one tab is active (Activity is default)\n   104→    await expect(page.getByTestId('activity-tab')).toHaveClass(/activity-comments-tab-active/);\n   105→\n   106→    // Verify comment input box is visible\n   107→    await expect(page.getByTestId('comment-input')).toBeVisible();\n   108→    await expect(page.getByTestId('comment-submit-btn')).toBeVisible();\n   109→    await expect(page.getByTestId('comment-submit-btn')).toContainText('Comment');\n   110→  });\n   111→\n   112→  test('Activity tab shows chronological history', async ({ page, baseURL }) => {\n   113→    // Use ENG-7 (backlog, unassigned) to make controlled changes via API\n   114→    const data = await loginViaApi(baseURL!, 'alice@acme.com', 'password123');\n   115→    const teams = await getTeams(baseURL!, data.token);\n   116→    const engTeam = teams.find((t: { identifier: string }) => t.identifier === 'ENG');\n   117→    const issues = await getTeamIssues(baseURL!, data.token, engTeam.id);\n   118→    const issue = issues.find((i: { number: number }) => i.number === 7);\n   119→\n   120→    // Create activity entries via API: status change, assignee change, priority change\n   121→    await updateIssueField(baseURL!, data.token, issue.id, 'status', 'todo');\n   122→\n   123→    // Get alice's member ID for assignee\n   124→    const members = await (await fetch(`${baseURL!}/api/team-issues?teamId=${engTeam.id}`, {\n   125→      headers: { Authorization: `Bearer ${data.token}` },\n   126→    })).json();\n   127→    const alice = members.members.find((m: { name: string }) => m.name === 'Alice Johnson');\n   128→    await updateIssueField(baseURL!, data.token, issue.id, 'assigneeId', alice.id);\n   129→\n   130→    await updateIssueField(baseURL!, data.token, issue.id, 'priority', 'high');\n   131→\n   132→    // Navigate to the issue\n   133→    await page.goto('/login');\n   134→    await page.evaluate((t) => localStorage.setItem('session_token', t), data.token);\n   135→    await page.goto(`/issue/${issue.id}`);\n   136→    await expect(page.getByTestId('issue-detail-page')).toBeVisible({ timeout: 30000 });\n   137→\n   138→    // Verify Activity tab is active by default\n   139→    await expect(page.getByTestId('activity-tab')).toHaveClass(/activity-comments-tab-active/);\n   140→\n   141→    // Verify activity entries exist\n   142→    await expect(page.getByTestId('activity-list')).toBeVisible({ timeout: 30000 });\n   143→    const entries = page.locator('[data-testid^=\"activity-entry-\"]');\n   144→    await expect(entries).toHaveCount(3, { timeout: 30000 });\n   145→\n   146→    // Verify entries contain expected action text (oldest first)\n   147→    const activityList = page.getByTestId('activity-list');\n   148→    await expect(activityList).toContainText('status', { timeout: 30000 });\n   149→    await expect(activityList).toContainText('assignee', { timeout: 30000 });\n   150→    await expect(activityList).toContainText('priority', { timeout: 30000 });\n   151→  });\n   152→\n   153→  test('Comments tab shows user comments', async ({ page, baseURL }) => {\n   154→    // Use ENG-8 for comments\n   155→    const data = await loginViaApi(baseURL!, 'alice@acme.com', 'password123');\n   156→    const teams = await getTeams(baseURL!, data.token);\n   157→    const engTeam = teams.find((t: { identifier: string }) => t.identifier === 'ENG');\n   158→    const issues = await getTeamIssues(baseURL!, data.token, engTeam.id);\n   159→    const issue = issues.find((i: { number: number }) => i.number === 8);\n   160→\n   161→    // Add two comments via API\n   162→    await addCommentViaApi(baseURL!, data.token, issue.id, \"I'll look into this\");\n   163→\n   164→    // Login as Bob for second comment\n   165→    const bobData = await loginViaApi(baseURL!, 'bob@acme.com', 'password123');\n   166→    await addCommentViaApi(baseURL!, bobData.token, issue.id, 'Found the root cause');\n   167→\n   168→    // Navigate to the issue\n   169→    await page.goto('/login');\n   170→    await page.evaluate((t) => localStorage.setItem('session_token', t), data.token);\n   171→    await page.goto(`/issue/${issue.id}`);\n   172→    await expect(page.getByTestId('issue-detail-page')).toBeVisible({ timeout: 30000 });\n   173→\n   174→    // Switch to Comments tab\n   175→    await page.getByTestId('comments-tab').click();\n   176→    await expect(page.getByTestId('comments-tab')).toHaveClass(/activity-comments-tab-active/);\n   177→\n   178→    // Verify comments list is visible\n   179→    await expect(page.getByTestId('comments-list')).toBeVisible({ timeout: 30000 });\n   180→\n   181→    // Verify two comments displayed\n   182→    const commentEntries = page.locator('[data-testid^=\"comment-entry-\"]');\n   183→    await expect(commentEntries).toHaveCount(2, { timeout: 30000 });\n   184→\n   185→    // Verify comment content\n   186→    const commentsList = page.getByTestId('comments-list');\n   187→    await expect(commentsList).toContainText(\"I'll look into this\");\n   188→    await expect(commentsList).toContainText('Found the root cause');\n   189→\n   190→    // Verify author names are displayed\n   191→    await expect(commentsList).toContainText('Alice Johnson');\n   192→    await expect(commentsList).toContainText('Bob Smith');\n   193→  });\n   194→\n   195→  test('Add a new comment', async ({ page, baseURL }) => {\n   196→    // Use ENG-3\n   197→    const { token, issue } = await loginAndNavigateToIssue(page, baseURL!, 3);\n   198→\n   199→    // Switch to Comments tab\n   200→    await page.getByTestId('comments-tab').click();\n   201→    await expect(page.getByTestId('comments-tab')).toHaveClass(/activity-comments-tab-active/);\n   202→\n   203→    // Verify no comments initially\n   204→    await expect(page.getByTestId('comments-empty')).toBeVisible();\n   205→\n   206→    // Type a comment\n   207→    const commentText = 'This should be fixed in the next sprint';\n   208→    await page.getByTestId('comment-input').fill(commentText);\n   209→\n   210→    // Click the Comment button\n   211→    await page.getByTestId('comment-submit-btn').click();\n   212→\n   213→    // Verify new comment appears\n   214→    const commentEntries = page.locator('[data-testid^=\"comment-entry-\"]');\n   215→    await expect(commentEntries).toHaveCount(1, { timeout: 30000 });\n   216→\n   217→    // Verify comment content\n   218→    const commentsList = page.getByTestId('comments-list');\n   219→    await expect(commentsList).toContainText(commentText);\n   220→\n   221→    // Verify author name is shown (logged in as Alice)\n   222→    await expect(commentsList).toContainText('Alice Johnson');\n   223→\n   224→    // Verify timestamp shows \"just now\"\n   225→    await expect(commentsList).toContainText('just now');\n   226→\n   227→    // Verify input is cleared\n   228→    await expect(page.getByTestId('comment-input')).toHaveValue('');\n   229→  });\n   230→\n   231→  test('Comment button is disabled when input is empty', async ({ page, baseURL }) => {\n   232→    await loginAndNavigateToIssue(page, baseURL!, 1);\n   233→\n   234→    // Verify comment input is empty\n   235→    await expect(page.getByTestId('comment-input')).toHaveValue('');\n   236→\n   237→    // Verify Comment button is disabled\n   238→    await expect(page.getByTestId('comment-submit-btn')).toBeDisabled();\n   239→  });\n   240→\n   241→  test('Comment button enables when text is entered', async ({ page, baseURL }) => {\n   242→    await loginAndNavigateToIssue(page, baseURL!, 1);\n   243→\n   2