    47→          i.title AS issue_title\n    48→        FROM notifications n\n    49→        LEFT JOIN issues i ON i.id = n.issue_id\n    50→        WHERE n.member_id = ${memberId} AND n.archived = false\n    51→        ORDER BY n.created_at DESC\n    52→      `;\n    53→      return new Response(JSON.stringify({ notifications }), {\n    54→        status: 200,\n    55→        headers: { 'Content-Type': 'application/json' },\n    56→      });\n    57→    }\n    58→\n    59→    if (req.method === 'PUT' && notificationId && action === 'read') {\n    60→      await sql`\n    61→        UPDATE notifications SET read = true\n    62→        WHERE id = ${notificationId} AND member_id = ${memberId}\n    63→      `;\n    64→      return new Response(JSON.stringify({ success: true }), {\n    65→        status: 200,\n    66→        headers: { 'Content-Type': 'application/json' },\n    67→      });\n    68→    }\n    69→\n    70→    if (req.method === 'PUT' && notificationId && action === 'archive') {\n    71→      await sql`\n    72→        UPDATE notifications SET archived = true\n    73→        WHERE id = ${notificationId} AND member_id = ${memberId}\n    74→      `;\n    75→      return new Response(JSON.stringify({ success: true }), {\n    76→        status: 200,\n    77→        headers: { 'Content-Type': 'application/json' },\n    78→      });\n    79→    }\n    80→\n    81→    return new Response(JSON.stringify({ error: 'Not found' }), {\n    82→      status: 404,\n    83→      headers: { 'Content-Type': 'application/json' },\n    84→    });\n    85→  } catch (err) {\n    86→    console.error('Notifications error:', err);\n    87→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n    88→      status: 500,\n    89→      headers: { 'Content-Type': 'application/json' },\n    90→    });\n    91→  }\n    92→}\n    93→"}]},"parent_tool_use_id":null,"session_id":"1c91b507-8d26-43b3-bb1c-ff396945621b","uuid":"47ef8dc0-146b-4767-874a-e4dfb2306100","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/netlify/functions/notifications.ts","content":"import type { Context } from '@netlify/functions';\nimport { getSql } from './db';\n\nexport default async function handler(req: Request, _context: Context) {\n  try {\n    const authHeader = req.headers.get('Authorization');\n    if (!authHeader?.startsWith('Bearer ')) {\n      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n        status: 401,\n        headers: { 'Content-Type': 'application/json' },\n      });\n    }\n\n    const token = authHeader.slice(7);\n    const sql = getSql();\n\n    const sessions = await sql`\n      SELECT s.member_id FROM sessions s\n      WHERE s.token = ${token} AND s.expires_at > NOW()\n    `;\n    const session = sessions[0];\n    if (!session) {\n      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n        status: 401,\n        headers: { 'Content-Type': 'application/json' },\n      });\n    }\n\n    const memberId = session.member_id;\n    const url = new URL(req.url);\n    const pathParts = url.pathname.split('/').filter(Boolean);\n    // pathParts: [\"api\", \"notifications\"] or [\"api\", \"notifications\", \"<id>\", \"<action>\"]\n    const notificationId = pathParts[2];\n    const action = pathParts[3];\n\n    if (req.method === 'GET' && !notificationId) {\n      const notifications = await sql`\n        SELECT\n          n.id,\n          n.type,\n          n.issue_id,\n          n.message AS description,\n          n.read,\n          n.archived,\n          n.created_at,\n          i.identifier AS issue_identifier,\n          i.title AS issue_title\n        FROM notifications n\n        LEFT JOIN issues i ON i.id = n.issue_id\n        WHERE n.member_id = ${memberId} AND n.archived = false\n        ORDER BY n.created_at DESC\n      `;\n      return new Response(JSON.stringify({ notifications }), {\n        status: 200,\n        headers: { 'Content-Type': 'application/json' },\n      });\n    }\n\n    if (req.method === 'PUT' && notificationId && action === 'read') {\n      await sql`\n        UPDATE notifications SET read = true\n        WHERE id = ${notificationId} AND member_id = ${memberId}\n      `;\n      return new Response(JSON.stringify({ success: true }), {\n        status: 200,\n        headers: { 'Content-Type': 'application/json' },\n      });\n    }\n\n    if (req.method === 'PUT' && notificationId && action === 'archive') {\n      await sql`\n        UPDATE notifications SET archived = true\n        WHERE id = ${notificationId} AND member_id = ${memberId}\n      `;\n      return new Response(JSON.stringify({ success: true }), {\n        status: 200,\n        headers: { 'Content-Type': 'application/json' },\n      });\n    }\n\n    return new Response(JSON.stringify({ error: 'Not found' }), {\n      status: 404,\n      headers: { 'Content-Type': 'application/json' },\n    });\n  } catch (err) {\n    console.error('Notifications error:', err);\n    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n      status: 500,\n      headers: { 'Content-Type': 'application/json' },\n    });\n  }\n}\n","numLines":93,"startLine":1,"totalLines":93}}}
