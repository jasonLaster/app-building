   38→            body.pipe(socket).on('end', () => server.close());\n    39→        });\n    40→        server.on('error', (error) => {\n    41→            reject(error);\n    42→        });\n    43→        server.listen({ port: 0, host: 'localhost' }, () => {\n    44→            const address = server.address();\n    45→            if (address == null || typeof address !== 'object') {\n    46→                throw new Error('Expected server.address() to return an object');\n    47→            }\n    48→            streamPort = address.port;\n    49→            resolve(undefined);\n    50→        });\n    51→    });\n    52→}\n    53→// See TODO above.\n    54→// eslint-disable-next-line @typescript-eslint/no-unnecessary-condition\n    55→if (lambdaEvent == null) {\n    56→    parentPort?.postMessage(lambdaEvent);\n    57→}\n    58→else {\n    59→    //  Looks like some sort of eslint bug...? It thinks `streamPort` can't be null here\n    60→    //  eslint-disable-next-line @typescript-eslint/no-unnecessary-condition\n    61→    const message = { ...lambdaEvent, ...(streamPort != null ? { streamPort } : {}) };\n    62→    parentPort?.postMessage(message);\n    63→}\n    64→//# sourceMappingURL=worker.js.map"}]},"parent_tool_use_id":null,"session_id":"ac218b6b-bf51-424d-b90a-443e75c6a1b6","uuid":"6a8833c7-bf4d-4ce7-990b-baccc71a4e2f","tool_use_result":{"type":"text","file":{"filePath":"/usr/local/lib/node_modules/netlify-cli/dist/lib/functions/runtimes/js/worker.js","content":"import { createServer } from 'net';\nimport process from 'process';\nimport { isMainThread, workerData, parentPort } from 'worker_threads';\nimport { isStream } from 'is-stream';\nimport lambdaLocal from 'lambda-local';\nimport sourceMapSupport from 'source-map-support';\nif (isMainThread) {\n    throw new Error(`Do not import \"${import.meta.url}\" in the main thread.`);\n}\nsourceMapSupport.install();\nlambdaLocal.getLogger().level = 'alert';\nconst { clientContext, entryFilePath, environment = {}, event, timeoutMs } = workerData;\n// Injecting into the environment any properties passed in by the parent.\nfor (const key in environment) {\n    process.env[key] = environment[key];\n}\n// eslint-disable-next-line @typescript-eslint/no-unsafe-assignment\nconst lambdaFunc = await import(entryFilePath);\nconst lambdaEvent = await lambdaLocal.execute({\n    clientContext,\n    event,\n    lambdaFunc,\n    region: 'dev',\n    timeoutMs,\n    verboseLevel: 3,\n});\nlet streamPort = null;\n// When the result body is a StreamResponse\n// we open up a http server that proxies back to the main thread.\n// TODO(serhalp): Improve `LambdaEvent` type. It sure would be nice to keep it simple as it\n// is now, but technically this is an arbitrary type from the user function return...\n// eslint-disable-next-line @typescript-eslint/no-unnecessary-condition\nif (lambdaEvent != null && isStream(lambdaEvent.body)) {\n    const { body } = lambdaEvent;\n    delete lambdaEvent.body;\n    await new Promise((resolve, reject) => {\n        const server = createServer((socket) => {\n            body.pipe(socket).on('end', () => server.close());\n        });\n        server.on('error', (error) => {\n            reject(error);\n        });\n        server.listen({ port: 0, host: 'localhost' }, () => {\n            const address = server.address();\n            if (address == null || typeof address !== 'object') {\n                throw new Error('Expected server.address() to return an object');\n            }\n            streamPort = address.port;\n            resolve(undefined);\n        });\n    });\n}\n// See TODO above.\n// eslint-disable-next-line @typescript-eslint/no-unnecessary-condition\nif (lambdaEvent == null) {\n    parentPort?.postMessage(lambdaEvent);\n}\nelse {\n    //  Looks like some sort of eslint bug...? It thinks `streamPort` can't be null here\n    //  eslint-disable-next-line @typescript-eslint/no-unnecessary-condition\n    const message = { ...lambdaEvent, ...(streamPort != null ? { streamPort } : {}) };\n    parentPort?.postMessage(message);\n}\n//# sourceMappingURL=worker.js.map","numLines":64,"startLine":1,"totalLines":64}}}
