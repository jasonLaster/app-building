       // Give it a moment to stabilize, then check with fetch\n          try {\n            const res = await fetch('http://localhost:8888', { signal: AbortSignal.timeout(2000) })\n            if (res.ok || res.status === 200 || res.status === 304) {\n              clearInterval(check)\n              clearTimeout(timeout)\n              resolve()\n            }\n          } catch { /* not ready yet */ }\n        }\n      }, 200)\n    })\n\n    log('Server ready')\n\n    // Step 6: Remove stale recordings\n    try { execSync('npx replayio remove --all 2>/dev/null || true', { cwd: appDir, stdio: 'ignore' }) } catch { /* ignore */ }","numLines":45,"startLine":131,"totalLines":317}}}
