[2026-03-14T19:49:44.614Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01W4Ywx44xKHnSuz14EqZCs5","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions';\n     2→import { getSql } from './db';\n     3→\n     4→export default async function handler(req: Request, _context: Context) {\n     5→  if (req.method !== 'PUT') {\n     6→    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n     7→      status: 405,\n     8→      headers: { 'Content-Type': 'application/json' },\n     9→    });\n    10→  }\n    11→\n    12→  try {\n    13→    const authHeader = req.headers.get('Authorization');\n    14→    if (!authHeader?.startsWith('Bearer ')) {\n    15→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    16→        status: 401,\n    17→        headers: { 'Content-Type': 'application/json' },\n    18→      });\n    19→    }\n    20→\n    21→    const token = authHeader.slice(7);\n    22→    const sql = getSql();\n    23→\n    24→    const sessions = await sql`\n    25→      SELECT s.member_id FROM sessions s\n    26→      WHERE s.token = ${token} AND s.expires_at > NOW()\n    27→    `;\n    28→    const session = sessions[0];\n    29→    if (!session) {\n    30→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    31→        status: 401,\n    32→        headers: { 'Content-Type': 'application/json' },\n    33→      });\n    34→    }\n    35→\n    36→    const { issueId, status } = await req.json();\n    37→\n    38→    if (!issueId || !status) {\n    39→      return new Response(JSON.stringify({ error: 'issueId and status are required' }), {\n    40→        status: 400,\n    41→        headers: { 'Content-Type': 'application/json' },\n    42→      });\n    43→    }\n    44→\n    45→    const validStatuses = ['backlog', 'todo', 'in_progress', 'in_review', 'done', 'cancelled'];\n    46→    if (!validStatuses.includes(status)) {\n    47→      return new Response(JSON.stringify({ error: 'Invalid status' }), {\n    48→        status: 400,\n    49→        headers: { 'Content-Type': 'application/json' },\n    50→      });\n    51→    }\n    52→\n    53→    const updated = await sql`\n    54→      UPDATE issues SET status = ${status}, updated_at = NOW()\n    55→      WHERE id = ${issueId}\n    56→      RETURNING id, status\n    57→    `;\n    58→\n    59→    const row = updated[0];\n    60→    if (!row) {\n    61→      return new Response(JSON.stringify({ error: 'Issue not found' }), {\n    62→        status: 404,\n    63→        headers: { 'Content-Type': 'application/json' },\n    64→      });\n    65→    }\n    66→\n    67→    return new Response(JSON.stringify({ issue: { id: row.id, status: row.status } }), {\n    68→      status: 200,\n    69→      headers: { 'Content-Type': 'application/json' },\n    70→    });\n    71→  } catch (err) {\n    72→    console.error('Update issue status error:', err);\n    73→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n    74→      status: 500,\n    75→      headers: { 'Content-Type': 'application/json' },\n    76→    });\n    77→  }\n    78→}\n    79→"}]},"parent_tool_use_id":"toolu_014vB59L6L4pzEX8iMoSPVUx","session_id":"76da8815-73a4-4291-afeb-dab9c3288c7d","uuid":"02df82df-c351-41de-a85b-70d7846e4a84"}
