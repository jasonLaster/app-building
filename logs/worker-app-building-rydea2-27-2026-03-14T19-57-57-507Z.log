[2026-03-14T19:48:55.956Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EHhjf26jpMvPxQ3vFZPWek","type":"tool_result","content":"     1→import { createSlice, createAsyncThunk } from '@reduxjs/toolkit';\n     2→\n     3→export interface IssueLabel {\n     4→  id: string;\n     5→  name: string;\n     6→  color: string;\n     7→}\n     8→\n     9→export interface Issue {\n    10→  id: string;\n    11→  title: string;\n    12→  description: string;\n    13→  status: string;\n    14→  priority: string;\n    15→  identifier: string;\n    16→  number: number;\n    17→  dueDate: string | null;\n    18→  createdAt: string;\n    19→  updatedAt: string;\n    20→  teamId: string;\n    21→  teamName: string;\n    22→  assigneeId: string | null;\n    23→  assigneeName: string | null;\n    24→  assigneeEmail: string | null;\n    25→  projectId: string | null;\n    26→  projectName: string | null;\n    27→  cycleId: string | null;\n    28→  parentId: string | null;\n    29→  labels: IssueLabel[];\n    30→}\n    31→\n    32→interface IssuesState {\n    33→  myIssues: Issue[];\n    34→  loading: boolean;\n    35→  error: string | null;\n    36→}\n    37→\n    38→const initialState: IssuesState = {\n    39→  myIssues: [],\n    40→  loading: false,\n    41→  error: null,\n    42→};\n    43→\n    44→export const fetchMyIssues = createAsyncThunk(\n    45→  'issues/fetchMyIssues',\n    46→  async (_, { getState, rejectWithValue }) => {\n    47→    const state = getState() as { auth: { token: string | null } };\n    48→    const token = state.auth.token;\n    49→    if (!token) return rejectWithValue('No token');\n    50→    const response = await fetch('/api/my-issues', {\n    51→      headers: { Authorization: `Bearer ${token}` },\n    52→    });\n    53→    if (!response.ok) {\n    54→      return rejectWithValue('Failed to fetch issues');\n    55→    }\n    56→    const data = await response.json();\n    57→    return data.issues as Issue[];\n    58→  }\n    59→);\n    60→\n    61→export interface CreateIssuePayload {\n    62→  teamId: string;\n    63→  title: string;\n    64→  description: string;\n    65→  status: string;\n    66→  priority: string;\n    67→  assigneeId: string | null;\n    68→  labelIds: string[];\n    69→  projectId: string | null;\n    70→  cycleId: string | null;\n    71→  dueDate: string | null;\n    72→  parentId: string | null;\n    73→}\n    74→\n    75→export const createIssue = createAsyncThunk(\n    76→  'issues/createIssue',\n    77→  async (payload: CreateIssuePayload, { getState, rejectWithValue }) => {\n    78→    const state = getState() as { auth: { token: string | null } };\n    79→    const token = state.auth.token;\n    80→    if (!token) return rejectWithValue('No token');\n    81→    const response = await fetch('/api/create-issue', {\n    82→      method: 'POST',\n    83→      headers: {\n    84→        'Content-Type': 'application/json',\n    85→        Authorization: `Bearer ${token}`,\n    86→      },\n    87→      body: JSON.stringify(payload),\n    88→    });\n    89→    if (!response.ok) {\n    90→      return rejectWithValue('Failed to create issue');\n    91→    }\n    92→    const data = await response.json();\n    93→    return data.issue as Issue;\n    94→  }\n    95→);\n    96→\n    97→export const updateIssueStatus = createAsyncThunk(\n    98→  'issues/updateIssueStatus',\n    99→  async ({ issueId, status }: { issueId: string; status: string }, { getState, rejectWithValue }) => {\n   100→    const state = getState() as { auth: { token: string | null } };\n   101→    const token = state.auth.token;\n   102→    if (!token) return rejectWithValue('No token');\n   103→    const response = await fetch('/api/update-issue-status', {\n   104→      method: 'PUT',\n   105→      headers: {\n   106→        'Content-Type': 'application/json',\n   107→        Authorization: `Bearer ${token}`,\n   108→      },\n   109→      body: JSON.stringify({ issueId, status }),\n   110→    });\n   111→    if (!response.ok) {\n   112→      return rejectWithValue('Failed to update status');\n   113→    }\n   114→    const data = await response.json();\n   115→    return { issueId, status: data.issue.status as string };\n   116→  }\n   117→);\n   118→\n   119→const issuesSlice = createSlice({\n   120→  name: 'issues',\n   121→  initialState,\n   122→  reducers: {},\n   123→  extraReducers: (builder) => {\n   124→    builder\n   125→      .addCase(fetchMyIssues.pending, (state) => {\n   126→        if (state.myIssues.length === 0) {\n   127→          state.loading = true;\n   128→        }\n   129→        state.error = null;\n   130→      })\n   131→      .addCase(fetchMyIssues.fulfilled, (state, action) => {\n   132→        state.loading = false;\n   133→        state.myIssues = action.payload;\n   134→      })\n   135→      .addCase(fetchMyIssues.rejected, (state, action) => {\n   136→        state.loading = false;\n   137→        state.error = action.payload as string;\n   138→      })\n   139→      .addCase(createIssue.fulfilled, (state, action) => {\n   140→        state.myIssues.unshift(action.payload);\n   141→      })\n   142→      .addCase(updateIssueStatus.fulfilled, (state, action) => {\n   143→        const { issueId, status } = action.payload;\n   144→        const issue = state.myIssues.find((i) => i.id === issueId);\n   145→        if (issue) {\n   146→          issue.status = status;\n   147→        }\n   148→      });\n   149→  },\n   150→});\n   151→\n   152→export default issuesSlice.reducer;\n   153→"}]},"parent_tool_use_id":"toolu_014vB59L6L4pzEX8iMoSPVUx","session_id":"76da8815-73a4-4291-afeb-dab9c3288c7d","uuid":"fa16e53e-9274-4857-a6a9-44bae125dccd"}
