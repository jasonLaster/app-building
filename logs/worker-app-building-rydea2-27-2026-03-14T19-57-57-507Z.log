);\n  background-color: rgba(94, 106, 210, 0.15);\n  padding: 1px 8px;\n  border-radius: 10px;\n  white-space: nowrap;\n  flex-shrink: 0;\n}\n\n.cycle-list-meta {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding-left: 24px;\n}\n\n.cycle-list-dates {\n  font-size: 12px;\n  color: var(--color-text-tertiary);\n  white-space: nowrap;\n}\n\n.cycle-list-issue-count {\n  font-size: 12px;\n  color: var(--color-text-tertiary);\n  white-space: nowrap;\n}\n\n.cycle-list-row-right {\n  flex-shrink: 0;\n}\n\n.cycle-list-progress-wrapper {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.cycle-list-progress-bar {\n  width: 100px;\n  height: 6px;\n  background-color: var(--color-border);\n  border-radius: 3px;\n  overflow: hidden;\n}\n\n.cycle-list-progress-fill {\n  height: 100%;\n  background-color: var(--color-accent);\n  border-radius: 3px;\n  transition: width 300ms ease;\n}\n\n.cycle-list-progress-text {\n  font-size: 12px;\n  color: var(--color-text-tertiary);\n  font-variant-numeric: tabular-nums;\n  min-width: 32px;\n  text-align: right;\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1432,"cache_read_input_tokens":87985,"cache_creation":{"ephemeral_5m_input_tokens":1432,"ephemeral_1h_input_tokens":0},"output_tokens":25,"service_tier":"standard","inference_geo":"global"},"context_management":null},"parent_tool_use_id":null,"session_id":"76da8815-73a4-4291-afeb-dab9c3288c7d","uuid":"b9aa8367-859d-4599-8495-6334209f7921"}
