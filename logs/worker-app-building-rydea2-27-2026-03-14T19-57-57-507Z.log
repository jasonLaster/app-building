n.team-issues-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 4px;\n}\n\n.team-issues-header-left {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.team-issues-title {\n  font-size: 20px;\n  font-weight: 600;\n  color: var(--color-text-primary);\n  margin: 0;\n}\n\n.team-issues-new-btn {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: 6px 14px;\n  background-color: var(--color-accent);\n  color: #fff;\n  border: none;\n  border-radius: 6px;\n  font-size: 13px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: background-color 150ms ease;\n  white-space: nowrap;\n}\n\n.team-issues-new-btn:hover {\n  background-color: #4f5bc4;\n}\n\n.team-issues-toolbar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  flex-wrap: wrap;\n}\n","numLines":60,"startLine":1,"totalLines":60}}}
