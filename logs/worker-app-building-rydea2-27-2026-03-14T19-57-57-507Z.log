[2026-03-14T19:49:30.727Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HfNj6R54uVYspgrDmyCUbD","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions';\n     2→import { getSql } from './db';\n     3→\n     4→export default async function handler(req: Request, _context: Context) {\n     5→  if (req.method !== 'POST') {\n     6→    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n     7→      status: 405,\n     8→      headers: { 'Content-Type': 'application/json' },\n     9→    });\n    10→  }\n    11→\n    12→  try {\n    13→    const authHeader = req.headers.get('Authorization');\n    14→    if (!authHeader?.startsWith('Bearer ')) {\n    15→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    16→        status: 401,\n    17→        headers: { 'Content-Type': 'application/json' },\n    18→      });\n    19→    }\n    20→\n    21→    const token = authHeader.slice(7);\n    22→    const sql = getSql();\n    23→\n    24→    const sessions = await sql`\n    25→      SELECT s.member_id FROM sessions s\n    26→      WHERE s.token = ${token} AND s.expires_at > NOW()\n    27→    `;\n    28→    const session = sessions[0];\n    29→    if (!session) {\n    30→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    31→        status: 401,\n    32→        headers: { 'Content-Type': 'application/json' },\n    33→      });\n    34→    }\n    35→\n    36→    const { issueId, content } = await req.json();\n    37→\n    38→    if (!issueId || !content) {\n    39→      return new Response(JSON.stringify({ error: 'issueId and content are required' }), {\n    40→        status: 400,\n    41→        headers: { 'Content-Type': 'application/json' },\n    42→      });\n    43→    }\n    44→\n    45→    // Insert the comment\n    46→    const insertResult = await sql`\n    47→      INSERT INTO comments (issue_id, member_id, content, created_at)\n    48→      VALUES (${issueId}, ${session.member_id}, ${content}, NOW())\n    49→      RETURNING id, created_at\n    50→    `;\n    51→    const newComment = insertResult[0];\n    52→    if (!newComment) {\n    53→      return new Response(JSON.stringify({ error: 'Failed to create comment' }), {\n    54→        status: 500,\n    55→        headers: { 'Content-Type': 'application/json' },\n    56→      });\n    57→    }\n    58→\n    59→    // Create activity entry\n    60→    await sql`\n    61→      INSERT INTO activity (issue_id, member_id, action, created_at)\n    62→      VALUES (${issueId}, ${session.member_id}, 'added a comment', NOW())\n    63→    `;\n    64→\n    65→    // Update issue updated_at\n    66→    await sql`UPDATE issues SET updated_at = NOW() WHERE id = ${issueId}`;\n    67→\n    68→    // Get the commenter info\n    69→    const memberRows = await sql`SELECT name, email FROM members WHERE id = ${session.member_id}`;\n    70→    const member = memberRows[0];\n    71→\n    72→    // Create notification for issue assignee (if different from commenter)\n    73→    const issueRows = await sql`\n    74→      SELECT i.assignee_id, i.title, i.number, t.identifier\n    75→      FROM issues i JOIN teams t ON t.id = i.team_id\n    76→      WHERE i.id = ${issueId}\n    77→    `;\n    78→    const issue = issueRows[0];\n    79→    if (issue && issue.assignee_id && issue.assignee_id !== session.member_id) {\n    80→      const commenterName = member ? String(member.name) : 'Someone';\n    81→      const identifier = `${issue.identifier}-${issue.number}`;\n    82→      await sql`\n    83→        INSERT INTO notifications (member_id, type, message, issue_id, created_at)\n    84→        VALUES (${issue.assignee_id}, 'comment', ${`${commenterName} commented on ${identifier}: ${issue.title}`}, ${issueId}, NOW())\n    85→      `;\n    86→    }\n    87→\n    88→    return new Response(JSON.stringify({\n    89→      comment: {\n    90→        id: newComment.id,\n    91→        content,\n    92→        createdAt: newComment.created_at,\n    93→        memberId: session.member_id,\n    94→        memberName: member ? String(member.name) : null,\n    95→        memberEmail: member ? String(member.email) : null,\n    96→      },\n    97→    }), {\n    98→      status: 201,\n    99→      headers: { 'Content-Type': 'application/json' },\n   100→    });\n   101→  } catch (err) {\n   102→    console.error('Add comment error:', err);\n   103→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n   104→      status: 500,\n   105→      headers: { 'Content-Type': 'application/json' },\n   106→    });\n   107→  }\n   108→}\n   109→"}]},"parent_tool_use_id":"toolu_014vB59L6L4pzEX8iMoSPVUx","session_id":"76da8815-73a4-4291-afeb-dab9c3288c7d","uuid":"b80bddb2-df74-408f-b920-931acfaefd6b"}
