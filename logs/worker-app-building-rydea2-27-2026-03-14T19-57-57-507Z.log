[2026-03-14T19:49:23.771Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016TxLuTMPs7quBRE3FkNEho","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions';\n     2→import { getSql } from './db';\n     3→\n     4→export default async function handler(req: Request, _context: Context) {\n     5→  if (req.method !== 'GET') {\n     6→    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n     7→      status: 405,\n     8→      headers: { 'Content-Type': 'application/json' },\n     9→    });\n    10→  }\n    11→\n    12→  try {\n    13→    const authHeader = req.headers.get('Authorization');\n    14→    if (!authHeader?.startsWith('Bearer ')) {\n    15→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    16→        status: 401,\n    17→        headers: { 'Content-Type': 'application/json' },\n    18→      });\n    19→    }\n    20→\n    21→    const token = authHeader.slice(7);\n    22→    const sql = getSql();\n    23→\n    24→    const sessions = await sql`\n    25→      SELECT s.member_id FROM sessions s\n    26→      WHERE s.token = ${token} AND s.expires_at > NOW()\n    27→    `;\n    28→    const session = sessions[0];\n    29→    if (!session) {\n    30→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    31→        status: 401,\n    32→        headers: { 'Content-Type': 'application/json' },\n    33→      });\n    34→    }\n    35→\n    36→    const memberId = session.member_id;\n    37→\n    38→    const issues = await sql`\n    39→      SELECT\n    40→        i.id,\n    41→        i.title,\n    42→        i.description,\n    43→        i.status,\n    44→        i.priority,\n    45→        i.number,\n    46→        i.due_date,\n    47→        i.created_at,\n    48→        i.updated_at,\n    49→        i.team_id,\n    50→        i.assignee_id,\n    51→        i.project_id,\n    52→        i.cycle_id,\n    53→        i.parent_id,\n    54→        t.identifier AS team_identifier,\n    55→        t.name AS team_name,\n    56→        p.name AS project_name,\n    57→        m.name AS assignee_name,\n    58→        m.email AS assignee_email\n    59→      FROM issues i\n    60→      JOIN teams t ON t.id = i.team_id\n    61→      LEFT JOIN projects p ON p.id = i.project_id\n    62→      LEFT JOIN members m ON m.id = i.assignee_id\n    63→      WHERE i.assignee_id = ${memberId}\n    64→      ORDER BY i.created_at DESC\n    65→    `;\n    66→\n    67→    const issueIds = issues.map((i) => i.id);\n    68→\n    69→    let issueLabels: Array<{ issue_id: string; label_id: string; label_name: string; label_color: string }> = [];\n    70→    if (issueIds.length > 0) {\n    71→      issueLabels = await sql`\n    72→        SELECT il.issue_id, l.id AS label_id, l.name AS label_name, l.color AS label_color\n    73→        FROM issue_labels il\n    74→        JOIN labels l ON l.id = il.label_id\n    75→        WHERE il.issue_id = ANY(${issueIds})\n    76→      `;\n    77→    }\n    78→\n    79→    const labelsByIssue: Record<string, Array<{ id: string; name: string; color: string }>> = {};\n    80→    for (const il of issueLabels) {\n    81→      if (!labelsByIssue[il.issue_id]) {\n    82→        labelsByIssue[il.issue_id] = [];\n    83→      }\n    84→      labelsByIssue[il.issue_id].push({\n    85→        id: il.label_id,\n    86→        name: il.label_name,\n    87→        color: il.label_color,\n    88→      });\n    89→    }\n    90→\n    91→    const enrichedIssues = issues.map((issue) => ({\n    92→      id: issue.id,\n    93→      title: issue.title,\n    94→      description: issue.description,\n    95→      status: issue.status,\n    96→      priority: issue.priority,\n    97→      identifier: `${issue.team_identifier}-${issue.number}`,\n    98→      number: issue.number,\n    99→      dueDate: issue.due_date ? String(issue.due_date).split('T')[0] : null,\n   100→      createdAt: issue.created_at,\n   101→      updatedAt: issue.updated_at,\n   102→      teamId: issue.team_id,\n   103→      teamName: issue.team_name,\n   104→      assigneeId: issue.assignee_id,\n   105→      assigneeName: issue.assignee_name,\n   106→      assigneeEmail: issue.assignee_email,\n   107→      projectId: issue.project_id,\n   108→      projectName: issue.project_name,\n   109→      cycleId: issue.cycle_id,\n   110→      parentId: issue.parent_id,\n   111→      labels: labelsByIssue[issue.id] || [],\n   112→    }));\n   113→\n   114→    return new Response(JSON.stringify({ issues: enrichedIssues }), {\n   115→      status: 200,\n   116→      headers: { 'Content-Type': 'application/json' },\n   117→    });\n   118→  } catch (err) {\n   119→    console.error('Fetch my issues error:', err);\n   120→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n   121→      status: 500,\n   122→      headers: { 'Content-Type': 'application/json' },\n   123→    });\n   124→  }\n   125→}\n   126→"}]},"parent_tool_use_id":"toolu_014vB59L6L4pzEX8iMoSPVUx","session_id":"76da8815-73a4-4291-afeb-dab9c3288c7d","uuid":"67f5f970-1d6d-46fb-a5dd-3adf857a6226"}
