[2026-03-14T19:49:13.814Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012hWxc8H1oJj2tz9dDrTeZr","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions';\n     2→import { getSql } from './db';\n     3→\n     4→export default async function handler(req: Request, _context: Context) {\n     5→  if (req.method !== 'PUT') {\n     6→    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n     7→      status: 405,\n     8→      headers: { 'Content-Type': 'application/json' },\n     9→    });\n    10→  }\n    11→\n    12→  try {\n    13→    const authHeader = req.headers.get('Authorization');\n    14→    if (!authHeader?.startsWith('Bearer ')) {\n    15→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    16→        status: 401,\n    17→        headers: { 'Content-Type': 'application/json' },\n    18→      });\n    19→    }\n    20→\n    21→    const token = authHeader.slice(7);\n    22→    const sql = getSql();\n    23→\n    24→    const sessions = await sql`\n    25→      SELECT s.member_id FROM sessions s\n    26→      WHERE s.token = ${token} AND s.expires_at > NOW()\n    27→    `;\n    28→    const session = sessions[0];\n    29→    if (!session) {\n    30→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    31→        status: 401,\n    32→        headers: { 'Content-Type': 'application/json' },\n    33→      });\n    34→    }\n    35→\n    36→    const body = await req.json();\n    37→    const { issueId, field, value, labelIds } = body;\n    38→\n    39→    if (!issueId || !field) {\n    40→      return new Response(JSON.stringify({ error: 'issueId and field are required' }), {\n    41→        status: 400,\n    42→        headers: { 'Content-Type': 'application/json' },\n    43→      });\n    44→    }\n    45→\n    46→    // Get current issue state for activity logging\n    47→    const currentRows = await sql`\n    48→      SELECT i.*, t.identifier AS team_identifier, m.name AS assignee_name\n    49→      FROM issues i\n    50→      JOIN teams t ON t.id = i.team_id\n    51→      LEFT JOIN members m ON m.id = i.assignee_id\n    52→      WHERE i.id = ${issueId}\n    53→    `;\n    54→    const current = currentRows[0];\n    55→    if (!current) {\n    56→      return new Response(JSON.stringify({ error: 'Issue not found' }), {\n    57→        status: 404,\n    58→        headers: { 'Content-Type': 'application/json' },\n    59→      });\n    60→    }\n    61→\n    62→    const STATUS_LABELS: Record<string, string> = {\n    63→      backlog: 'Backlog',\n    64→      todo: 'Todo',\n    65→      in_progress: 'In Progress',\n    66→      in_review: 'In Review',\n    67→      done: 'Done',\n    68→      cancelled: 'Cancelled',\n    69→    };\n    70→\n    71→    const PRIORITY_LABELS: Record<string, string> = {\n    72→      urgent: 'Urgent',\n    73→      high: 'High',\n    74→      medium: 'Medium',\n    75→      low: 'Low',\n    76→      none: 'No Priority',\n    77→    };\n    78→\n    79→    let activityAction = '';\n    80→\n    81→    if (field === 'title') {\n    82→      await sql`UPDATE issues SET title = ${value}, updated_at = NOW() WHERE id = ${issueId}`;\n    83→      activityAction = `changed title from \"${current.title}\" to \"${value}\"`;\n    84→    } else if (field === 'description') {\n    85→      await sql`UPDATE issues SET description = ${value}, updated_at = NOW() WHERE id = ${issueId}`;\n    86→      activityAction = 'updated the description';\n    87→    } else if (field === 'status') {\n    88→      await sql`UPDATE issues SET status = ${value}, updated_at = NOW() WHERE id = ${issueId}`;\n    89→      const oldLabel = STATUS_LABELS[String(current.status)] || current.status;\n    90→      const newLabel = STATUS_LABELS[String(value)] || value;\n    91→      activityAction = `changed status from ${oldLabel} to ${newLabel}`;\n    92→    } else if (field === 'priority') {\n    93→      await sql`UPDATE issues SET priority = ${value}, updated_at = NOW() WHERE id = ${issueId}`;\n    94→      const oldLabel = PRIORITY_LABELS[String(current.priority)] || current.priority;\n    95→      const newLabel = PRIORITY_LABELS[String(value)] || value;\n    96→      activityAction = `changed priority from ${oldLabel} to ${newLabel}`;\n    97→    } else if (field === 'assigneeId') {\n    98→      const assigneeVal = value || null;\n    99→      await sql`UPDATE issues SET assignee_id = ${assigneeVal}, updated_at = NOW() WHERE id = ${issueId}`;\n   100→      if (assigneeVal) {\n   101→        const aRows = await sql`SELECT name FROM members WHERE id = ${assigneeVal}`;\n   102→        const aRow = aRows[0];\n   103→        const newName = aRow ? String(aRow.name) : 'someone';\n   104→        if (current.assignee_id) {\n   105→          activityAction = `changed assignee from ${current.assignee_name || 'unknown'} to ${newName}`;\n   106→        } else {\n   107→          activityAction = `assigned to ${newName}`;\n   108→        }\n   109→        // Notify new assignee\n   110→        if (assigneeVal !== session.member_id) {\n   111→          const creatorRows = await sql`SELECT name FROM members WHERE id = ${session.member_id}`;\n   112→          const creator = creatorRows[0];\n   113→          const creatorName = creator ? String(creator.name) : 'Someone';\n   114→          const identifier = `${current.team_identifier}-${current.number}`;\n   115→          await sql`\n   116→            INSERT INTO notifications (member_id, type, message, issue_id, created_at)\n   117→            VALUES (${assigneeVal}, 'assigned', ${`${creatorName} assigned you to ${identifier}: ${current.title}`}, ${issueId}, NOW())\n   118→          `;\n   119→        }\n   120→      } else {\n   121→        activityAction = `removed assignee ${current.assignee_name || ''}`;\n   122→      }\n   123→    } else if (field === 'projectId') {\n   124→      const projectVal = value || null;\n   125→      await sql`UPDATE issues SET project_id = ${projectVal}, updated_at = NOW() WHERE id = ${issueId}`;\n   126→      if (projectVal) {\n   127→        const pRows = await sql`SELECT name FROM projects WHERE id = ${projectVal}`;\n   128→        const pRow = pRows[0];\n   129→        activityAction = `set project to ${pRow ? String(pRow.name) : 'unknown'}`;\n   130→      } else {\n   131→        activityAction = 'removed project';\n   132→      }\n   133→    } else if (field === 'cycleId') {\n   134→      const cycleVal = value || null;\n   135→      await sql`UPDATE issues SET cycle_id = ${cycleVal}, updated_at = NOW() WHERE id = ${issueId}`;\n   136→      if (cycleVal) {\n   137→        const cRows = await sql`SELECT name FROM cycles WHERE id = ${cycleVal}`;\n   138→        const cRow = cRows[0];\n   139→        activityAction = `set cycle to ${cRow ? String(cRow.name) : 'unknown'}`;\n   140→      } else {\n   141→        activityAction = 'removed cycle';\n   142→      }\n   143→    } else if (field === 'dueDate') {\n   144→      const dateVal = value || null;\n   145→      await sql`UPDATE issues SET due_date = ${dateVal}, updated_at = NOW() WHERE id = ${issueId}`;\n   146→      if (dateVal) {\n   147→        activityAction = `set due date to ${value}`;\n   148→      } else {\n   149→        activityAction = 'removed due date';\n   150→      }\n   151→    } else if (field === 'labels') {\n   152→      // Handle labels update - delete all and re-insert\n   153→      await sql`DELETE FROM issue_labels WHERE issue_id = ${issueId}`;\n   154→      if (labelIds && Array.isArray(labelIds) && labelIds.length > 0) {\n   155→        for (const labelId of labelIds) {\n   156→          await sql`INSERT INTO issue_labels (issue_id, label_id) VALUES (${issueId}, ${labelId})`;\n   157→        }\n   158→      }\n   159→      await sql`UPDATE issues SET updated_at = NOW() WHERE id = ${issueId}`;\n   160→      activityAction = 'updated labels';\n   161→    } else {\n   162→      return new Response(JSON.stringify({ error: 'Invalid field' }), {\n   163→        status: 400,\n   164→        headers: { 'Content-Type': 'application/json' },\n   165→      });\n   166→    }\n   167→\n   168→    // Create activity entry\n   169→    if (activityAction) {\n   170→      await sql`\n   171→        INSERT INTO activity (issue_id, member_id, action, created_at)\n   172→        VALUES (${issueId}, ${session.member_id}, ${activityAction}, NOW())\n   173→      `;\n   174→    }\n   175→\n   176→    // Fetch updated issue\n   177→    const updatedRows = await sql`\n   178→      SELECT\n   179→        i.id, i.title, i.description, i.status, i.priority, i.number,\n   180→        i.due_date, i.created_at, i.updated_at, i.team_id, i.assignee_id,\n   181→        i.project_id, i.cycle_id, i.parent_id,\n   182→        t.identifier AS team_identifier, t.name AS team_name,\n   183→        p.name AS project_name, m.name AS assignee_name, m.email AS assignee_email,\n   184→        cy.name AS cycle_name\n   185→      FROM issues i\n   186→      JOIN teams t ON t.id = i.team_id\n   187→      LEFT JOIN projects p ON p.id = i.project_id\n   188→      LEFT JOIN members m ON m.id = i.assignee_id\n   189→      LEFT JOIN cycles cy ON cy.id = i.cycle_id\n   190→      WHERE i.id = ${issueId}\n   191→    `;\n   192→    const updated = updatedRows[0];\n   193→    if (!updated) {\n   194→      return new Response(JSON.stringify({ error: 'Issue not found after update' }), {\n   195→        status: 500,\n   196→        headers: { 'Content-Type': 'application/json' },\n   197→      });\n   198→    }\n   199→\n   200→    const updatedLabels = await sql`\n   201→      SELECT l.id, l.name, l.color FROM issue_labels il JOIN labels l ON l.id = il.label_id WHERE il.issue_id = ${issueId}\n   202→    `;\n   203→\n   204→    // Get newest activity entry for response\n   205→    const latestActivity = await sql`\n   206→      SELECT a.id, a.action, a.created_at, a.member_id, m.name AS member_name, m.email AS member_email\n   207→      FROM activity a\n   208→      LEFT JOIN members m ON m.id = a.member_id\n   209→      WHERE a.issue_id = ${issueId}\n   210→      ORDER BY a.created_at DESC\n   211→      LIMIT 1\n   212→    `;\n   213→\n   214→    const enrichedIssue = {\n   215→      id: updated.id,\n   216→      title: updated.title,\n   217→      description: updated.description || '',\n   218→      status: updated.status,\n   219→      priority: updated.priority,\n   220→      identifier: `${updated.team_identifier}-${updated.number}`,\n   221→      number: updated.number,\n   222→      dueDate: updated.due_date ? String(updated.due_date).split('T')[0] : null,\n   223→      createdAt: updated.created_at,\n   224→      updatedAt: updated.updated_at,\n   225→      teamId: updated.team_id,\n   226→      teamName: updated.team_name,\n   227→      assigneeId: updated.assignee_id,\n   228→      assigneeName: updated.assignee_name,\n   229→      assigneeEmail: updated.assignee_email,\n   230→      projectId: updated.project_id,\n   231→      projectName: updated.project_name,\n   232→      cycleId: updated.cycle_id,\n   233→      cycleName: updated.cycle_name,\n   234→      parentId: updated.parent_id,\n   235→      labels: updatedLabels.map((l) => ({ id: String(l.id), name: String(l.name), color: String(l.color) })),\n   236→    };\n   237→\n   238→    const latestActivityEntry = latestActivity[0];\n   239→    const activityEntry = latestActivityEntry ? {\n   240→      id: latestActivityEntry.id,\n   241→      action: latestActivityEntry.action,\n   242→      createdAt: latestActivityEntry.created_at,\n   243→      memberId: latestActivityEntry.member_id,\n   244→      memberName: latestActivityEntry.member_name,\n   245→      memberEmail: latestActivityEntry.member_email,\n   246→    } : null;\n   247→\n   248→    return new Response(JSON.stringify({ issue: enrichedIssue, activity: activityEntry }), {\n   249→      status: 200,\n   250→      headers: { 'Content-Type': 'application/json' },\n   251→    });\n   252→  } catch (err) {\n   253→    console.error('Update issue error:', err);\n   254→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n   255→      status: 500,\n   256→      headers: { 'Content-Type': 'application/json' },\n   257→    });\n   258→  }\n   259→}\n   260→"}]},"parent_tool_use_id":"toolu_014vB59L6L4pzEX8iMoSPVUx","session_id":"76da8815-73a4-4291-afeb-dab9c3288c7d","uuid":"8773f2e4-db0e-425a-8bdd-9f39a3e6f064"}
