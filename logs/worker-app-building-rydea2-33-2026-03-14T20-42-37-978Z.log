00px;\n  overflow-y: auto;\n}\n\n.ws-dropdown-option {\n  display: block;\n  width: 100%;\n  padding: 8px 12px;\n  border: none;\n  background: none;\n  color: var(--color-text-primary);\n  font-size: 13px;\n  cursor: pointer;\n  text-align: left;\n  transition: background-color 100ms ease;\n}\n\n.ws-dropdown-option:hover {\n  background-color: var(--color-bg-hover);\n}\n\n.ws-dropdown-option-active {\n  background-color: rgba(94, 106, 210, 0.1);\n  color: var(--color-accent);\n}\n\n.ws-actions {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.ws-save-btn {\n  padding: 8px 20px;\n  border: none;\n  border-radius: 6px;\n  background-color: var(--color-accent);\n  color: #fff;\n  font-size: 13px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: opacity 150ms ease;\n}\n\n.ws-save-btn:hover {\n  opacity: 0.9;\n}\n\n.ws-save-btn:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.ws-success {\n  font-size: 13px;\n  color: #22c55e;\n  font-weight: 500;\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1938,"cache_read_input_tokens":63634,"cache_creation":{"ephemeral_5m_input_tokens":1938,"ephemeral_1h_input_tokens":0},"output_tokens":24,"service_tier":"standard","inference_geo":"global"},"context_management":null},"parent_tool_use_id":null,"session_id":"9ab25009-980f-40f8-a022-3d9ee277d1c2","uuid":"85895b4c-334c-47f5-8bf7-7b679ae392bf"}
