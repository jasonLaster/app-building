[2026-03-14T20:39:54.282Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01P4QaW3fahcGdrUdtJ8ghhL","type":"tool_result","content":"     1→import { useState, useEffect, useRef } from 'react';\n     2→import { useSelector, useDispatch } from 'react-redux';\n     3→import type { RootState, AppDispatch } from '../store';\n     4→import {\n     5→  fetchTeamDetail,\n     6→  updateTeam,\n     7→  deleteTeam,\n     8→  addTeamMember,\n     9→  removeTeamMember,\n    10→  clearTeamDetail,\n    11→  fetchTeams,\n    12→} from '../slices/teamsSlice';\n    13→import './TeamSettings.css';\n    14→\n    15→interface TeamSettingsProps {\n    16→  teamId: string;\n    17→  onBack: () => void;\n    18→}\n    19→\n    20→function getInitials(name: string): string {\n    21→  return name.split(' ').map((n) => n[0]).join('').toUpperCase().slice(0, 2);\n    22→}\n    23→\n    24→export default function TeamSettings({ teamId, onBack }: TeamSettingsProps) {\n    25→  const dispatch = useDispatch<AppDispatch>();\n    26→  const { selectedTeam, teamMembers, availableMembers, detailLoading } = useSelector(\n    27→    (state: RootState) => state.teams\n    28→  );\n    29→\n    30→  const [editingName, setEditingName] = useState(false);\n    31→  const [editingIdentifier, setEditingIdentifier] = useState(false);\n    32→  const [editingDescription, setEditingDescription] = useState(false);\n    33→  const [nameValue, setNameValue] = useState('');\n    34→  const [identifierValue, setIdentifierValue] = useState('');\n    35→  const [descriptionValue, setDescriptionValue] = useState('');\n    36→  const [nameError, setNameError] = useState<string | null>(null);\n    37→  const [identifierError, setIdentifierError] = useState<string | null>(null);\n    38→  const [showDeleteConfirm, setShowDeleteConfirm] = useState(false);\n    39→  const [showAddMember, setShowAddMember] = useState(false);\n    40→  const [removingMemberId, setRemovingMemberId] = useState<string | null>(null);\n    41→\n    42→  const nameInputRef = useRef<HTMLInputElement>(null);\n    43→  const identifierInputRef = useRef<HTMLInputElement>(null);\n    44→  const descriptionInputRef = useRef<HTMLTextAreaElement>(null);\n    45→\n    46→  useEffect(() => {\n    47→    dispatch(fetchTeamDetail(teamId));\n    48→    return () => {\n    49→      dispatch(clearTeamDetail());\n    50→    };\n    51→  }, [dispatch, teamId]);\n    52→\n    53→  useEffect(() => {\n    54→    if (selectedTeam) {\n    55→      setNameValue(selectedTeam.name);\n    56→      setIdentifierValue(selectedTeam.identifier);\n    57→      setDescriptionValue(selectedTeam.description);\n    58→    }\n    59→  }, [selectedTeam]);\n    60→\n    61→  useEffect(() => {\n    62→    if (editingName) {\n    63→      nameInputRef.current?.focus();\n    64→      nameInputRef.current?.select();\n    65→    }\n    66→  }, [editingName]);\n    67→\n    68→  useEffect(() => {\n    69→    if (editingIdentifier) {\n    70→      identifierInputRef.current?.focus();\n    71→      identifierInputRef.current?.select();\n    72→    }\n    73→  }, [editingIdentifier]);\n    74→\n    75→  useEffect(() => {\n    76→    if (editingDescription) {\n    77→      descriptionInputRef.current?.focus();\n    78→    }\n    79→  }, [editingDescription]);\n    80→\n    81→  async function saveNameField() {\n    82→    if (!nameValue.trim()) {\n    83→      setNameError('Team name cannot be empty');\n    84→      return;\n    85→    }\n    86→    setNameError(null);\n    87→    if (nameValue.trim() !== selectedTeam?.name) {\n    88→      const result = await dispatch(updateTeam({ teamId, name: nameValue.trim() }));\n    89→      if (updateTeam.rejected.match(result)) {\n    90→        setNameError(result.payload as string);\n    91→        return;\n    92→      }\n    93→      dispatch(fetchTeams());\n    94→    }\n    95→    setEditingName(false);\n    96→  }\n    97→\n    98→  async function saveIdentifierField() {\n    99→    const upper = identifierValue.toUpperCase();\n   100→    if (upper.length < 2 || upper.length > 5) {\n   101→      setIdentifierError('Identifier prefix must be 2-5 uppercase characters');\n   102→      return;\n   103→    }\n   104→    setIdentifierError(null);\n   105→    if (upper !== selectedTeam?.identifier) {\n   106→      const result = await dispatch(updateTeam({ teamId, identifier: upper }));\n   107→      if (updateTeam.rejected.match(result)) {\n   108→        setIdentifierError(result.payload as string);\n   109→        return;\n   110→      }\n   111→      dispatch(fetchTeams());\n   112→    }\n   113→    setEditingIdentifier(false);\n   114→  }\n   115→\n   116→  async function saveDescriptionField() {\n   117→    if (descriptionValue !== selectedTeam?.description) {\n   118→      await dispatch(updateTeam({ teamId, description: descriptionValue }));\n   119→      dispatch(fetchTeams());\n   120→    }\n   121→    setEditingDescription(false);\n   122→  }\n   123→\n   124→  function cancelNameEdit() {\n   125→    setNameValue(selectedTeam?.name || '');\n   126→    setNameError(null);\n   127→    setEditingName(false);\n   128→  }\n   129→\n   130→  function cancelIdentifierEdit() {\n   131→    setIdentifierValue(selectedTeam?.identifier || '');\n   132→    setIdentifierError(null);\n   133→    setEditingIdentifier(false);\n   134→  }\n   135→\n   136→  function cancelDescriptionEdit() {\n   137→    setDescriptionValue(selectedTeam?.description || '');\n   138→    setEditingDescription(false);\n   139→  }\n   140→\n   141→  async function handleDeleteTeam() {\n   142→    await dispatch(deleteTeam(teamId));\n   143→    dispatch(fetchTeams());\n   144→    onBack();\n   145→  }\n   146→\n   147→  async function handleAddMember(memberIdToAdd: string) {\n   148→    await dispatch(addTeamMember({ teamId, memberIdToAdd }));\n   149→    setShowAddMember(false);\n   150→  }\n   151→\n   152→  async function handleRemoveMember(memberIdToRemove: string) {\n   153→    await dispatch(removeTeamMember({ teamId, memberIdToRemove }));\n   154→    setRemovingMemberId(null);\n   155→  }\n   156→\n   157→  if (detailLoading || !selectedTeam) {\n   158→    return (\n   159→      <div className=\"team-settings\" data-testid=\"team-settings\">\n   160→        <div className=\"ts-loading\">Loading...</div>\n   161→      </div>\n   162→    );\n   163→  }\n   164→\n   165→  return (\n   166→    <div className=\"team-settings\" data-testid=\"team-settings\">\n   167→      <div className=\"ts-top-bar\">\n   168→        <button\n   169→          className=\"ts-back-btn\"\n   170→          onClick={onBack}\n   171→          data-testid=\"team-settings-back-btn\"\n   172→        >\n   173→          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n   174→            <polyline points=\"15 18 9 12 15 6\" />\n   175→          </svg>\n   176→          Back to Teams\n   177→        </button>\n   178→      </div>\n   179→\n   180→      <div className=\"ts-fields\">\n   181→        {/* Team Name */}\n   182→        <div className=\"ts-field\" data-testid=\"team-settings-name-field\">\n   183→          <label className=\"ts-field-label\">Team name</label>\n   184→          {editingName ? (\n   185→            <div className=\"ts-field-edit\">\n   186→              <input\n   187→                ref={nameInputRef}\n   188→                type=\"text\"\n   189→                className={`ts-input ${nameError ? 'ts-input-error' : ''}`}\n   190→                value={nameValue}\n   191→                onChange={(e) => { setNameValue(e.target.value); setNameError(null); }}\n   192→                onKeyDown={(e) => {\n   193→                  if (e.key === 'Enter') saveNameField();\n   194→                  if (e.key === 'Escape') cancelNameEdit();\n   195→                }}\n   196→                onBlur={saveNameField}\n   197→                data-testid=\"team-settings-name-input\"\n   198→              />\n   199→              {nameError && (\n   200→                <span className=\"ts-field-error\" data-testid=\"team-settings-name-error\">{nameError}</span>\n   201→              )}\n   202→            </div>\n   203→          ) : (\n   204→            <div\n   205→              className=\"ts-field-value ts-field-clickable\"\n   206→              onClick={() => setEditingName(true)}\n   207→              data-testid=\"team-settings-name-value\"\n   208→            >\n   209→              {selectedTeam.name}\n   210→              <svg className=\"ts-edit-icon\" width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n   211→                <path d=\"M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7\" />\n   212→                <path d=\"M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z\" />\n   213→              </svg>\n   214→            </div>\n   215→          )}\n   216→        </div>\n   217→\n   218→        {/* Identifier Prefix */}\n   219→        <div className=\"ts-field\" data-testid=\"team-settings-identifier-field\">\n   220→          <label className=\"ts-field-label\">Identifier prefix</label>\n   221→          {editingIdentifier ? (\n   222→            <div className=\"ts-field-edit\">\n   223→              <input\n   224→                ref={identifierInputRef}\n   225→                type=\"text\"\n   226→                className={`ts-input ${identifierError ? 'ts-input-error' : ''}`}\n   227→                value={identifierValue}\n   228→                onChange={(e) => {\n   229→                  const upper = e.target.value.toUpperCase().replace(/[^A-Z]/g, '');\n   230→                  setIdentifierValue(upper.slice(0, 5));\n   231→                  setIdentifierError(null);\n   232→                }}\n   233→                onKeyDown={(e) => {\n   234→                  if (e.key === 'Enter') saveIdentifierField();\n   235→                  if (e.key === 'Escape') cancelIdentifierEdit();\n   236→                }}\n   237→                onBlur={saveIdentifierField}\n   238→                maxLength={5}\n   239→                data-testid=\"team-settings-identifier-input\"\n   240→              />\n   241→              {identifierError && (\n   242→                <span className=\"ts-field-error\" data-testid=\"team-settings-identifier-error\">{identifierError}</span>\n   243→              )}\n   244→            </div>\n   245→          ) : (\n   246→            <div\n   247→              className=\"ts-field-value ts-field-clickable\"\n   248→              onClick={() => setEditingIdentifier(true)}\n   249→              data-testid=\"team-settings-identifier-value\"\n   250→            >\n   251→              {selectedTeam.identifier}\n   252→              <svg className=\"ts-edit-icon\" width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n   253→                <path d=\"M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7\" />\n   254→                <path d=\"M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z\" />\n   255→              </svg>\n   256→            </div>\n   257→          )}\n   258→        </div>\n   259→\n   260→        {/* Description */}\n   261→        <div className=\"ts-field\" data-testid=\"team-settings-description-field\">\n   262→          <label className=\"ts-field-label\">Description</label>\n   263→          {editingDescription ? (\n   264→            <div className=\"ts-field-edit\">\n   265→              <textarea\n   266→                ref={descriptionInputRef}\n   267→                className=\"ts-textarea\"\n   268→                value={descriptionValue}\n   269→                onChange={(e) => setDescriptionValue(e.target.value)}\n   270→                onKeyDown={(e) => {\n   271→                  if (e.key === 'Escape') cancelDescriptionEdit();\n   272→                }}\n   273→                onBlur={saveDescriptionField}\n   274→                rows={3}\n   275→                data-testid=\"team-settings-description-input\"\n   276→              />\n   277→            </div>\n   278→          ) : (\n   279→            <div\n   280→              className=\"ts-field-value ts-field-clickable\"\n   281→              onClick={() => setEditingDescription(true)}\n   282→              data-testid=\"team-settings-description-value\"\n   283→            >\n   284→              {selectedTeam.description || <span className=\"ts-placeholder\">No description</span>}\n   285→              <svg className=\"ts-edit-icon\" width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n   286→                <path d=\"M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7\" />\n   287→                <path d=\"M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z\" />\n   288→              </svg>\n   289→            </div>\n   290→          )}\n   291→        </div>\n   292→      </div>\n   293→\n   294→      {/* Team Members */}\n   295→      <div className=\"ts-members-section\" data-testid=\"team-settings-members-section\">\n   296→        <div className=\"ts-members-header\">\n   297→          <h3 className=\"ts-members-title\">Team Members</h3>\n   298→          <button\n   299→            className=\"ts-add-member-btn\"\n   300→            onClick={() => setShowAddMember(!showAddMember)}\n   301→            data-testid=\"team-settings-add-member-btn\"\n   302→          >\n   303→            <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n   304→              <line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\" />\n   305→              <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\" />\n   306→            </svg>\n   307→            Add Member\n   308→          </button>\n   309→        </div>\n   310→\n   311→        {showAddMember && (\n   312→          <div className=\"ts-add-member-dropdown\" data-testid=\"team-settings-member-selector\">\n   313→            {availableMembers.length === 0 ? (\n   314→              <div className=\"ts-add-member-empty\">No available members to add</div>\n   315→            ) : (\n   316→              availableMembers.map((member) => (\n   317→                <button\n   318→                  key={member.id}\n   319→                  className=\"ts-add-member-option\"\n   320→                  onClick={() => handleAddMember(member.id)}\n   321→                  data-testid={`team-settings-add-member-option-${member.id}`}\n   322→                >\n   323→                  <span className=\"ts-member-avatar\">{getInitials(member.name)}</span>\n   324→                  <span className=\"ts-member-option-name\">{member.name}</span>\n   325→                  <span className=\"ts-member-option-email\">{member.email}</span>\n   326→                </button>\n   327→              ))\n   328→            )}\n   329→          </div>\n   330→        )}\n   331→\n   332→        {teamMembers.length === 0 ? (\n   333→          <div className=\"ts-members-empty\" data-testid=\"team-settings-members-empty\">\n   334→            <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--color-text-tertiary)\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n   335→              <path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\" />\n   336→              <circle cx=\"9\" cy=\"7\" r=\"4\" />\n   337→              <path d=\"M23 21v-2a4 4 0 0 0-3-3.87\" />\n   338→              <path d=\"M16 3.13a4 4 0 0 1 0 7.75\" />\n   339→            </svg>\n   340→            <p>No members yet. Add members to this team.</p>\n   341→          </div>\n   342→        ) : (\n   343→          <div className=\"ts-members-list\" data-testid=\"team-settings-members-list\">\n   344→            {teamMembers.map((member) => (\n   345→              <div\n   346→                key={member.id}\n   347→                className=\"ts-member-row\"\n   348→                data-testid={`team-settings-member-${member.id}`}\n   349→              >\n   350→                <div className=\"ts-member-info\">\n   351→                  <span className=\"ts-member-avatar\">{getInitials(member.name)}</span>\n   352→                  <div className=\"ts-member-details\">\n   353→                    <span className=\"ts-member-name\">{member.name}</span>\n   354→                    <span className=\"ts-member-email\">{member.email}</span>\n   355→                  </div>\n   356→                </div>\n   357→\n   358→                {removingMemberId === member.id ? (\n   359→                  <div className=\"ts-member-confirm\">\n   360→                    <span className=\"ts-confirm-text\">Remove {member.name}?</span>\n   361→                    <button\n   362→                      className=\"ts-confirm-btn\"\n   363→                      onClick={() => handleRemoveMember(member.id)}\n   364→                      data-testid={`team-settings-confirm-remove-${member.id}`}\n   365→                    >\n   366→                      Confirm\n   367→                    </button>\n   368→                    <button\n   369→                      className=\"ts-cancel-confirm-btn\"\n   370→                      onClick={() => setRemovingMemberId(null)}\n   371→                      data-testid={`team-settings-cancel-remove-${member.id}`}\n   372→                    >\n   373→                      Cancel\n   374→                    </button>\n   375→                  </div>\n   376→                ) : (\n   377→                  <button\n   378→                    className=\"ts-remove-btn\"\n   379→                    onClick={() => setRemovingMemberId(member.id)}\n   380→                    data-testid={`team-settings-remove-member-${member.id}`}\n   381→                    title={`Remove ${member.name}`}\n   382→                  >\n   383→                    <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n   384→                      <line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\" />\n   385→                      <line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\" />\n   386→                    </svg>\n   387→                  </button>\n   388→                )}\n   389→              </div>\n   390→            ))}\n   391→          </div>\n   392→        )}\n   393→      </div>\n   394→\n   395→      {/* Delete Team */}\n   396→      <div className=\"ts-danger-zone\" data-testid=\"team-settings-danger-zone\">\n   397→        {showDeleteConfirm ? (\n   398→          <div className=\"ts-delete-confirm\" data-testid=\"team-settings-delete-confirm\">\n   399→            <p className=\"ts-delete-confirm-text\">\n   400→              Are you sure you want to delete the team &ldquo;{selectedTeam.name}&rdquo;? This action cannot be undone.\n   401→            </p>\n   402→            <div className=\"ts-delete-confirm-actions\">\n   403→              <button\n   404→                className=\"ts-delete-confirm-btn\"\n   405→                onClick={handleDeleteTeam}\n   406→                data-testid=\"team-settings-confirm-delete-btn\"\n   407→              >\n   408→                Delete\n   409→              </button>\n   410→              <button\n   411→                className=\"ts-delete-cancel-btn\"\n   412→                onClick={() => setShowDeleteConfirm(false)}\n   413→                data-testid=\"team-settings-cancel-delete-btn\"\n   414→              >\n   415→                Cancel\n   416→              </button>\n   417→            </div>\n   418→          </div>\n   419→        ) : (\n   420→          <button\n   421→            className=\"ts-delete-btn\"\n   422→            onClick={() => setShowDeleteConfirm(true)}\n   423→            data-testid=\"team-settings-delete-btn\"\n   424→          >\n   425→            <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n   426→              <polyline points=\"3 6 5 6 21 6\" />\n   427→              <path d=\"M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2\" />\n   428→            </svg>\n   429→            Delete Team\n   430→          </button>\n   431→        )}\n   432→      </div>\n   433→    </div>\n   434→  );\n   435→}\n   436→"}]},"parent_tool_use_id":null,"session_id":"9ab25009-980f-40f8-a022-3d9ee277d1c2","uuid":"87989ce5-573b-4a34-8508-8cac528df2e2","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/src/components/TeamSettings.tsx","content":"import { useState, useEffect, useRef } from 'react';\nimport { useSelector, useDispatch } from 'react-redux';\nimport type { RootState, AppDispatch } from '../store';\nimport {\n  fetchTeamDetail,\n  updateTeam,\n  deleteTeam,\n  addTeamMember,\n  removeTeamMember,\n  clearTeamDetail,\n  fetchTeams,\n} from '../slices/teamsSlice';\nimport './TeamSettings.css';\n\ninterface TeamSettingsProps {\n  teamId: string;\n  onBack: () => void;\n}\n\nfunction getInitials(name: string): string {\n  return name.split(' ').map((n) => n[0]).join('').toUpperCase().slice(0, 2);\n}\n\nexport default function TeamSettings({ teamId, onBack }: TeamSettingsProps) {\n  const dispatch = useDispatch<AppDispatch>();\n  const { selectedTeam, teamMembers, availableMembers, detailLoading } = useSelector(\n    (state: RootState) => state.teams\n  );\n\n  const [editingName, setEditingName] = useState(false);\n  const [editingIdentifier, setEditingIdentifier] = useState(false);\n  const [editingDescription, setEditingDescription] = useState(false);\n  const [nameValue, setNameValue] = useState('');\n  const [identifierValue, setIdentifierValue] = useState('');\n  const [descriptionValue, setDescriptionValue] = useState('');\n  const [nameError, setNameError] = useState<string | null>(null);\n  const [identifierError, setIdentifierError] = useState<string | null>(null);\n  const [showDeleteConfirm, setShowDeleteConfirm] = useState(false);\n  const [showAddMember, setShowAddMember] = useState(false);\n  const [removingMemberId, setRemovingMemberId] = useState<string | null>(null);\n\n  const nameInputRef = useRef<HTMLInputElement>(null);\n  const identifierInputRef = useRef<HTMLInputElement>(null);\n  const descriptionInputRef = useRef<HTMLTextAreaElement>(null);\n\n  useEffect(() => {\n    dispatch(fetchTeamDetail(teamId));\n    return () => {\n      dispatch(clearTeamDetail());\n    };\n  }, [dispatch, teamId]);\n\n  useEffect(() => {\n    if (selectedTeam) {\n      setNameValue(selectedTeam.name);\n      setIdentifierValue(selectedTeam.identifier);\n      setDescriptionValue(selectedTeam.description);\n    }\n  }, [selectedTeam]);\n\n  useEffect(() => {\n    if (editingName) {\n      nameInputRef.current?.focus();\n      nameInputRef.current?.select();\n    }\n  }, [editingName]);\n\n  useEffect(() => {\n    if (editingIdentifier) {\n      identifierInputRef.current?.focus();\n      identifierInputRef.current?.select();\n    }\n  }, [editingIdentifier]);\n\n  useEffect(() => {\n    if (editingDescription) {\n      descriptionInputRef.current?.focus();\n    }\n  }, [editingDescription]);\n\n  async function saveNameField() {\n    if (!nameValue.trim()) {\n      setNameError('Team name cannot be empty');\n      return;\n    }\n    setNameError(null);\n    if (nameValue.trim() !== selectedTeam?.name) {\n      const result = await dispatch(updateTeam({ teamId, name: nameValue.trim() }));\n      if (updateTeam.rejected.match(result)) {\n        setNameError(result.payload as string);\n        return;\n      }\n      dispatch(fetchTeams());\n    }\n    setEditingName(false);\n  }\n\n  async function saveIdentifierField() {\n    const upper = identifierValue.toUpperCase();\n    if (upper.length < 2 || upper.length > 5) {\n      setIdentifierError('Identifier prefix must be 2-5 uppercase characters');\n      return;\n    }\n    setIdentifierError(null);\n    if (upper !== selectedTeam?.identifier) {\n      const result = await dispatch(updateTeam({ teamId, identifier: upper }));\n      if (updateTeam.rejected.match(result)) {\n        setIdentifierError(result.payload as string);\n        return;\n      }\n      dispatch(fetchTeams());\n    }\n    setEditingIdentifier(false);\n  }\n\n  async function saveDescriptionField() {\n    if (descriptionValue !== selectedTeam?.description) {\n      await dispatch(updateTeam({ teamId, description: descriptionValue }));\n      dispatch(fetchTeams());\n    }\n    setEditingDescription(false);\n  }\n\n  function cancelNameEdit() {\n    setNameValue(selectedTeam?.name || '');\n    setNameError(null);\n    setEditingName(false);\n  }\n\n  function cancelIdentifierEdit() {\n    setIdentifierValue(selectedTeam?.identifier || '');\n    setIdentifierError(null);\n    setEditingIdentifier(false);\n  }\n\n  function cancelDescriptionEdit() {\n    setDescriptionValue(selectedTeam?.description || '');\n    setEditingDescription(false);\n  }\n\n  async function handleDeleteTeam() {\n    await dispatch(deleteTeam(teamId));\n    dispatch(fetchTeams());\n    onBack();\n  }\n\n  async function handleAddMember(memberIdToAdd: string) {\n    await dispatch(addTeamMember({ teamId, memberIdToAdd }));\n    setShowAddMember(false);\n  }\n\n  async function handleRemoveMember(memberIdToRemove: string) {\n    await dispatch(removeTeamMember({ teamId, memberIdToRemove }));\n    setRemovingMemberId(null);\n  }\n\n  if (detailLoading || !selectedTeam) {\n    return (\n      <div className=\"team-settings\" data-testid=\"team-settings\">\n        <div className=\"ts-loading\">Loading...</div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"team-settings\" data-testid=\"team-settings\">\n      <div className=\"ts-top-bar\">\n        <button\n          className=\"ts-back-btn\"\n          onClick={onBack}\n          data-testid=\"team-settings-back-btn\"\n        >\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n            <polyline points=\"15 18 9 12 15 6\" />\n          </svg>\n          Back to Teams\n        </button>\n      </div>\n\n      <div className=\"ts-fields\">\n        {/* Team Name */}\n        <div className=\"ts-field\" data-testid=\"team-settings-name-field\">\n          <label className=\"ts-field-label\">Team name</label>\n          {editingName ? (\n            <div className=\"ts-field-edit\">\n              <input\n                ref={nameInputRef}\n                type=\"text\"\n                className={`ts-input ${nameError ? 'ts-input-error' : ''}`}\n                value={nameValue}\n                onChange={(e) => { setNameValue(e.target.value); setNameError(null); }}\n                onKeyDown={(e) => {\n                  if (e.key === 'Enter') saveNameField();\n                  if (e.key === 'Escape') cancelNameEdit();\n                }}\n                onBlur={saveNameField}\n                data-testid=\"team-settings-name-input\"\n              />\n              {nameError && (\n                <span className=\"ts-field-error\" data-testid=\"team-settings-name-error\">{nameError}</span>\n              )}\n            </div>\n          ) : (\n            <div\n              className=\"ts-field-value ts-field-clickable\"\n              onClick={() => setEditingName(true)}\n              data-testid=\"team-settings-name-value\"\n            >\n              {selectedTeam.name}\n              <svg className=\"ts-edit-icon\" width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n                <path d=\"M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7\" />\n                <path d=\"M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z\" />\n              </svg>\n            </div>\n          )}\n        </div>\n\n        {/* Identifier Prefix */}\n        <div className=\"ts-field\" data-testid=\"team-settings-identifier-field\">\n          <label className=\"ts-field-label\">Identifier prefix</label>\n          {editingIdentifier ? (\n            <div className=\"ts-field-edit\">\n              <input\n                ref={identifierInputRef}\n                type=\"text\"\n                className={`ts-input ${identifierError ? 'ts-input-error' : ''}`}\n                value={identifierValue}\n                onChange={(e) => {\n                  const upper = e.target.value.toUpperCase().replace(/[^A-Z]/g, '');\n                  setIdentifierValue(upper.slice(0, 5));\n                  setIdentifierError(null);\n                }}\n                onKeyDown={(e) => {\n                  if (e.key === 'Enter') saveIdentifierField();\n                  if (e.key === 'Escape') cancelIdentifierEdit();\n                }}\n                onBlur={saveIdentifierField}\n                maxLength={5}\n                data-testid=\"team-settings-identifier-input\"\n              />\n              {identifierError && (\n                <span className=\"ts-field-error\" data-testid=\"team-settings-identifier-error\">{identifierError}</span>\n              )}\n            </div>\n          ) : (\n            <div\n              className=\"ts-field-value ts-field-clickable\"\n              onClick={() => setEditingIdentifier(true)}\n              data-testid=\"team-settings-identifier-value\"\n            >\n              {selectedTeam.identifier}\n              <svg className=\"ts-edit-icon\" width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n                <path d=\"M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7\" />\n                <path d=\"M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z\" />\n              </svg>\n            </div>\n          )}\n        </div>\n\n        {/* Description */}\n        <div className=\"ts-field\" data-testid=\"team-settings-description-field\">\n          <label className=\"ts-field-label\">Description</label>\n          {editingDescription ? (\n            <div className=\"ts-field-edit\">\n              <textarea\n                ref={descriptionInputRef}\n                className=\"ts-textarea\"\n                value={descriptionValue}\n                onChange={(e) => setDescriptionValue(e.target.value)}\n                onKeyDown={(e) => {\n                  if (e.key === 'Escape') cancelDescriptionEdit();\n                }}\n                onBlur={saveDescriptionField}\n                rows={3}\n                data-testid=\"team-settings-description-input\"\n              />\n            </div>\n          ) : (\n            <div\n              className=\"ts-field-value ts-field-clickable\"\n              onClick={() => setEditingDescription(true)}\n              data-testid=\"team-settings-description-value\"\n            >\n              {selectedTeam.description || <span className=\"ts-placeholder\">No description</span>}\n              <svg className=\"ts-edit-icon\" width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n                <path d=\"M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7\" />\n                <path d=\"M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z\" />\n              </svg>\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* Team Members */}\n      <div className=\"ts-members-section\" data-testid=\"team-settings-members-section\">\n        <div className=\"ts-members-header\">\n          <h3 className=\"ts-members-title\">Team Members</h3>\n          <button\n            className=\"ts-add-member-btn\"\n            onClick={() => setShowAddMember(!showAddMember)}\n            data-testid=\"team-settings-add-member-btn\"\n          >\n            <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n              <line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\" />\n              <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\" />\n            </svg>\n            Add Member\n          </button>\n        </div>\n\n        {showAddMember && (\n          <div className=\"ts-add-member-dropdown\" data-testid=\"team-settings-member-selector\">\n            {availableMembers.length === 0 ? (\n              <div className=\"ts-add-member-empty\">No available members to add</div>\n            ) : (\n              availableMembers.map((member) => (\n                <button\n                  key={member.id}\n                  className=\"ts-add-member-option\"\n                  onClick={() => handleAddMember(member.id)}\n                  data-testid={`team-settings-add-member-option-${member.id}`}\n                >\n                  <span className=\"ts-member-avatar\">{getInitials(member.name)}</span>\n                  <span className=\"ts-member-option-name\">{member.name}</span>\n                  <span className=\"ts-member-option-email\">{member.email}</span>\n                </button>\n              ))\n            )}\n          </div>\n        )}\n\n        {teamMembers.length === 0 ? (\n          <div className=\"ts-members-empty\" data-testid=\"team-settings-members-empty\">\n            <svg width=\"32\" height=\"32\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--color-text-tertiary)\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n              <path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\" />\n              <circle cx=\"9\" cy=\"7\" r=\"4\" />\n              <path d=\"M23 21v-2a4 4 0 0 0-3-3.87\" />\n              <path d=\"M16 3.13a4 4 0 0 1 0 7.75\" />\n            </svg>\n            <p>No members yet. Add members to this team.</p>\n          </div>\n        ) : (\n          <div className=\"ts-members-list\" data-testid=\"team-settings-members-list\">\n            {teamMembers.map((member) => (\n              <div\n                key={member.id}\n                className=\"ts-member-row\"\n                data-testid={`team-settings-member-${member.id}`}\n              >\n                <div className=\"ts-member-info\">\n                  <span className=\"ts-member-avatar\">{getInitials(member.name)}</span>\n                  <div className=\"ts-member-details\">\n                    <span className=\"ts-member-name\">{member.name}</span>\n                    <span className=\"ts-member-email\">{member.email}</span>\n                  </div>\n                </div>\n\n                {removingMemberId === member.id ? (\n                  <div className=\"ts-member-confirm\">\n                    <span className=\"ts-confirm-text\">Remove {member.name}?</span>\n                    <button\n                      className=\"ts-confirm-btn\"\n                      onClick={() => handleRemoveMember(member.id)}\n                      data-testid={`team-settings-confirm-remove-${member.id}`}\n                    >\n                      Confirm\n                    </button>\n                    <button\n                      className=\"ts-cancel-confirm-btn\"\n                      onClick={() => setRemovingMemberId(null)}\n                      data-testid={`team-settings-cancel-remove-${member.id}`}\n                    >\n                      Cancel\n                    </button>\n                  </div>\n                ) : (\n                  <button\n                    className=\"ts-remove-btn\"\n                    onClick={() => setRemovingMemberId(member.id)}\n                    data-testid={`team-settings-remove-member-${member.id}`}\n                    title={`Remove ${member.name}`}\n                  >\n                    <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n                      <line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\" />\n                      <line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\" />\n                    </svg>\n                  </button>\n                )}\n              </div>\n            ))}\n          </div>\n        )}\n      </div>\n\n      {/* Delete Team */}\n      <div className=\"ts-danger-zone\" data-testid=\"team-settings-danger-zone\">\n        {showDeleteConfirm ? (\n          <div className=\"ts-delete-confirm\" data-testid=\"team-settings-delete-confirm\">\n            <p className=\"ts-delete-confirm-text\">\n              Are you sure you want to delete the team &ldquo;{selectedTeam.name}&rdquo;? This action cannot be undone.\n            </p>\n            <div className=\"ts-delete-confirm-actions\">\n              <button\n                className=\"ts-delete-confirm-btn\"\n                onClick={handleDeleteTeam}\n                data-testid=\"team-settings-confirm-delete-btn\"\n              >\n                Delete\n              </button>\n              <button\n                className=\"ts-delete-cancel-btn\"\n                onClick={() => setShowDeleteConfirm(false)}\n                data-testid=\"team-settings-cancel-delete-btn\"\n              >\n                Cancel\n              </button>\n            </div>\n          </div>\n        ) : (\n          <button\n            className=\"ts-delete-btn\"\n            onClick={() => setShowDeleteConfirm(true)}\n            data-testid=\"team-settings-delete-btn\"\n          >\n            <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n              <polyline points=\"3 6 5 6 21 6\" />\n              <path d=\"M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2\" />\n            </svg>\n            Delete Team\n          </button>\n        )}\n      </div>\n    </div>\n  );\n}\n","numLines":436,"startLine":1,"totalLines":436}}}
