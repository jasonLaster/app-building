[2026-03-16T03:34:00.909Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GBk4CKURo8awn7DXvVGXBv","type":"tool_result","content":"     1→import { useState, useEffect, useCallback, useRef } from 'react'\n     2→import { useSelector, useDispatch } from 'react-redux'\n     3→import { useNavigate } from 'react-router-dom'\n     4→import { ChevronLeft, ChevronRight, ChevronDown } from 'lucide-react'\n     5→import type { RootState, AppDispatch } from '../store'\n     6→import type { Property } from '../slices/propertiesSlice'\n     7→import { createBooking, clearBookingError } from '../slices/bookingsSlice'\n     8→\n     9→interface BookingCardProps {\n    10→  property: Property\n    11→}\n    12→\n    13→interface BookedRange {\n    14→  check_in: string\n    15→  check_out: string\n    16→}\n    17→\n    18→function getDaysInMonth(year: number, month: number): number {\n    19→  return new Date(year, month + 1, 0).getDate()\n    20→}\n    21→\n    22→function getFirstDayOfWeek(year: number, month: number): number {\n    23→  return new Date(year, month, 1).getDay()\n    24→}\n    25→\n    26→function formatDateStr(year: number, month: number, day: number): string {\n    27→  return `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`\n    28→}\n    29→\n    30→function isDateBooked(dateStr: string, bookedRanges: BookedRange[]): boolean {\n    31→  for (const range of bookedRanges) {\n    32→    if (dateStr >= range.check_in && dateStr < range.check_out) {\n    33→      return true\n    34→    }\n    35→  }\n    36→  return false\n    37→}\n    38→\n    39→function isDateInPast(dateStr: string, todayStr: string): boolean {\n    40→  return dateStr < todayStr\n    41→}\n    42→\n    43→const MONTH_NAMES = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']\n    44→const DAY_NAMES = ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa']\n    45→\n    46→function CalendarMonth({\n    47→  year,\n    48→  month,\n    49→  todayStr,\n    50→  bookedRanges,\n    51→  checkIn,\n    52→  checkOut,\n    53→  onSelectDate,\n    54→}: {\n    55→  year: number\n    56→  month: number\n    57→  todayStr: string\n    58→  bookedRanges: BookedRange[]\n    59→  checkIn: string\n    60→  checkOut: string\n    61→  onSelectDate: (dateStr: string) => void\n    62→}) {\n    63→  const daysInMonth = getDaysInMonth(year, month)\n    64→  const firstDay = getFirstDayOfWeek(year, month)\n    65→\n    66→  const cells: (number | null)[] = []\n    67→  for (let i = 0; i < firstDay; i++) cells.push(null)\n    68→  for (let d = 1; d <= daysInMonth; d++) cells.push(d)\n    69→\n    70→  return (\n    71→    <div role=\"grid\" aria-label={`${MONTH_NAMES[month]} ${year}`}>\n    72→      <div className=\"text-center text-sm font-semibold text-text mb-3\">\n    73→        {MONTH_NAMES[month]} {year}\n    74→      </div>\n    75→      <div className=\"grid grid-cols-7 gap-0\">\n    76→        {DAY_NAMES.map((d) => (\n    77→          <div key={d} className=\"text-center text-xs font-semibold text-text-secondary py-1\" role=\"columnheader\">\n    78→            {d}\n    79→          </div>\n    80→        ))}\n    81→        {cells.map((day, idx) => {\n    82→          if (day === null) {\n    83→            return <div key={`empty-${idx}`} className=\"h-10\" />\n    84→          }\n    85→          const dateStr = formatDateStr(year, month, day)\n    86→          const isPast = isDateInPast(dateStr, todayStr)\n    87→          const booked = isDateBooked(dateStr, bookedRanges)\n    88→          const disabled = isPast || booked\n    89→          const isCheckIn = dateStr === checkIn\n    90→          const isCheckOut = dateStr === checkOut\n    91→          const isSelected = isCheckIn || isCheckOut\n    92→          const inRange = checkIn && checkOut && dateStr > checkIn && dateStr < checkOut\n    93→\n    94→          return (\n    95→            <button\n    96→              key={dateStr}\n    97→              data-testid={`calendar-day-${dateStr}`}\n    98→              disabled={disabled}\n    99→              onClick={() => !disabled && onSelectDate(dateStr)}\n   100→              aria-label={`${MONTH_NAMES[month]} ${day}, ${year}${isCheckIn ? ' (check-in)' : ''}${isCheckOut ? ' (checkout)' : ''}${booked ? ' (unavailable)' : ''}${isPast ? ' (past date)' : ''}`}\n   101→              aria-pressed={isSelected}\n   102→              className={`h-10 w-full text-sm rounded-full transition-colors cursor-pointer\n   103→                ${disabled ? 'text-border line-through cursor-not-allowed' : 'hover:bg-bg-secondary text-text'}\n   104→                ${isSelected ? 'bg-text text-white hover:bg-text' : ''}\n   105→                ${inRange ? 'bg-bg-secondary' : ''}\n   106→                ${booked ? 'bg-bg-secondary' : ''}\n   107→              `}\n   108→            >\n   109→              {day}\n   110→            </button>\n   111→          )\n   112→        })}\n   113→      </div>\n   114→    </div>\n   115→  )\n   116→}\n   117→\n   118→export default function BookingCard({ property }: BookingCardProps) {\n   119→  const dispatch = useDispatch<AppDispatch>()\n   120→  const navigate = useNavigate()\n   121→  const currentUser = useSelector((state: RootState) => state.auth.currentUser)\n   122→  const { loading, error } = useSelector((state: RootState) => state.bookings)\n   123→\n   124→  const [checkIn, setCheckIn] = useState('')\n   125→  const [checkOut, setCheckOut] = useState('')\n   126→  const [guests, setGuests] = useState(1)\n   127→  const [success, setSuccess] = useState(false)\n   128→  const [calendarOpen, setCalendarOpen] = useState(false)\n   129→  const [bookedRanges, setBookedRanges] = useState<BookedRange[]>([])\n   130→\n   131→  const now = new Date()\n   132→  const todayStr = formatDateStr(now.getFullYear(), now.getMonth(), now.getDate())\n   133→  const [calMonth, setCalMonth] = 