[2026-03-16T03:33:55.947Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DrxaocdHnDu1hDYmHztijU","type":"tool_result","content":"     1→import { useState, useCallback } from 'react'\n     2→import { useSelector } from 'react-redux'\n     3→import { Navigate } from 'react-router-dom'\n     4→import type { RootState } from '../store'\n     5→import LoginForm from '../components/LoginForm'\n     6→import RegisterForm from '../components/RegisterForm'\n     7→import AuthToggle from '../components/AuthToggle'\n     8→\n     9→function Login() {\n    10→  const [mode, setMode] = useState<'login' | 'register'>('login')\n    11→  const currentUser = useSelector((state: RootState) => state.auth.currentUser)\n    12→\n    13→  const handleToggle = useCallback(() => {\n    14→    setMode((prev) => (prev === 'login' ? 'register' : 'login'))\n    15→  }, [])\n    16→\n    17→  if (currentUser) {\n    18→    return <Navigate to=\"/\" replace />\n    19→  }\n    20→\n    21→  return (\n    22→    <main className=\"min-h-screen flex items-center justify-center bg-bg-secondary p-6 max-sm:p-3\" data-testid=\"login-page\">\n    23→      <section className=\"w-full max-w-md bg-bg rounded-2xl shadow-lg p-8\" aria-labelledby=\"login-title\">\n    24→        <header className=\"text-center mb-8\">\n    25→          <h1 id=\"login-title\" className=\"text-2xl font-bold text-primary\" data-testid=\"login-title\">\n    26→            {mode === 'login' ? 'Welcome Back' : 'Create Account'}\n    27→          </h1>\n    28→          <p className=\"text-text-secondary mt-2\">\n    29→            {mode === 'login'\n    30→              ? 'Log in to continue to AirbnbClone'\n    31→              : 'Sign up to get started with AirbnbClone'}\n    32→          </p>\n    33→        </header>\n    34→\n    35→        {mode === 'login' ? <LoginForm key=\"login\" /> : <RegisterForm key=\"register\" />}\n    36→\n    37→        <AuthToggle mode={mode} onToggle={handleToggle} />\n    38→      </section>\n    39→    </main>\n    40→  )\n    41→}\n    42→\n    43→export default Login\n    44→"}]},"parent_tool_use_id":"toolu_01K8gmF3iPxX9iX6L5AoXRWv","session_id":"02a601b0-a58d-4ced-bb22-f466b267f498","uuid":"ea9873bd-2e36-414c-9052-bd9ff16c90e0"}
