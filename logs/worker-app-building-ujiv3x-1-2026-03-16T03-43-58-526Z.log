[2026-03-16T03:34:00.012Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015Mp6hqqWhG5nxQG7d8auNJ","type":"tool_result","content":"     1→import { useState } from 'react'\n     2→import { Search } from 'lucide-react'\n     3→\n     4→interface SearchBarProps {\n     5→  onSearch: (filters: { city: string; checkIn: string; checkOut: string; guests: number }) => void\n     6→  initialCity?: string\n     7→  initialCheckIn?: string\n     8→  initialCheckOut?: string\n     9→  initialGuests?: number\n    10→}\n    11→\n    12→export default function SearchBar({ onSearch, initialCity = '', initialCheckIn = '', initialCheckOut = '', initialGuests = 0 }: SearchBarProps) {\n    13→  const [city, setCity] = useState(initialCity)\n    14→  const [checkIn, setCheckIn] = useState(initialCheckIn)\n    15→  const [checkOut, setCheckOut] = useState(initialCheckOut)\n    16→  const [guests, setGuests] = useState(initialGuests)\n    17→\n    18→  const today = new Date().toISOString().split('T')[0]\n    19→\n    20→  const checkOutMin = (() => {\n    21→    if (!checkIn) return today\n    22→    const d = new Date(checkIn + 'T00:00:00')\n    23→    d.setDate(d.getDate() + 1)\n    24→    return d.toISOString().split('T')[0]\n    25→  })()\n    26→\n    27→  const handleSubmit = (e: React.FormEvent) => {\n    28→    e.preventDefault()\n    29→    onSearch({ city, checkIn, checkOut, guests })\n    30→  }\n    31→\n    32→  const handleGuestsChange = (value: string) => {\n    33→    const num = parseInt(value, 10)\n    34→    if (isNaN(num) || num < 1) {\n    35→      setGuests(1)\n    36→    } else {\n    37→      setGuests(num)\n    38→    }\n    39→  }\n    40→\n    41→  return (\n    42→    <form\n    43→      data-testid=\"search-bar\"\n    44→      onSubmit={handleSubmit}\n    45→      role=\"search\"\n    46→      aria-label=\"Search properties\"\n    47→      className=\"flex items-center rounded-full border border-border bg-bg shadow-md hover:shadow-lg transition-shadow max-w-3xl mx-auto\"\n    48→    >\n    49→      <div className=\"flex-1 min-w-0 px-6 py-3\">\n    50→        <label htmlFor=\"search-location\" className=\"block text-xs font-semibold text-text\">Where</label>\n    51→        <input\n    52→          id=\"search-location\"\n    53→          data-testid=\"search-location\"\n    54→          type=\"text\"\n    55→          placeholder=\"Where are you going?\"\n    56→          value={city}\n    57→          onChange={(e) => setCity(e.target.value)}\n    58→          className=\"w-full text-sm text-text-secondary outline-none bg-transparent placeholder-text-secondary\"\n    59→        />\n    60→      </div>\n    61→\n    62→      <div className=\"w-px h-8 bg-border shrink-0\" aria-hidden=\"true\" />\n    63→\n    64→      <div className=\"px-4 py-3\">\n    65→        <span className=\"block text-xs font-semibold text-text\" id=\"search-when-label\">When</span>\n    66→        <div className=\"flex items-center gap-2\" role=\"group\" aria-labelledby=\"search-when-label\">\n    67→          <label htmlFor=\"search-checkin\" className=\"sr-only\">Check-in date</label>\n    68→          <input\n    69→            id=\"search-checkin\"\n    70→            data-testid=\"search-checkin\"\n    71→            type=\"date\"\n    72→            value={checkIn}\n    73→            min={today}\n    74→            onChange={(e) => {\n    75→              setCheckIn(e.target.value)\n    76→              if (checkOut && e.target.value >= checkOut) {\n    77→                setCheckOut('')\n    78→              }\n    79→            }}\n    80→            className=\"text-sm text-text-secondary outline-none bg-transparent w-[130px]\"\n    81→          />\n    82→          <span className=\"text-text-secondary text-xs\" aria-hidden=\"true\">–</span>\n    83→          <label htmlFor=\"search-checkout\" className=\"sr-only\">Check-out date</label>\n    84→          <input\n    85→            id=\"search-checkout\"\n    86→            data-testid=\"search-checkout\"\n    87→            type=\"date\"\n    88→            value={checkOut}\n    89→            min={checkOutMin}\n    90→            onChange={(e) => setCheckOut(e.target.value)}\n    91→            className=\"text-sm text-text-secondary outline-none bg-transparent w-[130px]\"\n    92→          />\n    93→        </div>\n    94→      </div>\n    95→\n    96→      <div className=\"w-px h-8 bg-border shrink-0\" aria-hidden=\"true\" />\n    97→\n    98→      <div className=\"flex items-center gap-2 pl-4 pr-2 py-2\">\n    99→        <div>\n   100→          <label htmlFor=\"search-guests\" className=\"block text-xs font-semibold text-text\">Who</label>\n   101→          <input\n   102→            id=\"search-guests\"\n   103→            data-testid=\"search-guests\"\n   104→            type=\"number\"\n   105→            min={1}\n   106→            placeholder=\"Add guests\"\n   107→            value={guests || ''}\n   108→            onChange={(e) => handleGuestsChange(e.target.value)}\n   109→            className=\"w-24 text-sm text-text-secondary outline-none bg-transparent placeholder-text-secondary\"\n   110→          />\n   111→        </div>\n   112→        <button\n   113→          data-testid=\"search-button\"\n   114→          type=\"submit\"\n   115→          aria-label=\"Search\"\n   116→          className=\"flex items-center justify-center rounded-full bg-primary p-3 text-white hover:bg-primary-dark transition-colors shrink-0\"\n   117→        >\n   118→          <Search size={16} aria-hidden=\"true\" />\n   119→        </button>\n   120→      </div>\n   121→    </form>\n   122→  )\n   123→}\n   124→"}]},"parent_tool_use_id":"toolu_01K8gmF3iPxX9iX6L5AoXRWv","session_id":"02a601b0-a58d-4ced-bb22-f466b267f498","uuid":"a9d99025-6496-487d-8ba1-7ded1d882789"}
