details</span>\n    36→      </main>\n    37→    )\n    38→  }\n    39→\n    40→  if (error || !property) {\n    41→    return (\n    42→      <main data-testid=\"property-detail-page\" className=\"p-6 max-sm:p-3 max-w-6xl mx-auto flex flex-col items-center justify-center min-h-[60vh] gap-4\">\n    43→        <p className=\"text-text-secondary\" role=\"alert\">{error || 'Property not found'}</p>\n    44→        <button\n    45→          className=\"text-primary font-semibold hover:underline cursor-pointer\"\n    46→          onClick={() => navigate('/')}\n    47→        >\n    48→          Back to listings\n    49→        </button>\n    50→      </main>\n    51→    )\n    52→  }\n    53→\n    54→  return (\n    55→    <main data-testid=\"property-detail-page\" className=\"px-6 max-sm:px-3 py-6 max-w-6xl mx-auto\">\n    56→      <nav aria-label=\"Property actions\" className=\"flex items-center justify-end mb-6\">\n    57→        <div className=\"flex items-center gap-4 shrink-0\">\n    58→          <button className=\"flex items-center gap-1.5 text-sm font-semibold text-text underline hover:no-underline cursor-pointer\">\n    59→            <Share size={16} aria-hidden=\"true\" />\n    60→            Share\n    61→          </button>\n    62→          <button className=\"flex items-center gap-1.5 text-sm font-semibold text-text underline hover:no-underline cursor-pointer\">\n    63→            <Heart size={16} aria-hidden=\"true\" />\n    64→            Save\n    65→          </button>\n    66→        </div>\n    67→      </nav>\n    68→\n    69→      <ImageGallery images={property.images || []} />\n    70→\n    71→      <div className=\"mt-8 flex flex-col lg:flex-row gap-12\">\n    72→        <div className=\"flex-1 min-w-0\">\n    73→          <PropertyHeader property={property} />\n    74→          <PropertyInfo property={property} />\n    75→          <PropertyDescription description={property.description} />\n    76→          <AmenitiesList amenities={property.