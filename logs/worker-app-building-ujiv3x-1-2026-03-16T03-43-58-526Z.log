       />\n    47→          {mainImage!.caption && (\n    48→            <span className=\"absolute bottom-2 left-2 bg-black/60 text-white text-xs px-2 py-1 rounded\">\n    49→              {mainImage!.caption}\n    50→            </span>\n    51→          )}\n    52→        </div>\n    53→        {thumbnails.slice(0, 4).map((img, i) => {\n    54→          const originalIndex = images.indexOf(img)\n    55→          return (\n    56→            <button\n    57→              key={img.id}\n    58→              data-testid={`thumbnail-${img.id}`}\n    59→              type=\"button\"\n    60→              aria-label={img.caption || `View property image ${originalIndex + 1}`}\n    61→              className={`relative cursor-pointer overflow-hidden hover:opacity-90 transition-opacity ${\n    62→                i === 1 ? 'rounded-tr-xl' : i === 3 ? 'rounded-br-xl' : ''\n    63→              }`}\n    64→              onClick={() => setMainIndex(originalIndex)}\n    65→            >\n    66→              <img\n    67→                src={img.url}\n    68→                alt={img.caption || 'Property image'}\n    69→                className=\"w-full h-full object-cover\"\n    70→              />\n    71→              {img.caption && (\n    72→                <span className=\"absolute bottom-1 left-1 bg-black/60 text-white text-[10px] px-1.5 py-0.5 rounded\">\n    73→                  {img.caption}\n    74→                </span>\n    75→              )}\n    76→            </button>\n    77→          )\n    78→        })}\n    79→      </div>\n    80→      {images.length > 5 && (\n    81→        <button className=\"absolute bottom-4 right-4 flex items-center gap-2 bg-white border border-text rounded-lg px-4 py-1.5 text-sm font-semibold text-text hover:bg-bg-secondary transition-colors cursor-pointer\">\n    82→          <Grid size={14} aria-hidden=\"true\" />\n    83→          Show all photos\n    84→        </button>\n    85→      )}\n    86→    </div>\n    87→  )\n    88→}\n    89→"}]},"parent_tool_use_id":"toolu_01K8gmF3iPxX9iX6L5AoXRWv","session_id":"02a601b0-a58d-4ced-bb22-f466b267f498","uuid":"2d33ddfd-2df7-4d9c-b960-2f3c3948d0b7"}
