text-sm font-medium text-text mb-1\">\n    46→          Name\n    47→        </label>\n    48→        <input\n    49→          id=\"register-name\"\n    50→          type=\"text\"\n    51→          value={name}\n    52→          onChange={(e) => {\n    53→            setName(e.target.value)\n    54→            setValidationError('')\n    55→          }}\n    56→          placeholder=\"Enter your name\"\n    57→          aria-required=\"true\"\n    58→          aria-describedby={displayError ? 'register-error' : undefined}\n    59→          aria-invalid={displayError ? true : undefined}\n    60→          className=\"w-full px-4 py-3 rounded-lg border border-border focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary text-text\"\n    61→          data-testid=\"register-name-input\"\n    62→        />\n    63→      </div>\n    64→\n    65→      <div>\n    66→        <label htmlFor=\"register-email\" className=\"block text-sm font-medium text-text mb-1\">\n    67→          Email\n    68→        </label>\n    69→        <input\n    70→          id=\"register-email\"\n    71→          type=\"email\"\n    72→          value={email}\n    73→          onChange={(e) => {\n    74→            setEmail(e.target.value)\n    75→            setValidationError('')\n    76→          }}\n    77→          placeholder=\"Enter your email\"\n    78→          aria-required=\"true\"\n    79→          aria-describedby={displayError ? 'register-error' : undefined}\n    80→          aria-invalid={displayError ? true : undefined}\n    81→          className=\"w-full px-4 py-3 rounded-lg border border-border focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary text-text\"\n    82→          data-testid=\"register-email-input\"\n    83→        />\n    84→      </div>\n    85→\n    86→      <div aria-live=\"polite\">\n    87→        {displayError && (\n    88→          <p id=\"register-error\" role=\"alert\" className=\"text-error text-sm\" data-testid=\"register-error\">\n    89→            {displayError}\n    90→          </p>\n    91→        )}\n    92→      </div>\n    93→\n    94→      <button\n    95→        type=\"submit\"\n    96→        disabled={loading}\n    97→        aria-busy={loading}\n    98→        className=\"w-full py-3 rounded-lg bg-primary text-white font-semibold hover:bg-primary-dark transition-colors disabled:opacity-50 cursor-pointer\"\n    99→        data-testid=\"register-submit-button\"\n   100→      >\n   101→        {loading ? 'Registering...' : 'Register'}\n   102→      </button>\n   103→    </form>\n   104→  )\n   105→}\n   106→\n   107→export default RegisterForm\n   108→"}]},"parent_tool_use_id":null,"session_id":"02a601b0-a58d-4ced-bb22-f466b267f498","uuid":"e1e32c63-7ae9-49a8-aa93-292733290d72","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/components/RegisterForm.tsx","content":"import { useState } from 'react'\nimport { useDispatch, useSelector } from 'react-redux'\nimport { useNavigate } from 'react-router-dom'\nimport type { AppDispatch, RootState } from '../store'\nimport { registerUser, clearError } from '../slices/authSlice'\n\nfunction RegisterForm() {\n  const [name, setName] = useState('')\n  const [email, setEmail] = useState('')\n  const [validationError, setValidationError] = useState('')\n  const dispatch = useDispatch<AppDispatch>()\n  const navigate = useNavigate()\n  const { loading, error } = useSelector((state: RootState) => state.auth)\n\n  const validate = (): string => {\n    if (!name.trim()) return 'Name is required'\n    if (!email.trim()) return 'Email is required'\n    const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/\n    if (!emailRegex.test(email)) return 'Please enter a valid email address'\n    return ''\n  }\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault()\n    dispatch(clearError())\n\n    const error = validate()\n    if (error) {\n      setValidationError(error)\n      return\n    }\n\n    setValidationError('')\n    const result = await dispatch(registerUser({ name: name.trim(), email: email.trim() }))\n    if (registerUser.fulfilled.match(result)) {\n      navigate('/')\n    }\n  }\n\n  const displayError = validationError || error\n\n  return (\n    <form onSubmit={handleSubmit} data-testid=\"register-form\" className=\"space-y-4\">\n      <div>\n        <label htmlFor=\"register-name\" className=\"block text-sm font-medium text-text mb-1\">\n          Name\n        </label>\n        <input\n          id=\"register-name\"\n          type=\"text\"\n          value={name}\n          onChange={(e) => {\n            setName(e.target.value)\n            setValidationError('')\n          }}\n          placeholder=\"Enter your name\"\n          aria-required=\"true\"\n          aria-describedby={displayError ? 'register-error' : undefined}\n          aria-invalid={displayError ? true : undefined}\n          className=\"w-full px-4 py-3 rounded-lg border border-border focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary text-text\"\n          data-testid=\"register-name-input\"\n        />\n      </div>\n\n      <div>\n        <label htmlFor=\"register-email\" className=\"block text-sm font-medium text-text mb-1\">\n          Email\n        </label>\n        <input\n          id=\"register-email\"\n          type=\"email\"\n          value={email}\n          onChange={(e) => {\n            setEmail(e.target.value)\n            setValidationError('')\n          }}\n          placeholder=\"Enter your email\"\n          aria-required=\"true\"\n          aria-describedby={displayError ? 'register-error' : undefined}\n          aria-invalid={displayError ? true : undefined}\n          className=\"w-full px-4 py-3 rounded-lg border border-border focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary text-text\"\n          data-testid=\"register-email-input\"\n        />\n      </div>\n\n      <div aria-live=\"polite\">\n        {displayError && (\n          <p id=\"register-error\" role=\"alert\" className=\"text-error text-sm\" data-testid=\"register-error\">\n            {displayError}\n          </p>\n        )}\n      </div>\n\n      <button\n        type=\"submit\"\n        disabled={loading}\n        aria-busy={loading}\n        className=\"w-full py-3 rounded-lg bg-primary text-white font-semibold hover:bg-primary-dark transition-colors disabled:opacity-50 cursor-pointer\"\n        data-testid=\"register-submit-button\"\n      >\n        {loading ? 'Registering...' : 'Register'}\n      </button>\n    </form>\n  )\n}\n\nexport default RegisterForm\n","numLines":108,"startLine":1,"totalLines":108}}}
