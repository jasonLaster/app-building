[2026-03-14T23:01:19.877Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017BwcjRif6NkMszXy2GEwut","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test'\n     2→\n     3→// Sarah's host ID and booking IDs\n     4→const SARAH_ID = 'a1111111-1111-1111-1111-111111111111'\n     5→const BOOKING_COMPLETED = 'e1111111-1111-1111-1111-111111111111' // Loft, Emma, completed\n     6→const BOOKING_CONFIRMED_VILLA = 'e2222222-2222-2222-2222-222222222222' // Villa, Alex, confirmed\n     7→const BOOKING_CANCELLED = 'e5555555-5555-5555-5555-555555555555' // Loft, Alex, cancelled\n     8→const BOOKING_CONFIRMED_TOWNHOUSE = 'e6666666-6666-6666-6666-666666666666' // Townhouse, Emma, confirmed\n     9→\n    10→// Property IDs for creating pending bookings\n    11→const PROP_LOFT = 'b1111111-1111-1111-1111-111111111111'\n    12→const GUEST_EMMA = 'a3333333-3333-3333-3333-333333333333'\n    13→\n    14→async function loginAsHost(page: import('@playwright/test').Page) {\n    15→  await page.goto('/login')\n    16→  await page.getByTestId('login-email-input').fill('sarah@example.com')\n    17→  await page.getByTestId('login-submit-button').click()\n    18→  await expect(page).toHaveURL('/', { timeout: 30000 })\n    19→}\n    20→\n    21→async function goToBookingsTab(page: import('@playwright/test').Page) {\n    22→  await loginAsHost(page)\n    23→  await page.goto('/hosting')\n    24→  await expect(page.getByTestId('tab-bookings')).toBeVisible({ timeout: 30000 })\n    25→  await page.getByTestId('tab-bookings').click()\n    26→  await expect(page.getByTestId('bookings-tab')).toBeVisible({ timeout: 15000 })\n    27→}\n    28→\n    29→async function createPendingBooking(request: import('@playwright/test').APIRequestContext, overrides?: { check_in?: string; check_out?: string; total_price?: number; num_guests?: number }) {\n    30→  const response = await request.post('http://localhost:8888/api/bookings', {\n    31→    data: {\n    32→      property_id: PROP_LOFT,\n    33→      guest_id: GUEST_EMMA,\n    34→      check_in: overrides?.check_in || '2027-08-01',\n    35→      check_out: overrides?.check_out || '2027-08-05',\n    36→      num_guests: overrides?.num_guests || 2,\n    37→      total_price: overrides?.total_price || 600,\n    38→    },\n    39→  })\n    40→  return response.json()\n    41→}\n    42→\n    43→test.describe('Host Dashboard - Bookings Tab Display & Filters', () => {\n    44→  test('Bookings tab displays table of bookings for host\\'s properties', async ({ page }) => {\n    45→    await goToBookingsTab(page)\n    46→\n    47→    // Table should be visible\n    48→    const table = page.getByTestId('bookings-table')\n    49→    await expect(table).toBeVisible({ timeout: 15000 })\n    50→\n    51→    // Verify column headers\n    52→    await expect(table.locator('th')).toHaveCount(8)\n    53→    await expect(table).toContainText('Property')\n    54→    await expect(table).toContainText('Guest')\n    55→    await expect(table).toContainText('Check-in')\n    56→    await expect(table).toContainText('Check-out')\n    57→    await expect(table).toContainText('Guests')\n    58→    await expect(table).toContainText('Total')\n    59→    await expect(table).toContainText('Status')\n    60→    await expect(table).toContainText('Actions')\n    61→\n    62→    // Sarah has 4 bookings\n    63→    const rows = page.locator('[data-testid^=\"booking-row-\"]')\n    64→    await expect(rows).toHaveCount(4, { timeout: 15000 })\n    65→  })\n    66→\n    67→  test('Bookings table shows correct data for each booking', async ({ page }) => {\n    68→    await goToBookingsTab(page)\n    69→\n    70→    // Check the confirmed Villa booking (e2222222): Villa, Alex Rivera, Apr 1-7 2026, 6 guests, $2,850, confirmed\n    71→    const villaRow = page.getByTestId(`booking-row-${BOOKING_CONFIRMED_VILLA}`)\n    72→    await expect(villaRow).toBeVisible({ timeout: 15000 })\n    73→    await expect(villaRow).toContainText('Beachfront Villa with Private Pool')\n    74→    await expect(villaRow).toContainText('Alex Rivera')\n    75→    await expect(villaRow).toContainText('Apr 1, 2026')\n    76→    await expect(villaRow).toContainText('Apr 7, 2026')\n    77→    await expect(villaRow).toContainText('6')\n    78→    await expect(villaRow).toContainText('$2,850')\n    79→\n    80→    const villaStatus = page.getByTestId(`booking-status-${BOOKING_CONFIRMED_VILLA}`)\n    81→    await expect(villaStatus).toHaveText(/confirmed/i)\n    82→  })\n    83→\n    84→  test('Bookings tab has status filter controls', async ({ page }) => {\n    85→    await goToBookingsTab(page)\n    86→\n    87→    // All 5 filter buttons should be visible\n    88→    await expect(page.getByTestId('booking-filter-all')).toBeVisible({ timeout: 15000 })\n    89→    await expect(page.getByTestId('booking-filter-pending')).toBeVisible()\n    90→    await expect(page.getByTestId('booking-filter-confirmed')).toBeVisible()\n    91→    await expect(page.getByTestId('booking-filter-cancelled')).toBeVisible()\n    92→    await expect(page.getByTestId('booking-filter-completed')).toBeVisible()\n    93→\n    94→    // \"All\" should be selected by default (has primary bg class)\n    95→    const allFilter = page.getByTestId('booking-filter-all')\n    96→    await expect(allFilter).toHaveClass(/bg-primary/)\n    97→  })\n    98→\n    99→  test('Filtering bookings by Pending status', async ({ page, request }) => {\n   100→    // Create a pending booking for Sarah's property\n   101→    await createPendingBooking(request)\n   102→\n   103→    await goToBookingsTab(page)\n   104→\n   105→    // Should now have 5 bookings total (4 seed + 1 pending)\n   106→    await expect(page.locator('[data-testid^=\"booking-row-\"]')).toHaveCount(5, { timeout: 15000 })\n   107→\n   108→    // Click Pending filter\n   109→    await page.getByTestId('booking-filter-pending').click()\n   110→\n   111→    // Only the pending booking should be visible\n   112→    await expect(page.locator('[data-testid^=\"booking-row-\"]')).toHaveCount(1, { timeout: 15000 })\n   113→\n   114→    // Pending filter should appear active\n   115→    await expect(page.getByTestId('booking-filter-pending')).toHaveClass(/bg-primary/)\n   116→  })\n   117→\n   118→  test('Filtering bookings by Confirmed status', async ({ page }) => {\n   119→    await goToBookingsTab(page)\n   120→\n   121→    await page.getByTestId('booking-filter-confirmed').click()\n   122→\n   123→    // Sarah has 2 confirmed bookings\n   124→    await expect(page.locator('[data-testid^=\"booking-row-\"]')).toHaveCount(2, { timeout: 15000 })\n   125→\n   126→    // Verify both confirmed bookings are visible\n   127→    await expect(page.getByTestId(`booking-row-${BOOKING_CONFIRMED_VILLA}`)).toBeVisible()\n   128→    await expect(page.getByTestId(`booking-row-${BOOKING_CONFIRMED_TOWNHOUSE}`)).toBeVisible()\n   129→  })\n   130→\n   131→  test('Filtering bookings by Completed status', async ({ page }) => {\n   132→    await goToBookingsTab(page)\n   133→\n   134→    await page.getByTestId('booking-filter-completed').click()\n   135→\n   136→    // Sarah has 1 completed booking\n   137→    await expect(page.locator('[data-testid^=\"booking-row-\"]')).toHaveCount(1, { timeout: 15000 })\n   138→    await expect(page.getByTestId(`booking-row-${BOOKING_COMPLETED}`)).toBeVisible()\n   139→  })\n   140→\n   141→  test('Filtering bookings by Cancelled status', async ({ page }) => {\n   142→    await goToBookingsTab(page)\n   143→\n   144→    await page.getByTestId('booking-filter-cancelled').click()\n   145→\n   146→    // Sarah has 1 cancelled booking\n   147→    await expect(page.locator('[data-testid^=\"booking-row-\"]')).toHaveCount(1, { timeout: 15000 })\n   148→    await expect(page.getByTestId(`booking-row-${BOOKING_CANCELLED}`)).toBeVisible()\n   149→  })\n   150→\n   151→  test('Resetting filter to All shows all bookings', async ({ page }) => {\n   152→    await goToBookingsTab(page)\n   153→\n   154→    // First filter by Confirmed\n   155→    await page.getByTestId('booking-filter-confirmed').click()\n   156→    await expect(page.locator('[data-testid^=\"booking-row-\"]')).toHaveCount(2, { timeout: 15000 })\n   157→\n   158→    // Reset to All\n   159→    await page.getByTestId('booking-filter-all').click()\n   160→    await expect(page.locator('[data-testid^=\"booking-row-\"]')).toHaveCount(4, { timeout: 15000 })\n   161→\n   162→    // All filter should be active\n   163→    await expect(page.getByTestId('booking-filter-all')).toHaveClass(/bg-primary/)\n   164→  })\n   165→\n   166→  test('Status filters work on repeated use', async ({ page, request }) => {\n   167→    test.slow()\n   168→    // Create a pending booking so we have all statuses\n   169→    await createPendingBooking(request)\n   170→\n   171→    await goToBookingsTab(page)\n   172→    await expect(page.locator('[data-testid^=\"booking-row-\"]')).toHaveCount(5, { timeout: 15000 })\n   173→\n   174→    // Pending\n   175→    await page.getByTestId('booking-filter-pending').click()\n   176→    await expect(page.locator('[data-testid^=\"booking-row-\"]')).toHaveCount(1, { timeout: 15000 })\n   177→    await expect(page.getByTestId('booking-filter-pending')).toHaveClass(/bg-primary/)\n   178→\n   179→    // Confirmed\n   180→    await page.getByTestId('booking-filter-confirmed').click()\n   181→    await expect(page.locator('[data-testid^=\"booking-row-\"]')).toHaveCount(2, { timeout: 15000 })\n   182→    await expect(page.getByTestId('booking-filter-confirmed')).toHaveClass(/bg-primary/)\n   183→\n   184→    // All\n   185→    await page.getByTestId('booking-filter-all').click()\n   186→    await expect(page.locator('[data-testid^=\"booking-row-\"]')).toHaveCount(5, { timeout: 15000 })\n   187→    await expect(page.getByTestId('booking-filter-all')).toHaveClass(/bg-primary/)\n   188→\n   189→    // Completed\n   190→    await page.getByTestId('booking-filter-completed').click()\n   191→    await expect(page.locator('[data-testid^=\"booking-row-\"]')).toHaveCount(1, { timeout: 15000 })\n   192→    await expect(page.getByTestId('booking-filter-completed')).toHaveClass(/bg-primary/)\n   193→  })\n   194→\n   195→  test('Bookings tab shows empty state when no bookings exist', async ({ page, request }) => {\n   196→    // Make Emma a host (she has no properties, hence no bookings)\n   197→    await request.post('http://localhost:8888/api/users/a3333333-3333-3333-3333-333333333333/become-host')\n   198→\n   199→    // Login as Emma\n   200→    await page.goto('/login')\n   201→    await page.getByTestId('login-email-input').fill('emma@example.com')\n   202→    await page.getByTestId('login-submit-button').click()\n   203→    await expect(page).toHaveURL('/', { timeout: 30000 })\n   204→\n   205→    await page.goto('/hosting')\n   206→    await expect(page.getByTestId('tab-bookings')).toBeVisible({ timeout: 30000 })\n   207→    await page.getByTestId('tab-bookings').click()\n   208→\n   209→    // Should show empty state\n   210→    await expect(page.getByTestId('bookings-empty-state')).toBeVisible({ timeout: 15000 })\n   211→    await expect(page.getByTestId('bookings-empty-state')).toContainText('No bookings yet')\n   212→  })\n   213→\n   214→  test('Completed and cancelled bookings have no action buttons', async ({ page }) => {\n   215→    await goToBookingsTab(page)\n   216→\n   217→    // Completed booking should not have confirm or cancel buttons\n   218→    const completedRow = page.getByTestId(`booking-row-${BOOKING_COMPLETED}`)\n   219→    await expect(completedRow).toBeVisible({ timeout: 15000 })\n   220→    await expect(page.getByTestId(`booking-confirm-${BOOKING_COMPLETED}`)).not.toBeVisible()\n   221→    await expect(page.getByTestId(`booking-cancel-${BOOKING_COMPLETED}`)).not.toBeVisible()\n   222→\n   223→    // Cancelled booking should not have confirm or cancel buttons\n   224→    const cancelledRow = page.getByTestId(`booking-row-${BOOKING_CANCELLED}`)\n   225→    await expect(cancelledRow).toBeVisible()\n   226→    await expect(page.getByTestId(`booking-confirm-${BOOKING_CANCELLED}`)).not.toBeVisible()\n   227→    await expect(page.getByTestId(`booking-cancel-${BOOKING_CANCELLED}`)).not.toBeVisible()\n   228→\n   229→    // Confirmed bookings SHOULD have a cancel button\n   230→    await expect(page.getByTestId(`booking-cancel-${BOOKING_CONFIRMED_VILLA}`)).toBeVisible()\n   231→  })\n   232→\n   233→  test('Status badges display correct colors', async ({ page, request }) => {\n   234→    // Create a pending booking so we have all 4 statuses\n   235→    const pendingBooking = await createPendingBooking(request)\n   236→\n   237→    await goToBookingsTab(page)\n   238→\n   239→    // Pending badge - yellow\n   240→    const pendingStatus = page.getByTestId(`booking-status-${pendingBooking.id}`)\n   241→    await expect(pendingStatus).toBeVisible({ timeout: 15000 })\n   242→    await expect(pendingStatus).toHaveClass(/status-pending/)\n   243→\n   244→    // Confirmed badge - green\n   245→    const confirmedStatus = page.getByTestId(`booking-status-${BOOKING_CONFIRMED_VILLA}`)\n   246→    await expect(confirmedStatus).toHaveClass(/status-confirmed/)\n   247→\n   248→    // Cancelled badge - red\n   249→    const cancelledStatus = page.getByTestId(`booking-status-${BOOKING_CANCELLED}`)\n   250→    await expect(cancelledStatus).toHaveClass(/status-cancelled/)\n   251→\n   252→    // Completed badge - blue\n   253→    const completedStatus = page.getByTestId(`booking-status-${BOOKING_COMPLETED}`)\n   254→    await expect(completedStatus).toHaveClass(/status-completed/)\n   255→  })\n   256→})\n   257→"}]},"parent_tool_use_id":null,"session_id":"d15d4d9a-a65f-4d36-8b15-78c930eaa7a0","uuid":"2a66d848-50cc-42e0-a145-27b5f0c4ee9e","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/tests/host-dashboard-bookings.spec.ts","content":"import { test, expect } from '@playwright/test'\n\n// Sarah's host ID and booking IDs\nconst SARAH_ID = 'a1111111-1111-1111-1111-111111111111'\nconst BOOKING_COMPLETED = 'e1111111-1111-1111-1111-111111111111' // Loft, Emma, completed\nconst BOOKING_CONFIRMED_VILLA = 'e2222222-2222-2222-2222-222222222222' // Villa, Alex, confirmed\nconst BOOKING_CANCELLED = 'e5555555-5555-5555-5555-555555555555' // Loft, Alex, cancelled\nconst BOOKING_CONFIRMED_TOWNHOUSE = 'e6666666-6666-6666-6666-666666666666' // Townhouse, Emma, confirmed\n\n// Property IDs for creating pending bookings\nconst PROP_LOFT = 'b1111111-1111-1111-1111-111111111111'\nconst GUEST_EMMA = 'a3333333-3333-3333-3333-333333333333'\n\nasync function loginAsHost(page: import('@playwright/test').Page) {\n  await page.goto('/login')\n  await page.getByTestId('login-email-input').fill('sarah@example.com')\n  await page.getByTestId('login-submit-button').click()\n  await expect(page).toHaveURL('/', { timeout: 30000 })\n}\n\nasync function goToBookingsTab(page: import('@playwright/test').Page) {\n  await loginAsHost(page)\n  await page.goto('/hosting')\n  await expect(page.getByTestId('tab-bookings')).toBeVisible({ timeout: 30000 })\n  await page.getByTestId('tab-bookings').click()\n  await expect(page.getByTestId('bookings-tab')).toBeVisible({ timeout: 15000 })\n}\n\nasync function createPendingBooking(request: import('@playwright/test').APIRequestContext, overrides?: { check_in?: string; check_out?: string; total_price?: number; num_guests?: number }) {\n  const response = await request.post('http://localhost:8888/api/bookings', {\n    data: {\n      property_id: PROP_LOFT,\n      guest_id: GUEST_EMMA,\n      check_in: overrides?.check_in || '2027-08-01',\n      check_out: overrides?.check_out || '2027-08-05',\n      num_guests: overrides?.num_guests || 2,\n      total_price: overrides?.total_price || 600,\n    },\n  })\n  return response.json()\n}\n\ntest.describe('Host Dashboard - Bookings Tab Display & Filters', () => {\n  test('Bookings tab displays table of bookings for host\\'s properties', async ({ page }) => {\n    await goToBookingsTab(page)\n\n    // Table should be visible\n    const table = page.getByTestId('bookings-table')\n    await expect(table).toBeVisible({ timeout: 15000 })\n\n    // Verify column headers\n    await expect(table.locator('th')).toHaveCount(8)\n    await expect(table).toContainText('Property')\n    await expect(table).toContainText('Guest')\n    await expect(table).toContainText('Check-in')\n    await expect(table).toContainText('Check-out')\n    await expect(table).toContainText('Guests')\n    await expect(table).toContainText('Total')\n    await expect(table).toContainText('Status')\n    await expect(table).toContainText('Actions')\n\n    // Sarah has 4 bookings\n    const rows = page.locator('[data-testid^=\"booking-row-\"]')\n    await expect(rows).toHaveCount(4, { timeout: 15000 })\n  })\n\n  test('Bookings table shows correct data for each booking', async ({ page }) => {\n    await goToBookingsTab(page)\n\n    // Check the confirmed Villa booking (e2222222): Villa, Alex Rivera, Apr 1-7 2026, 6 guests, $2,850, confirmed\n    const villaRow = page.getByTestId(`booking-row-${BOOKING_CONFIRMED_VILLA}`)\n    await expect(villaRow).toBeVisible({ timeout: 15000 })\n    await expect(villaRow).toContainText('Beachfront Villa with Private Pool')\n    await expect(villaRow).toContainText('Alex Rivera')\n    await expect(villaRow).toContainText('Apr 1, 2026')\n    await expect(villaRow).toContainText('Apr 7, 2026')\n    await expect(villaRow).toContainText('6')\n    await expect(villaRow).toContainText('$2,850')\n\n    const villaStatus = page.getByTestId(`booking-status-${BOOKING_CONFIRMED_VILLA}`)\n    await expect(villaStatus).toHaveText(/confirmed/i)\n  })\n\n  test('Bookings tab has status filter controls', async ({ page }) => {\n    await goToBookingsTab(page)\n\n    // All 5 filter buttons should be visible\n    await expect(page.getByTestId('booking-filter-all')).toBeVisible({ timeout: 15000 })\n    await expect(page.getByTestId('booking-filter-pending')).toBeVisible()\n    await expect(page.getByTestId('booking-filter-confirmed')).toBeVisible()\n    await expect(page.getByTestId('booking-filter-cancelled')).toBeVisible()\n    await expect(page.getByTestId('booking-filter-completed')).toBeVisible()\n\n    // \"All\" should be selected by default (has primary bg class)\n    const allFilter = page.getByTestId('booking-filter-all')\n    await expect(allFilter).toHaveClass(/bg-primary/)\n  })\n\n  test('Filtering bookings by Pending status', async ({ page, request }) => {\n    // Create a pending booking for Sarah's property\n    await createPendingBooking(request)\n\n    await goToBookingsTab(page)\n\n    // Should now have 5 bookings total (4 seed + 1 pending)\n    await expect(page.locator('[data-testid^=\"booking-row-\"]')).toHaveCount(5, { timeout: 15000 })\n\n    // Click Pending filter\n    await page.getByTestId('booking-filter-pending').click()\n\n    // Only the pending booking should be visible\n    await expect(page.locator('[data-testid^=\"booking-row-\"]')).toHaveCount(1, { timeout: 15000 })\n\n    // Pending filter should appear active\n    await expect(page.getByTestId('booking-filter-pending')).toHaveClass(/bg-primary/)\n  })\n\n  test('Filtering bookings by Confirmed status', async ({ page }) => {\n    await goToBookingsTab(page)\n\n    await page.getByTestId('booking-filter-confirmed').click()\n\n    // Sarah has 2 confirmed bookings\n    await expect(page.locator('[data-testid^=\"booking-row-\"]')).toHaveCount(2, { timeout: 15000 })\n\n    // Verify both confirmed bookings are visible\n    await expect(page.getByTestId(`booking-row-${BOOKING_CONFIRMED_VILLA}`)).toBeVisible()\n    await expect(page.getByTestId(`booking-row-${BOOKING_CONFIRMED_TOWNHOUSE}`)).toBeVisible()\n  })\n\n  test('Filtering bookings by Completed status', async ({ page }) => {\n    await goToBookingsTab(page)\n\n    await page.getByTestId('booking-filter-completed').click()\n\n    // Sarah has 1 completed booking\n    await expect(page.locator('[data-testid^=\"booking-row-\"]')).toHaveCount(1, { timeout: 15000 })\n    await expect(page.getByTestId(`booking-row-${BOOKING_COMPLETED}`)).toBeVisible()\n  })\n\n  test('Filtering bookings by Cancelled status', async ({ page }) => {\n    await goToBookingsTab(page)\n\n    await page.getByTestId('booking-filter-cancelled').click()\n\n    // Sarah has 1 cancelled booking\n    await expect(page.locator('[data-testid^=\"booking-row-\"]')).toHaveCount(1, { timeout: 15000 })\n    await expect(page.getByTestId(`booking-row-${BOOKING_CANCELLED}`)).toBeVisible()\n  })\n\n  test('Resetting filter to All shows all bookings', async ({ page }) => {\n    await goToBookingsTab(page)\n\n    // First filter by Confirmed\n    await page.getByTestId('booking-filter-confirmed').click()\n    await expect(page.locator('[data-testid^=\"booking-row-\"]')).toHaveCount(2, { timeout: 15000 })\n\n    // Reset to All\n    await page.getByTestId('booking-filter-all').click()\n    await expect(page.locator('[data-testid^=\"booking-row-\"]')).toHaveCount(4, { timeout: 15000 })\n\n    // All filter should be active\n    await expect(page.getByTestId('booking-filter-all')).toHaveClass(/bg-primary/)\n  })\n\n  test('Status filters work on repeated use', async ({ page, request }) => {\n    test.slow()\n    // Create a pending booking so we have all statuses\n    await createPendingBooking(request)\n\n    await goToBookingsTab(page)\n    await expect(page.locator('[data-testid^=\"booking-row-\"]')).toHaveCount(5, { timeout: 15000 })\n\n    // Pending\n    await page.getByTestId('booking-filter-pending').click()\n    await expect(page.locator('[data-testid^=\"booking-row-\"]')).toHaveCount(1, { timeout: 15000 })\n    await expect(page.getByTestId('booking-filter-pending')).toHaveClass(/bg-primary/)\n\n    // Confirmed\n    await page.getByTestId('booking-filter-confirmed').click()\n    await expect(page.locator('[data-testid^=\"booking-row-\"]')).toHaveCount(2, { timeout: 15000 })\n    await expect(page.getByTestId('booking-filter-confirmed')).toHaveClass(/bg-primary/)\n\n    // All\n    await page.getByTestId('booking-filter-all').click()\n    await expect(page.locator('[data-testid^=\"booking-row-\"]')).toHaveCount(5, { timeout: 15000 })\n    await expect(page.getByTestId('booking-filter-all')).toHaveClass(/bg-primary/)\n\n    // Completed\n    await page.getByTestId('booking-filter-completed').click()\n    await expect(page.locator('[data-testid^=\"booking-row-\"]')).toHaveCount(1, { timeout: 15000 })\n    await expect(page.getByTestId('booking-filter-completed')).toHaveClass(/bg-primary/)\n  })\n\n  test('Bookings tab shows empty state when no bookings exist', async ({ page, request }) => {\n    // Make Emma a host (she has no properties, hence no bookings)\n    await request.post('http://localhost:8888/api/users/a3333333-3333-3333-3333-333333333333/become-host')\n\n    // Login as Emma\n    await page.goto('/login')\n    await page.getByTestId('login-email-input').fill('emma@example.com')\n    await page.getByTestId('login-submit-button').click()\n    await expect(page).toHaveURL('/', { timeout: 30000 })\n\n    await page.goto('/hosting')\n    await expect(page.getByTestId('tab-bookings')).toBeVisible({ timeout: 30000 })\n    await page.getByTestId('tab-bookings').click()\n\n    // Should show empty state\n    await expect(page.getByTestId('bookings-empty-state')).toBeVisible({ timeout: 15000 })\n    await expect(page.getByTestId('bookings-empty-state')).toContainText('No bookings yet')\n  })\n\n  test('Completed and cancelled bookings have no action buttons', async ({ page }) => {\n    await goToBookingsTab(page)\n\n    // Completed booking should not have confirm or cancel buttons\n    const completedRow = page.getByTestId(`booking-row-${BOOKING_COMPLETED}`)\n    await expect(completedRow).toBeVisible({ timeout: 15000 })\n    await expect(page.getByTestId(`booking-confirm-${BOOKING_COMPLETED}`)).not.toBeVisible()\n    await expect(page.getByTestId(`booking-cancel-${BOOKING_COMPLETED}`)).not.toBeVisible()\n\n    // Cancelled booking should not have confirm or cancel buttons\n    const cancelledRow = page.getByTestId(`booking-row-${BOOKING_CANCELLED}`)\n    await expect(cancelledRow).toBeVisible()\n    await expect(page.getByTestId(`booking-confirm-${BOOKING_CANCELLED}`)).not.toBeVisible()\n    await expect(page.getByTestId(`booking-cancel-${BOOKING_CANCELLED}`)).not.toBeVisible()\n\n    // Confirmed bookings SHOULD have a cancel button\n    await expect(page.getByTestId(`booking-cancel-${BOOKING_CONFIRMED_VILLA}`)).toBeVisible()\n  })\n\n  test('Status badges display correct colors', async ({ page, request }) => {\n    // Create a pending booking so we have all 4 statuses\n    const pendingBooking = await createPendingBooking(request)\n\n    await goToBookingsTab(page)\n\n    // Pending badge - yellow\n    const pendingStatus = page.getByTestId(`booking-status-${pendingBooking.id}`)\n    await expect(pendingStatus).toBeVisible({ timeout: 15000 })\n    await expect(pendingStatus).toHaveClass(/status-pending/)\n\n    // Confirmed badge - green\n    const confirmedStatus = page.getByTestId(`booking-status-${BOOKING_CONFIRMED_VILLA}`)\n    await expect(confirmedStatus).toHaveClass(/status-confirmed/)\n\n    // Cancelled badge - red\n    const cancelledStatus = page.getByTestId(`booking-status-${BOOKING_CANCELLED}`)\n    await expect(cancelledStatus).toHaveClass(/status-cancelled/)\n\n    // Completed badge - blue\n    const completedStatus = page.getByTestId(`booking-status-${BOOKING_COMPLETED}`)\n    await expect(completedStatus).toHaveClass(/status-completed/)\n  })\n})\n","numLines":257,"startLine":1,"totalLines":257}}}
