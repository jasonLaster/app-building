ck_out, num_guests, total_price, status, special_requests, created_at)\n    43→      VALUES (gen_random_uuid(), ${property_id}, ${guest_id}, ${check_in}, ${check_out}, ${num_guests}, ${total_price}, 'pending', ${special_requests || null}, now())\n    44→      RETURNING *\n    45→    `\n    46→    const booking = result[0]\n    47→    return new Response(JSON.stringify(booking), { status: 201, headers })\n    48→  }\n    49→\n    50→  if (request.method === 'PUT' && bookingId) {\n    51→    const body = await request.json() as { status: string }\n    52→    const { status } = body\n    53→\n    54→    if (!['confirmed', 'cancelled'].includes(status)) {\n    55→      return new Response(JSON.stringify({ error: 'Invalid status' }), { status: 400, headers })\n    56→    }\n    57→\n    58→    const result = await sql`\n    59→      UPDATE bookings SET status = ${status} WHERE id = ${bookingId} RETURNING *\n    60→    `\n    61→    const booking = result[0]\n    62→    if (!booking) {\n    63→      return new Response(JSON.stringify({ error: 'Booking not found' }), { status: 404, headers })\n    64→    }\n    65→    return new Response(JSON.stringify(booking), { status: 200, headers })\n    66→  }\n    67→\n    68→  if (request.method === 'DELETE' && bookingId) {\n    69→    const result = await sql`\n    70→      DELETE FROM bookings WHERE id = ${bookingId} RETURNING *\n    71→    `\n    72→    const booking = result[0]\n    73→    if (!booking) {\n    74→      return new Response(JSON.stringify({ error: 'Booking not found' }), { status: 404, headers })\n    75→    }\n    76→    return new Response(JSON.stringify(booking), { status: 200, headers })\n    77→  }\n    78→\n    79→  if (request.method === 'DELETE' && !bookingId) {\n    80→    // Delete all non-seed bookings (seed IDs follow pattern e*-*-*-*-*)\n    81→    const seedIds = [\n    82→      'e1111111-1111-1111-1111-111111111111',\n    83→      'e2222222-2222-2222-2222-222222222222',\n    84→      'e3333333-3333-3333-3333-333333333333',\n    85→      'e4444444-4444-4444-4444-444444444444',\n    86→      'e5555555-5555-5555-5555-555555555555',\n    87→      'e6666666-6666-6666-6666-666666666666',\n    88→    ]\n    89→    await sql`DELETE FROM bookings WHERE id != ALL(${seedIds})`\n    90→    // Reset seed bookings to original statuses\n    91→    await sql`UPDATE bookings SET status = 'completed' WHERE id = 'e1111111-1111-1111-1111-111111111111'`\n    92→    await sql`UPDATE bookings SET status = 'confirmed' WHERE id = 'e2222222-2222-2222-2222-222222222222'`\n    93→    await sql`UPDATE bookings SET status = 'pending' WHERE id = 'e3333333-3333-3333-3333-333333333333'`\n    94→    await sql`UPDATE bookings SET status = 'completed' WHERE id = 'e4444444-4444-4444-4444-444444444444'`\n    95→    await sql`UPDATE bookings SET status = 'cancelled' WHERE id = 'e5555555-5555-5555-5555-555555555555'`\n    96→    await sql`UPDATE bookings SET status = 'confirmed' WHERE id = 'e6666666-6666-6666-6666-666666666666'`\n    97→    return new Response(JSON.stringify({ success: true }), { status: 200, headers })\n    98→  }\n    99→\n   100→  if (request.method === 'GET') {\n   101→    const guestId = url.searchParams.get('guest_id')\n   102→    if (!guestId) {\n   103→      return new Response(JSON.stringify({ error: 'guest_id is required' }), { status: 400, headers })\n   104→    }\n   105→\n   106→    const bookings = await sql`\n   107→      SELECT b.*,\n   108→        p.title as property_title, p.city as property_city, p.country as property_country,\n   109→        (SELECT url FROM property_images pi WHERE pi.property_id = p.id ORDER BY pi.display_order ASC LIMIT 1) as property_image,\n   110→        CASE WHEN EXISTS (SELECT 1 FROM reviews r WHERE r.booking_id = b.id) THEN true ELSE false END as has_review\n   111→      FROM bookings b\n   112→      JOIN properties p ON p.id = b.property_id\n   113→      WHERE b.guest_id = ${guestId}\n   114→      ORDER BY b.check_in ASC\n   115→    `\n   116→    return new Response(JSON.stringify(bookings), { status: 200, headers })\n   117→  }\n   118→\n   119→  return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers })\n   120→}\n   121→"}]},"parent_tool_use_id":null,"session_id":"d15d4d9a-a65f-4d36-8b15-78c930eaa7a0","uuid":"4d14ca14-62e6-4de7-aa57-32d2771ea1ec","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/netlify/functions/bookings.ts","content":"import type { Context } from '@netlify/functions'\nimport { getSql } from './db.js'\n\nexport default async (request: Request, _context: Context) => {\n  const sql = getSql()\n  const url = new URL(request.url)\n  const segments = url.pathname.split('/').filter(Boolean)\n  const funcIdx = segments.indexOf('bookings')\n  const bookingId = funcIdx >= 0 ? segments[funcIdx + 1] : undefined\n\n  const headers = { 'Content-Type': 'application/json' }\n\n  if (request.method === 'POST') {\n    const body = await request.json() as {\n      property_id: string\n      guest_id: string\n      check_in: string\n      check_out: string\n      num_guests: number\n      total_price: number\n      special_requests?: string\n    }\n\n    const { property_id, guest_id, check_in, check_out, num_guests, total_price, special_requests } = body\n\n    if (!property_id || !guest_id || !check_in || !check_out || !num_guests || !total_price) {\n      return new Response(JSON.stringify({ error: 'Missing required fields' }), { status: 400, headers })\n    }\n\n    const overlap = await sql`\n      SELECT id FROM bookings\n      WHERE property_id = ${property_id}\n      AND status IN ('confirmed', 'pending')\n      AND check_in < ${check_out}\n      AND check_out > ${check_in}\n    `\n    if (overlap.length > 0) {\n      return new Response(JSON.stringify({ error: 'Property is not available for the selected dates' }), { status: 409, headers })\n    }\n\n    const result = await sql`\n      INSERT INTO bookings (id, property_id, guest_id, check_in, check_out, num_guests, total_price, status, special_requests, created_at)\n      VALUES (gen_random_uuid(), ${property_id}, ${guest_id}, ${check_in}, ${check_out}, ${num_guests}, ${total_price}, 'pending', ${special_requests || null}, now())\n      RETURNING *\n    `\n    const booking = result[0]\n    return new Response(JSON.stringify(booking), { status: 201, headers })\n  }\n\n  if (request.method === 'PUT' && bookingId) {\n    const body = await request.json() as { status: string }\n    const { status } = body\n\n    if (!['confirmed', 'cancelled'].includes(status)) {\n      return new Response(JSON.stringify({ error: 'Invalid status' }), { status: 400, headers })\n    }\n\n    const result = await sql`\n      UPDATE bookings SET status = ${status} WHERE id = ${bookingId} RETURNING *\n    `\n    const booking = result[0]\n    if (!booking) {\n      return new Response(JSON.stringify({ error: 'Booking not found' }), { status: 404, headers })\n    }\n    return new Response(JSON.stringify(booking), { status: 200, headers })\n  }\n\n  if (request.method === 'DELETE' && bookingId) {\n    const result = await sql`\n      DELETE FROM bookings WHERE id = ${bookingId} RETURNING *\n    `\n    const booking = result[0]\n    if (!booking) {\n      return new Response(JSON.stringify({ error: 'Booking not found' }), { status: 404, headers })\n    }\n    return new Response(JSON.stringify(booking), { status: 200, headers })\n  }\n\n  if (request.method === 'DELETE' && !bookingId) {\n    // Delete all non-seed bookings (seed IDs follow pattern e*-*-*-*-*)\n    const seedIds = [\n      'e1111111-1111-1111-1111-111111111111',\n      'e2222222-2222-2222-2222-222222222222',\n      'e3333333-3333-3333-3333-333333333333',\n      'e4444444-4444-4444-4444-444444444444',\n      'e5555555-5555-5555-5555-555555555555',\n      'e6666666-6666-6666-6666-666666666666',\n    ]\n    await sql`DELETE FROM bookings WHERE id != ALL(${seedIds})`\n    // Reset seed bookings to original statuses\n    await sql`UPDATE bookings SET status = 'completed' WHERE id = 'e1111111-1111-1111-1111-111111111111'`\n    await sql`UPDATE bookings SET status = 'confirmed' WHERE id = 'e2222222-2222-2222-2222-222222222222'`\n    await sql`UPDATE bookings SET status = 'pending' WHERE id = 'e3333333-3333-3333-3333-333333333333'`\n    await sql`UPDATE bookings SET status = 'completed' WHERE id = 'e4444444-4444-4444-4444-444444444444'`\n    await sql`UPDATE bookings SET status = 'cancelled' WHERE id = 'e5555555-5555-5555-5555-555555555555'`\n    await sql`UPDATE bookings SET status = 'confirmed' WHERE id = 'e6666666-6666-6666-6666-666666666666'`\n    return new Response(JSON.stringify({ success: true }), { status: 200, headers })\n  }\n\n  if (request.method === 'GET') {\n    const guestId = url.searchParams.get('guest_id')\n    if (!guestId) {\n      return new Response(JSON.stringify({ error: 'guest_id is required' }), { status: 400, headers })\n    }\n\n    const bookings = await sql`\n      SELECT b.*,\n        p.title as property_title, p.city as property_city, p.country as property_country,\n        (SELECT url FROM property_images pi WHERE pi.property_id = p.id ORDER BY pi.display_order ASC LIMIT 1) as property_image,\n        CASE WHEN EXISTS (SELECT 1 FROM reviews r WHERE r.booking_id = b.id) THEN true ELSE false END as has_review\n      FROM bookings b\n      JOIN properties p ON p.id = b.property_id\n      WHERE b.guest_id = ${guestId}\n      ORDER BY b.check_in ASC\n    `\n    return new Response(JSON.stringify(bookings), { status: 200, headers })\n  }\n\n  return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers })\n}\n","numLines":121,"startLine":1,"totalLines":121}}}
