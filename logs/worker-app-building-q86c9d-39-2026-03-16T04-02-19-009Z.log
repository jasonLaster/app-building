gits: 0, maximumFractionDigits: 0 })}\n   152→                  </td>\n   153→                  <td className=\"py-3 px-4\">\n   154→                    <span\n   155→                      data-testid={`booking-status-${booking.id}`}\n   156→                      className={`inline-block px-2.5 py-1 rounded-full text-xs font-semibold capitalize ${statusColors[booking.status] || ''}`}\n   157→                    >\n   158→                      {booking.status}\n   159→                    </span>\n   160→                  </td>\n   161→                  <td className=\"py-3 px-4\">\n   162→                    {booking.status === 'pending' && (\n   163→                      <div className=\"flex gap-2\">\n   164→                        <button\n   165→                          data-testid={`booking-confirm-${booking.id}`}\n   166→                          onClick={() => handleConfirm(booking.id)}\n   167→                          disabled={actionLoading === booking.id}\n   168→                          className=\"px-3 py-1.5 text-xs font-medium text-white bg-status-confirmed rounded-lg hover:opacity-90 transition-opacity disabled:opacity-50\"\n   169→                        >\n   170→                          {actionLoading === booking.id ? '...' : 'Confirm'}\n   171→                        </button>\n   172→                        <button\n   173→                          data-testid={`booking-cancel-${booking.id}`}\n   174→                          onClick={(e) => handleCancelClick(booking, e.currentTarget)}\n   175→                          disabled={actionLoading === booking.id}\n   176→                          className=\"px-3 py-1.5 text-xs font-medium text-white bg-status-cancelled rounded-lg hover:opacity-90 transition-opacity disabled:opacity-50\"\n   177→                        >\n   178→                          Cancel\n   179→                        </button>\n   180→                      </div>\n   181→                    )}\n   182→                    {booking.status === 'confirmed' && (\n   183→                      <button\n   184→                        data-testid={`booking-cancel-${booking.id}`}\n   185→                        onClick={(e) => handleCancelClick(booking, e.currentTarget)}\n   186→                        disabled={actionLoading === booking.id}\n   187→                        className=\"px-3 py-1.5 text-xs font-medium text-white bg-status-cancelled rounded-lg hover:opacity-90 transition-opacity disabled:opacity-50\"\n   188→                      >\n   189→                        Cancel\n   190→                      </button>\n   191→                    )}\n   192→                  </td>\n   193→                </tr>\n   194→              ))}\n   195→            </tbody>\n   196→          </table>\n   197→        </div>\n   198→      )}\n   199→\n   200→      {cancelDialog && (\n   201→        <div\n   202→          data-testid=\"cancel-booking-dialog\"\n   203→          className=\"fixed inset-0 bg-black/50 flex items-center justify-center z-50\"\n   204→          onClick={() => setCancelDialog(null)}\n   205→        >\n   206→          <div\n   207→            ref={dialogRef}\n   208→            role=\"dialog\"\n   209→            aria-modal=\"true\"\n   210→            aria-labelledby=\"cancel-booking-dialog-title\"\n   211→            className=\"bg-white rounded-xl p-6 max-w-md w-full mx-4 shadow-lg\"\n   212→            onClick={(e) => e.stopPropagation()}\n   213→          >\n   214→            <h3 id=\"cancel-booking-dialog-title\" className=\"text-lg font-semibold text-text mb-2\">Cancel Booking</h3>\n   215→            <p className=\"text-text-secondary mb-1\">Are you sure you want to cancel this booking?</p>\n   216→            <div className=\"bg-bg-secondary rounded-lg p-3 mb-6 text-sm\">\n   217→              <p className=\"font-medium text-text\">{cancelDialog.property_title}</p>\n   218→              <p className=\"text-text-secondary\">Guest: {cancelDialog.guest_name}</p>\n   219→              <p className=\"text-text-secondary\">\n   220→                {formatDate(cancelDialog.check_in)} — {formatDate(cancelDialog.check_out)}\n   221→              </p>\n   222→            </div>\n   223→            <div className=\"flex gap-3 justify-end\">\n   224→              <button\n   225→                data-testid=\"cancel-booking-dialog-dismiss\"\n   226→                onClick={() => setCancelDialog(null)}\n   227→                className=\"px-4 py-2 text-sm font-medium text-text bg-bg-secondary rounded-lg hover:bg-border transition-colors\"\n   228→              >\n   229→                Keep Booking\n   230→              </button>\n   231→              <button\n   232→                data-testid=\"cancel-booking-dialog-confirm\"\n   233→                onClick={handleConfirmCancel}\n   234→                disabled={actionLoading === cancelDialog.id}\n   235→                className=\"px-4 py-2 text-sm font-medium text-white bg-status-cancelled rounded-lg hover:opacity-90 transition-opacity disabled:opacity-50\"\n   236→              >\n   237→                {actionLoading === cancelDialog.id ? 'Cancelling...' : 'Yes, Cancel'}\n   238→              </button>\n   239→            </div>\n   240→          </div>\n   241→        </div>\n   242→      )}\n   243→    </div>\n   244→  )\n   245→}\n   246→"}]},"parent_tool_use_id":"toolu_015gnvCPVRMwFHcqNtBbjseH","session_id":"8726d00c-8026-4c68-978a-d437b7ce1755","uuid":"07129763-b20e-48c2-b501-4fca4f072c86"}
