[2026-03-16T04:00:45.917Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016m5ZLXiCcVyHknvopHEnWK","type":"tool_result","content":"     1→import { useNavigate } from 'react-router-dom'\n     2→import { Calendar, MapPin } from 'lucide-react'\n     3→import type { Booking } from '../slices/bookingsSlice'\n     4→\n     5→interface TripCardProps {\n     6→  booking: Booking\n     7→  onCancel: () => void\n     8→}\n     9→\n    10→function formatDateRange(checkIn: string, checkOut: string): string {\n    11→  const opts: Intl.DateTimeFormatOptions = { month: 'short', day: 'numeric', year: 'numeric' }\n    12→  const inDate = new Date(checkIn.split('T')[0] + 'T12:00:00')\n    13→  const outDate = new Date(checkOut.split('T')[0] + 'T12:00:00')\n    14→  const inStr = inDate.toLocaleDateString('en-US', opts)\n    15→  const outStr = outDate.toLocaleDateString('en-US', opts)\n    16→  return `${inStr} – ${outStr}`\n    17→}\n    18→\n    19→const statusColors: Record<string, string> = {\n    20→  pending: 'bg-status-pending/15 text-status-pending',\n    21→  confirmed: 'bg-status-confirmed/15 text-status-confirmed',\n    22→  cancelled: 'bg-status-cancelled/15 text-status-cancelled',\n    23→  completed: 'bg-status-completed/15 text-status-completed',\n    24→}\n    25→\n    26→const statusLabels: Record<string, string> = {\n    27→  pending: 'Pending',\n    28→  confirmed: 'Confirmed',\n    29→  cancelled: 'Cancelled',\n    30→  completed: 'Completed',\n    31→}\n    32→\n    33→export default function TripCard({ booking, onCancel }: TripCardProps) {\n    34→  const navigate = useNavigate()\n    35→  const canCancel = booking.status === 'pending' || booking.status === 'confirmed'\n    36→  const canReview = booking.status === 'completed' && !booking.has_review\n    37→  const title = booking.property_title || 'Untitled Property'\n    38→\n    39→  const handleCardClick = () => {\n    40→    navigate(`/properties/${booking.property_id}`)\n    41→  }\n    42→\n    43→  return (\n    44→    <article\n    45→      data-testid={`trip-card-${booking.id}`}\n    46→      className=\"flex gap-4 rounded-xl border border-border hover:shadow-md transition-shadow cursor-pointer overflow-hidden\"\n    47→      onClick={handleCardClick}\n    48→    >\n    49→      <div className=\"w-[180px] h-[140px] shrink-0 overflow-hidden\">\n    50→        {booking.property_image ? (\n    51→          <img\n    52→            src={booking.property_image}\n    53→            alt=\"\"\n    54→            className=\"w-full h-full object-cover\"\n    55→          />\n    56→        ) : (\n    57→          <div className=\"w-full h-full bg-bg-secondary flex items-center justify-center text-text-secondary text-sm\">\n    58→            No image\n    59→          </div>\n    60→        )}\n    61→      </div>\n    62→\n    63→      <div className=\"flex-1 py-3.5 pr-4 flex flex-col justify-between min-w-0\">\n    64→        <div>\n    65→          <div className=\"flex items-center justify-between gap-2\">\n    66→            <h3 className=\"font-semibold text-text text-base truncate\">\n    67→              {title}\n    68→            </h3>\n    69→            <span\n    70→              data-testid={`status-badge-${booking.id}`}\n    71→              className={`shrink-0 text-xs font-semibold px-2.5 py-1 rounded-full ${statusColors[booking.status] || ''}`}\n    72→            >\n    73→              {statusLabels[booking.status] || booking.status}\n    74→            </span>\n    75→          </div>\n    76→          {booking.property_city && (\n    77→            <p className=\"flex items-center gap-1 text-sm text-text-secondary mt-1\">\n    78→              <MapPin size={14} aria-hidden=\"true\" />\n    79→              {booking.property_city}\n    80→              {booking.property_country ? `, ${booking.property_country}` : ''}\n    81→            </p>\n    82→          )}\n    83→          <p className=\"flex items-center gap-1 text-sm text-text-secondary mt-1\">\n    84→            <Calendar size={14} aria-hidden=\"true\" />\n    85→            {formatDateRange(booking.check_in, booking.check_out)}\n    86→          </p>\n    87→        </div>\n    88→\n    89→        <div className=\"flex items-center justify-between mt-2\">\n    90→          <p className=\"text-sm font-semibold text-text\">\n    91→            ${Number(booking.total_price).toFixed(0)}\n    92→          </p>\n    93→          <div className=\"flex gap-2\" onClick={(e) => e.stopPropagation()}>\n    94→            {canCancel && (\n    95→              <button\n    96→                data-testid={`cancel-button-${booking.id}`}\n    97→                onClick={onCancel}\n    98→                aria-label={`Cancel booking for ${title}`}\n    99→                className=\"text-xs font-semibold px-3 py-1.5 rounded-lg border border-border text-text hover:bg-bg-secondary transition-colors\"\n   100→              >\n   101→                Cancel\n   102→              </button>\n   103→            )}\n   104→            {canReview && (\n   105→              <button\n   106→                data-testid={`review-button-${booking.id}`}\n   107→                onClick={() => navigate(`/trips/${booking.id}/review`)}\n   108→                aria-label={`Write review for ${title}`}\n   109→                className=\"text-xs font-semibold px-3 py-1.5 rounded-lg bg-text text-white hover:opacity-90 transition-opacity\"\n   110→              >\n   111→                Write Review\n   112→              </button>\n   113→            )}\n   114→            {booking.status === 'completed' && booking.has_review && (\n   115→              <span\n   116→                data-testid={`reviewed-badge-${booking.id}`}\n   117→                className=\"text-xs font-medium px-3 py-1.5 text-status-confirmed\"\n   118→              >\n   119→                Reviewed\n   120→              </span>\n   121→            )}\n   122→          </div>\n   123→        </div>\n   124→      </div>\n   125→    </article>\n   126→  )\n   127→}\n   128→"}]},"parent_tool_use_id":"toolu_015gnvCPVRMwFHcqNtBbjseH","session_id":"8726d00c-8026-4c68-978a-d437b7ce1755","uuid":"bdac87d8-f823-4783-be8c-4d06deef81f5"}
