[2026-03-16T04:00:46.100Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KXuhvYZEkweSZwtZSY8p4q","type":"tool_result","content":"     1→import { useState, useEffect, useRef, useCallback } from 'react'\n     2→import { Loader2, Calendar } from 'lucide-react'\n     3→import type { HostBooking } from '../slices/hostSlice'\n     4→\n     5→interface BookingsTabProps {\n     6→  bookings: HostBooking[]\n     7→  loading: boolean\n     8→  onConfirm: (bookingId: string) => Promise<void>\n     9→  onCancel: (bookingId: string) => Promise<void>\n    10→}\n    11→\n    12→const STATUS_FILTERS = ['All', 'Pending', 'Confirmed', 'Cancelled', 'Completed'] as const\n    13→type StatusFilter = (typeof STATUS_FILTERS)[number]\n    14→\n    15→const statusColors: Record<string, string> = {\n    16→  pending: 'bg-status-pending/20 text-status-pending',\n    17→  confirmed: 'bg-status-confirmed/20 text-status-confirmed',\n    18→  cancelled: 'bg-status-cancelled/20 text-status-cancelled',\n    19→  completed: 'bg-status-completed/20 text-status-completed',\n    20→}\n    21→\n    22→function formatDate(dateStr: string): string {\n    23→  const d = new Date(dateStr.split('T')[0] + 'T12:00:00')\n    24→  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })\n    25→}\n    26→\n    27→export default function BookingsTab({ bookings, loading, onConfirm, onCancel }: BookingsTabProps) {\n    28→  const [activeFilter, setActiveFilter] = useState<StatusFilter>('All')\n    29→  const [cancelDialog, setCancelDialog] = useState<HostBooking | null>(null)\n    30→  const [actionLoading, setActionLoading] = useState<string | null>(null)\n    31→  const dialogRef = useRef<HTMLDivElement>(null)\n    32→  const triggerRef = useRef<HTMLButtonElement | null>(null)\n    33→\n    34→  const handleKeyDown = useCallback((e: KeyboardEvent) => {\n    35→    if (e.key === 'Escape') {\n    36→      setCancelDialog(null)\n    37→    }\n    38→    if (e.key === 'Tab' && dialogRef.current) {\n    39→      const focusable = dialogRef.current.querySelectorAll<HTMLElement>(\n    40→        'button, [href], input, select, textarea, [tabindex]:not([tabindex=\"-1\"])'\n    41→      )\n    42→      const first = focusable[0]\n    43→      const last = focusable[focusable.length - 1]\n    44→      if (e.shiftKey && document.activeElement === first) {\n    45→        e.preventDefault()\n    46→        last?.focus()\n    47→      } else if (!e.shiftKey && document.activeElement === last) {\n    48→        e.preventDefault()\n    49→        first?.focus()\n    50→      }\n    51→    }\n    52→  }, [])\n    53→\n    54→  useEffect(() => {\n    55→    if (cancelDialog) {\n    56→      document.addEventListener('keydown', handleKeyDown)\n    57→      dialogRef.current?.querySelector<HTMLElement>('button')?.focus()\n    58→      return () => document.removeEventListener('keydown', handleKeyDown)\n    59→    } else {\n    60→      triggerRef.current?.focus()\n    61→    }\n    62→  }, [cancelDialog, handleKeyDown])\n    63→\n    64→  const filteredBookings = activeFilter === 'All'\n    65→    ? bookings\n    66→    : bookings.filter((b) => b.status === activeFilter.toLowerCase())\n    67→\n    68→  const handleConfirm = async (bookingId: string) => {\n    69→    setActionLoading(bookingId)\n    70→    await onConfirm(bookingId)\n    71→    setActionLoading(null)\n    72→  }\n    73→\n    74→  const handleCancelClick = (booking: HostBooking, button: HTMLButtonElement) => {\n    75→    triggerRef.current = button\n    76→    setCancelDialog(booking)\n    77→  }\n    78→\n    79→  const handleConfirmCancel = async () => {\n    80→    if (!cancelDialog) return\n    81→    setActionLoading(cancelDialog.id)\n    82→    await onCancel(cancelDialog.id)\n    83→    setActionLoading(null)\n    84→    setCancelDialog(null)\n    85→  }\n    86→\n    87→  if (loading) {\n    88→    return (\n    89→      <div className=\"flex items-center justify-center py-16\" role=\"status\">\n    90→        <Loader2 size={32} className=\"animate-spin text-primary\" aria-hidden=\"true\" />\n    91→        <span className=\"sr-only\">Loading bookings...</span>\n    92→      </div>\n    93→    )\n    94→  }\n    95→\n    96→  return (\n    97→    <div data-testid=\"bookings-tab\">\n    98→      <div className=\"flex items-center gap-2 mb-6 flex-wrap\" role=\"group\" aria-label=\"Filter bookings by status\">\n    99→        {STATUS_FILTERS.map((filter) => (\n   100→          <button\n   101→            key={filter}\n   102→            data-testid={`booking-filter-${filter.toLowerCase()}`}\n   103→            onClick={() => setActiveFilter(filter)}\n   104→            aria-pressed={activeFilter === filter}\n   105→            className={`px-4 py-2 rounded-full text-sm font-medium transition-colors ${\n   106→              activeFilter === filter\n   107→                ? 'bg-primary text-white'\n   108→                : 'bg-bg-secondary text-text-secondary hover:bg-border'\n   109→            }`}\n   110→          >\n   111→            {filter}\n   112→          </button>\n   113→        ))}\n   114→      </div>\n   115→\n   116→      {filteredBookings.length === 0 ? (\n   117→        <div data-testid=\"bookings-empty-state\" className=\"text-center py-16\">\n   118→          <Calendar size={48} className=\"mx-auto text-text-secondary mb-4 opacity-50\" aria-hidden=\"true\" />\n   119→          <p className=\"text-text-secondary text-lg\">\n   120→            {activeFilter === 'All' ? 'No bookings yet' : `No ${activeFilter.toLowerCase()} bookings`}\n   121→          </p>\n   122→        </div>\n   123→      ) : (\n   124→        <div className=\"overflow-x-auto\">\n   125→          <table data-testid=\"bookings-table\" className=\"w-full\" aria-label=\"Bookings\">\n   126→            <thead>\n   127→              <tr className=\"border-b border-border\">\n   128→                <th className=\"text-left py-3 px-4 text-s