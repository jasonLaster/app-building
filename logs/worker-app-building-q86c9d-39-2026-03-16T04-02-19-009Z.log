[2026-03-16T04:00:42.968Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NaNfPNwBwd9w32rghVywgu","type":"tool_result","content":"     1→import { useEffect, useRef } from 'react'\n     2→import type { Booking } from '../slices/bookingsSlice'\n     3→\n     4→interface CancelBookingDialogProps {\n     5→  booking: Booking\n     6→  onConfirm: () => void\n     7→  onDismiss: () => void\n     8→}\n     9→\n    10→function formatDateRange(checkIn: string, checkOut: string): string {\n    11→  const opts: Intl.DateTimeFormatOptions = { month: 'long', day: 'numeric', year: 'numeric' }\n    12→  const inDate = new Date(checkIn.split('T')[0] + 'T12:00:00')\n    13→  const outDate = new Date(checkOut.split('T')[0] + 'T12:00:00')\n    14→  const inStr = inDate.toLocaleDateString('en-US', opts)\n    15→  const outStr = outDate.toLocaleDateString('en-US', opts)\n    16→  return `${inStr} – ${outStr}`\n    17→}\n    18→\n    19→export default function CancelBookingDialog({ booking, onConfirm, onDismiss }: CancelBookingDialogProps) {\n    20→  const dialogRef = useRef<HTMLDivElement>(null)\n    21→  const dismissRef = useRef<HTMLButtonElement>(null)\n    22→\n    23→  useEffect(() => {\n    24→    dismissRef.current?.focus()\n    25→\n    26→    const handleKeyDown = (e: KeyboardEvent) => {\n    27→      if (e.key === 'Escape') {\n    28→        onDismiss()\n    29→        return\n    30→      }\n    31→      if (e.key === 'Tab' && dialogRef.current) {\n    32→        const focusable = dialogRef.current.querySelectorAll<HTMLElement>(\n    33→          'button, [href], input, select, textarea, [tabindex]:not([tabindex=\"-1\"])'\n    34→        )\n    35→        const first = focusable[0]\n    36→        const last = focusable[focusable.length - 1]\n    37→        if (e.shiftKey && document.activeElement === first) {\n    38→          e.preventDefault()\n    39→          last?.focus()\n    40→        } else if (!e.shiftKey && document.activeElement === last) {\n    41→          e.preventDefault()\n    42→          first?.focus()\n    43→        }\n    44→      }\n    45→    }\n    46→\n    47→    document.addEventListener('keydown', handleKeyDown)\n    48→    return () => document.removeEventListener('keydown', handleKeyDown)\n    49→  }, [onDismiss])\n    50→\n    51→  return (\n    52→    <div\n    53→      data-testid=\"cancel-dialog-overlay\"\n    54→      className=\"fixed inset-0 bg-black/50 flex items-center justify-center z-50\"\n    55→      onClick={onDismiss}\n    56→      role=\"presentation\"\n    57→    >\n    58→      <div\n    59→        ref={dialogRef}\n    60→        data-testid=\"cancel-dialog\"\n    61→        role=\"dialog\"\n    62→        aria-modal=\"true\"\n    63→        aria-labelledby=\"cancel-dialog-title\"\n    64→        className=\"bg-white rounded-xl p-6 max-w-md w-full mx-4 shadow-xl\"\n    65→        onClick={(e) => e.stopPropagation()}\n    66→      >\n    67→        <h2 id=\"cancel-dialog-title\" className=\"text-lg font-semibold text-text mb-2\">Cancel Booking</h2>\n    68→        <p className=\"text-text-secondary mb-4\">\n    69→          Are you sure you want to cancel this booking?\n    70→        </p>\n    71→        <div className=\"bg-bg-secondary rounded-lg p-3 mb-6\">\n    72→          <p className=\"font-medium text-text\">{booking.property_title || 'Untitled Property'}</p>\n    73→          <p className=\"text-sm text-text-secondary mt-1\">\n    74→            {formatDateRange(booking.check_in, booking.check_out)}\n    75→          </p>\n    76→        </div>\n    77→        <div className=\"flex gap-3 justify-end\">\n    78→          <button\n    79→            ref={dismissRef}\n    80→            data-testid=\"cancel-dialog-dismiss\"\n    81→            onClick={onDismiss}\n    82→            className=\"px-4 py-2 text-sm font-medium rounded-lg border border-border text-text hover:bg-bg-secondary transition-colors\"\n    83→          >\n    84→            Keep Booking\n    85→          </button>\n    86→          <button\n    87→            data-testid=\"cancel-dialog-confirm\"\n    88→            onClick={onConfirm}\n    89→            className=\"px-4 py-2 text-sm font-medium rounded-lg bg-status-cancelled text-white hover:bg-status-cancelled/90 transition-colors\"\n    90→          >\n    91→            Yes, Cancel\n    92→          </button>\n    93→        </div>\n    94→      </div>\n    95→    </div>\n    96→  )\n    97→}\n    98→"}]},"parent_tool_use_id":"toolu_015gnvCPVRMwFHcqNtBbjseH","session_id":"8726d00c-8026-4c68-978a-d437b7ce1755","uuid":"dfddd80e-d9c7-4ae4-adc8-952d9665a663"}
