[2026-03-16T04:02:46.771Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SzfsMCB31wRSWjahSSEAVQ","type":"tool_result","content":"     1→import { Home, Calendar, DollarSign, Star } from 'lucide-react'\n     2→import type { HostStats } from '../slices/hostSlice'\n     3→\n     4→interface StatsOverviewProps {\n     5→  stats: HostStats\n     6→  loading: boolean\n     7→}\n     8→\n     9→export default function StatsOverview({ stats, loading }: StatsOverviewProps) {\n    10→  const cards = [\n    11→    {\n    12→      label: 'Total Listings',\n    13→      value: String(stats.totalListings),\n    14→      icon: Home,\n    15→      testId: 'stat-total-listings',\n    16→    },\n    17→    {\n    18→      label: 'Active Bookings',\n    19→      value: String(stats.activeBookings),\n    20→      icon: Calendar,\n    21→      testId: 'stat-active-bookings',\n    22→    },\n    23→    {\n    24→      label: 'Total Earnings',\n    25→      value: `$${stats.totalEarnings.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}`,\n    26→      icon: DollarSign,\n    27→      testId: 'stat-total-earnings',\n    28→    },\n    29→    {\n    30→      label: 'Average Rating',\n    31→      value: stats.reviewCount > 0 ? Number(stats.avgRating).toFixed(1) : '—',\n    32→      icon: Star,\n    33→      testId: 'stat-average-rating',\n    34→    },\n    35→  ]\n    36→\n    37→  if (loading) {\n    38→    return (\n    39→      <section data-testid=\"stats-overview\" aria-label=\"Host statistics\" className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n    40→        <p className=\"sr-only\" aria-live=\"polite\">Loading statistics...</p>\n    41→        {[1, 2, 3, 4].map((i) => (\n    42→          <div key={i} className=\"bg-white rounded-xl border border-border p-5 animate-pulse\" aria-hidden=\"true\">\n    43→            <div className=\"h-4 bg-bg-secondary rounded w-24 mb-3\" />\n    44→            <div className=\"h-8 bg-bg-secondary rounded w-16\" />\n    45→          </div>\n    46→        ))}\n    47→      </section>\n    48→    )\n    49→  }\n    50→\n    51→  return (\n    52→    <section data-testid=\"stats-overview\" aria-label=\"Host statistics\" className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n    53→      {cards.map((card) => (\n    54→        <div\n    55→          key={card.testId}\n    56→          data-testid={card.testId}\n    57→          className=\"bg-white rounded-xl border border-border p-5 flex items-start gap-4\"\n    58→        >\n    59→          <div className=\"w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0\" aria-hidden=\"true\">\n    60→            <card.icon size={20} className=\"text-primary\" />\n    61→          </div>\n    62→          <div>\n    63→            <p className=\"text-sm text-text-secondary font-medium\">{card.label}</p>\n    64→            <p className=\"text-2xl font-bold text-text mt-0.5 flex items-center gap-1\">\n    65→              {card.label === 'Average Rating' && stats.reviewCount > 0 && (\n    66→                <Star size={18} className=\"fill-status-pending text-status-pending\" aria-hidden=\"true\" />\n    67→              )}\n    68→              {card.value}\n    69→            </p>\n    70→          </div>\n    71→        </div>\n    72→      ))}\n    73→    </section>\n    74→  )\n    75→}\n    76→"}]},"parent_tool_use_id":"toolu_01S6e6eLSzEfJMhS9BRQEJGp","session_id":"89faff73-b689-4266-95e8-94a07c37d050","uuid":"fa7ae2fb-4ad0-434d-b461-f5ca214bdd19"}
