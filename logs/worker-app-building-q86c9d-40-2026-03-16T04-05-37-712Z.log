[2026-03-16T04:03:14.429Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015stVTRf62FghgmhmKEkQnf","type":"tool_result","content":"     1→import { useState, useEffect, useCallback, useRef } from 'react'\n     2→import { useSelector, useDispatch } from 'react-redux'\n     3→import { X, Plus, Trash2, ChevronLeft, ChevronRight, Minus, Check, Loader2 } from 'lucide-react'\n     4→import type { RootState, AppDispatch } from '../store'\n     5→import type { Amenity } from '../slices/propertiesSlice'\n     6→import { fetchAmenities } from '../slices/amenitiesSlice'\n     7→import { createProperty } from '../slices/hostSlice'\n     8→\n     9→interface AddListingFormProps {\n    10→  hostId: string\n    11→  onClose: () => void\n    12→  onSuccess: () => void\n    13→}\n    14→\n    15→interface FormData {\n    16→  propertyType: string\n    17→  title: string\n    18→  address: string\n    19→  city: string\n    20→  state: string\n    21→  country: string\n    22→  latitude: number | null\n    23→  longitude: number | null\n    24→  maxGuests: number\n    25→  bedrooms: number\n    26→  beds: number\n    27→  bathrooms: number\n    28→  selectedAmenities: string[]\n    29→  photos: { url: string; caption: string }[]\n    30→  pricePerNight: string\n    31→  cleaningFee: string\n    32→  description: string\n    33→}\n    34→\n    35→const PROPERTY_TYPES = ['Apartment', 'House', 'Cabin', 'Villa', 'Condo', 'Loft', 'Cottage', 'Townhouse']\n    36→const TOTAL_STEPS = 7\n    37→\n    38→const initialFormData: FormData = {\n    39→  propertyType: '',\n    40→  title: '',\n    41→  address: '',\n    42→  city: '',\n    43→  state: '',\n    44→  country: '',\n    45→  latitude: null,\n    46→  longitude: null,\n    47→  maxGuests: 1,\n    48→  bedrooms: 1,\n    49→  beds: 1,\n    50→  bathrooms: 1,\n    51→  selectedAmenities: [],\n    52→  photos: [],\n    53→  pricePerNight: '',\n    54→  cleaningFee: '0',\n    55→  description: '',\n    56→}\n    57→\n    58→interface AddressSuggestion {\n    59→  display_name: string\n    60→  address?: {\n    61→    road?: string\n    62→    house_number?: string\n    63→    city?: string\n    64→    town?: string\n    65→    village?: string\n    66→    state?: string\n    67→    country?: string\n    68→  }\n    69→  lat: string\n    70→  lon: string\n    71→}\n    72→\n    73→export default function AddListingForm({ hostId, onClose, onSuccess }: AddListingFormProps) {\n    74→  const dispatch = useDispatch<AppDispatch>()\n    75→  const amenities = useSelector((state: RootState) => state.amenities.items)\n    76→  const [step, setStep] = useState(1)\n    77→  const [formData, setFormData] = useState<FormData>(initialFormData)\n    78→  const [errors, setErrors] = useState<Record<string, string>>({})\n    79→  const [showDiscardDialog, setShowDiscardDialog] = useState(false)\n    80→  const [publishing, setPublishing] = useState(false)\n    81→  const [photoUrl, setPhotoUrl] = useState('')\n    82→  const [addressSuggestions, setAddressSuggestions] = useState<AddressSuggestion[]>([])\n    83→  const [showSuggestions, setShowSuggestions] = useState(false)\n    84→  const [propertyTypeOpen, setPropertyTypeOpen] = useState(false)\n    85→  const propertyTypeRef = useRef<HTMLDivElement>(null)\n    86→  const debounceRef = useRef<ReturnType<typeof setTimeout> | null>(null)\n    87→  const modalRef = useRef<HTMLDivElement>(null)\n    88→  const discardDialogRef = useRef<HTMLDivElement>(null)\n    89→\n    90→  useEffect(() => {\n    91→    const handleKeyDown = (e: KeyboardEvent) => {\n    92→      if (e.key === 'Escape') {\n    93→        if (showDiscardDialog) {\n    94→          setShowDiscardDialog(false)\n    95→        } else {\n    96→          setShowDiscardDialog(true)\n    97→        }\n    98→      }\n    99→      const activeContainer = showDiscardDialog ? discardDialogRef.current : modalRef.current\n   100→      if (e.key === 'Tab' && activeContainer) {\n   101→        const focusable = activeContainer.querySelectorAll<HTMLElement>(\n   102→          'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex=\"-1\"])'\n   103→        )\n   104→        const first = focusable[0]\n   105→        const last = focusable[focusable.length - 1]\n   106→        if (e.shiftKey && document.activeElement === first) {\n   107→          e.preventDefault()\n   108→          last?.focus()\n   109→        } else if (!e.shiftKey && document.activeElement === last) {\n   110→          e.preventDefault()\n   111→          first?.focus()\n   112→        }\n   113→      }\n   114→    }\n   115→    document.addEventListener('keydown', handleKeyDown)\n   116→    return () => document.removeEventListener('keydown', handleKeyDown)\n   117→  }, [showDiscardDialog])\n   118→\n   119→  useEffect(() => {\n   120→    if (amenities.length === 0) {\n   121→      dispatch(fetchAmenities())\n   122→    }\n   123→  }, [dispatch, amenities.length])\n   124→\n   125→  useEffect(() => {\n   126→    if (!propertyTypeOpen) return\n   127→    const handleClickOutside = (e: MouseEvent) => {\n   128→      if (propertyTypeRef.current && !propertyTypeRef.current.contains(e.target as Node)) {\n   129→        setPropertyTypeOpen(false)\n   130→      }\n   131→    }\n   132→    document.addEventListener('mousedown', handleClickOutside)\n   133→    return () => document.removeEventListener('mousedown', handleClickOutside)\n   134→  }, [propertyTypeOpen])\n   135→\n   136→  const fetchAddressSuggestions = useCallback(async (query: string) => {\n   137→    if (query.length < 3) {\n   138→      setAddressSuggestions([])\n   139→      return\n   140→    }\n   141→    try {\n   142→      const response = await fetch(\n   143→        `https://nominatim.openstreetmap.org/search?format=json&addressdetails=1&q=${encodeURIComponent(query)}&limit=5`\n   144→      )\n   145→      const data = await response.json() as AddressSuggestion[]\n   146→      setAddressSuggestions(data)\n   147→      setShowSuggestions(true)\n   148→    } catch {\n   149→      setAddressSuggestions([])\n   150→    }\n   151→  }, [])\n   152→\n   153→  const handleAddressChange = (value: string) => {\n   154→    setFormData((prev) => ({ ...prev, address: value }))\n   155→    if (debounceRef.current) clearTimeout(debounceRef.current)\n   156→    debounceRef.current = setTimeout(() => {\n   157→      fetchAddressSuggestions(value)\n   158→    }, 300)\n   159→  }\n   160→\n   161→  const handleSelectSuggestion = (suggestion: AddressSuggestion) => {\n   162→    const addr = suggestion.address\n   163→    const road = addr?.house_number ? `${addr.house_number} ${addr.road || ''}` : (addr?.road || '')\n   164→    setFormData((prev) => ({\n   165→      ...prev,\n   166→      address: road || suggestion.display_name,\n   167→      city: addr?.city || addr?.town || addr?.village || '',\n   168→      state: addr?.state || '',\n   169→      country: addr?.country || '',\n   170→      latitude: parseFloat(suggestion.lat),\n   171→      longitude: parseFloat(suggestion.lon),\n   172→    }))\n   173→    setShowSuggestions(false)\n   174→    setAddressSuggestions([])\n   175→  }\n   176→\n   177→  const validateStep = (): boolean => {\n   178→    const newErrors: Record<string, string> = {}\n   179→\n   180→    if (step === 1) {\n   181→      if (!formData.propertyType) newErrors.propertyType = 'Property type is required'\n   182→      if (!formData.title.trim()) newErrors.title = 'Title is required'\n   183→    } else if (step === 2) {\n   184→      if (!formData.city.trim()) newErrors.city = 'City is required'\n   185→      if (!formData.country.trim()) newErrors.country = 'Country is required'\n   186→    } else if (step === 3) {\n   187→      if (formData.maxGuests < 1) newErrors.maxGuests = 'Max guests must be at least 1'\n   188→      if (formData.bedrooms < 1) newErrors.bedrooms = 'At least 1 bedroom is required'\n   189→      if (formData.beds < 1) newErrors.beds = 'At least 1 bed is required'\n   190→      if (formData.bathrooms < 1) newErrors.bathrooms = 'At least 1 bathroom is required'\n   191→    } else if (step === 5) {\n   192→      if (formData.photos.length === 0) newErrors.photos = 'At least one photo is required'\n   193→    } else if (step === 6) {\n   194→      const price = parseFloat(formData.pricePerNight)\n   195→      if (!price || price <= 0) newErrors.pricePerNight = 'Price per night is required and must be greater than 0'\n   196→    }\n   197→\n   198→    setErrors(newErrors)\n   199→    return Object.keys(newErrors).length === 0\n   200→  }\n   201→\n   202→  const handleNext = () => {\n   203→    if (validateStep()) {\n   204→      setStep((s) => Math.min(s + 1, TOTAL_STEPS))\n   205→    }\n   206→  }\n   207→\n   208→  const handleBack = () => {\n   209→    setErrors({})\n   210→    setStep((s) => Math.max(s - 1, 1))\n   211→  }\n   212→\n   213→  const handleAddPhoto = () => {\n   214→    if (!photoUrl.trim()) return\n   215→    setFormData((prev) => ({\n   216→      ...prev,\n   217→      photos: [...prev.photos, { url: photoUrl.trim(), caption: '' }],\n   218→    }))\n   219→    setPhotoUrl('')\n   220→    setErrors((prev) => {\n   221→      const next = { ...prev }\n   222→      delete next.photos\n   223→      return next\n   224→    })\n   225→  }\n   226→\n   227→  const handleRemovePhoto = (index: number) => {\n   228→    setFormData((prev) => ({\n   229→      ...prev,\n   230→      photos: prev.photos.filter((_, i) => i !== index),\n   231→    }))\n   232→  }\n   233→\n   234→  const toggleAmenity = (amenityId: string) => {\n   235→    setFormData((prev) => ({\n   236→      ...prev,\n   237→      selectedAmenities: prev.selectedAmenities.includes(amenityId)\n   238→        ? prev.selectedAmenities.filter((id) => id !== amenityId)\n   239→        : [...prev.selectedAmenities, amenityId],\n   240→    }))\n   241→  }\n   242→\n   243→  const handlePublish = async () => {\n   244→    setPublishing(true)\n   245→    try {\n   246→      const result = await dispatch(createProperty({\n   247→        host_id: hostId,\n   248→        title: formData.title,\n   249→        description: formData.description,\n   250→        property_type: formData.propertyType,\n   251→        price_per_night: parseFloat(formData.pricePerNight),\n   252→        cleaning_fee: parseFloat(formData.cleaningFee) || 0,\n   253→        max_guests: formData.maxGuests,\n   254→        bedrooms: formData.bedrooms,\n   255→        beds: formData.beds,\n   256→        bathrooms: formData.bathrooms,\n   257→        address: formData.address,\n   258→        city: formData.city,\n   259→        state: formData.state || null,\n   260→        country: formData.country,\n   261→        latitude: formData.latitude,\n   262→        longitude: formData.longitude,\n   263→        amenity_ids: formData.selectedAmenities,\n   264→      })).unwrap()\n   265→\n   266→      const propertyId = result.id\n   267→\n   268→      for (let i = 0; i < formData.photos.length; i++) {\n   269→        const photo = formData.photos[i]\n   270→        if (photo) {\n   271→          await fetch('/api/property-images', {\n   272→            method: 'POST',\n   273→            headers: { 'Content-Type': 'application/json' },\n   274→            body: JSON.stringify({\n   275→              property_id: propertyId,\n   276→              url: photo.url,\n   277→              caption: photo.caption,\n   278→              display_order: i,\n   279→            }),\n   280→          })\n   281→        }\n   282→      }\n   283→\n   284→      onSuccess()\n   285→    } catch {\n   286→      setErrors({ publish: 'Failed to publish listing. Please try again.' })\n   287→    } finally {\n   288→      setPublishing(false)\n   289→    }\n   290→  }\n   291→\n   292→  const handleCancel = () => {\n   293→    setShowDiscardDialog(true)\n   294→  }\n   295→\n   296→  const incrementField = (field: 'maxGuests' | 'bedrooms' | 'beds' | 'bathrooms') => {\n   297→    setFormData((prev) => ({ ...prev, [field]: prev[field] + 1 }))\n   298→  }\n   299→\n   300→  const decrementField = (field: 'maxGuests' | 'bedrooms' | 'beds' | 'bathrooms') => {\n   301→    setFormData((prev) => ({ ...prev, [field]: Math.max(0, prev[field] - 1) }))\n   302→  }\n   303→\n   304→  const amenitiesByCategory = amenities.reduce<Record<string, Amenity[]>>((acc, amenity) => {\n   305→    const cat = amenity.category || 'Other'\n   306→    if (!acc[cat]) acc[cat] = []\n   307→    acc[cat].push(amenity)\n   308→    return acc\n   309→  }, {})\n   310→\n   311→  const renderStepIndicator = () => (\n   312→    <nav data-testid=\"step-indicator\" aria-label=\"Form progress\" className=\"flex items-center justify-center gap-2 mb-6\">\n   313→      {Array.from({ length: TOTAL_STEPS }, (_, i) => i + 1).map((s) => (\n   314→        <div\n   315→          key={s}\n   316→          aria-hidden=\"true\"\n   317→          className={`w-8 h-8 rounded-full flex items-center justify-center text-xs font-medium transition-colors ${\n   318→            s < step\n   319→              ? 'bg-primary text-white'\n   320→              : s === step\n   321→                ? 'bg-primary text-white'\n   322→                : 'bg-bg-secondary text-text-secondary'\n   323→          }`}\n   324→        >\n   325→          {s < step ? <Check size={14} /> : s}\n   326→        </div>\n   327→      ))}\n   328→      <span className=\"ml-2 text-sm text-text-secondary\" aria-live=\"polite\">Step {step} of {TOTAL_STEPS}</span>\n   329→    </nav>\n   330→  )\n   331→\n   332→  const renderStep1 = () => (\n   333→    <div data-testid=\"add-listing-step-1\">\n   334→      <h3 className=\"text-lg font-semibold text-text mb-4\">Property Type & Title</h3>\n   335→\n   336→      <div className=\"mb-4\">\n   337→        <label id=\"property-type-label\" className=\"block text-sm font-medium text-text mb-1.5\">Property Type *</label>\n   338→        <div className=\"relative\" ref={propertyTypeRef}>\n   339→          <button\n   340→            type=\"button\"\n   341→            data-testid=\"property-type-select\"\n   342→            aria-haspopup=\"listbox\"\n   343→            aria-expanded={propertyTypeOpen}\n   344→            aria-labelledby=\"property-type-label\"\n   345→            aria-required=\"true\"\n   346→            aria-describedby={errors.propertyType ? 'property-type-error' : undefined}\n   347→            onClick={() => setPropertyTypeOpen(!propertyTypeOpen)}\n   348→            className={`w-full text-left px-4 py-3 rounded-lg border ${\n   349→              errors.propertyType ? 'border-error' : 'border-border'\n   350→            } bg-white text-sm focus:outline-none focus:border-primary`}\n   351→          >\n   352→            {formData.propertyType || 'Select property type...'}\n   353→          </button>\n   354→          {propertyTypeOpen && (\n   355→            <div role=\"listbox\" aria-labelledby=\"property-type-label\" className=\"absolute top-full left-0 right-0 mt-1 bg-white border border-border rounded-lg shadow-lg z-10 max-h-60 overflow-y-auto\">\n   356→              {PROPERTY_TYPES.map((type) => (\n   357→                <button\n   358→                  key={type}\n   359→                  type=\"button\"\n   360→                  role=\"option\"\n   361→                  aria-selected={formData.propertyType === type}\n   362→                  data-testid={`property-type-option-${type.toLowerCase()}`}\n   363→                  onClick={() => {\n   364→                    setFormData((prev) => ({ ...prev, propertyType: type }))\n   365→                    setPropertyTypeOpen(false)\n   366→                    setErrors((prev) => {\n   367→                      const next = { ...prev }\n   368→                      delete next.propertyType\n   369→                      return next\n   370→                    })\n   371→                  }}\n   372→                  className={`w-full text-left px-4 py-2.5 text-sm hover:bg-bg-secondary transition-colors ${\n   373→                    formData.propertyType === type ? 'bg-primary/10 text-primary font-medium' : 'text-text'\n   374→                  }`}\n   375→                >\n   376→                  {type}\n   377→                </button>\n   378→              ))}\n   379→            </div>\n   380→          )}\n   381→        </div>\n   382→        {errors.propertyType && <p id=\"property-type-error\" className=\"text-error text-xs mt-1\" role=\"alert\">{errors.propertyType}</p>}\n   383→      </div>\n   384→\n   385→      <div className=\"mb-4\">\n   386→        <label htmlFor=\"listing-title-input\" className=\"block text-sm font-medium text-text mb-1.5\">Title *</label>\n   387→        <input\n   388→          id=\"listing-title-input\"\n   389→          data-testid=\"listing-title-input\"\n   390→          type=\"text\"\n   391→          aria-required=\"true\"\n   392→          aria-describedby={errors.title ? 'title-error' : undefined}\n   393→          value={formData.title}\n   394→          onChange={(e) => {\n   395→            setFormData((prev) => ({ ...prev, title: e.target.value }))\n   396→            if (errors.title) setErrors((prev) => { const n = { ...prev }; delete n.title; return n })\n   397→          }}\n   398→          placeholder=\"Give your place a catchy title\"\n   399→          className={`w-full px-4 py-3 rounded-lg border ${\n   400→            errors.title ? 'border-error' : 'border-border'\n   401→          } text-sm focus:outline-none focus:border-primary`}\n   402→        />\n   403→        {errors.title && <p id=\"title-error\" className=\"text-error text-xs mt-1\" role=\"alert\">{errors.title}</p>}\n   404→      </div>\n   405→    </div>\n   406→  )\n   407→\n   408→  const renderStep2 = () => (\n   409→    <div data-testid=\"add-listing-step-2\">\n   410→      <h3 className=\"text-lg font-semibold text-text mb-4\">Location</h3>\n   411→\n   412→      <div className=\"mb-4 relative\">\n   413→        <label htmlFor=\"listing-address-input\" className=\"block text-sm font-medium text-text mb-1.5\">Address</label>\n   414→        <input\n   415→          id=\"listing-address-input\"\n   416→          data-testid=\"listing-address-input\"\n   417→          type=\"text\"\n   418→          aria-autocomplete=\"list\"\n   419→          aria-controls={showSuggestions && addressSuggestions.length > 0 ? 'address-suggestions-list' : undefined}\n   420→          value={formData.address}\n   421→          onChange={(e) => handleAddressChange(e.target.value)}\n   422→          onFocus={() => { if (addressSuggestions.length > 0) setShowSuggestions(true) }}\n   423→          placeholder=\"Start typing an address...\"\n   424→          className=\"w-full px-4 py-3 rounded-lg border border-border text-sm focus:outline-none focus:border-primary\"\n   425→        />\n   426→        {showSuggestions && addressSuggestions.length > 0 && (\n   427→          <div\n   428→            id=\"address-suggestions-list\"\n   429→            data-testid=\"address-suggestions\"\n   430→            role=\"listbox\"\n   431→            aria-label=\"Address suggestions\"\n   432→            className=\"absolute top-full left-0 right-0 mt-1 bg-white border border-border rounded-lg shadow-lg z-10 max-h-48 overflow-y-auto\"\n   433→          >\n   434→            {addressSuggestions.map((s, i) => (\n   435→              <button\n   436→                key={i}\n   437→                type=\"button\"\n   438→                role=\"option\"\n   439→                aria-selected={false}\n   440→                onClick={() => handleSelectSuggestion(s)}\n   441→                className=\"w-full text-left px-4 py-2.5 text-sm hover:bg-bg-secondary transition-colors border-b border-border last:border-b-0\"\n   442→              >\n   443→                {s.display_name}\n   444→              </button>\n   445→            ))}\n   446→          </div>\n   447→        )}\n   448→      </div>\n   449→\n   450→      <div className=\"grid grid-cols-2 gap-4 mb-4\">\n   451→        <div>\n   452→          <label htmlFor=\"listing-city-input\" className=\"block text-sm font-medium text-text mb-1.5\">City *</label>\n   453→          <input\n   454→            id=\"listing-city-input\"\n   455→            data-testid=\"listing-city-input\"\n   456→            type=\"text\"\n   457→            aria-required=\"true\"\n   458→            aria-describedby={errors.city ? 'city-error' : undefined}\n   459→            value={formData.city}\n   460→            onChange={(e) => {\n   461→              setFormData((prev) => ({ ...prev, city: e.target.value }))\n   462→              if (errors.city) setErrors((prev) => { const n = { ...prev }; delete n.city; return n })\n   463→            }}\n   464→            placeholder=\"City\"\n   465→            className={`w-full px-4 py-3 rounded-lg border ${\n   466→              errors.city ? 'border-error' : 'border-border'\n   467→            } text-sm focus:outline-none focus:border-primary`}\n   468→          />\n   469→          {errors.city && <p id=\"city-error\" className=\"text-error text-xs mt-1\" role=\"alert\">{errors.city}</p>}\n   470→        </div>\n   471→        <div>\n   472→          <label htmlFor=\"listing-state-input\" className=\"block text-sm font-medium text-text mb-1.5\">State</label>\n   473→          <input\n   474→            id=\"listing-state-input\"\n   475→            data-testid=\"listing-state-input\"\n   476→            type=\"text\"\n   477→            value={formData.state}\n   478→            onChange={(e) => setFormData((prev) => ({ ...prev, state: e.target.value }))}\n   479→            placeholder=\"State/Province\"\n   480→            className=\"w-full px-4 py-3 rounded-lg border border-border text-sm focus:outline-none focus:border-primary\"\n   481→          />\n   482→        </div>\n   483→      </div>\n   484→\n   485→      <div className=\"mb-4\">\n   486→        <label htmlFor=\"listing-country-input\" className=\"block text-sm font-medium text-text mb-1.5\">Country *</label>\n   487→        <input\n   488→          id=\"listing-country-input\"\n   489→          data-testid=\"listing-country-input\"\n   490→          type=\"text\"\n   491→          aria-required=\"true\"\n   492→          aria-describedby={errors.country ? 'country-error' : undefined}\n   493→          value={formData.country}\n   494→          onChange={(e) => {\n   495→            setFormData((prev) => ({ ...prev, country: e.target.value }))\n   496→            if (errors.country) setErrors((prev) => { const n = { ...prev }; delete n.country; return n })\n   497→          }}\n   498→          placeholder=\"Country\"\n   499→          className={`w-full px-4 py-3 rounded-lg border ${\n   500→            errors.country ? 'border-error' : 'border-border'\n   501→          } text-sm focus:outline-none focus:border-primary`}\n   502→        />\n   503→        {errors.country && <p id=\"country-error\" className=\"text-error text-xs mt-1\" role=\"alert\">{errors.country}</p>}\n   504→      </div>\n   505→    </div>\n   506→  )\n   507→\n   508→  const renderStep3 = () => {\n   509→    const fields: { key: 'maxGuests' | 'bedrooms' | 'beds' | 'bathrooms'; label: string }[] = [\n   510→      { key: 'maxGuests', label: 'Max Guests' },\n   511→      { key: 'bedrooms', label: 'Bedrooms' },\n   512→      { key: 'beds', label: 'Beds' },\n   513→      { key: 'bathrooms', label: 'Bathrooms' },\n   514→    ]\n   515→\n   516→    return (\n   517→      <div data-testid=\"add-listing-step-3\">\n   518→        <h3 className=\"text-lg font-semibold text-text mb-4\">Property Details</h3>\n   519→        <div className=\"space-y-4\">\n   520→          {fields.map(({ key, label }) => (\n   521→            <div key={key} className=\"flex items-center justify-between\">\n   522→              <label id={`${key}-label`} className=\"text-sm font-medium text-text\">{label} *</label>\n   523→              <div className=\"flex items-center gap-3\" role=\"group\" aria-labelledby={`${key}-label`}>\n   524→                <button\n   525→                  type=\"button\"\n   526→                  data-testid={`${key}-decrement`}\n   527→                  aria-label={`Decrease ${label}`}\n   528→                  onClick={() => decrementField(key)}\n   529→                  className=\"w-8 h-8 rounded-full border border-border flex items-center justify-center text-text-secondary hover:border-text transition-colors\"\n   530→                >\n   531→                  <Minus size={14} aria-hidden=\"true\" />\n   532→                </button>\n   533→                <span data-testid={`${key}-value`} aria-live=\"polite\" className=\"text-lg font-medium text-text w-8 text-center\">\n   534→                  {formData[key]}\n   535→                </span>\n   536→                <button\n   537→                  type=\"button\"\n   538→                  data-testid={`${key}-increment`}\n   539→                  aria-label={`Increase ${label}`}\n   540→                  onClick={() => incrementField(key)}\n   541→                  className=\"w-8 h-8 rounded-full border border-border flex items-center justify-center text-text-secondary hover:border-text transition-colors\"\n   542→                >\n   543→                  <Plus size={14} aria-hidden=\"true\" />\n   544→                </button>\n   545→              </div>\n   546→              {errors[key] && <p className=\"text-error text-xs\" role=\"alert\">{errors[key]}</p>}\n   547→            </div>\n   548→          ))}\n   549→        </div>\n   550→      </div>\n   551→    )\n   552→  }\n   553→\n   554→  const renderStep4 = () => (\n   555→    <div data-testid=\"add-listing-step-4\">\n   556→      <h3 className=\"text-lg font-semibold text-text mb-4\">Amenities</h3>\n   557→      <p className=\"text-sm text-text-secondary mb-4\">Select the amenities your property offers (optional)</p>\n   558→      {Object.entries(amenitiesByCategory).map(([category, items]) => (\n   559→        <div key={category} className=\"mb-6\">\n   560→          <h4 className=\"text-sm font-semibold text-text mb-2 capitalize\">{category}</h4>\n   561→          <div className=\"grid grid-cols-2 gap-2\">\n   562→            {items.map((amenity) => (\n   563→              <label\n   564→                key={amenity.id}\n   565→                data-testid={`amenity-checkbox-${amenity.id}`}\n   566→                className={`flex items-center gap-2 px-3 py-2.5 rounded-lg border cursor-pointer transition-colors ${\n   567→                  formData.selectedAmenities.includes(amenity.id)\n   568→                    ? 'border-primary bg-primary/5'\n   569→                    : 'border-border hover:border-border-dark'\n   570→                }`}\n   571→              >\n   572→                <input\n   573→                  type=\"checkbox\"\n   574→                  checked={formData.selectedAmenities.includes(amenity.id)}\n   575→                  onChange={() => toggleAmenity(amenity.id)}\n   576→                  className=\"sr-only\"\n   577→                />\n   578→                <div\n   579→                  className={`w-4 h-4 rounded border flex items-center justify-center ${\n   580→                    formData.selectedAmenities.includes(amenity.id)\n   581→                      ? 'bg-primary border-primary'\n   582→                      : 'border-border-dark'\n   583→                  }`}\n   584→                >\n   585→                  {formData.selectedAmenities.includes(amenity.id) && (\n   586→                    <Check size={10} className=\"text-white\" />\n   587→                  )}\n   588→                </div>\n   589→                <span className=\"text-sm text-text\">{amenity.name}</span>\n   590→              </label>\n   591→            ))}\n   592→          </div>\n   593→        </div>\n   594→      ))}\n   595→    </div>\n   596→  )\n   597→\n   598→  const renderStep5 = () => (\n   599→    <div data-testid=\"add-listing-step-5\">\n   600→      <h3 className=\"text-lg font-semibold text-text mb-4\">Photos</h3>\n   601→\n   602→      <div className=\"flex gap-2 mb-4\">\n   603→        <input\n   604→          data-testid=\"photo-url-input\"\n   605→          type=\"text\"\n   606→          aria-label=\"Photo URL\"\n   607→          value={photoUrl}\n   608→          onChange={(e) => setPhotoUrl(e.target.value)}\n   609→          onKeyDown={(e) => { if (e.key === 'Enter') { e.preventDefault(); handleAddPhoto() } }}\n   610→          placeholder=\"Enter image URL...\"\n   611→          className=\"flex-1 px-4 py-3 rounded-lg border border-border text-sm focus:outline-none focus:border-primary\"\n   612→        />\n   613→        <button\n   614→          type=\"button\"\n   615→          data-testid=\"add-photo-button\"\n   616→          onClick={handleAddPhoto}\n   617→          className=\"px-4 py-3 bg-primary text-white rounded-lg text-sm font-medium hover:bg-primary-dark transition-colors\"\n   618→        >\n   619→          Add Photo\n   620→        </button>\n   621→      </div>\n   622→\n   623→      {errors.photos && <p className=\"text-error text-xs mb-3\" role=\"alert\">{errors.photos}</p>}\n   624→\n   625→      {formData.photos.length > 0 && (\n   626→        <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-3\">\n   627→          {formData.photos.map((photo, index) => (\n   628→            <div key={index} data-testid={`photo-item-${index}`} className=\"relative group\">\n   629→              <div className=\"aspect-[4/3] rounded-lg overflow-hidden border border-border\">\n   630→                <img\n   631→                  src={photo.url}\n   632→                  alt={`Photo ${index + 1}`}\n   633→                  className=\"w-full h-full object-cover\"\n   634→                  onError={(e) => {\n   635→                    (e.target as HTMLImageElement).src = ''\n   636→                    ;(e.target as HTMLImageElement).alt = 'Failed to load'\n   637→                  }}\n   638→                />\n   639→              </div>\n   640→              <button\n   641→                type=\"button\"\n   642→                data-testid={`remove-photo-${index}`}\n   643→                aria-label={`Remove photo ${index + 1}`}\n   644→                onClick={() => handleRemovePhoto(index)}\n   645→                className=\"absolute top-2 right-2 w-7 h-7 bg-white/90 rounded-full flex items-center justify-center shadow-sm opacity-0 group-hover:opacity-100 transition-opacity hover:bg-white\"\n   646→              >\n   647→                <Trash2 size={14} className=\"text-status-cancelled\" aria-hidden=\"true\" />\n   648→              </button>\n   649→            </div>\n   650→          ))}\n   651→        </div>\n   652→      )}\n   653→    </div>\n   654→  )\n   655→\n   656→  const renderStep6 = () => (\n   657→    <div data-testid=\"add-listing-step-6\">\n   658→      <h3 className=\"text-lg font-semibold text-text mb-4\">Pricing</h3>\n   659→\n   660→      <div className=\"mb-4\">\n   661→        <label htmlFor=\"price-per-night-input\" className=\"block text-sm font-medium text-text mb-1.5\">Price per Night *</label>\n   662→        <div className=\"relative\">\n   663→          <span className=\"absolute left-4 top-1/2 -translate-y-1/2 text-text-secondary\" aria-hidden=\"true\">$</span>\n   664→          <input\n   665→            id=\"price-per-night-input\"\n   666→            data-testid=\"price-per-night-input\"\n   667→            type=\"text\"\n   668→            inputMode=\"decimal\"\n   669→            aria-required=\"true\"\n   670→            aria-describedby={errors.pricePerNight ? 'price-error' : undefined}\n   671→            value={formData.pricePerNight}\n   672→            onChange={(e) => {\n   673→              const val = e.target.value.replace(/[^0-9.]/g, '')\n   674→              setFormData((prev) => ({ ...prev, pricePerNight: val }))\n   675→              if (errors.pricePerNight) setErrors((prev) => { const n = { ...prev }; delete n.pricePerNight; return n })\n   676→            }}\n   677→            placeholder=\"0\"\n   678→            className={`w-full pl-8 pr-4 py-3 rounded-lg border ${\n   679→              errors.pricePerNight ? 'border-error' : 'border-border'\n   680→            } text-sm focus:outline-none focus:border-primary`}\n   681→          />\n   682→        </div>\n   683→        {errors.pricePerNight && <p id=\"price-error\" className=\"text-error text-xs mt-1\" role=\"alert\">{errors.pricePerNight}</p>}\n   684→      </div>\n   685→\n   686→      <div className=\"mb-4\">\n   687→        <label htmlFor=\"cleaning-fee-input\" className=\"block text-sm font-medium text-text mb-1.5\">Cleaning Fee</label>\n   688→        <div className=\"relative\">\n   689→          <span className=\"absolute left-4 top-1/2 -translate-y-1/2 text-text-secondary\" aria-hidden=\"true\">$</span>\n   690→          <input\n   691→            id=\"cleaning-fee-input\"\n   692→            data-testid=\"cleaning-fee-input\"\n   693→            type=\"text\"\n   694→            inputMode=\"decimal\"\n   695→            value={formData.cleaningFee}\n   696→            onChange={(e) => {\n   697→              const val = e.target.value.replace(/[^0-9.]/g, '')\n   698→              setFormData((prev) => ({ ...prev, cleaningFee: val }))\n   699→            }}\n   700→            placeholder=\"0\"\n   701→            className=\"w-full pl-8 pr-4 py-3 rounded-lg border border-border text-sm focus:outline-none focus:border-primary\"\n   702→          />\n   703→        </div>\n   704→      </div>\n   705→    </div>\n   706→  )\n   707→\n   708→  const renderStep7 = () => {\n   709→    const selectedAmenityNames = amenities\n   710→      .filter((a) => formData.selectedAmenities.includes(a.id))\n   711→      .map((a) => a.name)\n   712→\n   713→    return (\n   714→      <div data-testid=\"add-listing-step-7\">\n   715→        <h3 className=\"text-lg font-semibold text-text mb-4\">Review & Publish</h3>\n   716→\n   717→        {errors.publish && (\n   718→          <div className=\"bg-error/10 text-error text-sm px-4 py-3 rounded-lg mb-4\" role=\"alert\">{errors.publish}</div>\n   719→        )}\n   720→\n   721→        <div className=\"space-y-4\">\n   722→          <div className=\"bg-bg-secondary rounded-lg p-4\">\n   723→            <h4 className=\"text-xs font-semibold text-text-secondary uppercase tracking-wide mb-2\">Property</h4>\n   724→            <p className=\"text-sm\"><strong>Type:</strong> {formData.propertyType}</p>\n   725→            <p className=\"text-sm\"><strong>Title:</strong> {formData.title}</p>\n   726→          </div>\n   727→\n   728→          <div className=\"bg-bg-secondary rounded-lg p-4\">\n   729→            <h4 className=\"text-xs font-semibold text-text-secondary uppercase tracking-wide mb-2\">Location</h4>\n   730→            <p className=\"text-sm\">\n   731→              {[formData.address, formData.city, formData.state, formData.country].filter(Boolean).join(', ')}\n   732→            </p>\n   733→          </div>\n   734→\n   735→          <div className=\"bg-bg-secondary rounded-lg p-4\">\n   736→            <h4 className=\"text-xs font-semibold text-text-secondary uppercase tracking-wide mb-2\">Details</h4>\n   737→            <div className=\"grid grid-cols-2 gap-2 text-sm\">\n   738→              <p><strong>Guests:</strong> {formData.maxGuests}</p>\n   739→              <p><strong>Bedrooms:</strong> {formData.bedrooms}</p>\n   740→              <p><strong>Beds:</strong> {formData.beds}</p>\n   741→              <p><strong>Bathrooms:</strong> {formData.bathrooms}</p>\n   742→            </div>\n   743→          </div>\n   744→\n   745→          {selectedAmenityNames.length > 0 && (\n   746→            <div className=\"bg-bg-secondary rounded-lg p-4\">\n   747→              <h4 className=\"text-xs font-semibold text-text-secondary uppercase tracking-wide mb-2\">Amenities</h4>\n   748→              <p className=\"text-sm\">{selectedAmenityNames.join(', ')}</p>\n   749→            </div>\n   750→          )}\n   751→\n   752→          {formData.photos.length > 0 && (\n   753→            <div className=\"bg-bg-secondary rounded-lg p-4\">\n   754→              <h4 className=\"text-xs font-semibold text-text-secondary uppercase tracking-wide mb-2\">Photos</h4>\n   755→              <div className=\"flex gap-2 overflow-x-auto\">\n   756→                {formData.photos.map((photo, i) => (\n   757→                  <div key={i} className=\"w-20 h-16 rounded-lg overflow-hidden shrink-0 border border-border\">\n   758→                    <img src={photo.url} alt={`Photo ${i + 1}`} className=\"w-full h-full object-cover\" />\n   759→                  </div>\n   760→                ))}\n   761→              </div>\n   762→            </div>\n   763→          )}\n   764→\n   765→          <div className=\"bg-bg-secondary rounded-lg p-4\">\n   766→            <h4 className=\"text-xs font-semibold text-text-secondary uppercase tracking-wide mb-2\">Pricing</h4>\n   767→            <p className=\"text-sm\"><strong>Price per night:</strong> ${formData.pricePerNight}</p>\n   768→            <p className=\"text-sm\"><strong>Cleaning fee:</strong> ${formData.cleaningFee || '0'}</p>\n   769→          </div>\n   770→        </div>\n   771→      </div>\n   772→    )\n   773→  }\n   774→\n   775→  return (\n   776→    <div\n   777→      data-testid=\"add-listing-form\"\n   778→      className=\"fixed inset-0 bg-black/50 flex items-center justify-center z-50\"\n   779→    >\n   780→      <div\n   781→        ref={modalRef}\n   782→        role=\"dialog\"\n   783→        aria-modal=\"true\"\n   784→        aria-labelledby=\"add-listing-dialog-title\"\n   785→        className=\"bg-white rounded-xl w-full max-w-2xl max-h-[90vh] overflow-y-auto mx-4 shadow-lg\"\n   786→      >\n   787→        <div className=\"sticky top-0 bg-white border-b border-border px-6 py-4 flex items-center justify-between z-10\">\n   788→          <h2 id=\"add-listing-dialog-title\" className=\"text-lg font-semibold text-text\">Add New Listing</h2>\n   789→          <button\n   790→            data-testid=\"add-listing-close\"\n   791→            onClick={handleCancel}\n   792→            aria-label=\"Close\"\n   793→            className=\"w-8 h-8 rounded-full hover:bg-bg-secondary flex items-center justify-center transition-colors\"\n   794→          >\n   795→            <X size={20} className=\"text-text-secondary\" aria-hidden=\"true\" />\n   796→          </button>\n   797→        </div>\n   798→\n   799→        <div className=\"px-6 py-6\">\n   800→          {renderStepIndicator()}\n   801→\n   802→          {step === 1 && renderStep1()}\n   803→          {step === 2 && renderStep2()}\n   804→          {step === 3 && renderStep3()}\n   805→          {step === 4 && renderStep4()}\n   806→          {step === 5 && renderStep5()}\n   807→          {step === 6 && renderStep6()}\n   808→          {step === 7 && renderStep7()}\n   809→        </div>\n   810→\n   811→        <div className=\"sticky bottom-0 bg-white border-t border-border px-6 py-4 flex items-center justify-between\">\n   812→          <button\n   813→            data-testid=\"add-listing-cancel\"\n   814→            onClick={handleCancel}\n   815→            className=\"px-4 py-2.5 text-sm font-medium text-text-secondary hover:text-text transition-colors\"\n   816→          >\n   817→            Cancel\n   818→          </button>\n   819→          <div className=\"flex gap-3\">\n   820→            {step > 1 && (\n   821→              <button\n   822→                data-testid=\"add-listing-back\"\n   823→                onClick={handleBack}\n   824→                className=\"flex items-center gap-1.5 px-4 py-2.5 text-sm font-medium text-text bg-bg-secondary rounded-lg hover:bg-border transition-colors\"\n   825→              >\n   826→                <ChevronLeft size={16} aria-hidden=\"true\" />\n   827→                Back\n   828→              </button>\n   829→            )}\n   830→            {step < TOTAL_STEPS ? (\n   831→              <button\n   832→                data-testid=\"add-listing-next\"\n   833→                onClick={handleNext}\n   834→                className=\"flex items-center gap-1.5 px-4 py-2.5 text-sm font-medium text-white bg-primary rounded-lg hover:bg-primary-dark transition-colors\"\n   835→              >\n   836→                Next\n   837→                <ChevronRight size={16} aria-hidden=\"true\" />\n   838→              </button>\n   839→            ) : (\n   840→              <button\n   841→                data-testid=\"add-listing-publish\"\n   842→                onClick={handlePublish}\n   843→                disabled={publishing}\n   844→                className=\"flex items-center gap-1.5 px-6 py-2.5 text-sm font-medium text-white bg-primary rounded-lg hover:bg-primary-dark transition-colors disabled:opacity-50\"\n   845→              >\n   846→                {publishing ? (\n   847→                  <>\n   848→                    <Loader2 size={16} className=\"animate-spin\" aria-hidden=\"true\" />\n   849→                    Publishing...\n   850→                  </>\n   851→                ) : (\n   852→                  'Publish'\n   853→                )}\n   854→              </button>\n   855→            )}\n   856→          </div>\n   857→        </div>\n   858→      </div>\n   859→\n   860→      {showDiscardDialog && (\n   861→        <div\n   862→          data-testid=\"discard-dialog\"\n   863→          className=\"fixed inset-0 bg-black/50 flex items-center justify-center z-[60]\"\n   864→          onClick={() => setShowDiscardDialog(false)}\n   865→        >\n   866→          <div\n   867→            ref={discardDialogRef}\n   868→            role=\"dialog\"\n   869→            aria-modal=\"true\"\n   870→            aria-labelledby=\"discard-dialog-title\"\n   871→            className=\"bg-white rounded-xl p-6 max-w-md w-full mx-4 shadow-lg\"\n   872→            onClick={(e) => e.stopPropagation()}\n   873→          >\n   874→            <h3 id=\"discard-dialog-title\" className=\"text-lg font-semibold text-text mb-2\">Discard your listing?</h3>\n   875→            <p className=\"text-text-secondary mb-6\">All entered information will be lost.</p>\n   876→            <div className=\"flex gap-3 justify-end\">\n   877→              <button\n   878→                data-testid=\"discard-dialog-keep\"\n   879→                onClick={() => setShowDiscardDialog(false)}\n   880→                className=\"px-4 py-2 text-sm font-medium text-text bg-bg-secondary rounded-lg hover:bg-border transition-colors\"\n   881→              >\n   882→                Keep Editing\n   883→              </button>\n   884→              <button\n   885→                data-testid=\"discard-dialog-confirm\"\n   886→                onClick={onClose}\n   887→                className=\"px-4 py-2 text-sm font-medium text-white bg-status-cancelled rounded-lg hover:opacity-90 transition-opacity\"\n   888→              >\n   889→                Discard\n   890→              </button>\n   891→            </div>\n   892→          </div>\n   893→        </div>\n   894→      )}\n   895→    </div>\n   896→  )\n   897→}\n   898→"}]},"parent_tool_use_id":null,"session_id":"89faff73-b689-4266-95e8-94a07c37d050","uuid":"6b02106b-adc7-46cb-ad49-0cd15ea51c05","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/components/AddListingForm.tsx","content":"import { useState, useEffect, useCallback, useRef } from 'react'\nimport { useSelector, useDispatch } from 'react-redux'\nimport { X, Plus, Trash2, ChevronLeft, ChevronRight, Minus, Check, Loader2 } from 'lucide-react'\nimport type { RootState, AppDispatch } from '../store'\nimport type { Amenity } from '../slices/propertiesSlice'\nimport { fetchAmenities } from '../slices/amenitiesSlice'\nimport { createProperty } from '../slices/hostSlice'\n\ninterface AddListingFormProps {\n  hostId: string\n  onClose: () => void\n  onSuccess: () => void\n}\n\ninterface FormData {\n  propertyType: string\n  title: string\n  address: string\n  city: string\n  state: string\n  country: string\n  latitude: number | null\n  longitude: number | null\n  maxGuests: number\n  bedrooms: number\n  beds: number\n  bathrooms: number\n  selectedAmenities: string[]\n  photos: { url: string; caption: string }[]\n  pricePerNight: string\n  cleaningFee: string\n  description: string\n}\n\nconst PROPERTY_TYPES = ['Apartment', 'House', 'Cabin', 'Villa', 'Condo', 'Loft', 'Cottage', 'Townhouse']\nconst TOTAL_STEPS = 7\n\nconst initialFormData: FormData = {\n  propertyType: '',\n  title: '',\n  address: '',\n  city: '',\n  state: '',\n  country: '',\n  latitude: null,\n  longitude: null,\n  maxGuests: 1,\n  bedrooms: 1,\n  beds: 1,\n  bathrooms: 1,\n  selectedAmenities: [],\n  photos: [],\n  pricePerNight: '',\n  cleaningFee: '0',\n  description: '',\n}\n\ninterface AddressSuggestion {\n  display_name: string\n  address?: {\n    road?: string\n    house_number?: string\n    city?: string\n    town?: string\n    village?: string\n    state?: string\n    country?: string\n  }\n  lat: string\n  lon: string\n}\n\nexport default function AddListingForm({ hostId, onClose, onSuccess }: AddListingFormProps) {\n  const dispatch = useDispatch<AppDispatch>()\n  const amenities = useSelector((state: RootState) => state.amenities.items)\n  const [step, setStep] = useState(1)\n  const [formData, setFormData] = useState<FormData>(initialFormData)\n  const [errors, setErrors] = useState<Record<string, string>>({})\n  const [showDiscardDialog, setShowDiscardDialog] = useState(false)\n  const [publishing, setPublishing] = useState(false)\n  const [photoUrl, setPhotoUrl] = useState('')\n  const [addressSuggestions, setAddressSuggestions] = useState<AddressSuggestion[]>([])\n  const [showSuggestions, setShowSuggestions] = useState(false)\n  const [propertyTypeOpen, setPropertyTypeOpen] = useState(false)\n  const propertyTypeRef = useRef<HTMLDivElement>(null)\n  const debounceRef = useRef<ReturnType<typeof setTimeout> | null>(null)\n  const modalRef = useRef<HTMLDivElement>(null)\n  const discardDialogRef = useRef<HTMLDivElement>(null)\n\n  useEffect(() => {\n    const handleKeyDown = (e: KeyboardEvent) => {\n      if (e.key === 'Escape') {\n        if (showDiscardDialog) {\n          setShowDiscardDialog(false)\n        } else {\n          setShowDiscardDialog(true)\n        }\n      }\n      const activeContainer = showDiscardDialog ? discardDialogRef.current : modalRef.current\n      if (e.key === 'Tab' && activeContainer) {\n        const focusable = activeContainer.querySelectorAll<HTMLElement>(\n          'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex=\"-1\"])'\n        )\n        const first = focusable[0]\n        const last = focusable[focusable.length - 1]\n        if (e.shiftKey && document.activeElement === first) {\n          e.preventDefault()\n          last?.focus()\n        } else if (!e.shiftKey && document.activeElement === last) {\n          e.preventDefault()\n          first?.focus()\n        }\n      }\n    }\n    document.addEventListener('keydown', handleKeyDown)\n    return () => document.removeEventListener('keydown', handleKeyDown)\n  }, [showDiscardDialog])\n\n  useEffect(() => {\n    if (amenities.length === 0) {\n      dispatch(fetchAmenities())\n    }\n  }, [dispatch, amenities.length])\n\n  useEffect(() => {\n    if (!propertyTypeOpen) return\n    const handleClickOutside = (e: MouseEvent) => {\n      if (propertyTypeRef.current && !propertyTypeRef.current.contains(e.target as Node)) {\n        setPropertyTypeOpen(false)\n      }\n    }\n    document.addEventListener('mousedown', handleClickOutside)\n    return () => document.removeEventListener('mousedown', handleClickOutside)\n  }, [propertyTypeOpen])\n\n  const fetchAddressSuggestions = useCallback(async (query: string) => {\n    if (query.length < 3) {\n      setAddressSuggestions([])\n      return\n    }\n    try {\n      const response = await fetch(\n        `https://nominatim.openstreetmap.org/search?format=json&addressdetails=1&q=${encodeURIComponent(query)}&limit=5`\n      )\n      const data = await response.json() as AddressSuggestion[]\n      setAddressSuggestions(data)\n      setShowSuggestions(true)\n    } catch {\n      setAddressSuggestions([])\n    }\n  }, [])\n\n  const handleAddressChange = (value: string) => {\n    setFormData((prev) => ({ ...prev, address: value }))\n    if (debounceRef.current) clearTimeout(debounceRef.current)\n    debounceRef.current = setTimeout(() => {\n      fetchAddressSuggestions(value)\n    }, 300)\n  }\n\n  const handleSelectSuggestion = (suggestion: AddressSuggestion) => {\n    const addr = suggestion.address\n    const road = addr?.house_number ? `${addr.house_number} ${addr.road || ''}` : (addr?.road || '')\n    setFormData((prev) => ({\n      ...prev,\n      address: road || suggestion.display_name,\n      city: addr?.city || addr?.town || addr?.village || '',\n      state: addr?.state || '',\n      country: addr?.country || '',\n      latitude: parseFloat(suggestion.lat),\n      longitude: parseFloat(suggestion.lon),\n    }))\n    setShowSuggestions(false)\n    setAddressSuggestions([])\n  }\n\n  const validateStep = (): boolean => {\n    const newErrors: Record<string, string> = {}\n\n    if (step === 1) {\n      if (!formData.propertyType) newErrors.propertyType = 'Property type is required'\n      if (!formData.title.trim()) newErrors.title = 'Title is required'\n    } else if (step === 2) {\n      if (!formData.city.trim()) newErrors.city = 'City is required'\n      if (!formData.country.trim()) newErrors.country = 'Country is required'\n    } else if (step === 3) {\n      if (formData.maxGuests < 1) newErrors.maxGuests = 'Max guests must be at least 1'\n      if (formData.bedrooms < 1) newErrors.bedrooms = 'At least 1 bedroom is required'\n      if (formData.beds < 1) newErrors.beds = 'At least 1 bed is required'\n      if (formData.bathrooms < 1) newErrors.bathrooms = 'At least 1 bathroom is required'\n    } else if (step === 5) {\n      if (formData.photos.length === 0) newErrors.photos = 'At least one photo is required'\n    } else if (step === 6) {\n      const price = parseFloat(formData.pricePerNight)\n      if (!price || price <= 0) newErrors.pricePerNight = 'Price per night is required and must be greater than 0'\n    }\n\n    setErrors(newErrors)\n    return Object.keys(newErrors).length === 0\n  }\n\n  const handleNext = () => {\n    if (validateStep()) {\n      setStep((s) => Math.min(s + 1, TOTAL_STEPS))\n    }\n  }\n\n  const handleBack = () => {\n    setErrors({})\n    setStep((s) => Math.max(s - 1, 1))\n  }\n\n  const handleAddPhoto = () => {\n    if (!photoUrl.trim()) return\n    setFormData((prev) => ({\n      ...prev,\n      photos: [...prev.photos, { url: photoUrl.trim(), caption: '' }],\n    }))\n    setPhotoUrl('')\n    setErrors((prev) => {\n      const next = { ...prev }\n      delete next.photos\n      return next\n    })\n  }\n\n  const handleRemovePhoto = (index: number) => {\n    setFormData((prev) => ({\n      ...prev,\n      photos: prev.photos.filter((_, i) => i !== index),\n    }))\n  }\n\n  const toggleAmenity = (amenityId: string) => {\n    setFormData((prev) => ({\n      ...prev,\n      selectedAmenities: prev.selectedAmenities.includes(amenityId)\n        ? prev.selectedAmenities.filter((id) => id !== amenityId)\n        : [...prev.selectedAmenities, amenityId],\n    }))\n  }\n\n  const handlePublish = async () => {\n    setPublishing(true)\n    try {\n      const result = await dispatch(createProperty({\n        host_id: hostId,\n        title: formData.title,\n        description: formData.description,\n        property_type: formData.propertyType,\n        price_per_night: parseFloat(formData.pricePerNight),\n        cleaning_fee: parseFloat(formData.cleaningFee) || 0,\n        max_guests: formData.maxGuests,\n        bedrooms: formData.bedrooms,\n        beds: formData.beds,\n        bathrooms: formData.bathrooms,\n        address: formData.address,\n        city: formData.city,\n        state: formData.state || null,\n        country: formData.country,\n        latitude: formData.latitude,\n        longitude: formData.longitude,\n        amenity_ids: formData.selectedAmenities,\n      })).unwrap()\n\n      const propertyId = result.id\n\n      for (let i = 0; i < formData.photos.length; i++) {\n        const photo = formData.photos[i]\n        if (photo) {\n          await fetch('/api/property-images', {\n            method: 'POST',\n            headers: { 'Content-Type': 'application/json' },\n            body: JSON.stringify({\n              property_id: propertyId,\n              url: photo.url,\n              caption: photo.caption,\n              display_order: i,\n            }),\n          })\n        }\n      }\n\n      onSuccess()\n    } catch {\n      setErrors({ publish: 'Failed to publish listing. Please try again.' })\n    } finally {\n      setPublishing(false)\n    }\n  }\n\n  const handleCancel = () => {\n    setShowDiscardDialog(true)\n  }\n\n  const incrementField = (field: 'maxGuests' | 'bedrooms' | 'beds' | 'bathrooms') => {\n    setFormData((prev) => ({ ...prev, [field]: prev[field] + 1 }))\n  }\n\n  const decrementField = (field: 'maxGuests' | 'bedrooms' | 'beds' | 'bathrooms') => {\n    setFormData((prev) => ({ ...prev, [field]: Math.max(0, prev[field] - 1) }))\n  }\n\n  const amenitiesByCategory = amenities.reduce<Record<string, Amenity[]>>((acc, amenity) => {\n    const cat = amenity.category || 'Other'\n    if (!acc[cat]) acc[cat] = []\n    acc[cat].push(amenity)\n    return acc\n  }, {})\n\n  const renderStepIndicator = () => (\n    <nav data-testid=\"step-indicator\" aria-label=\"Form progress\" className=\"flex items-center justify-center gap-2 mb-6\">\n      {Array.from({ length: TOTAL_STEPS }, (_, i) => i + 1).map((s) => (\n        <div\n          key={s}\n          aria-hidden=\"true\"\n          className={`w-8 h-8 rounded-full flex items-center justify-center text-xs font-medium transition-colors ${\n            s < step\n              ? 'bg-primary text-white'\n              : s === step\n                ? 'bg-primary text-white'\n                : 'bg-bg-secondary text-text-secondary'\n          }`}\n        >\n          {s < step ? <Check size={14} /> : s}\n        </div>\n      ))}\n      <span className=\"ml-2 text-sm text-text-secondary\" aria-live=\"polite\">Step {step} of {TOTAL_STEPS}</span>\n    </nav>\n  )\n\n  const renderStep1 = () => (\n    <div data-testid=\"add-listing-step-1\">\n      <h3 className=\"text-lg font-semibold text-text mb-4\">Property Type & Title</h3>\n\n      <div className=\"mb-4\">\n        <label id=\"property-type-label\" className=\"block text-sm font-medium text-text mb-1.5\">Property Type *</label>\n        <div className=\"relative\" ref={propertyTypeRef}>\n          <button\n            type=\"button\"\n            data-testid=\"property-type-select\"\n            aria-haspopup=\"listbox\"\n            aria-expanded={propertyTypeOpen}\n            aria-labelledby=\"property-type-label\"\n            aria-required=\"true\"\n            aria-describedby={errors.propertyType ? 'property-type-error' : undefined}\n            onClick={() => setPropertyTypeOpen(!propertyTypeOpen)}\n            className={`w-full text-left px-4 py-3 rounded-lg border ${\n              errors.propertyType ? 'border-error' : 'border-border'\n            } bg-white text-sm focus:outline-none focus:border-primary`}\n          >\n            {formData.propertyType || 'Select property type...'}\n          </button>\n          {propertyTypeOpen && (\n            <div role=\"listbox\" aria-labelledby=\"property-type-label\" className=\"absolute top-full left-0 right-0 mt-1 bg-white border border-border rounded-lg shadow-lg z-10 max-h-60 overflow-y-auto\">\n              {PROPERTY_TYPES.map((type) => (\n                <button\n                  key={type}\n                  type=\"button\"\n                  role=\"option\"\n                  aria-selected={formData.propertyType === type}\n                  data-testid={`property-type-option-${type.toLowerCase()}`}\n                  onClick={() => {\n                    setFormData((prev) => ({ ...prev, propertyType: type }))\n                    setPropertyTypeOpen(false)\n                    setErrors((prev) => {\n                      const next = { ...prev }\n                      delete next.propertyType\n                      return next\n                    })\n                  }}\n                  className={`w-full text-left px-4 py-2.5 text-sm hover:bg-bg-secondary transition-colors ${\n                    formData.propertyType === type ? 'bg-primary/10 text-primary font-medium' : 'text-text'\n                  }`}\n                >\n                  {type}\n                </button>\n              ))}\n            </div>\n          )}\n        </div>\n        {errors.propertyType && <p id=\"property-type-error\" className=\"text-error text-xs mt-1\" role=\"alert\">{errors.propertyType}</p>}\n      </div>\n\n      <div className=\"mb-4\">\n        <label htmlFor=\"listing-title-input\" className=\"block text-sm font-medium text-text mb-1.5\">Title *</label>\n        <input\n          id=\"listing-title-input\"\n          data-testid=\"listing-title-input\"\n          type=\"text\"\n          aria-required=\"true\"\n          aria-describedby={errors.title ? 'title-error' : undefined}\n          value={formData.title}\n          onChange={(e) => {\n            setFormData((prev) => ({ ...prev, title: e.target.value }))\n            if (errors.title) setErrors((prev) => { const n = { ...prev }; delete n.title; return n })\n          }}\n          placeholder=\"Give your place a catchy title\"\n          className={`w-full px-4 py-3 rounded-lg border ${\n            errors.title ? 'border-error' : 'border-border'\n          } text-sm focus:outline-none focus:border-primary`}\n        />\n        {errors.title && <p id=\"title-error\" className=\"text-error text-xs mt-1\" role=\"alert\">{errors.title}</p>}\n      </div>\n    </div>\n  )\n\n  const renderStep2 = () => (\n    <div data-testid=\"add-listing-step-2\">\n      <h3 className=\"text-lg font-semibold text-text mb-4\">Location</h3>\n\n      <div className=\"mb-4 relative\">\n        <label htmlFor=\"listing-address-input\" className=\"block text-sm font-medium text-text mb-1.5\">Address</label>\n        <input\n          id=\"listing-address-input\"\n          data-testid=\"listing-address-input\"\n          type=\"text\"\n          aria-autocomplete=\"list\"\n          aria-controls={showSuggestions && addressSuggestions.length > 0 ? 'address-suggestions-list' : undefined}\n          value={formData.address}\n          onChange={(e) => handleAddressChange(e.target.value)}\n          onFocus={() => { if (addressSuggestions.length > 0) setShowSuggestions(true) }}\n          placeholder=\"Start typing an address...\"\n          className=\"w-full px-4 py-3 rounded-lg border border-border text-sm focus:outline-none focus:border-primary\"\n        />\n        {showSuggestions && addressSuggestions.length > 0 && (\n          <div\n            id=\"address-suggestions-list\"\n            data-testid=\"address-suggestions\"\n            role=\"listbox\"\n            aria-label=\"Address suggestions\"\n            className=\"absolute top-full left-0 right-0 mt-1 bg-white border border-border rounded-lg shadow-lg z-10 max-h-48 overflow-y-auto\"\n          >\n            {addressSuggestions.map((s, i) => (\n              <button\n                key={i}\n                type=\"button\"\n                role=\"option\"\n                aria-selected={false}\n                onClick={() => handleSelectSuggestion(s)}\n                className=\"w-full text-left px-4 py-2.5 text-sm hover:bg-bg-secondary transition-colors border-b border-border last:border-b-0\"\n              >\n                {s.display_name}\n              </button>\n            ))}\n          </div>\n        )}\n      </div>\n\n      <div className=\"grid grid-cols-2 gap-4 mb-4\">\n        <div>\n          <label htmlFor=\"listing-city-input\" className=\"block text-sm font-medium text-text mb-1.5\">City *</label>\n          <input\n            id=\"listing-city-input\"\n            data-testid=\"listing-city-input\"\n            type=\"text\"\n            aria-required=\"true\"\n            aria-describedby={errors.city ? 'city-error' : undefined}\n            value={formData.city}\n            onChange={(e) => {\n              setFormData((prev) => ({ ...prev, city: e.target.value }))\n              if (errors.city) setErrors((prev) => { const n = { ...prev }; delete n.city; return n })\n            }}\n            placeholder=\"City\"\n            className={`w-full px-4 py-3 rounded-lg border ${\n              errors.city ? 'border-error' : 'border-border'\n            } text-sm focus:outline-none focus:border-primary`}\n          />\n          {errors.city && <p id=\"city-error\" className=\"text-error text-xs mt-1\" role=\"alert\">{errors.city}</p>}\n        </div>\n        <div>\n          <label htmlFor=\"listing-state-input\" className=\"block text-sm font-medium text-text mb-1.5\">State</label>\n          <input\n            id=\"listing-state-input\"\n            data-testid=\"listing-state-input\"\n            type=\"text\"\n            value={formData.state}\n            onChange={(e) => setFormData((prev) => ({ ...prev, state: e.target.value }))}\n            placeholder=\"State/Province\"\n            className=\"w-full px-4 py-3 rounded-lg border border-border text-sm focus:outline-none focus:border-primary\"\n          />\n        </div>\n      </div>\n\n      <div className=\"mb-4\">\n        <label htmlFor=\"listing-country-input\" className=\"block text-sm font-medium text-text mb-1.5\">Country *</label>\n        <input\n          id=\"listing-country-input\"\n          data-testid=\"listing-country-input\"\n          type=\"text\"\n          aria-required=\"true\"\n          aria-describedby={errors.country ? 'country-error' : undefined}\n          value={formData.country}\n          onChange={(e) => {\n            setFormData((prev) => ({ ...prev, country: e.target.value }))\n            if (errors.country) setErrors((prev) => { const n = { ...prev }; delete n.country; return n })\n          }}\n          placeholder=\"Country\"\n          className={`w-full px-4 py-3 rounded-lg border ${\n            errors.country ? 'border-error' : 'border-border'\n          } text-sm focus:outline-none focus:border-primary`}\n        />\n        {errors.country && <p id=\"country-error\" className=\"text-error text-xs mt-1\" role=\"alert\">{errors.country}</p>}\n      </div>\n    </div>\n  )\n\n  const renderStep3 = () => {\n    const fields: { key: 'maxGuests' | 'bedrooms' | 'beds' | 'bathrooms'; label: string }[] = [\n      { key: 'maxGuests', label: 'Max Guests' },\n      { key: 'bedrooms', label: 'Bedrooms' },\n      { key: 'beds', label: 'Beds' },\n      { key: 'bathrooms', label: 'Bathrooms' },\n    ]\n\n    return (\n      <div data-testid=\"add-listing-step-3\">\n        <h3 className=\"text-lg font-semibold text-text mb-4\">Property Details</h3>\n        <div className=\"space-y-4\">\n          {fields.map(({ key, label }) => (\n            <div key={key} className=\"flex items-center justify-between\">\n              <label id={`${key}-label`} className=\"text-sm font-medium text-text\">{label} *</label>\n              <div className=\"flex items-center gap-3\" role=\"group\" aria-labelledby={`${key}-label`}>\n                <button\n                  type=\"button\"\n                  data-testid={`${key}-decrement`}\n                  aria-label={`Decrease ${label}`}\n                  onClick={() => decrementField(key)}\n                  className=\"w-8 h-8 rounded-full border border-border flex items-center justify-center text-text-secondary hover:border-text transition-colors\"\n                >\n                  <Minus size={14} aria-hidden=\"true\" />\n                </button>\n                <span data-testid={`${key}-value`} aria-live=\"polite\" className=\"text-lg font-medium text-text w-8 text-center\">\n                  {formData[key]}\n                </span>\n                <button\n                  type=\"button\"\n                  data-testid={`${key}-increment`}\n                  aria-label={`Increase ${label}`}\n                  onClick={() => incrementField(key)}\n                  className=\"w-8 h-8 rounded-full border border-border flex items-center justify-center text-text-secondary hover:border-text transition-colors\"\n                >\n                  <Plus size={14} aria-hidden=\"true\" />\n                </button>\n              </div>\n              {errors[key] && <p className=\"text-error text-xs\" role=\"alert\">{errors[key]}</p>}\n            </div>\n          ))}\n        </div>\n      </div>\n    )\n  }\n\n  const renderStep4 = () => (\n    <div data-testid=\"add-listing-step-4\">\n      <h3 className=\"text-lg font-semibold text-text mb-4\">Amenities</h3>\n      <p className=\"text-sm text-text-secondary mb-4\">Select the amenities your property offers (optional)</p>\n      {Object.entries(amenitiesByCategory).map(([category, items]) => (\n        <div key={category} className=\"mb-6\">\n          <h4 className=\"text-sm font-semibold text-text mb-2 capitalize\">{category}</h4>\n          <div className=\"grid grid-cols-2 gap-2\">\n            {items.map((amenity) => (\n              <label\n                key={amenity.id}\n                data-testid={`amenity-checkbox-${amenity.id}`}\n                className={`flex items-center gap-2 px-3 py-2.5 rounded-lg border cursor-pointer transition-colors ${\n                  formData.selectedAmenities.includes(amenity.id)\n                    ? 'border-primary bg-primary/5'\n                    : 'border-border hover:border-border-dark'\n                }`}\n              >\n                <input\n                  type=\"checkbox\"\n                  checked={formData.selectedAmenities.includes(amenity.id)}\n                  onChange={() => toggleAmenity(amenity.id)}\n                  className=\"sr-only\"\n                />\n                <div\n                  className={`w-4 h-4 rounded border flex items-center justify-center ${\n                    formData.selectedAmenities.includes(amenity.id)\n                      ? 'bg-primary border-primary'\n                      : 'border-border-dark'\n                  }`}\n                >\n                  {formData.selectedAmenities.includes(amenity.id) && (\n                    <Check size={10} className=\"text-white\" />\n                  )}\n                </div>\n                <span className=\"text-sm text-text\">{amenity.name}</span>\n              </label>\n            ))}\n          </div>\n        </div>\n      ))}\n    </div>\n  )\n\n  const renderStep5 = () => (\n    <div data-testid=\"add-listing-step-5\">\n      <h3 className=\"text-lg font-semibold text-text mb-4\">Photos</h3>\n\n      <div className=\"flex gap-2 mb-4\">\n        <input\n          data-testid=\"photo-url-input\"\n          type=\"text\"\n          aria-label=\"Photo URL\"\n          value={photoUrl}\n          onChange={(e) => setPhotoUrl(e.target.value)}\n          onKeyDown={(e) => { if (e.key === 'Enter') { e.preventDefault(); handleAddPhoto() } }}\n          placeholder=\"Enter image URL...\"\n          className=\"flex-1 px-4 py-3 rounded-lg border border-border text-sm focus:outline-none focus:border-primary\"\n        />\n        <button\n          type=\"button\"\n          data-testid=\"add-photo-button\"\n          onClick={handleAddPhoto}\n          className=\"px-4 py-3 bg-primary text-white rounded-lg text-sm font-medium hover:bg-primary-dark transition-colors\"\n        >\n          Add Photo\n        </button>\n      </div>\n\n      {errors.photos && <p className=\"text-error text-xs mb-3\" role=\"alert\">{errors.photos}</p>}\n\n      {formData.photos.length > 0 && (\n        <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-3\">\n          {formData.photos.map((photo, index) => (\n            <div key={index} data-testid={`photo-item-${index}`} className=\"relative group\">\n              <div className=\"aspect-[4/3] rounded-lg overflow-hidden border border-border\">\n                <img\n                  src={photo.url}\n                  alt={`Photo ${index + 1}`}\n                  className=\"w-full h-full object-cover\"\n                  onError={(e) => {\n                    (e.target as HTMLImageElement).src = ''\n                    ;(e.target as HTMLImageElement).alt = 'Failed to load'\n                  }}\n                />\n              </div>\n              <button\n                type=\"button\"\n                data-testid={`remove-photo-${index}`}\n                aria-label={`Remove photo ${index + 1}`}\n                onClick={() => handleRemovePhoto(index)}\n                className=\"absolute top-2 right-2 w-7 h-7 bg-white/90 rounded-full flex items-center justify-center shadow-sm opacity-0 group-hover:opacity-100 transition-opacity hover:bg-white\"\n              >\n                <Trash2 size={14} className=\"text-status-cancelled\" aria-hidden=\"true\" />\n              </button>\n            </div>\n          ))}\n        </div>\n      )}\n    </div>\n  )\n\n  const renderStep6 = () => (\n    <div data-testid=\"add-listing-step-6\">\n      <h3 className=\"text-lg font-semibold text-text mb-4\">Pricing</h3>\n\n      <div className=\"mb-4\">\n        <label htmlFor=\"price-per-night-input\" className=\"block text-sm font-medium text-text mb-1.5\">Price per Night *</label>\n        <div className=\"relative\">\n          <span className=\"absolute left-4 top-1/2 -translate-y-1/2 text-text-secondary\" aria-hidden=\"true\">$</span>\n          <input\n            id=\"price-per-night-input\"\n            data-testid=\"price-per-night-input\"\n            type=\"text\"\n            inputMode=\"decimal\"\n            aria-required=\"true\"\n            aria-describedby={errors.pricePerNight ? 'price-error' : undefined}\n            value={formData.pricePerNight}\n            onChange={(e) => {\n              const val = e.target.value.replace(/[^0-9.]/g, '')\n              setFormData((prev) => ({ ...prev, pricePerNight: val }))\n              if (errors.pricePerNight) setErrors((prev) => { const n = { ...prev }; delete n.pricePerNight; return n })\n            }}\n            placeholder=\"0\"\n            className={`w-full pl-8 pr-4 py-3 rounded-lg border ${\n              errors.pricePerNight ? 'border-error' : 'border-border'\n            } text-sm focus:outline-none focus:border-primary`}\n          />\n        </div>\n        {errors.pricePerNight && <p id=\"price-error\" className=\"text-error text-xs mt-1\" role=\"alert\">{errors.pricePerNight}</p>}\n      </div>\n\n      <div className=\"mb-4\">\n        <label htmlFor=\"cleaning-fee-input\" className=\"block text-sm font-medium text-text mb-1.5\">Cleaning Fee</label>\n        <div className=\"relative\">\n          <span className=\"absolute left-4 top-1/2 -translate-y-1/2 text-text-secondary\" aria-hidden=\"true\">$</span>\n          <input\n            id=\"cleaning-fee-input\"\n            data-testid=\"cleaning-fee-input\"\n            type=\"text\"\n            inputMode=\"decimal\"\n            value={formData.cleaningFee}\n            onChange={(e) => {\n              const val = e.target.value.replace(/[^0-9.]/g, '')\n              setFormData((prev) => ({ ...prev, cleaningFee: val }))\n            }}\n            placeholder=\"0\"\n            className=\"w-full pl-8 pr-4 py-3 rounded-lg border border-border text-sm focus:outline-none focus:border-primary\"\n          />\n        </div>\n      </div>\n    </div>\n  )\n\n  const renderStep7 = () => {\n    const selectedAmenityNames = amenities\n      .filter((a) => formData.selectedAmenities.includes(a.id))\n      .map((a) => a.name)\n\n    return (\n      <div data-testid=\"add-listing-step-7\">\n        <h3 className=\"text-lg font-semibold text-text mb-4\">Review & Publish</h3>\n\n        {errors.publish && (\n          <div className=\"bg-error/10 text-error text-sm px-4 py-3 rounded-lg mb-4\" role=\"alert\">{errors.publish}</div>\n        )}\n\n        <div className=\"space-y-4\">\n          <div className=\"bg-bg-secondary rounded-lg p-4\">\n            <h4 className=\"text-xs font-semibold text-text-secondary uppercase tracking-wide mb-2\">Property</h4>\n            <p className=\"text-sm\"><strong>Type:</strong> {formData.propertyType}</p>\n            <p className=\"text-sm\"><strong>Title:</strong> {formData.title}</p>\n          </div>\n\n          <div className=\"bg-bg-secondary rounded-lg p-4\">\n            <h4 className=\"text-xs font-semibold text-text-secondary uppercase tracking-wide mb-2\">Location</h4>\n            <p className=\"text-sm\">\n              {[formData.address, formData.city, formData.state, formData.country].filter(Boolean).join(', ')}\n            </p>\n          </div>\n\n          <div className=\"bg-bg-secondary rounded-lg p-4\">\n            <h4 className=\"text-xs font-semibold text-text-secondary uppercase tracking-wide mb-2\">Details</h4>\n            <div className=\"grid grid-cols-2 gap-2 text-sm\">\n              <p><strong>Guests:</strong> {formData.maxGuests}</p>\n              <p><strong>Bedrooms:</strong> {formData.bedrooms}</p>\n              <p><strong>Beds:</strong> {formData.beds}</p>\n              <p><strong>Bathrooms:</strong> {formData.bathrooms}</p>\n            </div>\n          </div>\n\n          {selectedAmenityNames.length > 0 && (\n            <div className=\"bg-bg-secondary rounded-lg p-4\">\n              <h4 className=\"text-xs font-semibold text-text-secondary uppercase tracking-wide mb-2\">Amenities</h4>\n              <p className=\"text-sm\">{selectedAmenityNames.join(', ')}</p>\n            </div>\n          )}\n\n          {formData.photos.length > 0 && (\n            <div className=\"bg-bg-secondary rounded-lg p-4\">\n              <h4 className=\"text-xs font-semibold text-text-secondary uppercase tracking-wide mb-2\">Photos</h4>\n              <div className=\"flex gap-2 overflow-x-auto\">\n                {formData.photos.map((photo, i) => (\n                  <div key={i} className=\"w-20 h-16 rounded-lg overflow-hidden shrink-0 border border-border\">\n                    <img src={photo.url} alt={`Photo ${i + 1}`} className=\"w-full h-full object-cover\" />\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n\n          <div className=\"bg-bg-secondary rounded-lg p-4\">\n            <h4 className=\"text-xs font-semibold text-text-secondary uppercase tracking-wide mb-2\">Pricing</h4>\n            <p className=\"text-sm\"><strong>Price per night:</strong> ${formData.pricePerNight}</p>\n            <p className=\"text-sm\"><strong>Cleaning fee:</strong> ${formData.cleaningFee || '0'}</p>\n          </div>\n        </div>\n      </div>\n    )\n  }\n\n  return (\n    <div\n      data-testid=\"add-listing-form\"\n      className=\"fixed inset-0 bg-black/50 flex items-center justify-center z-50\"\n    >\n      <div\n        ref={modalRef}\n        role=\"dialog\"\n        aria-modal=\"true\"\n        aria-labelledby=\"add-listing-dialog-title\"\n        className=\"bg-white rounded-xl w-full max-w-2xl max-h-[90vh] overflow-y-auto mx-4 shadow-lg\"\n      >\n        <div className=\"sticky top-0 bg-white border-b border-border px-6 py-4 flex items-center justify-between z-10\">\n          <h2 id=\"add-listing-dialog-title\" className=\"text-lg font-semibold text-text\">Add New Listing</h2>\n          <button\n            data-testid=\"add-listing-close\"\n            onClick={handleCancel}\n            aria-label=\"Close\"\n            className=\"w-8 h-8 rounded-full hover:bg-bg-secondary flex items-center justify-center transition-colors\"\n          >\n            <X size={20} className=\"text-text-secondary\" aria-hidden=\"true\" />\n          </button>\n        </div>\n\n        <div className=\"px-6 py-6\">\n          {renderStepIndicator()}\n\n          {step === 1 && renderStep1()}\n          {step === 2 && renderStep2()}\n          {step === 3 && renderStep3()}\n          {step === 4 && renderStep4()}\n          {step === 5 && renderStep5()}\n          {step === 6 && renderStep6()}\n          {step === 7 && renderStep7()}\n        </div>\n\n        <div className=\"sticky bottom-0 bg-white border-t border-border px-6 py-4 flex items-center justify-between\">\n          <button\n            data-testid=\"add-listing-cancel\"\n            onClick={handleCancel}\n            className=\"px-4 py-2.5 text-sm font-medium text-text-secondary hover:text-text transition-colors\"\n          >\n            Cancel\n          </button>\n          <div className=\"flex gap-3\">\n            {step > 1 && (\n              <button\n                data-testid=\"add-listing-back\"\n                onClick={handleBack}\n                className=\"flex items-center gap-1.5 px-4 py-2.5 text-sm font-medium text-text bg-bg-secondary rounded-lg hover:bg-border transition-colors\"\n              >\n                <ChevronLeft size={16} aria-hidden=\"true\" />\n                Back\n              </button>\n            )}\n            {step < TOTAL_STEPS ? (\n              <button\n                data-testid=\"add-listing-next\"\n                onClick={handleNext}\n                className=\"flex items-center gap-1.5 px-4 py-2.5 text-sm font-medium text-white bg-primary rounded-lg hover:bg-primary-dark transition-colors\"\n              >\n                Next\n                <ChevronRight size={16} aria-hidden=\"true\" />\n              </button>\n            ) : (\n              <button\n                data-testid=\"add-listing-publish\"\n                onClick={handlePublish}\n                disabled={publishing}\n                className=\"flex items-center gap-1.5 px-6 py-2.5 text-sm font-medium text-white bg-primary rounded-lg hover:bg-primary-dark transition-colors disabled:opacity-50\"\n              >\n                {publishing ? (\n                  <>\n                    <Loader2 size={16} className=\"animate-spin\" aria-hidden=\"true\" />\n                    Publishing...\n                  </>\n                ) : (\n                  'Publish'\n                )}\n              </button>\n            )}\n          </div>\n        </div>\n      </div>\n\n      {showDiscardDialog && (\n        <div\n          data-testid=\"discard-dialog\"\n          className=\"fixed inset-0 bg-black/50 flex items-center justify-center z-[60]\"\n          onClick={() => setShowDiscardDialog(false)}\n        >\n          <div\n            ref={discardDialogRef}\n            role=\"dialog\"\n            aria-modal=\"true\"\n            aria-labelledby=\"discard-dialog-title\"\n            className=\"bg-white rounded-xl p-6 max-w-md w-full mx-4 shadow-lg\"\n            onClick={(e) => e.stopPropagation()}\n          >\n            <h3 id=\"discard-dialog-title\" className=\"text-lg font-semibold text-text mb-2\">Discard your listing?</h3>\n            <p className=\"text-text-secondary mb-6\">All entered information will be lost.</p>\n            <div className=\"flex gap-3 justify-end\">\n              <button\n                data-testid=\"discard-dialog-keep\"\n                onClick={() => setShowDiscardDialog(false)}\n                className=\"px-4 py-2 text-sm font-medium text-text bg-bg-secondary rounded-lg hover:bg-border transition-colors\"\n              >\n                Keep Editing\n              </button>\n              <button\n                data-testid=\"discard-dialog-confirm\"\n                onClick={onClose}\n                className=\"px-4 py-2 text-sm font-medium text-white bg-status-cancelled rounded-lg hover:opacity-90 transition-opacity\"\n              >\n                Discard\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  )\n}\n","numLines":898,"startLine":1,"totalLines":898}}}
