${encodeURIComponent(hostId)}`)\n    61→    const data = await response.json()\n    62→    if (!response.ok) {\n    63→      return rejectWithValue(data.error || 'Failed to fetch host stats')\n    64→    }\n    65→    return data as HostStats\n    66→  }\n    67→)\n    68→\n    69→export const fetchHostListings = createAsyncThunk(\n    70→  'host/fetchHostListings',\n    71→  async (hostId: string, { rejectWithValue }) => {\n    72→    const response = await fetch(`/api/host-listings?host_id=${encodeURIComponent(hostId)}`)\n    73→    const data = await response.json()\n    74→    if (!response.ok) {\n    75→      return rejectWithValue(data.error || 'Failed to fetch host listings')\n    76→    }\n    77→    return data as Property[]\n    78→  }\n    79→)\n    80→"}]},"parent_tool_use_id":"toolu_01S6e6eLSzEfJMhS9BRQEJGp","session_id":"89faff73-b689-4266-95e8-94a07c37d050","uuid":"57cff6fe-9dbd-4b6c-8e78-4fb8c46029bf"}
