[2026-03-16T04:02:44.480Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KMfEHwWRaJR95YV5L94pBg","type":"tool_result","content":"     1→import { useState, useEffect, useCallback } from 'react'\n     2→import { useSelector, useDispatch } from 'react-redux'\n     3→import { useNavigate } from 'react-router-dom'\n     4→import type { RootState, AppDispatch } from '../store'\n     5→import {\n     6→  fetchHostStats,\n     7→  fetchHostListings,\n     8→  fetchHostBookings,\n     9→  deactivateProperty,\n    10→  activateProperty,\n    11→  updateHostBookingStatus,\n    12→} from '../slices/hostSlice'\n    13→import type { Property } from '../slices/propertiesSlice'\n    14→import StatsOverview from '../components/StatsOverview'\n    15→import ListingsTab from '../components/ListingsTab'\n    16→import BookingsTab from '../components/BookingsTab'\n    17→import AddListingForm from '../components/AddListingForm'\n    18→\n    19→type Tab = 'listings' | 'bookings'\n    20→\n    21→export default function HostDashboard() {\n    22→  const dispatch = useDispatch<AppDispatch>()\n    23→  const navigate = useNavigate()\n    24→  const currentUser = useSelector((state: RootState) => state.auth.currentUser)\n    25→  const { stats, listings, bookings, statsLoading, listingsLoading, bookingsLoading } = useSelector(\n    26→    (state: RootState) => state.host\n    27→  )\n    28→  const [activeTab, setActiveTab] = useState<Tab>('listings')\n    29→  const [showAddForm, setShowAddForm] = useState(false)\n    30→\n    31→  useEffect(() => {\n    32→    if (!currentUser) {\n    33→      navigate('/login')\n    34→    }\n    35→  }, [currentUser, navigate])\n    36→\n    37→  useEffect(() => {\n    38→    if (currentUser?.is_host) {\n    39→      dispatch(fetchHostStats(currentUser.id))\n    40→      dispatch(fetchHostListings(currentUser.id))\n    41→      dispatch(fetchHostBookings(currentUser.id))\n    42→    }\n    43→  }, [dispatch, currentUser])\n    44→\n    45→  const handleDeactivate = useCallback(async (property: Property) => {\n    46→    await dispatch(deactivateProperty(property.id))\n    47→  }, [dispatch])\n    48→\n    49→  const handleActivate = useCallback(async (property: Property) => {\n    50→    await dispatch(activateProperty(property.id))\n    51→  }, [dispatch])\n    52→\n    53→  const handleConfirmBooking = useCallback(async (bookingId: string) => {\n    54→    await dispatch(updateHostBookingStatus({ bookingId, status: 'confirmed' }))\n    55→    if (currentUser) {\n    56→      dispatch(fetchHostStats(currentUser.id))\n    57→    }\n    58→  }, [dispatch, currentUser])\n    59→\n    60→  const handleCancelBooking = useCallback(async (bookingId: string) => {\n    61→    await dispatch(updateHostBookingStatus({ bookingId, status: 'cancelled' }))\n    62→    if (currentUser) {\n    63→      dispatch(fetchHostStats(currentUser.id))\n    64→    }\n    65→  }, [dispatch, currentUser])\n    66→\n    67→  const handleAddListingSuccess = useCallback(() => {\n    68→    setShowAddForm(false)\n    69→    if (currentUser) {\n    70→      dispatch(fetchHostStats(currentUser.id))\n    71→      dispatch(fetchHostListings(currentUser.id))\n    72→    }\n    73→  }, [dispatch, currentUser])\n    74→\n    75→  if (!currentUser) {\n    76→    return null\n    77→  }\n    78→\n    79→  if (!currentUser.is_host) {\n    80→    return (\n    81→      <main data-testid=\"host-dashboard\" className=\"max-w-[1120px] mx-auto px-6 max-sm:px-3 py-8\">\n    82→        <div className=\"max-w-lg mx-auto text-center py-16\">\n    83→          <h1 className=\"text-[32px] font-bold text-text mb-4\">Become a Host</h1>\n    84→          <p className=\"text-text-secondary mb-6 text-lg\">\n    85→            You need to become a host to access this page. Visit your profile to get started.\n    86→          </p>\n    87→          <button\n    88→            data-testid=\"become-host-link\"\n    89→            onClick={() => navigate('/profile')}\n    90→            className=\"bg-primary text-white px-8 py-3 rounded-lg font-semibold hover:bg-primary-dark transition-colors\"\n    91→          >\n    92→            Go to Profile\n    93→          </button>\n    94→        </div>\n    95→      </main>\n    96→    )\n    97→  }\n    98→\n    99→  return (\n   100→    <main data-testid=\"host-dashboard\" className=\"max-w-[1120px] mx-auto px-6 max-sm:px-3 py-8\">\n   101→      <h1 className=\"text-[32px] font-bold text-text mb-8\">Host Dashboard</h1>\n   102→\n   103→      <StatsOverview stats={stats} loading={statsLoading} />\n   104→\n   105→      <div className=\"mt-10 mb-6\">\n   106→        <div className=\"flex border-b border-border\" role=\"tablist\" aria-label=\"Dashboard sections\">\n   107→          <button\n   108→            data-testid=\"tab-listings\"\n   109→            role=\"tab\"\n   110→            aria-selected={activeTab === 'listings'}\n   111→            aria-controls=\"tabpanel-listings\"\n   112→            id=\"tab-listings-btn\"\n   113→            onClick={() => setActiveTab('listings')}\n   114→            className={`px-6 py-3 text-sm font-semibold border-b-2 transition-colors cursor-pointer ${\n   115→              activeTab === 'listings'\n   116→                ? 'border-text text-text'\n   117→                : 'border-transparent text-text-secondary hover:text-text'\n   118→            }`}\n   119→          >\n   120→            Listings\n   121→          </button>\n   122→          <button\n   123→            data-testid=\"tab-bookings\"\n   124→            role=\"tab\"\n   125→            aria-selected={activeTab === 'bookings'}\n   126→            aria-controls=\"tabpanel-bookings\"\n   127→            id=\"tab-bookings-btn\"\n   128→            onClick={() => setActiveTab('bookings')}\n   129→            className={`px-6 py-3 text-sm font-semibold border-b-2 transition-colors cursor-pointer ${\n   130→              activeTab === 'bookings'\n   131→                ? 'border-text text-text'\n   132→                : 'border-transparent text-text-secondary hover:text-text'\n   133→            }`}\n   134→          >\n   135→            Bookings\n   136→          </button>\n   137→        </div>\n   138→      </div>\n   139→\n   140→      {activeTab === 'listings' && (\n   141→        <div role=\"tabpanel\" id=\"tabpanel-listings\" aria-labelledby=\"tab-listings-btn\">\n   142→          <ListingsTab\n   143→            listings={listings}\n   144→            loading={listingsLoading}\n   145→            onDeactivate={handleDeactivate}\n   146→            onActivate={handleActivate}\n   147→            onAddListing={() => setShowAddForm(true)}\n   148→          />\n   149→        </div>\n   150→      )}\n   151→\n   152→      {activeTab === 'bookings' && (\n   153→        <div role=\"tabpanel\" id=\"tabpanel-bookings\" aria-labelledby=\"tab-bookings-btn\">\n   154→          <BookingsTab\n   155→            bookings={bookings}\n   156→            loading={bookingsLoading}\n   157→            onConfirm={handleConfirmBooking}\n   158→            onCancel={handleCancelBooking}\n   159→          />\n   160→        </div>\n   161→      )}\n   162→\n   163→      {showAddForm && (\n   164→        <AddListingForm\n   165→          hostId={currentUser.id}\n   166→          onClose={() => setShowAddForm(false)}\n   167→          onSuccess={handleAddListingSuccess}\n   168→        />\n   169→      )}\n   170→    </main>\n   171→  )\n   172→}\n   173→"}]},"parent_tool_use_id":"toolu_01S6e6eLSzEfJMhS9BRQEJGp","session_id":"89faff73-b689-4266-95e8-94a07c37d050","uuid":"26cf749c-ed75-43f0-8c6b-b35baf6fe664"}
