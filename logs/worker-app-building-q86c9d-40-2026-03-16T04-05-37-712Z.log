[2026-03-16T04:03:13.913Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014JgwwG9aXRw4eLbeek9hXP","type":"tool_result","content":"     1→import { useState, useEffect, useRef, useCallback } from 'react'\n     2→import { Loader2, Calendar } from 'lucide-react'\n     3→import type { HostBooking } from '../slices/hostSlice'\n     4→\n     5→interface BookingsTabProps {\n     6→  bookings: HostBooking[]\n     7→  loading: boolean\n     8→  onConfirm: (bookingId: string) => Promise<void>\n     9→  onCancel: (bookingId: string) => Promise<void>\n    10→}\n    11→\n    12→const STATUS_FILTERS = ['All', 'Pending', 'Confirmed', 'Cancelled', 'Completed'] as const\n    13→type StatusFilter = (typeof STATUS_FILTERS)[number]\n    14→\n    15→const statusColors: Record<string, string> = {\n    16→  pending: 'bg-status-pending/20 text-status-pending',\n    17→  confirmed: 'bg-status-confirmed/20 text-status-confirmed',\n    18→  cancelled: 'bg-status-cancelled/20 text-status-cancelled',\n    19→  completed: 'bg-status-completed/20 text-status-completed',\n    20→}\n    21→\n    22→function formatDate(dateStr: string): string {\n    23→  const d = new Date(dateStr.split('T')[0] + 'T12:00:00')\n    24→  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })\n    25→}\n    26→\n    27→export default function BookingsTab({ bookings, loading, onConfirm, onCancel }: BookingsTabProps) {\n    28→  const [activeFilter, setActiveFilter] = useState<StatusFilter>('All')\n    29→  const [cancelDialog, setCancelDialog] = useState<HostBooking | null>(null)\n    30→  const [actionLoading, setActionLoading] = useState<string | null>(null)\n    31→  const dialogRef = useRef<HTMLDivElement>(null)\n    32→  const triggerRef = useRef<HTMLButtonElement | null>(null)\n    33→\n    34→  const handleKeyDown = useCallback((e: KeyboardEvent) => {\n    35→    if (e.key === 'Escape') {\n    36→      setCancelDialog(null)\n    37→    }\n    38→    if (e.key === 'Tab' && dialogRef.current) {\n    39→      const focusable = dialogRef.current.querySelectorAll<HTMLElement>(\n    40→        'button, [href], input, select, textarea, [tabindex]:not([tabindex=\"-1\"])'\n    41→      )\n    42→      const first = focusable[0]\n    43→      const last = focusable[focusable.length - 1]\n    44→      if (e.shiftKey && document.activeElement === first) {\n    45→        e.preventDefault()\n    46→        last?.focus()\n    47→      } else if (!e.shiftKey && document.activeElement === last) {\n    48→        e.preventDefault()\n    49→        first?.focus()\n    50→      }\n    51→    }\n    52→  }, [])\n    53→\n    54→  useEffect(() => {\n    55→    if (cancelDialog) {\n    56→      document.addEventListener('keydown', handleKeyDown)\n    57→      dialogRef.current?.querySelector<HTMLElement>('button')?.focus()\n    58→      return () => document.removeEventListener('keydown', handleKeyDown)\n    59→    } else {\n    60→      triggerRef.current?.focus()\n    61→    }\n    62→  }, [cancelDialog, handleKeyDown])\n    63→\n    64→  const filteredBookings = activeFilter === 'All'\n    65→    ? bookings\n    66→    : bookings.filter((b) => b.status === activeFilter.toLowerCase())\n    67→\n    68→  const handleConfirm = async (bookingId: string) => {\n    69→    setActionLoading(bookingId)\n    70→    await onConfirm(bookingId)\n    71→    setActionLoading(null)\n    72→  }\n    73→\n    74→  const handleCancelClick = (booking: HostBooking, button: HTMLButtonElement) => {\n    75→    triggerRef.current = button\n    76→    setCancelDialog(booking)\n    77→  }\n    78→\n    79→  const handleConfirmCancel = async () => {\n    80→    if (!cancelDialog) return\n    81→    setActionLoading(cancelDialog.id)\n    82→    await onCancel(cancelDialog.id)\n    83→    setActionLoading(null)\n    84→    setCancelDialog(null)\n    85→  }\n    86→\n    87→  if (loading) {\n    88→    return (\n    89→      <div className=\"flex items-center justify-center py-16\" role=\"status\">\n    90→        <Loader2 size={32} className=\"animate-spin text-primary\" aria-hidden=\"true\" />\n    91→        <span className=\"sr-only\">Loading bookings...</span>\n    92→      </div>\n    93→    )\n    94→  }\n    95→\n    96→  return (\n    97→    <div data-testid=\"bookings-tab\">\n    98→      <div className=\"flex items-center gap-2 mb-6 flex-wrap\" role=\"group\" aria-label=\"Filter bookings by status\">\n    99→        {STATUS_FILTERS.map((filter) => (\n   100→          <button\n   101→            key={filter}\n   102→            data-testid={`booking-filter-${filter.toLowerCase()}`}\n   103→            onClick={() => setActiveFilter(filter)}\n   104→            aria-pressed={activeFilter === filter}\n   105→            className={`px-4 py-2 rounded-full text-sm font-medium transition-colors ${\n   106→              activeFilter === filter\n   107→                ? 'bg-primary text-white'\n   108→                : 'bg-bg-secondary text-text-secondary hover:bg-border'\n   109→            }`}\n   110→          >\n   111→            {filter}\n   112→          </button>\n   113→        ))}\n   114→      </div>\n   115→\n   116→      {filteredBookings.length === 0 ? (\n   117→        <div data-testid=\"bookings-empty-state\" className=\"text-center py-16\">\n   118→          <Calendar size={48} className=\"mx-auto text-text-secondary mb-4 opacity-50\" aria-hidden=\"true\" />\n   119→          <p className=\"text-text-secondary text-lg\">\n   120→            {activeFilter === 'All' ? 'No bookings yet' : `No ${activeFilter.toLowerCase()} bookings`}\n   121→          </p>\n   122→        </div>\n   123→      ) : (\n   124→        <div className=\"overflow-x-auto\">\n   125→          <table data-testid=\"bookings-table\" className=\"w-full\" aria-label=\"Bookings\">\n   126→            <thead>\n   127→              <tr className=\"border-b border-border\">\n   128→                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Property</th>\n   129→                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Guest</th>\n   130→                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Check-in</th>\n   131→                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Check-out</th>\n   132→                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Guests</th>\n   133→                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Total</th>\n   134→                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Status</th>\n   135→                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Actions</th>\n   136→              </tr>\n   137→            </thead>\n   138→            <tbody>\n   139→              {filteredBookings.map((booking) => (\n   140→                <tr\n   141→                  key={booking.id}\n   142→                  data-testid={`booking-row-${booking.id}`}\n   143→                  className=\"border-b border-border hover:bg-bg-secondary/50 transition-colors\"\n   144→                >\n   145→                  <td className=\"py-3 px-4 text-sm font-medium text-text\">{booking.property_title}</td>\n   146→                  <td className=\"py-3 px-4 text-sm text-text\">{booking.guest_name}</td>\n   147→                  <td className=\"py-3 px-4 text-sm text-text-secondary\">{formatDate(booking.check_in)}</td>\n   148→                  <td className=\"py-3 px-4 text-sm text-text-secondary\">{formatDate(booking.check_out)}</td>\n   149→                  <td className=\"py-3 px-4 text-sm text-text\">{booking.num_guests}</td>\n   150→                  <td className=\"py-3 px-4 text-sm font-medium text-text\">\n   151→                    ${Number(booking.total_price).toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}\n   152→                  </td>\n   153→                  <td className=\"py-3 px-4\">\n   154→                    <span\n   155→                      data-testid={`booking-status-${booking.id}`}\n   156→                      className={`inline-block px-2.5 py-1 rounded-full text-xs font-semibold capitalize ${statusColors[booking.status] || ''}`}\n   157→                    >\n   158→                      {booking.status}\n   159→                    </span>\n   160→                  </td>\n   161→                  <td className=\"py-3 px-4\">\n   162→                    {booking.status === 'pending' && (\n   163→                      <div className=\"flex gap-2\">\n   164→                        <button\n   165→                          data-testid={`booking-confirm-${booking.id}`}\n   166→                          onClick={() => handleConfirm(booking.id)}\n   167→                          disabled={actionLoading === booking.id}\n   168→                          className=\"px-3 py-1.5 text-xs font-medium text-white bg-status-confirmed rounded-lg hover:opacity-90 transition-opacity disabled:opacity-50\"\n   169→                        >\n   170→                          {actionLoading === booking.id ? '...' : 'Confirm'}\n   171→                        </button>\n   172→                        <button\n   173→                          data-testid={`booking-cancel-${booking.id}`}\n   174→                          onClick={(e) => handleCancelClick(booking, e.currentTarget)}\n   175→                          disabled={actionLoading === booking.id}\n   176→                          className=\"px-3 py-1.5 text-xs font-medium text-white bg-status-cancelled rounded-lg hover:opacity-90 transition-opacity disabled:opacity-50\"\n   177→                        >\n   178→                          Cancel\n   179→                        </button>\n   180→                      </div>\n   181→                    )}\n   182→                    {booking.status === 'confirmed' && (\n   183→                      <button\n   184→                        data-testid={`booking-cancel-${booking.id}`}\n   185→                        onClick={(e) => handleCancelClick(booking, e.currentTarget)}\n   186→                        disabled={actionLoading === booking.id}\n   187→                        className=\"px-3 py-1.5 text-xs font-medium text-white bg-status-cancelled rounded-lg hover:opacity-90 transition-opacity disabled:opacity-50\"\n   188→                      >\n   189→                        Cancel\n   190→                      </button>\n   191→                    )}\n   192→                  </td>\n   193→                </tr>\n   194→              ))}\n   195→            </tbody>\n   196→          </table>\n   197→        </div>\n   198→      )}\n   199→\n   200→      {cancelDialog && (\n   201→        <div\n   202→          data-testid=\"cancel-booking-dialog\"\n   203→          className=\"fixed inset-0 bg-black/50 flex items-center justify-center z-50\"\n   204→          onClick={() => setCancelDialog(null)}\n   205→        >\n   206→          <div\n   207→            ref={dialogRef}\n   208→            role=\"dialog\"\n   209→            aria-modal=\"true\"\n   210→            aria-labelledby=\"cancel-booking-dialog-title\"\n   211→            className=\"bg-white rounded-xl p-6 max-w-md w-full mx-4 shadow-lg\"\n   212→            onClick={(e) => e.stopPropagation()}\n   213→          >\n   214→            <h3 id=\"cancel-booking-dialog-title\" className=\"text-lg font-semibold text-text mb-2\">Cancel Booking</h3>\n   215→            <p className=\"text-text-secondary mb-1\">Are you sure you want to cancel this booking?</p>\n   216→            <div className=\"bg-bg-secondary rounded-lg p-3 mb-6 text-sm\">\n   217→              <p className=\"font-medium text-text\">{cancelDialog.property_title}</p>\n   218→              <p className=\"text-text-secondary\">Guest: {cancelDialog.guest_name}</p>\n   219→              <p className=\"text-text-secondary\">\n   220→                {formatDate(cancelDialog.check_in)} — {formatDate(cancelDialog.check_out)}\n   221→              </p>\n   222→            </div>\n   223→            <div className=\"flex gap-3 justify-end\">\n   224→              <button\n   225→                data-testid=\"cancel-booking-dialog-dismiss\"\n   226→                onClick={() => setCancelDialog(null)}\n   227→                className=\"px-4 py-2 text-sm font-medium text-text bg-bg-secondary rounded-lg hover:bg-border transition-colors\"\n   228→              >\n   229→                Keep Booking\n   230→              </button>\n   231→              <button\n   232→                data-testid=\"cancel-booking-dialog-confirm\"\n   233→                onClick={handleConfirmCancel}\n   234→                disabled={actionLoading === cancelDialog.id}\n   235→                className=\"px-4 py-2 text-sm font-medium text-white bg-status-cancelled rounded-lg hover:opacity-90 transition-opacity disabled:opacity-50\"\n   236→              >\n   237→                {actionLoading === cancelDialog.id ? 'Cancelling...' : 'Yes, Cancel'}\n   238→              </button>\n   239→            </div>\n   240→          </div>\n   241→        </div>\n   242→      )}\n   243→    </div>\n   244→  )\n   245→}\n   246→"}]},"parent_tool_use_id":null,"session_id":"89faff73-b689-4266-95e8-94a07c37d050","uuid":"ddedc96f-3d07-474a-8cc5-c93932867c13","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/components/BookingsTab.tsx","content":"import { useState, useEffect, useRef, useCallback } from 'react'\nimport { Loader2, Calendar } from 'lucide-react'\nimport type { HostBooking } from '../slices/hostSlice'\n\ninterface BookingsTabProps {\n  bookings: HostBooking[]\n  loading: boolean\n  onConfirm: (bookingId: string) => Promise<void>\n  onCancel: (bookingId: string) => Promise<void>\n}\n\nconst STATUS_FILTERS = ['All', 'Pending', 'Confirmed', 'Cancelled', 'Completed'] as const\ntype StatusFilter = (typeof STATUS_FILTERS)[number]\n\nconst statusColors: Record<string, string> = {\n  pending: 'bg-status-pending/20 text-status-pending',\n  confirmed: 'bg-status-confirmed/20 text-status-confirmed',\n  cancelled: 'bg-status-cancelled/20 text-status-cancelled',\n  completed: 'bg-status-completed/20 text-status-completed',\n}\n\nfunction formatDate(dateStr: string): string {\n  const d = new Date(dateStr.split('T')[0] + 'T12:00:00')\n  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })\n}\n\nexport default function BookingsTab({ bookings, loading, onConfirm, onCancel }: BookingsTabProps) {\n  const [activeFilter, setActiveFilter] = useState<StatusFilter>('All')\n  const [cancelDialog, setCancelDialog] = useState<HostBooking | null>(null)\n  const [actionLoading, setActionLoading] = useState<string | null>(null)\n  const dialogRef = useRef<HTMLDivElement>(null)\n  const triggerRef = useRef<HTMLButtonElement | null>(null)\n\n  const handleKeyDown = useCallback((e: KeyboardEvent) => {\n    if (e.key === 'Escape') {\n      setCancelDialog(null)\n    }\n    if (e.key === 'Tab' && dialogRef.current) {\n      const focusable = dialogRef.current.querySelectorAll<HTMLElement>(\n        'button, [href], input, select, textarea, [tabindex]:not([tabindex=\"-1\"])'\n      )\n      const first = focusable[0]\n      const last = focusable[focusable.length - 1]\n      if (e.shiftKey && document.activeElement === first) {\n        e.preventDefault()\n        last?.focus()\n      } else if (!e.shiftKey && document.activeElement === last) {\n        e.preventDefault()\n        first?.focus()\n      }\n    }\n  }, [])\n\n  useEffect(() => {\n    if (cancelDialog) {\n      document.addEventListener('keydown', handleKeyDown)\n      dialogRef.current?.querySelector<HTMLElement>('button')?.focus()\n      return () => document.removeEventListener('keydown', handleKeyDown)\n    } else {\n      triggerRef.current?.focus()\n    }\n  }, [cancelDialog, handleKeyDown])\n\n  const filteredBookings = activeFilter === 'All'\n    ? bookings\n    : bookings.filter((b) => b.status === activeFilter.toLowerCase())\n\n  const handleConfirm = async (bookingId: string) => {\n    setActionLoading(bookingId)\n    await onConfirm(bookingId)\n    setActionLoading(null)\n  }\n\n  const handleCancelClick = (booking: HostBooking, button: HTMLButtonElement) => {\n    triggerRef.current = button\n    setCancelDialog(booking)\n  }\n\n  const handleConfirmCancel = async () => {\n    if (!cancelDialog) return\n    setActionLoading(cancelDialog.id)\n    await onCancel(cancelDialog.id)\n    setActionLoading(null)\n    setCancelDialog(null)\n  }\n\n  if (loading) {\n    return (\n      <div className=\"flex items-center justify-center py-16\" role=\"status\">\n        <Loader2 size={32} className=\"animate-spin text-primary\" aria-hidden=\"true\" />\n        <span className=\"sr-only\">Loading bookings...</span>\n      </div>\n    )\n  }\n\n  return (\n    <div data-testid=\"bookings-tab\">\n      <div className=\"flex items-center gap-2 mb-6 flex-wrap\" role=\"group\" aria-label=\"Filter bookings by status\">\n        {STATUS_FILTERS.map((filter) => (\n          <button\n            key={filter}\n            data-testid={`booking-filter-${filter.toLowerCase()}`}\n            onClick={() => setActiveFilter(filter)}\n            aria-pressed={activeFilter === filter}\n            className={`px-4 py-2 rounded-full text-sm font-medium transition-colors ${\n              activeFilter === filter\n                ? 'bg-primary text-white'\n                : 'bg-bg-secondary text-text-secondary hover:bg-border'\n            }`}\n          >\n            {filter}\n          </button>\n        ))}\n      </div>\n\n      {filteredBookings.length === 0 ? (\n        <div data-testid=\"bookings-empty-state\" className=\"text-center py-16\">\n          <Calendar size={48} className=\"mx-auto text-text-secondary mb-4 opacity-50\" aria-hidden=\"true\" />\n          <p className=\"text-text-secondary text-lg\">\n            {activeFilter === 'All' ? 'No bookings yet' : `No ${activeFilter.toLowerCase()} bookings`}\n          </p>\n        </div>\n      ) : (\n        <div className=\"overflow-x-auto\">\n          <table data-testid=\"bookings-table\" className=\"w-full\" aria-label=\"Bookings\">\n            <thead>\n              <tr className=\"border-b border-border\">\n                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Property</th>\n                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Guest</th>\n                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Check-in</th>\n                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Check-out</th>\n                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Guests</th>\n                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Total</th>\n                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Status</th>\n                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Actions</th>\n              </tr>\n            </thead>\n            <tbody>\n              {filteredBookings.map((booking) => (\n                <tr\n                  key={booking.id}\n                  data-testid={`booking-row-${booking.id}`}\n                  className=\"border-b border-border hover:bg-bg-secondary/50 transition-colors\"\n                >\n                  <td className=\"py-3 px-4 text-sm font-medium text-text\">{booking.property_title}</td>\n                  <td className=\"py-3 px-4 text-sm text-text\">{booking.guest_name}</td>\n                  <td className=\"py-3 px-4 text-sm text-text-secondary\">{formatDate(booking.check_in)}</td>\n                  <td className=\"py-3 px-4 text-sm text-text-secondary\">{formatDate(booking.check_out)}</td>\n                  <td className=\"py-3 px-4 text-sm text-text\">{booking.num_guests}</td>\n                  <td className=\"py-3 px-4 text-sm font-medium text-text\">\n                    ${Number(booking.total_price).toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}\n                  </td>\n                  <td className=\"py-3 px-4\">\n                    <span\n                      data-testid={`booking-status-${booking.id}`}\n                      className={`inline-block px-2.5 py-1 rounded-full text-xs font-semibold capitalize ${statusColors[booking.status] || ''}`}\n                    >\n                      {booking.status}\n                    </span>\n                  </td>\n                  <td className=\"py-3 px-4\">\n                    {booking.status === 'pending' && (\n                      <div className=\"flex gap-2\">\n                        <button\n                          data-testid={`booking-confirm-${booking.id}`}\n                          onClick={() => handleConfirm(booking.id)}\n                          disabled={actionLoading === booking.id}\n                          className=\"px-3 py-1.5 text-xs font-medium text-white bg-status-confirmed rounded-lg hover:opacity-90 transition-opacity disabled:opacity-50\"\n                        >\n                          {actionLoading === booking.id ? '...' : 'Confirm'}\n                        </button>\n                        <button\n                          data-testid={`booking-cancel-${booking.id}`}\n                          onClick={(e) => handleCancelClick(booking, e.currentTarget)}\n                          disabled={actionLoading === booking.id}\n                          className=\"px-3 py-1.5 text-xs font-medium text-white bg-status-cancelled rounded-lg hover:opacity-90 transition-opacity disabled:opacity-50\"\n                        >\n                          Cancel\n                        </button>\n                      </div>\n                    )}\n                    {booking.status === 'confirmed' && (\n                      <button\n                        data-testid={`booking-cancel-${booking.id}`}\n                        onClick={(e) => handleCancelClick(booking, e.currentTarget)}\n                        disabled={actionLoading === booking.id}\n                        className=\"px-3 py-1.5 text-xs font-medium text-white bg-status-cancelled rounded-lg hover:opacity-90 transition-opacity disabled:opacity-50\"\n                      >\n                        Cancel\n                      </button>\n                    )}\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      )}\n\n      {cancelDialog && (\n        <div\n          data-testid=\"cancel-booking-dialog\"\n          className=\"fixed inset-0 bg-black/50 flex items-center justify-center z-50\"\n          onClick={() => setCancelDialog(null)}\n        >\n          <div\n            ref={dialogRef}\n            role=\"dialog\"\n            aria-modal=\"true\"\n            aria-labelledby=\"cancel-booking-dialog-title\"\n            className=\"bg-white rounded-xl p-6 max-w-md w-full mx-4 shadow-lg\"\n            onClick={(e) => e.stopPropagation()}\n          >\n            <h3 id=\"cancel-booking-dialog-title\" className=\"text-lg font-semibold text-text mb-2\">Cancel Booking</h3>\n            <p className=\"text-text-secondary mb-1\">Are you sure you want to cancel this booking?</p>\n            <div className=\"bg-bg-secondary rounded-lg p-3 mb-6 text-sm\">\n              <p className=\"font-medium text-text\">{cancelDialog.property_title}</p>\n              <p className=\"text-text-secondary\">Guest: {cancelDialog.guest_name}</p>\n              <p className=\"text-text-secondary\">\n                {formatDate(cancelDialog.check_in)} — {formatDate(cancelDialog.check_out)}\n              </p>\n            </div>\n            <div className=\"flex gap-3 justify-end\">\n              <button\n                data-testid=\"cancel-booking-dialog-dismiss\"\n                onClick={() => setCancelDialog(null)}\n                className=\"px-4 py-2 text-sm font-medium text-text bg-bg-secondary rounded-lg hover:bg-border transition-colors\"\n              >\n                Keep Booking\n              </button>\n              <button\n                data-testid=\"cancel-booking-dialog-confirm\"\n                onClick={handleConfirmCancel}\n                disabled={actionLoading === cancelDialog.id}\n                className=\"px-4 py-2 text-sm font-medium text-white bg-status-cancelled rounded-lg hover:opacity-90 transition-opacity disabled:opacity-50\"\n              >\n                {actionLoading === cancelDialog.id ? 'Cancelling...' : 'Yes, Cancel'}\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  )\n}\n","numLines":246,"startLine":1,"totalLines":246}}}
