 booking.check_out)}\n    38→          </p>\n    39→        </div>\n    40→        <div className=\"flex gap-3 justify-end\">\n    41→          <button\n    42→            data-testid=\"cancel-dialog-dismiss\"\n    43→            onClick={onDismiss}\n    44→            className=\"px-4 py-2 text-sm font-medium rounded-lg border border-border text-text hover:bg-bg-secondary transition-colors\"\n    45→          >\n    46→            Keep Booking\n    47→          </button>\n    48→          <button\n    49→            data-testid=\"cancel-dialog-confirm\"\n    50→            onClick={onConfirm}\n    51→            className=\"px-4 py-2 text-sm font-medium rounded-lg bg-status-cancelled text-white hover:bg-status-cancelled/90 transition-colors\"\n    52→          >\n    53→            Yes, Cancel\n    54→          </button>\n    55→        </div>\n    56→      </div>\n    57→    </div>\n    58→  )\n    59→}\n    60→"}]},"parent_tool_use_id":"toolu_01BYZBEUEUZFsy2s9VeJe4VB","session_id":"bf64fb1f-6d22-482a-898e-953cd6c2617e","uuid":"1467d250-8672-4175-b01a-f28d36b8b4a6"}
