[2026-03-14T20:45:47.645Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013m3nutZvJj2ifYU58QMBjF","type":"tool_result","content":"     1→import { useState } from 'react'\n     2→import type { Booking } from '../slices/bookingsSlice'\n     3→import TripCard from './TripCard'\n     4→import { Link } from 'react-router-dom'\n     5→\n     6→type TabKey = 'upcoming' | 'past' | 'cancelled'\n     7→\n     8→interface TripsTabsProps {\n     9→  bookings: Booking[]\n    10→  onCancelBooking: (booking: Booking) => void\n    11→}\n    12→\n    13→const tabs: { key: TabKey; label: string }[] = [\n    14→  { key: 'upcoming', label: 'Upcoming' },\n    15→  { key: 'past', label: 'Past' },\n    16→  { key: 'cancelled', label: 'Cancelled' },\n    17→]\n    18→\n    19→function filterBookings(bookings: Booking[], tab: TabKey): Booking[] {\n    20→  const today = new Date().toISOString().split('T')[0]\n    21→  switch (tab) {\n    22→    case 'upcoming':\n    23→      return bookings\n    24→        .filter(\n    25→          (b) =>\n    26→            (b.status === 'pending' || b.status === 'confirmed') &&\n    27→            b.check_in.split('T')[0]! >= today!\n    28→        )\n    29→        .sort((a, b) => a.check_in.localeCompare(b.check_in))\n    30→    case 'past':\n    31→      return bookings\n    32→        .filter((b) => b.status === 'completed')\n    33→        .sort((a, b) => a.check_in.localeCompare(b.check_in))\n    34→    case 'cancelled':\n    35→      return bookings\n    36→        .filter((b) => b.status === 'cancelled')\n    37→        .sort((a, b) => a.check_in.localeCompare(b.check_in))\n    38→  }\n    39→}\n    40→\n    41→export default function TripsTabs({ bookings, onCancelBooking }: TripsTabsProps) {\n    42→  const [activeTab, setActiveTab] = useState<TabKey>('upcoming')\n    43→  const filtered = filterBookings(bookings, activeTab)\n    44→\n    45→  return (\n    46→    <div data-testid=\"trips-tabs\">\n    47→      <div className=\"flex gap-1 border-b border-border mb-6\">\n    48→        {tabs.map((tab) => (\n    49→          <button\n    50→            key={tab.key}\n    51→            data-testid={`tab-${tab.key}`}\n    52→            onClick={() => setActiveTab(tab.key)}\n    53→            className={`px-4 py-3 text-sm font-medium border-b-2 transition-colors ${\n    54→              activeTab === tab.key\n    55→                ? 'border-text text-text'\n    56→                : 'border-transparent text-text-secondary hover:text-text hover:border-border-dark'\n    57→            }`}\n    58→          >\n    59→            {tab.label}\n    60→          </button>\n    61→        ))}\n    62→      </div>\n    63→\n    64→      <div data-testid=\"trips-list\">\n    65→        {filtered.length === 0 ? (\n    66→          <div data-testid=\"trips-empty-state\" className=\"text-center py-12\">\n    67→            <p className=\"text-text-secondary text-lg\">\n    68→              {activeTab === 'upcoming' && 'No upcoming trips'}\n    69→              {activeTab === 'past' && 'No past trips'}\n    70→              {activeTab === 'cancelled' && 'No cancelled trips.'}\n    71→            </p>\n    72→            {activeTab === 'upcoming' && (\n    73→              <Link\n    74→                to=\"/\"\n    75→                className=\"inline-block mt-3 text-primary hover:text-primary-dark font-medium\"\n    76→              >\n    77→                Browse properties\n    78→              </Link>\n    79→            )}\n    80→          </div>\n    81→        ) : (\n    82→          <div className=\"grid gap-4\">\n    83→            {filtered.map((booking) => (\n    84→              <TripCard\n    85→                key={booking.id}\n    86→                booking={booking}\n    87→                onCancel={() => onCancelBooking(booking)}\n    88→              />\n    89→            ))}\n    90→          </div>\n    91→        )}\n    92→      </div>\n    93→    </div>\n    94→  )\n    95→}\n    96→"}]},"parent_tool_use_id":null,"session_id":"bf64fb1f-6d22-482a-898e-953cd6c2617e","uuid":"229850c0-0b67-42fd-9719-2cb768b64d43","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/components/TripsTabs.tsx","content":"import { useState } from 'react'\nimport type { Booking } from '../slices/bookingsSlice'\nimport TripCard from './TripCard'\nimport { Link } from 'react-router-dom'\n\ntype TabKey = 'upcoming' | 'past' | 'cancelled'\n\ninterface TripsTabsProps {\n  bookings: Booking[]\n  onCancelBooking: (booking: Booking) => void\n}\n\nconst tabs: { key: TabKey; label: string }[] = [\n  { key: 'upcoming', label: 'Upcoming' },\n  { key: 'past', label: 'Past' },\n  { key: 'cancelled', label: 'Cancelled' },\n]\n\nfunction filterBookings(bookings: Booking[], tab: TabKey): Booking[] {\n  const today = new Date().toISOString().split('T')[0]\n  switch (tab) {\n    case 'upcoming':\n      return bookings\n        .filter(\n          (b) =>\n            (b.status === 'pending' || b.status === 'confirmed') &&\n            b.check_in.split('T')[0]! >= today!\n        )\n        .sort((a, b) => a.check_in.localeCompare(b.check_in))\n    case 'past':\n      return bookings\n        .filter((b) => b.status === 'completed')\n        .sort((a, b) => a.check_in.localeCompare(b.check_in))\n    case 'cancelled':\n      return bookings\n        .filter((b) => b.status === 'cancelled')\n        .sort((a, b) => a.check_in.localeCompare(b.check_in))\n  }\n}\n\nexport default function TripsTabs({ bookings, onCancelBooking }: TripsTabsProps) {\n  const [activeTab, setActiveTab] = useState<TabKey>('upcoming')\n  const filtered = filterBookings(bookings, activeTab)\n\n  return (\n    <div data-testid=\"trips-tabs\">\n      <div className=\"flex gap-1 border-b border-border mb-6\">\n        {tabs.map((tab) => (\n          <button\n            key={tab.key}\n            data-testid={`tab-${tab.key}`}\n            onClick={() => setActiveTab(tab.key)}\n            className={`px-4 py-3 text-sm font-medium border-b-2 transition-colors ${\n              activeTab === tab.key\n                ? 'border-text text-text'\n                : 'border-transparent text-text-secondary hover:text-text hover:border-border-dark'\n            }`}\n          >\n            {tab.label}\n          </button>\n        ))}\n      </div>\n\n      <div data-testid=\"trips-list\">\n        {filtered.length === 0 ? (\n          <div data-testid=\"trips-empty-state\" className=\"text-center py-12\">\n            <p className=\"text-text-secondary text-lg\">\n              {activeTab === 'upcoming' && 'No upcoming trips'}\n              {activeTab === 'past' && 'No past trips'}\n              {activeTab === 'cancelled' && 'No cancelled trips.'}\n            </p>\n            {activeTab === 'upcoming' && (\n              <Link\n                to=\"/\"\n                className=\"inline-block mt-3 text-primary hover:text-primary-dark font-medium\"\n              >\n                Browse properties\n              </Link>\n            )}\n          </div>\n        ) : (\n          <div className=\"grid gap-4\">\n            {filtered.map((booking) => (\n              <TripCard\n                key={booking.id}\n                booking={booking}\n                onCancel={() => onCancelBooking(booking)}\n              />\n            ))}\n          </div>\n        )}\n      </div>\n    </div>\n  )\n}\n","numLines":96,"startLine":1,"totalLines":96}}}
