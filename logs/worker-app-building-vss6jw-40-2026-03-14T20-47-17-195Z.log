@example.com')\n   107→    await page.goto('/trips')\n   108→\n   109→    await expect(page.getByTestId('my-trips-page')).toBeVisible({ timeout: 30000 })\n   110→    await page.getByTestId('tab-cancelled').click()\n   111→\n   112→    await expect(page.getByTestId('trips-empty-state')).toBeVisible({ timeout: 30000 })\n   113→    await expect(page.getByTestId('trips-empty-state')).toContainText('No cancelled trips')\n   114→  })\n   115→\n   116→  test('Upcoming tab empty state message', async ({ page }) => {\n   117→    // Sarah is a host with no guest bookings, so upcoming tab will be empty\n   118→    await loginAs(page, 'sarah@example.com')\n   119→    await page.goto('/trips')\n   120→\n   121→    await expect(page.getByTestId('my-trips-page')).toBeVisible({ timeout: 30000 })\n   122→\n   123→    // Upcoming tab is default and should show empty state\n   124→    await expect(page.getByTestId('trips-empty-state')).toBeVisible({ timeout: 30000 })\n   125→    await expect(page.getByTestId('trips-empty-state')).toContainText('No upcoming trips')\n   126→    // Should have a link to browse properties\n   127→    await expect(page.getByTestId('trips-empty-state').locator('a')).toContainText('Browse properties')\n   128→  })\n   129→\n   130→  test('Cancelled tab empty state message', async ({ page }) => {\n   131→    // Emma has no cancelled bookings\n   132→    await loginAs(page, 'emma@example.com')\n   133→    await page.goto('/trips')\n   134→\n   135→    await expect(page.getByTestId('my-trips-page')).toBeVisible({ timeout: 30000 })\n   136→    await page.getByTestId('tab-cancelled').click()\n   137→\n   138→    await expect(page.getByTestId('trips-empty-state')).toBeVisible({ timeout: 30000 })\n   139→    await expect(page.getByTestId('trips-empty-state')).toContainText('No cancelled trips')\n   140→  })\n   141→\n   142→  test('Tabs are functional on repeated use', async ({ page }) => {\n   143→    test.slow()\n   144→    await loginAs(page, 'emma@example.com')