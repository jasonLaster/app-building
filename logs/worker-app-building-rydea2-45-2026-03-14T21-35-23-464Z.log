[2026-03-14T21:35:00.972Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01T69MqdU4MU3PJCCQR11XJC","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test';\n     2→\n     3→// Helper to login as Alice and return token\n     4→async function loginAsAlice(baseURL: string): Promise<string> {\n     5→  const response = await fetch(`${baseURL}/api/login`, {\n     6→    method: 'POST',\n     7→    headers: { 'Content-Type': 'application/json' },\n     8→    body: JSON.stringify({ email: 'alice@acme.com', password: 'password123' }),\n     9→  });\n    10→  const data = await response.json();\n    11→  return data.token;\n    12→}\n    13→\n    14→// Helper to get notifications via API\n    15→async function getNotifications(baseURL: string, token: string) {\n    16→  const response = await fetch(`${baseURL}/api/notifications`, {\n    17→    headers: { Authorization: `Bearer ${token}` },\n    18→  });\n    19→  const data = await response.json();\n    20→  return data.notifications as Array<{\n    21→    id: string;\n    22→    type: string;\n    23→    issue_id: string;\n    24→    description: string;\n    25→    read: boolean;\n    26→    issue_identifier: string;\n    27→    created_at: string;\n    28→  }>;\n    29→}\n    30→\n    31→// Helper to mark notification as read via API\n    32→async function markNotificationReadAPI(baseURL: string, token: string, id: string) {\n    33→  await fetch(`${baseURL}/api/notifications/${id}/read`, {\n    34→    method: 'PUT',\n    35→    headers: { Authorization: `Bearer ${token}` },\n    36→  });\n    37→}\n    38→\n    39→// Helper to authenticate page as Alice\n    40→async function authenticatePage(page: any, baseURL: string): Promise<string> {\n    41→  const token = await loginAsAlice(baseURL);\n    42→  await page.goto('/login');\n    43→  await page.evaluate((t: string) => localStorage.setItem('session_token', t), token);\n    44→  return token;\n    45→}\n    46→\n    47→test.describe('Notification Row', () => {\n    48→  test('Notification row displays assignment notification correctly', async ({ page, baseURL }) => {\n    49→    const token = await authenticatePage(page, baseURL!);\n    50→    await page.goto('/inbox');\n    51→    await expect(page.getByTestId('notification-list')).toBeVisible({ timeout: 30000 });\n    52→\n    53→    const notifications = await getNotifications(baseURL!, token);\n    54→    const assignmentNotif = notifications.find((n) => n.type === 'assignment');\n    55→    expect(assignmentNotif).toBeTruthy();\n    56→\n    57→    const row = page.getByTestId(`notification-row-${assignmentNotif!.id}`);\n    58→    await expect(row).toBeVisible();\n    59→\n    60→    // Icon should be present\n    61→    await expect(page.getByTestId(`notification-icon-${assignmentNotif!.id}`)).toBeVisible();\n    62→    // Should have assignment icon class\n    63→    await expect(\n    64→      page.getByTestId(`notification-icon-${assignmentNotif!.id}`).locator('.notification-type-icon-assignment')\n    65→    ).toBeVisible();\n    66→\n    67→    // Issue identifier\n    68→    await expect(page.getByTestId(`notification-identifier-${assignmentNotif!.id}`)).toContainText(assignmentNotif!.issue_identifier);\n    69→\n    70→    // Description\n    71→    await expect(page.getByTestId(`notification-description-${assignmentNotif!.id}`)).toBeVisible();\n    72→\n    73→    // Timestamp (relative format)\n    74→    const timestamp = page.getByTestId(`notification-timestamp-${assignmentNotif!.id}`);\n    75→    await expect(timestamp).toBeVisible();\n    76→    await expect(timestamp).toContainText(/ago|just now/);\n    77→  });\n    78→\n    79→  test('Notification row displays issue update notification correctly', async ({ page, baseURL }) => {\n    80→    const token = await authenticatePage(page, baseURL!);\n    81→    await page.goto('/inbox');\n    82→    await expect(page.getByTestId('notification-list')).toBeVisible({ timeout: 30000 });\n    83→\n    84→    const notifications = await getNotifications(baseURL!, token);\n    85→    const updateNotif = notifications.find((n) => n.type === 'update');\n    86→    expect(updateNotif).toBeTruthy();\n    87→\n    88→    const row = page.getByTestId(`notification-row-${updateNotif!.id}`);\n    89→    await expect(row).toBeVisible();\n    90→\n    91→    // Should have update icon class\n    92→    await expect(\n    93→      page.getByTestId(`notification-icon-${updateNotif!.id}`).locator('.notification-type-icon-update')\n    94→    ).toBeVisible();\n    95→\n    96→    // Issue identifier\n    97→    await expect(page.getByTestId(`notification-identifier-${updateNotif!.id}`)).toContainText(updateNotif!.issue_identifier);\n    98→\n    99→    // Timestamp\n   100→    const timestamp = page.getByTestId(`notification-timestamp-${updateNotif!.id}`);\n   101→    await expect(timestamp).toBeVisible();\n   102→    await expect(timestamp).toContainText(/ago|just now/);\n   103→  });\n   104→\n   105→  test('Notification row displays mention notification correctly', async ({ page, baseURL }) => {\n   106→    const token = await authenticatePage(page, baseURL!);\n   107→    await page.goto('/inbox');\n   108→    await expect(page.getByTestId('notification-list')).toBeVisible({ timeout: 30000 });\n   109→\n   110→    const notifications = await getNotifications(baseURL!, token);\n   111→    const mentionNotif = notifications.find((n) => n.type === 'mention');\n   112→    expect(mentionNotif).toBeTruthy();\n   113→\n   114→    const row = page.getByTestId(`notification-row-${mentionNotif!.id}`);\n   115→    await expect(row).toBeVisible();\n   116→\n   117→    // Should have mention icon class\n   118→    await expect(\n   119→      page.getByTestId(`notification-icon-${mentionNotif!.id}`).locator('.notification-type-icon-mention')\n   120→    ).toBeVisible();\n   121→\n   122→    // Issue identifier\n   123→    await expect(page.getByTestId(`notification-identifier-${mentionNotif!.id}`)).toContainText(mentionNotif!.issue_identifier);\n   124→\n   125→    // Timestamp\n   126→    const timestamp = page.getByTestId(`notification-timestamp-${mentionNotif!.id}`);\n   127→    await expect(timestamp).toBeVisible();\n   128→    await expect(timestamp).toContainText(/ago|just now/);\n   129→  });\n   130→\n   131→  test('Clicking an unread notification marks it as read', async ({ page, baseURL }) => {\n   132→    const token = await authenticatePage(page, baseURL!);\n   133→    await page.goto('/inbox');\n   134→    await expect(page.getByTestId('notification-list')).toBeVisible({ timeout: 30000 });\n   135→\n   136→    const notifications = await getNotifications(baseURL!, token);\n   137→    const unreadNotif = notifications.find((n) => !n.read);\n   138→    expect(unreadNotif).toBeTruthy();\n   139→\n   140→    const row = page.getByTestId(`notification-row-${unreadNotif!.id}`);\n   141→\n   142→    // Verify it's visually unread\n   143→    await expect(row).toHaveClass(/notification-row-unread/, { timeout: 10000 });\n   144→\n   145→    // Get initial badge count\n   146→    const badgeText = await page.getByTestId('sidebar-inbox-badge').textContent();\n   147→    const initialBadge = parseInt(badgeText!, 10);\n   148→\n   149→    // Click the notification\n   150→    await row.click();\n   151→\n   152→    // Should navigate to issue detail\n   153→    await expect(page).toHaveURL(new RegExp(`/issue/${unreadNotif!.issue_id}`), { timeout: 30000 });\n   154→\n   155→    // Navigate back to inbox\n   156→    await page.getByTestId('sidebar-link-inbox').click();\n   157→    await expect(page).toHaveURL(/\\/inbox/, { timeout: 30000 });\n   158→    await expect(page.getByTestId('notification-list')).toBeVisible({ timeout: 30000 });\n   159→\n   160→    // Notification should now be read (no unread class)\n   161→    await expect(page.getByTestId(`notification-row-${unreadNotif!.id}`)).not.toHaveClass(/notification-row-unread/, { timeout: 15000 });\n   162→\n   163→    // Badge should have decremented\n   164→    if (initialBadge > 1) {\n   165→      await expect(page.getByTestId('sidebar-inbox-badge')).toHaveText(String(initialBadge - 1), { timeout: 15000 });\n   166→    } else {\n   167→      await expect(page.getByTestId('sidebar-inbox-badge')).not.toBeVisible({ timeout: 15000 });\n   168→    }\n   169→  });\n   170→\n   171→  test('Clicking a read notification does not change its state', async ({ page, baseURL }) => {\n   172→    const token = await authenticatePage(page, baseURL!);\n   173→    await page.goto('/inbox');\n   174→    await expect(page.getByTestId('notification-list')).toBeVisible({ timeout: 30000 });\n   175→\n   176→    const notifications = await getNotifications(baseURL!, token);\n   177→    const readNotif = notifications.find((n) => n.read);\n   178→    expect(readNotif).toBeTruthy();\n   179→\n   180→    const row = page.getByTestId(`notification-row-${readNotif!.id}`);\n   181→\n   182→    // Verify it's visually read (no unread class)\n   183→    await expect(row).not.toHaveClass(/notification-row-unread/, { timeout: 10000 });\n   184→\n   185→    // Click the notification\n   186→    await row.click();\n   187→\n   188→    // Should navigate to issue detail\n   189→    await expect(page).toHaveURL(new RegExp(`/issue/${readNotif!.issue_id}`), { timeout: 30000 });\n   190→\n   191→    // Navigate back to inbox\n   192→    await page.getByTestId('sidebar-link-inbox').click();\n   193→    await expect(page).toHaveURL(/\\/inbox/, { timeout: 30000 });\n   194→    await expect(page.getByTestId('notification-list')).toBeVisible({ timeout: 30000 });\n   195→\n   196→    // Notification should still be read\n   197→    await expect(page.getByTestId(`notification-row-${readNotif!.id}`)).not.toHaveClass(/notification-row-unread/, { timeout: 15000 });\n   198→  });\n   199→\n   200→  test('Clicking a notification navigates to the related issue', async ({