+) {\n   136→        const stop = stops[i]!\n   137→        const legOriginId = airportMap.get(stop.origin)\n   138→        const legDestId = airportMap.get(stop.dest)\n   139→        if (!legOriginId || !legDestId) continue\n   140→        await sql`\n   141→          INSERT INTO flight_legs (flight_id, leg_order, origin_airport_id, destination_airport_id, departure_time, arrival_time, duration_minutes, airline_id, flight_number, aircraft_type, terminal_departure, terminal_arrival)\n   142→          VALUES (${flightId}, ${i + 1}, ${legOriginId}, ${legDestId}, ${stop.dep}, ${stop.arr}, ${stop.dur}, ${airlineId}, ${flightNum}, ${aircraft}, ${stop.terminal_dep || null}, ${stop.terminal_arr || null})\n   143→        `\n   144→      }\n   145→    } else {\n   146→      await sql`\n   147→        INSERT INTO flight_legs (flight_id, leg_order, origin_airport_id, destination_airport_id, departure_time, arrival_time, duration_minutes, airline_id, flight_number, aircraft_type, terminal_departure, terminal_arrival)\n   148→        VALUES (${flightId}, ${1}, ${originId}, ${destId}, ${depTime}, ${arrTime}, ${durationMin}, ${airlineId}, ${flightNum}, ${aircraft}, ${'T1'}, ${'T2'})\n   149→      `\n   150→    }\n   151→\n   152→    // Add prices for all cabin classes\n   153→    const premiumMult = 1.8\n   154→    const businessMult = 3.5\n   155→    const firstMult = 6.0\n   156→    const taxRate = 0.15\n   157→\n   158→    for (const [cabinClass, mult] of [['economy', 1], ['premium_economy', premiumMult], ['business', businessMult], ['first', firstMult]] as [string, number][]) {\n   159→      const basePrice = Math.round(economyPrice * mult * 100)\n   160→      const taxes = Math.round(basePrice * taxRate)\n   161→      const total = basePrice + taxes\n   162→      const seats = Math.floor(Math.random() * 30) + 5\n   163→      await sql`\n   164→        INSERT INTO prices (flight_id, cabin_class, base_price_cents, taxes_cents, total_price_cents, available_seats)\n   165→       