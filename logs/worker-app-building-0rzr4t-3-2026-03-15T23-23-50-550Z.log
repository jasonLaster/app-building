[2026-03-15T23:23:31.793Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ULSnuKFdCYdky4Qt6dDiFc","type":"tool_result","content":"     1→import { execSync } from 'child_process'\n     2→import { readFileSync, writeFileSync, existsSync, mkdirSync } from 'fs'\n     3→import { join } from 'path'\n     4→import { initSchema } from './schema.ts'\n     5→import { truncateAndSeed } from './seed-db.ts'\n     6→\n     7→const appDir = join(import.meta.dirname, '..')\n     8→const logDir = join(appDir, 'logs')\n     9→mkdirSync(logDir, { recursive: true })\n    10→const logPath = join(logDir, 'deploy.log')\n    11→let logContent = ''\n    12→function log(msg: string) { logContent += msg + '\\n' }\n    13→\n    14→const envPath = join(appDir, '.env')\n    15→const deploymentPath = join(appDir, 'deployment.txt')\n    16→\n    17→function readEnv(): Record<string, string> {\n    18→  if (!existsSync(envPath)) return {}\n    19→  const lines = readFileSync(envPath, 'utf-8').split('\\n')\n    20→  const env: Record<string, string> = {}\n    21→  for (const line of lines) {\n    22→    const idx = line.indexOf('=')\n    23→    if (idx > 0 && !line.startsWith('#')) {\n    24→      env[line.slice(0, idx).trim()] = line.slice(idx + 1).trim()\n    25→    }\n    26→  }\n    27→  return env\n    28→}\n    29→\n    30→function writeEnvVar(key: string, value: string) {\n    31→  const content = existsSync(envPath) ? readFileSync(envPath, 'utf-8') : ''\n    32→  const lines = content.split('\\n')\n    33→  const idx = lines.findIndex(l => l.startsWith(key + '='))\n    34→  if (idx >= 0) {\n    35→    lines[idx] = `${key}=${value}`\n    36→  } else {\n    37→    lines.push(`${key}=${value}`)\n    38→  }\n    39→  writeFileSync(envPath, lines.join('\\n'))\n    40→}\n    41→\n    42→const NEON_API_KEY = (process.env.NEON_API_KEY || '').trim()\n    43→const NETLIFY_AUTH_TOKEN = process.env.NETLIFY_AUTH_TOKEN || ''\n    44→const NETLIFY_ACCOUNT_SLUG = process.env.NETLIFY_ACCOUNT_SLUG || ''\n    45→\n    46→async function neonApi(method: string, path: string, body?: unknown) {\n    47→  const opts: RequestInit = {\n    48→    method,\n    49→    headers: {\n    50→      'Authorization': `Bearer ${NEON_API_KEY}`,\n    51→      'Content-Type': 'application/json',\n    52→    },\n    53→  }\n    54→  if (body) opts.body = JSON.stringify(body)\n    55→  const res = await fetch(`https://console.neon.tech/api/v2${path}`, opts)\n    56→  return res.json()\n    57→}\n    58→\n    59→async function main() {\n    60→  let env = readEnv()\n    61→  let isFirstDeploy = false\n    62→\n    63→  // Step 1: Database setup\n    64→  if (!env.NEON_PROJECT_ID) {\n    65→    log('Creating Neon project...')\n    66→    const res = await neonApi('POST', '/projects', { project: { name: 'google-flights' } }) as {\n    67→      project?: { id: string };\n    68→      connection_uris?: { connection_uri: string }[];\n    69→    }\n    70→    const projectId = res.project?.id\n    71→    const dbUrl = res.connection_uris?.[0]?.connection_uri\n    72→    if (!projectId || !dbUrl) {\n    73→      log('Failed to create project: ' + JSON.stringify(res))\n    74→      writeFileSync(logPath, logContent)\n    75→      console.log('Deploy failed (neon) — see logs/deploy.log')\n    76→      process.exit(1)\n    77→    }\n    78→    writeEnvVar('NEON_PROJECT_ID', projectId)\n    79→    writeEnvVar('DATABASE_URL', dbUrl)\n    80→    env = readEnv()\n    81→    isFirstDeploy = true\n    82→    log(`Created Neon project: ${projectId}`)\n    83→  }\n    84→\n    85→  // Step 2: Schema sync\n    86→  log('Syncing schema...')\n    87→  await initSchema(env.DATABASE_URL!)\n    88→  log('Schema synced')\n    89→\n    90→  // Step 3: Seed on first deploy\n    91→  if (isFirstDeploy) {\n    92→    log('Seeding database (first deploy)...')\n    93→    await truncateAndSeed(env.DATABASE_URL!)\n    94→    log('Database seeded')\n    95→  }\n    96→\n    97→  // Step 4: Netlify site setup\n    98→  if (!env.NETLIFY_SITE_ID) {\n    99→    log('Creating Netlify site...')\n   100→    try {\n   101→      const siteName = `google-flights-${Date.now()}`\n   102→      const output = execSync(\n   103→        `LC_ALL=C npx netlify sites:create --account-slug ${NETLIFY_ACCOUNT_SLUG} --name ${siteName}`,\n   104→        { cwd: appDir, env: { ...process.env, NETLIFY_AUTH_TOKEN }, encoding: 'utf-8', stdio: ['ignore', 'pipe', 'pipe'] }\n   105→      )\n   106→      log(output)\n   107→      // Extract site ID from output\n   108→      const siteIdMatch = output.match(/Site ID:\\s+([a-f0-9-]+)/i) || output.match(/([a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12})/)\n   109→      if (siteIdMatch?.[1]) {\n   110→        writeEnvVar('NETLIFY_SITE_ID', siteIdMatch[1])\n   111→        env = readEnv()\n   112→        log(`Created Netlify site: ${siteIdMatch[1]}`)\n   113→      }\n   114→    } catch (e: unknown) {\n   115→      const err = e as { stdout?: string; stderr?: string }\n   116→      log('Site creation output: ' + (err.stdout || '') + (err.stderr || ''))\n   117→    }\n   118→  }\n   119→\n   120→  // Ensure public/_redirects exists for SPA routing\n   121→  const publicDir = join(appDir, 'public')\n   122→  mkdirSync(publicDir, { recursive: true })\n   123→  writeFileSync(join(publicDir, '_redirects'), '/* /index.html 200\\n')\n   124→\n   125→  // Step 5: Build\n   126→  log('Building app...')\n   127→  try {\n   128→    const buildOutput = execSync('npx vite build', {\n   129→      cwd: appDir,\n   130→      encoding: 'utf-8',\n   131→      stdio: ['ignore', 'pipe', 'pipe'],\n   132→      env: { ...process.env },\n   133→    })\n   134→    log('=== Build Output ===\\n' + buildOutput)\n   135→  } catch (e: unknown) {\n   136→    const err = e as { stdout?: string; stderr?: string }\n   137→    log('=== Build Failed ===\\n' + (err.stdout || '') + '\\n' + (err.stderr || ''))\n   138→    writeFileSync(logPath, logContent)\n   139→    console.log('Deploy failed (build) — see logs/deploy.log')\n   140→    process.exit(1)\n   141→  }\n   142→\n   143→  // Step 6: Deploy\n   144→  log('Deploying to Netlify...')\n   145→  const siteId = env.NETLIFY_SITE_ID || ''\n   146→\n   147→  // Link site if needed\n   148→  if (siteId) {\n   149→    try {\n   150→      execSync(`LC_ALL=C npx netlify link --id ${siteId}`, {\n   151→        cwd: appDir,\n   152→        env: { ...process.env, NETLIFY_AUTH_TOKEN },\n   153→        stdio: 'ignore',\n   154→      })\n   155→    } catch { /* ignore */ }\n   156→  }\n   157→\n   158→  let deployUrl = ''\n   159→  try {\n   160→    const deployOutput = execSync(\n   161→      `LC_ALL=C npx netlify deploy --prod --dir dist --functions ./netlify/functions${siteId ? ` --site ${siteId}` : ''}`,\n   162→      {\n   163→        cwd: appDir,\n   164→        env: { ...process.env, NETLIFY_AUTH_TOKEN },\n   165→        encoding: 'utf-8',\n   166→        stdio: ['ignore', 'pipe', 'pipe'],\n   167→      }\n   168→    )\n   169→    log('=== Deploy Output ===\\n' + deployOutput)\n   170→    const urlMatch = deployOutput.match(/https:\\/\\/[^\\s]+\\.netlify\\.app/)\n   171→    if (urlMatch) deployUrl = urlMatch[0]\n   172→  } catch (e: unknown) {\n   173→    const err = e as { stdout?: string; stderr?: string }\n   174→    log('=== Deploy Failed ===\\n' + (err.stdout || '') + '\\n' + (err.stderr || ''))\n   175→    writeFileSync(logPath, logContent)\n   176→    console.log('Deploy failed (netlify) — see logs/deploy.log')\n   177→    process.exit(1)\n   178→  }\n   179→\n   180→  // Step 7: Write deployment.txt\n   181→  env = readEnv()\n   182→  const resourceBlock = `url=${deployUrl}\n   183→site_id=${env.NETLIFY_SITE_ID || siteId}\n   184→neon_project_id=${env.NEON_PROJECT_ID || ''}\n   185→database_url=${env.DATABASE_URL || ''}`\n   186→\n   187→  let existingHistory = ''\n   188→  if (existsSync(deploymentPath)) {\n   189→    const existing = readFileSync(deploymentPath, 'utf-8')\n   190→    const historyIdx = existing.indexOf('\\n---\\n')\n   191→    if (historyIdx >= 0) existingHistory = existing.slice(historyIdx)\n   192→  }\n   193→  writeFileSync(deploymentPath, resourceBlock + '\\n' + existingHistory)\n   194→\n   195→  writeFileSync(logPath, logContent)\n   196→  console.log(`Deployed to ${deployUrl || 'Netlify'}`)\n   197→}\n   198→\n   199→main().catch(e => {\n   200→  log(String(e))\n   201→  writeFileSync(logPath, logContent)\n   202→  console.error('Deploy failed — see logs/deploy.log')\n   203→  process.exit(1)\n   204→})\n   205→"}]},"parent_tool_use_id":"toolu_01BvW1QsicJaf6kyD3mtVfdT","session_id":"e5d16018-2020-41b2-88f2-80c18c9d8446","uuid":"c2e9ed03-5c38-4d18-8009-6ce5441f2153"}
