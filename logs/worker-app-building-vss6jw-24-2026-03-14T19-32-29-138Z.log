   ORDER BY r.created_at DESC\n    43→    `\n    44→\n    45→    return new Response(JSON.stringify({ ...property, images, amenities, reviews }), { status: 200, headers })\n    46→  }\n    47→\n    48→  if (request.method === 'GET') {\n    49→    const city = url.searchParams.get('city') || ''\n    50→    const checkIn = url.searchParams.get('check_in') || ''\n    51→    const checkOut = url.searchParams.get('check_out') || ''\n    52→    const guestsStr = url.searchParams.get('guests') || '0'\n    53→    const propertyType = url.searchParams.get('property_type') || ''\n    54→    const minPriceStr = url.searchParams.get('min_price') || '0'\n    55→    const maxPriceStr = url.searchParams.get('max_price') || '0'\n    56→    const minBedroomsStr = url.searchParams.get('min_bedrooms') || '0'\n    57→    const minBedsStr = url.searchParams.get('min_beds') || '0'\n    58→    const minBathroomsStr = url.searchParams.get('min_bathrooms') || '0'\n    59→    const amenitiesParam = url.searchParams.get('amenities') || ''\n    60→    const page = parseInt(url.searchParams.get('page') || '1', 10)\n    61→    const limit = parseInt(url.searchParams.get('limit') || '12', 10)\n    62→    const offset = (page - 1) * limit\n    63→\n    64→    const guestsNum = parseInt(guestsStr, 10) || 0\n    65→    const minPrice = parseFloat(minPriceStr) || 0\n    66→    const maxPrice = parseFloat(maxPriceStr) || 0\n    67→    const minBedrooms = parseInt(minBedroomsStr, 10) || 0\n    68→    const minBeds = parseInt(minBedsStr, 10) || 0\n    69→    const minBathrooms = parseInt(minBathroomsStr, 10) || 0\n    70→    const amenityIds = amenitiesParam ? amenitiesParam.split(',').filter(Boolean) : []\n    71→    const amenityCount = amenityIds.length\n    72→    const hasDateFilter = checkIn !== '' && checkOut !== ''\n    73→    const hasAmenityFilter = amenityCount > 0\n    74→\n    75→    const countResult = await sql`\n    76→      SELECT count(*)::int as total\n    77→      FROM properties p\n    78→      WHERE p.is_active = true\n    79→        AND (${city} = '' OR LOWER(p.city) LIKE LOWER('%' || ${city} || '%'))\n    80→        AND (${guestsNum} = 0 OR p.max_guests >= ${guestsNum})\n    81→        AND (${propertyType} = '' OR p.property_type = ${propertyType})\n    82→        AND (${minPrice} = 0 OR p.price_per_night >= ${minPrice})\n    83→        AND (${maxPrice} = 0 OR p.price_per_night <= ${maxPrice})\n    84→        AND (${minBedrooms} = 0 OR p.bedrooms >= ${minBedrooms})\n    85→        AND (${minBeds} = 0 OR p.beds >= ${minBeds})\n    86→        AND (${minBathrooms} = 0 OR p.bathrooms >= ${minBathrooms})\n    87→        AND (${!hasDateFilter} OR NOT EXISTS (\n    88→          SELECT 1 FROM bookings b\n    89→          WHERE b.property_id = p.id\n    90→          AND b.status IN ('confirmed', 'pending')\n    91→          AND b.check_in < ${checkOut || '9999-12-31'}\n    92→          AND b.check_out > ${checkIn || '1970-01-01'}\n    93→        ))\n    94→        AND (${!hasAmenityFilter} OR (\n    95→          SELECT count(*) FROM property_amenities pa\n    96→          WHERE pa.property_id = p.id AND pa.amenity_id::text = ANY(${amenityIds})\n    97→        ) >= ${amenityCount})\n    98→    `\n    99→    const countRow = countResult[0]\n   100→    const total = countRow ? (countRow as Record<string, unknown>).total as number : 0\n   101→\n   102→    const properties = await sql`\n   103→      SELECT p.*,\n   104→        (SELECT url FROM property_images pi WHERE pi.property_id = p.id ORDER BY pi.display_order ASC LIMIT 1) as main_image,\n   105→        (SELECT COALESCE(AVG(r.rating)::numeric(10,1), 0) FROM reviews r WHERE r.property_id = p.id) as avg_rating,\n   106→        (SELECT count(*)::int FROM reviews r WHERE r.property_id = p.id) as review_count\n   107→      FROM properties p\n   108→      WHERE p.is_active = true\n   109→        AND (${city} = '' OR LOWER(p.city) LIKE LOWER('%' || ${city} || '%'))\n   110→        AND (${guestsNum} = 0 OR p.max_guests >= ${guestsNum})\n   111→        AND (${propertyType} = '' OR p.property_type = ${propertyType})\n   112→        AND (${minPrice} = 0 OR p.price_per_night >= ${minPrice})\n   113→        AND (${maxPrice} = 0 OR p.price_per_night <= ${maxPrice})\n   114→        AND (${minBedrooms} = 0 OR p.bedrooms >= ${minBedrooms})\n   115→        AND (${minBeds} = 0 OR p.beds >= ${minBeds})\n   116→        AND (${minBathrooms} = 0 OR p.bathrooms >= ${minBathrooms})\n   117→        AND (${!hasDateFilter} OR NOT EXISTS (\n   118→          SELECT 1 FROM bookings b\n   119→          WHERE b.property_id = p.id\n   120→          AND b.status IN ('confirmed', 'pending')\n   121→          AND b.check_in < ${checkOut || '9999-12-31'}\n   122→          AND b.check_out > ${checkIn || '1970-01-01'}\n   123→        ))\n   124→        AND (${!hasAmenityFilter} OR (\n   125→          SELECT count(*) FROM property_amenities pa\n   126→          WHERE pa.property_id = p.id AND pa.amenity_id::text = ANY(${amenityIds})\n   127→        ) >= ${amenityCount})\n   128→      ORDER BY p.created_at DESC\n   129→      LIMIT ${limit} OFFSET ${offset}\n   130→    `\n   131→\n   132→    return new Response(JSON.stringify({\n   133→      properties,\n   134→      total,\n   135→      page,\n   136→      limit,\n   137→      totalPages: Math.ceil(total / limit),\n   138→    }), { status: 200, headers })\n   139→  }\n   140→\n   141→  return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers })\n   142→}\n   143→"}]},"parent_tool_use_id":null,"session_id":"0eaeef5d-e35c-43d7-a0b9-dfed2a7c76ad","uuid":"9faed774-1bd7-4b36-93ae-227a0da2d1e0","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/netlify/functions/properties.ts","content":"import type { Context } from '@netlify/functions'\nimport { getSql } from './db.js'\n\nexport default async (request: Request, _context: Context) => {\n  const sql = getSql()\n  const url = new URL(request.url)\n  const segments = url.pathname.split('/').filter(Boolean)\n  const propertyId = segments[2] // /api/properties/:id\n\n  const headers = { 'Content-Type': 'application/json' }\n\n  if (request.method === 'GET' && propertyId) {\n    const result = await sql`\n      SELECT p.*,\n        u.name as host_name, u.avatar_url as host_avatar, u.bio as host_bio, u.created_at as host_since,\n        (SELECT count(*)::int FROM properties WHERE host_id = p.host_id AND is_active = true) as host_listing_count\n      FROM properties p\n      JOIN users u ON u.id = p.host_id\n      WHERE p.id = ${propertyId}\n    `\n    const property = result[0]\n    if (!property) {\n      return new Response(JSON.stringify({ error: 'Property not found' }), { status: 404, headers })\n    }\n\n    const images = await sql`\n      SELECT * FROM property_images WHERE property_id = ${propertyId} ORDER BY display_order ASC\n    `\n\n    const amenities = await sql`\n      SELECT a.* FROM amenities a\n      JOIN property_amenities pa ON pa.amenity_id = a.id\n      WHERE pa.property_id = ${propertyId}\n      ORDER BY a.category, a.name\n    `\n\n    const reviews = await sql`\n      SELECT r.*, u.name as guest_name, u.avatar_url as guest_avatar\n      FROM reviews r\n      JOIN users u ON u.id = r.guest_id\n      WHERE r.property_id = ${propertyId}\n      ORDER BY r.created_at DESC\n    `\n\n    return new Response(JSON.stringify({ ...property, images, amenities, reviews }), { status: 200, headers })\n  }\n\n  if (request.method === 'GET') {\n    const city = url.searchParams.get('city') || ''\n    const checkIn = url.searchParams.get('check_in') || ''\n    const checkOut = url.searchParams.get('check_out') || ''\n    const guestsStr = url.searchParams.get('guests') || '0'\n    const propertyType = url.searchParams.get('property_type') || ''\n    const minPriceStr = url.searchParams.get('min_price') || '0'\n    const maxPriceStr = url.searchParams.get('max_price') || '0'\n    const minBedroomsStr = url.searchParams.get('min_bedrooms') || '0'\n    const minBedsStr = url.searchParams.get('min_beds') || '0'\n    const minBathroomsStr = url.searchParams.get('min_bathrooms') || '0'\n    const amenitiesParam = url.searchParams.get('amenities') || ''\n    const page = parseInt(url.searchParams.get('page') || '1', 10)\n    const limit = parseInt(url.searchParams.get('limit') || '12', 10)\n    const offset = (page - 1) * limit\n\n    const guestsNum = parseInt(guestsStr, 10) || 0\n    const minPrice = parseFloat(minPriceStr) || 0\n    const maxPrice = parseFloat(maxPriceStr) || 0\n    const minBedrooms = parseInt(minBedroomsStr, 10) || 0\n    const minBeds = parseInt(minBedsStr, 10) || 0\n    const minBathrooms = parseInt(minBathroomsStr, 10) || 0\n    const amenityIds = amenitiesParam ? amenitiesParam.split(',').filter(Boolean) : []\n    const amenityCount = amenityIds.length\n    const hasDateFilter = checkIn !== '' && checkOut !== ''\n    const hasAmenityFilter = amenityCount > 0\n\n    const countResult = await sql`\n      SELECT count(*)::int as total\n      FROM properties p\n      WHERE p.is_active = true\n        AND (${city} = '' OR LOWER(p.city) LIKE LOWER('%' || ${city} || '%'))\n        AND (${guestsNum} = 0 OR p.max_guests >= ${guestsNum})\n        AND (${propertyType} = '' OR p.property_type = ${propertyType})\n        AND (${minPrice} = 0 OR p.price_per_night >= ${minPrice})\n        AND (${maxPrice} = 0 OR p.price_per_night <= ${maxPrice})\n        AND (${minBedrooms} = 0 OR p.bedrooms >= ${minBedrooms})\n        AND (${minBeds} = 0 OR p.beds >= ${minBeds})\n        AND (${minBathrooms} = 0 OR p.bathrooms >= ${minBathrooms})\n        AND (${!hasDateFilter} OR NOT EXISTS (\n          SELECT 1 FROM bookings b\n          WHERE b.property_id = p.id\n          AND b.status IN ('confirmed', 'pending')\n          AND b.check_in < ${checkOut || '9999-12-31'}\n          AND b.check_out > ${checkIn || '1970-01-01'}\n        ))\n        AND (${!hasAmenityFilter} OR (\n          SELECT count(*) FROM property_amenities pa\n          WHERE pa.property_id = p.id AND pa.amenity_id::text = ANY(${amenityIds})\n        ) >= ${amenityCount})\n    `\n    const countRow = countResult[0]\n    const total = countRow ? (countRow as Record<string, unknown>).total as number : 0\n\n    const properties = await sql`\n      SELECT p.*,\n        (SELECT url FROM property_images pi WHERE pi.property_id = p.id ORDER BY pi.display_order ASC LIMIT 1) as main_image,\n        (SELECT COALESCE(AVG(r.rating)::numeric(10,1), 0) FROM reviews r WHERE r.property_id = p.id) as avg_rating,\n        (SELECT count(*)::int FROM reviews r WHERE r.property_id = p.id) as review_count\n      FROM properties p\n      WHERE p.is_active = true\n        AND (${city} = '' OR LOWER(p.city) LIKE LOWER('%' || ${city} || '%'))\n        AND (${guestsNum} = 0 OR p.max_guests >= ${guestsNum})\n        AND (${propertyType} = '' OR p.property_type = ${propertyType})\n        AND (${minPrice} = 0 OR p.price_per_night >= ${minPrice})\n        AND (${maxPrice} = 0 OR p.price_per_night <= ${maxPrice})\n        AND (${minBedrooms} = 0 OR p.bedrooms >= ${minBedrooms})\n        AND (${minBeds} = 0 OR p.beds >= ${minBeds})\n        AND (${minBathrooms} = 0 OR p.bathrooms >= ${minBathrooms})\n        AND (${!hasDateFilter} OR NOT EXISTS (\n          SELECT 1 FROM bookings b\n          WHERE b.property_id = p.id\n          AND b.status IN ('confirmed', 'pending')\n          AND b.check_in < ${checkOut || '9999-12-31'}\n          AND b.check_out > ${checkIn || '1970-01-01'}\n        ))\n        AND (${!hasAmenityFilter} OR (\n          SELECT count(*) FROM property_amenities pa\n          WHERE pa.property_id = p.id AND pa.amenity_id::text = ANY(${amenityIds})\n        ) >= ${amenityCount})\n      ORDER BY p.created_at DESC\n      LIMIT ${limit} OFFSET ${offset}\n    `\n\n    return new Response(JSON.stringify({\n      properties,\n      total,\n      page,\n      limit,\n      totalPages: Math.ceil(total / limit),\n    }), { status: 200, headers })\n  }\n\n  return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers })\n}\n","numLines":143,"startLine":1,"totalLines":143}}}
