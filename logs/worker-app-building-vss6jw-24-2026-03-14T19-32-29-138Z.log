[2026-03-14T19:25:14.347Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XwHvLj1hs6nsQQ45x5fYaS","type":"tool_result","content":"     1→import { useState } from 'react'\n     2→import { Search } from 'lucide-react'\n     3→\n     4→interface SearchBarProps {\n     5→  onSearch: (filters: { city: string; checkIn: string; checkOut: string; guests: number }) => void\n     6→  initialCity?: string\n     7→  initialCheckIn?: string\n     8→  initialCheckOut?: string\n     9→  initialGuests?: number\n    10→}\n    11→\n    12→export default function SearchBar({ onSearch, initialCity = '', initialCheckIn = '', initialCheckOut = '', initialGuests = 0 }: SearchBarProps) {\n    13→  const [city, setCity] = useState(initialCity)\n    14→  const [checkIn, setCheckIn] = useState(initialCheckIn)\n    15→  const [checkOut, setCheckOut] = useState(initialCheckOut)\n    16→  const [guests, setGuests] = useState(initialGuests)\n    17→\n    18→  const today = new Date().toISOString().split('T')[0]\n    19→\n    20→  const handleSubmit = (e: React.FormEvent) => {\n    21→    e.preventDefault()\n    22→    onSearch({ city, checkIn, checkOut, guests })\n    23→  }\n    24→\n    25→  const handleGuestsChange = (value: string) => {\n    26→    const num = parseInt(value, 10)\n    27→    if (isNaN(num) || num < 1) {\n    28→      setGuests(1)\n    29→    } else {\n    30→      setGuests(num)\n    31→    }\n    32→  }\n    33→\n    34→  return (\n    35→    <form\n    36→      data-testid=\"search-bar\"\n    37→      onSubmit={handleSubmit}\n    38→      className=\"flex flex-wrap items-center gap-3 rounded-full border border-border bg-bg p-2 shadow-md\"\n    39→    >\n    40→      <div className=\"flex-1 min-w-[160px]\">\n    41→        <input\n    42→          data-testid=\"search-location\"\n    43→          type=\"text\"\n    44→          placeholder=\"Where are you going?\"\n    45→          value={city}\n    46→          onChange={(e) => setCity(e.target.value)}\n    47→          className=\"w-full rounded-full px-4 py-2 text-sm text-text outline-none bg-transparent\"\n    48→        />\n    49→      </div>\n    50→      <div className=\"border-l border-border pl-3\">\n    51→        <input\n    52→          data-testid=\"search-checkin\"\n    53→          type=\"date\"\n    54→          value={checkIn}\n    55→          min={today}\n    56→          onChange={(e) => {\n    57→            setCheckIn(e.target.value)\n    58→            if (checkOut && e.target.value >= checkOut) {\n    59→              setCheckOut('')\n    60→            }\n    61→          }}\n    62→          className=\"rounded-full px-3 py-2 text-sm text-text outline-none bg-transparent\"\n    63→        />\n    64→      </div>\n    65→      <div className=\"border-l border-border pl-3\">\n    66→        <input\n    67→          data-testid=\"search-checkout\"\n    68→          type=\"date\"\n    69→          value={checkOut}\n    70→          min={checkIn || today}\n    71→          onChange={(e) => setCheckOut(e.target.value)}\n    72→          className=\"rounded-full px-3 py-2 text-sm text-text outline-none bg-transparent\"\n    73→        />\n    74→      </div>\n    75→      <div className=\"border-l border-border pl-3 flex items-center gap-2\">\n    76→        <input\n    77→          data-testid=\"search-guests\"\n    78→          type=\"number\"\n    79→          min={1}\n    80→          placeholder=\"Guests\"\n    81→          value={guests || ''}\n    82→          onChange={(e) => handleGuestsChange(e.target.value)}\n    83→          className=\"w-20 rounded-full px-3 py-2 text-sm text-text outline-none bg-transparent\"\n    84→        />\n    85→      </div>\n    86→      <button\n    87→        data-testid=\"search-button\"\n    88→        type=\"submit\"\n    89→        className=\"flex items-center justify-center rounded-full bg-primary p-3 text-white hover:bg-primary-dark transition-colors\"\n    90→      >\n    91→        <Search size={18} />\n    92→      </button>\n    93→    </form>\n    94→  )\n    95→}\n    96→"}]},"parent_tool_use_id":"toolu_01PRcctAp5FCZbp1RzMX8NKJ","session_id":"0eaeef5d-e35c-43d7-a0b9-dfed2a7c76ad","uuid":"e8d89c04-5b65-4ee0-a18f-200f34689fcc"}
