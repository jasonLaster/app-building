[2026-03-14T19:25:09.683Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AFJvkJd6feX2PsaSEcqeNg","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions'\n     2→import { getSql } from './db.js'\n     3→\n     4→export default async (request: Request, _context: Context) => {\n     5→  const sql = getSql()\n     6→  const url = new URL(request.url)\n     7→  const segments = url.pathname.split('/').filter(Boolean)\n     8→  const propertyId = segments[2] // /api/properties/:id\n     9→\n    10→  const headers = { 'Content-Type': 'application/json' }\n    11→\n    12→  if (request.method === 'GET' && propertyId) {\n    13→    const result = await sql`\n    14→      SELECT p.*,\n    15→        u.name as host_name, u.avatar_url as host_avatar, u.bio as host_bio, u.created_at as host_since,\n    16→        (SELECT count(*)::int FROM properties WHERE host_id = p.host_id AND is_active = true) as host_listing_count\n    17→      FROM properties p\n    18→      JOIN users u ON u.id = p.host_id\n    19→      WHERE p.id = ${propertyId}\n    20→    `\n    21→    const property = result[0]\n    22→    if (!property) {\n    23→      return new Response(JSON.stringify({ error: 'Property not found' }), { status: 404, headers })\n    24→    }\n    25→\n    26→    const images = await sql`\n    27→      SELECT * FROM property_images WHERE property_id = ${propertyId} ORDER BY display_order ASC\n    28→    `\n    29→\n    30→    const amenities = await sql`\n    31→      SELECT a.* FROM amenities a\n    32→      JOIN property_amenities pa ON pa.amenity_id = a.id\n    33→      WHERE pa.property_id = ${propertyId}\n    34→      ORDER BY a.category, a.name\n    35→    `\n    36→\n    37→    const reviews = await sql`\n    38→      SELECT r.*, u.name as guest_name, u.avatar_url as guest_avatar\n    39→      FROM reviews r\n    40→      JOIN users u ON u.id = r.guest_id\n    41→      WHERE r.property_id = ${propertyId}\n    42→      ORDER BY r.created_at DESC\n    43→    `\n    44→\n    45→    return new Response(JSON.stringify({ ...property, images, amenities, reviews }), { status: 200, headers })\n    46→  }\n    47→\n    48→  if (request.method === 'GET') {\n    49→    const city = url.searchParams.get('city') || ''\n    50→    const checkIn = url.searchParams.get('check_in') || ''\n    51→    const checkOut = url.searchParams.get('check_out') || ''\n    52→    const guestsStr = url.searchParams.get('guests') || '0'\n    53→    const propertyType = url.searchParams.get('property_type') || ''\n    54→    const minPriceStr = url.searchParams.get('min_price') || '0'\n    55→    const maxPriceStr = url.searchParams.get('max_price') || '0'\n    56→    const minBedroomsStr = url.searchParams.get('min_bedrooms') || '0'\n    57→    const minBedsStr = url.searchParams.get('min_beds') || '0'\n    58→    const minBathroomsStr = url.searchParams.get('min_bathrooms') || '0'\n    59→    const amenitiesParam = url.searchParams.get('amenities') || ''\n    60→    const page = parseInt(url.searchParams.get('page') || '1', 10)\n    61→    const limit = parseInt(url.searchParams.get('limit') || '12', 10)\n    62→    const offset = (page - 1) * limit\n    63→\n    64→    const guestsNum = parseInt(guestsStr, 10) || 0\n    65→    const minPrice = parseFloat(minPriceStr) || 0\n    66→    const maxPrice = parseFloat(maxPriceStr) || 0\n    67→    const minBedrooms = parseInt(minBedroomsStr, 10) || 0\n    68→    const minBeds = parseInt(minBedsStr, 10) || 0\n    69→    const minBathrooms = parseInt(minBathroomsStr, 10) || 0\n    70→    const amenityIds = amenitiesParam ? amenitiesParam.split(',').filter(Boolean) : []\n    71→    const amenityCount = amenityIds.length\n    72→    const hasDateFilter = checkIn !== '' && checkOut !== ''\n    73→    const hasAmenityFilter = amenityCount > 0\n    74→\n    75→    const countResult = await sql`\n    76→      SELECT count(*)::int as total\n    77→      FROM properties p\n    78→      WHERE p.is_active = true\n    79→        AND (${city} = '' OR LOWER(p.city) LIKE LOWER('%' || ${city} || '%'))\n    80→        AND (${guestsNum} = 0 OR p.max_guests >= ${guestsNum})"}]},"parent_tool_use_id":"toolu_01PRcctAp5FCZbp1RzMX8NKJ","session_id":"0eaeef5d-e35c-43d7-a0b9-dfed2a7c76ad","uuid":"c28e2efa-a237-46af-8518-68b093cd313e"}
