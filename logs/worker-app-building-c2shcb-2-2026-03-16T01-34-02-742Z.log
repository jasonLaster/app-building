ions` is true (no completions), a div with `data-testid=\"burndown-chart-empty\"` is rendered\n- The div displays the message: \"No issues completed yet\"\n- This empty state div is conditionally rendered and only appears when there are no burndown entries\n\nThe component still renders the chart container and axes below the empty state message, but the bars would all be at 0 since the `burndownMap` would have no entries."}],"totalDurationMs":3469,"totalTokens":18753,"totalToolUseCount":1,"usage":{"input_tokens":5,"cache_creation_input_tokens":1460,"cache_read_input_tokens":17074,"output_tokens":214,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":0,"ephemeral_5m_input_tokens":1460},"inference_geo":"","iterations":[],"speed":"standard"}}}
