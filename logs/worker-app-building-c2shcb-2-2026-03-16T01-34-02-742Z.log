    const idx = state.selectedIds.indexOf(id);\n   149→      if (idx >= 0) {\n   150→        state.selectedIds.splice(idx, 1);\n   151→      } else {\n   152→        state.selectedIds.push(id);\n   153→      }\n   154→    },\n   155→    selectCycleGroupIssues(state, action: { payload: string[] }) {\n   156→      const ids = action.payload;\n   157→      const allSelected = ids.every((id) => state.selectedIds.includes(id));\n   158→      if (allSelected) {\n   159→        state.selectedIds = state.selectedIds.filter((id) => !ids.includes(id));\n   160→      } else {\n   161→        const newIds = ids.filter((id) => !state.selectedIds.includes(id));\n   162→        state.selectedIds.push(...newIds);\n   163→      }\n   164→    },\n   165→    clearCycleSelection(state) {\n   166→      state.selectedIds = [];\n   167→    },\n   168→  },\n   169→  extraReducers: (builder) => {\n   170→    builder\n   171→      .addCase(fetchCycles.pending, (state) => {\n   172→        if (state.cycles.length === 0) {\n   173→          state.loading = true;\n   174→        }\n   175→        state.error = null;\n   176→      })\n   177→      .addCase(fetchCycles.fulfilled, (state, action) => {\n   178→        state.loading = false;\n   179→        state.cycles = action.payload.cycles;\n   180→      })\n   181→      .addCase(fetchCycles.rejected, (state, action) => {\n   182→        state.loading = false;\n   183→        state.error = action.payload as string;\n   184→      })\n   185→      .addCase(fetchCycleIssues.pending, (state) => {\n   186→        if (state.cycleIssues.length === 0) {\n   187→          state.detailLoading = true;\n   188→        }\n   189→        state.detailError = null;\n   190→      })\n   191→      .addCase(fetchCycleIssues.fulfilled, (state, action) => {\n   192→        state.detailLoading = false;\n   193→        state.cycleDetail = action.payload.cycle;\n   194→        state.cycleIssues = action.payload.issues;\n   195→        state.cycleMembers = action.payload.members;\n   196→        state.burndown = action.payload.burndown;\n   197→        state.selectedIds = [];\n   198→      })\n   199→      .addCase(fetchCycleIssues.rejected, (state, action) => {\n   200→        state.detailLoading = false;\n   201→        state.detailError = action.payload as string;\n   202→      })\n   203→      .addCase(createCycle.fulfilled, (state, action) => {\n   204→        state.cycles.push(action.payload);\n   205→        state.cycles.sort((a, b) => a.startDate.localeCompare(b.startDate));\n   206→      })\n   207→      .addCase(updateIssueStatus.fulfilled, (state, action) => {\n   208→        const { issueId, status } = action.payload;\n   209→        const issue = state.cycleIssues.find((i) => i.id === issueId);\n   210→        if (issue) {\n   211→          issue.status = status;\n   212→        }\n   213→      });\n   214→  },\n   215→});\n   216→\n   217→export const {\n   218→  setSelectedCycleId,\n   219→  setCycleGroupBy,\n   220→  setCycleSortBy,\n   221→  toggleCycleIssueSelection,\n   222→  selectCycleGroupIssues,\n   223→  clearCycleSelection,\n   224→} = cyclesSlice.actions;\n   225→\n   226→export default cyclesSlice.reducer;\n   227→"}]},"parent_tool_use_id":"toolu_01QjYo4WQuKNMthcouqzzzPV","session_id":"1880e500-2182-4a27-9a5d-5f74c5e8203c","uuid":"dabaafe8-aa14-46c0-8bf9-a32d8616648d"}
