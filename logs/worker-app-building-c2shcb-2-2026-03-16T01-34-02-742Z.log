r (e.g., Sprint 12 auto-selection) to prevent race conditions.\n    await page.route('**/api/cycle-issues**', async (route) => {\n      const url = new URL(route.request().url());\n      const cycleId = url.searchParams.get('cycleId');\n      if (cycleId === newCycle.id) {\n        await route.continue();\n      } else {\n        await route.abort();\n      }\n    });\n\n    await page.goto(`/team/${team.id}/cycles`);\n    await expect(page.getByTestId('active-cycle-page')).toBeVisible({ timeout: 30000 });\n    await expect(page.getByTestId('cycle-list')).toBeVisible({ timeout: 30000 });\n\n    // Click the Long Cycle\n    await page.getByTestId(`cycle-row-${newCycle.id}`).click({ force: true });\n\n    // Debug: log requests after click\n    await page.waitForTimeout(5000);\n    console.log('Cycle issues requests:', JSON.stringify(cycleIssuesRequests, null, 2));\n\n    // Wait for cycle detail to load\n    await expect(page.getByTestId('cycle-detail')).toBeVisible({ timeout: 30000 });\n    await expect(page.getByTestId('cycle-detail-name')).toContainText('Long Cycle', { timeout: 15000 });</tool_use_error>","is_error":true,"tool_use_id":"toolu_019XBA8VoCWZzgAFYNqSt3iH"}]},"parent_tool_use_id":null,"session_id":"1880e500-2182-4a27-9a5d-5f74c5e8203c","uuid":"4023a4e0-3dbd-4871-8c8d-9fd16df12b08","tool_use_result":"Error: String to replace not found in file.\nString:     // Debug: check cycle creation and API\n    console.log('Created cycle:', JSON.stringify(newCycle));\n\n    // First verify the cycle exists\n    const cycleCheckResponse = await fetch(`${baseURL}/api/cycles?teamId=${team.id}`, {\n      headers: { Authorization: `Bearer ${data.token}` },\n    });\n    const cycleCheckData = await cycleCheckResponse.json();\n    const found = cycleCheckData.cycles?.find((c: { id: string }) => c.id === newCycle.id);\n    console.log('Cycle found in list:', !!found, 'id:', newCycle.id);\n\n    // Now try to get cycle-issues\n    const directApiResponse = await fetch(`${baseURL}/api/cycle-issues?cycleId=${newCycle.id}`, {\n      headers: { Authorization: `Bearer ${data.token}` },\n    });\n    console.log('Direct API call status:', directApiResponse.status);\n    const body = await directApiResponse.text();\n    console.log('Direct API body:', body.substring(0, 500));\n\n    // Login and set token\n    await page.goto('/login');\n    await page.evaluate((t) => localStorage.setItem('session_token', t), data.token);\n\n    // Log all cycle-issues requests for debugging\n    const cycleIssuesRequests: string[] = [];\n    page.on('request', (req) => {\n      if (req.url().includes('/api/cycle-issues')) {\n        cycleIssuesRequests.push(`REQ: ${req.url()}`);\n      }\n    });\n    page.on('response', (res) => {\n      if (res.url().includes('/api/cycle-issues')) {\n        cycleIssuesRequests.push(`RES: ${res.url()} status=${res.status()}`);\n      }\n    });\n    page.on('requestfailed', (req) => {\n      if (req.url().includes('/api/cycle-issues')) {\n        cycleIssuesRequests.push(`FAIL: ${req.url()} err=${req.failure()?.errorText}`);\n      }\n    });\n\n    // Intercept cycle-issues requests: only allow the Long Cycle's request through,\n    // abort any other (e.g., Sprint 12 auto-selection) to prevent race conditions.\n    await page.route('**/api/cycle-issues**', async (route) => {\n      const url = new URL(route.request().url());\n      const cycleId = url.searchParams.get('cycleId');\n      if (cycleId === newCycle.id) {\n        await route.continue();\n      } else {\n        await route.abort();\n      }\n    });\n\n    await page.goto(`/team/${team.id}/cycles`);\n    await expect(page.getByTestId('active-cycle-page')).toBeVisible({ timeout: 30000 });\n    await expect(page.getByTestId('cycle-list')).toBeVisible({ timeout: 30000 });\n\n    // Click the Long Cycle\n    await page.getByTestId(`cycle-row-${newCycle.id}`).click({ force: true });\n\n    // Debug: log requests after click\n    await page.waitForTimeout(5000);\n    console.log('Cycle issues requests:', JSON.stringify(cycleIssuesRequests, null, 2));\n\n    // Wait for cycle detail to load\n    await expect(page.getByTestId('cycle-detail')).toBeVisible({ timeout: 30000 });\n    await expect(page.getByTestId('cycle-detail-name')).toContainText('Long Cycle', { timeout: 15000 });"}
