h = join(process.env.HOME || '/home/agent', '.deno', 'bin')\n    const netlifyDev = spawn('npx', ['netlify', 'dev', '--port', '8888', '--functions', './netlify/functions'], {\n      cwd: appDir,\n      env: { ...process.env, DATABASE_URL: ephemeralDbUrl, NETLIFY_SITE_ID: '', PATH: `${denoPath}:${process.env.PATH}` },\n      stdio: ['ignore', 'pipe', 'pipe'],\n      detached: true,\n    })\n\n    await new Promise<void>((resolve, reject) => {\n      const timeout = setTimeout(() => reject(new Error('netlify dev failed to start within 60s')), 60000)\n      let output = ''\n      let resolved = false\n      const check = (data: Buffer) => {\n        output += data.toString()\n        if (!resolved && (output.includes('Server ready') || output.includes('ready on') || output.includes('localhost:8888'))) {\n          resolved = true\n          // Wait a bit for functions to finish loading\n          setTimeout(() => { clearTimeout(timeout); resolve() }, 5000)\n        }\n      }\n      netlifyDev.stdout?.on('data', check)\n      netlifyDev.stderr?.on('data', check)\n      netlifyDev.on('error', (err) => { if (!resolved) { clearTimeout(timeout); reject(err) } })\n      netlifyDev.on('exit', (code) => {\n        if (!resolved && code !== null && code !== 0) { clearTimeout(timeout); reject(new Error(`netlify dev exited ${code}\\n${output}`)) }\n      })\n    })\n\n    try { execSync('npx replayio remove --all', { cwd: appDir, stdio: 'ignore' }) } catch { /* ignore */ }\n\n    await resetDatabase(ephemeralDbUrl)\n","numLines":60,"startLine":147,"totalLines":281}}}
