ator('[data-testid^=\"burndown-bar-\"]');\n    await expect(barColumns).toHaveCount(28, { timeout: 15000 });","new_string":"    // Navigate to cycles page and wait for auto-selection to fully complete\n    await page.goto('/login');\n    await page.evaluate((t) => localStorage.setItem('session_token', t), data.token);\n    await page.goto(`/team/${team.id}/cycles`);\n    await expect(page.getByTestId('active-cycle-page')).toBeVisible({ timeout: 30000 });\n\n    // Wait for cycle-detail to appear (auto-selection completes with Sprint 12)\n    // This ensures the auto-selected cycle's fetch has completed before we click the Long Cycle\n    await expect(page.getByTestId('cycle-detail')).toBeVisible({ timeout: 30000 });\n\n    // Now go back to the list and click the Long Cycle\n    // Since Sprint 12's fetch already completed, clicking Long Cycle will only trigger ONE fetch\n    await page.getByTestId('cycle-back-btn').click();\n    // Auto-selection may re-trigger, so we need to be quick or wait for the cycle list specifically\n    // Use waitForSelector with a short timeout, and if it auto-selects again, try once more\n    await expect(page.getByTestId(`cycle-row-${newCycle.id}`)).toBeVisible({ timeout: 15000 });\n    await page.getByTestId(`cycle-row-${newCycle.id}`).click({ timeout: 15000 });\n    await expect(page.getByTestId('cycle-detail')).toBeVisible({ timeout: 30000 });\n    await expect(page.getByTestId('cycle-detail-name')).toContainText('Long Cycle', { timeout: 15000 });\n\n    // Verify burndown chart renders\n    await expect(page.getByTestId('burndown-chart')).toBeVisible({ timeout: 15000 });\n    await expect(page.getByTestId('burndown-chart-container')).toBeVisible();\n\n    // Should have 28 bar columns for 28 days\n    const barColumns = page.locator('[data-testid^=\"burndown-bar-\"]');\n    await expect(barColumns).toHaveCount(28, { timeout: 15000 });"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"