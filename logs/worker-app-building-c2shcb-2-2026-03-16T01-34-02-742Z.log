: 40px;\n    74→}\n    75→\n    76→.burndown-chart-bar-track {\n    77→  width: 100%;\n    78→  height: 100px;\n    79→  display: flex;\n    80→  align-items: flex-end;\n    81→  justify-content: center;\n    82→}\n    83→\n    84→.burndown-chart-bar {\n    85→  width: 70%;\n    86→  min-width: 8px;\n    87→  max-width: 28px;\n    88→  background-color: var(--color-accent);\n    89→  border-radius: 3px 3px 0 0;\n    90→  transition: height 300ms ease;\n    91→  cursor: default;\n    92→}\n    93→\n    94→.burndown-chart-bar:hover {\n    95→  opacity: 0.85;\n    96→}\n    97→\n    98→.burndown-chart-x-label {\n    99→  font-size: 10px;\n   100→  color: var(--color-text-tertiary);\n   101→  white-space: nowrap;\n   102→  margin-top: 4px;\n   103→  text-align: center;\n   104→}\n   105→\n   106→.burndown-chart-x-label-hidden {\n   107→  visibility: hidden;\n   108→}\n   109→"}]},"parent_tool_use_id":null,"session_id":"1880e500-2182-4a27-9a5d-5f74c5e8203c","uuid":"1ec97009-7257-4b4b-8650-6453929a200c","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/src/components/BurndownChart.css","content":".burndown-chart {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.burndown-chart-title {\n  font-size: 14px;\n  font-weight: 600;\n  color: var(--color-text-primary);\n  margin: 0;\n}\n\n.burndown-chart-empty {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 24px;\n  color: var(--color-text-tertiary);\n  font-size: 13px;\n}\n\n.burndown-chart-empty p {\n  margin: 0;\n}\n\n.burndown-chart-container {\n  display: flex;\n  gap: 8px;\n  padding: 12px;\n  background-color: var(--color-bg-surface);\n  border: 1px solid var(--color-border);\n  border-radius: 8px;\n  min-height: 160px;\n}\n\n.burndown-chart-y-axis {\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  align-items: flex-end;\n  padding-bottom: 20px;\n  flex-shrink: 0;\n}\n\n.burndown-chart-y-label {\n  font-size: 11px;\n  color: var(--color-text-tertiary);\n  font-variant-numeric: tabular-nums;\n  line-height: 1;\n}\n\n.burndown-chart-bars-wrapper {\n  flex: 1;\n  min-width: 0;\n  overflow-x: auto;\n}\n\n.burndown-chart-bars {\n  display: flex;\n  align-items: flex-end;\n  gap: 2px;\n  height: 120px;\n  min-width: fit-content;\n}\n\n.burndown-chart-bar-column {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  flex: 1;\n  min-width: 16px;\n  max-width: 40px;\n}\n\n.burndown-chart-bar-track {\n  width: 100%;\n  height: 100px;\n  display: flex;\n  align-items: flex-end;\n  justify-content: center;\n}\n\n.burndown-chart-bar {\n  width: 70%;\n  min-width: 8px;\n  max-width: 28px;\n  background-color: var(--color-accent);\n  border-radius: 3px 3px 0 0;\n  transition: height 300ms ease;\n  cursor: default;\n}\n\n.burndown-chart-bar:hover {\n  opacity: 0.85;\n}\n\n.burndown-chart-x-label {\n  font-size: 10px;\n  color: var(--color-text-tertiary);\n  white-space: nowrap;\n  margin-top: 4px;\n  text-align: center;\n}\n\n.burndown-chart-x-label-hidden {\n  visibility: hidden;\n}\n","numLines":109,"startLine":1,"totalLines":109}}}
