 height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n   419→                <polyline points=\"3 6 9 6\" />\n   420→                <polyline points=\"3 12 15 12\" />\n   421→                <polyline points=\"3 18 21 18\" />\n   422→              </svg>\n   423→              Sort: {currentSortLabel}\n   424→            </button>\n   425→            {sortDropdownOpen && (\n   426→              <div className=\"cycle-detail-filter-dropdown\" data-testid=\"cycle-sort-by-dropdown\">\n   427→                {SORT_OPTIONS.map((opt) => (\n   428→                  <button\n   429→                    key={opt.value}\n   430→                    className={`cycle-detail-dropdown-option ${sortBy === opt.value ? 'cycle-detail-dropdown-option-active' : ''}`}\n   431→                    onClick={() => {\n   432→                      dispatch(setCycleSortBy(opt.value));\n   433→                      setSortDropdownOpen(false);\n   434→                    }}\n   435→                    data-testid={`cycle-sort-by-option-${opt.value}`}\n   436→                  >\n   437→                    {opt.label}\n   438→                  </button>\n   439→                ))}\n   440→              </div>\n   441→            )}\n   442→          </div>\n   443→        </div>\n   444→      </div>\n   445→\n   446→      {selectedIds.length > 0 && (\n   447→        <div className=\"cycle-detail-bulk-bar\" data-testid=\"cycle-bulk-actions\">\n   448→          <span className=\"cycle-detail-bulk-count\">{selectedIds.length} selected</span>\n   449→          <div className=\"cycle-detail-bulk-actions\" ref={bulkRef}>\n   450→            <button\n   451→              className=\"cycle-detail-bulk-btn\"\n   452→              onClick={() => setBulkStatusOpen(!bulkStatusOpen)}\n   453→              data-testid=\"cycle-bulk-status-btn\"\n   454→            >\n   455→              Set Status\n   456→            </button>\n   457→            {bulkStatusOpen && (\n   458→              <div className=\"cycle-detail-filter-dropdown\" data-testid=\"cycle-bulk-status-dropdown\">\n   459→                {ALL_STATUSES.map((status) => (\n   460→                  <button\n   461→                    key={status}\n   462→                    className=\"cycle-detail-dropdown-option\"\n   463→                    onClick={() => handleBulkStatusChange(status)}\n   464→                    data-testid={`cycle-bulk-status-${status}`}\n   465→                  >\n   466→                    {STATUS_LABELS[status]}\n   467→                  </button>\n   468→                ))}\n   469→              </div>\n   470→            )}\n   471→          </div>\n   472→          <button\n   473→            className=\"cycle-detail-bulk-btn cycle-detail-bulk-clear\"\n   474→            onClick={() => dispatch(clearCycleSelection())}\n   475→            data-testid=\"cycle-bulk-clear\"\n   476→          >\n   477→            Clear\n   478→          </button>\n   479→        </div>\n   480→      )}\n   481→\n   482→      <div className=\"cycle-detail-issues\" data-testid=\"cycle-detail-issues\">\n   483→        {filteredIssues.length === 0 ? (\n   484→          <div className=\"cycle-detail-no-issues\" data-testid=\"cycle-detail-no-issues\">\n   485→            <p>No issues in this cycle</p>\n   486→          </div>\n   487→        ) : groupBy === 'none' ? (\n   488→          groups[0]?.issues.map((issue) => (\n   489→            <IssueRow\n   490→              key={issue.id}\n   491→              issue={issue}\n   492→              showCheckbox\n   493→              checked={selectedIds.includes(issue.id)}\n   494→              onCheckChange={handleCheckChange}\n   495→            />\n   496→          ))\n   497→        ) : (\n   498→          groups.map((group) => {\n   499→            const isCollapsed = !!collapsedGroups[group.key];\n   500→            const groupIssueIds = group.issues.map((i) => i.id);\n   501→            const allSelected = groupIssueIds.length > 0 && groupIssueIds.every((id) => selectedIds.includes(id));\n   502→\n   503→            return (\n   504→              <div key={group.key} className=\"cycle-detail-group\" data-testid={`cycle-issue-group-${group.key}`}>\n   505→                <div className=\"cycle-detail-group-header\" data-testid={`cycle-issue-group-header-${group.key}`}>\n   506→                  <label className=\"cycle-detail-group-select\" onClick={(e) => e.stopPropagation()}>\n   507→                    <input\n   508→                      type=\"checkbox\"\n   509→                      className=\"cycle-detail-group-checkbox\"\n   510→                      checked={allSelected}\n   511→                      onChange={() => handleGroupSelect(groupIssueIds)}\n   512→                    />\n   513→                  </label>\n   514→                  <button\n   515→                    className=\"cycle-detail-group-toggle\"\n   516→                    onClick={() => toggleGroup(group.key)}\n   517→                  >\n   518→                    <svg\n   519→                      className={`cycle-detail-group-chevron ${isCollapsed ? '' : 'cycle-detail-group-chevron-expanded'}`}\n   520→                      width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\"\n   521→                    >\n   522→                      <polyline points=\"9 18 15 12 9 6\" />\n   523→                    </svg>\n   524→                    {group.icon}\n   525→                    <span className=\"cycle-detail-group-label\">{group.label}</span>\n   526→                    <span className=\"cycle-detail-group-count\">({group.issues.length})</span>\n   527→                  </button>\n   528→                </div>\n   529→                {!isCollapsed && (\n   530→                  <div className=\"cycle-detail-group-items\" data-testid={`cycle-issue-group-items-${group.key}`}>\n   531→                    {group.issues.map((issue) => (\n   532→                      <IssueRow\n   533→                        key={issue.id}\n   534→                        issue={issue}\n   535→                        showCheckbox\n   536→                        checked={selectedIds.includes(issue.id)}\n   537→                        onCheckChange={handleCheckChange}\n   538→                      />\n   539→                    ))}\n   540→                  </div>\n   541→                )}\n   542→              </div>\n   543→            );\n   544→          })\n   545→        )}\n   546→      </div>\n   547→    </div>\n   548→  );\n   549→}\n   550→"}]},"parent_tool_use_id":"toolu_01QjYo4WQuKNMthcouqzzzPV","session_id":"1880e500-2182-4a27-9a5d-5f74c5e8203c","uuid":"4165215d-69b6-4eab-9e2d-a6d36ff449c9"}
