cles c\n    49→      WHERE c.id = ${cycleId}\n    50→    `;\n    51→    const cycle = cycleRows[0];\n    52→    if (!cycle) {\n    53→      return new Response(JSON.stringify({ error: 'Cycle not found' }), {\n    54→        status: 404,\n    55→        headers: { 'Content-Type': 'application/json' },\n    56→      });\n    57→    }\n    58→\n    59→    // Fetch issues in this cycle\n    60→    const issues = await sql`\n    61→      SELECT\n    62→        i.id,\n    63→        i.title,\n    64→        i.description,\n    65→        i.status,\n    66→        i.priority,\n    67→        i.number,\n    68→        i.due_date,\n    69→        i.created_at,\n    70→        i.updated_at,\n    71→        i.team_id,\n    72→        i.assignee_id,\n    73→        i.project_id,\n    74→        i.cycle_id,\n    75→        i.parent_id,\n    76→        t.identifier AS team_identifier,\n    77→        t.name AS team_name,\n    78→        p.name AS project_name,\n    79→        m.name AS assignee_name,\n    80→        m.email AS assignee_email\n    81→      FROM issues i\n    82→      JOIN teams t ON t.id = i.team_id\n    83→      LEFT JOIN projects p ON p.id = i.project_id\n    84→      LEFT JOIN members m ON m.id = i.assignee_id\n    85→      WHERE i.cycle_id = ${cycleId}\n    86→      ORDER BY i.created_at DESC\n    87→    `;\n    88→\n    89→    const issueIds = issues.map((i) => i.id);\n    90→\n    91→    let issueLabels: Array<{ issue_id: string; label_id: string; label_name: string; label_color: string }> = [];\n    92→    if (issueIds.length > 0) {\n    93→      issueLabels = await sql`\n    94→        SELECT il.issue_id, l.id AS label_id, l.name AS label_name, l.color AS label_color\n    95→        FROM issue_labels il\n    96→        JOIN labels l ON l.id = il.label_id\n    97→        WHERE il.issue_id = ANY(${issueIds})\n    98→      `;\n    99→    }\n   100→\n   101→    const labelsByIssue: Record<string, Array<{ id: string; name: string; color: string }>> = {};\n   102→    for (const il of issueLabels) {\n   103→      if (!labelsByIssue[il.issue_id]) {\n   104→        labelsByIssue[il.issue_id] = [];\n   105→      }\n   106→      labelsByIssue[il.issue_id].push({\n   107→        id: il.label_id,\n   108→        name: il.label_name,\n   109→        color: il.label_color,\n   110→      });\n   111→    }\n   112→\n   113→    const enrichedIssues = issues.map((issue) => ({\n   114→      id: issue.id,\n   115→      title: issue.title,\n   116→      description: issue.description,\n   117→      status: issue.status,\n   118→      priority: issue.priority,\n   119→      identifier: `${issue.team_identifier}-${issue.number}`,\n   120→      number: issue.number,\n   121→      dueDate: issue.due_date ? (issue.due_date instanceof Date ? issue.due_date.toISOString().split('T')[0] : String(issue.due_date).split('T')[0]) : null,\n   122→      createdAt: issue.created_at,\n   123→      updatedAt: issue.updated_at,\n   124→      teamId: issue.team_id,\n   125→      teamName: issue.team_name,\n   126→      assigneeId: issue.assignee_id,\n   127→      assigneeName: issue.assignee_name,\n   128→      assigneeEmail: issue.assignee_email,\n   129→      projectId: issue.project_id,\n   130→      projectName: issue.project_name,\n   131→      cycleId: issue.cycle_id,\n   132→      cycleName: cycle.name,\n   133→      parentId: issue.parent_id,\n   134→      labels: labelsByIssue[issue.id] || [],\n   135→    }));\n   136→\n   137→    const cycleStartDate = cycle.start_date instanceof Date ? cycle.start_date.toISOString().split('T')[0] : String(cycle.start_date).split('T')[0];\n   138→    const cycleEndDate = cycle.end_date instanceof Date ? cycle.end_date.toISOString().split('T')[0] : String(cycle.end_date).split('T')[0];\n   139→\n   140→    // Fetch burndown data: activity entries where status changed to 'done' for issues in this cycle\n   141→    const burndownData = await sql`\n   142→      SELECT DATE(a.created_at) AS completion_date, COUNT(*)::int AS count\n   143→      FROM activity a\n   144→      WHERE a.issue_id = ANY(${issueIds.length > 0 ? issueIds : ['__none__']})\n   145→        AND a.field = 'status'\n   146→        AND a.new_value = 'done'\n   147→        AND DATE(a.created_at) >= ${cycleStartDate}\n   148→        AND DATE(a.created_at) <= ${cycleEndDate}\n   149→      GROUP BY DATE(a.created_at)\n   150→      ORDER BY DATE(a.created_at) ASC\n   151→    `;\n   152→\n   153→    // Fetch team members for filters\n   154→    const members = await sql`\n   155→      SELECT m.id, m.name, m.email\n   156→      FROM members m\n   157→      JOIN team_members tm ON tm.member_id = m.id\n   158→      WHERE tm.team_id = ${cycle.team_id}\n   159→      ORDER BY m.name ASC\n   160→    `;\n   161→\n   162→    return new Response(JSON.stringify({\n   163→      cycle: {\n   164→        id: cycle.id,\n   165→        name: cycle.name,\n   166→        startDate: cycleStartDate,\n   167→        endDate: cycleEndDate,\n   168→        teamId: cycle.team_id,\n   169→      },\n   170→      issues: enrichedIssues,\n   171→      members,\n   172→      burndown: burndownData.map((d) => ({\n   173→        date: d.completion_date instanceof Date ? d.completion_date.toISOString().split('T')[0] : String(d.completion_date).split('T')[0],\n   174→        count: d.count,\n   175→      })),\n   176→    }), {\n   177→      status: 200,\n   178→      headers: { 'Content-Type': 'application/json' },\n   179→    });\n   180→  } catch (err) {\n   181→    console.error('Cycle issues error:', err);\n   182→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n   183→      status: 500,\n   184→      headers: { 'Content-Type': 'application/json' },\n   185→    });\n   186→  }\n   187→}\n   188→"}]},"parent_tool_use_id":null,"session_id":"1880e500-2182-4a27-9a5d-5f74c5e8203c","uuid":"47c36631-ddf5-474e-966a-947e494135dc","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/netlify/functions/cycle-issues.ts","content":"import type { Context } from '@netlify/functions';\nimport { getSql } from './db';\n\nexport default async function handler(req: Request, _context: Context) {\n  if (req.method !== 'GET') {\n    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n      status: 405,\n      headers: { 'Content-Type': 'application/json' },\n    });\n  }\n\n  try {\n    const authHeader = req.headers.get('Authorization');\n    if (!authHeader?.startsWith('Bearer ')) {\n      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n        status: 401,\n        headers: { 'Content-Type': 'application/json' },\n      });\n    }\n\n    const token = authHeader.slice(7);\n    const sql = getSql();\n\n    const sessions = await sql`\n      SELECT s.member_id FROM sessions s\n      WHERE s.token = ${token} AND s.expires_at > NOW()\n    `;\n    const session = sessions[0];\n    if (!session) {\n      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n        status: 401,\n        headers: { 'Content-Type': 'application/json' },\n      });\n    }\n\n    const url = new URL(req.url);\n    const cycleId = url.searchParams.get('cycleId');\n    if (!cycleId) {\n      return new Response(JSON.stringify({ error: 'cycleId is required' }), {\n        status: 400,\n        headers: { 'Content-Type': 'application/json' },\n      });\n    }\n\n    // Fetch cycle info\n    const cycleRows = await sql`\n      SELECT c.id, c.name, c.start_date, c.end_date, c.team_id\n      FROM cycles c\n      WHERE c.id = ${cycleId}\n    `;\n    const cycle = cycleRows[0];\n    if (!cycle) {\n      return new Response(JSON.stringify({ error: 'Cycle not found' }), {\n        status: 404,\n        headers: { 'Content-Type': 'application/json' },\n      });\n    }\n\n    // Fetch issues in this cycle\n    const issues = await sql`\n      SELECT\n        i.id,\n        i.title,\n        i.description,\n        i.status,\n        i.priority,\n        i.number,\n        i.due_date,\n        i.created_at,\n        i.updated_at,\n        i.team_id,\n        i.assignee_id,\n        i.project_id,\n        i.cycle_id,\n        i.parent_id,\n        t.identifier AS team_identifier,\n        t.name AS team_name,\n        p.name AS project_name,\n        m.name AS assignee_name,\n        m.email AS assignee_email\n      FROM issues i\n      JOIN teams t ON t.id = i.team_id\n      LEFT JOIN projects p ON p.id = i.project_id\n      LEFT JOIN members m ON m.id = i.assignee_id\n      WHERE i.cycle_id = ${cycleId}\n      ORDER BY i.created_at DESC\n    `;\n\n    const issueIds = issues.map((i) => i.id);\n\n    let issueLabels: Array<{ issue_id: string; label_id: string; label_name: string; label_color: string }> = [];\n    if (issueIds.length > 0) {\n      issueLabels = await sql`\n        SELECT il.issue_id, l.id AS label_id, l.name AS label_name, l.color AS label_color\n        FROM issue_labels il\n        JOIN labels l ON l.id = il.label_id\n        WHERE il.issue_id = ANY(${issueIds})\n      `;\n    }\n\n    const labelsByIssue: Record<string, Array<{ id: string; name: string; color: string }>> = {};\n    for (const il of issueLabels) {\n      if (!labelsByIssue[il.issue_id]) {\n        labelsByIssue[il.issue_id] = [];\n      }\n      labelsByIssue[il.issue_id].push({\n        id: il.label_id,\n        name: il.label_name,\n        color: il.label_color,\n      });\n    }\n\n    const enrichedIssues = issues.map((issue) => ({\n      id: issue.id,\n      title: issue.title,\n      description: issue.description,\n      status: issue.status,\n      priority: issue.priority,\n      identifier: `${issue.team_identifier}-${issue.number}`,\n      number: issue.number,\n      dueDate: issue.due_date ? (issue.due_date instanceof Date ? issue.due_date.toISOString().split('T')[0] : String(issue.due_date).split('T')[0]) : null,\n      createdAt: issue.created_at,\n      updatedAt: issue.updated_at,\n      teamId: issue.team_id,\n      teamName: issue.team_name,\n      assigneeId: issue.assignee_id,\n      assigneeName: issue.assignee_name,\n      assigneeEmail: issue.assignee_email,\n      projectId: issue.project_id,\n      projectName: issue.project_name,\n      cycleId: issue.cycle_id,\n      cycleName: cycle.name,\n      parentId: issue.parent_id,\n      labels: labelsByIssue[issue.id] || [],\n    }));\n\n    const cycleStartDate = cycle.start_date instanceof Date ? cycle.start_date.toISOString().split('T')[0] : String(cycle.start_date).split('T')[0];\n    const cycleEndDate = cycle.end_date instanceof Date ? cycle.end_date.toISOString().split('T')[0] : String(cycle.end_date).split('T')[0];\n\n    // Fetch burndown data: activity entries where status changed to 'done' for issues in this cycle\n    const burndownData = await sql`\n      SELECT DATE(a.created_at) AS completion_date, COUNT(*)::int AS count\n      FROM activity a\n      WHERE a.issue_id = ANY(${issueIds.length > 0 ? issueIds : ['__none__']})\n        AND a.field = 'status'\n        AND a.new_value = 'done'\n        AND DATE(a.created_at) >= ${cycleStartDate}\n        AND DATE(a.created_at) <= ${cycleEndDate}\n      GROUP BY DATE(a.created_at)\n      ORDER BY DATE(a.created_at) ASC\n    `;\n\n    // Fetch team members for filters\n    const members = await sql`\n      SELECT m.id, m.name, m.email\n      FROM members m\n      JOIN team_members tm ON tm.member_id = m.id\n      WHERE tm.team_id = ${cycle.team_id}\n      ORDER BY m.name ASC\n    `;\n\n    return new Response(JSON.stringify({\n      cycle: {\n        id: cycle.id,\n        name: cycle.name,\n        startDate: cycleStartDate,\n        endDate: cycleEndDate,\n        teamId: cycle.team_id,\n      },\n      issues: enrichedIssues,\n      members,\n      burndown: burndownData.map((d) => ({\n        date: d.completion_date instanceof Date ? d.completion_date.toISOString().split('T')[0] : String(d.completion_date).split('T')[0],\n        count: d.count,\n      })),\n    }), {\n      status: 200,\n      headers: { 'Content-Type': 'application/json' },\n    });\n  } catch (err) {\n    console.error('Cycle issues error:', err);\n    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n      status: 500,\n      headers: { 'Content-Type': 'application/json' },\n    });\n  }\n}\n","numLines":188,"startLine":1,"totalLines":188}}}
