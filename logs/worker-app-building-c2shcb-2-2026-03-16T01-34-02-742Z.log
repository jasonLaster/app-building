[2026-03-15T23:24:37.973Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VGgMTLUzdVeWuXYYJMQ8aQ","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test';\n     2→\n     3→// Helper to login via API and get token\n     4→async function loginViaApi(baseURL: string, email: string, password: string) {\n     5→  const response = await fetch(`${baseURL}/api/login`, {\n     6→    method: 'POST',\n     7→    headers: { 'Content-Type': 'application/json' },\n     8→    body: JSON.stringify({ email, password }),\n     9→  });\n    10→  return response.json();\n    11→}\n    12→\n    13→// Helper to get teams via API\n    14→async function getTeams(baseURL: string, token: string) {\n    15→  const response = await fetch(`${baseURL}/api/teams`, {\n    16→    headers: { Authorization: `Bearer ${token}` },\n    17→  });\n    18→  const data = await response.json();\n    19→  return data.teams;\n    20→}\n    21→\n    22→// Helper to get cycles via API\n    23→async function getCycles(baseURL: string, token: string, teamId: string) {\n    24→  const response = await fetch(`${baseURL}/api/cycles?teamId=${teamId}`, {\n    25→    headers: { Authorization: `Bearer ${token}` },\n    26→  });\n    27→  const data = await response.json();\n    28→  return data.cycles;\n    29→}\n    30→\n    31→// Helper to get cycle issues via API\n    32→async function getCycleIssues(baseURL: string, token: string, cycleId: string) {\n    33→  const response = await fetch(`${baseURL}/api/cycle-issues?cycleId=${cycleId}`, {\n    34→    headers: { Authorization: `Bearer ${token}` },\n    35→  });\n    36→  return response.json();\n    37→}\n    38→\n    39→// Helper to login and navigate to cycle detail view\n    40→async function loginAndGoToCycleDetail(\n    41→  page: import('@playwright/test').Page,\n    42→  baseURL: string,\n    43→  teamIdentifier = 'ENG',\n    44→  email = 'alice@acme.com',\n    45→  password = 'password123'\n    46→) {\n    47→  const data = await loginViaApi(baseURL, email, password);\n    48→  const teams = await getTeams(baseURL, data.token);\n    49→  const team = teams.find((t: { identifier: string }) => t.identifier === teamIdentifier);\n    50→\n    51→  // Get cycles and pick the first one\n    52→  const cycles = await getCycles(baseURL, data.token, team.id);\n    53→  const cycle = cycles[0];\n    54→\n    55→  await page.goto('/login');\n    56→  await page.evaluate((t) => localStorage.setItem('session_token', t), data.token);\n    57→  await page.goto(`/team/${team.id}/cycles`);\n    58→  await expect(page.getByTestId('active-cycle-page')).toBeVisible({ timeout: 30000 });\n    59→\n    60→  // Wait for cycle list and click the cycle\n    61→  await expect(page.getByTestId('cycle-list')).toBeVisible({ timeout: 30000 });\n    62→  await page.getByTestId(`cycle-row-${cycle.id}`).click();\n    63→  await expect(page.getByTestId('cycle-detail')).toBeVisible({ timeout: 30000 });\n    64→\n    65→  return { token: data.token, user: data.user, team, teams, cycle, cycles };\n    66→}\n    67→\n    68→test.describe('CycleDetail', () => {\n    69→  test('Cycle detail view renders cycle name and date range', async ({ page, baseURL }) => {\n    70→    const { cycle } = await loginAndGoToCycleDetail(page, baseURL!);\n    71→\n    72→    // Verify cycle name\n    73→    await expect(page.getByTestId('cycle-detail-name')).toContainText(cycle.name);\n    74→\n    75→    // Verify date range is displayed\n    76→    await expect(page.getByTestId('cycle-detail-dates')).toBeVisible();\n    77→    // The date range should contain formatted dates\n    78→    const datesText = await page.getByTestId('cycle-detail-dates').textContent();\n    79→    expect(datesText).toBeTruthy();\n    80→    expect(datesText!.length).toBeGreaterThan(0);\n    81→  });\n    82→\n    83→  test('Cycle detail shows progress stats (total, completed, in progress, remaining)', async ({ page, baseURL }) => {\n    84→    const { token, cycle } = await loginAndGoToCycleDetail(page, baseURL!);\n    85→\n    86→    // Get cycle issues from API to compute expected stats\n    87→    const cycleData = await getCycleIssues(baseURL!, token, cycle.id);\n    88→    const issues = cycleData.issues;\n    89→    const totalIssues = issues.length;\n    90→    const completedIssues = issues.filter((i: { status: string }) => i.status === 'done').length;\n    91→    const inProgressIssues = issues.filter((i: { status: string }) => i.status === 'in_progress' || i.status === 'in_review').length;\n    92→    const remainingIssues = totalIssues - completedIssues - inProgressIssues;\n    93→\n    94→    // Verify stats\n    95→    await expect(page.getByTestId('cycle-detail-stats')).toBeVisible({ timeout: 10000 });\n    96→\n    97→    const totalStat = page.getByTestId('cycle-stat-total');\n    98→    await expect(totalStat).toContainText(String(totalIssues));\n    99→\n   100→    const completedStat = page.getByTestId('cycle-stat-completed');"}]},"parent_tool_use_id":"toolu_01QjYo4WQuKNMthcouqzzzPV","session_id":"1880e500-2182-4a27-9a5d-5f74c5e8203c","uuid":"3ad0cc79-cb8c-4ca8-8874-53e8fb608a01"}
