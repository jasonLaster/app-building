   98→  await expect(page.getByTestId('cycle-detail')).toBeVisible({ timeout: 30000 });\n    99→\n   100→  return { token: data.token, user: data.user, team, teams, cycle, cycles };\n   101→}\n   102→\n   103→test.describe('BurndownChart', () => {\n   104→  test('Burndown chart renders as a bar chart showing issues completed per day', async ({ page, baseURL }) => {\n   105→    const { token, cycle } = await loginAndGoToCycleDetail(page, baseURL!);\n   106→\n   107→    // Verify burndown chart is visible\n   108→    await expect(page.getByTestId('burndown-chart')).toBeVisible({ timeout: 15000 });\n   109→"}]},"parent_tool_use_id":null,"session_id":"1880e500-2182-4a27-9a5d-5f74c5e8203c","uuid":"0d5a8e77-ec7d-480c-a444-0ce5f90de385","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/tests/burndown-chart.spec.ts","content":"    },\n    body: JSON.stringify({ teamId, name, startDate, endDate }),\n  });\n  return response.json();\n}\n\n// Helper to login and navigate to cycle detail view\nasync function loginAndGoToCycleDetail(\n  page: import('@playwright/test').Page,\n  baseURL: string,\n  cycleId?: string,\n  teamIdentifier = 'ENG',\n  email = 'alice@acme.com',\n  password = 'password123'\n) {\n  const data = await loginViaApi(baseURL, email, password);\n  const teams = await getTeams(baseURL, data.token);\n  const team = teams.find((t: { identifier: string }) => t.identifier === teamIdentifier);\n\n  const cycles = await getCycles(baseURL, data.token, team.id);\n  const cycle = cycleId\n    ? cycles.find((c: { id: string }) => c.id === cycleId)\n    : cycles[0];\n\n  await page.goto('/login');\n  await page.evaluate((t) => localStorage.setItem('session_token', t), data.token);\n  await page.goto(`/team/${team.id}/cycles`);\n  await expect(page.getByTestId('active-cycle-page')).toBeVisible({ timeout: 30000 });\n\n  // Wait for cycle list to be visible, then wait for it to be stable before clicking\n  await expect(page.getByTestId('cycle-list')).toBeVisible({ timeout: 30000 });\n  // Wait briefly for any pending re-renders (auto-selection may cause list to re-render)\n  await page.waitForTimeout(500);\n  // If auto-selection already showed CycleDetail, just proceed\n  const listStillVisible = await page.getByTestId('cycle-list').isVisible().catch(() => false);\n  if (listStillVisible) {\n    await page.getByTestId(`cycle-row-${cycle.id}`).click({ force: true });\n  }\n  await expect(page.getByTestId('cycle-detail')).toBeVisible({ timeout: 30000 });\n\n  return { token: data.token, user: data.user, team, teams, cycle, cycles };\n}\n\ntest.describe('BurndownChart', () => {\n  test('Burndown chart renders as a bar chart showing issues completed per day', async ({ page, baseURL }) => {\n    const { token, cycle } = await loginAndGoToCycleDetail(page, baseURL!);\n\n    // Verify burndown chart is visible\n    await expect(page.getByTestId('burndown-chart')).toBeVisible({ timeout: 15000 });\n","numLines":50,"startLine":60,"totalLines":367}}}
