n    63→  cycleMembers: [],\n    64→  burndown: [],\n    65→  detailLoading: false,\n    66→  detailError: null,\n    67→  groupBy: 'status',\n    68→  sortBy: 'priority',\n    69→  selectedIds: [],\n    70→};\n    71→\n    72→export const fetchCycles = createAsyncThunk(\n    73→  'cycles/fetchCycles',\n    74→  async (teamId: string, { getState, rejectWithValue }) => {\n    75→    const state = getState() as { auth: { token: string | null } };\n    76→    const token = state.auth.token;\n    77→    if (!token) return rejectWithValue('No token');\n    78→    const response = await fetch(`/api/cycles?teamId=${teamId}`, {\n    79→      headers: { Authorization: `Bearer ${token}` },\n    80→    });\n    81→    if (!response.ok) {\n    82→      return rejectWithValue('Failed to fetch cycles');\n    83→    }\n    84→    return await response.json() as { cycles: CycleSummary[] };\n    85→  }\n    86→);\n    87→\n    88→export const fetchCycleIssues = createAsyncThunk(\n    89→  'cycles/fetchCycleIssues',\n    90→  async (cycleId: string, { getState, rejectWithValue }) => {\n    91→    const state = getState() as { auth: { token: string | null } };\n    92→    const token = state.auth.token;\n    93→    if (!token) return rejectWithValue('No token');\n    94→    const response = await fetch(`/api/cycle-issues?cycleId=${cycleId}`, {\n    95→      headers: { Authorization: `Bearer ${token}` },\n    96→    });\n    97→    if (!response.ok) {\n    98→      return rejectWithValue('Failed to fetch cycle issues');\n    99→    }\n   100→    return await response.json() as {"}]},"parent_tool_use_id":"toolu_01QjYo4WQuKNMthcouqzzzPV","session_id":"1880e500-2182-4a27-9a5d-5f74c5e8203c","uuid":"823b1815-7c4a-4a32-a17e-63628f8c11cb"}
