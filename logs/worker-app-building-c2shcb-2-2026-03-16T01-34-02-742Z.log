stead (because `selectedCycleId && cycleDetail` is false). This means the `cycle-detail` testID never appears until `cycleDetail` is populated. The fetch should populate it, but maybe the fetch fails for the new cycle.\n\nLet me check the error context for the empty state test:"}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1332,"cache_read_input_tokens":164387,"cache_creation":{"ephemeral_5m_input_tokens":1332,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard","inference_geo":"global"},"context_management":null},"parent_tool_use_id":null,"session_id":"1880e500-2182-4a27-9a5d-5f74c5e8203c","uuid":"936de2b5-3e4e-40d2-be58-4a5052c385d9"}
