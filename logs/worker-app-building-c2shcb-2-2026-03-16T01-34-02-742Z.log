[2026-03-15T23:25:42.394Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GsdQHquSVynYFFAqKTfRKQ","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions';\n     2→import { getSql } from './db';\n     3→import crypto from 'crypto';\n     4→\n     5→function hashPassword(password: string, salt: string): string {\n     6→  return crypto.pbkdf2Sync(password, salt, 10000, 64, 'sha512').toString('hex');\n     7→}\n     8→\n     9→function generateToken(): string {\n    10→  return crypto.randomBytes(48).toString('hex');\n    11→}\n    12→\n    13→export default async function handler(req: Request, _context: Context) {\n    14→  if (req.method !== 'POST') {\n    15→    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n    16→      status: 405,\n    17→      headers: { 'Content-Type': 'application/json' },\n    18→    });\n    19→  }\n    20→\n    21→  try {\n    22→    const { name, email, password } = await req.json();\n    23→\n    24→    if (!name || !email || !password) {\n    25→      return new Response(JSON.stringify({ error: 'Name, email, and password are required' }), {\n    26→        status: 400,\n    27→        headers: { 'Content-Type': 'application/json' },\n    28→      });\n    29→    }\n    30→\n    31→    if (password.length < 8) {\n    32→      return new Response(JSON.stringify({ error: 'Password must be at least 8 characters' }), {\n    33→        status: 400,\n    34→        headers: { 'Content-Type': 'application/json' },\n    35→      });\n    36→    }\n    37→\n    38→    const sql = getSql();\n    39→\n    40→    const existing = await sql`SELECT id FROM members WHERE email = ${email}`;\n    41→    if (existing.length > 0) {\n    42→      return new Response(JSON.stringify({ error: 'An account with this email already exists' }), {\n    43→        status: 409,\n    44→        headers: { 'Content-Type': 'application/json' },\n    45→      });\n    46→    }\n    47→\n    48→    const salt = crypto.randomBytes(16).toString('hex');\n    49→    const passwordHash = hashPassword(password, salt);\n    50→    const memberId = crypto.randomUUID();\n    51→\n    52→    // Create the member\n    53→    await sql`\n    54→      INSERT INTO members (id, name, email, password_hash, password_salt, role)\n    55→      VALUES (${memberId}, ${name}, ${email}, ${passwordHash}, ${salt}, 'admin')\n    56→    `;\n    57→\n    58→    // Create a default workspace if none exists\n    59→    const workspaces = await sql`SELECT id FROM workspaces LIMIT 1`;\n    60→    if (workspaces.length === 0) {\n    61→      const workspaceId = crypto.randomUUID();\n    62→      await sql`INSERT INTO workspaces (id, name) VALUES (${workspaceId}, ${name + \"'s Workspace\"})`;\n    63→    }\n    64→\n    65→    // Create session\n    66→    const token = generateToken();\n    67→    const expiresAt = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString();\n    68→    await sql`INSERT INTO sessions (token, member_id, expires_at) VALUES (${token}, ${memberId}, ${expiresAt})`;\n    69→\n    70→    return new Response(JSON.stringify({\n    71→      user: { id: memberId, name, email },\n    72→      token,\n    73→    }), {\n    74→      status: 201,\n    75→      headers: { 'Content-Type': 'application/json' },\n    76→    });\n    77→  } catch (err) {\n    78→    console.error('Signup error:', err);\n    79→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n    80→      status: 500,\n    81→      headers: { 'Content-Type': 'application/json' },\n    82→    });\n    83→  }\n    84→}\n    85→"}]},"parent_tool_use_id":"toolu_01Ti3mmwVKwX6yN58sbZXJho","session_id":"1880e500-2182-4a27-9a5d-5f74c5e8203c","uuid":"6ebab280-99c7-4ce3-81fe-c0f094a430de"}
