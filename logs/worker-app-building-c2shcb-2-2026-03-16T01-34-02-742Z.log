[2026-03-16T00:22:06.288Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013sS4iTiomEcUVinBiBki2B","type":"tool_result","content":"     1→import http from 'http'\n     2→import { spawn, type ChildProcess } from 'child_process'\n     3→import { join, basename } from 'path'\n     4→import { readdirSync } from 'fs'\n     5→\n     6→const appDir = join(import.meta.dirname, '..')\n     7→const functionsDir = join(appDir, 'netlify', 'functions')\n     8→const PORT = parseInt(process.env.DEV_PORT || '8888', 10)\n     9→const VITE_PORT = 5173\n    10→\n    11→let viteProcess: ChildProcess | null = null\n    12→\n    13→// Load all function handlers\n    14→async function loadFunctions(): Promise<Map<string, (req: Request) => Promise<Response>>> {\n    15→  const handlers = new Map<string, (req: Request) => Promise<Response>>()\n    16→  const files = readdirSync(functionsDir).filter(f => f.endsWith('.ts') && f !== 'db.ts')\n    17→  for (const file of files) {\n    18→    const name = basename(file, '.ts')\n    19→    try {\n    20→      const mod = await import(join(functionsDir, file))\n    21→      const handler = mod.default\n    22→      if (typeof handler === 'function') {\n    23→        handlers.set(name, handler)\n    24→      }\n    25→    } catch (err) {\n    26→      console.warn(`Failed to load function ${name}:`, err)\n    27→    }\n    28→  }\n    29→  return handlers\n    30→}\n    31→\n    32→async function startVite(): Promise<void> {\n    33→  const viteBin = join(appDir, 'node_modules', '.bin', 'vite')\n    34→  viteProcess = spawn(viteBin, ['--port', String(VITE_PORT), '--strictPort'], {\n    35→    cwd: appDir,\n    36→    stdio: ['ignore', 'pipe', 'pipe'],\n    37→  })\n    38→\n    39→  viteProcess.on('exit', (code) => {\n    40→    console.error(`Vite process exited with code ${code}`)\n    41→  })\n    42→\n    43→  return new Promise((resolve, reject) => {\n    44→    const timeout = setTimeout(() => reject(new Error('Vite failed to start within 30s')), 30000)\n    45→    let output = ''\n    46→    const check = (data: Buffer) => {\n    47→      output += data.toString()\n    48→      if (output.includes('ready') || output.includes(`localhost:${VITE_PORT}`)) {\n    49→        clearTimeout(timeout)\n    50→        resolve()\n    51→      }\n    52→    }\n    53→    viteProcess!.stdout?.on('data', check)\n    54→    viteProcess!.stderr?.on('data', check)\n    55→    viteProcess!.on('error', (err) => { clearTimeout(timeout); reject(err) })\n    56→  })\n    57→}\n    58→\n    59→function collectBody(req: http.IncomingMessage): Promise<Buffer> {\n    60→  return new Promise((resolve) => {\n    61→    const chunks: Buffer[] = []\n    62→    req.on('data', (chunk: Buffer) => chunks.push(chunk))\n    63→    req.on('end', () => resolve(Buffer.concat(chunks)))\n    64→  })\n    65→}\n    66→\n    67→async function main() {\n    68→  const handlers = await loadFunctions()\n    69→  console.log(`Loaded ${handlers.size} functions: ${[...handlers.keys()].join(', ')}`)\n    70→\n    71→  await startVite()\n    72→  console.log(`Vite dev server ready on port ${VITE_PORT}`)\n    73→\n    74→  const server = http.createServer(async (req, res) => {\n    75→    const url = req.url || '/'\n    76→\n    77→    // Handle API routes -> netlify functions\n    78→    const apiMatch = url.match(/^\\/api\\/([^/?]+)/)\n    79→    if (apiMatch) {\n    80→      const fnName = apiMatch[1]!\n    81→      const handler = handlers.get(fnName)\n    82→      if (!handler) {\n    83→        res.writeHead(404, { 'Content-Type': 'application/json' })\n    84→        res.end(JSON.stringify({ error: `Function ${fnName} not found` }))\n    85→        return\n    86→      }\n    87→\n    88→      try {\n    89→        const body = await collectBody(req)\n    90→        const headers: Record<string, string> = {}\n    91→        for (const [key, val] of Object.entries(req.headers)) {\n    92→          if (val) headers[key] = Array.isArray(val) ? val.join(', ') : val\n    93→        }\n    94→\n    95→        const fnReq = new Request(`http://localhost:${PORT}${url}`, {\n    96→          method: req.method,\n    97→          headers,\n    98→          body: req.method !== 'GET' && req.method !== 'HEAD' ? body : undefined,\n    99→        })\n   100→\n   101→        const fnRes = await handler(fnReq)\n   102→        const resBody = await fnRes.text()\n   103→\n   104→        const resHeaders: Record<string, string> = {}\n   105→        fnRes.headers.forEach((val, key) => { resHeaders[key] = val })\n   106→        res.writeHead(fnRes.status, resHeaders)\n   107→        res.end(resBody)\n   108→      } catch (err) {\n   109→        console.error(`Error in function ${fnName}:`, err)\n   110→        res.writeHead(500, { 'Content-Type': 'application/json' })\n   111→        res.end(JSON.stringify({ error: 'Internal server error' }))\n   112→      }\n   113→      return\n   114→    }\n   115→\n   116→    // Proxy everything else to Vite\n   117→    const proxyReq = http.request(\n   118→      { hostname: '::1', port: VITE_PORT, path: url, method: req.method, headers: req.headers },\n   119→      (proxyRes) => {\n   120→        res.writeHead(proxyRes.statusCode || 200, proxyRes.headers)\n   121→        proxyRes.pipe(res)\n   122→      }\n   123→    )\n   124→    proxyReq.on('error', (err) => {\n   125→      console.error(`Proxy error to Vite: ${err.message}`)\n   126→      res.writeHead(502)\n   127→      res.end(`Proxy error: ${err.message}`)\n   128→    })\n   129→\n   130→    req.pipe(proxyReq)\n   131→  })\n   132→\n   133→  // Handle WebSocket upgrades for Vite HMR\n   134→  server.on('upgrade', (req, socket, head) => {\n   135→    const proxyReq = http.request({\n   136→      hostname: '127.0.0.1',\n   137→      port: VITE_PORT,\n   138→      path: req.url,\n   139→      method: req.method,\n   140→      headers: req.headers,\n   141→    })\n   142→    proxyReq.on('upgrade', (proxyRes, proxySocket, proxyHead) => {\n   143→      socket.write(`HTTP/${proxyRes.httpVersion} ${proxyRes.statusCode} ${proxyRes.statusMessage}\\r\\n`)\n   144→      for (let i = 0; i < proxyRes.rawHeaders.length; i += 2) {\n   145→        socket.write(`${proxyRes.rawHeaders[i]}: ${proxyRes.rawHeaders[i + 1]}\\r\\n`)\n   146→      }\n   147→      socket.write('\\r\\n')\n   148→      if (proxyHead.length) socket.write(proxyHead)\n   149→      proxySocket.pipe(socket)\n   150→      socket.pipe(proxySocket)\n   151→    })\n   152→    proxyReq.on('error', () => socket.end())\n   153→    proxyReq.end()\n   154→  })\n   155→\n   156→  server.listen(PORT, () => {\n   157→    console.log(`Dev server ready on http://localhost:${PORT}`)\n   158→  })\n   159→\n   160→  // Keep process alive\n   161→  process.on('SIGTERM', () => {\n   162→    if (viteProcess) viteProcess.kill()\n   163→    process.exit(0)\n   164→  })\n   165→  process.on('SIGINT', () => {\n   166→    if (viteProcess) viteProcess.kill()\n   167→    process.exit(0)\n   168→  })\n   169→}\n   170→\n   171→main().catch((err) => {\n   172→  console.error('Dev server failed:', err)\n   173→  process.exit(1)\n   174→})\n   175→"}]},"parent_tool_use_id":null,"session_id":"1880e500-2182-4a27-9a5d-5f74c5e8203c","uuid":"66a1d4a9-e61d-4f0f-a09f-f0e746557801","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/scripts/dev-server.ts","content":"import http from 'http'\nimport { spawn, type ChildProcess } from 'child_process'\nimport { join, basename } from 'path'\nimport { readdirSync } from 'fs'\n\nconst appDir = join(import.meta.dirname, '..')\nconst functionsDir = join(appDir, 'netlify', 'functions')\nconst PORT = parseInt(process.env.DEV_PORT || '8888', 10)\nconst VITE_PORT = 5173\n\nlet viteProcess: ChildProcess | null = null\n\n// Load all function handlers\nasync function loadFunctions(): Promise<Map<string, (req: Request) => Promise<Response>>> {\n  const handlers = new Map<string, (req: Request) => Promise<Response>>()\n  const files = readdirSync(functionsDir).filter(f => f.endsWith('.ts') && f !== 'db.ts')\n  for (const file of files) {\n    const name = basename(file, '.ts')\n    try {\n      const mod = await import(join(functionsDir, file))\n      const handler = mod.default\n      if (typeof handler === 'function') {\n        handlers.set(name, handler)\n      }\n    } catch (err) {\n      console.warn(`Failed to load function ${name}:`, err)\n    }\n  }\n  return handlers\n}\n\nasync function startVite(): Promise<void> {\n  const viteBin = join(appDir, 'node_modules', '.bin', 'vite')\n  viteProcess = spawn(viteBin, ['--port', String(VITE_PORT), '--strictPort'], {\n    cwd: appDir,\n    stdio: ['ignore', 'pipe', 'pipe'],\n  })\n\n  viteProcess.on('exit', (code) => {\n    console.error(`Vite process exited with code ${code}`)\n  })\n\n  return new Promise((resolve, reject) => {\n    const timeout = setTimeout(() => reject(new Error('Vite failed to start within 30s')), 30000)\n    let output = ''\n    const check = (data: Buffer) => {\n      output += data.toString()\n      if (output.includes('ready') || output.includes(`localhost:${VITE_PORT}`)) {\n        clearTimeout(timeout)\n        resolve()\n      }\n    }\n    viteProcess!.stdout?.on('data', check)\n    viteProcess!.stderr?.on('data', check)\n    viteProcess!.on('error', (err) => { clearTimeout(timeout); reject(err) })\n  })\n}\n\nfunction collectBody(req: http.IncomingMessage): Promise<Buffer> {\n  return new Promise((resolve) => {\n    const chunks: Buffer[] = []\n    req.on('data', (chunk: Buffer) => chunks.push(chunk))\n    req.on('end', () => resolve(Buffer.concat(chunks)))\n  })\n}\n\nasync function main() {\n  const handlers = await loadFunctions()\n  console.log(`Loaded ${handlers.size} functions: ${[...handlers.keys()].join(', ')}`)\n\n  await startVite()\n  console.log(`Vite dev server ready on port ${VITE_PORT}`)\n\n  const server = http.createServer(async (req, res) => {\n    const url = req.url || '/'\n\n    // Handle API routes -> netlify functions\n    const apiMatch = url.match(/^\\/api\\/([^/?]+)/)\n    if (apiMatch) {\n      const fnName = apiMatch[1]!\n      const handler = handlers.get(fnName)\n      if (!handler) {\n        res.writeHead(404, { 'Content-Type': 'application/json' })\n        res.end(JSON.stringify({ error: `Function ${fnName} not found` }))\n        return\n      }\n\n      try {\n        const body = await collectBody(req)\n        const headers: Record<string, string> = {}\n        for (const [key, val] of Object.entries(req.headers)) {\n          if (val) headers[key] = Array.isArray(val) ? val.join(', ') : val\n        }\n\n        const fnReq = new Request(`http://localhost:${PORT}${url}`, {\n          method: req.method,\n          headers,\n          body: req.method !== 'GET' && req.method !== 'HEAD' ? body : undefined,\n        })\n\n        const fnRes = await handler(fnReq)\n        const resBody = await fnRes.text()\n\n        const resHeaders: Record<string, string> = {}\n        fnRes.headers.forEach((val, key) => { resHeaders[key] = val })\n        res.writeHead(fnRes.status, resHeaders)\n        res.end(resBody)\n      } catch (err) {\n        console.error(`Error in function ${fnName}:`, err)\n        res.writeHead(500, { 'Content-Type': 'application/json' })\n        res.end(JSON.stringify({ error: 'Internal server error' }))\n      }\n      return\n    }\n\n    // Proxy everything else to Vite\n    const proxyReq = http.request(\n      { hostname: '::1', port: VITE_PORT, path: url, method: req.method, headers: req.headers },\n      (proxyRes) => {\n        res.writeHead(proxyRes.statusCode || 200, proxyRes.headers)\n        proxyRes.pipe(res)\n      }\n    )\n    proxyReq.on('error', (err) => {\n      console.error(`Proxy error to Vite: ${err.message}`)\n      res.writeHead(502)\n      res.end(`Proxy error: ${err.message}`)\n    })\n\n    req.pipe(proxyReq)\n  })\n\n  // Handle WebSocket upgrades for Vite HMR\n  server.on('upgrade', (req, socket, head) => {\n    const proxyReq = http.request({\n      hostname: '127.0.0.1',\n      port: VITE_PORT,\n      path: req.url,\n      method: req.method,\n      headers: req.headers,\n    })\n    proxyReq.on('upgrade', (proxyRes, proxySocket, proxyHead) => {\n      socket.write(`HTTP/${proxyRes.httpVersion} ${proxyRes.statusCode} ${proxyRes.statusMessage}\\r\\n`)\n      for (let i = 0; i < proxyRes.rawHeaders.length; i += 2) {\n        socket.write(`${proxyRes.rawHeaders[i]}: ${proxyRes.rawHeaders[i + 1]}\\r\\n`)\n      }\n      socket.write('\\r\\n')\n      if (proxyHead.length) socket.write(proxyHead)\n      proxySocket.pipe(socket)\n      socket.pipe(proxySocket)\n    })\n    proxyReq.on('error', () => socket.end())\n    proxyReq.end()\n  })\n\n  server.listen(PORT, () => {\n    console.log(`Dev server ready on http://localhost:${PORT}`)\n  })\n\n  // Keep process alive\n  process.on('SIGTERM', () => {\n    if (viteProcess) viteProcess.kill()\n    process.exit(0)\n  })\n  process.on('SIGINT', () => {\n    if (viteProcess) viteProcess.kill()\n    process.exit(0)\n  })\n}\n\nmain().catch((err) => {\n  console.error('Dev server failed:', err)\n  process.exit(1)\n})\n","numLines":175,"startLine":1,"totalLines":175}}}
