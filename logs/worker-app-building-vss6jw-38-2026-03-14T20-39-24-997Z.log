g = await sql`SELECT * FROM users WHERE id = ${userId}`\n    46→    const existingUser = existing[0]\n    47→    if (!existingUser) {\n    48→      return new Response(JSON.stringify({ error: 'User not found' }), { status: 404, headers })\n    49→    }\n    50→\n    51→    const eu = existingUser as Record<string, unknown>\n    52→    const result = await sql`\n    53→      UPDATE users SET\n    54→        name = ${body.name !== undefined ? body.name : eu.name as string},\n    55→        bio = ${body.bio !== undefined ? (body.bio || null) : eu.bio as string | null},\n    56→        phone = ${body.phone !== undefined ? (body.phone || null) : eu.phone as string | null},\n    57→        avatar_url = ${body.avatar_url !== undefined ? (body.avatar_url || null) : eu.avatar_url as string | null}\n    58→      WHERE id = ${userId}\n    59→      RETURNING *\n    60→    `\n    61→    const user = result[0]\n    62→    return new Response(JSON.stringify(user), { status: 200, headers })\n    63→  }\n    64→\n    65→  return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers })\n    66→}\n    67→"}]},"parent_tool_use_id":"toolu_01FZARh1Zdt1qgiuFEKfLqvi","session_id":"3cb04981-cf4f-45af-a469-e67faaad997f","uuid":"ddb67961-1ca7-4443-93bd-d28421ca9ca3"}
