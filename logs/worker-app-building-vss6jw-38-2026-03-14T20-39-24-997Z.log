[2026-03-14T20:32:42.832Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DrXU4twmcbwpNWLqNUFjzx","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions'\n     2→import { getSql } from './db.js'\n     3→\n     4→export default async (request: Request, _context: Context) => {\n     5→  const sql = getSql()\n     6→  const url = new URL(request.url)\n     7→  const headers = { 'Content-Type': 'application/json' }\n     8→\n     9→  if (request.method === 'GET') {\n    10→    const guestId = url.searchParams.get('guest_id')\n    11→    const propertyId = url.searchParams.get('property_id')\n    12→\n    13→    if (guestId) {\n    14→      const reviews = await sql`\n    15→        SELECT r.*, p.title as property_title\n    16→        FROM reviews r\n    17→        JOIN properties p ON p.id = r.property_id\n    18→        WHERE r.guest_id = ${guestId}\n    19→        ORDER BY r.created_at DESC\n    20→      `\n    21→      return new Response(JSON.stringify(reviews), { status: 200, headers })\n    22→    }\n    23→\n    24→    if (propertyId) {\n    25→      const reviews = await sql`\n    26→        SELECT r.*, u.name as guest_name, u.avatar_url as guest_avatar\n    27→        FROM reviews r\n    28→        JOIN users u ON u.id = r.guest_id\n    29→        WHERE r.property_id = ${propertyId}\n    30→        ORDER BY r.created_at DESC\n    31→      `\n    32→      return new Response(JSON.stringify(reviews), { status: 200, headers })\n    33→    }\n    34→\n    35→    return new Response(JSON.stringify({ error: 'guest_id or property_id is required' }), { status: 400, headers })\n    36→  }\n    37→\n    38→  if (request.method === 'POST') {\n    39→    const body = await request.json() as {\n    40→      booking_id: string\n    41→      property_id: string\n    42→      guest_id: string\n    43→      rating: number\n    44→      cleanliness: number\n    45→      accuracy: number\n    46→      communication: number\n    47→      location: number\n    48→      value: number\n    49→      comment?: string | null\n    50→    }\n    51→\n    52→    const { booking_id, property_id, guest_id, rating, cleanliness, accuracy, communication, location, value, comment } = body\n    53→\n    54→    if (!booking_id || !property_id || !guest_id || !rating) {\n    55→      return new Response(JSON.stringify({ error: 'Missing required fields' }), { status: 400, headers })\n    56→    }\n    57→\n    58→    const existingReview = await sql`SELECT id FROM reviews WHERE booking_id = ${booking_id}`\n    59→    if (existingReview.length > 0) {\n    60→      return new Response(JSON.stringify({ error: 'A review already exists for this booking' }), { status: 409, headers })\n    61→    }\n    62→\n    63→    const result = await sql`\n    64→      INSERT INTO reviews (id, booking_id, property_id, guest_id, rating, cleanliness, accuracy, communication, location, value, comment, created_at)\n    65→      VALUES (gen_random_uuid(), ${booking_id}, ${property_id}, ${guest_id}, ${rating}, ${cleanliness}, ${accuracy}, ${communication}, ${location}, ${value}, ${comment || null}, now())\n    66→      RETURNING *\n    67→    `\n    68→    const review = result[0]\n    69→    if (!review) {\n    70→      return new Response(JSON.stringify({ error: 'Failed to create review' }), { status: 500, headers })\n    71→    }\n    72→    return new Response(JSON.stringify(review), { status: 201, headers })\n    73→  }\n    74→\n    75→  return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers })\n    76→}\n    77→"}]},"parent_tool_use_id":"toolu_01FZARh1Zdt1qgiuFEKfLqvi","session_id":"3cb04981-cf4f-45af-a469-e67faaad997f","uuid":"e536c13b-d15d-4170-a92f-5e874981de4c"}
