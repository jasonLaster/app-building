(gen_random_uuid(), ${property_id}, ${guest_id}, ${check_in}, ${check_out}, ${num_guests}, ${total_price}, 'pending', ${special_requests || null}, now())\n    43→      RETURNING *\n    44→    `\n    45→    const booking = result[0]\n    46→    return new Response(JSON.stringify(booking), { status: 201, headers })\n    47→  }\n    48→\n    49→  if (request.method === 'PUT' && bookingId) {\n    50→    const body = await request.json() as { status: string }\n    51→    const { status } = body\n    52→\n    53→    if (!['confirmed', 'cancelled'].includes(status)) {\n    54→      return new Response(JSON.stringify({ error: 'Invalid status' }), { status: 400, headers })\n    55→    }\n    56→\n    57→    const result = await sql`\n    58→      UPDATE bookings SET status = ${status} WHERE id = ${bookingId} RETURNING *\n    59→    `\n    60→    const booking = result[0]\n    61→    if (!booking) {\n    62→      return new Response(JSON.stringify({ error: 'Booking not found' }), { status: 404, headers })\n    63→    }\n    64→    return new Response(JSON.stringify(booking), { status: 200, headers })\n    65→  }\n    66→\n    67→  if (request.method === 'GET') {\n    68→    const guestId = url.searchParams.get('guest_id')\n    69→    if (!guestId) {\n    70→      return new Response(JSON.stringify({ error: 'guest_id is required' }), { status: 400, headers })\n    71→    }\n    72→\n    73→    const bookings = await sql`\n    74→      SELECT b.*,\n    75→        p.title as property_title, p.city as property_city, p.country as property_country,\n    76→        (SELECT url FROM property_images pi WHERE pi.property_id = p.id ORDER BY pi.display_order ASC LIMIT 1) as property_image,\n    77→        CASE WHEN EXISTS (SELECT 1 FROM reviews r WHERE r.booking_id = b.id) THEN true ELSE false END as has_review\n    78→      FROM bookings b\n    79→      JOIN properties p ON p.id = b.property_id\n    80→      WHERE b.guest_id = ${guestId}\n    81→      ORDER BY b.check_in ASC\n    82→    `\n    83→    return new Response(JSON.stringify(bookings), { status: 200, headers })\n    84→  }\n    85→\n    86→  return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers })\n    87→}\n    88→"}]},"parent_tool_use_id":null,"session_id":"3cb04981-cf4f-45af-a469-e67faaad997f","uuid":"d8b248af-674d-472a-9524-456c2694fc5a","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/netlify/functions/bookings.ts","content":"import type { Context } from '@netlify/functions'\nimport { getSql } from './db.js'\n\nexport default async (request: Request, _context: Context) => {\n  const sql = getSql()\n  const url = new URL(request.url)\n  const segments = url.pathname.split('/').filter(Boolean)\n  const bookingId = segments[2]\n\n  const headers = { 'Content-Type': 'application/json' }\n\n  if (request.method === 'POST') {\n    const body = await request.json() as {\n      property_id: string\n      guest_id: string\n      check_in: string\n      check_out: string\n      num_guests: number\n      total_price: number\n      special_requests?: string\n    }\n\n    const { property_id, guest_id, check_in, check_out, num_guests, total_price, special_requests } = body\n\n    if (!property_id || !guest_id || !check_in || !check_out || !num_guests || !total_price) {\n      return new Response(JSON.stringify({ error: 'Missing required fields' }), { status: 400, headers })\n    }\n\n    const overlap = await sql`\n      SELECT id FROM bookings\n      WHERE property_id = ${property_id}\n      AND status IN ('confirmed', 'pending')\n      AND check_in < ${check_out}\n      AND check_out > ${check_in}\n    `\n    if (overlap.length > 0) {\n      return new Response(JSON.stringify({ error: 'Property is not available for the selected dates' }), { status: 409, headers })\n    }\n\n    const result = await sql`\n      INSERT INTO bookings (id, property_id, guest_id, check_in, check_out, num_guests, total_price, status, special_requests, created_at)\n      VALUES (gen_random_uuid(), ${property_id}, ${guest_id}, ${check_in}, ${check_out}, ${num_guests}, ${total_price}, 'pending', ${special_requests || null}, now())\n      RETURNING *\n    `\n    const booking = result[0]\n    return new Response(JSON.stringify(booking), { status: 201, headers })\n  }\n\n  if (request.method === 'PUT' && bookingId) {\n    const body = await request.json() as { status: string }\n    const { status } = body\n\n    if (!['confirmed', 'cancelled'].includes(status)) {\n      return new Response(JSON.stringify({ error: 'Invalid status' }), { status: 400, headers })\n    }\n\n    const result = await sql`\n      UPDATE bookings SET status = ${status} WHERE id = ${bookingId} RETURNING *\n    `\n    const booking = result[0]\n    if (!booking) {\n      return new Response(JSON.stringify({ error: 'Booking not found' }), { status: 404, headers })\n    }\n    return new Response(JSON.stringify(booking), { status: 200, headers })\n  }\n\n  if (request.method === 'GET') {\n    const guestId = url.searchParams.get('guest_id')\n    if (!guestId) {\n      return new Response(JSON.stringify({ error: 'guest_id is required' }), { status: 400, headers })\n    }\n\n    const bookings = await sql`\n      SELECT b.*,\n        p.title as property_title, p.city as property_city, p.country as property_country,\n        (SELECT url FROM property_images pi WHERE pi.property_id = p.id ORDER BY pi.display_order ASC LIMIT 1) as property_image,\n        CASE WHEN EXISTS (SELECT 1 FROM reviews r WHERE r.booking_id = b.id) THEN true ELSE false END as has_review\n      FROM bookings b\n      JOIN properties p ON p.id = b.property_id\n      WHERE b.guest_id = ${guestId}\n      ORDER BY b.check_in ASC\n    `\n    return new Response(JSON.stringify(bookings), { status: 200, headers })\n  }\n\n  return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers })\n}\n","numLines":88,"startLine":1,"totalLines":88}}}
