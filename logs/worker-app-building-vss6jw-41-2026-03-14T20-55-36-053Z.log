[2026-03-14T20:52:23.240Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JtshWCXue3dyzb61kuTHh7","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions'\n     2→import { getSql } from './db.js'\n     3→\n     4→export default async (request: Request, _context: Context) => {\n     5→  const sql = getSql()\n     6→\n     7→  if (request.method === 'POST') {\n     8→    const body = await request.json()\n     9→    const { email, name } = body\n    10→\n    11→    if (!email) {\n    12→      return new Response(JSON.stringify({ error: 'Email is required' }), {\n    13→        status: 400,\n    14→        headers: { 'Content-Type': 'application/json' },\n    15→      })\n    16→    }\n    17→\n    18→    if (name) {\n    19→      // Register mode\n    20→      const existing = await sql`SELECT * FROM users WHERE email = ${email}`\n    21→      if (existing.length > 0) {\n    22→        return new Response(\n    23→          JSON.stringify({ error: 'An account with this email already exists' }),\n    24→          { status: 409, headers: { 'Content-Type': 'application/json' } }\n    25→        )\n    26→      }\n    27→\n    28→      const result = await sql`\n    29→        INSERT INTO users (id, email, name, created_at)\n    30→        VALUES (gen_random_uuid(), ${email}, ${name}, now())\n    31→        RETURNING *\n    32→      `\n    33→      const user = result[0]\n    34→      if (!user) {\n    35→        return new Response(JSON.stringify({ error: 'Failed to create user' }), {\n    36→          status: 500,\n    37→          headers: { 'Content-Type': 'application/json' },\n    38→        })\n    39→      }\n    40→      return new Response(JSON.stringify(user), {\n    41→        status: 201,\n    42→        headers: { 'Content-Type': 'application/json' },\n    43→      })\n    44→    } else {\n    45→      // Login mode\n    46→      const result = await sql`SELECT * FROM users WHERE email = ${email}`\n    47→      const user = result[0]\n    48→      if (!user) {\n    49→        return new Response(\n    50→          JSON.stringify({ error: 'No account found with this email' }),\n    51→          { status: 404, headers: { 'Content-Type': 'application/json' } }\n    52→        )\n    53→      }\n    54→      return new Response(JSON.stringify(user), {\n    55→        status: 200,\n    56→        headers: { 'Content-Type': 'application/json' },\n    57→      })\n    58→    }\n    59→  }\n    60→\n    61→  return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n    62→    status: 405,\n    63→    headers: { 'Content-Type': 'application/json' },\n    64→  })\n    65→}\n    66→"}]},"parent_tool_use_id":null,"session_id":"8b502c6d-2fab-4348-89e8-3447774cafbf","uuid":"29d5cdcb-9352-46cd-9b38-58cd6b9435fc","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/netlify/functions/auth.ts","content":"import type { Context } from '@netlify/functions'\nimport { getSql } from './db.js'\n\nexport default async (request: Request, _context: Context) => {\n  const sql = getSql()\n\n  if (request.method === 'POST') {\n    const body = await request.json()\n    const { email, name } = body\n\n    if (!email) {\n      return new Response(JSON.stringify({ error: 'Email is required' }), {\n        status: 400,\n        headers: { 'Content-Type': 'application/json' },\n      })\n    }\n\n    if (name) {\n      // Register mode\n      const existing = await sql`SELECT * FROM users WHERE email = ${email}`\n      if (existing.length > 0) {\n        return new Response(\n          JSON.stringify({ error: 'An account with this email already exists' }),\n          { status: 409, headers: { 'Content-Type': 'application/json' } }\n        )\n      }\n\n      const result = await sql`\n        INSERT INTO users (id, email, name, created_at)\n        VALUES (gen_random_uuid(), ${email}, ${name}, now())\n        RETURNING *\n      `\n      const user = result[0]\n      if (!user) {\n        return new Response(JSON.stringify({ error: 'Failed to create user' }), {\n          status: 500,\n          headers: { 'Content-Type': 'application/json' },\n        })\n      }\n      return new Response(JSON.stringify(user), {\n        status: 201,\n        headers: { 'Content-Type': 'application/json' },\n      })\n    } else {\n      // Login mode\n      const result = await sql`SELECT * FROM users WHERE email = ${email}`\n      const user = result[0]\n      if (!user) {\n        return new Response(\n          JSON.stringify({ error: 'No account found with this email' }),\n          { status: 404, headers: { 'Content-Type': 'application/json' } }\n        )\n      }\n      return new Response(JSON.stringify(user), {\n        status: 200,\n        headers: { 'Content-Type': 'application/json' },\n      })\n    }\n  }\n\n  return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n    status: 405,\n    headers: { 'Content-Type': 'application/json' },\n  })\n}\n","numLines":66,"startLine":1,"totalLines":66}}}
