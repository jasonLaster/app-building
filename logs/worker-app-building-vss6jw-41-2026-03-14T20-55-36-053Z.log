[2026-03-14T20:49:30.365Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DGMMC2AZ9g9XvgrQtiyHdN","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions'\n     2→import { getSql } from './db.js'\n     3→\n     4→export default async (request: Request, _context: Context) => {\n     5→  const sql = getSql()\n     6→  const url = new URL(request.url)\n     7→  const segments = url.pathname.split('/').filter(Boolean)\n     8→  const propertyId = segments[2] // /api/properties/:id\n     9→\n    10→  const headers = { 'Content-Type': 'application/json' }\n    11→\n    12→  if (request.method === 'GET' && propertyId) {\n    13→    const result = await sql`\n    14→      SELECT p.*,\n    15→        u.name as host_name, u.avatar_url as host_avatar, u.bio as host_bio, u.created_at as host_since,\n    16→        (SELECT count(*)::int FROM properties WHERE host_id = p.host_id AND is_active = true) as host_listing_count,\n    17→        (SELECT COALESCE(AVG(r.rating)::numeric(10,1), 0) FROM reviews r WHERE r.property_id = p.id) as avg_rating,\n    18→        (SELECT count(*)::int FROM reviews r WHERE r.property_id = p.id) as review_count\n    19→      FROM properties p\n    20→      JOIN users u ON u.id = p.host_id\n    21→      WHERE p.id = ${propertyId}\n    22→    `\n    23→    const property = result[0]\n    24→    if (!property) {\n    25→      return new Response(JSON.stringify({ error: 'Property not found' }), { status: 404, headers })\n    26→    }\n    27→\n    28→    const images = await sql`\n    29→      SELECT * FROM property_images WHERE property_id = ${propertyId} ORDER BY display_order ASC\n    30→    `\n    31→\n    32→    const amenities = await sql`\n    33→      SELECT a.* FROM amenities a\n    34→      JOIN property_amenities pa ON pa.amenity_id = a.id\n    35→      WHERE pa.property_id = ${propertyId}\n    36→      ORDER BY a.category, a.name\n    37→    `\n    38→\n    39→    const reviews = await sql`\n    40→      SELECT r.*, u.name as guest_name, u.avatar_url as guest_avatar\n    41→      FROM reviews r\n    42→      JOIN users u ON u.id = r.guest_id\n    43→      WHERE r.property_id = ${propertyId}\n    44→      ORDER BY r.created_at DESC\n    45→    `\n    46→\n    47→    return new Response(JSON.stringify({ ...property, images, amenities, reviews }), { status: 200, headers })\n    48→  }\n    49→\n    50→  if (request.method === 'GET') {\n    51→    const city = url.searchParams.get('city') || ''\n    52→    const checkIn = url.searchParams.get('check_in') || ''\n    53→    const checkOut = url.searchParams.get('check_out') || ''\n    54→    const guestsStr = url.searchParams.get('guests') || '0'\n    55→    const propertyType = url.searchParams.get('property_type') || ''\n    56→    const minPriceStr = url.searchParams.get('min_price') || '0'\n    57→    const maxPriceStr = url.searchParams.get('max_price') || '0'\n    58→    const minBedroomsStr = url.searchParams.get('min_bedrooms') || '0'\n    59→    const minBedsStr = url.searchParams.get('min_beds') || '0'\n    60→    const minBathroomsStr = url.searchParams.get('min_bathrooms') || '0'\n    61→    const amenitiesParam = url.searchParams.get('amenities') || ''\n    62→    const page = parseInt(url.searchParams.get('page') || '1', 10)\n    63→    const limit = parseInt(url.searchParams.get('limit') || '12', 10)\n    64→    const offset = (page - 1) * limit\n    65→\n    66→    const guestsNum = parseInt(guestsStr, 10) || 0\n    67→    const minPrice = parseFloat(minPriceStr) || 0\n    68→    const maxPrice = parseFloat(maxPriceStr) || 0\n    69→    const minBedrooms = parseInt(minBedroomsStr, 10) || 0\n    70→    const minBeds = parseInt(minBedsStr, 10) || 0\n    71→    const minBathrooms = parseInt(minBathroomsStr, 10) || 0\n    72→    const amenityIds = amenitiesParam ? amenitiesParam.split(',').filter(Boolean) : []\n    73→    const amenityCount = amenityIds.length\n    74→    const hasDateFilter = checkIn !== '' && checkOut !== ''\n    75→    const hasAmenityFilter = amenityCount > 0\n    76→\n    77→    const countResult = await sql`\n    78→      SELECT count(*)::int as total\n    79→      FROM properties p\n    80→      WHERE p.is_active = true\n    81→        AND (${city} = '' OR LOWER(p.city) LIKE LOWER('%' || ${city} || '%'))\n    82→        AND (${guestsNum} = 0 OR p.max_guests >= ${guestsNum})\n    83→        AND (${propertyType} = '' OR p.property_type = ${propertyType})\n    84→        AND (${minPrice} = 0 OR p.price_per_night >= ${minPrice})\n    85→        AND (${maxPrice} = 0 OR p.price_per_night <= ${maxPrice})\n    86→        AND (${minBedrooms} = 0 OR p.bedrooms >= ${minBedrooms})\n    87→        AND (${minBeds} = 0 OR p.beds >= ${minBeds})\n    88→        AND (${minBathrooms} = 0 OR p.bathrooms >= ${minBathrooms})\n    89→        AND (${!hasDateFilter} OR NOT EXISTS (\n    90→          SELECT 1 FROM bookings b\n    91→          WHERE b.property_id = p.id\n    92→          AND b.status IN ('confirmed', 'pending')\n    93→          AND b.check_in < ${checkOut || '9999-12-31'}\n    94→          AND b.check_out > ${checkIn || '1970-01-01'}\n    95→        ))\n    96→        AND (${!hasAmenityFilter} OR (\n    97→          SELECT count(*) FROM property_amenities pa\n    98→          WHERE pa.property_id = p.id AND pa.amenity_id::text = ANY(${amenityIds})\n    99→        ) >= ${amenityCount})\n   100→    `\n   101→    const countRow = countResult[0]\n   102→    const total = countRow ? (countRow as Record<string, unknown>).total as number : 0\n   103→\n   104→    const properties = await sql`\n   105→      SELECT p.*,\n   106→        (SELECT url FROM property_images pi WHERE pi.property_id = p.id ORDER BY pi.display_order ASC LIMIT 1) as main_image,\n   107→        (SELECT COALESCE(AVG(r.rating)::numeric(10,1), 0) FROM reviews r WHERE r.property_id = p.id) as avg_rating,\n   108→        (SELECT count(*)::int FROM reviews r WHERE r.property_id = p.id) as review_count\n   109→      FROM properties p\n   110→      WHERE p.is_active = true\n   111→        AND (${city} = '' OR LOWER(p.city) LIKE LOWER('%' || ${city} || '%'))\n   112→        AND (${guestsNum} = 0 OR p.max_guests >= ${guestsNum})\n   113→        AND (${propertyType} = '' OR p.property_type = ${propertyType})\n   114→        AND (${minPrice} = 0 OR p.price_per_night >= ${minPrice})\n   115→        AND (${maxPrice} = 0 OR p.price_per_night <= ${maxPrice})\n   116→        AND (${minBedrooms} = 0 OR p.bedrooms >= ${minBedrooms})\n   117→        AND (${minBeds} = 0 OR p.beds >= ${minBeds})\n   118→        AND (${minBathrooms} = 0 OR p.bathrooms >= ${minBathrooms})\n   119→        AND (${!hasDateFilter} OR NOT EXISTS (\n   120→          SELECT 1 FROM bookings b\n   121→          WHERE b.property_id = p.id\n   122→          AND b.status IN ('confirmed', 'pending')\n   123→          AND b.check_in < ${checkOut || '9999-12-31'}\n   124→          AND b.check_out > ${checkIn || '1970-01-01'}\n   125→        ))\n   126→        AND (${!hasAmenityFilter} OR (\n   127→          SELECT count(*) FROM property_amenities pa\n   128→          WHERE pa.property_id = p.id AND pa.amenity_id::text = ANY(${amenityIds})\n   129→        ) >= ${amenityCount})\n   130→      ORDER BY p.created_at DESC\n   131→      LIMIT ${limit} OFFSET ${offset}\n   132→    `\n   133→\n   134→    return new Response(JSON.stringify({\n   135→      properties,\n   136→      total,\n   137→      page,\n   138→      limit,\n   139→      totalPages: Math.ceil(total / limit),\n   140→    }), { status: 200, headers })\n   141→  }\n   142→\n   143→  if (request.method === 'POST') {\n   144→    const body = await request.json() as {\n   145→      host_id: string\n   146→      title: string\n   147→      description: string\n   148→      property_type: string\n   149→      price_per_night: number\n   150→      cleaning_fee: number\n   151→      max_guests: number\n   152→      bedrooms: number\n   153→      beds: number\n   154→      bathrooms: number\n   155→      address: string\n   156→      city: string\n   157→      state: string | null\n   158→      country: string\n   159→      latitude: number | null\n   160→      longitude: number | null\n   161→      amenity_ids?: string[]\n   162→    }\n   163→\n   164→    const {\n   165→      host_id, title, description, property_type, price_per_night, cleaning_fee,\n   166→      max_guests, bedrooms, beds, bathrooms, address, city, state, country,\n   167→      latitude, longitude, amenity_ids,\n   168→    } = body\n   169→\n   170→    if (!host_id || !title || !property_type || !price_per_night || !max_guests || !city || !country) {\n   171→      return new Response(JSON.stringify({ error: 'Missing required fields' }), { status: 400, headers })\n   172→    }\n   173→\n   174→    const result = await sql`\n   175→      INSERT INTO properties (id, host_id, title, description, property_type, price_per_night, cleaning_fee,\n   176→        max_guests, bedrooms, beds, bathrooms, address, city, state, country, latitude, longitude,\n   177→        is_active, created_at, updated_at)\n   178→      VALUES (gen_random_uuid(), ${host_id}, ${title}, ${description || ''}, ${property_type},\n   179→        ${price_per_night}, ${cleaning_fee || 0}, ${max_guests}, ${bedrooms || 0}, ${beds || 0},\n   180→        ${bathrooms || 0}, ${address || ''}, ${city}, ${state || null}, ${country},\n   181→        ${latitude || null}, ${longitude || null}, true, now(), now())\n   182→      RETURNING *\n   183→    `\n   184→    const property = result[0]\n   185→\n   186→    if (amenity_ids && amenity_ids.length > 0) {\n   187→      for (const amenityId of amenity_ids) {\n   188→        await sql`\n   189→          INSERT INTO property_amenities (property_id, amenity_id)\n   190→          VALUES (${(property as Record<string, unknown>).id as string}, ${amenityId})\n   191→          ON CONFLICT DO NOTHING\n   192→        `\n   193→      }\n   1