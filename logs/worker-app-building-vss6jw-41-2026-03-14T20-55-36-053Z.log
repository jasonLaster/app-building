   50→  return (\n    51→    <div data-testid=\"stats-overview\" className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n    52→      {cards.map((card) => (\n    53→        <div\n    54→          key={card.testId}\n    55→          data-testid={card.testId}\n    56→          className=\"bg-white rounded-xl border border-border p-5 flex items-start gap-4\"\n    57→        >\n    58→          <div className=\"w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0\">\n    59→            <card.icon size={20} className=\"text-primary\" />\n    60→          </div>\n    61→          <div>\n    62→            <p className=\"text-sm text-text-secondary font-medium\">{card.label}</p>\n    63→            <p className=\"text-2xl font-bold text-text mt-0.5 flex items-center gap-1\">\n    64→              {card.label === 'Average Rating' && stats.reviewCount > 0 && (\n    65→                <Star size={18} className=\"fill-status-pending text-status-pending\" />\n    66→              )}\n    67→              {card.value}\n    68→            </p>\n    69→          </div>\n    70→        </div>\n    71→      ))}\n    72→    </div>\n    73→  )\n    74→}\n    75→"}]},"parent_tool_use_id":"toolu_017FNgZEfQUDpMnJrhDek63E","session_id":"8b502c6d-2fab-4348-89e8-3447774cafbf","uuid":"f5fe7293-c853-45df-8d0a-700a7010fccf"}
