[2026-03-14T20:47:58.077Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011fLi4SiFi7UiKXEUVXcDYw","type":"tool_result","content":"     1→import { useState } from 'react'\n     2→import { Loader2, Calendar } from 'lucide-react'\n     3→import type { HostBooking } from '../slices/hostSlice'\n     4→\n     5→interface BookingsTabProps {\n     6→  bookings: HostBooking[]\n     7→  loading: boolean\n     8→  onConfirm: (bookingId: string) => Promise<void>\n     9→  onCancel: (bookingId: string) => Promise<void>\n    10→}\n    11→\n    12→const STATUS_FILTERS = ['All', 'Pending', 'Confirmed', 'Cancelled', 'Completed'] as const\n    13→type StatusFilter = (typeof STATUS_FILTERS)[number]\n    14→\n    15→const statusColors: Record<string, string> = {\n    16→  pending: 'bg-status-pending/20 text-status-pending',\n    17→  confirmed: 'bg-status-confirmed/20 text-status-confirmed',\n    18→  cancelled: 'bg-status-cancelled/20 text-status-cancelled',\n    19→  completed: 'bg-status-completed/20 text-status-completed',\n    20→}\n    21→\n    22→function formatDate(dateStr: string): string {\n    23→  const d = new Date(dateStr.split('T')[0] + 'T12:00:00')\n    24→  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })\n    25→}\n    26→\n    27→export default function BookingsTab({ bookings, loading, onConfirm, onCancel }: BookingsTabProps) {\n    28→  const [activeFilter, setActiveFilter] = useState<StatusFilter>('All')\n    29→  const [cancelDialog, setCancelDialog] = useState<HostBooking | null>(null)\n    30→  const [actionLoading, setActionLoading] = useState<string | null>(null)\n    31→\n    32→  const filteredBookings = activeFilter === 'All'\n    33→    ? bookings\n    34→    : bookings.filter((b) => b.status === activeFilter.toLowerCase())\n    35→\n    36→  const handleConfirm = async (bookingId: string) => {\n    37→    setActionLoading(bookingId)\n    38→    await onConfirm(bookingId)\n    39→    setActionLoading(null)\n    40→  }\n    41→\n    42→  const handleCancelClick = (booking: HostBooking) => {\n    43→    setCancelDialog(booking)\n    44→  }\n    45→\n    46→  const handleConfirmCancel = async () => {\n    47→    if (!cancelDialog) return\n    48→    setActionLoading(cancelDialog.id)\n    49→    await onCancel(cancelDialog.id)\n    50→    setActionLoading(null)\n    51→    setCancelDialog(null)\n    52→  }\n    53→\n    54→  if (loading) {\n    55→    return (\n    56→      <div className=\"flex items-center justify-center py-16\">\n    57→        <Loader2 size={32} className=\"animate-spin text-primary\" />\n    58→      </div>\n    59→    )\n    60→  }\n    61→\n    62→  return (\n    63→    <div data-testid=\"bookings-tab\">\n    64→      <div className=\"flex items-center gap-2 mb-6 flex-wrap\">\n    65→        {STATUS_FILTERS.map((filter) => (\n    66→          <button\n    67→            key={filter}\n    68→            data-testid={`booking-filter-${filter.toLowerCase()}`}\n    69→            onClick={() => setActiveFilter(filter)}\n    70→            className={`px-4 py-2 rounded-full text-sm font-medium transition-colors ${\n    71→              activeFilter === filter\n    72→                ? 'bg-primary text-white'\n    73→                : 'bg-bg-secondary text-text-secondary hover:bg-border'\n    74→            }`}\n    75→          >\n    76→            {filter}\n    77→          </button>\n    78→        ))}\n    79→      </div>\n    80→\n    81→      {filteredBookings.length === 0 ? (\n    82→        <div data-testid=\"bookings-empty-state\" className=\"text-center py-16\">\n    83→          <Calendar size={48} className=\"mx-auto text-text-secondary mb-4 opacity-50\" />\n    84→          <p className=\"text-text-secondary text-lg\">\n    85→            {activeFilter === 'All' ? 'No bookings yet' : `No ${activeFilter.toLowerCase()} bookings`}\n    86→          </p>\n    87→        </div>\n    88→      ) : (\n    89→        <div className=\"overflow-x-auto\">\n    90→          <table data-testid=\"bookings-table\" className=\"w-full\">\n    91→            <thead>\n    92→              <tr className=\"border-b border-border\">\n    93→                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Property</th>\n    94→                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Guest</th>\n    95→                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Check-in</th>\n    96→                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Check-out</th>\n    97→                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Guests</th>\n    98→                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Total</th>\n    99→                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Status</th>\n   100→                <th className=\"text-left py-3 px-4 text-sm font-medium text-text-secondary\">Actions</th>\n   101→              </tr>\n   102→            </thead>\n   103→            <tbody>\n   104→              {filteredBookings.map((booking) => (\n   105→                <tr\n   106→                  key={booking.id}\n   107→                  data-testid={`booking-row-${booking.id}`}\n   108→                  className=\"border-b border-border hover:bg-bg-secondary/50 transition-colors\"\n   109→                >\n   110→                  <td className=\"py-3 px-4 text-sm font-medium text-text\">{booking.property_title}</td>\n   111→                  <td className=\"py-3 px-4 text-sm text-text\">{booking.guest_name}</td>\n   112→                  <td className=\"py-3 px-4 text-sm text-text-secondary\">{formatDate(booking.check_in)}</td>\n   113→                  <td className=\"py-3 px-4 text-sm text-text-secondary\">{formatDate(booking.check_out)}</td>\n   114→                  <td className=\"py-3 px-4 text-sm text-text\">{booking.num_guests}</td>\n   115→                  <td className=\"py-3 px-4 text-sm font-medium text-text\">\n   116→                    ${Number(booking.total_price).toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}\n   117→                  </td>\n   118→                  <td className=\"py-3 px-4\">\n   119→                    <span\n   120→                      data-testid={`booking-status-${booking.id}`}\n   121→                      className={`inline-block px-2.5 py-1 rounded-full text-xs font-semibold capitalize ${statusColors[booking.status] || ''}`}\n   122→                    >\n   123→                      {booking.status}\n   124→                    </span>\n   125→                  </td>\n   126→                  <td className=\"py-3 px-4\">\n   127→                    {booking.status === 'pending' && (\n   128→                      <div className=\"flex gap-2\">\n   129→                        <button\n   130→                          data-testid={`booking-confirm-${booking.id}`}\n   131→                          onClick={() => handleConfirm(booking.id)}\n   132→                          disabled={actionLoading === booking.id}\n   133→                          className=\"px-3 py-1.5 text-xs font-medium text-white bg-status-confirmed rounded-lg hover:opacity-90 transition-opacity disabled:opacity-50\"\n   134→                        >\n   135→                          {actionLoading === booking.id ? '...' : 'Confirm'}\n   136→                        </button>\n   137→                        <button\n   138→                          data-testid={`booking-cancel-${booking.id}`}\n   139→                          onClick={() => handleCancelClick(booking)}\n   140→                          disabled={actionLoading === booking.id}\n   141→                          className=\"px-3 py-1.5 text-xs font-medium text-white bg-status-cancelled rounded-lg hover:opacity-90 transition-opacity disabled:opacity-50\"\n   142→                        >\n   143→                          Cancel\n   144→                        </button>\n   145→                      </div>\n   146→                    )}\n   147→                    {booking.status === 'confirmed' && (\n   148→                      <button\n   149→                        data-testid={`booking-cancel-${booking.id}`}\n   150→                        onClick={() => handleCancelClick(booking)}\n   151→                        disabled={actionLoading === booking.id}\n   152→                        className=\"px-3 py-1.5 text-xs font-medium text-white bg-status-cancelled rounded-lg hover:opacity-90 transition-opacity disabled:opacity-50\"\n   153→                      >\n   154→                        Cancel\n   155→                      </button>\n   156→                    )}\n   157→                  </td>\n   158→                </tr>\n   159→              ))}\n   160→            </tbody>\n   161→          </table>\n   162→        </div>\n   163→      )}\n   164→\n   165→      {cancelDialog && (\n   166→        <div\n   167→          data-testid=\"cancel-booking-dialog\"\n   168→          className=\"fixed inset-0 bg-black/50 flex items-center justify-center z-50\"\n   169→          onClick={() => setCancelDialog(null)}\n   170→        >\n   171→          <div\n   172→            className=\"bg-white rounded-xl p-6 max-w-md w-full mx-4 shadow-lg\"\n   173→            onClick={(e) => e.stopPropagation()}\n   174→          >\n   175→            <h3 className=\"text-lg font-semibold text-text mb-2\">Cancel Booking</h3>\n   176→            <p className=\"text-text-secondary mb-1\">Are you sure you want to cancel this booking?</p>\n   177→            <div className=\"bg-bg-secondary rounded-lg p-3 mb-6 text-sm\">\n   178→              <p className=\"font-medium text-text\">{cancelDialog.property_title}</p>\n   179→              <p className=\"text-text-secondary\">Guest: {cancelDialog.guest_name}</p>\n   180→              <p className=\"text-text-secondary\">\n   181→                {formatDate(cancelDialog.check_in)} — {formatDate(cancelDialog.check_out)}\n   182→              </p>\n   183→            </div>\n   184→            <div className=\"flex gap-3 justify-end\">\n   185→              <button\n   186→                data-testid=\"cancel-booking-dialog-dismiss\"\n   187→                onClick={() => setCancelDialog(null)}\n   188→                className=\"px-4 py-2 text-sm font-medium text-text bg-bg-secondary rounded-lg hover:bg-border transition-colors\"\n   189→              >\n   190→                Keep Booking\n   191→              </button>\n   192→              <button\n   193→                data-testid=\"cancel-booking-dialog-confirm\"\n   194→                onClick={handleConfirmCancel}\n   195→                disabled={actionLoading === cancelDialog.id}\n   196→                className=\"px-4 py-2 text-sm font-medium text-white bg-status-cancelled rounded-lg hover:opacity-90 transition-opacity disabled:opacity-50\"\n   197→              >\n   198→                {actionLoading === cancelDialog.id ? 'Cancelling...' : 'Yes, Cancel'}\n   199→              </button>\n   200→            </div>\n   201→          </div>\n   202→        </div>\n   203→      )}\n   204→    </div>\n   205→  )\n   206→}\n   207→"}]},"parent_tool_use_id":"toolu_017FNgZEfQUDpMnJrhDek63E","session_id":"8b502c6d-2fab-4348-89e8-3447774cafbf","uuid":"4c3eea94-5278-47a4-8baa-9b8b125eef80"}
