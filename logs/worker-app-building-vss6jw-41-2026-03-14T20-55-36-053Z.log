[2026-03-14T20:49:26.283Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SEgNuwqahXjMZ6vDBXuKYa","type":"tool_result","content":"     1→import { useState, useEffect, useCallback } from 'react'\n     2→import { useSelector, useDispatch } from 'react-redux'\n     3→import { useNavigate } from 'react-router-dom'\n     4→import type { RootState, AppDispatch } from '../store'\n     5→import {\n     6→  fetchHostStats,\n     7→  fetchHostListings,\n     8→  fetchHostBookings,\n     9→  deactivateProperty,\n    10→  activateProperty,\n    11→  updateHostBookingStatus,\n    12→} from '../slices/hostSlice'\n    13→import type { Property } from '../slices/propertiesSlice'\n    14→import StatsOverview from '../components/StatsOverview'\n    15→import ListingsTab from '../components/ListingsTab'\n    16→import BookingsTab from '../components/BookingsTab'\n    17→import AddListingForm from '../components/AddListingForm'\n    18→\n    19→type Tab = 'listings' | 'bookings'\n    20→\n    21→export default function HostDashboard() {\n    22→  const dispatch = useDispatch<AppDispatch>()\n    23→  const navigate = useNavigate()\n    24→  const currentUser = useSelector((state: RootState) => state.auth.currentUser)\n    25→  const { stats, listings, bookings, statsLoading, listingsLoading, bookingsLoading } = useSelector(\n    26→    (state: RootState) => state.host\n    27→  )\n    28→  const [activeTab, setActiveTab] = useState<Tab>('listings')\n    29→  const [showAddForm, setShowAddForm] = useState(false)\n    30→\n    31→  useEffect(() => {\n    32→    if (!currentUser) {\n    33→      navigate('/login')\n    34→    }\n    35→  }, [currentUser, navigate])\n    36→\n    37→  useEffect(() => {\n    38→    if (currentUser?.is_host) {\n    39→      dispatch(fetchHostStats(currentUser.id))\n    40→      dispatch(fetchHostListings(currentUser.id))\n    41→      dispatch(fetchHostBookings(currentUser.id))\n    42→    }\n    43→  }, [dispatch, currentUser])\n    44→\n    45→  const handleDeactivate = useCallback(async (property: Property) => {\n    46→    await dispatch(deactivateProperty(property.id))\n    47→  }, [dispatch])\n    48→\n    49→  const handleActivate = useCallback(async (property: Property) => {\n    50→    await dispatch(activateProperty(property.id))\n    51→  }, [dispatch])\n    52→\n    53→  const handleConfirmBooking = useCallback(async (bookingId: string) => {\n    54→    await dispatch(updateHostBookingStatus({ bookingId, status: 'confirmed' }))\n    55→  }, [dispatch])\n    56→\n    57→  const handleCancelBooking = useCallback(async (bookingId: string) => {\n    58→    await dispatch(updateHostBookingStatus({ bookingId, status: 'cancelled' }))\n    59→  }, [dispatch])\n    60→\n    61→  const handleAddListingSuccess = useCallback(() => {\n    62→    setShowAddForm(false)\n    63→    if (currentUser) {\n    64→      dispatch(fetchHostStats(currentUser.id))\n    65→      dispatch(fetchHostListings(currentUser.id))\n    66→    }\n    67→  }, [dispatch, currentUser])\n    68→\n    69→  if (!currentUser) {\n    70→    return null\n    71→  }\n    72→\n    73→  if (!currentUser.is_host) {\n    74→    return (\n    75→      <div data-testid=\"host-dashboard\" className=\"p-6 max-sm:p-3\">\n    76→        <div className=\"max-w-lg mx-auto text-center py-16\">\n    77→          <h1 className=\"text-2xl font-bold text-text mb-4\">Become a Host</h1>\n    78→          <p className=\"text-text-secondary mb-6\">\n    79→            You need to become a host to access this page. Visit your profile to get started.\n    80→          </p>\n    81→          <button\n    82→            data-testid=\"become-host-link\"\n    83→            onClick={() => navigate('/profile')}\n    84→            className=\"bg-primary text-white px-6 py-3 rounded-lg font-medium hover:bg-primary-dark transition-colors\"\n    85→          >\n    86→            Go to Profile\n    87→          </button>\n    88→        </div>\n    89→      </div>\n    90→    )\n    91→  }\n    92→\n    93→  return (\n    94→    <div data-testid=\"host-dashboard\" className=\"p-6 max-sm:p-3\">\n    95→      <div className=\"max-w-6xl mx-auto\">\n    96→        <h1 className=\"text-2xl font-bold text-text mb-6\">Host Dashboard</h1>\n    97→\n    98→        <StatsOverview stats={stats} loading={statsLoading} />\n    99→\n   100→        <div className=\"mt-8 mb-6\">\n   101→          <div className=\"flex border-b border-border\">\n   102→            <button\n   103→              data-testid=\"tab-listings\"\n   104→              onClick={() => setActiveTab('listings')}\n   105→              className={`px-6 py-3 text-sm font-medium border-b-2 transition-colors ${\n   106→                activeTab === 'listings'\n   107→                  ? 'border-primary text-primary'\n   108→                  : 'border-transparent text-text-secondary hover:text-text'\n   109→              }`}\n   110→            >\n   111→              Listings\n   112→            </button>\n   113→            <button\n   114→              data-testid=\"tab-bookings\"\n   115→              onClick={() => setActiveTab('bookings')}\n   116→              className={`px-6 py-3 text-sm font-medium border-b-2 transition-colors ${\n   117→                activeTab === 'bookings'\n   118→                  ? 'border-primary text-primary'\n   119→                  : 'border-transparent text-text-secondary hover:text-text'\n   120→              }`}\n   121→            >\n   122→              Bookings\n   123→            </button>\n   124→          </div>\n   125→        </div>\n   126→\n   127→        {activeTab === 'listings' && (\n   128→          <ListingsTab\n   129→            listings={listings}\n   130→            loading={listingsLoading}\n   131→            onDeactivate={handleDeactivate}\n   132→            onActivate={handleActivate}\n   133→            onAddListing={() => setShowAddForm(true)}\n   134→          />\n   135→        )}\n   136→\n   137→        {activeTab === 'bookings' && (\n   138→          <BookingsTab\n   139→            bookings={bookings}\n   140→            loading={bookingsLoading}\n   141→            onConfirm={handleConfirmBooking}\n   142→            onCancel={handleCancelBooking}\n   143→          />\n   144→        )}\n   145→\n   146→        {showAddForm && (\n   147→          <AddListingForm\n   148→            hostId={currentUser.id}\n   149→            onClose={() => setShowAddForm(false)}\n   150→            onSuccess={handleAddListingSuccess}\n   151→          />\n   152→        )}\n   153→      </div>\n   154→    </div>\n   155→  )\n   156→}\n   157→"}]},"parent_tool_use_id":"toolu_014gpPcyb41PcFVG2jCWKaQw","session_id":"8b502c6d-2fab-4348-89e8-3447774cafbf","uuid":"3ac46d11-9489-4d58-8a8f-094967c06fce"}
