ssName=\"text-center py-8 text-text-secondary border border-border rounded-xl\">\n    50→          You haven't written any reviews yet\n    51→        </div>\n    52→      ) : (\n    53→        <div className=\"space-y-3\">\n    54→          {reviews.map((review) => (\n    55→            <div\n    56→              key={review.id}\n    57→              data-testid={`review-card-${review.id}`}\n    58→              className=\"rounded-xl border border-border p-4 hover:shadow-md transition-shadow\"\n    59→            >\n    60→              <div className=\"flex items-start justify-between gap-2 mb-2\">\n    61→                <button\n    62→                  data-testid={`review-property-link-${review.id}`}\n    63→                  onClick={() => navigate(`/properties/${review.property_id}`)}\n    64→                  className=\"text-primary font-semibold hover:underline text-left\"\n    65→                >\n    66→                  {review.property_title}\n    67→                </button>\n    68→                <span className=\"text-xs text-text-secondary whitespace-nowrap\">\n    69→                  {formatDate(review.created_at)}\n    70→                </span>\n    71→              </div>\n    72→\n    73→              <StarRating rating={review.rating} />\n    74→\n    75→              {review.comment && (\n    76→                <p className=\"text-sm text-text mt-2\">{review.comment}</p>\n    77→              )}\n    78→            </div>\n    79→          ))}\n    80→        </div>\n    81→      )}\n    82→    </div>\n    83→  )\n    84→}\n    85→"}]},"parent_tool_use_id":null,"session_id":"f9a10ac0-bbdf-4066-b957-0d7c86e1c5c4","uuid":"d7b94e6b-90e9-4add-b54a-fa80667da2ac","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/components/UserReviewsList.tsx","content":"import { useNavigate } from 'react-router-dom'\nimport { Star, MessageSquare } from 'lucide-react'\nimport type { UserReview } from '../slices/userReviewsSlice'\n\ninterface UserReviewsListProps {\n  reviews: UserReview[]\n  loading: boolean\n}\n\nfunction formatDate(dateStr: string): string {\n  const date = new Date(dateStr.split('T')[0] + 'T12:00:00')\n  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })\n}\n\nfunction StarRating({ rating }: { rating: number }) {\n  return (\n    <div className=\"flex items-center gap-0.5\" data-testid=\"star-rating\">\n      {[1, 2, 3, 4, 5].map((star) => (\n        <Star\n          key={star}\n          size={16}\n          className={star <= rating ? 'text-primary fill-primary' : 'text-border'}\n          fill={star <= rating ? 'currentColor' : 'none'}\n        />\n      ))}\n    </div>\n  )\n}\n\nexport default function UserReviewsList({ reviews, loading }: UserReviewsListProps) {\n  const navigate = useNavigate()\n\n  if (loading) {\n    return (\n      <div data-testid=\"reviews-loading\" className=\"text-center py-8 text-text-secondary\">\n        Loading reviews...\n      </div>\n    )\n  }\n\n  return (\n    <div data-testid=\"user-reviews-list\">\n      <h2 className=\"text-xl font-semibold text-text mb-4 flex items-center gap-2\">\n        <MessageSquare size={20} />\n        My Reviews\n      </h2>\n\n      {reviews.length === 0 ? (\n        <div data-testid=\"reviews-empty-state\" className=\"text-center py-8 text-text-secondary border border-border rounded-xl\">\n          You haven't written any reviews yet\n        </div>\n      ) : (\n        <div className=\"space-y-3\">\n          {reviews.map((review) => (\n            <div\n              key={review.id}\n              data-testid={`review-card-${review.id}`}\n              className=\"rounded-xl border border-border p-4 hover:shadow-md transition-shadow\"\n            >\n              <div className=\"flex items-start justify-between gap-2 mb-2\">\n                <button\n                  data-testid={`review-property-link-${review.id}`}\n                  onClick={() => navigate(`/properties/${review.property_id}`)}\n                  className=\"text-primary font-semibold hover:underline text-left\"\n                >\n                  {review.property_title}\n                </button>\n                <span className=\"text-xs text-text-secondary whitespace-nowrap\">\n                  {formatDate(review.created_at)}\n                </span>\n              </div>\n\n              <StarRating rating={review.rating} />\n\n              {review.comment && (\n                <p className=\"text-sm text-text mt-2\">{review.comment}</p>\n              )}\n            </div>\n          ))}\n        </div>\n      )}\n    </div>\n  )\n}\n","numLines":85,"startLine":1,"totalLines":85}}}
