 37→    // Check pending booking (Emma's e3333333)\n    38→    await loginAs(page, 'emma@example.com')\n    39→    await page.goto('/trips')\n    40→    await expect(page.getByTestId('my-trips-page')).toBeVisible({ timeout: 30000 })\n    41→\n    42→    // Upcoming tab: e3333333 is pending, e6666666 is confirmed\n    43→    await expect(page.getByTestId('trip-card-e3333333-3333-3333-3333-333333333333')).toBeVisible({ timeout: 30000 })\n    44→    await expect(page.getByTestId('review-button-e3333333-3333-3333-3333-333333333333')).not.toBeVisible()\n    45→\n    46→    await expect(page.getByTestId('trip-card-e6666666-6666-6666-6666-666666666666')).toBeVisible()\n    47→    await expect(page.getByTestId('review-button-e6666666-6666-6666-6666-666666666666')).not.toBeVisible()\n    48→\n    49→    // Check cancelled booking (Alex's e5555555)\n    50→    await loginAs(page, 'alex@example.com')\n    51→    await page.goto('/trips')\n    52→    await expect(page.getByTestId('my-trips-page')).toBeVisible({ timeout: 30000 })\n    53→\n    54→    await page.getByTestId('tab-cancelled').click()\n    55→    await expect(page.getByTestId('trip-card-e5555555-5555-5555-5555-555555555555')).toBeVisible({ timeout: 30000 })\n    56→    await expect(page.getByTestId('review-button-e5555555-5555-5555-5555-555555555555')).not.toBeVisible()\n    57→  })\n    58→\n    59→  test('Trip cards are ordered by check-in date', async ({ page }) => {\n    60→    // Emma has two upcoming bookings:\n    61→    // e3333333: check_in 2026-05-10 (Mountain Cabin)\n    62→    // e6666666: check_in 2026-06-15 (Historic Townhouse)\n    63→    // They should appear in chronological order: e3333333 first, then e6666666\n    64→    await loginAs(page, 'emma@example.com')\n    65→    await page.goto('/trips')\n    66→    await expect(page.getByTestId('my-trips-page')).toBeVisible({ timeout: 30000 })\n    67→\n    68→    // Both cards should be visible in Upcoming tab\n    69→    await expect(page.getByTestId(