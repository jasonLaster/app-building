ssName=\"flex items-center justify-between\">\n            <label className=\"text-sm font-medium text-text\">{label}</label>\n            <span className=\"text-sm font-semibold text-text\" data-testid={`rating-value-${key}`}>\n              {ratings[key]}\n            </span>\n          </div>\n          <div className=\"flex items-center gap-3\">\n            <input\n              type=\"range\"\n              min={1}\n              max={5}\n              step={1}\n              value={ratings[key]}\n              onChange={(e) => handleChange(key, parseInt(e.target.value, 10))}\n              data-testid={`rating-input-${key}`}\n              className=\"flex-1 h-2 rounded-full appearance-none cursor-pointer accent-primary\"\n              style={{\n                background: `linear-gradient(to right, var(--color-primary) ${((ratings[key] - 1) / 4) * 100}%, var(--color-bg-secondary) ${((ratings[key] - 1) / 4) * 100}%)`,\n              }}\n            />\n            <div className=\"flex items-center gap-0.5\">\n              {Array.from({ length: 5 }, (_, i) => (\n                <Star\n                  key={i}\n                  size={14}\n                  className={\n                    i < ratings[key]\n                      ? 'fill-primary text-primary'\n                      : 'text-border'\n                  }\n                />\n              ))}\n            </div>\n          </div>\n        </div>\n      ))}\n    </div>\n  )\n}\n","structuredPatch":[{"oldStart":36,"oldLines":7,"newStart":36,"newLines":7,"lines":["           <div className=\"flex items-center justify-between\">","             <label className=\"text-sm font-medium text-text\">{label}</label>","             <span className=\"text-sm font-semibold text-text\" data-testid={`rating-value-${key}`}>","-              {ratings[key]}","+              {ratings[key] === 0 ? 'Not rated' : ratings[key]}","             </span>","           </div>","           <div className=\"flex items-center 