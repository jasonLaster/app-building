ssName=\"text-center py-8 text-text-secondary border border-border rounded-xl\">\n    50→          You haven't written any reviews yet\n    51→        </div>\n    52→      ) : (\n    53→        <div className=\"space-y-3\">\n    54→          {reviews.map((review) => (\n    55→            <div\n    56→              key={review.id}\n    57→              data-testid={`review-card-${review.id}`}\n    58→              className=\"rounded-xl border border-border p-4 hover:shadow-md transition-shadow\"\n    59→            >\n    60→              <div className=\"flex items-start justify-between gap-2 mb-2\">\n    61→                <button\n    62→                  data-testid={`review-property-link-${review.id}`}\n    63→                  onClick={() => navigate(`/properties/${review.property_id}`)}\n    64→                  className=\"text-primary font-semibold hover:underline text-left\"\n    65→                >\n    66→                  {review.property_title}\n    67→                </button>\n    68→                <span className=\"text-xs text-text-secondary whitespace-nowrap\">\n    69→                  {formatDate(review.created_at)}\n    70→                </span>\n    71→              </div>\n    72→\n    73→              <StarRating rating={review.rating} />\n    74→\n    75→              {review.comment && (\n    76→                <p className=\"text-sm text-text mt-2\">{review.comment}</p>\n    77→              )}\n    78→            </div>\n    79→          ))}\n    80→        </div>\n    81→      )}\n    82→    </div>\n    83→  )\n    84→}\n    85→"}]},"parent_tool_use_id":"toolu_01BK4ifK4xonNBXiuUCX9VmH","session_id":"f9a10ac0-bbdf-4066-b957-0d7c86e1c5c4","uuid":"0fdfbdcc-f08f-46a4-a1f2-e262b40608d0"}
