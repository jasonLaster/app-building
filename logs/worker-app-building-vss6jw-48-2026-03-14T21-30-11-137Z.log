[2026-03-14T21:20:10.077Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FRcVK7WJBobGtrKhrXsdZU","type":"tool_result","content":"     1→import { Calendar, MapPin, Users } from 'lucide-react'\n     2→import type { BookingDetail } from '../slices/reviewFormSlice'\n     3→\n     4→interface PropertyBookingContextProps {\n     5→  booking: BookingDetail\n     6→}\n     7→\n     8→function formatDate(dateStr: string): string {\n     9→  const date = new Date(dateStr.split('T')[0] + 'T12:00:00')\n    10→  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })\n    11→}\n    12→\n    13→function calcNights(checkIn: string, checkOut: string): number {\n    14→  const inDate = new Date(checkIn.split('T')[0] + 'T12:00:00')\n    15→  const outDate = new Date(checkOut.split('T')[0] + 'T12:00:00')\n    16→  return Math.round((outDate.getTime() - inDate.getTime()) / (1000 * 60 * 60 * 24))\n    17→}\n    18→\n    19→export default function PropertyBookingContext({ booking }: PropertyBookingContextProps) {\n    20→  const nights = calcNights(booking.check_in, booking.check_out)\n    21→\n    22→  return (\n    23→    <div data-testid=\"property-booking-context\" className=\"flex gap-4 rounded-xl border border-border\">\n    24→      <div className=\"w-40 h-32 shrink-0 overflow-hidden rounded-l-xl\">\n    25→        {booking.property_image ? (\n    26→          <img\n    27→            src={booking.property_image}\n    28→            alt={booking.property_title}\n    29→            className=\"w-full h-full object-cover\"\n    30→            data-testid=\"booking-context-image\"\n    31→          />\n    32→        ) : (\n    33→          <div className=\"w-full h-full bg-bg-secondary flex items-center justify-center text-text-secondary text-sm\">\n    34→            No image\n    35→          </div>\n    36→        )}\n    37→      </div>\n    38→\n    39→      <div className=\"flex-1 py-3 pr-4 flex flex-col justify-between min-w-0\">\n    40→        <div>\n    41→          <h3 className=\"font-semibold text-text text-lg\" data-testid=\"booking-context-title\">\n    42→            {booking.property_title}\n    43→          </h3>\n    44→          <p className=\"flex items-center gap-1 text-sm text-text-secondary mt-1\" data-testid=\"booking-context-location\">\n    45→            <MapPin size={14} />\n    46→            {booking.property_city}{booking.property_country ? `, ${booking.property_country}` : ''}\n    47→          </p>\n    48→        </div>\n    49→\n    50→        <div className=\"flex flex-wrap items-center gap-4 mt-2 text-sm text-text-secondary\">\n    51→          <span className=\"flex items-center gap-1\" data-testid=\"booking-context-dates\">\n    52→            <Calendar size={14} />\n    53→            {formatDate(booking.check_in)} – {formatDate(booking.check_out)} ({nights} {nights === 1 ? 'night' : 'nights'})\n    54→          </span>\n    55→          <span className=\"flex items-center gap-1\" data-testid=\"booking-context-guests\">\n    56→            <Users size={14} />\n    57→            {booking.num_guests} {booking.num_guests === 1 ? 'guest' : 'guests'}\n    58→          </span>\n    59→          <span className=\"font-semibold text-text\" data-testid=\"booking-context-price\">\n    60→            ${Number(booking.total_price).toLocaleString()}\n    61→          </span>\n    62→        </div>\n    63→      </div>\n    64→    </div>\n    65→  )\n    66→}\n    67→"}]},"parent_tool_use_id":"toolu_01BK4ifK4xonNBXiuUCX9VmH","session_id":"f9a10ac0-bbdf-4066-b957-0d7c86e1c5c4","uuid":"022b3d75-f6f2-47cb-ac57-a4c2e6327330"}
