[2026-03-14T21:22:16.820Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017vzbYDcTwVMBu4AvVgvX3j","type":"tool_result","content":"     1→import { useNavigate } from 'react-router-dom'\n     2→import { Calendar, MapPin } from 'lucide-react'\n     3→import type { Booking } from '../slices/bookingsSlice'\n     4→\n     5→interface TripCardProps {\n     6→  booking: Booking\n     7→  onCancel: () => void\n     8→}\n     9→\n    10→function formatDateRange(checkIn: string, checkOut: string): string {\n    11→  const opts: Intl.DateTimeFormatOptions = { month: 'short', day: 'numeric', year: 'numeric' }\n    12→  const inDate = new Date(checkIn.split('T')[0] + 'T12:00:00')\n    13→  const outDate = new Date(checkOut.split('T')[0] + 'T12:00:00')\n    14→  const inStr = inDate.toLocaleDateString('en-US', opts)\n    15→  const outStr = outDate.toLocaleDateString('en-US', opts)\n    16→  return `${inStr} – ${outStr}`\n    17→}\n    18→\n    19→const statusColors: Record<string, string> = {\n    20→  pending: 'bg-status-pending/15 text-status-pending',\n    21→  confirmed: 'bg-status-confirmed/15 text-status-confirmed',\n    22→  cancelled: 'bg-status-cancelled/15 text-status-cancelled',\n    23→  completed: 'bg-status-completed/15 text-status-completed',\n    24→}\n    25→\n    26→const statusLabels: Record<string, string> = {\n    27→  pending: 'Pending',\n    28→  confirmed: 'Confirmed',\n    29→  cancelled: 'Cancelled',\n    30→  completed: 'Completed',\n    31→}\n    32→\n    33→export default function TripCard({ booking, onCancel }: TripCardProps) {\n    34→  const navigate = useNavigate()\n    35→  const canCancel = booking.status === 'pending' || booking.status === 'confirmed'\n    36→  const canReview = booking.status === 'completed' && !booking.has_review\n    37→\n    38→  const handleCardClick = () => {\n    39→    navigate(`/properties/${booking.property_id}`)\n    40→  }\n    41→\n    42→  return (\n    43→    <div\n    44→      data-testid={`trip-card-${booking.id}`}\n    45→      className=\"flex gap-4 rounded-xl border border-border hover:shadow-md transition-shadow cursor-pointer\"\n    46→      onClick={handleCardClick}\n    47→    >\n    48→      <div className=\"w-40 h-32 shrink-0 overflow-hidden rounded-l-xl\">\n    49→        {booking.property_image ? (\n    50→          <img\n    51→            src={booking.property_image}\n    52→            alt={booking.property_title || 'Property'}\n    53→            className=\"w-full h-full object-cover\"\n    54→          />\n    55→        ) : (\n    56→          <div className=\"w-full h-full bg-bg-secondary flex items-center justify-center text-text-secondary text-sm\">\n    57→            No image\n    58→          </div>\n    59→        )}\n    60→      </div>\n    61→\n    62→      <div className=\"flex-1 py-3 pr-4 flex flex-col justify-between min-w-0\">\n    63→        <div>\n    64→          <div className=\"flex items-center justify-between gap-2\">\n    65→            <h3 className=\"font-semibold text-text truncate\">\n    66→              {booking.property_title || 'Untitled Property'}\n    67→            </h3>\n    68→            <span\n    69→              data-testid={`status-badge-${booking.id}`}\n    70→              className={`shrink-0 text-xs font-semibold px-2.5 py-1 rounded-full ${statusColors[booking.status] || ''}`}\n    71→            >\n    72→              {statusLabels[booking.status] || booking.status}\n    73→            </span>\n    74→          </div>\n    75→          {booking.property_city && (\n    76→            <p className=\"flex items-center gap-1 text-sm text-text-secondary mt-1\">\n    77→              <MapPin size={14} />\n    78→              {booking.property_city}\n    79→              {booking.property_country ? `, ${booking.property_country}` : ''}\n    80→            </p>\n    81→          )}\n    82→          <p className=\"flex items-center gap-1 text-sm text-text-secondary mt-1\">\n    83→            <Calendar size={14} />\n    84→            {formatDateRange(booking.check_in, booking.check_out)}\n    85→          </p>\n    86→        </div>\n    87→\n    88→        <div className=\"flex items-center justify-between mt-2\">\n    89→          <p className=\"text-sm font-semibold text-text\">\n    90→            ${Number(booking.total_price).toFixed(0)}\n    91→          </p>\n    92→          <div className=\"flex gap-2\" onClick={(e) => e.stopPropagation()}>\n    93→            {canCancel && (\n    94→              <button\n    95→                data-testid={`cancel-button-${booking.id}`}\n    96→                onClick={onCancel}\n    97→                className=\"text-xs font-medium px-3 py-1.5 rounded-lg border border-status-cancelled text-status-cancelled hover:bg-status-cancelled/10 transition-colors\"\n    98→              >\n    99→                Cancel\n   100→              </button>\n   101→            )}\n   102→            {canReview && (\n   103→              <button\n   104→                data-testid={`review-button-${booking.id}`}\n   105→                onClick={() => navigate(`/trips/${booking.id}/review`)}\n   106→                className=\"text-xs font-medium px-3 py-1.5 rounded-lg bg-primary text-white hover:bg-primary-dark transition-colors\"\n   107→              >\n   108→                Write Review\n   109→              </button>\n   110→            )}\n   111→            {booking.status === 'completed' && booking.has_review && (\n   112→              <span\n   113→                data-testid={`reviewed-badge-${booking.id}`}\n   114→                className=\"text-xs font-medium px-3 py-1.5 text-status-confirmed\"\n   115→              >\n   116→                Reviewed ✓\n   117→              </span>\n   118→            )}\n   119→          </div>\n   120→        </div>\n   121→      </div>\n   122→    </div>\n   123→  )\n   124→}\n   125→"}]},"parent_tool_use_id":"toolu_011SVqbtmZjNurFdjAqe1G7E","session_id":"f9a10ac0-bbdf-4066-b957-0d7c86e1c5c4","uuid":"f7450aae-65ad-4841-ae79-a48e9b6bab37"}
