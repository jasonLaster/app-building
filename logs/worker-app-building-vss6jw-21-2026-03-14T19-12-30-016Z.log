[2026-03-14T19:06:04.246Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014k2xBMQhLafe7sePE3hRRj","type":"tool_result","content":"     1→import { useState, useCallback } from 'react'\n     2→import { useSelector } from 'react-redux'\n     3→import { Navigate } from 'react-router-dom'\n     4→import type { RootState } from '../store'\n     5→import LoginForm from '../components/LoginForm'\n     6→import RegisterForm from '../components/RegisterForm'\n     7→import AuthToggle from '../components/AuthToggle'\n     8→\n     9→function Login() {\n    10→  const [mode, setMode] = useState<'login' | 'register'>('login')\n    11→  const currentUser = useSelector((state: RootState) => state.auth.currentUser)\n    12→\n    13→  const handleToggle = useCallback(() => {\n    14→    setMode((prev) => (prev === 'login' ? 'register' : 'login'))\n    15→  }, [])\n    16→\n    17→  if (currentUser) {\n    18→    return <Navigate to=\"/\" replace />\n    19→  }\n    20→\n    21→  return (\n    22→    <div className=\"min-h-screen flex items-center justify-center bg-bg-secondary p-6 max-sm:p-3\" data-testid=\"login-page\">\n    23→      <div className=\"w-full max-w-md bg-bg rounded-2xl shadow-lg p-8\">\n    24→        <div className=\"text-center mb-8\">\n    25→          <h1 className=\"text-2xl font-bold text-primary\" data-testid=\"login-title\">\n    26→            {mode === 'login' ? 'Welcome Back' : 'Create Account'}\n    27→          </h1>\n    28→          <p className=\"text-text-secondary mt-2\">\n    29→            {mode === 'login'\n    30→              ? 'Log in to continue to AirbnbClone'\n    31→              : 'Sign up to get started with AirbnbClone'}\n    32→          </p>\n    33→        </div>\n    34→\n    35→        {mode === 'login' ? <LoginForm key=\"login\" /> : <RegisterForm key=\"register\" />}\n    36→\n    37→        <AuthToggle mode={mode} onToggle={handleToggle} />\n    38→      </div>\n    39→    </div>\n    40→  )\n    41→}\n    42→\n    43→export default Login\n    44→"}]},"parent_tool_use_id":"toolu_017QGnMaBu6sGT8UjWWXH9TK","session_id":"11df892d-2feb-4cba-a8ae-217c7a739ed7","uuid":"ae9b43ef-fc33-4c2f-94b1-68b51d80723e"}
