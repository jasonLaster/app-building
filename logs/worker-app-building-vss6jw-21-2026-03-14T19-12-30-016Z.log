e\">{property.title}</h3>\n          {reviewCount > 0 ? (\n            <div className=\"flex items-center gap-1 shrink-0 ml-2\">\n              <Star size={14} className=\"fill-text text-text\" />\n              <span className=\"text-sm font-medium text-text\">{rating.toFixed(1)}</span>\n              <span className=\"text-sm text-text-secondary\">({reviewCount})</span>\n            </div>\n          ) : (\n            <span className=\"text-sm text-text-secondary shrink-0 ml-2\">New</span>\n          )}\n        </div>\n        <p className=\"text-text-secondary text-sm mt-0.5\">\n          {property.city}, {property.country}\n        </p>\n        <p className=\"mt-1 text-sm\">\n          <span className=\"font-semibold text-text\">${Number(property.price_per_night).toFixed(0)}</span>\n          <span className=\"text-text-secondary\"> / night</span>\n        </p>\n      </div>\n    </div>\n  )\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":428,"cache_read_input_tokens":61994,"cache_creation":{"ephemeral_5m_input_tokens":428,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard","inference_geo":"global"},"context_management":null},"parent_tool_use_id":null,"session_id":"11df892d-2feb-4cba-a8ae-217c7a739ed7","uuid":"7ed6c9db-eca0-4ba1-9329-2bd68476e39b"}
