&& propertyId) {\n    // GET /api/properties/:id - Get single property with details\n    const result = await sql`\n      SELECT p.*,\n        u.name as host_name, u.avatar_url as host_avatar, u.bio as host_bio, u.created_at as host_since,\n        (SELECT count(*)::int FROM properties WHERE host_id = p.host_id AND is_active = true) as host_listing_count\n      FROM properties p\n      JOIN users u ON u.id = p.host_id\n      WHERE p.id = ${propertyId}\n    `\n    const property = result[0]\n    if (!property) {\n      return new Response(JSON.stringify({ error: 'Property not found' }), { status: 404, headers })\n    }\n\n    const images = await sql`\n      SELECT * FROM property_images WHERE property_id = ${propertyId} ORDER BY display_order ASC\n    `\n\n    const amenities = await sql`\n      SELECT a.* FROM amenities a\n      JOIN property_amenities pa ON pa.amenity_id = a.id\n      WHERE pa.property_id = ${propertyId}\n      ORDER BY a.category, a.name\n    `\n\n    const reviews = await sql`\n      SELECT r.*, u.name as guest_name, u.avatar_url as guest_avatar\n      FROM reviews r\n      JOIN users u ON u.id = r.guest_id\n      WHERE r.property_id = ${propertyId}\n      ORDER BY r.created_at DESC\n    `\n\n    return new Response(JSON.stringify({ ...property, images, amenities, reviews }), { status: 200, headers })\n  }\n\n  if (request.method === 'GET') {\n    // GET /api/properties - List with search/filter\n    const city = url.searchParams.get('city') || ''\n    const checkIn = url.searchParams.get('check_in') || ''\n    const checkOut = url.searchParams.get('check_out') || ''\n    const guests = url.searchParams.get('guests') || ''\n    const propertyType = url.searchParams.get('property_type') || ''\n    const minPrice = url.searchParams.get('min_price') || ''\n    const maxPrice = url.searchParams.get('max_price') || ''\n    const minBedrooms = url.searchParams.get('min_bedrooms') || ''\n    const minBeds = url.searchParams.get('min_beds') || ''\n    const minBathrooms = url.searchParams.get('min_bathrooms') || ''\n    const amenitiesParam = url.searchParams.get('amenities') || ''\n    const page = parseInt(url.searchParams.get('page') || '1', 10)\n    const limit = parseInt(url.searchParams.get('limit') || '12', 10)\n    const offset = (page - 1) * limit\n\n    // Build dynamic WHERE conditions\n    const conditions: string[] = ['p.is_active = true']\n    const values: unknown[] = []\n    let paramIndex = 1\n\n    if (city) {\n      conditions.push(`LOWER(p.city) LIKE LOWER($${paramIndex})`)\n      values.push(`%${city}%`)\n      paramIndex++\n    }\n    if (guests) {\n      conditions.push(`p.max_guests >= $${paramIndex}`)\n      values.push(parseInt(guests, 10))\n      paramIndex++\n    }\n    if (propertyType) {\n      conditions.push(`p.property_type = $${paramIndex}`)\n      values.push(propertyType)\n      paramIndex++\n    }\n    if (minPrice) {\n      conditions.push(`p.price_per_night >= $${paramIndex}`)\n      values.push(parseFloat(minPrice))\n      paramIndex++\n    }\n    if (maxPrice) {\n      conditions.push(`p.price_per_night <= $${paramIndex}`)\n      values.push(parseFloat(maxPrice))\n      paramIndex++\n    }\n    if (minBedrooms) {\n      conditions.push(`p.bedrooms >= $${paramIndex}`)\n      values.push(parseInt(minBedrooms, 10))\n      paramIndex++\n    }\n    if (minBeds) {\n      conditions.push(`p.beds >= $${paramIndex}`)\n      values.push(parseInt(minBeds, 10))\n      paramIndex++\n    }\n    if (minBathrooms) {\n      conditions.push(`p.bathrooms >= $${paramIndex}`)\n      values.push(parseInt(minBathrooms, 10))\n      paramIndex++\n    }\n    if (checkIn && checkOut) {\n      conditions.push(`NOT EXISTS (\n        SELECT 1 FROM bookings b\n        WHERE b.property_id = p.id\n        AND b.status IN ('confirmed', 'pending')\n        AND b.check_in < $${paramIndex + 1}\n        AND b.check_out > $${paramIndex}\n      )`)\n      values.push(checkIn, checkOut)\n      paramIndex += 2\n    }\n\n    const amenityIds = amenitiesParam ? amenitiesParam.split(',').filter(Boolean) : []\n    if (amenityIds.length > 0) {\n      conditions.push(`(\n        SELECT count(*) FROM property_amenities pa\n        WHERE pa.property_id = p.id AND pa.amenity_id = ANY($${paramIndex}::uuid[])\n      ) >= $${paramIndex + 1}`)\n      values.push(amenityIds, amenityIds.length)\n      paramIndex += 2\n    }\n\n    const whereClause = conditions.join(' AND ')\n\n    // Use tagged template for simple query, but we need dynamic params here\n    // Build the query with tagged template fragments\n    const countQuery = `SELECT count(*)::int as total FROM properties p WHERE ${whereClause}`\n    const dataQuery = `SELECT p.*,\n      (SELECT url FROM property_images pi WHERE pi.property_id = p.id ORDER BY pi.display_order ASC LIMIT 1) as main_image,\n      (SELECT COALESCE(AVG(r.rating), 0) FROM reviews r WHERE r.property_id = p.id) as avg_rating,\n      (SELECT count(*)::int FROM reviews r WHERE r.property_id = p.id) as review_count\n      FROM properties p\n      WHERE ${whereClause}\n      ORDER BY p.created_at DESC\n      LIMIT $${paramIndex} OFFSET $${paramIndex + 1}`\n\n    values.push(limit, offset)\n\n    // Use sql.query for dynamic queries\n    const countResult = await sql(countQuery, values.slice(0, -2))\n    const countRow = countResult[0]\n    const total = countRow ? (countRow as Record<string, unknown>).total as number : 0\n\n    const properties = await sql(dataQuery, values)\n\n    return new Response(JSON.stringify({\n      properties,\n      total,\n      page,\n      limit,\n      totalPages: Math.ceil(total / limit),\n    }), { status: 200, headers })\n  }\n\n  return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers })\n}\n"}}
