kOutside);\n    39→    }\n    40→    return () => document.removeEventListener('mousedown', handleClickOutside);\n    41→  }, [openDropdown]);\n    42→\n    43→  function toggleDropdown(type: DropdownType) {\n    44→    setOpenDropdown(openDropdown === type ? null : type);\n    45→  }\n    46→\n    47→  const currentGroupLabel = GROUP_OPTIONS.find((o) => o.value === groupBy)?.label || 'Status';\n    48→  const currentSortLabel = SORT_OPTIONS.find((o) => o.value === sortBy)?.label || 'Priority';\n    49→\n    50→  return (\n    51→    <div className=\"group-by-sort\" ref={containerRef} data-testid=\"group-by-sort\">\n    52→      <div className=\"group-by-sort-control\">\n    53→        <button\n    54→          className=\"group-by-sort-btn\"\n    55→          onClick={() => toggleDropdown('group')}\n    56→          data-testid=\"group-by-btn\"\n    57→        >\n    58→          <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n    59→            <line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\" />\n    60→            <line x1=\"3\" y1=\"12\" x2=\"15\" y2=\"12\" />\n    61→            <line x1=\"3\" y1=\"18\" x2=\"9\" y2=\"18\" />\n    62→          </svg>\n    63→          Group: {currentGroupLabel}\n    64→        </button>\n    65→        {openDropdown === 'group' && (\n    66→          <div className=\"group-by-sort-dropdown\" data-testid=\"group-by-dropdown\">\n    67→            {GROUP_OPTIONS.map((opt) => (\n    68→              <button\n    69→                key={opt.value}\n    70→                className={`group-by-sort-option ${groupBy === opt.value ? 'group-by-sort-option-active' : ''}`}\n    71→                onClick={() => {\n    72→                  dispatch(setGroupBy(opt.value));\n    73→                  setOpenDropdown(null);\n    74→                }}\n    75→                data-testid={`group-by-option-${opt.value}`}\n    76→              >\n    77→                {opt.label}\n    78→                {groupBy === opt.value && (\n    79→                  <svg width=\"12\" height=\"12\" viewBox=\"0 0 10 10\" fill=\"none\">\n    80→                    <path d=\"M2 5l2 2 4-4\" stroke=\"currentColor\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n    81→                  </svg>\n    82→                )}\n    83→              </button>\n    84→            ))}\n    85→          </div>\n    86→        )}\n    87→      </div>\n    88→\n    89→      <div className=\"group-by-sort-control\">\n    90→        <button\n    91→          className=\"group-by-sort-btn\"\n    92→          onClick={() => toggleDropdown('sort')}\n    93→          data-testid=\"sort-by-btn\"\n    94→        >\n    95→          <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n    96→            <polyline points=\"3 6 9 6\" />\n    97→            <polyline points=\"3 12 15 12\" />\n    98→            <polyline points=\"3 18 21 18\" />\n    99→          </svg>\n   100→          Sort: {currentSortLabel}\n   101→        </button>\n   102→        {openDropdown === 'sort' && (\n   103→          <div className=\"group-by-sort-dropdown\" data-testid=\"sort-by-dropdown\">\n   104→            {SORT_OPTIONS.map((opt) => (\n   105→              <button\n   106→                key={opt.value}\n   107→                className={`group-by-sort-option ${sortBy === opt.value ? 'group-by-sort-option-active' : ''}`}\n   108→                onClick={() => {\n   109→                  dispatch(setSortBy(opt.value));\n   110→                  setOpenDropdown(null);\n   111→                }}\n   112→                data-testid={`sort-by-option-${opt.value}`}\n   113→              >\n   114→                {opt.label}\n   115→                {sortBy === opt.value && (\n   116→                  <svg width=\"12\" height=\"12\"