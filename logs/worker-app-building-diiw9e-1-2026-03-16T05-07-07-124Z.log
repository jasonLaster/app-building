[2026-03-16T04:56:08.275Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016YD9WZeBpAVTVPzQi7KePg","type":"tool_result","content":"     1→import { useState, useEffect, useRef, useCallback } from 'react';\n     2→import { useSelector } from 'react-redux';\n     3→import type { RootState } from '../store';\n     4→import { StatusIcon, PriorityIcon, STATUS_CONFIG, STATUS_ORDER } from './IssueRow';\n     5→import './CreateIssueForm.css';\n     6→\n     7→const PRIORITY_ORDER = ['urgent', 'high', 'medium', 'low', 'none'] as const;\n     8→const PRIORITY_LABELS: Record<string, string> = {\n     9→  urgent: 'Urgent',\n    10→  high: 'High',\n    11→  medium: 'Medium',\n    12→  low: 'Low',\n    13→  none: 'No Priority',\n    14→};\n    15→\n    16→interface SearchableIssue {\n    17→  id: string;\n    18→  title: string;\n    19→  identifier: string;\n    20→}\n    21→\n    22→export interface CreateIssueFormData {\n    23→  teamId: string;\n    24→  title: string;\n    25→  description: string;\n    26→  status: string;\n    27→  priority: string;\n    28→  assigneeId: string | null;\n    29→  labelIds: string[];\n    30→  projectId: string | null;\n    31→  cycleId: string | null;\n    32→  dueDate: string | null;\n    33→  parentId: string | null;\n    34→}\n    35→\n    36→interface CreateIssueFormProps {\n    37→  defaultTeamId?: string;\n    38→  formData: CreateIssueFormData;\n    39→  onFormChange: (data: CreateIssueFormData) => void;\n    40→  titleError: string | null;\n    41→}\n    42→\n    43→type DropdownType = 'team' | 'status' | 'priority' | 'assignee' | 'labels' | 'project' | 'cycle' | 'parent' | null;\n    44→\n    45→export default function CreateIssueForm({ defaultTeamId, formData, onFormChange, titleError }: CreateIssueFormProps) {\n    46→  const { items: teams } = useSelector((state: RootState) => state.teams);\n    47→  const { items: labels } = useSelector((state: RootState) => state.labels);\n    48→  const token = useSelector((state: RootState) => state.auth.token);\n    49→\n    50→  const [openDropdown, setOpenDropdown] = useState<DropdownType>(null);\n    51→  const [assigneeSearch, setAssigneeSearch] = useState('');\n    52→  const [projectSearch, setProjectSearch] = useState('');\n    53→  const [parentSearch, setParentSearch] = useState('');\n    54→  const [parentResults, setParentResults] = useState<SearchableIssue[]>([]);\n    55→\n    56→  // Team-specific data (members, projects, cycles)\n    57→  const [teamMembers, setTeamMembers] = useState<Array<{ id: string; name: string; email: string }>>([]);\n    58→  const [teamProjects, setTeamProjects] = useState<Array<{ id: string; name: string }>>([]);\n    59→  const [teamCycles, setTeamCycles] = useState<Array<{ id: string; name: string; start_date: string; end_date: string }>>([]);\n    60→\n    61→  const formRef = useRef<HTMLDivElement>(null);\n    62→  const titleRef = useRef<HTMLInputElement>(null);\n    63→\n    64→  // Focus title on mount\n    65→  useEffect(() => {\n    66→    titleRef.current?.focus();\n    67→  }, []);\n    68→\n    69→  // Set default team\n    70→  useEffect(() => {\n    71→    if (defaultTeamId && !formData.teamId) {\n    72→      onFormChange({ ...formData, teamId: defaultTeamId });\n    73→    } else if (!formData.teamId && teams.length > 0 && teams[0]) {\n    74→      onFormChange({ ...formData, teamId: teams[0].id });\n    75→    }\n    76→  }, [defaultTeamId, teams]); // eslint-disable-line react-hooks/exhaustive-deps\n    77→\n    78→  // Fetch team-specific data when team changes\n    79→  const fetchTeamData = useCallback(async (teamId: string) => {\n    80→    if (!token || !teamId) return;\n    81→    try {\n    82→      const response = await fetch(`/api/team-issues?teamId=${teamId}`, {\n    83→        headers: { Authorization: `Bearer ${token}` },\n    84→      });\n    85→      if (response.ok) {\n    86→        const data = await response.json();\n    87→        setTeamMembers(data.members || []);\n    88→        setTeamProjects(data.projects || []);\n    89→        setTeamCycles(data.cycles || []);\n    90→      }\n    91→    } catch {\n    92→      // silently fail\n    93→    }\n    94→  }, [token]);\n    95→\n    96→  useEffect(() => {\n    97→    if (formData.teamId) {\n    98→      fetchTeamData(formData.teamId);\n    99→    }\n   100→  }, [formData.teamId, fetchTeamData]);"}]},"parent_tool_use_id":"toolu_019oGdiL6UYYYLYmWWxfECTi","session_id":"ab2ea44b-562c-4be4-8098-792368c383b9","uuid":"a5ce057f-def8-44fe-afd9-76b44ae852de"}
