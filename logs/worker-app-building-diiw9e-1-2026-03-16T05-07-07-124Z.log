a-testid={`workspace-default-team-option-${team.id}`}\n                  >\n                    {team.name}\n                  </button>\n                ))}\n              </div>\n            )}\n          </div>\n        </div>\n      </div>\n\n      <div className=\"ws-actions\">\n        <button\n          className=\"ws-save-btn\"\n          onClick={handleSave}\n          disabled={saving}\n          data-testid=\"workspace-settings-save-btn\"\n        >\n          {saving ? 'Saving...' : 'Save'}\n        </button>\n        {successMessage && (\n          <span className=\"ws-success\" data-testid=\"workspace-settings-success\">{successMessage}</span>\n        )}\n      </div>\n    </div>\n  );\n}\n","structuredPatch":[{"oldStart":143,"oldLines":6,"newStart":143,"newLines":7,"lines":["                   </button>","                 ))}","               </div>","+              </>","             )}","           </div>","         </div>"]}],"userModified":false,"replaceAll":false}}
