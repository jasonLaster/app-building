iary);\n   150→}\n   151→\n   152→.cif-search-input:focus {\n   153→  border-color: var(--color-accent);\n   154→}\n   155→\n   156→.cif-dropdown-option {\n   157→  display: flex;\n   158→  align-items: center;\n   159→  gap: 8px;\n   160→  width: 100%;\n   161→  padding: 6px 8px;\n   162→  border: none;\n   163→  background: none;\n   164→  color: var(--color-text-secondary);\n   165→  font-size: 13px;\n   166→  cursor: pointer;\n   167→  border-radius: 4px;\n   168→  transition: background-color 150ms ease, color 150ms ease;\n   169→  text-align: left;\n   170→}\n   171→\n   172→.cif-dropdown-option:hover {\n   173→  background-color: var(--color-bg-hover);\n   174→  color: var(--color-text-primary);\n   175→}\n   176→\n   177→.cif-dropdown-option-active {\n   178→  background-color: var(--color-bg-hover);\n   179→  color: var(--color-text-primary);\n   180→}\n   181→\n   182→.cif-dropdown-empty {\n   183→  padding: 8px 12px;\n   184→  color: var(--color-text-tertiary);\n   185→  font-size: 12px;\n   186→}\n   187→\n   188→.cif-avatar {\n   189→  width: 22px;\n   190→  height: 22px;\n   191→  border-radius: 50%;\n   192→  background-color: var(--color-accent);\n   193→  color: #fff;\n   194→  font-size: 9px;\n   195→  font-weight: 600;\n   196→  display: flex;\n   197→  align-items: center;\n   198→  justify-content: center;\n   199→  flex-shrink: 0;\n   200→}\n   201→\n   202→.cif-avatar-empty {\n   203→  background-color: var(--color-border);\n   204→  color: var(--color-text-tertiary);\n   205→}\n   206→\n   207→.cif-selected-labels {\n   208→  display: flex;\n   209→  flex-wrap: wrap;\n   210→  gap: 6px;\n   211→}\n   212→\n   213→.cif-label-badge {\n   214→  display: inline-flex;\n   215→  align-items: center;\n   216→  gap: 4px;\n   217→  padding: 2px 8px;\n   218→  border: 1px solid;\n   219→  border-radius: 12px;\n   220→  font-size: 12px;\n   221→  color: var(--color-text-secondary);\n   222→  background: transparent;\n   223→}\n   224→\n   225→.cif-label