bels.length}</span>\n   209→          )}\n   210→        </button>\n   211→        {openDropdown === 'label' && (\n   212→          <div className=\"team-filters-dropdown\" data-testid=\"team-filter-dropdown-label\">\n   213→            {labels.map((label) => {\n   214→              const checked = selectedLabels.includes(label.id);\n   215→              return (\n   216→                <button\n   217→                  key={label.id}\n   218→                  className={`team-filters-option ${checked ? 'team-filters-option-checked' : ''}`}\n   219→                  onClick={() => toggleItem(selectedLabels, label.id, onLabelChange)}\n   220→                  data-testid={`team-filter-option-label-${label.id}`}\n   221→                >\n   222→                  <span className=\"team-filters-checkbox\">{checked && <CheckIcon />}</span>\n   223→                  <span className=\"team-filters-label-dot\" style={{ backgroundColor: label.color }} />\n   224→                  <span>{label.name}</span>\n   225→                </button>\n   226→              );\n   227→            })}\n   228→            {labels.length === 0 && (\n   229→              <div className=\"team-filters-empty\">No labels available</div>\n   230→            )}\n   231→          </div>\n   232→        )}\n   233→      </div>\n   234→\n   235→      {/* Project Filter */}\n   236→      <div className=\"team-filters-filter\">\n   237→        <button\n   238→          className={`team-filters-btn ${selectedProjects.length > 0 ? 'team-filters-btn-active' : ''}`}\n   239→          onClick={() => toggleDropdown('project')}\n   240→          data-testid=\"team-filter-btn-project\"\n   241→        >\n   242→          Project\n   243→          {selectedProjects.length > 0 && (\n   244→            <span className=\"team-filters-badge\" data-testid=\"team-filter-badge-project\">{selectedProjects.length}</span>\n   245→          )}\n   246→        </button>\n   247→        {openDropdown === 'project' && (\n   248→          <div className=\"team-filters-dropdown\" data-testid=\"team-filter-dropdown-project\">\n   249→            <button\n   250→              className={`team-filters-option ${selectedProjects.includes('none') ? 'team-filters-option-checked' : ''}`}\n   251→              onClick={() => toggleItem(selectedProjects, 'none', onProjectChange)}\n   252→              data-testid=\"team-filter-option-project-none\"\n   253→            >\n   254→              <span className=\"team-filters-checkbox\">\n   255→                {selectedProjects.includes('none') && <CheckIcon />}\n   256→              </span>\n   257→              <span>No Project</span>\n   258→            </button>\n   259→            {projects.map((p) => {\n   260→              const checked = selectedProjects.includes(p.id);\n   261→              return (\n   262→                <button\n   263→                  key={p.id}\n   264→                  className={`team-filters-option ${checked ? 'team-filters-option-checked' : ''}`}\n   265→                  onClick={() => toggleItem(selectedProjects, p.id, onProjectChange)}\n   266→                  data-testid={`team-filter-option-project-${p.id}`}\n   267→                >\n   268→                  <span className=\"team-filters-checkbox\">{checked && <CheckIcon />}</span>\n   269→                  <span>{p.name}</span>\n   270→                </button>\n   271→              );\n   272→            })}\n   273→          </div>\n   274→        )}\n   275→      </div>\n   276→\n   277→      {/* Cycle Filter */}\n   278→      <div className=\"team-filters-filter\">\n   279→        <button\n   280→          className={`team-filters-btn ${selectedCycles.length > 0 ? 'team-filters-btn-active' : ''}`}\n   281→          onClick={() => toggleDropdown('cycle')}\n   282→          data-testid=\"team-filter-btn-cycle\"\n   283→        >\n   284→          Cycle\n   285→          {selectedCycles.length > 0 && (\n   286→            <span className=\"team-filters-badge\" data-testid=\"team-filter-badge-cycle\">{selectedCycles.length}</span>\n   287→          )}\n   288→        </button>\n   289→        {openDropdown === 'cycle' && (\n   290→          <div className=\"team-filters-dropdown\" data-testid=\"team-filter-dropdown-cycle\">\n   291→            <button\n   292→              className={`team-filters-option ${selectedCycles.includes('none') ? 'team-filters-option-checked' : ''}`}\n   293→              onClick={() => toggleItem(selectedCycles, 'none', onCycleChange)}\n   294→              data-testid=\"team-filter-option-cycle-none\"\n   295→            >\n   296→              <span className=\"team-filters-checkbox\">\n   297→                {selectedCycles.includes('none') && <CheckIcon />}\n   298→              </span>\n   299→              <span>No Cycle</span>\n   300→            </button>\n   301→            {cycles.map((c) => {\n   302→              const checked = selectedCycles.includes(c.id);\n   303→              return (\n   304→                <button\n   305→                  key={c.id}\n   306→                  className={`team-filters-option ${checked ? 'team-filters-option-checked' : ''}`}\n   307→                  onClick={() => toggleItem(selectedCycles, c.id, onCycleChange)}\n   308→                  data-testid={`team-filter-option-cycle-${c.id}`}\n   309→                >\n   310→                  <span className=\"team-filters-checkbox\">{checked && <CheckIcon />}</span>\n   311→                  <span>{c.name}</span>\n   312→                </button>\n   313→              );\n   314→            })}\n   315→          </div>\n   316→        )}\n   317→      </div>\n   318→    </div>\n   319→  );\n   320→}\n   321→"}]},"parent_tool_use_id":"toolu_019oGdiL6UYYYLYmWWxfECTi","session_id":"ab2ea44b-562c-4be4-8098-792368c383b9","uuid":"0acd499c-cb42-4fa9-8a0f-ec66056e324a"}
