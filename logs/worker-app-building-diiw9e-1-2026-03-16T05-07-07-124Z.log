n   191→        <label className=\"sidebar-label\">Assignee</label>\n   192→        <div className=\"sidebar-dropdown-wrapper\">\n   193→          <button\n   194→            className=\"sidebar-select-btn\"\n   195→            onClick={() => toggleDropdown('assignee')}\n   196→            data-testid=\"sidebar-assignee-btn\"\n   197→          >\n   198→            {issue.assigneeName ? (\n   199→              <>\n   200→                <span className=\"sidebar-avatar\">{getInitials(issue.assigneeName)}</span>\n   201→                <span>{issue.assigneeName}</span>\n   202→              </>\n   203→            ) : (\n   204→              <span className=\"sidebar-placeholder\">No assignee</span>\n   205→            )}\n   206→          </button>\n   207→          {openDropdown === 'assignee' && (\n   208→            <div className=\"sidebar-dropdown sidebar-dropdown-searchable\" data-testid=\"sidebar-assignee-dropdown\">\n   209→              <input\n   210→                className=\"sidebar-search-input\"\n   211→                placeholder=\"Search members...\"\n   212→                value={assigneeSearch}\n   213→                onChange={(e) => setAssigneeSearch(e.target.value)}\n   214→                autoFocus\n   215→                data-testid=\"sidebar-assignee-search\"\n   216→              />\n   217→              <button\n   218→                className=\"sidebar-dropdown-option\"\n   219→                onClick={() => handleAssigneeChange(null)}\n   220→                data-testid=\"sidebar-assignee-option-none\"\n   221→              >\n   222→                <span className=\"sidebar-avatar sidebar-avatar-empty\">?</span>\n   223→                <span>Unassign</span>\n   224→              </button>\n   225→              {filteredMembers.map((m) => (\n   226→                <button\n   227→                  key={m.id}\n   228→                  className={`sidebar-dropdown-option ${issue.assigneeId === m.id ? 'sidebar-dropdown-option-active' : ''}