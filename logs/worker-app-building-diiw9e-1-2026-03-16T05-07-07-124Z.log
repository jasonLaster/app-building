\n    49→  onPriorityChange,\n    50→  onAssigneeChange,\n    51→  onLabelChange,\n    52→  onProjectChange,\n    53→  onCycleChange,\n    54→}: TeamFiltersProps) {\n    55→  const { members, projects, cycles } = useSelector((state: RootState) => state.teamIssues);\n    56→  const { items: labels } = useSelector((state: RootState) => state.labels);\n    57→  const [openDropdown, setOpenDropdown] = useState<DropdownType>(null);\n    58→  const toolbarRef = useRef<HTMLDivElement>(null);\n    59→\n    60→  useEffect(() => {\n    61→    function handleClickOutside(e: MouseEvent) {\n    62→      if (toolbarRef.current && !toolbarRef.current.contains(e.target as Node)) {\n    63→        setOpenDropdown(null);\n    64→      }\n    65→    }\n    66→    if (openDropdown) {\n    67→      document.addEventListener('mousedown', handleClickOutside);\n    68→    }\n    69→    return () => document.removeEventListener('mousedown', handleClickOutside);\n    70→  }, [openDropdown]);\n    71→\n    72→  function toggleDropdown(type: DropdownType) {\n    73→    setOpenDropdown(openDropdown === type ? null : type);\n    74→  }\n    75→\n    76→  function toggleItem(list: string[], item: string, setter: (v: string[]) => void) {\n    77→    if (list.includes(item)) {\n    78→      setter(list.filter((i) => i !== item));\n    79→    } else {\n    80→      setter([...list, item]);\n    81→    }\n    82→  }\n    83→\n    84→  return (\n    85→    <div className=\"team-filters\" ref={toolbarRef} data-testid=\"team-filters-toolbar\">\n    86→      {/* Status Filter */}\n    87→      <div className=\"team-filters-filter\">\n    88→        <button\n    89→          className={`team-filters-btn ${selectedStatuses.length > 0 ? 'team-filters-btn-active' : ''}`}\n    90→          onClick={() => toggleDropdown('status')}\n    91→          data-testid=\"team-filter-btn-status\"\n    92→        >\n    93→          Status\n    94→          {selectedStatuses.length > 0 && (\n    95→            <span className=\"team-filters-badge\" data-testid=\"team-filter-badge-status\">{selectedStatuses.length}</span>\n    96→          )}\n    97→        </button>\n    98→        {openDropdown === 'status' && (\n    99→          <div className=\"team-filters-dropdown\" data-testid=\"team-filter-dropdown-status\">\n   100→            {STATUS_ORDER.map((s) => {\n   101→              const cfg = STATUS_CONFIG[s];\n   102→              const checked = selectedStatuses.includes(s);\n   103→              return (\n   104→                <button\n   105→                  key={s}\n   106→                  className={`team-filters-option ${checked ? 'team-filters-option-checked' : ''}`}\n   107→                  onClick={() => toggleItem(selectedStatuses, s, onStatusChange)}\n   108→                  data-testid={`team-filter-option-status-${s}`}\n   109→                >\n   110→                  <span className=\"team-filters-checkbox\">{checked && <CheckIcon />}</span>\n   111→                  <StatusIcon status={s} color={cfg.color} />\n   112→                  <span>{cfg.label}</span>\n   113→                </button>\n   114→              );\n   115→            })}\n   116→          </div>\n   117→        )}\n   118→      </div>\n   119→\n   120→      {/* Priority Filter */}\n   121→      <div className=\"team-filters-filter\">\n   122→        <button\n   123→          className={`team-filters-btn ${selectedPriorities.length > 0 ? 'team-filters-btn-active' : ''}`}\n   124→          onClick={() => toggleDropdown('priority')}\n   125→          data-testid=\"team-filter-btn-priority\"\n   126→        >\n   127→          Priority\n   128→          {selectedPriorities.length > 0 && (\n   129→            <span className=\"team-filters-badge\" data-testid=\"team-filter-badge-priority\">{selectedPriorities.length}</span>\n   130→          )}\n   131→        </button>\n   132→        {openDropdown === 'priority' && (\n   133→          <div className=\"team-filters-dropdown\" data-testid=\"team-filter-dropdown-priority\">\n   134→            {PRIORITY_ORDER.map((p) => {\n   135→              const checked = selectedPriorities.includes(p);\n   136→              return (\n   137→                <button\n   138→                  key={p}\n   139→                  className={`team-filters-option ${checked ? 'team-filters-option-checked' : ''}`}\n   140→                  onClick={() => toggleItem(selectedPriorities, p, onPriorityChange)}\n   141→                  data-testid={`team-filter-option-priority-${p}`}\n   142→                >\n   143→                  <span className=\"team-filters-checkbox\">{checked && <CheckIcon />}</span>\n   144→                  <PriorityIcon priority={p} />\n   145→                  <span>{PRIORITY_LABELS[p]}</span>\n   146→                </button>\n   147→              );\n   148→            })}\n   149→          </div>\n   150→        )}\n   151→      </div>\n   152→\n   153→      {/* Assignee Filter */}\n   154→      <div className=\"team-filters-filter\">\n   155→        <button\n   156→          className={`team-filters-btn ${selectedAssignees.length > 0 ? 'team-filters-btn-active' : ''}`}\n   157→          onClick={() => toggleDropdown('assignee')}\n   158→          data-testid=\"team-filter-btn-assignee\"\n   159→        >\n   160→          Assignee\n   161→          {selectedAssignees.length > 0 && (\n   162→            <span className=\"team-filters-badge\" data-testid=\"team-filter-badge-assignee\">{selectedAssignees.length}</span>\n   163→          )}\n   164→        </button>\n   165→        {openDropdown === 'assignee' && (\n   166→          <div className=\"team-filters-dropdown\" data-testid=\"team-filter-dropdown-assignee\">\n   167→            <button\n   168→              className={`team-filters-option ${selectedAssignees.includes('unassigned') ? 'team-filters-option-checked' : ''}`}\n   169→              onClick={() => toggleItem(selectedAssignees, 'unassigned', onAssigneeChange)}\n   170→             