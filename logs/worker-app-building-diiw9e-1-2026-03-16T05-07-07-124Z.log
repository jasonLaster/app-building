kground-color: var(--color-accent);\n  color: #fff;\n  font-size: 9px;\n  font-weight: 600;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n\n.cif-avatar-empty {\n  background-color: var(--color-border);\n  color: var(--color-text-tertiary);\n}\n\n.cif-selected-labels {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n}\n\n.cif-label-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  padding: 2px 8px;\n  border: 1px solid;\n  border-radius: 12px;\n  font-size: 12px;\n  color: var(--color-text-secondary);\n  background: transparent;\n}\n\n.cif-label-dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  flex-shrink: 0;\n}\n\n.cif-label-remove {\n  border: none;\n  background: none;\n  color: var(--color-text-tertiary);\n  cursor: pointer;\n  font-size: 14px;\n  padding: 0 0 0 2px;\n  line-height: 1;\n}\n\n.cif-label-remove:hover {\n  color: var(--color-text-primary);\n}\n\n.cif-check {\n  margin-left: auto;\n  flex-shrink: 0;\n}\n\n.cif-active-badge {\n  margin-left: auto;\n  font-size: 10px;\n  font-weight: 600;\n  color: var(--color-accent);\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.cif-date-wrapper {\n  position: relative;\n}\n\n.cif-date-input {\n  width: 100%;\n  padding: 8px 12px;\n  border: 1px solid var(--color-border);\n  border-radius: 6px;\n  background: var(--color-bg-surface);\n  color: var(--color-text-primary);\n  font-size: 13px;\n  outline: none;\n  box-sizing: border-box;\n  color-scheme: dark;\n}\n\n.cif-date-input:focus {\n  border-color: var(--color-accent);\n}\n\n.cif-date-display {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-top: 4px;\n  font-size: 13px;\n  color: var(--color-text-primary);\n}\n\n.cif-date-clear {\n  border: none;\n  background: none;\n  color: var(--color-text-tertiary);\n  cursor: pointer;\n  font-size: 16px;\n  padding: 0;\n  line-height: 1;\n}\n\n.cif-date-clear:hover {\n  color: var(--color-text-primary);