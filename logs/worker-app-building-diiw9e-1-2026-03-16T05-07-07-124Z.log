dleDateChange(e: React.ChangeEvent<HTMLInputElement>) {\n   148→    const val = e.target.value || null;\n   149→    dispatch(updateProjectField({ projectId: project.id, field: 'targetDate', value: val }));\n   150→    setEditingDate(false);\n   151→  }\n   152→\n   153→  function handleClearDate() {\n   154→    dispatch(updateProjectField({ projectId: project.id, field: 'targetDate', value: null }));\n   155→    setEditingDate(false);\n   156→  }\n   157→\n   158→  // Lead handlers\n   159→  function handleLeadChange(memberId: string | null) {\n   160→    dispatch(updateProjectField({ projectId: project.id, field: 'leadId', value: memberId }));\n   161→    setLeadDropdownOpen(false);\n   162→    setLeadSearch('');\n   163→  }\n   164→\n   165→  const filteredMembers = members.filter((m) =>\n   166→    m.name.toLowerCase().includes(leadSearch.toLowerCase()) ||\n   167→    m.email.toLowerCase().includes(leadSearch.toLowerCase())\n   168→  );\n   169→\n   170→  const statusCfg = PROJECT_STATUS_CONFIG[project.status] || PROJECT_STATUS_CONFIG.planned;\n   171→  const percentage = project.totalIssues > 0\n   172→    ? Math.round((project.completedIssues / project.totalIssues) * 100)\n   173→    : 0;\n   174→\n   175→  return (\n   176→    <div className=\"project-header\" data-testid=\"project-header\">\n   177→      {/* Name */}\n   178→      <div className=\"project-header-name-row\">\n   179→        {editingName ? (\n   180→          <div className=\"project-header-name-edit\">\n   181→            <input\n   182→              ref={nameInputRef}\n   183→              className={`project-header-name-input ${nameError ? 'project-header-name-input-error' : ''}`}\n   184→              value={nameValue}\n   185→              onChange={(e) => { setNameValue(e.target.value); setNameError(false); }}\n   186→              onBlur={saveName}\n   187→              onKeyDown={handleNameKeyDown}\n   188→              data-testid=\"project-header-name-input\"\n   189→            />\n   190→            {nameError && (\n   191→              <span className=\"project-header-name-error\" data-testid=\"project-header-name-error\">\n   192→                Name is required\n   193→              </span>\n   194→            )}\n   195→          </div>\n   196→        ) : (\n   197→          <h1\n   198→            className=\"project-header-name\"\n   199→            onClick={handleNameClick}\n   200→            data-testid=\"project-header-name\"\n   201→          >\n   202→            {project.name}\n   203→          </h1>\n   204→        )}\n   205→      </div>\n   206→\n   207→      {/* Meta row: status, progress, target date, lead */}\n   208→      <div className=\"project-header-meta\">\n   209→        {/* Status badge */}\n   210→        <div className=\"project-header-status-wrapper\" ref={statusRef}>\n   211→          <button\n   212→            className={`project-header-status-badge ${statusCfg.className}`}\n   213→            onClick={() => setStatusDropdownOpen(!statusDropdownOpen)}\n   214→            data-testid=\"project-header-status-badge\"\n   215→          >\n   216→            {statusCfg.label}\n   217→          </button>\n   218→          {statusDropdownOpen && (\n   219→            <div className=\"project-header-status-dropdown\" data-testid=\"project-header-status-dropdown\">\n   220→              {PROJECT_STATUS_ORDER.map((s) => {\n   221→                const cfg = PROJECT_STATUS_CONFIG[s];\n   222→                return (\n   223→                  <button\n   224→                    key={s}\n   225→                    className={`project-header-status-option ${project.status === s ? 'project-header-status-option-active' : ''}`}\n   226→                    onClick={() => handleStatusChange(s)}\n   227→                    data-testid={`project-header-status-option-${s}`}\n   228→                  >\n   229→                    <span className={`project-header-status-dot ${cfg.className}`} />\n   230→                    <span>{cfg.label}</span>\n   231→                  </button>\n   232→                );\n   233→              })}\n   234→            </div>\n   235→          )}\n   236→        </div>\n   237→\n   238→        {/* Progress bar */}\n   239→        <div className=\"project-header-progress\" data-testid=\"project-header-progress\">\n   240→          <div className=\"project-header-progress-bar\">\n   241→            <div\n   242→              className={`project-header-progress-fill ${percentage === 100 ? 'project-header-progress-complete' : ''}`}\n   243→              style={{ width: `${percentage}%` }}\n   244→            />\n   245→          </div>\n   246→          <span className=\"project-header-progress-text\" data-testid=\"project-header-progress-text\">\n   247→            {project.completedIssues} of {project.totalIssues} issues completed\n   248→          </span>\n   249→        </div>\n   250→\n   251→        {/* Target Date */}\n   252→        <div className=\"project-header-date-wrapper\">\n   253→          {editingDate ? (\n   254→            <div className=\"project-header-date-edit\">\n   255→              <input\n   256→                ref={dateInputRef}\n   257→                type=\"date\"\n   258→                className=\"project-header-date-input\"\n   259→                defaultValue={project.targetDate || ''}\n   260→                onChange={handleDateChange}\n   261→                onBlur={() => setEditingDate(false)}\n   262→                data-testid=\"project-header-date-input\"\n   263→              />\n   264→              {project.targetDate && (\n   265→                <button\n   266→                  className=\"project-header-date-clear\"\n   267→                  onMouseDown={(e) => { e.preventDefault(); handleClearDate(); }}\n   268→                  data-testid=\"project-header-date-clear\"\n   269→                >\n   270→                  Clear\n   271→                </button>\n   272→              )}\n   273→            </div>\n   274→          ) : (\n   275→            <button\n   276→              className=\"project-header-date-btn\"\n   277→              onClick={handleDateClick}\n   278→              data-testid=\"project-header-date-btn\"\n   279→            >\n   280→              <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n   281→                <rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\" />\n   282→                <line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\" />\n   283→                <line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\" />\n   284→                <line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\" />\n   285→              </svg>\n   286→              <span>\n   287→                {project.targetDate ? formatTargetDate(project.targetDate) : 'No target date'}\n   288→              </span>\n   289→            </button>\n   290→          )}\n   291→        </div>\n   292→\n   293→        {/* Lead selector */}\n   294→        <div className=\"project-header-lead-wrapper\" ref={leadRef}>\n   295→          <button\n   296→            className=\"project-header-lead-btn\"\n   297→            onClick={() => setLeadDropdownOpen(!leadDropdownOpen)}\n   298→            data-testid=\"project-header-lead-btn\"\n   299→          >\n   300→            {project.leadName ? (\n   301→              <>\n   302→                <span className=\"project-header-lead-avatar\">\n   303→                  {getInitials(project.leadName)}\n   304→                </span>\n   305→                <span className=\"project-header-lead-name\">{project.leadName}</span>\n   306→              </>\n   307→            ) : (\n   308→              <span className=\"project-header-no-lead\">No lead</span>\n   309→            )}\n   310→          </button>\n   311→          {leadDropdownOpen && (\n   312→            <div className=\"project-header-lead-dropdown\" data-testid=\"project-header-lead-dropdown\">\n   313→              <input\n   314→                ref={leadSearchRef}\n   315→                className=\"project-header-lead-search\"\n   316→                placeholder=\"Search members...\"\n   317→                value={leadSearch}\n   318→                onChange={(e) => setLeadSearch(e.target.value)}\n   319→                data-testid=\"project-header-lead-search\"\n   320→              />\n   321→              <button\n   322→                className=\"project-header-lead-option\"\n   323→                onClick={() => handleLeadChange(null)}\n   324→                data-testid=\"project-header-lead-option-remove\"\n   325→              >\n   326→                <span className=\"project-header-lead-avatar project-header-lead-avatar-empty\">?</span>\n   327→                <span>Remove lead</span>\n   328→              </button>\n   329→              {filteredMembers.map((m) => (\n   330→                <button\n   331→                  key={m.id}\n   332→                  className={`project-header-lead-option ${project.leadId === m.id ? 'project-header-lead-option-active' : ''}`}\n   333→                  onClick={() => handleLeadChange(m.id)}\n   334→                  data-testid={`project-header-lead-option-${m.id}`}\n   335→                >\n   336→                  <span className=\"project-header-lead-avatar\">\n   337→                    {getInitials(m.name)}\n   338→                  </span>\n   339→                  <span>{m.name}</span>\n   340→                </button>\n   341→              ))}\n   342→            </div>\n   343→          )}\n   344→        </div>\n   345→      </div>\n   346→\n   347→      {/* Tabs */}\n   348→      <div className=\"project-header-tabs\" data-testid=\"project-header-tabs\">\n   349→        <button\n   350→          className={`project-header-tab ${activeTab === 'issues' ? 'project-header-tab-active' : ''}`}\n   351→          onClick={() => onTabChange('issues')}\n   352→          data-testid=\"project-tab-issues\"\n   353→        >\n   354→          Issues\n   355→        </button>\n   356→        <button\n   357→          className={`project-header-tab ${activeTab === 'overview' ? 'project-header-tab-active' : ''}`}\n   358→          onClick={() => onTabChange('overview')}\n   359→          data-testid=\"project-tab-overview\"\n   360→        >\n   361→          Overview\n   362→        </button>\n   363→      </div>\n   364→    </div>\n   365→  );\n   366→}\n   367→"}]},"parent_tool_use_id":null,"session_id":"ab2ea44b-562c-4be4-8098-792368c383b9","uuid":"2306a009-a82e-4131-9401-60b53e3b27e6","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/src/components/ProjectHeader.tsx","content":"import { useState, useRef, useEffect } from 'react';\nimport { useDispatch } from 'react-redux';\nimport type { AppDispatch } from '../store';\nimport type { ProjectDetail, ProjectMember } from '../slices/projectDetailSlice';\nimport { updateProjectField } from '../slices/projectDetailSlice';\nimport './ProjectHeader.css';\n\nconst PROJECT_STATUS_ORDER = ['planned', 'in_progress', 'completed', 'cancelled'] as const;\n\nconst PROJECT_STATUS_CONFIG: Record<string, { label: string; className: string }> = {\n  planned: { label: 'Planned', className: 'project-header-badge-planned' },\n  in_progress: { label: 'In Progress', className: 'project-header-badge-in-progress' },\n  completed: { label: 'Completed', className: 'project-header-badge-completed' },\n  cancelled: { label: 'Cancelled', className: 'project-header-badge-cancelled' },\n};\n\nfunction getInitials(name: string): string {\n  return name.split(' ').map((n) => n[0]).join('').toUpperCase().slice(0, 2);\n}\n\nfunction formatTargetDate(dateStr: string): string {\n  const d = new Date(dateStr + 'T00:00:00');\n  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });\n}\n\ninterface ProjectHeaderProps {\n  project: ProjectDetail;\n  members: ProjectMember[];\n  activeTab: 'issues' | 'overview';\n  onTabChange: (tab: 'issues' | 'overview') => void;\n}\n\nexport default function ProjectHeader({ project, members, activeTab, onTabChange }: ProjectHeaderProps) {\n  const dispatch = useDispatch<AppDispatch>();\n\n  // Name editing\n  const [editingName, setEditingName] = useState(false);\n  const [nameValue, setNameValue] = useState(project.name);\n  const [nameError, setNameError] = useState(false);\n  const nameInputRef = useRef<HTMLInputElement>(null);\n\n  // Status dropdown\n  const [statusDropdownOpen, setStatusDropdownOpen] = useState(false);\n  const statusRef = useRef<HTMLDivElement>(null);\n\n  // Date editing\n  const [editingDate, setEditingDate] = useState(false);\n  const dateInputRef = useRef<HTMLInputElement>(null);\n\n  // Lead selector\n  const [leadDropdownOpen, setLeadDropdownOpen] = useState(false);\n  const [leadSearch, setLeadSearch] = useState('');\n  const leadRef = useRef<HTMLDivElement>(null);\n  const leadSearchRef = useRef<HTMLInputElement>(null);\n\n  // Sync name from props\n  useEffect(() => {\n    setNameValue(project.name);\n  }, [project.name]);\n\n  // Focus name input\n  useEffect(() => {\n    if (editingName) {\n      nameInputRef.current?.focus();\n      nameInputRef.current?.select();\n    }\n  }, [editingName]);\n\n  // Focus lead search\n  useEffect(() => {\n    if (leadDropdownOpen) {\n      leadSearchRef.current?.focus();\n    }\n  }, [leadDropdownOpen]);\n\n  // Close status dropdown on outside click\n  useEffect(() => {\n    function handleClickOutside(e: MouseEvent) {\n      if (statusRef.current && !statusRef.current.contains(e.target as Node)) {\n        setStatusDropdownOpen(false);\n      }\n    }\n    if (statusDropdownOpen) {\n      document.addEventListener('mousedown', handleClickOutside);\n    }\n    return () => document.removeEventListener('mousedown', handleClickOutside);\n  }, [statusDropdownOpen]);\n\n  // Close lead dropdown on outside click\n  useEffect(() => {\n    function handleClickOutside(e: MouseEvent) {\n      if (leadRef.current && !leadRef.current.contains(e.target as Node)) {\n        setLeadDropdownOpen(false);\n        setLeadSearch('');\n      }\n    }\n    if (leadDropdownOpen) {\n      document.addEventListener('mousedown', handleClickOutside);\n    }\n    return () => document.removeEventListener('mousedown', handleClickOutside);\n  }, [leadDropdownOpen]);\n\n  // Name handlers\n  function handleNameClick() {\n    setEditingName(true);\n    setNameError(false);\n  }\n\n  async function saveName() {\n    const trimmed = nameValue.trim();\n    if (!trimmed) {\n      setNameError(true);\n      return;\n    }\n    if (trimmed !== project.name) {\n      await dispatch(updateProjectField({ projectId: project.id, field: 'name', value: trimmed }));\n    }\n    setEditingName(false);\n    setNameError(false);\n  }\n\n  function handleNameKeyDown(e: React.KeyboardEvent) {\n    if (e.key === 'Enter') {\n      e.preventDefault();\n      saveName();\n    } else if (e.key === 'Escape') {\n      setNameValue(project.name);\n      setEditingName(false);\n      setNameError(false);\n    }\n  }\n\n  // Status handlers\n  function handleStatusChange(newStatus: string) {\n    dispatch(updateProjectField({ projectId: project.id, field: 'status', value: newStatus }));\n    setStatusDropdownOpen(false);\n  }\n\n  // Date handlers\n  function handleDateClick() {\n    setEditingDate(true);\n    setTimeout(() => {\n      dateInputRef.current?.showPicker?.();\n    }, 0);\n  }\n\n  function handleDateChange(e: React.ChangeEvent<HTMLInputElement>) {\n    const val = e.target.value || null;\n    dispatch(updateProjectField({ projectId: project.id, field: 'targetDate', value: val }));\n    setEditingDate(false);\n  }\n\n  function handleClearDate() {\n    dispatch(updateProjectField({ projectId: project.id, field: 'targetDate', value: null }));\n    setEditingDate(false);\n  }\n\n  // Lead handlers\n  function handleLeadChange(memberId: string | null) {\n    dispatch(updateProjectField({ projectId: project.id, field: 'leadId', value: memberId }));\n    setLeadDropdownOpen(false);\n    setLeadSearch('');\n  }\n\n  const filteredMembers = members.filter((m) =>\n    m.name.toLowerCase().includes(leadSearch.toLowerCase()) ||\n    m.email.toLowerCase().includes(leadSearch.toLowerCase())\n  );\n\n  const statusCfg = PROJECT_STATUS_CONFIG[project.status] || PROJECT_STATUS_CONFIG.planned;\n  const percentage = project.totalIssues > 0\n    ? Math.round((project.completedIssues / project.totalIssues) * 100)\n    : 0;\n\n  return (\n    <div className=\"project-header\" data-testid=\"project-header\">\n      {/* Name */}\n      <div className=\"project-header-name-row\">\n        {editingName ? (\n          <div className=\"project-header-name-edit\">\n            <input\n              ref={nameInputRef}\n              className={`project-header-name-input ${nameError ? 'project-header-name-input-error' : ''}`}\n              value={nameValue}\n              onChange={(e) => { setNameValue(e.target.value); setNameError(false); }}\n              onBlur={saveName}\n              onKeyDown={handleNameKeyDown}\n              data-testid=\"project-header-name-input\"\n            />\n            {nameError && (\n              <span className=\"project-header-name-error\" data-testid=\"project-header-name-error\">\n                Name is required\n              </span>\n            )}\n          </div>\n        ) : (\n          <h1\n            className=\"project-header-name\"\n            onClick={handleNameClick}\n            data-testid=\"project-header-name\"\n          >\n            {project.name}\n          </h1>\n        )}\n      </div>\n\n      {/* Meta row: status, progress, target date, lead */}\n      <div className=\"project-header-meta\">\n        {/* Status badge */}\n        <div className=\"project-header-status-wrapper\" ref={statusRef}>\n          <button\n            className={`project-header-status-badge ${statusCfg.className}`}\n            onClick={() => setStatusDropdownOpen(!statusDropdownOpen)}\n            data-testid=\"project-header-status-badge\"\n          >\n            {statusCfg.label}\n          </button>\n          {statusDropdownOpen && (\n            <div className=\"project-header-status-dropdown\" data-testid=\"project-header-status-dropdown\">\n              {PROJECT_STATUS_ORDER.map((s) => {\n                const cfg = PROJECT_STATUS_CONFIG[s];\n                return (\n                  <button\n                    key={s}\n                    className={`project-header-status-option ${project.status === s ? 'project-header-status-option-active' : ''}`}\n                    onClick={() => handleStatusChange(s)}\n                    data-testid={`project-header-status-option-${s}`}\n                  >\n                    <span className={`project-header-status-dot ${cfg.className}`} />\n                    <span>{cfg.label}</span>\n                  </button>\n                );\n              })}\n            </div>\n          )}\n        </div>\n\n        {/* Progress bar */}\n        <div className=\"project-header-progress\" data-testid=\"project-header-progress\">\n          <div className=\"project-header-progress-bar\">\n            <div\n              className={`project-header-progress-fill ${percentage === 100 ? 'project-header-progress-complete' : ''}`}\n              style={{ width: `${percentage}%` }}\n            />\n          </div>\n          <span className=\"project-header-progress-text\" data-testid=\"project-header-progress-text\">\n            {project.completedIssues} of {project.totalIssues} issues completed\n          </span>\n        </div>\n\n        {/* Target Date */}\n        <div className=\"project-header-date-wrapper\">\n          {editingDate ? (\n            <div className=\"project-header-date-edit\">\n              <input\n                ref={dateInputRef}\n                type=\"date\"\n                className=\"project-header-date-input\"\n                defaultValue={project.targetDate || ''}\n                onChange={handleDateChange}\n                onBlur={() => setEditingDate(false)}\n                data-testid=\"project-header-date-input\"\n              />\n              {project.targetDate && (\n                <button\n                  className=\"project-header-date-clear\"\n                  onMouseDown={(e) => { e.preventDefault(); handleClearDate(); }}\n                  data-testid=\"project-header-date-clear\"\n                >\n                  Clear\n                </button>\n              )}\n            </div>\n          ) : (\n            <button\n              className=\"project-header-date-btn\"\n              onClick={handleDateClick}\n              data-testid=\"project-header-date-btn\"\n            >\n              <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n                <rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\" />\n                <line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\" />\n                <line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\" />\n                <line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\" />\n              </svg>\n              <span>\n                {project.targetDate ? formatTargetDate(project.targetDate) : 'No target date'}\n              </span>\n            </button>\n          )}\n        </div>\n\n        {/* Lead selector */}\n        <div className=\"project-header-lead-wrapper\" ref={leadRef}>\n          <button\n            className=\"project-header-lead-btn\"\n            onClick={() => setLeadDropdownOpen(!leadDropdownOpen)}\n            data-testid=\"project-header-lead-btn\"\n          >\n            {project.leadName ? (\n              <>\n                <span className=\"project-header-lead-avatar\">\n                  {getInitials(project.leadName)}\n                </span>\n                <span className=\"project-header-lead-name\">{project.leadName}</span>\n              </>\n            ) : (\n              <span className=\"project-header-no-lead\">No lead</span>\n            )}\n          </button>\n          {leadDropdownOpen && (\n            <div className=\"project-header-lead-dropdown\" data-testid=\"project-header-lead-dropdown\">\n              <input\n                ref={leadSearchRef}\n                className=\"project-header-lead-search\"\n                placeholder=\"Search members...\"\n                value={leadSearch}\n                onChange={(e) => setLeadSearch(e.target.value)}\n                data-testid=\"project-header-lead-search\"\n              />\n              <button\n                className=\"project-header-lead-option\"\n                onClick={() => handleLeadChange(null)}\n                data-testid=\"project-header-lead-option-remove\"\n              >\n                <span className=\"project-header-lead-avatar project-header-lead-avatar-empty\">?</span>\n                <span>Remove lead</span>\n              </button>\n              {filteredMembers.map((m) => (\n                <button\n                  key={m.id}\n                  className={`project-header-lead-option ${project.leadId === m.id ? 'project-header-lead-option-active' : ''}`}\n                  onClick={() => handleLeadChange(m.id)}\n                  data-testid={`project-header-lead-option-${m.id}`}\n                >\n                  <span className=\"project-header-lead-avatar\">\n                    {getInitials(m.name)}\n                  </span>\n                  <span>{m.name}</span>\n                </button>\n              ))}\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* Tabs */}\n      <div className=\"project-header-tabs\" data-testid=\"project-header-tabs\">\n        <button\n          className={`project-header-tab ${activeTab === 'issues' ? 'project-header-tab-active' : ''}`}\n          onClick={() => onTabChange('issues')}\n          data-testid=\"project-tab-issues\"\n        >\n          Issues\n        </button>\n        <button\n          className={`project-header-tab ${activeTab === 'overview' ? 'project-header-tab-active' : ''}`}\n          onClick={() => onTabChange('overview')}\n          data-testid=\"project-tab-overview\"\n        >\n          Overview\n        </button>\n      </div>\n    </div>\n  );\n}\n","numLines":367,"startLine":1,"totalLines":367}}}
