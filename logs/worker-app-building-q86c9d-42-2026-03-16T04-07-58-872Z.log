s-center gap-3\">\n    43→            <input\n    44→              type=\"range\"\n    45→              id={`rating-input-${key}`}\n    46→              min={0}\n    47→              max={5}\n    48→              step={1}\n    49→              value={ratings[key]}\n    50→              onChange={(e) => handleChange(key, parseInt(e.target.value, 10))}\n    51→              aria-valuetext={ratings[key] === 0 ? 'Not rated' : `${ratings[key]} out of 5`}\n    52→              data-testid={`rating-input-${key}`}\n    53→              className=\"flex-1 h-2 rounded-full appearance-none cursor-pointer accent-primary\"\n    54→              style={{\n    55→                background: ratings[key] === 0\n    56→                  ? 'var(--color-bg-secondary)'\n    57→                  : `linear-gradient(to right, var(--color-primary) ${((ratings[key] - 1) / 4) * 100}%, var(--color-bg-secondary) ${((ratings[key] - 1) / 4) * 100}%)`,\n    58→              }}\n    59→            />\n    60→            <div className=\"flex items-center gap-0.5\" aria-hidden=\"true\">\n    61→              {Array.from({ length: 5 }, (_, i) => (\n    62→                <Star\n    63→                  key={i}\n    64→                  size={14}\n    65→                  className={\n    66→                    i < ratings[key]\n    67→                      ? 'fill-primary text-primary'\n    68→                      : 'text-border'\n    69→                  }\n    70→                />\n    71→              ))}\n    72→            </div>\n    73→          </div>\n    74→        </div>\n    75→      ))}\n    76→    </div>\n    77→  )\n    78→}\n    79→"}]},"parent_tool_use_id":null,"session_id":"77a6fe6d-b266-4c39-a2b8-53370bc7835f","uuid":"73662677-26fd-4103-bc7f-7c678cce5dce","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/components/RatingSliders.tsx","content":"import { Star } from 'lucide-react'\n\nexport interface Ratings {\n  rating: number\n  cleanliness: number\n  accuracy: number\n  communication: number\n  location: number\n  value: number\n}\n\ninterface RatingSlidersProps {\n  ratings: Ratings\n  onChange: (ratings: Ratings) => void\n}\n\nconst SLIDER_CATEGORIES: { key: keyof Ratings; label: string }[] = [\n  { key: 'rating', label: 'Overall' },\n  { key: 'cleanliness', label: 'Cleanliness' },\n  { key: 'accuracy', label: 'Accuracy' },\n  { key: 'communication', label: 'Communication' },\n  { key: 'location', label: 'Location' },\n  { key: 'value', label: 'Value' },\n]\n\nexport default function RatingSliders({ ratings, onChange }: RatingSlidersProps) {\n  const handleChange = (key: keyof Ratings, val: number) => {\n    onChange({ ...ratings, [key]: val })\n  }\n\n  return (\n    <div data-testid=\"rating-sliders\" className=\"space-y-5\">\n      <h3 className=\"text-lg font-semibold text-text\">Rate your experience</h3>\n      {SLIDER_CATEGORIES.map(({ key, label }) => (\n        <div key={key} data-testid={`rating-slider-${key}`} className=\"space-y-1.5\">\n          <div className=\"flex items-center justify-between\">\n            <label htmlFor={`rating-input-${key}`} className=\"text-sm font-medium text-text\">{label}</label>\n            <span className=\"text-sm font-semibold text-text\" data-testid={`rating-value-${key}`}>\n              {ratings[key] === 0 ? 'Not rated' : ratings[key]}\n            </span>\n          </div>\n          <div className=\"flex items-center gap-3\">\n            <input\n              type=\"range\"\n              id={`rating-input-${key}`}\n              min={0}\n              max={5}\n              step={1}\n              value={ratings[key]}\n              onChange={(e) => handleChange(key, parseInt(e.target.value, 10))}\n              aria-valuetext={ratings[key] === 0 ? 'Not rated' : `${ratings[key]} out of 5`}\n              data-testid={`rating-input-${key}`}\n              className=\"flex-1 h-2 rounded-full appearance-none cursor-pointer accent-primary\"\n              style={{\n                background: ratings[key] === 0\n                  ? 'var(--color-bg-secondary)'\n                  : `linear-gradient(to right, var(--color-primary) ${((ratings[key] - 1) / 4) * 100}%, var(--color-bg-secondary) ${((ratings[key] - 1) / 4) * 100}%)`,\n              }}\n            />\n            <div className=\"flex items-center gap-0.5\" aria-hidden=\"true\">\n              {Array.from({ length: 5 }, (_, i) => (\n                <Star\n                  key={i}\n                  size={14}\n                  className={\n                    i < ratings[key]\n                      ? 'fill-primary text-primary'\n                      : 'text-border'\n                  }\n                />\n              ))}\n            </div>\n          </div>\n        </div>\n      ))}\n    </div>\n  )\n}\n","numLines":79,"startLine":1,"totalLines":79}}}
