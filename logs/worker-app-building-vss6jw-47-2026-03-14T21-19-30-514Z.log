[2026-03-14T21:17:07.903Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XVNeHZSh41BctgWcDdkz5w","type":"tool_result","content":"     1→import { createSlice, createAsyncThunk } from '@reduxjs/toolkit'\n     2→\n     3→export interface BookingDetail {\n     4→  id: string\n     5→  property_id: string\n     6→  guest_id: string\n     7→  check_in: string\n     8→  check_out: string\n     9→  num_guests: number\n    10→  total_price: number\n    11→  status: string\n    12→  property_title: string\n    13→  property_city: string\n    14→  property_country: string\n    15→  property_image: string | null\n    16→  has_review: boolean\n    17→}\n    18→\n    19→interface ReviewFormState {\n    20→  booking: BookingDetail | null\n    21→  loading: boolean\n    22→  error: string | null\n    23→  submitting: boolean\n    24→  submitSuccess: boolean\n    25→}\n    26→\n    27→const initialState: ReviewFormState = {\n    28→  booking: null,\n    29→  loading: false,\n    30→  error: null,\n    31→  submitting: false,\n    32→  submitSuccess: false,\n    33→}\n    34→\n    35→export const fetchBookingForReview = createAsyncThunk(\n    36→  'reviewForm/fetchBookingForReview',\n    37→  async ({ bookingId, guestId }: { bookingId: string; guestId: string }, { rejectWithValue }) => {\n    38→    const response = await fetch(`/api/bookings?guest_id=${encodeURIComponent(guestId)}`)\n    39→    const data = await response.json()\n    40→    if (!response.ok) {\n    41→      return rejectWithValue(data.error || 'Failed to fetch bookings')\n    42→    }\n    43→    const bookings = data as BookingDetail[]\n    44→    const booking = bookings.find((b) => b.id === bookingId)\n    45→    if (!booking) {\n    46→      return rejectWithValue('Booking not found')\n    47→    }\n    48→    if (booking.guest_id !== guestId) {\n    49→      return rejectWithValue('You cannot review this booking')\n    50→    }\n    51→    if (booking.status !== 'completed') {\n    52→      return rejectWithValue('You can only review completed bookings')\n    53→    }\n    54→    if (booking.has_review) {\n    55→      return rejectWithValue('You have already reviewed this booking')\n    56→    }\n    57→    return booking\n    58→  }\n    59→)\n    60→\n    61→export const submitReview = createAsyncThunk(\n    62→  'reviewForm/submitReview',\n    63→  async (\n    64→    data: {\n    65→      booking_id: string\n    66→      property_id: string\n    67→      guest_id: string\n    68→      rating: number\n    69→      cleanliness: number\n    70→      accuracy: number\n    71→      communication: number\n    72→      location: number\n    73→      value: number\n    74→      comment?: string\n    75→    },\n    76→    { rejectWithValue }\n    77→  ) => {\n    78→    const response = await fetch('/api/reviews', {\n    79→      method: 'POST',\n    80→      headers: { 'Content-Type': 'application/json' },\n    81→      body: JSON.stringify(data),\n    82→    })\n    83→    const result = await response.json()\n    84→    if (!response.ok) {\n    85→      return rejectWithValue(result.error || 'Failed to submit review')\n    86→    }\n    87→    return result\n    88→  }\n    89→)\n    90→\n    91→const reviewFormSlice = createSlice({\n    92→  name: 'reviewForm',\n    93→  initialState,\n    94→  reducers: {\n    95→    resetReviewForm(state) {\n    96→      state.booking = null\n    97→      state.loading = false\n    98→      state.error = null\n    99→      state.submitting = false\n   100→      state.submitSuccess = false\n   101→    },\n   102→  },\n   103→  extraReducers: (builder) => {\n   104→    builder\n   105→      .addCase(fetchBookingForReview.pending, (state) => {\n   106→        state.loading = true\n   107→        state.error = null\n   108→      })\n   109→      .addCase(fetchBookingForReview.fulfilled, (state, action) => {\n   110→        state.loading = false\n   111→        state.booking = action.payload\n   112→      })\n   113→      .addCase(fetchBookingForReview.rejected, (state, action) => {\n   114→        state.loading = false\n   115→        state.error = action.payload as string\n   116→      })\n   117→      .addCase(submitReview.pending, (state) => {\n   118→        state.submitting = true\n   119→        state.error = null\n   120→      })\n   121→      .addCase(submitReview.fulfilled, (state) => {\n   122→        state.submitting = false\n   123→        state.submitSuccess = true\n   124→      })\n   125→      .addCase(submitReview.rejected, (state, action) => {\n   126→        state.submitting = false\n   127→        state.error = action.payload as string\n   128→      })\n   129→  },\n   130→})\n   131→\n   132→export const { resetReviewForm } = reviewFormSlice.actions\n   133→export default reviewFormSlice.reducer\n   134→"}]},"parent_tool_use_id":null,"session_id":"57b6b709-e228-49db-ae11-b6aa36b4e36c","uuid":"01f69f4e-8bb0-4aad-9f6f-4e4e8ff9799f","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/slices/reviewFormSlice.ts","content":"import { createSlice, createAsyncThunk } from '@reduxjs/toolkit'\n\nexport interface BookingDetail {\n  id: string\n  property_id: string\n  guest_id: string\n  check_in: string\n  check_out: string\n  num_guests: number\n  total_price: number\n  status: string\n  property_title: string\n  property_city: string\n  property_country: string\n  property_image: string | null\n  has_review: boolean\n}\n\ninterface ReviewFormState {\n  booking: BookingDetail | null\n  loading: boolean\n  error: string | null\n  submitting: boolean\n  submitSuccess: boolean\n}\n\nconst initialState: ReviewFormState = {\n  booking: null,\n  loading: false,\n  error: null,\n  submitting: false,\n  submitSuccess: false,\n}\n\nexport const fetchBookingForReview = createAsyncThunk(\n  'reviewForm/fetchBookingForReview',\n  async ({ bookingId, guestId }: { bookingId: string; guestId: string }, { rejectWithValue }) => {\n    const response = await fetch(`/api/bookings?guest_id=${encodeURIComponent(guestId)}`)\n    const data = await response.json()\n    if (!response.ok) {\n      return rejectWithValue(data.error || 'Failed to fetch bookings')\n    }\n    const bookings = data as BookingDetail[]\n    const booking = bookings.find((b) => b.id === bookingId)\n    if (!booking) {\n      return rejectWithValue('Booking not found')\n    }\n    if (booking.guest_id !== guestId) {\n      return rejectWithValue('You cannot review this booking')\n    }\n    if (booking.status !== 'completed') {\n      return rejectWithValue('You can only review completed bookings')\n    }\n    if (booking.has_review) {\n      return rejectWithValue('You have already reviewed this booking')\n    }\n    return booking\n  }\n)\n\nexport const submitReview = createAsyncThunk(\n  'reviewForm/submitReview',\n  async (\n    data: {\n      booking_id: string\n      property_id: string\n      guest_id: string\n      rating: number\n      cleanliness: number\n      accuracy: number\n      communication: number\n      location: number\n      value: number\n      comment?: string\n    },\n    { rejectWithValue }\n  ) => {\n    const response = await fetch('/api/reviews', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify(data),\n    })\n    const result = await response.json()\n    if (!response.ok) {\n      return rejectWithValue(result.error || 'Failed to submit review')\n    }\n    return result\n  }\n)\n\nconst reviewFormSlice = createSlice({\n  name: 'reviewForm',\n  initialState,\n  reducers: {\n    resetReviewForm(state) {\n      state.booking = null\n      state.loading = false\n      state.error = null\n      state.submitting = false\n      state.submitSuccess = false\n    },\n  },\n  extraReducers: (builder) => {\n    builder\n      .addCase(fetchBookingForReview.pending, (state) => {\n        state.loading = true\n        state.error = null\n      })\n      .addCase(fetchBookingForReview.fulfilled, (state, action) => {\n        state.loading = false\n        state.booking = action.payload\n      })\n      .addCase(fetchBookingForReview.rejected, (state, action) => {\n        state.loading = false\n        state.error = action.payload as string\n      })\n      .addCase(submitReview.pending, (state) => {\n        state.submitting = true\n        state.error = null\n      })\n      .addCase(submitReview.fulfilled, (state) => {\n        state.submitting = false\n        state.submitSuccess = true\n      })\n      .addCase(submitReview.rejected, (state, action) => {\n        state.submitting = false\n        state.error = action.payload as string\n      })\n  },\n})\n\nexport const { resetReviewForm } = reviewFormSlice.actions\nexport default reviewFormSlice.reducer\n","numLines":134,"startLine":1,"totalLines":134}}}
