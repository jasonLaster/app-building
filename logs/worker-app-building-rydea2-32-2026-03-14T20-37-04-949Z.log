etSelectedTeamId(null);\n    44→            dispatch(fetchTeams());\n    45→          }}\n    46→        />\n    47→      </div>\n    48→    );\n    49→  }\n    50→\n    51→  return (\n    52→    <div className=\"teams-page\" data-testid=\"teams-page\">\n    53→      <div className=\"teams-header\">\n    54→        <h1 className=\"teams-title\" data-testid=\"teams-title\">Teams</h1>\n    55→        <button\n    56→          className=\"teams-create-btn\"\n    57→          onClick={() => setCreateModalOpen(true)}\n    58→          data-testid=\"create-team-btn\"\n    59→        >\n    60→          <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n    61→            <line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\" />\n    62→            <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\" />\n    63→          </svg>\n    64→          Create Team\n    65→        </button>\n    66→      </div>\n    67→\n    68→      {loading ? (\n    69→        <div className=\"teams-loading\" data-testid=\"teams-loading\">\n    70→          Loading...\n    71→        </div>\n    72→      ) : teams.length === 0 ? (\n    73→        <div className=\"teams-empty\" data-testid=\"teams-empty\">\n    74→          <svg width=\"48\" height=\"48\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--color-text-tertiary)\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n    75→            <path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\" />\n    76→            <circle cx=\"9\" cy=\"7\" r=\"4\" />\n    77→            <path d=\"M23 21v-2a4 4 0 0 0-3-3.87\" />\n    78→            <path d=\"M16 3.13a4 4 0 0 1 0 7.75\" />\n    79→          </svg>\n    80→          <p>No teams yet. Create your first team to get started.</p>\n    81→        </div>\n    82→      ) : (\n    83→        <div className=\"teams-grid\" data-testid=\"teams-grid\">\n    84→          {teams.map((team) => (\n