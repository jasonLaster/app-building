itStart={() => onEditStart(label.id)}\n          onEditCancel={onEditCancel}\n          onSave={onSave}\n          onDeleteClick={() => onDeleteClick(label)}\n          existingNames={labels.filter((l) => l.id !== label.id).map((l) => l.name.toLowerCase())}\n        />\n      ))}\n    </div>\n  );\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":307,"cache_read_input_tokens":65263,"cache_creation":{"ephemeral_5m_input_tokens":307,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard","inference_geo":"global"},"context_management":null},"parent_tool_use_id":null,"session_id":"84716977-2503-4df5-acde-0e663b049346","uuid":"ef031624-b3b3-433c-9733-a4db7fd21259"}
