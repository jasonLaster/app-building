-accent);\n}\n\n.member-role-badge-member {\n  background-color: rgba(255, 255, 255, 0.06);\n  color: var(--color-text-secondary);\n}\n\n.member-row-teams {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 4px;\n  min-width: 0;\n}\n\n.member-team-badge {\n  display: inline-flex;\n  align-items: center;\n  padding: 2px 6px;\n  border-radius: 3px;\n  font-size: 11px;\n  font-weight: 500;\n  background-color: rgba(255, 255, 255, 0.06);\n  color: var(--color-text-secondary);\n  white-space: nowrap;\n}\n\n.member-row-actions {\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  position: relative;\n  z-index: 1;\n}\n\n.member-list-empty {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: 60px 0;\n  gap: 12px;\n  color: var(--color-text-tertiary);\n  font-size: 14px;\n}\n\n.member-list-empty p {\n  margin: 0;\n}\n","numLines":145,"startLine":1,"totalLines":145}}}
