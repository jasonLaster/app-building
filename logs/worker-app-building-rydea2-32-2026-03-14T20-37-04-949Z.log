lor-text-primary);\n}\n\n.label-action-btn-delete:hover {\n  color: #ef4444;\n}\n\n.label-row-edit-content {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.label-row-edit-name-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.label-edit-input {\n  flex: 1;\n  padding: 6px 10px;\n  border-radius: 6px;\n  border: 1px solid var(--color-border);\n  background-color: var(--color-bg-primary);\n  color: var(--color-text-primary);\n  font-size: 13px;\n  outline: none;\n  transition: border-color 150ms ease;\n}\n\n.label-edit-input:focus {\n  border-color: var(--color-accent);\n}\n\n.label-edit-input-error {\n  border-color: #ef4444 !important;\n}\n\n.label-edit-error {\n  font-size: 12px;\n  color: #ef4444;\n}\n\n.label-edit-color-section {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  flex-wrap: wrap;\n}\n\n.label-edit-presets {\n  display: flex;\n  gap: 5px;\n}\n\n.label-edit-swatch {\n  width: 20px;\n  height: 20px;\n  border-radius: 50%;\n  border: 2px solid transparent;\n  cursor: pointer;\n  padding: 0;\n  transition: border-color 150ms ease, transform 150ms ease;\n}\n\n.label-edit-swatch:hover {\n  transform: scale(1.15);\n}\n\n.label-edit-swatch-selected {\n  border-color: #fff;\n  box-shadow: 0 0 0 2px var(--color-accent);\n}\n\n.label-edit-hex-input {\n  width: 100px;\n  padding: 4px 8px;\n  border-radius: 6px;\n  border: 1px solid var(--color-border);\n  background-color: var(--color-bg-primary);\n  color: var(--color-text-primary);\n  font-size: 12px;\n  font-family: monospace;\n  outline: none;\n  transition: border-color 150ms ease;\n}\n\n.label-edit-hex-input:focus {\n  border-color: var(--color-accent);\n}\n\n.label-row-edit-actions {\n  display: flex;\n  justify-content: flex-end;\n  gap: 8px;\n}\n\n.label-edit-cancel-btn {\n  padding: 5px 12px;\n  border-radius: 6px;\n  border: 1px solid var(--color-border);\n  background: transparent;\n  color: var(--color-text-secondary);\n  font-size: 12px;\n  font-weight