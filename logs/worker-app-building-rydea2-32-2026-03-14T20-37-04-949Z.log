iary);\n    72→  font-style: italic;\n    73→}\n    74→"}]},"parent_tool_use_id":null,"session_id":"84716977-2503-4df5-acde-0e663b049346","uuid":"1dfa972b-f75c-4966-8209-5b11fc9f09c7","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/src/components/TeamCard.css","content":".team-card {\n  background-color: var(--color-bg-surface);\n  border: 1px solid var(--color-border);\n  border-radius: 8px;\n  padding: 16px;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  cursor: pointer;\n  transition: border-color 150ms ease;\n}\n\n.team-card:hover {\n  border-color: var(--color-text-tertiary);\n}\n\n.team-card:focus-visible {\n  outline: 2px solid var(--color-accent);\n  outline-offset: 2px;\n}\n\n.team-card-header {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.team-card-identifier-badge {\n  font-size: 11px;\n  font-weight: 700;\n  padding: 2px 8px;\n  border-radius: 4px;\n  background-color: rgba(94, 106, 210, 0.15);\n  color: var(--color-accent);\n  letter-spacing: 0.5px;\n  flex-shrink: 0;\n}\n\n.team-card-name {\n  font-size: 15px;\n  font-weight: 600;\n  color: var(--color-text-primary);\n  margin: 0;\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.team-card-meta {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  flex-wrap: wrap;\n}\n\n.team-card-stat {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 12px;\n  color: var(--color-text-secondary);\n}\n\n.team-card-stat svg {\n  color: var(--color-text-tertiary);\n  flex-shrink: 0;\n}\n\n.team-card-no-cycle {\n  color: var(--color-text-tertiary);\n  font-style: italic;\n}\n","numLines":74,"startLine":1,"totalLines":74}}}
