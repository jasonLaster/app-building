[2026-03-14T22:46:46.148Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LUL7cDdibfNNkWdEZr3Tjc","type":"tool_result","content":"     1→import { useState } from 'react';\n     2→import { useSelector, useDispatch } from 'react-redux';\n     3→import type { RootState, AppDispatch } from '../store';\n     4→import type { Issue } from '../slices/issuesSlice';\n     5→import {\n     6→  toggleProjectIssueSelection,\n     7→  clearProjectIssueSelection,\n     8→  bulkUpdateProjectIssues,\n     9→} from '../slices/projectDetailSlice';\n    10→import IssueRow from './IssueRow';\n    11→import { StatusIcon, PriorityIcon, STATUS_CONFIG, STATUS_ORDER } from './IssueRow';\n    12→import './ProjectIssuesTab.css';\n    13→\n    14→const PRIORITY_ORDER = ['urgent', 'high', 'medium', 'low', 'none'] as const;\n    15→const PRIORITY_CONFIG_MAP: Record<string, { label: string }> = {\n    16→  urgent: { label: 'Urgent' },\n    17→  high: { label: 'High' },\n    18→  medium: { label: 'Medium' },\n    19→  low: { label: 'Low' },\n    20→  none: { label: 'No Priority' },\n    21→};\n    22→\n    23→type DropdownType = 'status' | 'priority' | 'assignee' | 'label' | null;\n    24→\n    25→interface TeamGroup {\n    26→  teamId: string;\n    27→  teamName: string;\n    28→  issues: Issue[];\n    29→}\n    30→\n    31→export default function ProjectIssuesTab() {\n    32→  const dispatch = useDispatch<AppDispatch>();\n    33→  const { project, issues, selectedIssueIds, members, labels } = useSelector(\n    34→    (state: RootState) => state.projectDetail\n    35→  );\n    36→  const [collapsedTeams, setCollapsedTeams] = useState<Set<string>>(new Set());\n    37→  const [bulkDropdown, setBulkDropdown] = useState<DropdownType>(null);\n    38→\n    39→  // Group issues by team\n    40→  const teamGroups: TeamGroup[] = [];\n    41→  const teamMap = new Map<string, TeamGroup>();\n    42→  for (const issue of issues) {\n    43→    let group = teamMap.get(issue.teamId);\n    44→    if (!group) {\n    45→      group = { teamId: issue.teamId, teamName: issue.teamName, issues: [] };\n    46→      teamMap.set(issue.teamId, group);\n    47→      teamGroups.push(group);\n    48→    }\n    49→    group.issues.push(issue);\n    50→  }\n    51→\n    52→  function toggleTeamCollapse(teamId: string) {\n    53→    setCollapsedTeams((prev) => {\n    54→      const next = new Set(prev);\n    55→      if (next.has(teamId)) {\n    56→        next.delete(teamId);\n    57→      } else {\n    58→        next.add(teamId);\n    59→      }\n    60→      return next;\n    61→    });\n    62→  }\n    63→\n    64→  function handleCheckChange(issueId: string) {\n    65→    dispatch(toggleProjectIssueSelection(issueId));\n    66→  }\n    67→\n    68→  function handleBulkStatus(status: string) {\n    69→    if (project) {\n    70→      dispatch(bulkUpdateProjectIssues({ issueIds: selectedIssueIds, status, projectId: project.id }));\n    71→    }\n    72→    setBulkDropdown(null);\n    73→  }\n    74→\n    75→  function handleBulkPriority(priority: string) {\n    76→    if (project) {\n    77→      dispatch(bulkUpdateProjectIssues({ issueIds: selectedIssueIds, priority, projectId: project.id }));\n    78→    }\n    79→    setBulkDropdown(null);\n    80→  }\n    81→\n    82→  function handleBulkAssignee(assigneeId: string | null) {\n    83→    if (project) {\n    84→      dispatch(bulkUpdateProjectIssues({ issueIds: selectedIssueIds, assigneeId, projectId: project.id }));\n    85→    }\n    86→    setBulkDropdown(null);\n    87→  }\n    88→\n    89→  function handleBulkLabel(labelId: string) {\n    90→    if (project) {\n    91→      dispatch(bulkUpdateProjectIssues({ issueIds: selectedIssueIds, labelId, projectId: project.id }));\n    92→    }\n    93→    setBulkDropdown(null);\n    94→  }\n    95→\n    96→  if (issues.length === 0) {\n    97→    return (\n    98→      <div className=\"project-issues-tab\" data-testid=\"project-issues-tab\">\n    99→        <div className=\"project-issues-empty\" data-testid=\"project-issues-empty\">\n   100→          <svg width=\"40\" height=\"40\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--color-text-tertiary)\" strokeWidth=\"1.5\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n   101→            <circle cx=\"12\" cy=\"12\" r=\"10\" />\n   102→            <line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"12\" />\n   103→            <line x1=\"12\" y1=\"16\" x2=\"12.01\" y2=\"16\" />\n   104→          </svg>\n   105→          <p>No issues in this project yet.</p>\n   106→        </div>\n   107→      </div>\n   108→    );\n   109→  }\n   110→\n   111→  return (\n   112→    <div className=\"project-issues-tab\" data-testid=\"project-issues-tab\">\n   113→      {/* Bulk actions toolbar */}\n   114→      {selectedIssueIds.length > 0 && (\n   115→        <div className=\"project-issues-bulk\" data-testid=\"project-issues-bulk-toolbar\">\n   116→          <span className=\"project-issues-bulk-count\" data-testid=\"project-issues-bulk-count\">\n   117→            {selectedIssueIds.length} selected\n   118→          </span>\n   119→          <div className=\"project-issues-bulk-buttons\">\n   120→            <div className=\"project-issues-bulk-dd-wrapper\">\n   121→              <button\n   122→                className=\"project-issues-bulk-btn\"\n   123→                onClick={() => setBulkDropdown(bulkDropdown === 'status' ? null : 'status')}\n   124→                data-testid=\"project-bulk-action-status\"\n   125→              >\n   126→                Status\n   127→              </button>\n   128→              {bulkDropdown === 'status' && (\n   129→                <div className=\"project-issues-bulk-dropdown\" data-testid=\"project-bulk-status-dropdown\">\n   130→                  {STATUS_ORDER.map((s) => {\n   131→                    const cfg = STATUS_CONFIG[s];\n   132→                    return (\n   133→                      <button\n   134→                        key={s}\n   135→                        className=\"project-issues-bulk-option\"\n   136→                        onClick={() => handleBulkStatus(s)}\n   137→                        data-testid={`project-bulk-status-option-${s}`}\n   138→                      >\n   139→                        <StatusIcon status={s} color={cfg.color} />\n   140→                        <span>{cfg.label}</span>\n   141→                      </button>\n   142→                    );\n   143→                  })}\n   144→                </div>\n   145→              )}\n   146→            </div>\n   147→            <div className=\"project-issues-bulk-dd-wrapper\">\n   148→              <button\n   149→                className=\"project-issues-bulk-btn\"\n   150→                onClick={() => setBulkDropdown(bulkDropdown === 'priority' ? null : 'priority')}\n   151→                data-testid=\"project-bulk-action-priority\"\n   152→              >\n   153→                Priority\n   154→              </button>\n   155→              {bulkDropdown === 'priority' && (\n   156→                <div className=\"project-issues-bulk-dropdown\" data-testid=\"project-bulk-priority-dropdown\">\n   157→                  {PRIORITY_ORDER.map((p) => (\n   158→                    <button\n   159→                      key={p}\n   160→                      className=\"project-issues-bulk-option\"\n   161→                      onClick={() => handleBulkPriority(p)}\n   162→                      data-testid={`project-bulk-priority-option-${p}`}\n   163→                    >\n   164→                      <PriorityIcon priority={p} />\n   165→                      <span>{PRIORITY_CONFIG_MAP[p].label}</span>\n   166→                    </button>\n   167→                  ))}\n   168→                </div>\n   169→              )}\n   170→            </div>\n   171→            <div className=\"project-issues-bulk-dd-wrapper\">\n   172→              <button\n   173→                className=\"project-issues-bulk-btn\"\n   174→                onClick={() => setBulkDropdown(bulkDropdown === 'assignee' ? null : 'assignee')}\n   175→                data-testid=\"project-bulk-action-assignee\"\n   176→              >\n   177→                Assignee\n   178→              </button>\n   179→              {bulkDropdown === 'assignee' && (\n   180→                <div className=\"project-issues-bulk-dropdown\" data-testid=\"project-bulk-assignee-dropdown\">\n   181→                  <button\n   182→                    className=\"project-issues-bulk-option\"\n   183→                    onClick={() => handleBulkAssignee(null)}\n   184→                    data-testid=\"project-bulk-assignee-option-unassigned\"\n   185→                  >\n   186→                    <span className=\"project-issues-bulk-avatar project-issues-bulk-avatar-empty\">?</span>\n   187→                    <span>Unassigned</span>\n   188→                  </button>\n   189→                  {members.map((m) => (\n   190→                    <button\n   191→                      key={m.id}\n   192→                      className=\"project-issues-bulk-option\"\n   193→                      onClick={() => handleBulkAssignee(m.id)}\n   194→                      data-testid={`project-bulk-assignee-option-${m.id}`}\n   195→                    >\n   196→                      <span className=\"project-issues-bulk-avatar\">\n   197→                        {m.name.split(' ').map((n) => n[0]).join('').toUpperCase().slice(0, 2)}\n   198→                      </span>\n   199→                      <span>{m.name}</span>\n   200→                    </button>\n   201→                  ))}\n   202→                </div>\n   203→              )}\n   204→            </div>\n   205→            <div className=\"project-issues-bulk-dd-wrapper\">\n   206→              <button\n   207→                className=\"project-issues-bulk-btn\"\n   208→                onClick={() => setBulkDropdown(bulkDropdown === 'label' ? null : 'label')}\n   209→                data-testid=\"project-bulk-action-label\"\n   210→              >\n   211→                Label\n   212→              </button>\n   213→              {bulkDropdown === 'label' && (\n   214→                <div className=\"project-issues-bulk-dropdown\" data-testid=\"project-bulk-label-dropdown\">\n   215→                  {labels.map((label) => (\n   216→                    <button\n   217→                      key={label.id}\n   218→                      className=\"project-issues-bulk-option\"\n   219→                      onClick={() => handleBulkLabel(label.id)}\n   220→                      data-testid={`project-bulk-label-option-${label.id}`}\n   221→                    >\n   222→                      <span className=\"project-issues-bulk-label-dot\" style={{ backgroundColor: label.color }} />\n   223→                      <span>{label.name}</span>\n   224→                    </button>\n   225→                  ))}\n   226→                  {labels.length === 0 && (\n   227→                    <div className=\"project-issues-bulk-empty\">No labels available</div>\n   228→                  )}\n   229→                </div>\n   230→              )}\n   231→            </div>\n   232→          </div>\n   233→          <button\n   234→            className=\"project-issues-bulk-cancel\"\n   235→            onClick={() => dispatch(clearProjectIssueSelection())}\n   236→            data-testid=\"project-issues-deselect-all\"\n   237→          >\n   238→            Deselect all\n   239→          </button>\n   240→        </div>\n   241→      )}\n   242→\n   243→      {/* Team groups */}\n   244→      {teamGroups.map((group) => {\n   245→        const isCollapsed = collapsedTeams.has(group.teamId);\n   246→        return (\n   247→          <div key={group.teamId} className=\"project-issues-team-group\" data-testid={`project-team-group-${group.teamId}`}>\n   248→            <button\n   249→              className=\"project-issues-team-header\"\n   250→              onClick={() => toggleTeamCollapse(group.teamId)}\n   251→              data-testid={`project-team-header-${group.teamId}`}\n   252→            >\n   253→              <svg\n   254→                className={`project-issues-team-chevron ${isCollapsed ? 'project-issues-team-chevron-collapsed' : ''}`}\n   255→                width=\"12\"\n   256→                height=\"12\"\n   257→                viewBox=\"0 0 24 24\"\n   258→                fill=\"none\"\n   259→                stroke=\"currentColor\"\n   260→                strokeWidth=\"2\"\n   261→                strokeLinecap=\"round\"\n   262→                strokeLinejoin=\"round\"\n   263→              >\n   264→                <polyline points=\"6 9 12 15 18 9\" />\n   265→              </svg>\n   266→              <span className=\"project-issues-team-name\">{group.teamName}</span>\n   267→              <span className=\"project-issues-team-count\" data-testid={`project-team-count-${group.teamId}`}>\n   268→                ({group.issues.length})\n   269→              </span>\n   270→            </button>\n   271→            {!isCollapsed && (\n   272→              <div className=\"project-issues-team-list\" data-testid={`project-team-issues-${group.teamId}`}>\n   273→                {group.issues.map((issue) => (\n   274→                  <IssueRow\n   275→                    key={issue.id}\n   276→                    issue={issue}\n   277→                    showCheckbox\n   278→                    checked={selectedIssueIds.includes(issue.id)}\n   279→                    onCheckChange={handleCheckChange}\n   280→                  />\n   281→                ))}\n   282→              </div>\n   283→            )}\n   284→          </div>\n   285→        );\n   286→      })}\n   287→    </div>\n   288→  );\n   289→}\n   290→"}]},"parent_tool_use_id":"toolu_01JpeAZFMzUGeqYHDKiAwDdN","session_id":"ad7a792d-8b72-46d6-abe8-c425bbbed9a4","uuid":"8e9d9b3a-38a8-4b49-b0ea-630ede162f35"}
