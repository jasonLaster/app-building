[2026-03-14T22:46:47.182Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HWDzRaJkWv4zhysZFS3VwP","type":"tool_result","content":"     1→import { createSlice, createAsyncThunk } from '@reduxjs/toolkit';\n     2→import type { Issue, IssueLabel } from './issuesSlice';\n     3→import { updateIssueStatus } from './issuesSlice';\n     4→\n     5→export interface ProjectDetail {\n     6→  id: string;\n     7→  name: string;\n     8→  description: string | null;\n     9→  status: string;\n    10→  targetDate: string | null;\n    11→  leadId: string | null;\n    12→  leadName: string | null;\n    13→  leadEmail: string | null;\n    14→  totalIssues: number;\n    15→  completedIssues: number;\n    16→  inProgressIssues: number;\n    17→}\n    18→\n    19→export interface ProjectMilestone {\n    20→  id: string;\n    21→  name: string;\n    22→  targetDate: string | null;\n    23→  completed: boolean;\n    24→}\n    25→\n    26→export interface ProjectMember {\n    27→  id: string;\n    28→  name: string;\n    29→  email: string;\n    30→}\n    31→\n    32→export interface ProjectActivityEntry {\n    33→  id: string;\n    34→  action: string;\n    35→  createdAt: string;\n    36→  memberId: string;\n    37→  memberName: string | null;\n    38→  memberEmail: string | null;\n    39→}\n    40→\n    41→interface ProjectDetailState {\n    42→  project: ProjectDetail | null;\n    43→  issues: Issue[];\n    44→  milestones: ProjectMilestone[];\n    45→  members: ProjectMember[];\n    46→  labels: IssueLabel[];\n    47→  activity: ProjectActivityEntry[];\n    48→  loading: boolean;\n    49→  error: string | null;\n    50→  selectedIssueIds: string[];\n    51→}\n    52→\n    53→const initialState: ProjectDetailState = {\n    54→  project: null,\n    55→  issues: [],\n    56→  milestones: [],\n    57→  members: [],\n    58→  labels: [],\n    59→  activity: [],\n    60→  loading: false,\n    61→  error: null,\n    62→  selectedIssueIds: [],\n    63→};\n    64→\n    65→export const fetchProjectDetail = createAsyncThunk(\n    66→  'projectDetail/fetchProjectDetail',\n    67→  async (projectId: string, { getState, rejectWithValue }) => {\n    68→    const state = getState() as { auth: { token: string | null } };\n    69→    const token = state.auth.token;\n    70→    if (!token) return rejectWithValue('No token');\n    71→    const response = await fetch(`/api/project-detail?projectId=${projectId}`, {\n    72→      headers: { Authorization: `Bearer ${token}` },\n    73→    });\n    74→    if (!response.ok) {\n    75→      return rejectWithValue('Failed to fetch project');\n    76→    }\n    77→    return await response.json();\n    78→  }\n    79→);\n    80→\n    81→export const updateProjectField = createAsyncThunk(\n    82→  'projectDetail/updateProjectField',\n    83→  async (\n    84→    payload: { projectId: string; field: string; value: string | null },\n    85→    { getState, rejectWithValue }\n    86→  ) => {\n    87→    const state = getState() as { auth: { token: string | null } };\n    88→    const token = state.auth.token;\n    89→    if (!token) return rejectWithValue('No token');\n    90→    const response = await fetch('/api/update-project', {\n    91→      method: 'PUT',\n    92→      headers: {\n    93→        'Content-Type': 'application/json',\n    94→        Authorization: `Bearer ${token}`,\n    95→      },\n    96→      body: JSON.stringify(payload),\n    97→    });\n    98→    if (!response.ok) {\n    99→      return rejectWithValue('Failed to update project');\n   100→    }\n   101→    return await response.json() as {\n   102→      project: ProjectDetail;\n   103→      activity: ProjectActivityEntry | null;\n   104→    };\n   105→  }\n   106→);\n   107→\n   108→export const createMilestone = createAsyncThunk(\n   109→  'projectDetail/createMilestone',\n   110→  async (\n   111→    payload: { projectId: string; name: string; targetDate: string | null },\n   112→    { getState, rejectWithValue }\n   113→  ) => {\n   114→    const state = getState() as { auth: { token: string | null } };\n   115→    const token = state.auth.token;\n   116→    if (!token) return rejectWithValue('No token');\n   117→    const response = await fetch('/api/project-milestones', {\n   118→      method: 'POST',\n   119→      headers: {\n   120→        'Content-Type': 'application/json',\n   121→        Authorization: `Bearer ${token}`,\n   122→      },\n   123→      body: JSON.stringify(payload),\n   124→    });\n   125→    if (!response.ok) {\n   126→      return rejectWithValue('Failed to create milestone');\n   127→    }\n   128→    return await response.json() as { milestone: ProjectMilestone };\n   129→  }\n   130→);\n   131→\n   132→export const updateMilestone = createAsyncThunk(\n   133→  'projectDetail/updateMilestone',\n   134→  async (\n   135→    payload: { milestoneId: string; projectId: string; name?: string; targetDate?: string | null; completed?: boolean },\n   136→    { getState, rejectWithValue }\n   137→  ) => {\n   138→    const state = getState() as { auth: { token: string | null } };\n   139→    const token = state.auth.token;\n   140→    if (!token) return rejectWithValue('No token');\n   141→    const response = await fetch('/api/project-milestones', {\n   142→      method: 'PUT',\n   143→      headers: {\n   144→        'Content-Type': 'application/json',\n   145→        Authorization: `Bearer ${token}`,\n   146→      },\n   147→      body: JSON.stringify(payload),\n   148→    });\n   149→    if (!response.ok) {\n   150→      return rejectWithValue('Failed to update milestone');\n   151→    }\n   152→    return await response.json() as { milestone: ProjectMilestone };\n   153→  }\n   154→);\n   155→\n   156→export const deleteMilestone = createAsyncThunk(\n   157→  'projectDetail/deleteMilestone',\n   158→  async (\n   159→    payload: { milestoneId: string; projectId: string },\n   160→    { getState, rejectWithValue }\n   161→  ) => {\n   162→    const state = getState() as { auth: { token: string | null } };\n   163→    const token = state.auth.token;\n   164→    if (!token) return rejectWithValue('No token');\n   165→    const response = await fetch(\n   166→      `/api/project-milestones?milestoneId=${payload.milestoneId}&projectId=${payload.projectId}`,\n   167→      {\n   168→        method: 'DELETE',\n   169→        headers: { Authorization: `Bearer ${token}` },\n   170→      }\n   171→    );\n   172→    if (!response.ok) {\n   173→      return rejectWithValue('Failed to delete milestone');\n   174→    }\n   175→    return { milestoneId: payload.milestoneId };\n   176→  }\n   177→);\n   178→\n   179→export const updateProjectIssueStatus = createAsyncThunk(\n   180→  'projectDetail/updateProjectIssueStatus',\n   181→  async (\n   182→    payload: { issueId: string; status: string },\n   183→    { getState, rejectWithValue }\n   184→  ) => {\n   185→    const state = getState() as { auth: { token: string | null } };\n   186→    const token = state.auth.token;\n   187→    if (!token) return rejectWithValue('No token');\n   188→    const response = await fetch('/api/update-issue-status', {\n   189→      method: 'PUT',\n   190→      headers: {\n   191→        'Content-Type': 'application/json',\n   192→        Authorization: `Bearer ${token}`,\n   193→      },\n   194→      body: JSON.stringify(payload),\n   195→    });\n   196→    if (!response.ok) {\n   197→      return rejectWithValue('Failed to update issue status');\n   198→    }\n   199→    const data = await response.json();\n   200→    return { issueId: payload.issueId, status: data.issue.status as string };\n   201→  }\n   202→);\n   203→\n   204→export const bulkUpdateProjectIssues = createAsyncThunk(\n   205→  'projectDetail/bulkUpdateProjectIssues',\n   206→  async (\n   207→    payload: {\n   208→      issueIds: string[];\n   209→      projectId: string;\n   210→      status?: string;\n   211→      priority?: string;\n   212→      assigneeId?: string | null;\n   213→      labelId?: string;\n   214→    },\n   215→    { getState, dispatch, rejectWithValue }\n   216→  ) => {\n   217→    const state = getState() as { auth: { token: string | null } };\n   218→    const token = state.auth.token;\n   219→    if (!token) return rejectWithValue('No token');\n   220→    const { projectId, ...body } = payload;\n   221→    const response = await fetch('/api/bulk-update-issues', {\n   222→      method: 'PUT',\n   223→      headers: {\n   224→        'Content-Type': 'application/json',\n   225→        Authorization: `Bearer ${token}`,\n   226→      },\n   227→      body: JSON.stringify(body),\n   228→    });\n   229→    if (!response.ok) {\n   230→      return rejectWithValue('Failed to bulk update issues');\n   231→    }\n   232→    dispatch(fetchProjectDetail(projectId));\n   233→    return payload;\n   234→  }\n   235→);\n   236→\n   237→const projectDetailSlice = createSlice({\n   238→  name: 'projectDetail',\n   239→  initialState,\n   240→  reducers: {\n   241→    clearProjectDetail(state) {\n   242→      state.project = null;\n   243→      state.issues = [];\n   244→      state.milestones = [];\n   245→      state.members = [];\n   246→      state.labels = [];\n   247→      state.activity = [];\n   248→      state.loading = false;\n   249→      state.error = null;\n   250→      state.selectedIssueIds = [];\n   251→    },\n   252→    toggleProjectIssueSelection(state, action: { payload: string }) {\n   253→      const id = action.payload;\n   254→      const idx = state.selectedIssueIds.indexOf(id);\n   255→      if (idx >= 0) {\n   256→        state.selectedIssueIds.splice(idx, 1);\n   257→      } else {\n   258→        state.selectedIssueIds.push(id);\n   259→      }\n   260→    },\n   261→    clearProjectIssueSelection(state) {\n   262→      state.selectedIssueIds = [];\n   263→    },\n   264→  },\n   265→  extraReducers: (builder) => {\n   266→    builder\n   267→      .addCase(fetchProjectDetail.pending, (state) => {\n   268→        if (!state.project) {\n   269→          state.loading = true;\n   270→        }\n   271→        state.error = null;\n   272→      })\n   273→      .addCase(fetchProjectDetail.fulfilled, (state, action) => {\n   274→        state.loading = false;\n   275→        state.project = action.payload.project;\n   276→        state.issues = action.payload.issues;\n   277→        state.milestones = action.payload.milestones;\n   278→        state.members = action.payload.members;\n   279→        state.labels = action.payload.labels;\n   280→        state.activity = action.payload.activity;\n   281→      })\n   282→      .addCase(fetchProjectDetail.rejected, (state, action) => {\n   283→        state.loading = false;\n   284→        state.error = action.payload as string;\n   285→      })\n   286→      .addCase(updateProjectField.fulfilled, (state, action) => {\n   287→        state.project = action.payload.project;\n   288→        if (action.payload.activity) {\n   289→          state.activity.unshift(action.payload.activity);\n   290→        }\n   291→      })\n   292→      .addCase(createMilestone.fulfilled, (state, action) => {\n   293→        state.milestones.push(action.payload.milestone);\n   294→      })\n   295→      .addCase(updateMilestone.fulfilled, (state, action) => {\n   296→        const idx = state.milestones.findIndex((m) => m.id === action.payload.milestone.id);\n   297→        if (idx >= 0) {\n   298→          state.milestones[idx] = action.payload.milestone;\n   299→        }\n   300→      })\n   301→      .addCase(deleteMilestone.fulfilled, (state, action) => {\n   302→        state.milestones = state.milestones.filter((m) => m.id !== action.payload.milestoneId);\n   303→      })\n   304→      .addCase(updateProjectIssueStatus.fulfilled, (state, action) => {\n   305→        const { issueId, status } = action.payload;\n   306→        const issue = state.issues.find((i) => i.id === issueId);\n   307→        if (issue) {\n   308→          const wasDone = issue.status === 'done';\n   309→          const nowDone = status === 'done';\n   310→          const wasInProgress = issue.status === 'in_progress';\n   311→          const nowInProgress = status === 'in_progress';\n   312→          issue.status = status;\n   313→          // Update project counts\n   314→          if (state.project) {\n   315→            if (!wasDone && nowDone) {\n   316→              state.project.completedIssues += 1;\n   317→            } else if (wasDone && !nowDone) {\n   318→              state.project.completedIssues -= 1;\n   319→            }\n   320→            if (!wasInProgress && nowInProgress) {\n   321→              state.project.inProgressIssues += 1;\n   322→            } else if (wasInProgress && !nowInProgress) {\n   323→              state.project.inProgressIssues -= 1;\n   324→            }\n   325→          }\n   326→        }\n   327→      })\n   328→      .addCase(bulkUpdateProjectIssues.fulfilled, (state) => {\n   329→        state.selectedIssueIds = [];\n   330→      })\n   331→      // Cross-slice: handle status updates from IssueRow (issuesSlice)\n   332→      .addCase(updateIssueStatus.fulfilled, (state, action) => {\n   333→        const { issueId, status } = action.payload;\n   334→        const issue = state.issues.find((i) => i.id === issueId);\n   335→        if (issue) {\n   336→          const wasDone = issue.status === 'done';\n   337→          const nowDone = status === 'done';\n   338→          const wasInProgress = issue.status === 'in_progress';\n   339→          const nowInProgress = status === 'in_progress';\n   340→          issue.status = status;\n   341→          if (state.project) {\n   342→            if (!wasDone && nowDone) {\n   343→              state.project.completedIssues += 1;\n   344→            } else if (wasDone && !nowDone) {\n   345→              state.project.completedIssues -= 1;\n   346→            }\n   347→            if (!wasInProgress && nowInProgress) {\n   348→              state.project.inProgressIssues += 1;\n   349→            } else if (wasInProgress && !nowInProgress) {\n   350→              state.project.inProgressIssues -= 1;\n   351→            }\n   352→          }\n   353→        }\n   354→      });\n   355→  },\n   356→});\n   357→\n   358→export const {\n   359→  clearProjectDetail,\n   360→  toggleProjectIssueSelection,\n   361→  clearProjectIssueSelection,\n   362→} = projectDetailSlice.actions;\n   363→export default projectDetailSlice.reducer;\n   364→"}]},"parent_tool_use_id":"toolu_01JpeAZFMzUGeqYHDKiAwDdN","session_id":"ad7a792d-8b72-46d6-abe8-c425bbbed9a4","uuid":"65d1d69d-5121-4052-bb8b-361d0c336111"}
