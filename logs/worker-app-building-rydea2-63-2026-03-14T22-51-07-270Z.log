, 'done', 'cancelled'];\n    47→      if (!validStatuses.includes(status)) {\n    48→        return new Response(JSON.stringify({ error: 'Invalid status' }), {\n    49→          status: 400,\n    50→          headers: { 'Content-Type': 'application/json' },\n    51→        });\n    52→      }\n    53→      await sql`\n    54→        UPDATE issues SET status = ${status}, updated_at = NOW()\n    55→        WHERE id = ANY(${issueIds})\n    56→      `;\n    57→    }\n    58→\n    59→    if (priority) {\n    60→      const validPriorities = ['urgent', 'high', 'medium', 'low', 'none'];\n    61→      if (!validPriorities.includes(priority)) {\n    62→        return new Response(JSON.stringify({ error: 'Invalid priority' }), {\n    63→          status: 400,\n    64→          headers: { 'Content-Type': 'application/json' },\n    65→        });\n    66→      }\n    67→      await sql`\n    68→        UPDATE issues SET priority = ${priority}, updated_at = NOW()\n    69→        WHERE id = ANY(${issueIds})\n    70→      `;\n    71→    }\n    72→\n    73→    if (assigneeId !== undefined) {\n    74→      const assignee = assigneeId || null;\n    75→      await sql`\n    76→        UPDATE issues SET assignee_id = ${assignee}, updated_at = NOW()\n    77→        WHERE id = ANY(${issueIds})\n    78→      `;\n    79→    }\n    80→\n    81→    if (labelId) {\n    82→      for (const issueId of issueIds) {\n    83→        const existing = await sql`\n    84→          SELECT 1 FROM issue_labels WHERE issue_id = ${issueId} AND label_id = ${labelId}\n    85→        `;\n    86→        if (existing.length === 0) {\n    87→          await sql`\n    88→            INSERT INTO issue_labels (issue_id, label_id) VALUES (${issueId}, ${labelId})\n    89→          `;\n    90→        }\n    91→      }\n    92→    }\n    93→\n    94→    return new Response(JSON.stringify({ success: true }), {\n    95→      status: 200,\n    96→      headers: { 'Content-Type': 'application/json' },\n    97→    });\n    