[2026-03-14T22:48:02.467Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Eb9czpBewKS8PPpKZW32wP","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test';\n     2→\n     3→async function loginViaApi(baseURL: string) {\n     4→  const response = await fetch(`${baseURL}/api/login`, {\n     5→    method: 'POST',\n     6→    headers: { 'Content-Type': 'application/json' },\n     7→    body: JSON.stringify({ email: 'alice@acme.com', password: 'password123' }),\n     8→  });\n     9→  return response.json();\n    10→}\n    11→\n    12→async function getProjectsData(baseURL: string, token: string) {\n    13→  const response = await fetch(`${baseURL}/api/projects`, {\n    14→    headers: { Authorization: `Bearer ${token}` },\n    15→  });\n    16→  return response.json() as Promise<{\n    17→    projects: Array<{\n    18→      id: string;\n    19→      name: string;\n    20→      status: string;\n    21→      leadId: string | null;\n    22→      leadName: string | null;\n    23→      targetDate: string | null;\n    24→      totalIssues: number;\n    25→      completedIssues: number;\n    26→    }>;\n    27→    members: Array<{ id: string; name: string; email: string }>;\n    28→    teams: Array<{ id: string; name: string; identifier: string }>;\n    29→  }>;\n    30→}\n    31→\n    32→async function getProjectDetail(baseURL: string, token: string, projectId: string) {\n    33→  const response = await fetch(`${baseURL}/api/project-detail?projectId=${projectId}`, {\n    34→    headers: { Authorization: `Bearer ${token}` },\n    35→  });\n    36→  return response.json() as Promise<{\n    37→    project: {\n    38→      id: string;\n    39→      name: string;\n    40→      description: string | null;\n    41→      status: string;\n    42→      targetDate: string | null;\n    43→      leadId: string | null;\n    44→      leadName: string | null;\n    45→      totalIssues: number;\n    46→      completedIssues: number;\n    47→      inProgressIssues: number;\n    48→    };\n    49→    members: Array<{ id: string; name: string; email: string }>;\n    50→    activity: Array<{ id: string; action: string }>;\n    51→  }>;\n    52→}\n    53→\n    54→async function createProjectViaApi(\n    55→  baseURL: string,\n    56→  token: string,\n    57→  data: Record<string, unknown>\n    58→) {\n    59→  const response = await fetch(`${baseURL}/api/projects`, {\n    60→    method: 'POST',\n    61→    headers: {\n    62→      'Content-Type': 'application/json',\n    63→      Authorization: `Bearer ${token}`,\n    64→    },\n    65→    body: JSON.stringify(data),\n    66→  });\n    67→  return response.json();\n    68→}\n    69→\n    70→async function createIssueViaApi(\n    71→  baseURL: string,\n    72→  token: string,\n    73→  data: Record<string, unknown>\n    74→) {\n    75→  const response = await fetch(`${baseURL}/api/create-issue`, {\n    76→    method: 'POST',\n    77→    headers: {\n    78→      'Content-Type': 'application/json',\n    79→      Authorization: `Bearer ${token}`,\n    80→    },\n    81→    body: JSON.stringify(data),\n    82→  });\n    83→  return response.json();\n    84→}\n    85→\n    86→async function loginAndGoToProject(\n    87→  page: import('@playwright/test').Page,\n    88→  baseURL: string,\n    89→  projectId: string\n    90→) {\n    91→  const data = await loginViaApi(baseURL);\n    92→  await page.goto('/login');\n    93→  await page.evaluate((t) => localStorage.setItem('session_token', t), data.token);\n    94→  await page.goto(`/project/${projectId}`);\n    95→  await expect(page.getByTestId('project-header')).toBeVisible({ timeout: 30000 });\n    96→  return { token: data.token };\n    97→}\n    98→\n    99→test.describe('Project Header — Lead', () => {\n   100→  test('Inline edit lead via searchable selector', async ({ page, baseURL }) => {\n   101→    const data = await loginViaApi(baseURL!);\n   102→    const { projects } = await getProjectsData(baseURL!, data.token);\n   103→    const v2 = projects.find((p) => p.name === 'V2 Launch')!;\n   104→\n   105→    await loginAndGoToProject(page, baseURL!, v2.id);\n   106→\n   107→    // Verify current lead is displayed\n   108→    await expect(page.getByTestId('project-header-lead-btn')).toContainText('Alice Johnson');\n   109→\n   110→    // Click lead button to open dropdown\n   111→    await page.getByTestId('project-header-lead-btn').click();\n   112→    const dropdown = page.getByTestId('project-header-lead-dropdown');\n   113→    await expect(dropdown).toBeVisible({ timeout: 5000 });\n   114→\n   115→    // Verify search input is visible\n   116→    await expect(page.getByTestId('project-header-lead-search')).toBeVisible();\n   117→\n   118→    // Verify all members are listed (Alice, Bob, Carol) plus Remove option\n   119→    const detail = await getProjectDetail(baseURL!, data.token, v2.id);\n   120→    for (const member of detail.members) {\n   121→      await expect(page.getByTestId(`project-header-lead-option-${member.id}`)).toBeVisible();\n   122→      await expect(page.getByTestId(`project-header-lead-option-${member.id}`)).toContainText(member.name);\n   123→    }\n   124→\n   125→    // Verify the current lead option has active styling\n   126→    const aliceMember = detail.members.find((m) => m.name === 'Alice Johnson')!;\n   127→    await expect(page.getByTestId(`project-header-lead-option-${aliceMember.id}`)).toHaveClass(/project-header-lead-option-active/);\n   128→  });\n   129→\n   130→  test('Change project lead', async ({ page, baseURL }) => {\n   131→    const data = await loginViaApi(baseURL!);\n   132→    const { members } = await getProjectsData(baseURL!, data.token);\n   133→    const alice = members.find((m) => m.name === 'Alice Johnson')!;\n   134→\n   135→    const proj = await createProjectViaApi(baseURL!, data.token, {\n   136→      name: `Lead Change Test ${Date.now()}`,\n   137→      status: 'planned',\n   138→      leadId: alice.id,\n   139→    });\n   140→\n   141→    await loginAndGoToProject(page, baseURL!, proj.id);\n   142→\n   143→    // Verify initial lead\n   144→    await expect(page.getByTestId('project-header-lead-btn')).toContainText('Alice Johnson', { timeout: 10000 });\n   145→\n   146→    // Open lead dropdown\n   147→    await page.getByTestId('project-header-lead-btn').click();\n   148→    await expect(page.getByTestId('project-header-lead-dropdown')).toBeVisible({ timeout: 5000 });\n   149→\n   150→    // Type to search for Bob\n   151→    await page.getByTestId('project-header-lead-search').fill('Bob');\n   152→\n   153→    // Select Bob Smith\n   154→    const bob = members.find((m) => m.name === 'Bob Smith')!;\n   155→    await page.getByTestId(`project-header-lead-option-${bob.id}`).click();\n   156→\n   157→    // Verify lead updated in UI with avatar\n   158→    await expect(page.getByTestId('project-header-lead-btn')).toContainText('Bob Smith', { timeout: 10000 });\n   159→    await expect(page.getByTestId('project-header-lead-btn')).toContainText('BS');\n   160→\n   161→    // Verify dropdown closed\n   162→    await expect(page.getByTestId('project-header-lead-dropdown')).toHaveCount(0);\n   163→\n   164→    // Verify persisted and activity created\n   165→    const detail = await getProjectDetail(baseURL!, data.token, proj.id);\n   166→    expect(detail.project.leadId).toBe(bob.id);\n   167→    expect(detail.project.leadName).toBe('Bob Smith');\n   168→    expect(detail.activity.length).toBeGreaterThan(0);\n   169→    expect(detail.activity[0].action).toContain('lead');\n   170→  });\n   171→\n   172→  test('Search lead selector filters results', async ({ page, baseURL }) => {\n   173→    const data = await loginViaApi(baseURL!);\n   174→    const { projects, members } = await getProjectsData(baseURL!, data.token);\n   175→    const v2 = projects.find((p) => p.name === 'V2 Launch')!;\n   176→\n   177→    await loginAndGoToProject(page, baseURL!, v2.id);\n   178→\n   179→    // Open lead dropdown\n   180→    await page.getByTestId('project-header-lead-btn').click();\n   181→    await expect(page.getByTestId('project-header-lead-dropdown')).toBeVisible({ timeout: 5000 });\n   182→\n   183→    // Type \"bob\" in search\n   184→    await page.getByTestId('project-header-lead-search').fill('bob');\n   185→\n   186→    // Verify only Bob is shown\n   187→    const bob = members.find((m) => m.name === 'Bob Smith')!;\n   188→    await expect(page.getByTestId(`project-header-lead-option-${bob.id}`)).toBeVisible();\n   189→\n   190→    // Verify other members are hidden\n   191→    const alice = members.find((m) => m.name === 'Alice Johnson')!;\n   192→    const carol = members.find((m) => m.name === 'Carol Davis')!;\n   193→    await expect(page.getByTestId(`project-header-lead-option-${alice.id}`)).toHaveCount(0);\n   194→    await expect(page.getByTestId(`project-header-lead-option-${carol.id}`)).toHaveCount(0);\n   195→  });\n   196→\n   197→  test('Remove project lead', async ({ page, baseURL }) => {\n   198→    const data = await loginViaApi(baseURL!);\n   199→    const { members } = await getProjectsData(baseURL!, data.token);\n   200→    const alice = members.find((m) => m.name === 'Alice Johnson')!;\n   201→\n   202→    const proj = await createProjectViaApi(baseURL!, data.token, {\n   203→      name: `Remove Lead Test ${Date.now()}`,\n   204→      status: 'planned',\n   205→      leadId: alice.id,\n   206→    });\n   207→\n   208→    await loginAndGoToProject(page, baseURL!, proj.id);\n   209→\n   210→    // Verify initial lead\n   211→    await expect(page.getByTestId('project-header-lead-btn')).toContainText('Alice Johnson', { timeout: 10000 });\n   212→\n   213→    // Open lead dropdown and click Remove\n   214→    await page.getByTestId('project-header-lead-btn').click();\n   215→    await expect(page.getByTestId('project-header-lead-dropdown')).toBeVisible({ timeout: 5000 });\n   216→    await page.getByTestId('project-header-lead-option-remove').click();\n   217→\n   218→    // Verify lead is cleared\n   219→    await expect(page.getByTestId('project-header-lead-btn')).toContainText('No lead', { timeout: 10000 });\n   220→\n   221→    // Verify persisted and activity created\n   222→    const detail = await getProjectDetail(baseURL!, data.token, proj.id);\n   223→    expect(detail.project.leadId).toBeNull();\n   224→    expect(detail.activity.length).toBeGreaterThan(0);\n   225→    expect(detail.activity[0].action).toContain('removed lead');\n   226→  });\n   227→});\n   228→\n   229→test.describe('Project Header — Progress Bar', () => {\n   230→  test('Progress bar reflects issue completion accurately', async ({ page, baseURL }) => {\n   231→    const data = await loginViaApi(baseURL!);\n   232→    const { projects } = await getProjectsData(baseURL!, data.token);\n   233→    const v2 = projects.find((p) => p.name === 'V2 Launch')!;\n   234→\n   235→    await loginAndGoToProject(page, baseURL!, v2.id);\n   236→\n   237→    // Get actual data from API\n   238→    const detail = await getProjectDetail(baseURL!, data.token, v2.id);\n   239→    const { completedIssues, totalIssues } = detail.project;\n   240→    const percentage = totalIssues > 0 ? Math.round((completedIssues / totalIssues) * 100) : 0;\n   241→\n   242→    // Verify progress text\n   243→    const expectedText = `${completedIssues} of ${totalIssues} issues completed`;\n   244→    await expect(page.getByTestId('project-header-progress-text')).toHaveText(expectedText, { timeout: 10000 });\n   245→\n   246→    // Verify the progress bar fill width matches the percentage\n   247→    const fill = page.getByTestId('project-header-progress').locator('.project-header-progress-fill');\n   248→    await expect(fill).toHaveAttribute('style', new RegExp(`width:\\\\s*${percentage}%`), { timeout: 5000 });\n   249→  });\n   250→\n   251→  test('Progress bar shows 0% for project with no completed issues', async ({ page, baseURL }) => {\n   252→    const data = await loginViaApi(baseURL!);\n   253→    const { teams } = await getProjectsData(baseURL!, data.token);\n   254→    const engTeam = teams.find((t) => t.identifier === 'ENG')!;\n   255→\n   256→    // Create project with only non-done issues\n   257→    const proj = await createProjectViaApi(baseURL!, data.token, {\n   258→      name: `Zero Progress ${Date.now()}`,\n   259→      status: 'planned',\n   260→    });\n   261→\n   262→    for (let i = 0; i < 5; i++) {\n   263→      await createIssueViaApi(baseURL!, data.token, {\n   264→        teamId: engTeam.id,\n   265→        title: `Todo Issue ${i} ${Date.now()}`,\n   266→        status: 'todo',\n   267→        priority: 'medium',\n   268→        projectId: proj.id,\n   269→      });\n   270→    }\n   271→\n   272→    await loginAndGoToProject(page, baseURL!, proj.id);\n   273→\n   274→    // Verify 0% progress text\n   275→    await expect(page.getByTestId('project-header-progress-text')).toHaveText('0 of 5 issues completed', { timeout: 10000 });\n   276→  });\n   277→\n   278→  test('Progress bar shows 100% for fully completed project', async ({ page, baseURL }) => {\n   279→    const data = await loginViaApi(baseURL!);\n   280→    const { teams } = await getProjectsData(baseURL!, data.token);\n   281→    const engTeam = teams.find((t) => t.identifier === 'ENG')!;\n   282→\n   283→    // Create project with all done issues\n   284→    const proj = await createProjectViaApi(baseURL!, data.token, {\n   285→      name: `All Done ${Date.now()}`,\n   286→      status: 'completed',\n   287→    });\n   288→\n   289→    for (let i = 0; i < 4; i++) {\n   290→      await createIssueViaApi(baseURL!, data.token, {\n   291→        teamId: engTeam.id,\n   292→        title: `Done Issue ${i} ${Date.now()}`,\n   293→        status: 'done',\n   294→        priority: 'medium',\n   295→        projectId: proj.id,\n   296→      });\n   297→    }\n   298→\n   299→    await loginAndGoToProject(page, baseURL!, proj.id);\n   300→\n   301→    // Verify 100% progress text\n   302→    await expect(page.getByTestId('project-header-progress-text')).toHaveText('4 of 4 issues completed', { timeout: 10000 });\n   303→\n   304→    // Verify complete styling class\n   305→    const fill = page.getByTestId('project-header-progress').locator('.project-header-progress-fill');\n   306→    await expect(fill).toHaveClass(/project-header-progress-complete/);\n   307→  });\n   308→\n   309→  test('Progress bar handles project with no issues', async ({ page, baseURL }) => {\n   310→    const data = await loginViaApi(baseURL!);\n   311→\n   312→    const proj = await createProjectViaApi(baseURL!, data.token, {\n   313→      name: `No Issues ${Date.now()}`,\n   314→      status: 'planned',\n   315→    });\n   316→\n   317→    await loginAndGoToProject(page, baseURL!, proj.id);\n   318→\n   319→    // Verify 0 of 0 with no errors\n   320→    await expect(page.getByTestId('project-header-progress-text')).toHaveText('0 of 0 issues completed', { timeout: 10000 });\n   321→\n   322→    // Verify the progress section is visible (no crash)\n   323→    await expect(page.getByTestId('project-header-progress')).toBeVisible();\n   324→  });\n   325→});\n   326→\n   327→test.describe('Project Header — Tabs', () => {\n   328→  test('Header displays tabs for Issues and Overview', async ({ page, baseURL }) => {\n   329→    const data = await loginViaApi(baseURL!);\n   330→    const { projects } = await getProjectsData(baseURL!, data.token);\n   331→    const v2 = projects.find((p) => p.name === 'V2 Launch')!;\n   332→\n   333→    await loginAndGoToProject(page, baseURL!, v2.id);\n   334→\n   335→    // Verify both tabs are visible\n   336→    await expect(page.getByTestId('project-tab-issues')).toBeVisible();\n   337→    await expect(page.getByTestId('project-tab-overview')).toBeVisible();\n   338→\n   339→    await expect(page.getByTestId('project-tab-issues')).toHaveText('Issues');\n   340→    await expect(page.getByTestId('project-tab-overview')).toHaveText('Overview');\n   341→\n   342→    // Verify Issues tab is active by default\n   343→    await expect(page.getByTestId('project-tab-issues')).toHaveClass(/project-header-tab-active/);\n   344→    await expect(page.getByTestId('project-tab-overview')).not.toHaveClass(/project-header-tab-active/);\n   345→  });\n   346→\n   347→  test('Clicking Overview tab switches to overview content', async ({ page, baseURL }) => {\n   348→    const data = await loginViaApi(baseURL!);\n   349→    const { projects } = await getProjectsData(baseURL!, data.token);\n   350→    const v2 = projects.find((p) => p.name === 'V2 Launch')!;\n   351→\n   352→    await loginAndGoToProject(page, baseURL!, v2.id);\n   353→\n   354→    // Verify Issues tab is active initially\n   355→    await expect(page.getByTestId('project-tab-issues')).toHaveClass(/project-header-tab-active/);\n   356→\n   357→    // Click Overview tab\n   358→    await page.getByTestId('project-tab-overview').click();\n   359→\n   360→    // Verify Overview tab becomes active\n   361→    await expect(page.getByTestId('project-tab-overview')).toHaveClass(/project-header-tab-active/, { timeout: 5000 });\n   362→    await expect(page.getByTestId('project-tab-issues')).not.toHaveClass(/project-header-tab-active/);\n   363→\n   364→    // Verify overview content is displayed\n   365→    await expect(page.getByTestId('project-overview-tab')).toBeVisible({ timeout: 10000 });\n   366→    await expect(page.getByTestId('project-overview-description-section')).toBeVisible();\n   367→    await expect(page.getByTestId('project-overview-milestones-section')).toBeVisible();\n   368→    await expect(page.getByTestId('project-overview-metrics-section')).toBeVisible();\n   369→  });\n   370→});\n   371→"}]},"parent_tool_use_id":null,"session_id":"ad7a792d-8b72-46d6-abe8-c425bbbed9a4","uuid":"95fb93b7-63be-4827-83fa-d2a391ec5607","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/tests/project-header-lead-progress.spec.ts","content":"import { test, expect } from '@playwright/test';\n\nasync function loginViaApi(baseURL: string) {\n  const response = await fetch(`${baseURL}/api/login`, {\n    method: 'POST',\n    headers: { 'Content-Type': 'application/json' },\n    body: JSON.stringify({ email: 'alice@acme.com', password: 'password123' }),\n  });\n  return response.json();\n}\n\nasync function getProjectsData(baseURL: string, token: string) {\n  const response = await fetch(`${baseURL}/api/projects`, {\n    headers: { Authorization: `Bearer ${token}` },\n  });\n  return response.json() as Promise<{\n    projects: Array<{\n      id: string;\n      name: string;\n      status: string;\n      leadId: string | null;\n      leadName: string | null;\n      targetDate: string | null;\n      totalIssues: number;\n      completedIssues: number;\n    }>;\n    members: Array<{ id: string; name: string; email: string }>;\n    teams: Array<{ id: string; name: string; identifier: string }>;\n  }>;\n}\n\nasync function getProjectDetail(baseURL: string, token: string, projectId: string) {\n  const response = await fetch(`${baseURL}/api/project-detail?projectId=${projectId}`, {\n    headers: { Authorization: `Bearer ${token}` },\n  });\n  return response.json() as Promise<{\n    project: {\n      id: string;\n      name: string;\n      description: string | null;\n      status: string;\n      targetDate: string | null;\n      leadId: string | null;\n      leadName: string | null;\n      totalIssues: number;\n      completedIssues: number;\n      inProgressIssues: number;\n    };\n    members: Array<{ id: string; name: string; email: string }>;\n    activity: Array<{ id: string; action: string }>;\n  }>;\n}\n\nasync function createProjectViaApi(\n  baseURL: string,\n  token: string,\n  data: Record<string, unknown>\n) {\n  const response = await fetch(`${baseURL}/api/projects`, {\n    method: 'POST',\n    headers: {\n      'Content-Type': 'application/json',\n      Authorization: `Bearer ${token}`,\n    },\n    body: JSON.stringify(data),\n  });\n  return response.json();\n}\n\nasync function createIssueViaApi(\n  baseURL: string,\n  token: string,\n  data: Record<string, unknown>\n) {\n  const response = await fetch(`${baseURL}/api/create-issue`, {\n    method: 'POST',\n    headers: {\n      'Content-Type': 'application/json',\n      Authorization: `Bearer ${token}`,\n    },\n    body: JSON.stringify(data),\n  });\n  return response.json();\n}\n\nasync function loginAndGoToProject(\n  page: import('@playwright/test').Page,\n  baseURL: string,\n  projectId: string\n) {\n  const data = await loginViaApi(baseURL);\n  await page.goto('/login');\n  await page.evaluate((t) => localStorage.setItem('session_token', t), data.token);\n  await page.goto(`/project/${projectId}`);\n  await expect(page.getByTestId('project-header')).toBeVisible({ timeout: 30000 });\n  return { token: data.token };\n}\n\ntest.describe('Project Header — Lead', () => {\n  test('Inline edit lead via searchable selector', async ({ page, baseURL }) => {\n    const data = await loginViaApi(baseURL!);\n    const { projects } = await getProjectsData(baseURL!, data.token);\n    const v2 = projects.find((p) => p.name === 'V2 Launch')!;\n\n    await loginAndGoToProject(page, baseURL!, v2.id);\n\n    // Verify current lead is displayed\n    await expect(page.getByTestId('project-header-lead-btn')).toContainText('Alice Johnson');\n\n    // Click lead button to open dropdown\n    await page.getByTestId('project-header-lead-btn').click();\n    const dropdown = page.getByTestId('project-header-lead-dropdown');\n    await expect(dropdown).toBeVisible({ timeout: 5000 });\n\n    // Verify search input is visible\n    await expect(page.getByTestId('project-header-lead-search')).toBeVisible();\n\n    // Verify all members are listed (Alice, Bob, Carol) plus Remove option\n    const detail = await getProjectDetail(baseURL!, data.token, v2.id);\n    for (const member of detail.members) {\n      await expect(page.getByTestId(`project-header-lead-option-${member.id}`)).toBeVisible();\n      await expect(page.getByTestId(`project-header-lead-option-${member.id}`)).toContainText(member.name);\n    }\n\n    // Verify the current lead option has active styling\n    const aliceMember = detail.members.find((m) => m.name === 'Alice Johnson')!;\n    await expect(page.getByTestId(`project-header-lead-option-${aliceMember.id}`)).toHaveClass(/project-header-lead-option-active/);\n  });\n\n  test('Change project lead', async ({ page, baseURL }) => {\n    const data = await loginViaApi(baseURL!);\n    const { members } = await getProjectsData(baseURL!, data.token);\n    const alice = members.find((m) => m.name === 'Alice Johnson')!;\n\n    const proj = await createProjectViaApi(baseURL!, data.token, {\n      name: `Lead Change Test ${Date.now()}`,\n      status: 'planned',\n      leadId: alice.id,\n    });\n\n    await loginAndGoToProject(page, baseURL!, proj.id);\n\n    // Verify initial lead\n    await expect(page.getByTestId('project-header-lead-btn')).toContainText('Alice Johnson', { timeout: 10000 });\n\n    // Open lead dropdown\n    await page.getByTestId('project-header-lead-btn').click();\n    await expect(page.getByTestId('project-header-lead-dropdown')).toBeVisible({ timeout: 5000 });\n\n    // Type to search for Bob\n    await page.getByTestId('project-header-lead-search').fill('Bob');\n\n    // Select Bob Smith\n    const bob = members.find((m) => m.name === 'Bob Smith')!;\n    await page.getByTestId(`project-header-lead-option-${bob.id}`).click();\n\n    // Verify lead updated in UI with avatar\n    await expect(page.getByTestId('project-header-lead-btn')).toContainText('Bob Smith', { timeout: 10000 });\n    await expect(page.getByTestId('project-header-lead-btn')).toContainText('BS');\n\n    // Verify dropdown closed\n    await expect(page.getByTestId('project-header-lead-dropdown')).toHaveCount(0);\n\n    // Verify persisted and activity created\n    const detail = await getProjectDetail(baseURL!, data.token, proj.id);\n    expect(detail.project.leadId).toBe(bob.id);\n    expect(detail.project.leadName).toBe('Bob Smith');\n    expect(detail.activity.length).toBeGreaterThan(0);\n    expect(detail.activity[0].action).toContain('lead');\n  });\n\n  test('Search lead selector filters results', async ({ page, baseURL }) => {\n    const data = await loginViaApi(baseURL!);\n    const { projects, members } = await getProjectsData(baseURL!, data.token);\n    const v2 = projects.find((p) => p.name === 'V2 Launch')!;\n\n    await loginAndGoToProject(page, baseURL!, v2.id);\n\n    // Open lead dropdown\n    await page.getByTestId('project-header-lead-btn').click();\n    await expect(page.getByTestId('project-header-lead-dropdown')).toBeVisible({ timeout: 5000 });\n\n    // Type \"bob\" in search\n    await page.getByTestId('project-header-lead-search').fill('bob');\n\n    // Verify only Bob is shown\n    const bob = members.find((m) => m.name === 'Bob Smith')!;\n    await expect(page.getByTestId(`project-header-lead-option-${bob.id}`)).toBeVisible();\n\n    // Verify other members are hidden\n    const alice = members.find((m) => m.name === 'Alice Johnson')!;\n    const carol = members.find((m) => m.name === 'Carol Davis')!;\n    await expect(page.getByTestId(`project-header-lead-option-${alice.id}`)).toHaveCount(0);\n    await expect(page.getByTestId(`project-header-lead-option-${carol.id}`)).toHaveCount(0);\n  });\n\n  test('Remove project lead', async ({ page, baseURL }) => {\n    const data = await loginViaApi(baseURL!);\n    const { members } = await getProjectsData(baseURL!, data.token);\n    const alice = members.find((m) => m.name === 'Alice Johnson')!;\n\n    const proj = await createProjectViaApi(baseURL!, data.token, {\n      name: `Remove Lead Test ${Date.now()}`,\n      status: 'planned',\n      leadId: alice.id,\n    });\n\n    await loginAndGoToProject(page, baseURL!, proj.id);\n\n    // Verify initial lead\n    await expect(page.getByTestId('project-header-lead-btn')).toContainText('Alice Johnson', { timeout: 10000 });\n\n    // Open lead dropdown and click Remove\n    await page.getByTestId('project-header-lead-btn').click();\n    await expect(page.getByTestId('project-header-lead-dropdown')).toBeVisible({ timeout: 5000 });\n    await page.getByTestId('project-header-lead-option-remove').click();\n\n    // Verify lead is cleared\n    await expect(page.getByTestId('project-header-lead-btn')).toContainText('No lead', { timeout: 10000 });\n\n    // Verify persisted and activity created\n    const detail = await getProjectDetail(baseURL!, data.token, proj.id);\n    expect(detail.project.leadId).toBeNull();\n    expect(detail.activity.length).toBeGreaterThan(0);\n    expect(detail.activity[0].action).toContain('removed lead');\n  });\n});\n\ntest.describe('Project Header — Progress Bar', () => {\n  test('Progress bar reflects issue completion accurately', async ({ page, baseURL }) => {\n    const data = await loginViaApi(baseURL!);\n    const { projects } = await getProjectsData(baseURL!, data.token);\n    const v2 = projects.find((p) => p.name === 'V2 Launch')!;\n\n    await loginAndGoToProject(page, baseURL!, v2.id);\n\n    // Get actual data from API\n    const detail = await getProjectDetail(baseURL!, data.token, v2.id);\n    const { completedIssues, totalIssues } = detail.project;\n    const percentage = totalIssues > 0 ? Math.round((completedIssues / totalIssues) * 100) : 0;\n\n    // Verify progress text\n    const expectedText = `${completedIssues} of ${totalIssues} issues completed`;\n    await expect(page.getByTestId('project-header-progress-text')).toHaveText(expectedText, { timeout: 10000 });\n\n    // Verify the progress bar fill width matches the percentage\n    const fill = page.getByTestId('project-header-progress').locator('.project-header-progress-fill');\n    await expect(fill).toHaveAttribute('style', new RegExp(`width:\\\\s*${percentage}%`), { timeout: 5000 });\n  });\n\n  test('Progress bar shows 0% for project with no completed issues', async ({ page, baseURL }) => {\n    const data = await loginViaApi(baseURL!);\n    const { teams } = await getProjectsData(baseURL!, data.token);\n    const engTeam = teams.find((t) => t.identifier === 'ENG')!;\n\n    // Create project with only non-done issues\n    const proj = await createProjectViaApi(baseURL!, data.token, {\n      name: `Zero Progress ${Date.now()}`,\n      status: 'planned',\n    });\n\n    for (let i = 0; i < 5; i++) {\n      await createIssueViaApi(baseURL!, data.token, {\n        teamId: engTeam.id,\n        title: `Todo Issue ${i} ${Date.now()}`,\n        status: 'todo',\n        priority: 'medium',\n        projectId: proj.id,\n      });\n    }\n\n    await loginAndGoToProject(page, baseURL!, proj.id);\n\n    // Verify 0% progress text\n    await expect(page.getByTestId('project-header-progress-text')).toHaveText('0 of 5 issues completed', { timeout: 10000 });\n  });\n\n  test('Progress bar shows 100% for fully completed project', async ({ page, baseURL }) => {\n    const data = await loginViaApi(baseURL!);\n    const { teams } = await getProjectsData(baseURL!, data.token);\n    const engTeam = teams.find((t) => t.identifier === 'ENG')!;\n\n    // Create project with all done issues\n    const proj = await createProjectViaApi(baseURL!, data.token, {\n      name: `All Done ${Date.now()}`,\n      status: 'completed',\n    });\n\n    for (let i = 0; i < 4; i++) {\n      await createIssueViaApi(baseURL!, data.token, {\n        teamId: engTeam.id,\n        title: `Done Issue ${i} ${Date.now()}`,\n        status: 'done',\n        priority: 'medium',\n        projectId: proj.id,\n      });\n    }\n\n    await loginAndGoToProject(page, baseURL!, proj.id);\n\n    // Verify 100% progress text\n    await expect(page.getByTestId('project-header-progress-text')).toHaveText('4 of 4 issues completed', { timeout: 10000 });\n\n    // Verify complete styling class\n    const fill = page.getByTestId('project-header-progress').locator('.project-header-progress-fill');\n    await expect(fill).toHaveClass(/project-header-progress-complete/);\n  });\n\n  test('Progress bar handles project with no issues', async ({ page, baseURL }) => {\n    const data = await loginViaApi(baseURL!);\n\n    const proj = await createProjectViaApi(baseURL!, data.token, {\n      name: `No Issues ${Date.now()}`,\n      status: 'planned',\n    });\n\n    await loginAndGoToProject(page, baseURL!, proj.id);\n\n    // Verify 0 of 0 with no errors\n    await expect(page.getByTestId('project-header-progress-text')).toHaveText('0 of 0 issues completed', { timeout: 10000 });\n\n    // Verify the progress section is visible (no crash)\n    await expect(page.getByTestId('project-header-progress')).toBeVisible();\n  });\n});\n\ntest.describe('Project Header — Tabs', () => {\n  test('Header displays tabs for Issues and Overview', async ({ page, baseURL }) => {\n    const data = await loginViaApi(baseURL!);\n    const { projects } = await getProjectsData(baseURL!, data.token);\n    const v2 = projects.find((p) => p.name === 'V2 Launch')!;\n\n    await loginAndGoToProject(page, baseURL!, v2.id);\n\n    // Verify both tabs are visible\n    await expect(page.getByTestId('project-tab-issues')).toBeVisible();\n    await expect(page.getByTestId('project-tab-overview')).toBeVisible();\n\n    await expect(page.getByTestId('project-tab-issues')).toHaveText('Issues');\n    await expect(page.getByTestId('project-tab-overview')).toHaveText('Overview');\n\n    // Verify Issues tab is active by default\n    await expect(page.getByTestId('project-tab-issues')).toHaveClass(/project-header-tab-active/);\n    await expect(page.getByTestId('project-tab-overview')).not.toHaveClass(/project-header-tab-active/);\n  });\n\n  test('Clicking Overview tab switches to overview content', async ({ page, baseURL }) => {\n    const data = await loginViaApi(baseURL!);\n    const { projects } = await getProjectsData(baseURL!, data.token);\n    const v2 = projects.find((p) => p.name === 'V2 Launch')!;\n\n    await loginAndGoToProject(page, baseURL!, v2.id);\n\n    // Verify Issues tab is active initially\n    await expect(page.getByTestId('project-tab-issues')).toHaveClass(/project-header-tab-active/);\n\n    // Click Overview tab\n    await page.getByTestId('project-tab-overview').click();\n\n    // Verify Overview tab becomes active\n    await expect(page.getByTestId('project-tab-overview')).toHaveClass(/project-header-tab-active/, { timeout: 5000 });\n    await expect(page.getByTestId('project-tab-issues')).not.toHaveClass(/project-header-tab-active/);\n\n    // Verify overview content is displayed\n    await expect(page.getByTestId('project-overview-tab')).toBeVisible({ timeout: 10000 });\n    await expect(page.getByTestId('project-overview-description-section')).toBeVisible();\n    await expect(page.getByTestId('project-overview-milestones-section')).toBeVisible();\n    await expect(page.getByTestId('project-overview-metrics-section')).toBeVisible();\n  });\n});\n","numLines":371,"startLine":1,"totalLines":371}}}
