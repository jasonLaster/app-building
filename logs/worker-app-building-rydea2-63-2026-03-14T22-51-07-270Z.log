[2026-03-14T22:46:58.139Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012aPtnUkFqFNiNRgzfqsnHV","type":"tool_result","content":"     1→import { Link } from 'react-router-dom';\n     2→import type { Project } from '../slices/projectsSlice';\n     3→import './ProjectCard.css';\n     4→\n     5→const PROJECT_STATUS_CONFIG: Record<string, { label: string; className: string }> = {\n     6→  planned: { label: 'Planned', className: 'project-badge-planned' },\n     7→  in_progress: { label: 'In Progress', className: 'project-badge-in-progress' },\n     8→  completed: { label: 'Completed', className: 'project-badge-completed' },\n     9→  cancelled: { label: 'Cancelled', className: 'project-badge-cancelled' },\n    10→};\n    11→\n    12→function getInitials(name: string): string {\n    13→  return name.split(' ').map((n) => n[0]).join('').toUpperCase().slice(0, 2);\n    14→}\n    15→\n    16→interface ProjectCardProps {\n    17→  project: Project;\n    18→}\n    19→\n    20→export default function ProjectCard({ project }: ProjectCardProps) {\n    21→  const percentage = project.totalIssues > 0\n    22→    ? Math.round((project.completedIssues / project.totalIssues) * 100)\n    23→    : 0;\n    24→\n    25→  const statusCfg = PROJECT_STATUS_CONFIG[project.status] || PROJECT_STATUS_CONFIG.planned;\n    26→\n    27→  function formatTargetDate(dateStr: string): string {\n    28→    const d = new Date(dateStr + 'T00:00:00');\n    29→    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });\n    30→  }\n    31→\n    32→  return (\n    33→    <div className=\"project-card\" data-testid={`project-card-${project.id}`}>\n    34→      <div className=\"project-card-header\">\n    35→        <Link\n    36→          to={`/project/${project.id}`}\n    37→          className=\"project-card-name\"\n    38→          data-testid={`project-card-name-${project.id}`}\n    39→        >\n    40→          {project.name}\n    41→        </Link>\n    42→        <span\n    43→          className={`project-card-badge ${statusCfg.className}`}\n    44→          data-testid={`project-card-status-${project.id}`}\n    45→        >\n    46→          {statusCfg.label}\n    47→        </span>\n    48→      </div>\n    49→\n    50→      <div className=\"project-card-meta\">\n    51→        {/* Lead */}\n    52→        <div className=\"project-card-lead\" data-testid={`project-card-lead-${project.id}`}>\n    53→          {project.leadName ? (\n    54→            <>\n    55→              <span className=\"project-card-avatar\">\n    56→                {getInitials(project.leadName)}\n    57→              </span>\n    58→              <span className=\"project-card-lead-name\">{project.leadName}</span>\n    59→            </>\n    60→          ) : (\n    61→            <span className=\"project-card-no-lead\">No lead</span>\n    62→          )}\n    63→        </div>\n    64→\n    65→        {/* Target Date */}\n    66→        <div className=\"project-card-date\" data-testid={`project-card-date-${project.id}`}>\n    67→          {project.targetDate ? (\n    68→            <>\n    69→              <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n    70→                <rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\" />\n    71→                <line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\" />\n    72→                <line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\" />\n    73→                <line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\" />\n    74→              </svg>\n    75→              <span>{formatTargetDate(project.targetDate)}</span>\n    76→            </>\n    77→          ) : (\n    78→            <span className=\"project-card-no-date\">No target date</span>\n    79→          )}\n    80→        </div>\n    81→      </div>\n    82→\n    83→      {/* Progress Bar */}\n    84→      <div className=\"project-card-progress\" data-testid={`project-card-progress-${project.id}`}>\n    85→        <div className=\"project-card-progress-bar\">\n    86→          <div\n    87→            className={`project-card-progress-fill ${percentage === 100 ? 'project-card-progress-complete' : ''}`}\n    88→            style={{ width: `${percentage}%` }}\n    89→          />\n    90→        </div>\n    91→        <span className=\"project-card-progress-text\">\n    92→          {project.completedIssues}/{project.totalIssues} ({percentage}%)\n    93→        </span>\n    94→      </div>\n    95→\n    96→      {/* Team Icons */}\n    97→      {project.teams.length > 0 && (\n    98→        <div className=\"project-card-teams\" data-testid={`project-card-teams-${project.id}`}>\n    99→          {project.teams.map((team) => (\n   100→            <span\n   101→              key={team.id}\n   102→              className=\"project-card-team-icon\"\n   103→              title={team.name}\n   104→              data-testid={`project-card-team-${project.id}-${team.id}`}\n   105→            >\n   106→              {team.identifier.slice(0, 2)}\n   107→            </span>\n   108→          ))}\n   109→        </div>\n   110→      )}\n   111→    </div>\n   112→  );\n   113→}\n   114→"}]},"parent_tool_use_id":"toolu_01JpeAZFMzUGeqYHDKiAwDdN","session_id":"ad7a792d-8b72-46d6-abe8-c425bbbed9a4","uuid":"03c5833f-55f5-435f-9040-bd4f34c4cad9"}
