[2026-03-14T22:46:50.659Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011tbRWW4h6nU6TbxYMDTgoj","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions';\n     2→import { getSql } from './db';\n     3→\n     4→export default async function handler(req: Request, _context: Context) {\n     5→  if (req.method !== 'PUT') {\n     6→    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n     7→      status: 405,\n     8→      headers: { 'Content-Type': 'application/json' },\n     9→    });\n    10→  }\n    11→\n    12→  try {\n    13→    const authHeader = req.headers.get('Authorization');\n    14→    if (!authHeader?.startsWith('Bearer ')) {\n    15→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    16→        status: 401,\n    17→        headers: { 'Content-Type': 'application/json' },\n    18→      });\n    19→    }\n    20→\n    21→    const token = authHeader.slice(7);\n    22→    const sql = getSql();\n    23→\n    24→    const sessions = await sql`\n    25→      SELECT s.member_id FROM sessions s\n    26→      WHERE s.token = ${token} AND s.expires_at > NOW()\n    27→    `;\n    28→    const session = sessions[0];\n    29→    if (!session) {\n    30→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    31→        status: 401,\n    32→        headers: { 'Content-Type': 'application/json' },\n    33→      });\n    34→    }\n    35→\n    36→    const { issueIds, status, priority, assigneeId, labelId } = await req.json();\n    37→\n    38→    if (!issueIds || !Array.isArray(issueIds) || issueIds.length === 0) {\n    39→      return new Response(JSON.stringify({ error: 'issueIds array is required' }), {\n    40→        status: 400,\n    41→        headers: { 'Content-Type': 'application/json' },\n    42→      });\n    43→    }\n    44→\n    45→    if (status) {\n    46→      const validStatuses = ['backlog', 'todo', 'in_progress', 'in_review', 'done', 'cancelled'];\n    47→      if (!validStatuses.includes(status)) {\n    48→        return new Response(JSON.stringify({ error: 'Invalid status' }), {\n    49→          status: 400,\n    50→          headers: { 'Content-Type': 'application/json' },\n    51→        });\n    52→      }\n    53→      await sql`\n    54→        UPDATE issues SET status = ${status}, updated_at = NOW()\n    55→        WHERE id = ANY(${issueIds})\n    56→      `;\n    57→    }\n    58→\n    59→    if (priority) {\n    60→      const validPriorities = ['urgent', 'high', 'medium', 'low', 'none'];\n    61→      if (!validPriorities.includes(priority)) {\n    62→        return new Response(JSON.stringify({ error: 'Invalid priority' }), {\n    63→          status: 400,\n    64→          headers: { 'Content-Type': 'application/json' },\n    65→        });\n    66→      }\n    67→      await sql`\n    68→        UPDATE issues SET priority = ${priority}, updated_at = NOW()\n    69→        WHERE id = ANY(${issueIds})\n    70→      `;\n    71→    }\n    72→\n    73→    if (assigneeId !== undefined) {\n    74→      const assignee = assigneeId || null;\n    75→      await sql`\n    76→        UPDATE issues SET assignee_id = ${assignee}, updated_at = NOW()\n    77→        WHERE id = ANY(${issueIds})\n    78→      `;\n    79→    }\n    80→\n    81→    if (labelId) {\n    82→      for (const issueId of issueIds) {\n    83→        const existing = await sql`\n    84→          SELECT 1 FROM issue_labels WHERE issue_id = ${issueId} AND label_id = ${labelId}\n    85→        `;\n    86→        if (existing.length === 0) {\n    87→          await sql`\n    88→            INSERT INTO issue_labels (issue_id, label_id) VALUES (${issueId}, ${labelId})\n    89→          `;\n    90→        }\n    91→      }\n    92→    }\n    93→\n    94→    return new Response(JSON.stringify({ success: true }), {\n    95→      status: 200,\n    96→      headers: { 'Content-Type': 'application/json' },\n    97→    });\n    98→  } catch (err) {\n    99→    console.error('Bulk update issues error:', err);\n   100→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n   101→      status: 500,\n   102→      headers: { 'Content-Type': 'application/json' },\n   103→    });\n   104→  }\n   105→}\n   106→"}]},"parent_tool_use_id":"toolu_01JpeAZFMzUGeqYHDKiAwDdN","session_id":"ad7a792d-8b72-46d6-abe8-c425bbbed9a4","uuid":"91e0741c-9d43-4123-bbaf-7afbd354d34c"}
