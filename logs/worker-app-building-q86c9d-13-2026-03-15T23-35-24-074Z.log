[2026-03-15T22:57:50.539Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PTcy9xV1kJ4MWCS1rp97nq","type":"tool_result","content":"     1→import { useState } from 'react'\n     2→import { Grid } from 'lucide-react'\n     3→import type { PropertyImage } from '../slices/propertiesSlice'\n     4→\n     5→interface ImageGalleryProps {\n     6→  images: PropertyImage[]\n     7→}\n     8→\n     9→export default function ImageGallery({ images }: ImageGalleryProps) {\n    10→  const [mainIndex, setMainIndex] = useState(0)\n    11→\n    12→  if (images.length === 0) {\n    13→    return (\n    14→      <div data-testid=\"image-gallery\" className=\"rounded-xl bg-bg-secondary flex items-center justify-center h-[400px]\">\n    15→        <p className=\"text-text-secondary\">No images available</p>\n    16→      </div>\n    17→    )\n    18→  }\n    19→\n    20→  const mainImage = images[mainIndex]\n    21→\n    22→  if (images.length === 1) {\n    23→    return (\n    24→      <div data-testid=\"image-gallery\">\n    25→        <div className=\"relative rounded-xl overflow-hidden h-[400px]\">\n    26→          <img\n    27→            src={mainImage!.url}\n    28→            alt={mainImage!.caption || 'Property image'}\n    29→            className=\"w-full h-full object-cover\"\n    30→          />\n    31→        </div>\n    32→      </div>\n    33→    )\n    34→  }\n    35→\n    36→  const thumbnails = images.filter((_, i) => i !== mainIndex)\n    37→\n    38→  return (\n    39→    <div data-testid=\"image-gallery\" className=\"relative\">\n    40→      <div className=\"grid grid-cols-4 gap-2 h-[400px]\">\n    41→        <div className=\"col-span-2 row-span-2 relative cursor-pointer hover:opacity-95 transition-opacity rounded-l-xl overflow-hidden\">\n    42→          <img\n    43→            src={mainImage!.url}\n    44→            alt={mainImage!.caption || 'Property image'}\n    45→            className=\"w-full h-full object-cover\"\n    46→          />\n    47→        </div>\n    48→        {thumbnails.slice(0, 4).map((img, i) => {\n    49→          const originalIndex = images.indexOf(img)\n    50→          return (\n    51→            <div\n    52→              key={img.id}\n    53→              data-testid={`thumbnail-${img.id}`}\n    54→              className={`relative cursor-pointer overflow-hidden hover:opacity-90 transition-opacity ${\n    55→                i === 1 ? 'rounded-tr-xl' : i === 3 ? 'rounded-br-xl' : ''\n    56→              }`}\n    57→              onClick={() => setMainIndex(originalIndex)}\n    58→            >\n    59→              <img\n    60→                src={img.url}\n    61→                alt={img.caption || 'Property image'}\n    62→                className=\"w-full h-full object-cover\"\n    63→              />\n    64→            </div>\n    65→          )\n    66→        })}\n    67→      </div>\n    68→      {images.length > 5 && (\n    69→        <button className=\"absolute bottom-4 right-4 flex items-center gap-2 bg-white border border-text rounded-lg px-4 py-1.5 text-sm font-semibold text-text hover:bg-bg-secondary transition-colors cursor-pointer\">\n    70→          <Grid size={14} />\n    71→          Show all photos\n    72→        </button>\n    73→      )}\n    74→    </div>\n    75→  )\n    76→}\n    77→"}]},"parent_tool_use_id":"toolu_01BPcqBqZbXqT7EFKYDBcy5c","session_id":"6d86e976-1032-4e20-b927-fb9bc4791925","uuid":"29ef9668-cb46-4325-a03b-7a31d6d5fb36"}
