[2026-03-15T23:05:58.129Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UzFJJHC6wFvvXGNxZ68sJq","type":"tool_result","content":"     1→import { useEffect } from 'react'\n     2→import { useParams, useNavigate } from 'react-router-dom'\n     3→import { useSelector, useDispatch } from 'react-redux'\n     4→import { Loader2, Share, Heart } from 'lucide-react'\n     5→import type { RootState, AppDispatch } from '../store'\n     6→import { fetchPropertyDetail, clearPropertyDetail } from '../slices/propertyDetailSlice'\n     7→import ImageGallery from '../components/ImageGallery'\n     8→import PropertyHeader from '../components/PropertyHeader'\n     9→import PropertyInfo from '../components/PropertyInfo'\n    10→import PropertyDescription from '../components/PropertyDescription'\n    11→import AmenitiesList from '../components/AmenitiesList'\n    12→import BookingCard from '../components/BookingCard'\n    13→import ReviewsSection from '../components/ReviewsSection'\n    14→import HostInfoCard from '../components/HostInfoCard'\n    15→\n    16→export default function PropertyDetail() {\n    17→  const { id } = useParams<{ id: string }>()\n    18→  const dispatch = useDispatch<AppDispatch>()\n    19→  const navigate = useNavigate()\n    20→  const { property, loading, error } = useSelector((state: RootState) => state.propertyDetail)\n    21→\n    22→  useEffect(() => {\n    23→    if (id) {\n    24→      dispatch(fetchPropertyDetail(id))\n    25→    }\n    26→    return () => {\n    27→      dispatch(clearPropertyDetail())\n    28→    }\n    29→  }, [dispatch, id])\n    30→\n    31→  if (loading) {\n    32→    return (\n    33→      <div data-testid=\"property-detail-page\" className=\"p-6 max-sm:p-3 max-w-6xl mx-auto flex items-center justify-center min-h-[60vh]\">\n    34→        <Loader2 size={32} className=\"animate-spin text-primary\" />\n    35→      </div>\n    36→    )\n    37→  }\n    38→\n    39→  if (error || !property) {\n    40→    return (\n    41→      <div data-testid=\"property-detail-page\" className=\"p-6 max-sm:p-3 max-w-6xl mx-auto flex flex-col items-center justify-center min-h-[60vh] gap-4\">\n    42→        <p className=\"text-text-secondary\">{error || 'Property not found'}</p>\n    43→        <button\n    44→          className=\"text-primary font-semibold hover:underline cursor-pointer\"\n    45→          onClick={() => navigate('/')}\n    46→        >\n    47→          Back to listings\n    48→        </button>\n    49→      </div>\n    50→    )\n    51→  }\n    52→\n    53→  return (\n    54→    <div data-testid=\"property-detail-page\" className=\"px-6 max-sm:px-3 py-6 max-w-6xl mx-auto\">\n    55→      <div className=\"flex items-center justify-between mb-6\">\n    56→        <h1 className=\"text-[26px] font-semibold text-text leading-tight\">{property.title}</h1>\n    57→        <div className=\"flex items-center gap-4 shrink-0\">\n    58→          <button className=\"flex items-center gap-1.5 text-sm font-semibold text-text underline hover:no-underline cursor-pointer\">\n    59→            <Share size={16} />\n    60→            Share\n    61→          </button>\n    62→          <button className=\"flex items-center gap-1.5 text-sm font-semibold text-text underline hover:no-underline cursor-pointer\">\n    63→            <Heart size={16} />\n    64→            Save\n    65→          </button>\n    66→        </div>\n    67→      </div>\n    68→\n    69→      <ImageGallery images={property.images || []} />\n    70→\n    71→      <div className=\"mt-8 flex flex-col lg:flex-row gap-12\">\n    72→        <div className=\"flex-1 min-w-0\">\n    73→          <PropertyHeader property={property} />\n    74→          <PropertyInfo property={property} />\n    75→          <PropertyDescription description={property.description} />\n    76→          <AmenitiesList amenities={property.amenities || []} />\n    77→          <ReviewsSection reviews={property.reviews || []} />\n    78→          <HostInfoCard property={property} />\n    79→        </div>\n    80→\n    81→        <div className=\"w-full lg:w-[372px] shrink-0\">\n    82→          <BookingCard property={property} />\n    83→        </div>\n    84→      </div>\n    85→    </div>\n    86→  )\n    87→}\n    88→"}]},"parent_tool_use_id":"toolu_01FdKjeKjuTrjPk3rqnbUoXq","session_id":"6d86e976-1032-4e20-b927-fb9bc4791925","uuid":"52eba984-3fa3-46e7-9618-6782bf047bce"}
