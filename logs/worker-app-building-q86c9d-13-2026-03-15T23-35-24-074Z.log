[2]\n    49→if (!testFile) {\n    50→  console.error('Usage: npm run test <test-file>')\n    51→  process.exit(1)\n    52→}\n    53→\n    54→async function run() {\n    55→  const env = readEnv()\n    56→  const neonProjectId = env['NEON_PROJECT_ID'] || process.env['NEON_PROJECT_ID'] || ''\n    57→  const neonApiKey = process.env['NEON_API_KEY'] || ''\n    58→  const replayApiKey = process.env['RECORD_REPLAY_API_KEY'] || ''\n    59→\n    60→  if (!neonProjectId || !neonApiKey) {\n    61→    console.error('Missing NEON_PROJECT_ID or NEON_API_KEY')\n    62→    process.exit(1)\n    63→  }\n    64→\n    65→  // Step 1: Kill stale processes\n    66→  tryExec('pkill -f \"netlify dev\" 2>/dev/null || true', { stdio: 'ignore' })\n    67→  tryExec('pkill -f \"vite\" 2>/dev/null || true', { stdio: 'ignore' })\n    68→\n    69→  // Step 2: Clean up stale test branches\n    70→  try {\n    71→    const branchesResp = execSync(\n    72→      `curl -s \"https://console.neon.tech/api/v2/projects/${neonProjectId}/branches\" -H \"Authorization: Bearer ${neonApiKey}\"`,\n    73→      { encoding: 'utf-8', timeout: 15000 }\n    74→    )\n    75→    const branches = JSON.parse(branchesResp).branches || []\n    76→    for (const b of branches) {\n    77→      if (typeof b.name === 'string' && b.name.startsWith('test-run-')) {\n    78→        tryExec(\n    79→          `curl -s -X DELETE \"https://console.neon.tech/api/v2/projects/${neonProjectId}/branches/${b.id}\" -H \"Authorization: Bearer ${neonApiKey}\"`,\n    80→          { stdio: 'ignore', timeout: 10000 }\n    81→        )\n    82→        log(`Cleaned up stale branch: ${b.name}`)\n    83→      }\n    84→    }\n    85→  } catch { log('Warning: could not clean stale branches') }\n    86→\n    87→  // Step 3: Create ephemeral branch\n    88→  const branchName = `test-run-${Date.now()}`\n    89→  let branchId = ''\n    90→  let testDbUrl = ''\n    91→\n    92→  try {\n    93→    const resp = execSync(\n    94→      `curl -s -X POST \"https://console.neon.tech/api/v2/projects/${neonProjectId}/branches\" -H \"Authorization: Bearer ${neonApiKey}\" -H \"Content-Type: application/json\" -d '{\"branch\": {\"name\": \"${branchName}\"}, \"endpoints\": [{\"type\": \"read_write\"}]}'`,\n    95→      { encoding: 'utf-8', timeout: 30000 }\n    96→    )\n    97→    const data = JSON.parse(resp)\n    98→    branchId = data.branch?.id || ''\n    99→    const connUri = data.connection_uris?.[0]?.connection_uri\n   100→    if (connUri) {\n   101→      testDbUrl = connUri\n   102→    } else {\n   103→      const ep = data.endpoints?.[0]\n   104→      const host = ep?.host || ''\n   105→      const role = data.roles?.[0]?.name || 'neondb_owner'\n   106→      const pwResp = execSync(\n   107→        `curl -s \"https://console.neon.tech/api/v2/projects/${neonProjectId}/branches/${branchId}/roles/${role}/reveal_password\" -H \"Authorization: Bearer ${neonApiKey}\"`,\n   108→        { encoding: 'utf-8', timeout: 10000 }\n   109→      )\n   110→      const password = JSON.parse(pwResp).password || ''\n   111→      testDbUrl = `postgresql://${role}:${password}@${host}/neondb?sslmode=require`\n   112→    }\n   113→    log(`Created branch: ${branchName} (${branchId})`)\n   114→    log(`Test DB URL: ${testDbUrl.replace(/:[^:@]+@/, ':***@')}`)\n   115→  } catch (e) {\n   116→    log(`Failed to create branch: ${e}`)\n   117→    writeLog()\n   118→    console.error('Failed to create Neon test branch')\n   119→    process.exit(1)\n   120→  }\n   121→\n   122→  // Wait for branch to be ready\n   123→  await new Promise(resolve => setTimeout(resolve, 3000))\n   124→\n   125→  // Step 4: Initialize schema and seed\n   126→  try {\n   127→    await initSchema(testDbUrl)\n   128→    log('Schema initialized')\n   129→    await truncateAndSeed(testDbUrl)\n   130→    log('Database seeded')\n   131→  } catch (e) {\n   132→    log(`Schema/seed failed: ${e}`)\n   133→    writeLog()\n   134→    console.error('Schema/seed failed — see ' + logFile)\n   135→    cleanup(branchId, neonProjectId, neonApiKey)\n   136→    process.exit(1)\n   137→  }\n   138→\n   139→  // Step 5 & 6: Remove stale recordings\n   140→  tryExec('npx replayio remove --all 2>/dev/null || true', { stdio: 'ignore', cwd: appDir })"}]},"parent_tool_use_id":null,"session_id":"6d86e976-1032-4e20-b927-fb9bc4791925","uuid":"06765d73-66a4-4e32-b4bf-06229274b572","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/scripts/test.ts","content":"import { execSync } from 'child_process'\nimport { readFileSync, writeFileSync, mkdirSync, existsSync, readdirSync } from 'fs'\nimport { join } from 'path'\nimport { initSchema } from './schema'\nimport { truncateAndSeed } from './seed-db'\n\nconst appDir = join(import.meta.dirname, '..')\nconst logDir = join(appDir, 'logs')\nmkdirSync(logDir, { recursive: true })\n\n// Find next log number\nconst existingLogs = readdirSync(logDir).filter(f => f.startsWith('test-run-'))\nconst maxNum = existingLogs.reduce((max, f) => {\n  const m = f.match(/test-run-(\\d+)\\.log/)\n  return m ? Math.max(max, parseInt(m[1]!)) : max\n}, 0)\nconst logFile = join(logDir, `test-run-${maxNum + 1}.log`)\nlet logContent = ''\n\nfunction log(msg: string) {\n  logContent += msg + '\\n'\n}\n\nfunction writeLog() {\n  writeFileSync(logFile, logContent)\n}\n\nfunction readEnv(): Record<string, string> {\n  const envPath = join(appDir, '.env')\n  if (!existsSync(envPath)) return {}\n  const lines = readFileSync(envPath, 'utf-8').split('\\n')\n  const env: Record<string, string> = {}\n  for (const line of lines) {\n    const trimmed = line.trim()\n    if (!trimmed || trimmed.startsWith('#')) continue\n    const eqIdx = trimmed.indexOf('=')\n    if (eqIdx > 0) {\n      env[trimmed.slice(0, eqIdx)] = trimmed.slice(eqIdx + 1)\n    }\n  }\n  return env\n}\n\nfunction tryExec(cmd: string, opts?: Parameters<typeof execSync>[1]) {\n  try { execSync(cmd, opts) } catch { /* ignored */ }\n}\n\nconst testFile = process.argv[2]\nif (!testFile) {\n  console.error('Usage: npm run test <test-file>')\n  process.exit(1)\n}\n\nasync function run() {\n  const env = readEnv()\n  const neonProjectId = env['NEON_PROJECT_ID'] || process.env['NEON_PROJECT_ID'] || ''\n  const neonApiKey = process.env['NEON_API_KEY'] || ''\n  const replayApiKey = process.env['RECORD_REPLAY_API_KEY'] || ''\n\n  if (!neonProjectId || !neonApiKey) {\n    console.error('Missing NEON_PROJECT_ID or NEON_API_KEY')\n    process.exit(1)\n  }\n\n  // Step 1: Kill stale processes\n  tryExec('pkill -f \"netlify dev\" 2>/dev/null || true', { stdio: 'ignore' })\n  tryExec('pkill -f \"vite\" 2>/dev/null || true', { stdio: 'ignore' })\n\n  // Step 2: Clean up stale test branches\n  try {\n    const branchesResp = execSync(\n      `curl -s \"https://console.neon.tech/api/v2/projects/${neonProjectId}/branches\" -H \"Authorization: Bearer ${neonApiKey}\"`,\n      { encoding: 'utf-8', timeout: 15000 }\n    )\n    const branches = JSON.parse(branchesResp).branches || []\n    for (const b of branches) {\n      if (typeof b.name === 'string' && b.name.startsWith('test-run-')) {\n        tryExec(\n          `curl -s -X DELETE \"https://console.neon.tech/api/v2/projects/${neonProjectId}/branches/${b.id}\" -H \"Authorization: Bearer ${neonApiKey}\"`,\n          { stdio: 'ignore', timeout: 10000 }\n        )\n        log(`Cleaned up stale branch: ${b.name}`)\n      }\n    }\n  } catch { log('Warning: could not clean stale branches') }\n\n  // Step 3: Create ephemeral branch\n  const branchName = `test-run-${Date.now()}`\n  let branchId = ''\n  let testDbUrl = ''\n\n  try {\n    const resp = execSync(\n      `curl -s -X POST \"https://console.neon.tech/api/v2/projects/${neonProjectId}/branches\" -H \"Authorization: Bearer ${neonApiKey}\" -H \"Content-Type: application/json\" -d '{\"branch\": {\"name\": \"${branchName}\"}, \"endpoints\": [{\"type\": \"read_write\"}]}'`,\n      { encoding: 'utf-8', timeout: 30000 }\n    )\n    const data = JSON.parse(resp)\n    branchId = data.branch?.id || ''\n    const connUri = data.connection_uris?.[0]?.connection_uri\n    if (connUri) {\n      testDbUrl = connUri\n    } else {\n      const ep = data.endpoints?.[0]\n      const host = ep?.host || ''\n      const role = data.roles?.[0]?.name || 'neondb_owner'\n      const pwResp = execSync(\n        `curl -s \"https://console.neon.tech/api/v2/projects/${neonProjectId}/branches/${branchId}/roles/${role}/reveal_password\" -H \"Authorization: Bearer ${neonApiKey}\"`,\n        { encoding: 'utf-8', timeout: 10000 }\n      )\n      const password = JSON.parse(pwResp).password || ''\n      testDbUrl = `postgresql://${role}:${password}@${host}/neondb?sslmode=require`\n    }\n    log(`Created branch: ${branchName} (${branchId})`)\n    log(`Test DB URL: ${testDbUrl.replace(/:[^:@]+@/, ':***@')}`)\n  } catch (e) {\n    log(`Failed to create branch: ${e}`)\n    writeLog()\n    console.error('Failed to create Neon test branch')\n    process.exit(1)\n  }\n\n  // Wait for branch to be ready\n  await new Promise(resolve => setTimeout(resolve, 3000))\n\n  // Step 4: Initialize schema and seed\n  try {\n    await initSchema(testDbUrl)\n    log('Schema initialized')\n    await truncateAndSeed(testDbUrl)\n    log('Database seeded')\n  } catch (e) {\n    log(`Schema/seed failed: ${e}`)\n    writeLog()\n    console.error('Schema/seed failed — see ' + logFile)\n    cleanup(branchId, neonProjectId, neonApiKey)\n    process.exit(1)\n  }\n\n  // Step 5 & 6: Remove stale recordings\n  tryExec('npx replayio remove --all 2>/dev/null || true', { stdio: 'ignore', cwd: appDir })","numLines":140,"startLine":1,"totalLines":277}}}
