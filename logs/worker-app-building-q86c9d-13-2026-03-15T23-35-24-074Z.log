DbUrl.replace(/:[^:@]+@/, ':***@'));\n\n  // Write to .env\n  writeFileSync(join(__dirname, '.env'), \\`NEON_PROJECT_ID=\\${projectId}\\nDATABASE_URL=\\${testDbUrl}\\n\\`);\n  \n  // Start server\n  const server = require('child_process').spawn('npx', ['netlify', 'dev', '--offline', '--port', '8877', '--functions', './netlify/functions'], {\n    env: { ...process.env, PATH: '/tmp/fake-deno:' + process.env.PATH, DATABASE_URL: testDbUrl },\n    stdio: ['ignore', 'pipe', 'pipe'],\n    cwd: __dirname,\n  });\n\n  let serverLog = '';\n  server.stdout.on('data', d => serverLog += d.toString());\n  server.stderr.on('data', d => serverLog += d.toString());\n\n  await new Promise(r => setTimeout(r, 12000));\n\n  // Test with curl - get raw text\n  try {\n    const raw = execSync('curl -s -w \\\"\\\\n---HTTP_CODE:%{http_code}\\\" http://localhost:8877/api/properties/b2222222-2222-2222-2222-222222222222', { encoding: 'utf-8', timeout: 15000 });\n    console.log('RAW RESPONSE:', raw);\n  } catch (e) {\n    console.log('CURL ERROR:', e.message?.substring(0, 500));\n  }\n\n  // Print server log for diagnostics\n  console.log('\\\\nSERVER LOG (last 500 chars):', serverLog.slice(-500));\n\n  server.kill();\n  \n  writeFileSync(join(__dirname, '.env'), \\`NEON_PROJECT_ID=\\${projectId}\\n\\`);\n  execSync(\\`curl -s -X DELETE 'https://console.neon.tech/api/v2/projects/\\${projectId}/branches/\\${branchId}' -H 'Authorization: Bearer \\${apiKey}'\\`, { stdio: 'ignore', timeout: 10000 });\n  console.log('Done');\n}\nmain().catch(console.error);\n\" 2>&1","description":"Get full error text from API","timeout":120000},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":266,"cache_read_input_tokens":102293,"cache_creation":{"ephemeral_5m_input_tokens":266,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"global"},"context_management":null},"parent_tool_use_id":null,"session_i