[2026-03-15T00:11:50.327Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01N75eSnzKXZDNMCKoxn1Ckx","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test'\n     2→\n     3→// Sarah's property IDs (host a1111111)\n     4→const PROP_LOFT = 'b1111111-1111-1111-1111-111111111111'\n     5→const PROP_VILLA = 'b2222222-2222-2222-2222-222222222222'\n     6→const PROP_TOWNHOUSE = 'b5555555-5555-5555-5555-555555555555'\n     7→\n     8→const BASE = 'http://localhost:8888'\n     9→\n    10→async function loginAsHost(page: import('@playwright/test').Page) {\n    11→  await page.goto('/login')\n    12→  await page.getByTestId('login-email-input').fill('sarah@example.com')\n    13→  await page.getByTestId('login-submit-button').click()\n    14→  await expect(page).toHaveURL('/', { timeout: 30000 })\n    15→}\n    16→\n    17→async function goToHostDashboard(page: import('@playwright/test').Page) {\n    18→  await loginAsHost(page)\n    19→  await page.goto('/hosting')\n    20→  await expect(page.getByTestId('listings-tab')).toBeVisible({ timeout: 30000 })\n    21→}\n    22→\n    23→test.describe('Host Dashboard - Listings Tab', () => {\n    24→  test.beforeEach(async ({ request }) => {\n    25→    // Reset all properties to active state before each test\n    26→    await request.put(`${BASE}/api/properties/${PROP_LOFT}`, { data: { is_active: true } })\n    27→    await request.put(`${BASE}/api/properties/${PROP_VILLA}`, { data: { is_active: true } })\n    28→    await request.put(`${BASE}/api/properties/${PROP_TOWNHOUSE}`, { data: { is_active: true } })\n    29→  })\n    30→  test('Listings tab displays host\\'s properties in a grid', async ({ page }) => {\n    31→    await goToHostDashboard(page)\n    32→\n    33→    // Sarah has 3 properties\n    34→    const cards = page.locator('[data-testid^=\"listing-card-\"]')\n    35→    await expect(cards).toHaveCount(3, { timeout: 15000 })\n    36→\n    37→    // Verify each property card is visible\n    38→    await expect(page.getByTestId(`listing-card-${PROP_LOFT}`)).toBeVisible()\n    39→    await expect(page.getByTestId(`listing-card-${PROP_VILLA}`)).toBeVisible()\n    40→    await expect(page.getByTestId(`listing-card-${PROP_TOWNHOUSE}`)).toBeVisible()\n    41→  })\n    42→\n    43→  test('Listing card shows property details', async ({ page }) => {\n    44→    await goToHostDashboard(page)\n    45→\n    46→    // Check the Loft card details: title, price, city, rating, review count, active badge\n    47→    const loftCard = page.getByTestId(`listing-card-${PROP_LOFT}`)\n    48→    await expect(loftCard).toBeVisible({ timeout: 15000 })\n    49→    await expect(loftCard).toContainText('Cozy Downtown Loft with City Views')\n    50→    await expect(loftCard).toContainText('$150')\n    51→    await expect(loftCard).toContainText('New York')\n    52→    await expect(loftCard).toContainText('5.0')\n    53→    await expect(loftCard).toContainText('1 reviews')\n    54→\n    55→    const statusBadge = page.getByTestId(`listing-status-${PROP_LOFT}`)\n    56→    await expect(statusBadge).toHaveText('Active')\n    57→  })\n    58→\n    59→  test('Listing card has Edit button that navigates to property detail', async ({ page }) => {\n    60→    await goToHostDashboard(page)\n    61→\n    62→    const editBtn = page.getByTestId(`listing-edit-${PROP_LOFT}`)\n    63→    await expect(editBtn).toBeVisible({ timeout: 15000 })\n    64→    await editBtn.click()\n    65→\n    66→    await expect(page).toHaveURL(`/properties/${PROP_LOFT}`, { timeout: 30000 })\n    67→  })\n    68→\n    69→  test('Listing card has Deactivate button for active properties', async ({ page }) => {\n    70→    await goToHostDashboard(page)\n    71→\n    72→    // Click Deactivate on the Loft\n    73→    const deactivateBtn = page.getByTestId(`listing-deactivate-${PROP_LOFT}`)\n    74→    await expect(deactivateBtn).toBeVisible({ timeout: 15000 })\n    75→    await deactivateBtn.click()\n    76→\n    77→    // Confirmation dialog should appear\n    78→    const dialog = page.getByTestId('deactivate-dialog')\n    79→    await expect(dialog).toBeVisible({ timeout: 15000 })\n    80→    await expect(dialog).toContainText('Are you sure you want to deactivate this listing?')"}]},"parent_tool_use_id":"toolu_01CpwXuL5JNYmpVrR7uqp3T5","session_id":"ed4f3c62-e32b-47e8-ad73-d7f458349ef4","uuid":"80967aa1-e074-4063-8169-b0f68af9649d"}
