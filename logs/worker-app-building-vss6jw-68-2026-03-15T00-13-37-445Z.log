 37→    // Check pending booking (Emma's e3333333)\n    38→    await loginAs(page, 'emma@example.com')\n    39→    await page.goto('/trips')\n    40→    await expect(page.getByTestId('my-trips-page')).toBeVisible({ timeout: 30000 })\n    41→\n    42→    // Upcoming tab: e3333333 is pending, e6666666 is confirmed\n    43→    await expect(page.getByTestId('trip-card-e3333333-3333-3333-3333-333333333333')).toBeVisible({ timeout: 30000 })\n    44→    await expect(page.getByTestId('review-button-e3333333-3333-3333-3333-333333333333')).not.toBeVisible()\n    45→\n    46→    await expect(page.getByTestId('trip-card-e6666666-6666-6666-6666-666666666666')).toBeVisible()\n    47→    await expect(page.getByTestId('review-button-e6666666-6666-6666-6666-666666666666')).not.toBeVisible()\n    48→\n    49→    // Check cancelled booking (Alex's e5555555)\n    50→    await loginAs(page, 'alex@example.com')\n    51→    await page.goto('/trips')\n    52→    await expect(page.getByTestId('my-trips-page')).toBeVisible({ timeout: 30000 })\n    53→\n    54→    await page.getByTestId('tab-cancelled').click()\n    55→    await expect(page.getByTestId('trip-card-e5555555-5555-5555-5555-555555555555')).toBeVisible({ timeout: 30000 })\n    56→    await expect(page.getByTestId('review-button-e5555555-5555-5555-5555-555555555555')).not.toBeVisible()\n    57→  })\n    58→\n    59→  test('Trip cards are ordered by check-in date', async ({ page }) => {\n    60→    // Emma has two upcoming bookings:\n    61→    // e3333333: check_in 2026-05-10 (Mountain Cabin)\n    62→    // e6666666: check_in 2026-06-15 (Historic Townhouse)\n    63→    // They should appear in chronological order: e3333333 first, then e6666666\n    64→    await loginAs(page, 'emma@example.com')\n    65→    await page.goto('/trips')\n    66→    await expect(page.getByTestId('my-trips-page')).toBeVisible({ timeout: 30000 })\n    67→\n    68→    // Both cards should be visible in Upcoming tab\n    69→    await expect(page.getByTestId('trip-card-e3333333-3333-3333-3333-333333333333')).toBeVisible({ timeout: 30000 })\n    70→    await expect(page.getByTestId('trip-card-e6666666-6666-6666-6666-666666666666')).toBeVisible()\n    71→\n    72→    // Get all trip cards in the list and verify order\n    73→    const tripCards = page.getByTestId('trips-list').locator('[data-testid^=\"trip-card-\"]')\n    74→    await expect(tripCards).toHaveCount(2, { timeout: 30000 })\n    75→\n    76→    // First card should be the earlier check-in (May 10 - Mountain Cabin)\n    77→    await expect(tripCards.nth(0)).toContainText('May 10, 2026')\n    78→    // Second card should be the later check-in (Jun 15 - Historic Townhouse)\n    79→    await expect(tripCards.nth(1)).toContainText('Jun 15, 2026')\n    80→  })\n    81→})\n    82→"}]},"parent_tool_use_id":null,"session_id":"ed4f3c62-e32b-47e8-ad73-d7f458349ef4","uuid":"cdc3e2b3-45d6-426a-b6a8-2b0f013b41ab","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/tests/my-trips-review-order.spec.ts","content":"import { test, expect } from '@playwright/test'\n\nasync function loginAs(page: import('@playwright/test').Page, email: string) {\n  await page.goto('/login')\n  await page.getByTestId('login-email-input').fill(email)\n  await page.getByTestId('login-submit-button').click()\n  await expect(page).toHaveURL('/', { timeout: 30000 })\n}\n\ntest.describe('My Trips - Review & Ordering', () => {\n  test('Clicking Write Review button navigates to review page', async ({ page }) => {\n    // Delete Alex's review for e4444444 so the Write Review button appears\n    const reviewsRes = await page.request.get('/api/reviews?property_id=b4444444-4444-4444-4444-444444444444')\n    const reviews = await reviewsRes.json()\n    for (const review of reviews) {\n      await page.request.delete(`/api/reviews/${review.id}`)\n    }\n\n    await loginAs(page, 'alex@example.com')\n    await page.goto('/trips')\n    await expect(page.getByTestId('my-trips-page')).toBeVisible({ timeout: 30000 })\n\n    await page.getByTestId('tab-past').click()\n\n    // e4444444 is completed without a review now\n    const reviewBtn = page.getByTestId('review-button-e4444444-4444-4444-4444-444444444444')\n    await expect(reviewBtn).toBeVisible({ timeout: 30000 })\n\n    await reviewBtn.click()\n\n    // Should navigate to the review page for this booking\n    await expect(page).toHaveURL(/\\/trips\\/e4444444-4444-4444-4444-444444444444\\/review/, { timeout: 30000 })\n  })\n\n  test('Write Review button does not appear on pending, confirmed, or cancelled bookings', async ({ page }) => {\n    test.slow()\n    // Check pending booking (Emma's e3333333)\n    await loginAs(page, 'emma@example.com')\n    await page.goto('/trips')\n    await expect(page.getByTestId('my-trips-page')).toBeVisible({ timeout: 30000 })\n\n    // Upcoming tab: e3333333 is pending, e6666666 is confirmed\n    await expect(page.getByTestId('trip-card-e3333333-3333-3333-3333-333333333333')).toBeVisible({ timeout: 30000 })\n    await expect(page.getByTestId('review-button-e3333333-3333-3333-3333-333333333333')).not.toBeVisible()\n\n    await expect(page.getByTestId('trip-card-e6666666-6666-6666-6666-666666666666')).toBeVisible()\n    await expect(page.getByTestId('review-button-e6666666-6666-6666-6666-666666666666')).not.toBeVisible()\n\n    // Check cancelled booking (Alex's e5555555)\n    await loginAs(page, 'alex@example.com')\n    await page.goto('/trips')\n    await expect(page.getByTestId('my-trips-page')).toBeVisible({ timeout: 30000 })\n\n    await page.getByTestId('tab-cancelled').click()\n    await expect(page.getByTestId('trip-card-e5555555-5555-5555-5555-555555555555')).toBeVisible({ timeout: 30000 })\n    await expect(page.getByTestId('review-button-e5555555-5555-5555-5555-555555555555')).not.toBeVisible()\n  })\n\n  test('Trip cards are ordered by check-in date', async ({ page }) => {\n    // Emma has two upcoming bookings:\n    // e3333333: check_in 2026-05-10 (Mountain Cabin)\n    // e6666666: check_in 2026-06-15 (Historic Townhouse)\n    // They should appear in chronological order: e3333333 first, then e6666666\n    await loginAs(page, 'emma@example.com')\n    await page.goto('/trips')\n    await expect(page.getByTestId('my-trips-page')).toBeVisible({ timeout: 30000 })\n\n    // Both cards should be visible in Upcoming tab\n    await expect(page.getByTestId('trip-card-e3333333-3333-3333-3333-333333333333')).toBeVisible({ timeout: 30000 })\n    await expect(page.getByTestId('trip-card-e6666666-6666-6666-6666-666666666666')).toBeVisible()\n\n    // Get all trip cards in the list and verify order\n    const tripCards = page.getByTestId('trips-list').locator('[data-testid^=\"trip-card-\"]')\n    await expect(tripCards).toHaveCount(2, { timeout: 30000 })\n\n    // First card should be the earlier check-in (May 10 - Mountain Cabin)\n    await expect(tripCards.nth(0)).toContainText('May 10, 2026')\n    // Second card should be the later check-in (Jun 15 - Historic Townhouse)\n    await expect(tripCards.nth(1)).toContainText('Jun 15, 2026')\n  })\n})\n","numLines":82,"startLine":1,"totalLines":82}}}
