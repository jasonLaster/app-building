[2026-03-16T03:58:25.401Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013ipPvGY2Gg9T2wsV2bVdb8","type":"tool_result","content":"     1→import { useEffect } from 'react'\n     2→import { useParams, useNavigate } from 'react-router-dom'\n     3→import { useSelector, useDispatch } from 'react-redux'\n     4→import { Loader2, Share, Heart } from 'lucide-react'\n     5→import type { RootState, AppDispatch } from '../store'\n     6→import { fetchPropertyDetail, clearPropertyDetail } from '../slices/propertyDetailSlice'\n     7→import ImageGallery from '../components/ImageGallery'\n     8→import PropertyHeader from '../components/PropertyHeader'\n     9→import PropertyInfo from '../components/PropertyInfo'\n    10→import PropertyDescription from '../components/PropertyDescription'\n    11→import AmenitiesList from '../components/AmenitiesList'\n    12→import BookingCard from '../components/BookingCard'\n    13→import ReviewsSection from '../components/ReviewsSection'\n    14→import HostInfoCard from '../components/HostInfoCard'\n    15→\n    16→export default function PropertyDetail() {\n    17→  const { id } = useParams<{ id: string }>()\n    18→  const dispatch = useDispatch<AppDispatch>()\n    19→  const navigate = useNavigate()\n    20→  const { property, loading, error } = useSelector((state: RootState) => state.propertyDetail)\n    21→\n    22→  useEffect(() => {\n    23→    if (id) {\n    24→      dispatch(fetchPropertyDetail(id))\n    25→    }\n    26→    return () => {\n    27→      dispatch(clearPropertyDetail())\n    28→    }\n    29→  }, [dispatch, id])\n    30→\n    31→  if (loading) {\n    32→    return (\n    33→      <main data-testid=\"property-detail-page\" className=\"p-6 max-sm:p-3 max-w-[1120px] mx-auto flex items-center justify-center min-h-[60vh]\" aria-busy=\"true\">\n    34→        <Loader2 size={32} className=\"animate-spin text-primary\" aria-hidden=\"true\" />\n    35→        <span className=\"sr-only\">Loading property details</span>\n    36→      </main>\n    37→    )\n    38→  }\n    39→\n    40→  if (error || !property) {\n    41→    return (\n    42→      <main data-testid=\"property-detail-page\" className=\"p-6 max-sm:p-3 max-w-[1120px] mx-auto flex flex-col items-center justify-center min-h-[60vh] gap-4\">\n    43→        <p className=\"text-text-secondary\" role=\"alert\">{error || 'Property not found'}</p>\n    44→        <button\n    45→          className=\"text-primary font-semibold hover:underline cursor-pointer\"\n    46→          onClick={() => navigate('/')}\n    47→        >\n    48→          Back to listings\n    49→        </button>\n    50→      </main>\n    51→    )\n    52→  }\n    53→\n    54→  return (\n    55→    <main data-testid=\"property-detail-page\" className=\"px-6 max-sm:px-3 py-6 max-w-[1120px] mx-auto\">\n    56→      {/* Title section above images - Airbnb style */}\n    57→      <h1 className=\"text-[26px] font-semibold text-text mb-1\">{property.title}</h1>\n    58→      <div className=\"flex items-center justify-between mb-6\">\n    59→        <p className=\"text-sm text-text underline cursor-pointer\">\n    60→          {property.city}, {property.country}\n    61→        </p>\n    62→        <div className=\"flex items-center gap-4 shrink-0\">\n    63→          <button className=\"flex items-center gap-1.5 text-sm font-semibold text-text underline hover:no-underline cursor-pointer\">\n    64→            <Share size={16} aria-hidden=\"true\" />\n    65→            Share\n    66→          </button>\n    67→          <button className=\"flex items-center gap-1.5 text-sm font-semibold text-text underline hover:no-underline cursor-pointer\">\n    68→            <Heart size={16} aria-hidden=\"true\" />\n    69→            Save\n    70→          </button>\n    71→        </div>\n    72→      </div>\n    73→\n    74→      <ImageGallery images={property.images || []} />\n    75→\n    76→      <div className=\"mt-10 flex flex-col lg:flex-row gap-12\">\n    77→        <div className=\"flex-1 min-w-0\">\n    78→          <PropertyHeader property={property} />\n    79→          <PropertyInfo property={property} />\n    80→          <PropertyDescription description={property.description} />\n    81→          <AmenitiesList amenities={property.amenities || []} />\n    82→          <ReviewsSection reviews={property.reviews || []} />\n    83→          <HostInfoCard property={property} />\n    84→        </div>\n    85→\n    86→        <div className=\"w-full lg:w-[372px] shrink-0\">\n    87→          <BookingCard property={property} />\n    88→        </div>\n    89→      </div>\n    90→    </main>\n    91→  )\n    92→}\n    93→"}]},"parent_tool_use_id":"toolu_01EXSeAogz8QKs7dquJLCEz4","session_id":"2eb78e56-88a3-4b5b-b71a-173ede6214fd","uuid":"c8ec51a8-bfd8-4c6f-b85c-69877428991c"}
