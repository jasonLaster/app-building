[2026-03-16T03:58:45.234Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017YSJkrxByUzZW4hMfyGNcr","type":"tool_result","content":"     1→import { useState, useEffect, useCallback, useRef } from 'react'\n     2→import { useSelector, useDispatch } from 'react-redux'\n     3→import { useNavigate } from 'react-router-dom'\n     4→import { ChevronLeft, ChevronRight, ChevronDown } from 'lucide-react'\n     5→import type { RootState, AppDispatch } from '../store'\n     6→import type { Property } from '../slices/propertiesSlice'\n     7→import { createBooking, clearBookingError } from '../slices/bookingsSlice'\n     8→\n     9→interface BookingCardProps {\n    10→  property: Property\n    11→}\n    12→\n    13→interface BookedRange {\n    14→  check_in: string\n    15→  check_out: string\n    16→}\n    17→\n    18→function getDaysInMonth(year: number, month: number): number {\n    19→  return new Date(year, month + 1, 0).getDate()\n    20→}\n    21→\n    22→function getFirstDayOfWeek(year: number, month: number): number {\n    23→  return new Date(year, month, 1).getDay()\n    24→}\n    25→\n    26→function formatDateStr(year: number, month: number, day: number): string {\n    27→  return `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`\n    28→}\n    29→\n    30→function isDateBooked(dateStr: string, bookedRanges: BookedRange[]): boolean {\n    31→  for (const range of bookedRanges) {\n    32→    if (dateStr >= range.check_in && dateStr < range.check_out) {\n    33→      return true\n    34→    }\n    35→  }\n    36→  return false\n    37→}\n    38→\n    39→function isDateInPast(dateStr: string, todayStr: string): boolean {\n    40→  return dateStr < todayStr\n    41→}\n    42→\n    43→const MONTH_NAMES = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']\n    44→const DAY_NAMES = ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa']\n    45→\n    46→function CalendarMonth({\n    47→  year,\n    48→  month,\n    49→  todayStr,\n    50→  bookedRanges,\n    51→  checkIn,\n    52→  checkOut,\n    53→  onSelectDate,\n    54→}: {\n    55→  year: number\n    56→  month: number\n    57→  todayStr: string\n    58→  bookedRanges: BookedRange[]\n    59→  checkIn: string\n    60→  checkOut: string\n    61→  onSelectDate: (dateStr: string) => void\n    62→}) {\n    63→  const daysInMonth = getDaysInMonth(year, month)\n    64→  const firstDay = getFirstDayOfWeek(year, month)\n    65→\n    66→  const cells: (number | null)[] = []\n    67→  for (let i = 0; i < firstDay; i++) cells.push(null)\n    68→  for (let d = 1; d <= daysInMonth; d++) cells.push(d)\n    69→\n    70→  return (\n    71→    <div role=\"grid\" aria-label={`${MONTH_NAMES[month]} ${year}`}>\n    72→      <div className=\"text-center text-sm font-semibold text-text mb-3\">\n    73→        {MONTH_NAMES[month]} {year}\n    74→      </div>\n    75→      <div className=\"grid grid-cols-7 gap-0\">\n    76→        {DAY_NAMES.map((d) => (\n    77→          <div key={d} className=\"text-center text-xs font-semibold text-text-secondary py-1\" role=\"columnheader\">\n    78→            {d}\n    79→          </div>\n    80→        ))}\n    81→        {cells.map((day, idx) => {\n    82→          if (day === null) {\n    83→            return <div key={`empty-${idx}`} className=\"h-10\" />\n    84→          }\n    85→          const dateStr = formatDateStr(year, month, day)\n    86→          const isPast = isDateInPast(dateStr, todayStr)\n    87→          const booked = isDateBooked(dateStr, bookedRanges)\n    88→          const disabled = isPast || booked\n    89→          const isCheckIn = dateStr === checkIn\n    90→          const isCheckOut = dateStr === checkOut\n    91→          const isSelected = isCheckIn || isCheckOut\n    92→          const inRange = checkIn && checkOut && dateStr > checkIn && dateStr < checkOut\n    93→\n    94→          return (\n    95→            <button\n    96→              key={dateStr}\n    97→              data-testid={`calendar-day-${dateStr}`}\n    98→              disabled={disabled}\n    99→              onClick={() => !disabled && onSelectDate(dateStr)}\n   100→              aria-label={`${MONTH_NAMES[month]} ${day}, ${year}${isCheckIn ? ' (check-in)' : ''}${isCheckOut ? ' (checkout)' : ''}${booked ? ' (unavailable)' : ''}${isPast ? ' (past date)' : ''}`}\n   101→              aria-pressed={isSelected}\n   102→              className={`h-10 w-full text-sm rounded-full transition-colors cursor-pointer\n   103→                ${disabled ? 'text-border line-through cursor-not-allowed' : 'hover:bg-bg-secondary text-text'}\n   104→                ${isSelected ? 'bg-text text-white hover:bg-text' : ''}\n   105→                ${inRange ? 'bg-bg-secondary' : ''}\n   106→                ${booked ? 'bg-bg-secondary' : ''}\n   107→              `}\n   108→            >\n   109→              {day}\n   110→            </button>\n   111→          )\n   112→        })}\n   113→      </div>\n   114→    </div>\n   115→  )\n   116→}\n   117→\n   118→export default function BookingCard({ property }: BookingCardProps) {\n   119→  const dispatch = useDispatch<AppDispatch>()\n   120→  const navigate = useNavigate()\n   121→  const currentUser = useSelector((state: RootState) => state.auth.currentUser)\n   122→  const { loading, error } = useSelector((state: RootState) => state.bookings)\n   123→\n   124→  const [checkIn, setCheckIn] = useState('')\n   125→  const [checkOut, setCheckOut] = useState('')\n   126→  const [guests, setGuests] = useState(1)\n   127→  const [success, setSuccess] = useState(false)\n   128→  const [calendarOpen, setCalendarOpen] = useState(false)\n   129→  const [bookedRanges, setBookedRanges] = useState<BookedRange[]>([])\n   130→\n   131→  const now = new Date()\n   132→  const todayStr = formatDateStr(now.getFullYear(), now.getMonth(), now.getDate())\n   133→  const [calMonth, setCalMonth] = useState(now.getMonth())\n   134→  const [calYear, setCalYear] = useState(now.getFullYear())\n   135→  const [guestDropdownOpen, setGuestDropdownOpen] = useState(false)\n   136→  const guestDropdownRef = useRef<HTMLDivElement>(null)\n   137→\n   138→  useEffect(() => {\n   139→    function handleClickOutside(e: MouseEvent) {\n   140→      if (guestDropdownRef.current && !guestDropdownRef.current.contains(e.target as Node)) {\n   141→        setGuestDropdownOpen(false)\n   142→      }\n   143→    }\n   144→    document.addEventListener('mousedown', handleClickOutside)\n   145→    return () => document.removeEventListener('mousedown', handleClickOutside)\n   146→  }, [])\n   147→\n   148→  const isOwnProperty = currentUser?.id === property.host_id\n   149→\n   150→  useEffect(() => {\n   151→    fetch(`/api/bookings?property_id=${property.id}`)\n   152→      .then((r) => r.json())\n   153→      .then((data) => {\n   154→        if (Array.isArray(data)) {\n   155→          setBookedRanges(data.map((b: { check_in: string; check_out: string }) => ({\n   156→            check_in: b.check_in.slice(0, 10),\n   157→            check_out: b.check_out.slice(0, 10),\n   158→          })))\n   159→        }\n   160→      })\n   161→      .catch(() => {})\n   162→  }, [property.id])\n   163→\n   164→  const handleSelectDate = useCallback((dateStr: string) => {\n   165→    if (!checkIn || (checkIn && checkOut)) {\n   166→      setCheckIn(dateStr)\n   167→      setCheckOut('')\n   168→    } else {\n   169→      if (dateStr <= checkIn) {\n   170→        setCheckIn(dateStr)\n   171→        setCheckOut('')\n   172→      } else {\n   173→        // Check if any booked date is between checkIn and this date\n   174→        const hasBlockedInRange = bookedRanges.some(\n   175→          (r) => r.check_in < dateStr && r.check_out > checkIn\n   176→        )\n   177→        if (hasBlockedInRange) {\n   178→          setCheckIn(dateStr)\n   179→          setCheckOut('')\n   180→        } else {\n   181→          setCheckOut(dateStr)\n   182→        }\n   183→      }\n   184→    }\n   185→  }, [checkIn, checkOut, bookedRanges])\n   186→\n   187→  const handlePrevMonth = () => {\n   188→    if (calMonth === 0) {\n   189→      setCalMonth(11)\n   190→      setCalYear(calYear - 1)\n   191→    } else {\n   192→      setCalMonth(calMonth - 1)\n   193→    }\n   194→  }\n   195→\n   196→  const handleNextMonth = () => {\n   197→    if (calMonth === 11) {\n   198→      setCalMonth(0)\n   199→      setCalYear(calYear + 1)\n   200→    } else {\n   201→      setCalMonth(calMonth + 1)\n   202→    }\n   203→  }\n   204→\n   205→  const nextMonth = calMonth === 11 ? 0 : calMonth + 1\n   206→  const nextYear = calMonth === 11 ? calYear + 1 : calYear\n   207→\n   208→  const nights =\n   209→    checkIn && checkOut\n   210→      ? Math.max(0, Math.round((new Date(checkOut).getTime() - new Date(checkIn).getTime()) / (1000 * 60 * 60 * 24)))\n   211→      : 0\n   212→\n   213→  const nightlyTotal = nights * Number(property.price_per_night)\n   214→  const cleaningFee = Number(property.cleaning_fee)\n   215→  const total = nightlyTotal + cleaningFee\n   216→\n   217→  const canReserve = checkIn && checkOut && nights > 0 && !isOwnProperty && currentUser && !loading\n   218→\n   219→  const handleReserve = async () => {\n   220→    if (!currentUser) {\n   221→      navigate('/login')\n   222→      return\n   223→    }\n   224→    if (!checkIn || !checkOut || isOwnProperty) return\n   225→\n   226→    dispatch(clearBookingError())\n   227→    const result = await dispatch(\n   228→      createBooking({\n   229→        property_id: property.id,\n   230→        guest_id: currentUser.id,\n   231→        check_in: checkIn,\n   232→        check_out: checkOut,\n   233→        num_guests: guests,\n   234→        total_price: total,\n   235→      })\n   236→    )\n   237→    if (createBooking.fulfilled.match(result)) {\n   238→      setSuccess(true)\n   239→      setTimeout(() => navigate('/trips'), 1500)\n   240→    }\n   241→  }\n   242→\n   243→  const formatDisplayDate = (d: string) => {\n   244→    if (!d) return ''\n   245→    const date = new Date(d + 'T00:00:00')\n   246→    return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })\n   247→  }\n   248→\n   249→  return (\n   250→    <aside data-testid=\"booking-card\" className=\"border border-border rounded-xl p-6 shadow-lg sticky top-[96px]\" aria-label=\"Booking\">\n   251→      {nights > 0 ? (\n   252→        <div className=\"flex items-baseline gap-1 mb-5\">\n   253→          <span className=\"text-[22px] font-semibold text-text\">${Number(property.price_per_night).toFixed(0)}</span>\n   254→          <span className=\"text-text-secondary\">night</span>\n   255→        </div>\n   256→      ) : (\n   257→        <p className=\"text-[22px] font-semibold text-text mb-5\">Add dates for prices</p>\n   258→      )}\n   259→\n   260→      <div className=\"border border-border rounded-lg overflow-hidden mb-4\">\n   261→        <button\n   262→          type=\"button\"\n   263→          className=\"grid grid-cols-2 cursor-pointer w-full text-left bg-transparent border-0 p-0\"\n   264→          onClick={() => setCalendarOpen(!calendarOpen)}\n   265→          aria-expanded={calendarOpen}\n   266→          aria-label=\"Select check-in and checkout dates\"\n   267→        >\n   268→          <div className=\"p-3 border-r border-border\">\n   269→            <span className=\"block text-[10px] font-bold text-text uppercase tracking-wide\">Check-in</span>\n   270→            <p data-testid=\"booking-checkin\" className=\"text-sm text-text-secondary mt-0.5\">\n   271→              {checkIn ? formatDisplayDate(checkIn) : 'Add date'}\n   272→            </p>\n   273→          </div>\n   274→          <div className=\"p-3\">\n   275→            <span className=\"block text-[10px] font-bold text-text uppercase tracking-wide\">Checkout</span>\n   276→            <p data-testid=\"booking-checkout\" className=\"text-sm text-text-secondary mt-0.5\">\n   277→              {checkOut ? formatDisplayDate(checkOut) : 'Add date'}\n   278→            </p>\n   279→          </div>\n   280→        </button>\n   281→        <div className=\"border-t border-border p-3 relative\" ref={guestDropdownRef}>\n   282→          <span id=\"guests-label\" className=\"block text-[10px] font-bold text-text uppercase tracking-wide\">Guests</span>\n   283→          <button\n   284→            data-testid=\"booking-guests\"\n   285→            data-value={String(guests)}\n   286→            type=\"button\"\n   287→            onClick={() => setGuestDropdownOpen(!guestDropdownOpen)}\n   288→            aria-expanded={guestDropdownOpen}\n   289→            aria-haspopup=\"listbox\"\n   290→            aria-labelledby=\"guests-label\"\n   291→            className=\"w-full flex items-center justify-between text-sm text-text bg-transparent outline-none mt-0.5 cursor-pointer\"\n   292→          >\n   293→            <span>{guests} {guests === 1 ? 'guest' : 'guests'}</span>\n   294→            <ChevronDown size={16} aria-hidden=\"true\" className={`transition-transform ${guestDropdownOpen ? 'rotate-180' : ''}`} />\n   295→          </button>\n   296→          {guestDropdownOpen && (\n   297→            <div data-testid=\"booking-guests-dropdown\" role=\"listbox\" aria-label=\"Number of guests\" className=\"absolute left-0 right-0 top-full mt-1 bg-bg border border-border rounded-lg shadow-lg z-50 max-h-48 overflow-y-auto\">\n   298→              {Array.from({ length: property.max_guests }, (_, i) => i + 1).map((n) => (\n   299→                <button\n   300→                  key={n}\n   301→                  data-testid={`guest-option-${n}`}\n   302→                  type=\"button\"\n   303→                  role=\"option\"\n   304→                  aria-selected={guests === n}\n   305→                  onClick={() => { setGuests(n); setGuestDropdownOpen(false) }}\n   306→                  className={`w-full text-left px-3 py-2 text-sm cursor-pointer transition-colors\n   307→                    ${guests === n ? 'bg-bg-secondary font-semibold text-text' : 'text-text hover:bg-bg-secondary'}\n   308→                  `}\n   309→                >\n   310→                  {n} {n === 1 ? 'guest' : 'guests'}\n   311→                </button>\n   312→              ))}\n   313→            </div>\n   314→          )}\n   315→        </div>\n   316→      </div>\n   317→\n   318→      {calendarOpen && (\n   319→        <div className=\"mb-4 border border-border rounded-xl p-4 bg-bg shadow-sm\">\n   320→          <div className=\"mb-3\">\n   321→            <h3 className=\"text-base font-semibold text-text\">Select dates</h3>\n   322→            <p className=\"text-xs text-text-secondary\">Add your travel dates for exact pricing</p>\n   323→          </div>\n   324→          <div className=\"flex items-center justify-between mb-2\">\n   325→            <button\n   326→              data-testid=\"calendar-prev-month\"\n   327→              onClick={handlePrevMonth}\n   328→              aria-label=\"Previous month\"\n   329→              className=\"p-1 rounded-full hover:bg-bg-secondary cursor-pointer\"\n   330→            >\n   331→              <ChevronLeft size={20} aria-hidden=\"true\" />\n   332→            </button>\n   333→            <div />\n   334→            <button\n   335→              data-testid=\"calendar-next-month\"\n   336→              onClick={handleNextMonth}\n   337→              aria-label=\"Next month\"\n   338→              className=\"p-1 rounded-full hover:bg-bg-secondary cursor-pointer\"\n   339→            >\n   340→              <ChevronRight size={20} aria-hidden=\"true\" />\n   341→            </button>\n   342→          </div>\n   343→          <div className=\"grid grid-cols-2 gap-6\">\n   344→            <CalendarMonth\n   345→              year={calYear}\n   346→              month={calMonth}\n   347→              todayStr={todayStr}\n   348→              bookedRanges={bookedRanges}\n   349→              checkIn={checkIn}\n   350→              checkOut={checkOut}\n   351→              onSelectDate={handleSelectDate}\n   352→            />\n   353→            <CalendarMonth\n   354→              year={nextYear}\n   355→              month={nextMonth}\n   356→              todayStr={todayStr}\n   357→              bookedRanges={bookedRanges}\n   358→              checkIn={checkIn}\n   359→              checkOut={checkOut}\n   360→              onSelectDate={handleSelectDate}\n   361→            />\n   362→          </div>\n   363→          <div className=\"flex items-center justify-end gap-3 mt-4 pt-3 border-t border-border\">\n   364→            <button\n   365→              onClick={() => { setCheckIn(''); setCheckOut('') }}\n   366→              className=\"text-sm font-semibold text-text underline hover:no-underline cursor-pointer\"\n   367→            >\n   368→              Clear dates\n   369→            </button>\n   370→            <button\n   371→              onClick={() => setCalendarOpen(false)}\n   372→              className=\"text-sm font-semibold text-white bg-text rounded-lg px-4 py-2 hover:opacity-90 cursor-pointer\"\n   373→            >\n   374→              Close\n   375→            </button>\n   376→          </div>\n   377→        </div>\n   378→      )}\n   379→\n   380→      {nights > 0 && (\n   381→        <div data-testid=\"price-breakdown\" className=\"mb-4 space-y-2 text-sm\">\n   382→          <div className=\"flex justify-between text-text-secondary\">\n   383→            <span className=\"underline\">${Number(property.price_per_night).toFixed(0)} x {nights} {nights === 1 ? 'night' : 'nights'}</span>\n   384→            <span>${nightlyTotal.toFixed(0)}</span>\n   385→          </div>\n   386→          <div className=\"flex justify-between text-text-secondary\">\n   387→            <span className=\"underline\">Cleaning fee</span>\n   388→            <span>${cleaningFee.toFixed(0)}</span>\n   389→          </div>\n   390→          <div className=\"flex justify-between font-semibold text-text pt-3 border-t border-border\">\n   391→            <span>Total</span>\n   392→            <span>${total.toFixed(0)}</span>\n   393→          </div>\n   394→        </div>\n   395→      )}\n   396→\n   397→      {isOwnProperty ? (\n   398→        <p data-testid=\"own-property-message\" className=\"text-center text-text-secondary text-sm mb-2\">\n   399→          You cannot book your own property\n   400→        </p>\n   401→      ) : !currentUser ? (\n   402→        <button\n   403→          data-testid=\"booking-login-prompt\"\n   404→          className=\"w-full py-3 rounded-lg bg-gradient-to-r from-primary to-[#E61E4D] text-white font-semibold hover:opacity-95 transition-opacity cursor-pointer text-base\"\n   405→          onClick={() => navigate('/login')}\n   406→        >\n   407→          Log in to reserve\n   408→        </button>\n   409→      ) : (\n   410→        <button\n   411→          data-testid=\"reserve-button\"\n   412→          className=\"w-full py-3 rounded-lg bg-gradient-to-r from-primary to-[#E61E4D] text-white font-semibold hover:opacity-95 transition-opacity disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer text-base\"\n   413→          disabled={!canReserve}\n   414→          onClick={handleReserve}\n   415→        >\n   416→          {loading ? 'Reserving...' : 'Reserve'}\n   417→        </button>\n   418→      )}\n   419→\n   420→      {!checkIn && !checkOut && currentUser && !isOwnProperty && (\n   421→        <p className=\"text-center text-text-secondary text-xs mt-3\">You won't be charged yet</p>\n   422→      )}\n   423→\n   424→      {error && (\n   425→        <p data-testid=\"booking-error\" role=\"alert\" className=\"text-error text-sm mt-2 text-center\">{error}</p>\n   426→      )}\n   427→\n   428→      {success && (\n   429→        <p data-testid=\"booking-success\" role=\"status\" aria-live=\"polite\" className=\"text-success text-sm mt-2 text-center font-semibold\">\n   430→          Booking confirmed! Redirecting...\n   431→        </p>\n   432→      )}\n   433→    </aside>\n   434→  )\n   435→}\n   436→"}]},"parent_tool_use_id":null,"session_id":"2eb78e56-88a3-4b5b-b71a-173ede6214fd","uuid":"02fdd5d1-f963-4a0e-b413-729585b376dc","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/components/BookingCard.tsx","content":"import { useState, useEffect, useCallback, useRef } from 'react'\nimport { useSelector, useDispatch } from 'react-redux'\nimport { useNavigate } from 'react-router-dom'\nimport { ChevronLeft, ChevronRight, ChevronDown } from 'lucide-react'\nimport type { RootState, AppDispatch } from '../store'\nimport type { Property } from '../slices/propertiesSlice'\nimport { createBooking, clearBookingError } from '../slices/bookingsSlice'\n\ninterface BookingCardProps {\n  property: Property\n}\n\ninterface BookedRange {\n  check_in: string\n  check_out: string\n}\n\nfunction getDaysInMonth(year: number, month: number): number {\n  return new Date(year, month + 1, 0).getDate()\n}\n\nfunction getFirstDayOfWeek(year: number, month: number): number {\n  return new Date(year, month, 1).getDay()\n}\n\nfunction formatDateStr(year: number, month: number, day: number): string {\n  return `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`\n}\n\nfunction isDateBooked(dateStr: string, bookedRanges: BookedRange[]): boolean {\n  for (const range of bookedRanges) {\n    if (dateStr >= range.check_in && dateStr < range.check_out) {\n      return true\n    }\n  }\n  return false\n}\n\nfunction isDateInPast(dateStr: string, todayStr: string): boolean {\n  return dateStr < todayStr\n}\n\nconst MONTH_NAMES = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']\nconst DAY_NAMES = ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa']\n\nfunction CalendarMonth({\n  year,\n  month,\n  todayStr,\n  bookedRanges,\n  checkIn,\n  checkOut,\n  onSelectDate,\n}: {\n  year: number\n  month: number\n  todayStr: string\n  bookedRanges: BookedRange[]\n  checkIn: string\n  checkOut: string\n  onSelectDate: (dateStr: string) => void\n}) {\n  const daysInMonth = getDaysInMonth(year, month)\n  const firstDay = getFirstDayOfWeek(year, month)\n\n  const cells: (number | null)[] = []\n  for (let i = 0; i < firstDay; i++) cells.push(null)\n  for (let d = 1; d <= daysInMonth; d++) cells.push(d)\n\n  return (\n    <div role=\"grid\" aria-label={`${MONTH_NAMES[month]} ${year}`}>\n      <div className=\"text-center text-sm font-semibold text-text mb-3\">\n        {MONTH_NAMES[month]} {year}\n      </div>\n      <div className=\"grid grid-cols-7 gap-0\">\n        {DAY_NAMES.map((d) => (\n          <div key={d} className=\"text-center text-xs font-semibold text-text-secondary py-1\" role=\"columnheader\">\n            {d}\n          </div>\n        ))}\n        {cells.map((day, idx) => {\n          if (day === null) {\n            return <div key={`empty-${idx}`} className=\"h-10\" />\n          }\n          const dateStr = formatDateStr(year, month, day)\n          const isPast = isDateInPast(dateStr, todayStr)\n          const booked = isDateBooked(dateStr, bookedRanges)\n          const disabled = isPast || booked\n          const isCheckIn = dateStr === checkIn\n          const isCheckOut = dateStr === checkOut\n          const isSelected = isCheckIn || isCheckOut\n          const inRange = checkIn && checkOut && dateStr > checkIn && dateStr < checkOut\n\n          return (\n            <button\n              key={dateStr}\n              data-testid={`calendar-day-${dateStr}`}\n              disabled={disabled}\n              onClick={() => !disabled && onSelectDate(dateStr)}\n              aria-label={`${MONTH_NAMES[month]} ${day}, ${year}${isCheckIn ? ' (check-in)' : ''}${isCheckOut ? ' (checkout)' : ''}${booked ? ' (unavailable)' : ''}${isPast ? ' (past date)' : ''}`}\n              aria-pressed={isSelected}\n              className={`h-10 w-full text-sm rounded-full transition-colors cursor-pointer\n                ${disabled ? 'text-border line-through cursor-not-allowed' : 'hover:bg-bg-secondary text-text'}\n                ${isSelected ? 'bg-text text-white hover:bg-text' : ''}\n                ${inRange ? 'bg-bg-secondary' : ''}\n                ${booked ? 'bg-bg-secondary' : ''}\n              `}\n            >\n              {day}\n            </button>\n          )\n        })}\n      </div>\n    </div>\n  )\n}\n\nexport default function BookingCard({ property }: BookingCardProps) {\n  const dispatch = useDispatch<AppDispatch>()\n  const navigate = useNavigate()\n  const currentUser = useSelector((state: RootState) => state.auth.currentUser)\n  const { loading, error } = useSelector((state: RootState) => state.bookings)\n\n  const [checkIn, setCheckIn] = useState('')\n  const [checkOut, setCheckOut] = useState('')\n  const [guests, setGuests] = useState(1)\n  const [success, setSuccess] = useState(false)\n  const [calendarOpen, setCalendarOpen] = useState(false)\n  const [bookedRanges, setBookedRanges] = useState<BookedRange[]>([])\n\n  const now = new Date()\n  const todayStr = formatDateStr(now.getFullYear(), now.getMonth(), now.getDate())\n  const [calMonth, setCalMonth] = useState(now.getMonth())\n  const [calYear, setCalYear] = useState(now.getFullYear())\n  const [guestDropdownOpen, setGuestDropdownOpen] = useState(false)\n  const guestDropdownRef = useRef<HTMLDivElement>(null)\n\n  useEffect(() => {\n    function handleClickOutside(e: MouseEvent) {\n      if (guestDropdownRef.current && !guestDropdownRef.current.contains(e.target as Node)) {\n        setGuestDropdownOpen(false)\n      }\n    }\n    document.addEventListener('mousedown', handleClickOutside)\n    return () => document.removeEventListener('mousedown', handleClickOutside)\n  }, [])\n\n  const isOwnProperty = currentUser?.id === property.host_id\n\n  useEffect(() => {\n    fetch(`/api/bookings?property_id=${property.id}`)\n      .then((r) => r.json())\n      .then((data) => {\n        if (Array.isArray(data)) {\n          setBookedRanges(data.map((b: { check_in: string; check_out: string }) => ({\n            check_in: b.check_in.slice(0, 10),\n            check_out: b.check_out.slice(0, 10),\n          })))\n        }\n      })\n      .catch(() => {})\n  }, [property.id])\n\n  const handleSelectDate = useCallback((dateStr: string) => {\n    if (!checkIn || (checkIn && checkOut)) {\n      setCheckIn(dateStr)\n      setCheckOut('')\n    } else {\n      if (dateStr <= checkIn) {\n        setCheckIn(dateStr)\n        setCheckOut('')\n      } else {\n        // Check if any booked date is between checkIn and this date\n        const hasBlockedInRange = bookedRanges.some(\n          (r) => r.check_in < dateStr && r.check_out > checkIn\n        )\n        if (hasBlockedInRange) {\n          setCheckIn(dateStr)\n          setCheckOut('')\n        } else {\n          setCheckOut(dateStr)\n        }\n      }\n    }\n  }, [checkIn, checkOut, bookedRanges])\n\n  const handlePrevMonth = () => {\n    if (calMonth === 0) {\n      setCalMonth(11)\n      setCalYear(calYear - 1)\n    } else {\n      setCalMonth(calMonth - 1)\n    }\n  }\n\n  const handleNextMonth = () => {\n    if (calMonth === 11) {\n      setCalMonth(0)\n      setCalYear(calYear + 1)\n    } else {\n      setCalMonth(calMonth + 1)\n    }\n  }\n\n  const nextMonth = calMonth === 11 ? 0 : calMonth + 1\n  const nextYear = calMonth === 11 ? calYear + 1 : calYear\n\n  const nights =\n    checkIn && checkOut\n      ? Math.max(0, Math.round((new Date(checkOut).getTime() - new Date(checkIn).getTime()) / (1000 * 60 * 60 * 24)))\n      : 0\n\n  const nightlyTotal = nights * Number(property.price_per_night)\n  const cleaningFee = Number(property.cleaning_fee)\n  const total = nightlyTotal + cleaningFee\n\n  const canReserve = checkIn && checkOut && nights > 0 && !isOwnProperty && currentUser && !loading\n\n  const handleReserve = async () => {\n    if (!currentUser) {\n      navigate('/login')\n      return\n    }\n    if (!checkIn || !checkOut || isOwnProperty) return\n\n    dispatch(clearBookingError())\n    const result = await dispatch(\n      createBooking({\n        property_id: property.id,\n        guest_id: currentUser.id,\n        check_in: checkIn,\n        check_out: checkOut,\n        num_guests: guests,\n        total_price: total,\n      })\n    )\n    if (createBooking.fulfilled.match(result)) {\n      setSuccess(true)\n      setTimeout(() => navigate('/trips'), 1500)\n    }\n  }\n\n  const formatDisplayDate = (d: string) => {\n    if (!d) return ''\n    const date = new Date(d + 'T00:00:00')\n    return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })\n  }\n\n  return (\n    <aside data-testid=\"booking-card\" className=\"border border-border rounded-xl p-6 shadow-lg sticky top-[96px]\" aria-label=\"Booking\">\n      {nights > 0 ? (\n        <div className=\"flex items-baseline gap-1 mb-5\">\n          <span className=\"text-[22px] font-semibold text-text\">${Number(property.price_per_night).toFixed(0)}</span>\n          <span className=\"text-text-secondary\">night</span>\n        </div>\n      ) : (\n        <p className=\"text-[22px] font-semibold text-text mb-5\">Add dates for prices</p>\n      )}\n\n      <div className=\"border border-border rounded-lg overflow-hidden mb-4\">\n        <button\n          type=\"button\"\n          className=\"grid grid-cols-2 cursor-pointer w-full text-left bg-transparent border-0 p-0\"\n          onClick={() => setCalendarOpen(!calendarOpen)}\n          aria-expanded={calendarOpen}\n          aria-label=\"Select check-in and checkout dates\"\n        >\n          <div className=\"p-3 border-r border-border\">\n            <span className=\"block text-[10px] font-bold text-text uppercase tracking-wide\">Check-in</span>\n            <p data-testid=\"booking-checkin\" className=\"text-sm text-text-secondary mt-0.5\">\n              {checkIn ? formatDisplayDate(checkIn) : 'Add date'}\n            </p>\n          </div>\n          <div className=\"p-3\">\n            <span className=\"block text-[10px] font-bold text-text uppercase tracking-wide\">Checkout</span>\n            <p data-testid=\"booking-checkout\" className=\"text-sm text-text-secondary mt-0.5\">\n              {checkOut ? formatDisplayDate(checkOut) : 'Add date'}\n            </p>\n          </div>\n        </button>\n        <div className=\"border-t border-border p-3 relative\" ref={guestDropdownRef}>\n          <span id=\"guests-label\" className=\"block text-[10px] font-bold text-text uppercase tracking-wide\">Guests</span>\n          <button\n            data-testid=\"booking-guests\"\n            data-value={String(guests)}\n            type=\"button\"\n            onClick={() => setGuestDropdownOpen(!guestDropdownOpen)}\n            aria-expanded={guestDropdownOpen}\n            aria-haspopup=\"listbox\"\n            aria-labelledby=\"guests-label\"\n            className=\"w-full flex items-center justify-between text-sm text-text bg-transparent outline-none mt-0.5 cursor-pointer\"\n          >\n            <span>{guests} {guests === 1 ? 'guest' : 'guests'}</span>\n            <ChevronDown size={16} aria-hidden=\"true\" className={`transition-transform ${guestDropdownOpen ? 'rotate-180' : ''}`} />\n          </button>\n          {guestDropdownOpen && (\n            <div data-testid=\"booking-guests-dropdown\" role=\"listbox\" aria-label=\"Number of guests\" className=\"absolute left-0 right-0 top-full mt-1 bg-bg border border-border rounded-lg shadow-lg z-50 max-h-48 overflow-y-auto\">\n              {Array.from({ length: property.max_guests }, (_, i) => i + 1).map((n) => (\n                <button\n                  key={n}\n                  data-testid={`guest-option-${n}`}\n                  type=\"button\"\n                  role=\"option\"\n                  aria-selected={guests === n}\n                  onClick={() => { setGuests(n); setGuestDropdownOpen(false) }}\n                  className={`w-full text-left px-3 py-2 text-sm cursor-pointer transition-colors\n                    ${guests === n ? 'bg-bg-secondary font-semibold text-text' : 'text-text hover:bg-bg-secondary'}\n                  `}\n                >\n                  {n} {n === 1 ? 'guest' : 'guests'}\n                </button>\n              ))}\n            </div>\n          )}\n        </div>\n      </div>\n\n      {calendarOpen && (\n        <div className=\"mb-4 border border-border rounded-xl p-4 bg-bg shadow-sm\">\n          <div className=\"mb-3\">\n            <h3 className=\"text-base font-semibold text-text\">Select dates</h3>\n            <p className=\"text-xs text-text-secondary\">Add your travel dates for exact pricing</p>\n          </div>\n          <div className=\"flex items-center justify-between mb-2\">\n            <button\n              data-testid=\"calendar-prev-month\"\n              onClick={handlePrevMonth}\n              aria-label=\"Previous month\"\n              className=\"p-1 rounded-full hover:bg-bg-secondary cursor-pointer\"\n            >\n              <ChevronLeft size={20} aria-hidden=\"true\" />\n            </button>\n            <div />\n            <button\n              data-testid=\"calendar-next-month\"\n              onClick={handleNextMonth}\n              aria-label=\"Next month\"\n              className=\"p-1 rounded-full hover:bg-bg-secondary cursor-pointer\"\n            >\n              <ChevronRight size={20} aria-hidden=\"true\" />\n            </button>\n          </div>\n          <div className=\"grid grid-cols-2 gap-6\">\n            <CalendarMonth\n              year={calYear}\n              month={calMonth}\n              todayStr={todayStr}\n              bookedRanges={bookedRanges}\n              checkIn={checkIn}\n              checkOut={checkOut}\n              onSelectDate={handleSelectDate}\n            />\n            <CalendarMonth\n              year={nextYear}\n              month={nextMonth}\n              todayStr={todayStr}\n              bookedRanges={bookedRanges}\n              checkIn={checkIn}\n              checkOut={checkOut}\n              onSelectDate={handleSelectDate}\n            />\n          </div>\n          <div className=\"flex items-center justify-end gap-3 mt-4 pt-3 border-t border-border\">\n            <button\n              onClick={() => { setCheckIn(''); setCheckOut('') }}\n              className=\"text-sm font-semibold text-text underline hover:no-underline cursor-pointer\"\n            >\n              Clear dates\n            </button>\n            <button\n              onClick={() => setCalendarOpen(false)}\n              className=\"text-sm font-semibold text-white bg-text rounded-lg px-4 py-2 hover:opacity-90 cursor-pointer\"\n            >\n              Close\n            </button>\n          </div>\n        </div>\n      )}\n\n      {nights > 0 && (\n        <div data-testid=\"price-breakdown\" className=\"mb-4 space-y-2 text-sm\">\n          <div className=\"flex justify-between text-text-secondary\">\n            <span className=\"underline\">${Number(property.price_per_night).toFixed(0)} x {nights} {nights === 1 ? 'night' : 'nights'}</span>\n            <span>${nightlyTotal.toFixed(0)}</span>\n          </div>\n          <div className=\"flex justify-between text-text-secondary\">\n            <span className=\"underline\">Cleaning fee</span>\n            <span>${cleaningFee.toFixed(0)}</span>\n          </div>\n          <div className=\"flex justify-between font-semibold text-text pt-3 border-t border-border\">\n            <span>Total</span>\n            <span>${total.toFixed(0)}</span>\n          </div>\n        </div>\n      )}\n\n      {isOwnProperty ? (\n        <p data-testid=\"own-property-message\" className=\"text-center text-text-secondary text-sm mb-2\">\n          You cannot book your own property\n        </p>\n      ) : !currentUser ? (\n        <button\n          data-testid=\"booking-login-prompt\"\n          className=\"w-full py-3 rounded-lg bg-gradient-to-r from-primary to-[#E61E4D] text-white font-semibold hover:opacity-95 transition-opacity cursor-pointer text-base\"\n          onClick={() => navigate('/login')}\n        >\n          Log in to reserve\n        </button>\n      ) : (\n        <button\n          data-testid=\"reserve-button\"\n          className=\"w-full py-3 rounded-lg bg-gradient-to-r from-primary to-[#E61E4D] text-white font-semibold hover:opacity-95 transition-opacity disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer text-base\"\n          disabled={!canReserve}\n          onClick={handleReserve}\n        >\n          {loading ? 'Reserving...' : 'Reserve'}\n        </button>\n      )}\n\n      {!checkIn && !checkOut && currentUser && !isOwnProperty && (\n        <p className=\"text-center text-text-secondary text-xs mt-3\">You won't be charged yet</p>\n      )}\n\n      {error && (\n        <p data-testid=\"booking-error\" role=\"alert\" className=\"text-error text-sm mt-2 text-center\">{error}</p>\n      )}\n\n      {success && (\n        <p data-testid=\"booking-success\" role=\"status\" aria-live=\"polite\" className=\"text-success text-sm mt-2 text-center font-semibold\">\n          Booking confirmed! Redirecting...\n        </p>\n      )}\n    </aside>\n  )\n}\n","numLines":436,"startLine":1,"totalLines":436}}}
