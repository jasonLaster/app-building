[2026-03-16T03:58:27.463Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017qsyiT5ABmj7fZoF8m3F9J","type":"tool_result","content":"     1→import { Star } from 'lucide-react'\n     2→import type { Property } from '../slices/propertiesSlice'\n     3→\n     4→interface PropertyHeaderProps {\n     5→  property: Property\n     6→}\n     7→\n     8→export default function PropertyHeader({ property }: PropertyHeaderProps) {\n     9→  const rating = Number(property.avg_rating) || 0\n    10→  const reviewCount = property.review_count || 0\n    11→\n    12→  const scrollToReviews = () => {\n    13→    const el = document.getElementById('reviews-section')\n    14→    if (el) {\n    15→      el.scrollIntoView({ behavior: 'smooth' })\n    16→    }\n    17→  }\n    18→\n    19→  const hostingSince = property.host_since ? new Date(property.host_since) : null\n    20→  const yearsHosting = hostingSince\n    21→    ? Math.max(1, Math.floor((Date.now() - hostingSince.getTime()) / (365.25 * 24 * 60 * 60 * 1000)))\n    22→    : null\n    23→\n    24→  return (\n    25→    <header data-testid=\"property-header\" className=\"pb-6 border-b border-border\">\n    26→      <div className=\"flex items-center gap-2 mb-2\">\n    27→        {reviewCount > 0 ? (\n    28→          <button\n    29→            data-testid=\"review-count-link\"\n    30→            className=\"flex items-center gap-1.5 hover:underline cursor-pointer text-sm\"\n    31→            onClick={scrollToReviews}\n    32→            aria-label={`${rating.toFixed(2)} stars, ${reviewCount} ${reviewCount === 1 ? 'review' : 'reviews'} - scroll to reviews`}\n    33→          >\n    34→            <Star size={14} className=\"fill-text text-text\" aria-hidden=\"true\" />\n    35→            <span className=\"font-semibold text-text\">{rating.toFixed(2)}</span>\n    36→            <span className=\"text-text-secondary\">·</span>\n    37→            <span className=\"text-text-secondary underline\">{reviewCount} {reviewCount === 1 ? 'review' : 'reviews'}</span>\n    38→          </button>\n    39→        ) : (\n    40→          <span className=\"text-sm text-text-secondary\">New listing</span>\n    41→        )}\n    42→      </div>\n    43→\n    44→      <div className=\"flex items-center gap-4 mt-6 pt-6 border-t border-border\">\n    45→        <button data-testid=\"host-info\" className=\"flex items-center gap-3 cursor-pointer\" aria-label={`Hosted by ${property.host_name} - scroll to host info`} onClick={() => {\n    46→          const el = document.getElementById('host-info-card')\n    47→          if (el) el.scrollIntoView({ behavior: 'smooth' })\n    48→        }}>\n    49→          {property.host_avatar ? (\n    50→            <img\n    51→              data-testid=\"host-avatar\"\n    52→              src={property.host_avatar}\n    53→              alt={property.host_name || 'Host'}\n    54→              className=\"w-12 h-12 rounded-full object-cover\"\n    55→            />\n    56→          ) : (\n    57→            <div data-testid=\"host-avatar\" className=\"w-12 h-12 rounded-full bg-text flex items-center justify-center text-sm font-semibold text-white\">\n    58→              {property.host_name?.charAt(0) || 'H'}\n    59→            </div>\n    60→          )}\n    61→          <div className=\"text-left\">\n    62→            <p className=\"text-base font-semibold text-text\">Hosted by {property.host_name}</p>\n    63→            {yearsHosting && (\n    64→              <p className=\"text-sm text-text-secondary\">{yearsHosting} {yearsHosting === 1 ? 'year' : 'years'} hosting</p>\n    65→            )}\n    66→          </div>\n    67→        </button>\n    68→      </div>\n    69→    </header>\n    70→  )\n    71→}\n    72→"}]},"parent_tool_use_id":"toolu_01EXSeAogz8QKs7dquJLCEz4","session_id":"2eb78e56-88a3-4b5b-b71a-173ede6214fd","uuid":"dd8ae344-8db7-4349-afb3-59f32ac1e951"}
