[2026-03-16T03:58:29.568Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WRUEp835AFp9KBk9KMLgeh","type":"tool_result","content":"     1→import { useState } from 'react'\n     2→import { Star } from 'lucide-react'\n     3→import type { Review } from '../slices/propertiesSlice'\n     4→\n     5→interface ReviewsSectionProps {\n     6→  reviews: Review[]\n     7→}\n     8→\n     9→const INITIAL_SHOW = 6\n    10→\n    11→const CATEGORIES: { key: keyof Review; label: string }[] = [\n    12→  { key: 'cleanliness', label: 'Cleanliness' },\n    13→  { key: 'accuracy', label: 'Accuracy' },\n    14→  { key: 'communication', label: 'Communication' },\n    15→  { key: 'location', label: 'Location' },\n    16→  { key: 'value', label: 'Value' },\n    17→]\n    18→\n    19→function formatDate(dateStr: string): string {\n    20→  const date = new Date(dateStr)\n    21→  return date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })\n    22→}\n    23→\n    24→function avgRating(reviews: Review[], key: keyof Review): number {\n    25→  const sum = reviews.reduce((acc, r) => acc + Number(r[key]), 0)\n    26→  return sum / reviews.length\n    27→}\n    28→\n    29→export default function ReviewsSection({ reviews }: ReviewsSectionProps) {\n    30→  const [showAll, setShowAll] = useState(false)\n    31→\n    32→  if (reviews.length === 0) {\n    33→    return (\n    34→      <section id=\"reviews-section\" data-testid=\"reviews-section\" className=\"py-8 border-b border-border\">\n    35→        <h2 className=\"text-[22px] font-semibold text-text mb-3\">Reviews</h2>\n    36→        <p className=\"text-text-secondary\">No reviews yet</p>\n    37→      </section>\n    38→    )\n    39→  }\n    40→\n    41→  const overallAvg = reviews.reduce((acc, r) => acc + Number(r.rating), 0) / reviews.length\n    42→  const displayReviews = showAll ? reviews : reviews.slice(0, INITIAL_SHOW)\n    43→\n    44→  return (\n    45→    <section id=\"reviews-section\" data-testid=\"reviews-section\" className=\"py-8 border-b border-border\">\n    46→      <div className=\"flex items-center gap-2 mb-6\">\n    47→        <Star size={22} className=\"fill-text text-text\" aria-hidden=\"true\" />\n    48→        <h2 className=\"text-[22px] font-semibold text-text\">\n    49→          {overallAvg.toFixed(1)} · {reviews.length} {reviews.length === 1 ? 'review' : 'reviews'}\n    50→        </h2>\n    51→      </div>\n    52→\n    53→      <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-x-12 gap-y-4 mb-8\">\n    54→        {CATEGORIES.map(({ key, label }) => {\n    55→          const avg = avgRating(reviews, key)\n    56→          return (\n    57→            <div key={key} data-testid={`rating-category-${key}`} className=\"flex items-center justify-between text-sm\">\n    58→              <span className=\"text-text\">{label}</span>\n    59→              <div className=\"flex items-center gap-2\">\n    60→                <div className=\"w-28 h-1 bg-border rounded-full overflow-hidden\" role=\"meter\" aria-label={`${label} rating`} aria-valuenow={avg} aria-valuemin={0} aria-valuemax={5}>\n    61→                  <div\n    62→                    className=\"h-full bg-text rounded-full\"\n    63→                    style={{ width: `${(avg / 5) * 100}%` }}\n    64→                  />\n    65→                </div>\n    66→                <span className=\"font-medium text-text text-xs w-6 text-right\">{avg.toFixed(1)}</span>\n    67→              </div>\n    68→            </div>\n    69→          )\n    70→        })}\n    71→      </div>\n    72→\n    73→      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8\">\n    74→        {displayReviews.map((review) => (\n    75→          <div key={review.id} data-testid={`review-card-${review.id}`} className=\"space-y-3\">\n    76→            <div className=\"flex items-center gap-3\">\n    77→              {review.guest_avatar ? (\n    78→                <img\n    79→                  src={review.guest_avatar}\n    80→                  alt={review.guest_name}\n    81→                  className=\"w-12 h-12 rounded-full object-cover\"\n    82→                />\n    83→              ) : (\n    84→                <div className=\"w-12 h-12 rounded-full bg-text flex items-center justify-center text-sm font-bold text-white\">\n    85→                  {review.guest_name.charAt(0)}\n    86→                </div>\n    87→              )}\n    88→              <div>\n    89→                <p className=\"font-semibold text-text text-sm\">{review.guest_name}</p>\n    90→                <p className=\"text-text-secondary text-xs\">{formatDate(review.created_at)}</p>\n    91→              </div>\n    92→            </div>\n    93→            <div className=\"flex items-center gap-0.5\" role=\"img\" aria-label={`${Number(review.rating)} out of 5 stars`}>\n    94→              {Array.from({ length: 5 }, (_, i) => (\n    95→                <Star\n    96→                  key={i}\n    97→                  size={12}\n    98→                  aria-hidden=\"true\"\n    99→                  className={i < Number(review.rating) ? 'fill-text text-text' : 'text-border'}\n   100→                />\n   101→              ))}\n   102→            </div>\n   103→            {review.comment && (\n   104→              <p className=\"text-text text-sm leading-relaxed\">{review.comment}</p>\n   105→            )}\n   106→          </div>\n   107→        ))}\n   108→      </div>\n   109→\n   110→      {reviews.length > INITIAL_SHOW && (\n   111→        <button\n   112→          data-testid=\"reviews-toggle\"\n   113→          className=\"mt-8 px-6 py-3 rounded-lg border border-text text-sm font-semibold text-text hover:bg-bg-secondary transition-colors cursor-pointer\"\n   114→          onClick={() => setShowAll(!showAll)}\n   115→          aria-expanded={showAll}\n   116→        >\n   117→          {showAll ? 'Show less' : `Show all ${reviews.length} reviews`}\n   118→        </button>\n   119→      )}\n   120→    </section>\n   121→  )\n   122→}\n   123→"}]},"parent_tool_use_id":"toolu_01EXSeAogz8QKs7dquJLCEz4","session_id":"2eb78e56-88a3-4b5b-b71a-173ede6214fd","uuid":"58ede866-70ab-4e7e-8e42-f38a44ebc233"}
