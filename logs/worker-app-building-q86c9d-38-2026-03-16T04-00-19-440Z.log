\"\n    46→          />\n    47→          {mainImage!.caption && (\n    48→            <span className=\"absolute bottom-2 left-2 bg-black/60 text-white text-xs px-2 py-1 rounded\">\n    49→              {mainImage!.caption}\n    50→            </span>\n    51→          )}\n    52→        </div>\n    53→        {thumbnails.slice(0, 4).map((img) => {\n    54→          const originalIndex = images.indexOf(img)\n    55→          return (\n    56→            <button\n    57→              key={img.id}\n    58→              data-testid={`thumbnail-${img.id}`}\n    59→              type=\"button\"\n    60→              aria-label={img.caption || `View property image ${originalIndex + 1}`}\n    61→              className=\"relative cursor-pointer overflow-hidden hover:opacity-90 transition-opacity\"\n    62→              onClick={() => setMainIndex(originalIndex)}\n    63→            >\n    64→              <img\n    65→                src={img.url}\n    66→                alt={img.caption || 'Property image'}\n    67→                className=\"w-full h-full object-cover\"\n    68→              />\n    69→              {img.caption && (\n    70→                <span className=\"absolute bottom-1 left-1 bg-black/60 text-white text-[10px] px-1.5 py-0.5 rounded\">\n    71→                  {img.caption}\n    72→                </span>\n    73→              )}\n    74→            </button>\n    75→          )\n    76→        })}\n    77→      </div>\n    78→      {images.length > 5 && (\n    79→        <button className=\"absolute bottom-4 right-4 flex items-center gap-2 bg-white border border-text rounded-lg px-4 py-1.5 text-sm font-semibold text-text hover:bg-bg-secondary transition-colors cursor-pointer\">\n    80→          <Grid size={14} aria-hidden=\"true\" />\n    81→          Show all photos\n    82→        </button>\n    83→      )}\n    84→    </div>\n    85→  )\n    86→}\n    87→"}]},"parent_tool_use_id":null,"session_id":"2eb78e56-88a3-4b5b-b71a-173ede6214fd","uuid":"b10ca70e-691d-4c51-aa0f-1e2f381df4db","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/components/ImageGallery.tsx","content":"import { useState } from 'react'\nimport { Grid } from 'lucide-react'\nimport type { PropertyImage } from '../slices/propertiesSlice'\n\ninterface ImageGalleryProps {\n  images: PropertyImage[]\n}\n\nexport default function ImageGallery({ images }: ImageGalleryProps) {\n  const [mainIndex, setMainIndex] = useState(0)\n\n  if (images.length === 0) {\n    return (\n      <div data-testid=\"image-gallery\" className=\"rounded-xl bg-bg-secondary flex items-center justify-center h-[420px]\">\n        <p className=\"text-text-secondary\">No images available</p>\n      </div>\n    )\n  }\n\n  const mainImage = images[mainIndex]\n\n  if (images.length === 1) {\n    return (\n      <div data-testid=\"image-gallery\">\n        <div className=\"relative rounded-xl overflow-hidden h-[420px]\">\n          <img\n            src={mainImage!.url}\n            alt={mainImage!.caption || 'Property image'}\n            className=\"w-full h-full object-cover\"\n          />\n        </div>\n      </div>\n    )\n  }\n\n  const thumbnails = images.filter((_, i) => i !== mainIndex)\n\n  return (\n    <div data-testid=\"image-gallery\" className=\"relative\">\n      <div className=\"grid grid-cols-4 gap-2 h-[420px] rounded-xl overflow-hidden\">\n        <div className=\"col-span-2 row-span-2 relative cursor-pointer hover:opacity-95 transition-opacity overflow-hidden\">\n          <img\n            src={mainImage!.url}\n            alt={mainImage!.caption || 'Property image'}\n            className=\"w-full h-full object-cover\"\n          />\n          {mainImage!.caption && (\n            <span className=\"absolute bottom-2 left-2 bg-black/60 text-white text-xs px-2 py-1 rounded\">\n              {mainImage!.caption}\n            </span>\n          )}\n        </div>\n        {thumbnails.slice(0, 4).map((img) => {\n          const originalIndex = images.indexOf(img)\n          return (\n            <button\n              key={img.id}\n              data-testid={`thumbnail-${img.id}`}\n              type=\"button\"\n              aria-label={img.caption || `View property image ${originalIndex + 1}`}\n              className=\"relative cursor-pointer overflow-hidden hover:opacity-90 transition-opacity\"\n              onClick={() => setMainIndex(originalIndex)}\n            >\n              <img\n                src={img.url}\n                alt={img.caption || 'Property image'}\n                className=\"w-full h-full object-cover\"\n              />\n              {img.caption && (\n                <span className=\"absolute bottom-1 left-1 bg-black/60 text-white text-[10px] px-1.5 py-0.5 rounded\">\n                  {img.caption}\n                </span>\n              )}\n            </button>\n          )\n        })}\n      </div>\n      {images.length > 5 && (\n        <button className=\"absolute bottom-4 right-4 flex items-center gap-2 bg-white border border-text rounded-lg px-4 py-1.5 text-sm font-semibold text-text hover:bg-bg-secondary transition-colors cursor-pointer\">\n          <Grid size={14} aria-hidden=\"true\" />\n          Show all photos\n        </button>\n      )}\n    </div>\n  )\n}\n","numLines":87,"startLine":1,"totalLines":87}}}
