[2026-03-16T03:58:29.599Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HQbtMEprA6sCseZ3gTf73p","type":"tool_result","content":"     1→import { Shield, Home, Star } from 'lucide-react'\n     2→import type { Property } from '../slices/propertiesSlice'\n     3→\n     4→interface HostInfoCardProps {\n     5→  property: Property\n     6→}\n     7→\n     8→function formatMemberSince(dateStr: string): string {\n     9→  const date = new Date(dateStr)\n    10→  return date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })\n    11→}\n    12→\n    13→function getYearsHosting(dateStr: string): number {\n    14→  const date = new Date(dateStr)\n    15→  return Math.max(1, Math.floor((Date.now() - date.getTime()) / (365.25 * 24 * 60 * 60 * 1000)))\n    16→}\n    17→\n    18→export default function HostInfoCard({ property }: HostInfoCardProps) {\n    19→  const listingCount = property.host_listing_count || 0\n    20→  const rating = Number(property.avg_rating) || 0\n    21→  const reviewCount = property.review_count || 0\n    22→\n    23→  return (\n    24→    <section id=\"host-info-card\" data-testid=\"host-info-card\" className=\"py-8\">\n    25→      <div className=\"rounded-xl border border-border p-6 shadow-sm\">\n    26→        <div className=\"flex items-start gap-6\">\n    27→          {/* Host avatar + name card */}\n    28→          <div className=\"flex flex-col items-center text-center min-w-[120px]\">\n    29→            {property.host_avatar ? (\n    30→              <img\n    31→                src={property.host_avatar}\n    32→                alt={property.host_name || 'Host'}\n    33→                className=\"w-[72px] h-[72px] rounded-full object-cover mb-2\"\n    34→              />\n    35→            ) : (\n    36→              <div className=\"w-[72px] h-[72px] rounded-full bg-text flex items-center justify-center text-2xl font-bold text-white mb-2\">\n    37→                {property.host_name?.charAt(0) || 'H'}\n    38→              </div>\n    39→            )}\n    40→            <h3 className=\"font-bold text-text text-lg\">{property.host_name}</h3>\n    41→            <p className=\"text-text-secondary text-xs mt-0.5\">Host</p>\n    42→          </div>\n    43→\n    44→          {/* Host stats */}\n    45→          <div className=\"flex-1\">\n    46→            <div className=\"grid grid-cols-3 gap-4 mb-4\">\n    47→              {reviewCount > 0 && (\n    48→                <div className=\"text-center\">\n    49→                  <p className=\"text-lg font-bold text-text\">{reviewCount}</p>\n    50→                  <p className=\"text-xs text-text-secondary\">{reviewCount === 1 ? 'Review' : 'Reviews'}</p>\n    51→                </div>\n    52→              )}\n    53→              {reviewCount > 0 && (\n    54→                <div className=\"text-center\">\n    55→                  <div className=\"flex items-center justify-center gap-0.5\">\n    56→                    <p className=\"text-lg font-bold text-text\">{rating.toFixed(1)}</p>\n    57→                    <Star size={12} className=\"fill-text text-text\" aria-hidden=\"true\" />\n    58→                  </div>\n    59→                  <p className=\"text-xs text-text-secondary\">Rating</p>\n    60→                </div>\n    61→              )}\n    62→              {property.host_since && (\n    63→                <div className=\"text-center\">\n    64→                  <p className=\"text-lg font-bold text-text\">{getYearsHosting(property.host_since)}</p>\n    65→                  <p className=\"text-xs text-text-secondary\">{getYearsHosting(property.host_since) === 1 ? 'Year' : 'Years'} hosting</p>\n    66→                </div>\n    67→              )}\n    68→            </div>\n    69→\n    70→            <div className=\"space-y-2 text-sm text-text-secondary\">\n    71→              {property.host_since && (\n    72→                <p className=\"flex items-center gap-2\">\n    73→                  <Shield size={16} aria-hidden=\"true\" />\n    74→                  Member since {formatMemberSince(property.host_since)}\n    75→                </p>\n    76→              )}\n    77→              <p className=\"flex items-center gap-2\">\n    78→                <Home size={16} aria-hidden=\"true\" />\n    79→                {listingCount} {listingCount === 1 ? 'listing' : 'listings'}\n    80→              </p>\n    81→            </div>\n    82→          </div>\n    83→        </div>\n    84→\n    85→        {property.host_bio && (\n    86→          <p className=\"text-text text-sm mt-5 pt-5 border-t border-border leading-relaxed\">{property.host_bio}</p>\n    87→        )}\n    88→      </div>\n    89→    </section>\n    90→  )\n    91→}\n    92→"}]},"parent_tool_use_id":"toolu_01EXSeAogz8QKs7dquJLCEz4","session_id":"2eb78e56-88a3-4b5b-b71a-173ede6214fd","uuid":"cdfc13cc-0c6a-4da9-a020-1f7679bb1866"}
