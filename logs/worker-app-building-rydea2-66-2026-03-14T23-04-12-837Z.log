[2026-03-14T22:58:39.623Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BgVSM1Yh7jYZXxFwbjiBoH","type":"tool_result","content":"     1→import { useState, useEffect, useRef } from 'react';\n     2→import { useSelector, useDispatch } from 'react-redux';\n     3→import type { RootState, AppDispatch } from '../store';\n     4→import { updateWorkspace } from '../slices/workspaceSlice';\n     5→import { fetchTeams } from '../slices/teamsSlice';\n     6→import './WorkspaceSettings.css';\n     7→\n     8→export default function WorkspaceSettings() {\n     9→  const dispatch = useDispatch<AppDispatch>();\n    10→  const { workspace } = useSelector((state: RootState) => state.workspace);\n    11→  const { items: teams } = useSelector((state: RootState) => state.teams);\n    12→  const { token } = useSelector((state: RootState) => state.auth);\n    13→\n    14→  const [nameValue, setNameValue] = useState('');\n    15→  const [nameError, setNameError] = useState<string | null>(null);\n    16→  const [selectedTeamId, setSelectedTeamId] = useState<string | null>(null);\n    17→  const [saving, setSaving] = useState(false);\n    18→  const [successMessage, setSuccessMessage] = useState<string | null>(null);\n    19→  const [teamDropdownOpen, setTeamDropdownOpen] = useState(false);\n    20→\n    21→  const nameInputRef = useRef<HTMLInputElement>(null);\n    22→  const dropdownRef = useRef<HTMLDivElement>(null);\n    23→\n    24→  useEffect(() => {\n    25→    if (token) {\n    26→      dispatch(fetchTeams());\n    27→    }\n    28→  }, [dispatch, token]);\n    29→\n    30→  useEffect(() => {\n    31→    if (workspace) {\n    32→      setNameValue(workspace.name);\n    33→      setSelectedTeamId(workspace.default_team_id);\n    34→    }\n    35→  }, [workspace]);\n    36→\n    37→  // Close dropdown on outside click\n    38→  useEffect(() => {\n    39→    function handleClickOutside(e: MouseEvent) {\n    40→      if (dropdownRef.current && !dropdownRef.current.contains(e.target as Node)) {\n    41→        setTeamDropdownOpen(false);\n    42→      }\n    43→    }\n    44→    if (teamDropdownOpen) {\n    45→      document.addEventListener('mousedown', handleClickOutside);\n    46→      return () => document.removeEventListener('mousedown', handleClickOutside);\n    47→    }\n    48→  }, [teamDropdownOpen]);\n    49→\n    50→  function clearSuccess() {\n    51→    setTimeout(() => setSuccessMessage(null), 3000);\n    52→  }\n    53→\n    54→  async function handleSave() {\n    55→    if (!nameValue.trim()) {\n    56→      setNameError('Workspace name is required');\n    57→      nameInputRef.current?.focus();\n    58→      return;\n    59→    }\n    60→    setNameError(null);\n    61→    setSaving(true);\n    62→\n    63→    const updates: { name?: string; default_team_id?: string | null } = {};\n    64→    if (nameValue.trim() !== workspace?.name) {\n    65→      updates.name = nameValue.trim();\n    66→    }\n    67→    if (selectedTeamId !== workspace?.default_team_id) {\n    68→      updates.default_team_id = selectedTeamId;\n    69→    }\n    70→\n    71→    if (Object.keys(updates).length === 0) {\n    72→      setSaving(false);\n    73→      setSuccessMessage('Settings saved');\n    74→      clearSuccess();\n    75→      return;\n    76→    }\n    77→\n    78→    const result = await dispatch(updateWorkspace(updates));\n    79→    setSaving(false);\n    80→\n    81→    if (updateWorkspace.rejected.match(result)) {\n    82→      setNameError(result.payload as string);\n    83→      return;\n    84→    }\n    85→\n    86→    setSuccessMessage('Settings saved');\n    87→    clearSuccess();\n    88→  }\n    89→\n    90→  function handleNameKeyDown(e: React.KeyboardEvent) {\n    91→    if (e.key === 'Enter') {\n    92→      handleSave();\n    93→    }\n    94→  }\n    95→\n    96→  function handleTeamSelect(teamId: string | null) {\n    97→    setSelectedTeamId(teamId);\n    98→    setTeamDropdownOpen(false);\n    99→  }\n   100→\n   101→  const selectedTeam = teams.find((t) => t.id === selectedTeamId);\n   102→\n   103→  return (\n   104→    <div className=\"ws-settings\" data-testid=\"workspace-settings\">\n   105→      <div className=\"ws-fields\">\n   106→        {/* Workspace Name */}\n   107→        <div className=\"ws-field\" data-testid=\"workspace-name-field\">\n   108→          <label className=\"ws-field-label\">Workspace name</label>\n   109→          <input\n   110→            ref={nameInputRef}\n   111→            type=\"text\"\n   112→            className={`ws-input ${nameError ? 'ws-input-error' : ''}`}\n   113→            value={nameValue}\n   114→            onChange={(e) => { setNameValue(e.target.value); setNameError(null); }}\n   115→            onKeyDown={handleNameKeyDown}\n   116→            data-testid=\"workspace-name-input\"\n   117→          />\n   118→          {nameError && (\n   119→            <span className=\"ws-field-error\" data-testid=\"workspace-name-error\">{nameError}</span>\n   120→          )}\n   121→        </div>\n   122→\n   123→        {/* Default Team */}\n   124→        <div className=\"ws-field\" data-testid=\"workspace-default-team-field\">\n   125→          <label className=\"ws-field-label\">Default team for new issues</label>\n   126→          <div className=\"ws-dropdown-wrapper\" ref={dropdownRef}>\n   127→            <button\n   128→              className=\"ws-select-btn\"\n   129→              onClick={() => setTeamDropdownOpen(!teamDropdownOpen)}\n   130→              data-testid=\"workspace-default-team-selector\"\n   131→            >\n   132→              <span>{selectedTeam ? selectedTeam.name : 'No default team'}</span>\n   133→              <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\">\n   134→                <polyline points=\"6 9 12 15 18 9\" />\n   135→              </svg>\n   136→            </button>\n   137→            {teamDropdownOpen && (\n   138→              <div className=\"ws-dropdown\" data-testid=\"workspace-default-team-dropdown\">\n   139→                <button\n   140→                  className={`ws-dropdown-option ${!selectedTeamId ? 'ws-dropdown-option-active' : ''}`}\n   141→                  onClick={() => handleTeamSelect(null)}\n   142→                  data-testid=\"workspace-default-team-option-none\"\n   143→                >\n   144→                  No default team\n   145→                </button>\n   146→                {teams.map((team) => (\n   147→                  <button\n   148→                    key={team.id}\n   149→                    className={`ws-dropdown-option ${selectedTeamId === team.id ? 'ws-dropdown-option-active' : ''}`}\n   150→                    onClick={() => handleTeamSelect(team.id)}\n   151→                    data-testid={`workspace-default-team-option-${team.id}`}\n   152→                  >\n   153→                    {team.name}\n   154→                  </button>\n   155→                ))}\n   156→              </div>\n   157→            )}\n   158→          </div>\n   159→        </div>\n   160→      </div>\n   161→\n   162→      <div className=\"ws-actions\">\n   163→        <button\n   164→          className=\"ws-save-btn\"\n   165→          onClick={handleSave}\n   166→          disabled={saving}\n   167→          data-testid=\"workspace-settings-save-btn\"\n   168→        >\n   169→          {saving ? 'Saving...' : 'Save'}\n   170→        </button>\n   171→        {successMessage && (\n   172→          <span className=\"ws-success\" data-testid=\"workspace-settings-success\">{successMessage}</span>\n   173→        )}\n   174→      </div>\n   175→    </div>\n   176→  );\n   177→}\n   178→"}]},"parent_tool_use_id":"toolu_018GPwKEcD1FYpyKVFpeMfoq","session_id":"90024d97-e35b-4034-b06d-d2556c8f7f36","uuid":"0bd2f8ea-d177-478a-b7ee-6f11cd35d322"}
