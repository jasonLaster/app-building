[2026-03-14T22:58:28.084Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Xp9riR2fVQfTWoF3w5U8d4","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions';\n     2→import { getSql } from './db';\n     3→\n     4→async function authenticate(req: Request) {\n     5→  const authHeader = req.headers.get('Authorization');\n     6→  if (!authHeader?.startsWith('Bearer ')) return null;\n     7→  const token = authHeader.slice(7);\n     8→  const sql = getSql();\n     9→  const sessions = await sql`\n    10→    SELECT s.member_id FROM sessions s\n    11→    WHERE s.token = ${token} AND s.expires_at > NOW()\n    12→  `;\n    13→  const session = sessions[0];\n    14→  return session ? session.member_id as string : null;\n    15→}\n    16→\n    17→export default async function handler(req: Request, _context: Context) {\n    18→  try {\n    19→    const memberId = await authenticate(req);\n    20→    if (!memberId) {\n    21→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    22→        status: 401,\n    23→        headers: { 'Content-Type': 'application/json' },\n    24→      });\n    25→    }\n    26→\n    27→    const sql = getSql();\n    28→\n    29→    if (req.method === 'POST') {\n    30→      const body = await req.json();\n    31→      const { teamId, memberIdToAdd } = body as { teamId: string; memberIdToAdd: string };\n    32→\n    33→      if (!teamId || !memberIdToAdd) {\n    34→        return new Response(JSON.stringify({ error: 'teamId and memberIdToAdd are required' }), {\n    35→          status: 400,\n    36→          headers: { 'Content-Type': 'application/json' },\n    37→        });\n    38→      }\n    39→\n    40→      const existing = await sql`\n    41→        SELECT 1 FROM team_members WHERE team_id = ${teamId} AND member_id = ${memberIdToAdd}\n    42→      `;\n    43→      if (existing.length > 0) {\n    44→        return new Response(JSON.stringify({ error: 'Member is already on this team' }), {\n    45→          status: 409,\n    46→          headers: { 'Content-Type': 'application/json' },\n    47→        });\n    48→      }\n    49→\n    50→      await sql`\n    51→        INSERT INTO team_members (team_id, member_id)\n    52→        VALUES (${teamId}, ${memberIdToAdd})\n    53→      `;\n    54→\n    55→      const addedMembers = await sql`\n    56→        SELECT m.id, m.name, m.email\n    57→        FROM members m WHERE m.id = ${memberIdToAdd}\n    58→      `;\n    59→      const addedMember = addedMembers[0];\n    60→\n    61→      return new Response(JSON.stringify({ member: addedMember }), {\n    62→        status: 201,\n    63→        headers: { 'Content-Type': 'application/json' },\n    64→      });\n    65→    }\n    66→\n    67→    if (req.method === 'DELETE') {\n    68→      const body = await req.json();\n    69→      const { teamId, memberIdToRemove } = body as { teamId: string; memberIdToRemove: string };\n    70→\n    71→      if (!teamId || !memberIdToRemove) {\n    72→        return new Response(JSON.stringify({ error: 'teamId and memberIdToRemove are required' }), {\n    73→          status: 400,\n    74→          headers: { 'Content-Type': 'application/json' },\n    75→        });\n    76→      }\n    77→\n    78→      await sql`\n    79→        DELETE FROM team_members WHERE team_id = ${teamId} AND member_id = ${memberIdToRemove}\n    80→      `;\n    81→\n    82→      return new Response(JSON.stringify({ success: true }), {\n    83→        status: 200,\n    84→        headers: { 'Content-Type': 'application/json' },\n    85→      });\n    86→    }\n    87→\n    88→    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n    89→      status: 405,\n    90→      headers: { 'Content-Type': 'application/json' },\n    91→    });\n    92→  } catch (err) {\n    93→    console.error('Team members error:', err);\n    94→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n    95→      status: 500,\n    96→      headers: { 'Content-Type': 'application/json' },\n    97→    });\n    98→  }\n    99→}\n   100→"}]},"parent_tool_use_id":"toolu_018GPwKEcD1FYpyKVFpeMfoq","session_id":"90024d97-e35b-4034-b06d-d2556c8f7f36","uuid":"1857c7ed-7cee-4104-b8e5-84f712da4f0a"}
