ber.role === 'admin' ? 'member-role-badge-admin' : 'member-role-badge-member'}`}\n                data-testid={`member-role-badge-${member.id}`}\n              >\n                {member.role === 'admin' ? 'Admin' : 'Member'}\n              </span>\n            </div>\n            <div className=\"member-row-teams\" data-testid={`member-teams-${member.id}`}>\n              {member.teams.map((team) => (\n                <span\n                  key={team.id}\n                  className=\"member-team-badge\"\n                  data-testid={`member-team-badge-${member.id}-${team.id}`}\n                >\n                  {team.name}\n                </span>\n              ))}\n            </div>\n            <div className=\"member-row-actions\">\n              <MemberActions\n                member={member}\n                isSelf={isSelf}\n                isLastAdmin={isLastAdmin}\n                onChangeRole={onChangeRole}\n                onRemove={onRemove}\n              />\n            </div>\n          </div>\n        );\n      })}\n    </div>\n  );\n}\n","numLines":109,"startLine":1,"totalLines":109}}}
