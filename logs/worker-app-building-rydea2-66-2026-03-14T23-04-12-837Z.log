[2026-03-14T22:59:44.182Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XvZwb5vzAYezKtNEeJogeA","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions';\n     2→import { getSql } from './db';\n     3→import crypto from 'crypto';\n     4→\n     5→function hashPassword(password: string, salt: string): string {\n     6→  return crypto.pbkdf2Sync(password, salt, 10000, 64, 'sha512').toString('hex');\n     7→}\n     8→\n     9→export default async function handler(req: Request, _context: Context) {\n    10→  const sql = getSql();\n    11→\n    12→  // Authenticate\n    13→  const authHeader = req.headers.get('Authorization');\n    14→  if (!authHeader?.startsWith('Bearer ')) {\n    15→    return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    16→      status: 401,\n    17→      headers: { 'Content-Type': 'application/json' },\n    18→    });\n    19→  }\n    20→\n    21→  const token = authHeader.slice(7);\n    22→  const sessions = await sql`\n    23→    SELECT s.member_id, m.name, m.email, m.role\n    24→    FROM sessions s\n    25→    JOIN members m ON m.id = s.member_id\n    26→    WHERE s.token = ${token} AND s.expires_at > NOW()\n    27→  `;\n    28→  const session = sessions[0];\n    29→  if (!session) {\n    30→    return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    31→      status: 401,\n    32→      headers: { 'Content-Type': 'application/json' },\n    33→    });\n    34→  }\n    35→\n    36→  const currentUserId = session.member_id as string;\n    37→\n    38→  try {\n    39→    // GET - list all members with their teams\n    40→    if (req.method === 'GET') {\n    41→      const members = await sql`\n    42→        SELECT m.id, m.name, m.email, m.role\n    43→        FROM members m\n    44→        ORDER BY m.name ASC\n    45→      `;\n    46→\n    47→      const teamMembers = await sql`\n    48→        SELECT tm.member_id, t.id AS team_id, t.name AS team_name\n    49→        FROM team_members tm\n    50→        JOIN teams t ON t.id = tm.team_id\n    51→        ORDER BY t.name ASC\n    52→      `;\n    53→\n    54→      const membersWithTeams = members.map((m) => ({\n    55→        ...m,\n    56→        teams: teamMembers\n    57→          .filter((tm) => tm.member_id === m.id)\n    58→          .map((tm) => ({ id: tm.team_id, name: tm.team_name })),\n    59→      }));\n    60→\n    61→      return new Response(JSON.stringify({ members: membersWithTeams, currentUserId }), {\n    62→        status: 200,\n    63→        headers: { 'Content-Type': 'application/json' },\n    64→      });\n    65→    }\n    66→\n    67→    // POST - invite a new member\n    68→    if (req.method === 'POST') {\n    69→      const { email } = await req.json();\n    70→\n    71→      if (!email || typeof email !== 'string') {\n    72→        return new Response(JSON.stringify({ error: 'Email is required' }), {\n    73→          status: 400,\n    74→          headers: { 'Content-Type': 'application/json' },\n    75→        });\n    76→      }\n    77→\n    78→      const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n    79→      if (!emailRegex.test(email)) {\n    80→        return new Response(JSON.stringify({ error: 'Please enter a valid email address' }), {\n    81→          status: 400,\n    82→          headers: { 'Content-Type': 'application/json' },\n    83→        });\n    84→      }\n    85→\n    86→      const existing = await sql`SELECT id FROM members WHERE email = ${email}`;\n    87→      if (existing.length > 0) {\n    88→        return new Response(JSON.stringify({ error: 'This email is already a member of the workspace' }), {\n    89→          status: 409,\n    90→          headers: { 'Content-Type': 'application/json' },\n    91→        });\n    92→      }\n    93→\n    94→      const memberId = crypto.randomUUID();\n    95→      const name = email.split('@')[0] || 'New Member';\n    96→      const salt = crypto.randomBytes(16).toString('hex');\n    97→      const passwordHash = hashPassword('temporary123', salt);\n    98→\n    99→      await sql`\n   100→        INSERT INTO members (id, name, email, password_hash, password_salt, role)\n   101→        VALUES (${memberId}, ${name}, ${email}, ${passwordHash}, ${salt}, 'member')\n   102→      `;\n   103→\n   104→      const member = {\n   105→        id: memberId,\n   106→        name,\n   107→        email,\n   108→        role: 'member',\n   109→        teams: [],\n   110→      };\n   111→\n   112→      return new Response(JSON.stringify({ member }), {\n   113→        status: 201,\n   114→        headers: { 'Content-Type': 'application/json' },\n   115→      });\n   116→    }\n   117→\n   118→    // PUT - update member role\n   119→    if (req.method === 'PUT') {\n   120→      const url = new URL(req.url);\n   121→      const segments = url.pathname.split('/').filter(Boolean);\n   122→      const memberId = segments[segments.length - 1];\n   123→\n   124→      if (!memberId) {\n   125→        return new Response(JSON.stringify({ error: 'Member ID required' }), {\n   126→          status: 400,\n   127→          headers: { 'Content-Type': 'application/json' },\n   128→        });\n   129→      }\n   130→\n   131→      const { role } = await req.json();\n   132→\n   133→      if (!role || !['admin', 'member'].includes(role)) {\n   134→        return new Response(JSON.stringify({ error: 'Valid role is required (admin or member)' }), {\n   135→          status: 400,\n   136→          headers: { 'Content-Type': 'application/json' },\n   137→        });\n   138→      }\n   139→\n   140→      // Cannot demote the last admin\n   141→      if (role === 'member') {\n   142→        const admins = await sql`SELECT id FROM members WHERE role = 'admin'`;\n   143→        const targetIsAdmin = admins.some((a) => a.id === memberId);\n   144→        if (targetIsAdmin && admins.length <= 1) {\n   145→          return new Response(JSON.stringify({ error: 'Cannot demote the last Admin' }), {\n   146→            status: 400,\n   147→            headers: { 'Content-Type': 'application/json' },\n   148→          });\n   149→        }\n   150→      }\n   151→\n   152→      await sql`UPDATE members SET role = ${role} WHERE id = ${memberId}`;\n   153→\n   154→      return new Response(JSON.stringify({ success: true, memberId, role }), {\n   155→        status: 200,\n   156→        headers: { 'Content-Type': 'application/json' },\n   157→      });\n   158→    }\n   159→\n   160→    // DELETE - remove a member\n   161→    if (req.method === 'DELETE') {\n   162→      const url = new URL(req.url);\n   163→      const segments = url.pathname.split('/').filter(Boolean);\n   164→      const memberId = segments[segments.length - 1];\n   165→\n   166→      if (!memberId) {\n   167→        return new Response(JSON.stringify({ error: 'Member ID required' }), {\n   168→          status: 400,\n   169→          headers: { 'Content-Type': 'application/json' },\n   170→        });\n   171→      }\n   172→\n   173→      if (memberId === currentUserId) {\n   174→        return new Response(JSON.stringify({ error: 'Cannot remove yourself' }), {\n   175→          status: 400,\n   176→          headers: { 'Content-Type': 'application/json' },\n   177→        });\n   178→      }\n   179→\n   180→      // Remove from team_members first (FK dependency)\n   181→      await sql`DELETE FROM team_members WHERE member_id = ${memberId}`;\n   182→      // Remove sessions\n   183→      await sql`DELETE FROM sessions WHERE member_id = ${memberId}`;\n   184→      // Remove the member\n   185→      await sql`DELETE FROM members WHERE id = ${memberId}`;\n   186→\n   187→      return new Response(JSON.stringify({ success: true, memberId }), {\n   188→        status: 200,\n   189→        headers: { 'Content-Type': 'application/json' },\n   190→      });\n   191→    }\n   192→\n   193→    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n   194→      status: 405,\n   195→      headers: { 'Content-Type': 'application/json' },\n   196→    });\n   197→  } catch (err) {\n   198→    console.error('Members endpoint error:', err);\n   199→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n   200→      status: 500,\n   201→      headers: { 'Content-Type': 'application/json' },\n   202→    });\n   203→  }\n   204→}\n   205→"}]},"parent_tool_use_id":null,"session_id":"90024d97-e35b-4034-b06d-d2556c8f7f36","uuid":"e84746e0-bc25-4576-a09e-9969ca603203","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/netlify/functions/members.ts","content":"import type { Context } from '@netlify/functions';\nimport { getSql } from './db';\nimport crypto from 'crypto';\n\nfunction hashPassword(password: string, salt: string): string {\n  return crypto.pbkdf2Sync(password, salt, 10000, 64, 'sha512').toString('hex');\n}\n\nexport default async function handler(req: Request, _context: Context) {\n  const sql = getSql();\n\n  // Authenticate\n  const authHeader = req.headers.get('Authorization');\n  if (!authHeader?.startsWith('Bearer ')) {\n    return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n      status: 401,\n      headers: { 'Content-Type': 'application/json' },\n    });\n  }\n\n  const token = authHeader.slice(7);\n  const sessions = await sql`\n    SELECT s.member_id, m.name, m.email, m.role\n    FROM sessions s\n    JOIN members m ON m.id = s.member_id\n    WHERE s.token = ${token} AND s.expires_at > NOW()\n  `;\n  const session = sessions[0];\n  if (!session) {\n    return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n      status: 401,\n      headers: { 'Content-Type': 'application/json' },\n    });\n  }\n\n  const currentUserId = session.member_id as string;\n\n  try {\n    // GET - list all members with their teams\n    if (req.method === 'GET') {\n      const members = await sql`\n        SELECT m.id, m.name, m.email, m.role\n        FROM members m\n        ORDER BY m.name ASC\n      `;\n\n      const teamMembers = await sql`\n        SELECT tm.member_id, t.id AS team_id, t.name AS team_name\n        FROM team_members tm\n        JOIN teams t ON t.id = tm.team_id\n        ORDER BY t.name ASC\n      `;\n\n      const membersWithTeams = members.map((m) => ({\n        ...m,\n        teams: teamMembers\n          .filter((tm) => tm.member_id === m.id)\n          .map((tm) => ({ id: tm.team_id, name: tm.team_name })),\n      }));\n\n      return new Response(JSON.stringify({ members: membersWithTeams, currentUserId }), {\n        status: 200,\n        headers: { 'Content-Type': 'application/json' },\n      });\n    }\n\n    // POST - invite a new member\n    if (req.method === 'POST') {\n      const { email } = await req.json();\n\n      if (!email || typeof email !== 'string') {\n        return new Response(JSON.stringify({ error: 'Email is required' }), {\n          status: 400,\n          headers: { 'Content-Type': 'application/json' },\n        });\n      }\n\n      const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n      if (!emailRegex.test(email)) {\n        return new Response(JSON.stringify({ error: 'Please enter a valid email address' }), {\n          status: 400,\n          headers: { 'Content-Type': 'application/json' },\n        });\n      }\n\n      const existing = await sql`SELECT id FROM members WHERE email = ${email}`;\n      if (existing.length > 0) {\n        return new Response(JSON.stringify({ error: 'This email is already a member of the workspace' }), {\n          status: 409,\n          headers: { 'Content-Type': 'application/json' },\n        });\n      }\n\n      const memberId = crypto.randomUUID();\n      const name = email.split('@')[0] || 'New Member';\n      const salt = crypto.randomBytes(16).toString('hex');\n      const passwordHash = hashPassword('temporary123', salt);\n\n      await sql`\n        INSERT INTO members (id, name, email, password_hash, password_salt, role)\n        VALUES (${memberId}, ${name}, ${email}, ${passwordHash}, ${salt}, 'member')\n      `;\n\n      const member = {\n        id: memberId,\n        name,\n        email,\n        role: 'member',\n        teams: [],\n      };\n\n      return new Response(JSON.stringify({ member }), {\n        status: 201,\n        headers: { 'Content-Type': 'application/json' },\n      });\n    }\n\n    // PUT - update member role\n    if (req.method === 'PUT') {\n      const url = new URL(req.url);\n      const segments = url.pathname.split('/').filter(Boolean);\n      const memberId = segments[segments.length - 1];\n\n      if (!memberId) {\n        return new Response(JSON.stringify({ error: 'Member ID required' }), {\n          status: 400,\n          headers: { 'Content-Type': 'application/json' },\n        });\n      }\n\n      const { role } = await req.json();\n\n      if (!role || !['admin', 'member'].includes(role)) {\n        return new Response(JSON.stringify({ error: 'Valid role is required (admin or member)' }), {\n          status: 400,\n          headers: { 'Content-Type': 'application/json' },\n        });\n      }\n\n      // Cannot demote the last admin\n      if (role === 'member') {\n        const admins = await sql`SELECT id FROM members WHERE role = 'admin'`;\n        const targetIsAdmin = admins.some((a) => a.id === memberId);\n        if (targetIsAdmin && admins.length <= 1) {\n          return new Response(JSON.stringify({ error: 'Cannot demote the last Admin' }), {\n            status: 400,\n            headers: { 'Content-Type': 'application/json' },\n          });\n        }\n      }\n\n      await sql`UPDATE members SET role = ${role} WHERE id = ${memberId}`;\n\n      return new Response(JSON.stringify({ success: true, memberId, role }), {\n        status: 200,\n        headers: { 'Content-Type': 'application/json' },\n      });\n    }\n\n    // DELETE - remove a member\n    if (req.method === 'DELETE') {\n      const url = new URL(req.url);\n      const segments = url.pathname.split('/').filter(Boolean);\n      const memberId = segments[segments.length - 1];\n\n      if (!memberId) {\n        return new Response(JSON.stringify({ error: 'Member ID required' }), {\n          status: 400,\n          headers: { 'Content-Type': 'application/json' },\n        });\n      }\n\n      if (memberId === currentUserId) {\n        return new Response(JSON.stringify({ error: 'Cannot remove yourself' }), {\n          status: 400,\n          headers: { 'Content-Type': 'application/json' },\n        });\n      }\n\n      // Remove from team_members first (FK dependency)\n      await sql`DELETE FROM team_members WHERE member_id = ${memberId}`;\n      // Remove sessions\n      await sql`DELETE FROM sessions WHERE member_id = ${memberId}`;\n      // Remove the member\n      await sql`DELETE FROM members WHERE id = ${memberId}`;\n\n      return new Response(JSON.stringify({ success: true, memberId }), {\n        status: 200,\n        headers: { 'Content-Type': 'application/json' },\n      });\n    }\n\n    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n      status: 405,\n      headers: { 'Content-Type': 'application/json' },\n    });\n  } catch (err) {\n    console.error('Members endpoint error:', err);\n    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n      status: 500,\n      headers: { 'Content-Type': 'application/json' },\n    });\n  }\n}\n","numLines":205,"startLine":1,"totalLines":205}}}
