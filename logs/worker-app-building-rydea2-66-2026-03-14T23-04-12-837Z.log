  async function handleConfirmRemove() {\n    52→    setUpdating(true);\n    53→    try {\n    54→      await onRemove(member.id);\n    55→    } finally {\n    56→      setUpdating(false);\n    57→      setConfirmRemoveOpen(false);\n    58→    }\n    59→  }\n    60→\n    61→  const roleDisabled = isSelf && isLastAdmin;\n    62→\n    63→  return (\n    64→    <div className=\"member-actions\" data-testid={`member-actions-${member.id}`}>\n    65→      <div className=\"member-actions-role-wrapper\" ref={dropdownRef}>\n    66→        <button\n    67→          className=\"member-actions-role-btn\"\n    68→          onClick={() => setRoleDropdownOpen(!roleDropdownOpen)}\n    69→          disabled={roleDisabled || updating}\n    70→          title={roleDisabled ? 'Cannot demote the last Admin' : 'Change role'}\n    71→          data-testid={`member-role-dropdown-btn-${member.id}`}\n    72→        >\n    73→          <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n    74→            <polyline points=\"6 9 12 15 18 9\" />\n    75→          </svg>\n    76→        </button>\n    77→        {roleDropdownOpen && (\n    78→          <div className=\"member-actions-role-dropdown\" data-testid={`member-role-dropdown-${member.id}`}>\n    79→            <button\n    80→              className={`member-actions-role-option ${member.role === 'admin' ? 'member-actions-role-option-active' : ''}`}\n    81→              onClick={() => handleRoleChange('admin')}\n    82→              data-testid={`member-role-option-admin-${member.id}`}\n    83→            >\n    84→              <span>Admin</span>\n    85→              {member.role === 'admin' && (\n    86→                <svg className=\"member-actions-check\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"20 6 9 17 4 12\" /></svg>\n    87→             