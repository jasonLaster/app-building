[2026-03-14T22:59:39.324Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KhjQvcZ6yqWX28MSrrmB6w","type":"tool_result","content":"     1→import { useState, useEffect, useCallback, useRef } from 'react';\n     2→import './InviteMemberModal.css';\n     3→\n     4→interface InviteMemberModalProps {\n     5→  open: boolean;\n     6→  onClose: () => void;\n     7→  onSubmit: (email: string) => Promise<void>;\n     8→}\n     9→\n    10→export default function InviteMemberModal({ open, onClose, onSubmit }: InviteMemberModalProps) {\n    11→  const [email, setEmail] = useState('');\n    12→  const [error, setError] = useState<string | null>(null);\n    13→  const [submitting, setSubmitting] = useState(false);\n    14→  const emailRef = useRef<HTMLInputElement>(null);\n    15→\n    16→  useEffect(() => {\n    17→    if (open) {\n    18→      setEmail('');\n    19→      setError(null);\n    20→      setSubmitting(false);\n    21→      setTimeout(() => emailRef.current?.focus(), 50);\n    22→    }\n    23→  }, [open]);\n    24→\n    25→  const handleClose = useCallback(() => {\n    26→    onClose();\n    27→  }, [onClose]);\n    28→\n    29→  useEffect(() => {\n    30→    if (!open) return;\n    31→    function handleKeyDown(e: KeyboardEvent) {\n    32→      if (e.key === 'Escape') {\n    33→        handleClose();\n    34→      }\n    35→    }\n    36→    document.addEventListener('keydown', handleKeyDown);\n    37→    return () => document.removeEventListener('keydown', handleKeyDown);\n    38→  }, [open, handleClose]);\n    39→\n    40→  async function handleSubmit() {\n    41→    const trimmed = email.trim();\n    42→    if (!trimmed) {\n    43→      setError('Email is required');\n    44→      return;\n    45→    }\n    46→\n    47→    const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n    48→    if (!emailRegex.test(trimmed)) {\n    49→      setError('Please enter a valid email address');\n    50→      return;\n    51→    }\n    52→\n    53→    setError(null);\n    54→    setSubmitting(true);\n    55→    try {\n    56→      await onSubmit(trimmed);\n    57→    } catch (err) {\n    58→      if (err instanceof Error) {\n    59→        setError(err.message);\n    60→      } else if (typeof err === 'string') {\n    61→        setError(err);\n    62→      } else {\n    63→        setError('Failed to invite member');\n    64→      }\n    65→      setSubmitting(false);\n    66→    }\n    67→  }\n    68→\n    69→  function handleOverlayClick(e: React.MouseEvent) {\n    70→    if (e.target === e.currentTarget) {\n    71→      handleClose();\n    72→    }\n    73→  }\n    74→\n    75→  function handleKeyDown(e: React.KeyboardEvent) {\n    76→    if (e.key === 'Enter') {\n    77→      e.preventDefault();\n    78→      handleSubmit();\n    79→    }\n    80→  }\n    81→\n    82→  if (!open) return null;\n    83→\n    84→  return (\n    85→    <div\n    86→      className=\"invite-member-overlay\"\n    87→      onClick={handleOverlayClick}\n    88→      data-testid=\"invite-member-modal-overlay\"\n    89→    >\n    90→      <div className=\"invite-member-modal\" data-testid=\"invite-member-modal\">\n    91→        <div className=\"imm-header\">\n    92→          <h2 className=\"imm-title\">Invite Member</h2>\n    93→        </div>\n    94→\n    95→        <div className=\"imm-body\">\n    96→          <div className=\"imm-field\" data-testid=\"invite-member-email-field\">\n    97→            <label className=\"imm-label\">Email address</label>\n    98→            <input\n    99→              ref={emailRef}\n   100→              type=\"email\"\n   101→              className={`imm-input ${error ? 'imm-input-error' : ''}`}\n   102→              placeholder=\"colleague@example.com\"\n   103→              value={email}\n   104→              onChange={(e) => { setEmail(e.target.value); setError(null); }}\n   105→              onKeyDown={handleKeyDown}\n   106→              data-testid=\"invite-member-email-input\"\n   107→            />\n   108→            {error && (\n   109→              <span className=\"imm-error\" data-testid=\"invite-member-error\">\n   110→                {error}\n   111→              </span>\n   112→            )}\n   113→          </div>\n   114→        </div>\n   115→\n   116→        <div className=\"imm-footer\">\n   117→          <button\n   118→            className=\"imm-cancel-btn\"\n   119→            onClick={handleClose}\n   120→            data-testid=\"invite-member-cancel-btn\"\n   121→          >\n   122→            Cancel\n   123→          </button>\n   124→          <button\n   125→            className=\"imm-submit-btn\"\n   126→            onClick={handleSubmit}\n   127→            disabled={submitting}\n   128→            data-testid=\"invite-member-submit-btn\"\n   129→          >\n   130→            {submitting ? 'Sending...' : 'Send Invite'}\n   131→          </button>\n   132→        </div>\n   133→      </div>\n   134→    </div>\n   135→  );\n   136→}\n   137→"}]},"parent_tool_use_id":null,"session_id":"90024d97-e35b-4034-b06d-d2556c8f7f36","uuid":"b71ae5ff-c6b2-42ef-9e3f-b76f74be6f4a","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/src/components/InviteMemberModal.tsx","content":"import { useState, useEffect, useCallback, useRef } from 'react';\nimport './InviteMemberModal.css';\n\ninterface InviteMemberModalProps {\n  open: boolean;\n  onClose: () => void;\n  onSubmit: (email: string) => Promise<void>;\n}\n\nexport default function InviteMemberModal({ open, onClose, onSubmit }: InviteMemberModalProps) {\n  const [email, setEmail] = useState('');\n  const [error, setError] = useState<string | null>(null);\n  const [submitting, setSubmitting] = useState(false);\n  const emailRef = useRef<HTMLInputElement>(null);\n\n  useEffect(() => {\n    if (open) {\n      setEmail('');\n      setError(null);\n      setSubmitting(false);\n      setTimeout(() => emailRef.current?.focus(), 50);\n    }\n  }, [open]);\n\n  const handleClose = useCallback(() => {\n    onClose();\n  }, [onClose]);\n\n  useEffect(() => {\n    if (!open) return;\n    function handleKeyDown(e: KeyboardEvent) {\n      if (e.key === 'Escape') {\n        handleClose();\n      }\n    }\n    document.addEventListener('keydown', handleKeyDown);\n    return () => document.removeEventListener('keydown', handleKeyDown);\n  }, [open, handleClose]);\n\n  async function handleSubmit() {\n    const trimmed = email.trim();\n    if (!trimmed) {\n      setError('Email is required');\n      return;\n    }\n\n    const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n    if (!emailRegex.test(trimmed)) {\n      setError('Please enter a valid email address');\n      return;\n    }\n\n    setError(null);\n    setSubmitting(true);\n    try {\n      await onSubmit(trimmed);\n    } catch (err) {\n      if (err instanceof Error) {\n        setError(err.message);\n      } else if (typeof err === 'string') {\n        setError(err);\n      } else {\n        setError('Failed to invite member');\n      }\n      setSubmitting(false);\n    }\n  }\n\n  function handleOverlayClick(e: React.MouseEvent) {\n    if (e.target === e.currentTarget) {\n      handleClose();\n    }\n  }\n\n  function handleKeyDown(e: React.KeyboardEvent) {\n    if (e.key === 'Enter') {\n      e.preventDefault();\n      handleSubmit();\n    }\n  }\n\n  if (!open) return null;\n\n  return (\n    <div\n      className=\"invite-member-overlay\"\n      onClick={handleOverlayClick}\n      data-testid=\"invite-member-modal-overlay\"\n    >\n      <div className=\"invite-member-modal\" data-testid=\"invite-member-modal\">\n        <div className=\"imm-header\">\n          <h2 className=\"imm-title\">Invite Member</h2>\n        </div>\n\n        <div className=\"imm-body\">\n          <div className=\"imm-field\" data-testid=\"invite-member-email-field\">\n            <label className=\"imm-label\">Email address</label>\n            <input\n              ref={emailRef}\n              type=\"email\"\n              className={`imm-input ${error ? 'imm-input-error' : ''}`}\n              placeholder=\"colleague@example.com\"\n              value={email}\n              onChange={(e) => { setEmail(e.target.value); setError(null); }}\n              onKeyDown={handleKeyDown}\n              data-testid=\"invite-member-email-input\"\n            />\n            {error && (\n              <span className=\"imm-error\" data-testid=\"invite-member-error\">\n                {error}\n              </span>\n            )}\n          </div>\n        </div>\n\n        <div className=\"imm-footer\">\n          <button\n            className=\"imm-cancel-btn\"\n            onClick={handleClose}\n            data-testid=\"invite-member-cancel-btn\"\n          >\n            Cancel\n          </button>\n          <button\n            className=\"imm-submit-btn\"\n            onClick={handleSubmit}\n            disabled={submitting}\n            data-testid=\"invite-member-submit-btn\"\n          >\n            {submitting ? 'Sending...' : 'Send Invite'}\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n}\n","numLines":137,"startLine":1,"totalLines":137}}}
