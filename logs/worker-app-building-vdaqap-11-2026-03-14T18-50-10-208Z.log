arDestinations.map((dest) => (\n          <button\n            key={dest.id}\n            className=\"popular-destinations__card\"\n            onClick={() => handleClick(dest)}\n            data-testid={`popular-dest-${dest.iata_code}`}\n          >\n            <div\n              className=\"popular-destinations__image\"\n              style={{ background: dest.gradient }}\n            >\n              <span className=\"popular-destinations__code\">{dest.iata_code}</span>\n            </div>\n            <div className=\"popular-destinations__info\">\n              <span className=\"popular-destinations__city\">{dest.city}</span>\n              <span className=\"popular-destinations__country\">{dest.country}</span>\n              {dest.min_price !== null && (\n                <span className=\"popular-destinations__price\" data-testid={`popular-dest-price-${dest.iata_code}`}>\n                  from ${dest.min_price}\n                </span>\n              )}\n            </div>\n          </button>\n        ))}\n      </div>\n    </div>\n  )\n}\n\nexport default PopularDestinations\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1976,"cache_read_input_tokens":110520,"cache_creation":{"ephemeral_5m_input_tokens":1976,"ephemeral_1h_input_tokens":0},"output_tokens":24,"service_tier":"standard","inference_geo":"global"},"context_management":null},"parent_tool_use_id":null,"session_id":"e83b6a70-0e11-4c8e-bdc4-82e0f5b3de96","uuid":"abeb6710-d034-4684-ad32-90e61a4b5faf"}
