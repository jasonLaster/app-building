-overflow: ellipsis;\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1918,"cache_read_input_tokens":95279,"cache_creation":{"ephemeral_5m_input_tokens":1918,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard","inference_geo":"global"},"context_management":null},"parent_tool_use_id":null,"session_id":"e83b6a70-0e11-4c8e-bdc4-82e0f5b3de96","uuid":"a7b8cb96-de88-4341-b8a1-38c25f12ed3c"}
