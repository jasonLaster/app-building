[2026-03-14T22:29:38.247Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BPVTsk1KjRysZehPgt89bj","type":"tool_result","content":"     1→import { useEffect, useCallback } from 'react'\n     2→import { useDispatch, useSelector } from 'react-redux'\n     3→import {\n     4→  setExploreOrigin,\n     5→  setDateRange,\n     6→  fetchExploreDestinations,\n     7→  fetchExploreDates,\n     8→  fetchExploreDeals,\n     9→} from '../slices/exploreSlice'\n    10→import type { DateRange } from '../slices/exploreSlice'\n    11→import type { Airport } from '../slices/searchSlice'\n    12→import type { RootState, AppDispatch } from '../store'\n    13→import AirportAutocomplete from '../components/AirportAutocomplete'\n    14→import DestinationMap from '../components/DestinationMap'\n    15→import FlexibleDatesGrid from '../components/FlexibleDatesGrid'\n    16→import DealsSection from '../components/DealsSection'\n    17→import './ExplorePage.css'\n    18→\n    19→function ExplorePage() {\n    20→  const dispatch = useDispatch<AppDispatch>()\n    21→  const {\n    22→    origin,\n    23→    destinations,\n    24→    destinationsLoading,\n    25→    datePrices,\n    26→    datePricesLoading,\n    27→    dateRange,\n    28→    deals,\n    29→    dealsLoading,\n    30→  } = useSelector((state: RootState) => state.explore)\n    31→\n    32→  useEffect(() => {\n    33→    if (!origin) return\n    34→    dispatch(fetchExploreDestinations(origin.iata_code))\n    35→    dispatch(fetchExploreDeals(origin.iata_code))\n    36→  }, [dispatch, origin])\n    37→\n    38→  useEffect(() => {\n    39→    if (!origin) return\n    40→    dispatch(fetchExploreDates({ originCode: origin.iata_code, dateRange }))\n    41→  }, [dispatch, origin, dateRange])\n    42→\n    43→  const handleOriginChange = useCallback((airport: Airport | null) => {\n    44→    dispatch(setExploreOrigin(airport))\n    45→  }, [dispatch])\n    46→\n    47→  const handleDateRangeChange = useCallback((range: DateRange) => {\n    48→    dispatch(setDateRange(range))\n    49→  }, [dispatch])\n    50→\n    51→  return (\n    52→    <div className=\"explore-page\" data-testid=\"explore-page\">\n    53→      <div className=\"explore-page__header\">\n    54→        <h1 className=\"explore-page__title\">Explore destinations</h1>\n    55→        <p className=\"explore-page__subtitle\">Find cheap flights from your airport</p>\n    56→      </div>\n    57→\n    58→      <div className=\"explore-page__origin-selector\" data-testid=\"explore-origin-selector\">\n    59→        <label className=\"explore-page__origin-label\">From</label>\n    60→        <AirportAutocomplete\n    61→          value={origin}\n    62→          onChange={handleOriginChange}\n    63→          placeholder=\"Select origin airport\"\n    64→          testIdPrefix=\"explore-origin\"\n    65→        />\n    66→      </div>\n    67→\n    68→      <div className=\"explore-page__sections\">\n    69→        <section className=\"explore-page__map-section\">\n    70→          <DestinationMap\n    71→            destinations={destinations}\n    72→            loading={destinationsLoading}\n    73→            originCode={origin?.iata_code || null}\n    74→          />\n    75→        </section>\n    76→\n    77→        <section className=\"explore-page__dates-section\">\n    78→          <FlexibleDatesGrid\n    79→            datePrices={datePrices}\n    80→            loading={datePricesLoading}\n    81→            dateRange={dateRange}\n    82→            onDateRangeChange={handleDateRangeChange}\n    83→            originCode={origin?.iata_code || null}\n    84→          />\n    85→        </section>\n    86→\n    87→        <section className=\"explore-page__deals-section\">\n    88→          <DealsSection\n    89→            deals={deals}\n    90→            loading={dealsLoading}\n    91→            originCode={origin?.iata_code || null}\n    92→          />\n    93→        </section>\n    94→      </div>\n    95→    </div>\n    96→  )\n    97→}\n    98→\n    99→export default ExplorePage\n   100→"}]},"parent_tool_use_id":"toolu_01Tz9XJZ7PTYGxNtWeGP27V9","session_id":"630917b2-6ea2-4867-b126-d32adb3e5b74","uuid":"219ca016-a5df-42a3-96f0-6f82aa980a0d"}
