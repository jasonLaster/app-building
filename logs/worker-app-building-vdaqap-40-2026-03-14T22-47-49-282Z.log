{\n    66→  font-size: 16px;\n    67→  font-weight: 600;\n    68→  color: var(--color-text-primary);\n    69→}\n    70→\n    71→.deals-section__card-country {\n    72→  font-size: 12px;\n    73→  color: var(--color-text-secondary);\n    74→}\n    75→\n    76→.deals-section__card-dates {\n    77→  font-size: 13px;\n    78→  color: var(--color-text-secondary);\n    79→}\n    80→\n    81→.deals-section__card-pricing {\n    82→  display: flex;\n    83→  align-items: baseline;\n    84→  gap: 8px;\n    85→  margin-top: 4px;\n    86→  flex-wrap: wrap;\n    87→}\n    88→\n    89→.deals-section__card-price {\n    90→  font-size: 20px;\n    91→  font-weight: 700;\n    92→  color: var(--color-text-primary);\n    93→}\n    94→\n    95→.deals-section__card-savings {\n    96→  font-size: 12px;\n    97→  font-weight: 500;\n    98→  color: var(--color-success);\n    99→}\n   100→\n   101→.deals-section__loading {\n   102→  padding: 0;\n   103→}\n   104→\n   105→.deals-section__skeleton-grid {\n   106→  display: grid;\n   107→  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));\n   108→  gap: 16px;\n   109→}\n   110→\n   111→.deals-section__skeleton-card {\n   112→  height: 200px;\n   113→  border-radius: var(--radius-md);\n   114→  background: var(--color-border-light);\n   115→  animation: deals-pulse 1.5s infinite;\n   116→}\n   117→\n   118→@keyframes deals-pulse {\n   119→  0%, 100% { opacity: 1; }\n   120→  50% { opacity: 0.5; }\n   121→}\n   122→\n   123→.deals-section__empty {\n   124→  text-align: center;\n   125→  padding: 40px 16px;\n   126→  font-size: 14px;\n   127→  color: var(--color-text-secondary);\n   128→}\n   129→"}]},"parent_tool_use_id":"toolu_01Tz9XJZ7PTYGxNtWeGP27V9","session_id":"630917b2-6ea2-4867-b126-d32adb3e5b74","uuid":"80651f7f-3e01-4278-8f29-6b38e244de61"}
