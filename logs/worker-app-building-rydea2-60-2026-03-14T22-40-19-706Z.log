113→  ) => {\n   114→    const state = getState() as { auth: { token: string | null } };\n   115→    const token = state.auth.token;\n   116→    if (!token) return rejectWithValue('No token');\n   117→    const response = await fetch('/api/project-milestones', {\n   118→      method: 'POST',\n   119→      headers: {\n   120→        'Content-Type': 'application/json',\n   121→        Authorization: `Bearer ${token}`,\n   122→      },\n   123→      body: JSON.stringify(payload),\n   124→    });\n   125→    if (!response.ok) {\n   126→      return rejectWithValue('Failed to create milestone');\n   127→    }\n   128→    return await response.json() as { milestone: ProjectMilestone };\n   129→  }\n   130→);\n   131→\n   132→export const updateMilestone = createAsyncThunk(\n   133→  'projectDetail/updateMilestone',\n   134→  async (\n   135→    payload: { milestoneId: string; projectId: string; name?: string; targetDate?: string | null; completed?: boolean },\n   136→    { getState, rejectWithValue }\n   137→  ) => {\n   138→    const state = getState() as { auth: { token: string | null } };\n   139→    const token = state.auth.token;\n   140→    if (!token) return rejectWithValue('No token');\n   141→    const response = await fetch('/api/project-milestones', {\n   142→      method: 'PUT',\n   143→      headers: {\n   144→        'Content-Type': 'application/json',\n   145→        Authorization: `Bearer ${token}`,\n   146→      },\n   147→      body: JSON.stringify(payload),\n   148→    });\n   149→    if (!response.ok) {\n   150→      return rejectWithValue('Failed to update milestone');"}]},"parent_tool_use_id":"toolu_01EU2QPa8QJNsK7xhJLMtquJ","session_id":"ec926985-4614-4c34-906c-86ecc6695d62","uuid":"0226a107-5134-4624-83b6-97128290eac4"}
