[2026-03-14T22:37:04.677Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011vRQZsfF2JWZb5zCTFF3Kz","type":"tool_result","content":"     1→import { useState, useRef, useEffect } from 'react';\n     2→import { useDispatch } from 'react-redux';\n     3→import type { AppDispatch } from '../store';\n     4→import type { ProjectDetail, ProjectMember } from '../slices/projectDetailSlice';\n     5→import { updateProjectField } from '../slices/projectDetailSlice';\n     6→import './ProjectHeader.css';\n     7→\n     8→const PROJECT_STATUS_ORDER = ['planned', 'in_progress', 'completed', 'cancelled'] as const;\n     9→\n    10→const PROJECT_STATUS_CONFIG: Record<string, { label: string; className: string }> = {\n    11→  planned: { label: 'Planned', className: 'project-header-badge-planned' },\n    12→  in_progress: { label: 'In Progress', className: 'project-header-badge-in-progress' },\n    13→  completed: { label: 'Completed', className: 'project-header-badge-completed' },\n    14→  cancelled: { label: 'Cancelled', className: 'project-header-badge-cancelled' },\n    15→};\n    16→\n    17→function getInitials(name: string): string {\n    18→  return name.split(' ').map((n) => n[0]).join('').toUpperCase().slice(0, 2);\n    19→}\n    20→\n    21→function formatTargetDate(dateStr: string): string {\n    22→  const d = new Date(dateStr + 'T00:00:00');\n    23→  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });\n    24→}\n    25→\n    26→interface ProjectHeaderProps {\n    27→  project: ProjectDetail;\n    28→  members: ProjectMember[];\n    29→  activeTab: 'issues' | 'overview';\n    30→  onTabChange: (tab: 'issues' | 'overview') => void;\n    31→}\n    32→\n    33→export default function ProjectHeader({ project, members, activeTab, onTabChange }: ProjectHeaderProps) {\n    34→  const dispatch = useDispatch<AppDispatch>();\n    35→\n    36→  // Name editing\n    37→  const [editingName, setEditingName] = useState(false);\n    38→  const [nameValue, setNameValue] = useState(project.name);\n    39→  const [nameError, setNameError] = useState(false);\n    40→  const nameInputRef = useRef<HTMLInputElement>(null);\n    41→\n    42→  // Status dropdown\n    43→  const [statusDropdownOpen, setStatusDropdownOpen] = useState(false);\n    44→  const statusRef = useRef<HTMLDivElement>(null);\n    45→\n    46→  // Date editing\n    47→  const [editingDate, setEditingDate] = useState(false);\n    48→  const dateInputRef = useRef<HTMLInputElement>(null);\n    49→\n    50→  // Lead selector\n    51→  const [leadDropdownOpen, setLeadDropdownOpen] = useState(false);\n    52→  const [leadSearch, setLeadSearch] = useState('');\n    53→  const leadRef = useRef<HTMLDivElement>(null);\n    54→  const leadSearchRef = useRef<HTMLInputElement>(null);\n    55→\n    56→  // Sync name from props\n    57→  useEffect(() => {\n    58→    setNameValue(project.name);\n    59→  }, [project.name]);\n    60→\n    61→  // Focus name input\n    62→  useEffect(() => {\n    63→    if (editingName) {\n    64→      nameInputRef.current?.focus();\n    65→      nameInputRef.current?.select();\n    66→    }\n    67→  }, [editingName]);\n    68→\n    69→  // Focus lead search\n    70→  useEffect(() => {\n    71→    if (leadDropdownOpen) {\n    72→      leadSearchRef.current?.focus();\n    73→    }\n    74→  }, [leadDropdownOpen]);\n    75→\n    76→  // Close status dropdown on outside click\n    77→  useEffect(() => {\n    78→    function handleClickOutside(e: MouseEvent) {\n    79→      if (statusRef.current && !statusRef.current.contains(e.target as Node)) {\n    80→        setStatusDropdownOpen(false);\n    81→      }\n    82→    }\n    83→    if (statusDropdownOpen) {\n    84→      document.addEventListener('mousedown', handleClickOutside);\n    85→    }\n    86→    return () => document.removeEventListener('mousedown', handleClickOutside);\n    87→  }, [statusDropdownOpen]);\n    88→\n    89→  // Close lead dropdown on outside click\n    90→  useEffect(() => {\n    91→    function handleClickOutside(e: MouseEvent) {\n    92→      if (leadRef.current && !leadRef.current.contains(e.target as Node)) {\n    93→        setLeadDropdownOpen(false);\n    94→        setLeadSearch('');\n    95→      }\n    96→    }\n    97→    if (leadDropdownOpen) {\n    98→      document.addEventListener('mousedown', handleClickOutside);\n    99→    }\n   100→    return () => document.removeEventListener('mousedown', handleClickOutside);"}]},"parent_tool_use_id":"toolu_01EU2QPa8QJNsK7xhJLMtquJ","session_id":"ec926985-4614-4c34-906c-86ecc6695d62","uuid":"886d90a3-cfd0-4a41-b63b-529aeab753f2"}
