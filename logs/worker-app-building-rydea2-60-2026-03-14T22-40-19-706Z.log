 // Apply filters\n    41→  const filteredProjects = projects.filter((project) => {\n    42→    if (selectedStatuses.length > 0 && !selectedStatuses.includes(project.status)) {\n    43→      return false;\n    44→    }\n    45→    if (selectedLeads.length > 0 && (!project.leadId || !selectedLeads.includes(project.leadId))) {\n    46→      return false;\n    47→    }\n    48→    if (selectedTeams.length > 0) {\n    49→      const projectTeamIds = project.teams.map((t) => t.id);\n    50→      const hasMatchingTeam = selectedTeams.some((tid) => projectTeamIds.includes(tid));\n    51→      if (!hasMatchingTeam) return false;\n    52→    }\n    53→    return true;\n    54→  });\n    55→\n    56→  return (\n    57→    <div className=\"projects-page\" data-testid=\"projects-page\">\n    58→      <div className=\"projects-header\">\n    59→        <h1 className=\"projects-title\" data-testid=\"projects-title\">Projects</h1>\n    60→        <button\n    61→          className=\"projects-create-btn\"\n    62→          onClick={() => setCreateModalOpen(true)}\n    63→          data-testid=\"create-project-btn\"\n    64→        >\n    65→          <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n    66→            <line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\" />\n    67→            <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\" />\n    68→          </svg>\n    69→          Create Project\n    70→        </button>\n    71→      </div>\n    72→\n    73→      <ProjectFilters\n    74→        selectedStatuses={selectedStatuses}\n    75→        selectedLeads={selectedLeads}\n    76→        selectedTeams={selectedTeams}\n    77→        onStatusChange={setSelectedStatuses}\n    78→        onLeadChange={setSelectedLeads}\n    79→        onTeamChange={setSelectedTeams}\n    80→        members={members}\n    81→        teams={teams}\n    82→      />\n    83→\n    84→      {loading 