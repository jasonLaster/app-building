wn] = useState<DropdownType>(null);\n    53→  const [leadSearch, setLeadSearch] = useState('');\n    54→  const nameRef = useRef<HTMLInputElement>(null);\n    55→  const formRef = useRef<HTMLDivElement>(null);\n    56→\n    57→  // Reset form when modal opens\n    58→  useEffect(() => {\n    59→    if (open) {\n    60→      setFormData({\n    61→        name: '',\n    62→        description: '',\n    63→        status: 'planned',\n    64→        leadId: null,\n    65→        targetDate: null,\n    66→        teamIds: [],\n    67→      });\n    68→      setNameError(null);\n    69→      setSubmitting(false);\n    70→      setOpenDropdown(null);\n    71→      setLeadSearch('');\n    72→      setTimeout(() => nameRef.current?.focus(), 50);\n    73→    }\n    74→  }, [open]);\n    75→\n    76→  // Handle Escape key\n    77→  const handleClose = useCallback(() => {\n    78→    onClose();\n    79→  }, [onClose]);\n    80→\n    81→  useEffect(() => {\n    82→    if (!open) return;\n    83→    function handleKeyDown(e: KeyboardEvent) {\n    84→      if (e.key === 'Escape') {\n    85→        handleClose();\n    86→      }\n    87→    }\n    88→    document.addEventListener('keydown', handleKeyDown);\n    89→    return () => document.removeEventListener('keydown', handleKeyDown);\n    90→  }, [open, handleClose]);\n    91→\n    92→  // Close dropdown on outside click within form\n    93→  useEffect(() => {\n    94→    function handleClickOutside(e: MouseEvent) {\n    95→      if (formRef.current && !formRef.current.contains(e.target as Node)) {\n    96→        setOpenDropdown(null);\n    97→      }\n    98→    }\n    99→    if (openDropdown) {\n   100→      document.addEventListener('mousedown', handleClickOutside);\n   101→    }\n   102→    return () => document.removeEventListener('mousedown', handleClickOutside);\n   103→  }, [openDropdown]);\n   104→\n   105→  async function handleSubmit() {\n   106→    if (!formData.name.trim()) {\n   107→      setNameError('Name is required');\n   108→      return;\n   109→    }\n   110→    setNameError(null);\n   111→    setSubmitting(true);\n   112→    try {\n   113→      await onSubmit(formData);\n   114→    } catch {\n   115→      setSubmitting(false);\n   116→    }\n   117→  }\n   118→\n   119→  function handleOverlayClick(e: React.MouseEvent) {\n   120→    if (e.target === e.currentTarget) {\n   121→      handleClose();\n   122→    }\n   123→  }\n   124→\n   125→  function toggleDropdown(type: DropdownType) {\n   126→    setOpenDropdown(openDropdown === type ? null : type);\n   127→    if (type === 'lead') setLeadSearch('');\n   128→  }\n   129→\n   130→  function toggleTeam(teamId: string) {\n   131→    const current = formData.teamIds;\n   132→    if (current.includes(teamId)) {\n   133→      setFormData({ ...formData, teamIds: current.filter((id) => id !== teamId) });\n   134→    } else {\n   135→      setFormData({ ...formData, teamIds: [...current, teamId] });\n   136→    }\n   137→  }\n   138→\n   139→  const selectedLead = members.find((m) => m.id === formData.leadId);\n   140→  const selectedTeams = teams.filter((t) => formData.teamIds.includes(t.id));\n   141→  const statusConfig = PROJECT_STATUSES.find((s) => s.value === formData.status) || PROJECT_STATUSES[0]!;\n   142→\n   143→  const filteredMembers = members.filter((m) =>\n   144→    m.name.toLowerCase().includes(leadSearch.toLowerCase())\n   145→  );\n   146→\n   147→  if (!open) return null;\n   148→\n   149→  return (\n   150→    <div\n   151→      className=\"create-project-overlay\"\n   152→      onClick={handleOverlayClick}\n   153→      data-testid=\"create-project-modal-overlay\"\n   154→    >\n   155→      <div className=\"create-project-modal\" data-testid=\"create-project-modal\">\n   156→        <div className=\"cpm-header\">\n   157→          <h2 className=\"cpm-title\">Create Project</h2>\n   158→        </div>\n   159→\n   160→        <div className=\"cpm-body\" ref={formRef}>\n   161→          {/* Name */}\n   162→          <div className=\"cpm-field\" data-testid=\"create-project-name-field\">\n   163→            <label className=\"cpm-label\">Name</label>\n   164→            <input\n   165→              ref={nameRef}\n   166→              type=\"text\"\n   167→              className={`cpm-input ${nameError ? 'cpm-input-error' : ''}`}\n   168→              placeholder=\"Project name\"\n   169→              value={formData.name}\n   170→              onChange={(e) => setFormData({ ...formData, name: e.target.value })}\n   171→              data-testid=\"create-project-name-input\"\n   172→            />\n   173→            {nameError && (\n   174→              <span className=\"cpm-error\" data-testid=\"create-project-name-error\">{nameError}</span>\n   175→            )}\n   176→          </div>\n   177→\n   178→          {/* Description */}\n   179→          <div className=\"cpm-field\" data-testid=\"create-project-description-field\">\n   180→            <label className=\"cpm-label\">Description</label>\n   181→            <textarea\n   182→              className=\"cpm-textarea\"\n   183→              placeholder=\"Project description...\"\n   184→              value={formData.description}\n   185→              onChange={(e) => setFormData({ ...formData, description: e.target.value })}\n   186→              rows={3}\n   187→              data-testid=\"create-project-description-input\"\n   188→            />\n   189→          </div>\n   190→\n   191→          {/* Status */}\n   192→          <div className=\"cpm-field\" data-testid=\"create-project-status-field\">\n   193→            <label className=\"cpm-label\">Status</label>\n   194→            <div className=\"cpm-dropdown-wrapper\">\n   195→              <button\n   196→                className=\"cpm-select-btn\"\n   197→                onClick={() => toggleDropdown('status')}\n   198→                data-testid=\"create-project-status-selector\"\n   199→              >\n   200→                <span>{statusConfig.label}</span>\n   201→                <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n   202→              </button>\n   203→              {openDropdown === 'status' && (\n   204→                <div className=\"cpm-dropdown\" data-testid=\"create-project-status-dropdown\">\n   205→                  {PROJECT_STATUSES.map((s) => (\n   206→                    <button\n   207→                      key={s.value}\n   208→                      className={`cpm-dropdown-option ${formData.status === s.value ? 'cpm-dropdown-option-active' : ''}`}\n   209→                      onClick={() => { setFormData({ ...formData, status: s.value }); setOpenDropdown(null); }}\n   210→                      data-testid={`create-project-status-option-${s.value}`}\n   211→                    >\n   212→                      <span>{s.label}</span>\n   213→                    </button>\n   214→                  ))}\n   215→                </div>\n   216→              )}\n   217→            </div>\n   218→          </div>\n   219→\n   220→          {/* Lead */}\n   221→          <div className=\"cpm-field\" data-testid=\"create-project-lead-field\">\n   222→            <label className=\"cpm-label\">Lead</label>\n   223→            <div className=\"cpm-dropdown-wrapper\">\n   224→              <button\n   225→                className=\"cpm-select-btn\"\n   226→                onClick={() => toggleDropdown('lead')}\n   227→                data-testid=\"create-project-lead-selector\"\n   228→              >\n   229→                {selectedLead ? (\n   230→                  <>\n   231→                    <span className=\"cpm-avatar\">{getInitials(selectedLead.name)}</span>\n   232→                    <span>{selectedLead.name}</span>\n   233→                  </>\n   234→                ) : (\n   235→                  <span className=\"cpm-placeholder\">No lead</span>\n   236→                )}\n   237→                <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n   238→              </button>\n   239→              {openDropdown === 'lead' && (\n   240→                <div className=\"cpm-dropdown cpm-dropdown-searchable\" data-testid=\"create-project-lead-dropdown\">\n   241→                  <input\n   242→                    className=\"cpm-search-input\"\n   243→                    placeholder=\"Search members...\"\n   244→                    value={leadSearch}\n   245→                    onChange={(e) => setLeadSearch(e.target.value)}\n   246→                    autoFocus\n   247→                    data-testid=\"create-project-lead-search\"\n   248→                  />\n   249→                  <button\n   250→                    className=\"cpm-dropdown-option\"\n   251→                    onClick={() => { setFormData({ ...formData, leadId: null }); setOpenDropdown(null); }}\n   252→                    data-testid=\"create-project-lead-option-none\"\n   253→                  >\n   254→                    <span className=\"cpm-avatar cpm-avatar-empty\">?</span>\n   255→                    <span>No lead</span>\n   256→                  </button>\n   257→                  {filteredMembers.map((m) => (\n   258→                    <button\n   259→                      key={m.id}\n   260→                      className={`cpm-dropdown-option ${formData.leadId === m.id ? 'cpm-dropdown-option-active' : ''}`}\n   261→                      onClick={() => { setFormData({ ...formData, leadId: m.id }); setOpenDropdown(null); }}\n   262→                      data-testid={`create-project-lead-option-${m.id}`}\n   263→                    >\n   264→                      <span className=\"cpm-avatar\">{getInitials(m.name)}</span>\n   265→                      <span>{m.name}</span>\n   266→                    </button>\n   267→                  ))}\n   268→                </div>\n   269→              )}\n   270→            </div>\n   271→          </div>\n   272→\n   273→          {/* Target Date */}\n   274→          <div className=\"cpm-field\" data-testid=\"create-project-target-date-field\">\n   275→            <label className=\"cpm-label\">Target date</label>\n   276→            <input\n   277→              type=\"date\"\n   278→              className=\"cpm-date-input\"\n   279→              value={formData.targetDate || ''}\n   280→              onChange={(e) => setFormData({ ...formData, targetDate: e.target.value || null })}\n   281→              data-testid=\"create-project-target-date-input\"\n   282→            />\n   283→          </div>\n   284→\n   285→          {/* Teams */}\n   286→          <div className=\"cpm-field\" data-testid=\"create-project-teams-field\">\n   287→            <label className=\"cpm-label\">Teams</label>\n   288→            {selectedTeams.length > 0 && (\n   289→              <div className=\"cpm-selected-teams\" data-testid=\"create-project-selected-teams\">\n   290→                {selectedTeams.map((t) => (\n   291→                  <span key={t.id} className=\"cpm-team-chip\" data-testid={`create-project-team-chip-${t.id}`}>\n   292→                    {t.name}\n   293→                    <button\n   294→                      className=\"cpm-team-chip-remove\"\n   295→                      onClick={() => toggleTeam(t.id)}\n   296→                      data-testid={`create-project-team-remove-${t.id}`}\n   297→                    >\n   298→                      &times;\n   299→                    </button>\n   300→                  </span>\n   301→                ))}\n   302→              </div>\n   303→            )}\n   304→            <div className=\"cpm-dropdown-wrapper\">\n   305→              <button\n   306→                className=\"cpm-select-btn\"\n   307→                onClick={() => toggleDropdown('teams')}\n   308→                data-testid=\"create-project-teams-selector\"\n   309→              >\n   310→                <span className=\"cpm-placeholder\">\n   311→                  {selectedTeams.length === 0 ? 'Select teams' : 'Add more teams'}\n   312→                </span>\n   313→                <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n   314→              </button>\n   315→              {openDropdown === 'teams' && (\n   316→                <div className=\"cpm-dropdown\" data-testid=\"create-project-teams-dropdown\">\n   317→                  {teams.map((t) => {\n   318→                    const checked = formData.teamIds.includes(t.id);\n   319→                    return (\n   320→                      <button\n   321→                        key={t.id}\n   322→                        className={`cpm-dropdown-option ${checked ? 'cpm-dropdown-option-active' : ''}`}\n   323→                        onClick={() => toggleTeam(t.id)}\n   324→                        data-testid={`create-project-team-option-${t.id}`}\n   325→                      >\n   326→                        <span>{t.name}</span>\n   327→                        {checked && (\n   328→                          <svg className=\"cpm-check\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"20 6 9 17 4 12\" /></svg>\n   329→                        )}\n   330→                      </button>\n   331→                    );\n   332→                  })}\n   333→                  {teams.length === 0 && (\n   334→                    <div className=\"cpm-dropdown-empty\">No teams available</div>\n   335→                  )}\n   336→                </div>\n   337→              )}\n   338→            </div>\n   339→          </div>\n   340→        </div>\n   341→\n   342→        <div className=\"cpm-footer\">\n   343→          <button\n   344→            className=\"cpm-cancel-btn\"\n   345→            onClick={handleClose}\n   346→            data-testid=\"create-project-cancel-btn\"\n   347→          >\n   348→            Cancel\n   349→          </button>\n   350→          <button\n   351→            className=\"cpm-submit-btn\"\n   352→            onClick={handleSubmit}\n   353→            disabled={submitting}\n   354→            data-testid=\"create-project-submit-btn\"\n   355→          >\n   356→            {submitting ? 'Creating...' : 'Create Project'}\n   357→          </button>\n   358→        </div>\n   359→      </div>\n   360→    </div>\n   361→  );\n   362→}\n   363→"}]},"parent_tool_use_id":"toolu_01EU2QPa8QJNsK7xhJLMtquJ","session_id":"ec926985-4614-4c34-906c-86ecc6695d62","uuid":"aa2729fa-4e6c-46e1-96d4-68360a0543f3"}
