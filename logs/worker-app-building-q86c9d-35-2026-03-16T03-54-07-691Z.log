w-page\">\n    44→        <div className=\"text-center py-12\">\n    45→          <p data-testid=\"review-page-error\" className=\"text-error text-lg font-medium mb-4\">{error}</p>\n    46→          <Link\n    47→            to=\"/trips\"\n    48→            className=\"text-primary hover:text-primary-dark font-semibold underline\"\n    49→          >\n    50→            Back to My Trips\n    51→          </Link>\n    52→        </div>\n    53→      </div>\n    54→    )\n    55→  }\n    56→\n    57→  if (submitSuccess) {\n    58→    return (\n    59→      <div className=\"max-w-[1120px] mx-auto px-6 max-sm:px-3 py-8\" data-testid=\"write-review-page\">\n    60→        <div className=\"text-center py-12\">\n    61→          <p data-testid=\"review-success-message\" className=\"text-success text-lg font-semibold mb-4\">\n    62→            Review submitted successfully\n    63→          </p>\n    64→          <Link\n    65→            to=\"/trips\"\n    66→            className=\"text-primary hover:text-primary-dark font-semibold underline\"\n    67→          >\n    68→            Back to My Trips\n    69→          </Link>\n    70→        </div>\n    71→      </div>\n    72→    )\n    73→  }\n    74→\n    75→  if (!booking) {\n    76→    return (\n    77→      <div className=\"max-w-[1120px] mx-auto px-6 max-sm:px-3 py-8\" data-testid=\"write-review-page\">\n    78→        <div className=\"text-center py-12 text-text-secondary\">Booking not found</div>\n    79→      </div>\n    80→    )\n    81→  }\n    82→\n    83→  return (\n    84→    <div className=\"max-w-2xl mx-auto px-6 max-sm:px-3 py-8\" data-testid=\"write-review-page\">\n    85→      <h1 className=\"text-[26px] font-semibold text-text mb-6\">Write a Review</h1>\n    86→      <div className=\"mb-8 rounded-xl border border-border p-5\">\n    87→        <PropertyBookingContext booking={booking} />\n    88→      </div>\n    89→      <ReviewForm booking={booking} />\n    90→    </div>\n    91→  )\n    92→}\n    93→"}]},"parent_tool_use_id":null,"session_id":"8c3e5c21-8ad2-4f26-b5fe-46a801da86a8","uuid":"858b3e15-8adb-433d-9142-ec1279d574a0","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/pages/WriteReview.tsx","content":"import { useEffect } from 'react'\nimport { useParams, useNavigate, Link } from 'react-router-dom'\nimport { useSelector, useDispatch } from 'react-redux'\nimport type { RootState, AppDispatch } from '../store'\nimport { fetchBookingForReview, resetReviewForm } from '../slices/reviewFormSlice'\nimport PropertyBookingContext from '../components/PropertyBookingContext'\nimport ReviewForm from '../components/ReviewForm'\n\nexport default function WriteReview() {\n  const { bookingId } = useParams<{ bookingId: string }>()\n  const dispatch = useDispatch<AppDispatch>()\n  const navigate = useNavigate()\n  const { currentUser } = useSelector((state: RootState) => state.auth)\n  const { booking, loading, error, submitSuccess } = useSelector((state: RootState) => state.reviewForm)\n\n  useEffect(() => {\n    if (!currentUser) {\n      navigate('/login')\n      return\n    }\n    if (bookingId) {\n      dispatch(fetchBookingForReview({ bookingId, guestId: currentUser.id }))\n    }\n    return () => {\n      dispatch(resetReviewForm())\n    }\n  }, [currentUser, bookingId, dispatch, navigate])\n\n  if (!currentUser) {\n    return null\n  }\n\n  if (loading) {\n    return (\n      <div className=\"max-w-[1120px] mx-auto px-6 max-sm:px-3 py-8\" data-testid=\"write-review-page\">\n        <div className=\"text-center py-12 text-text-secondary\">Loading booking details...</div>\n      </div>\n    )\n  }\n\n  if (error) {\n    return (\n      <div className=\"max-w-[1120px] mx-auto px-6 max-sm:px-3 py-8\" data-testid=\"write-review-page\">\n        <div className=\"text-center py-12\">\n          <p data-testid=\"review-page-error\" className=\"text-error text-lg font-medium mb-4\">{error}</p>\n          <Link\n            to=\"/trips\"\n            className=\"text-primary hover:text-primary-dark font-semibold underline\"\n          >\n            Back to My Trips\n          </Link>\n        </div>\n      </div>\n    )\n  }\n\n  if (submitSuccess) {\n    return (\n      <div className=\"max-w-[1120px] mx-auto px-6 max-sm:px-3 py-8\" data-testid=\"write-review-page\">\n        <div className=\"text-center py-12\">\n          <p data-testid=\"review-success-message\" className=\"text-success text-lg font-semibold mb-4\">\n            Review submitted successfully\n          </p>\n          <Link\n            to=\"/trips\"\n            className=\"text-primary hover:text-primary-dark font-semibold underline\"\n          >\n            Back to My Trips\n          </Link>\n        </div>\n      </div>\n    )\n  }\n\n  if (!booking) {\n    return (\n      <div className=\"max-w-[1120px] mx-auto px-6 max-sm:px-3 py-8\" data-testid=\"write-review-page\">\n        <div className=\"text-center py-12 text-text-secondary\">Booking not found</div>\n      </div>\n    )\n  }\n\n  return (\n    <div className=\"max-w-2xl mx-auto px-6 max-sm:px-3 py-8\" data-testid=\"write-review-page\">\n      <h1 className=\"text-[26px] font-semibold text-text mb-6\">Write a Review</h1>\n      <div className=\"mb-8 rounded-xl border border-border p-5\">\n        <PropertyBookingContext booking={booking} />\n      </div>\n      <ReviewForm booking={booking} />\n    </div>\n  )\n}\n","numLines":93,"startLine":1,"totalLines":93}}}
