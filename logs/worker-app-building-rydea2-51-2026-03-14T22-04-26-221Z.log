] = useState(false);\n    44→\n    45→  async function handleSubmitComment() {\n    46→    if (!commentText.trim() || submitting) return;\n    47→    setSubmitting(true);\n    48→    await dispatch(addComment({ issueId, content: commentText.trim() }));\n    49→    setCommentText('');\n    50→    setSubmitting(false);\n    51→  }\n    52→\n    53→  function handleCommentKeyDown(e: React.KeyboardEvent) {\n    54→    if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) {\n    55→      e.preventDefault();\n    56→      handleSubmitComment();\n    57→    }\n    58→  }\n    59→\n    60→  return (\n    61→    <div className=\"activity-comments\" data-testid=\"activity-comments\">\n    62→      <div className=\"activity-comments-tabs\" data-testid=\"activity-comments-tabs\">\n    63→        <button\n    64→          className={`activity-comments-tab ${activeTab === 'activity' ? 'activity-comments-tab-active' : ''}`}\n    65→          onClick={() => setActiveTab('activity')}\n    66→          data-testid=\"activity-tab\"\n    67→        >\n    68→          Activity\n    69→        </button>\n    70→        <button\n    71→          className={`activity-comments-tab ${activeTab === 'comments' ? 'activity-comments-tab-active' : ''}`}\n    72→          onClick={() => setActiveTab('comments')}\n    73→          data-testid=\"comments-tab\"\n    74→        >\n    75→          Comments\n    76→        </button>\n    77→      </div>\n    78→\n    79→      <div className=\"activity-comments-content\" data-testid=\"activity-comments-content\">\n    80→        {activeTab === 'activity' ? (\n    81→          <div className=\"activity-list\" data-testid=\"activity-list\">\n    82→            {activity.length === 0 ? (\n    83→              <div className=\"activity-empty\" data-testid=\"activity-empty\">No activity yet</div>\n    84→            ) : (\n    85→              activity.map((entry) => (\n    86→                <div key={entry.id} className=\"activity-entry\" data-testid={`activity-entry-${entry.id}`}>\n    87→                  <div className=\"activity-avatar\">\n    88→                    {entry.memberName ? getInitials(entry.memberName) : '?'}\n    89→                  </div>\n    90→                  <div className=\"activity-info\">\n    91→                    <span className=\"activity-actor\">{entry.memberName || 'Unknown'}</span>\n    92→                    <span className=\"activity-action\">{entry.action}</span>\n    93→                    <span className=\"activity-time\">{formatRelativeTime(entry.createdAt)}</span>\n    94→                  </div>\n    95→                </div>\n    96→              ))\n    97→            )}\n    98→          </div>\n    99→        ) : (\n   100→          <div className=\"comments-list\" data-testid=\"comments-list\">\n   101→            {comments.length === 0 ? (\n   102→              <div className=\"comments-empty\" data-testid=\"comments-empty\">No comments yet</div>\n   103→            ) : (\n   104→              comments.map((comment) => (\n   105→                <div key={comment.id} className=\"comment-entry\" data-testid={`comment-entry-${comment.id}`}>\n   106→                  <div className=\"comment-avatar\">\n   107→                    {comment.memberName ? getInitials(comment.memberName) : '?'}\n   108→                  </div>\n   109→                  <div className=\"comment-body\">\n   110→                    <div className=\"comment-header\">\n   111→                      <span className=\"comment-author\">{comment.memberName || 'Unknown'}</span>\n   112→                      <span className=\"comment-time\">{formatRelativeTime(comment.createdAt)}</span>\n   113→                    </div>\n   114→                    <div className=\"comment-content\" data-testid={`comment-content-${comment.id}`}>\n   115→                      {comment.content}\n   116→                    </div>\n   117→                  </div>\n   118→                </div>\n   119→              ))\n   120→            )}\n   121→          </div>\n   122→        )}\n   123→      </div>\n   124→\n   125→      <div className=\"activity-comments-input\" data-testid=\"comment-input-section\">\n   126→        <textarea\n   127→          className=\"comment-textarea\"\n   128→          placeholder=\"Write a comment...\"\n   129→          value={commentText}\n   130→          onChange={(e) => setCommentText(e.target.value)}\n   131→          onKeyDown={handleCommentKeyDown}\n   132→          rows={2}\n   133→          data-testid=\"comment-input\"\n   134→        />\n   135→        <button\n   136→          className=\"comment-submit-btn\"\n   137→          onClick={handleSubmitComment}\n   138→          disabled={!commentText.trim() || submitting}\n   139→          data-testid=\"comment-submit-btn\"\n   140→        >\n   141→          Comment\n   142→        </button>\n   143→      </div>\n   144→    </div>\n   145→  );\n   146→}\n   147→"}]},"parent_tool_use_id":null,"session_id":"7b3a342c-e5c0-4c3a-aec1-6eee419ae688","uuid":"3b50b9f9-3836-42f3-8e1d-875fc1802701","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/src/components/ActivityComments.tsx","content":"import { useState } from 'react';\nimport { useDispatch } from 'react-redux';\nimport type { AppDispatch } from '../store';\nimport type { ActivityEntry, Comment } from '../slices/issueDetailSlice';\nimport { addComment } from '../slices/issueDetailSlice';\nimport './ActivityComments.css';\n\ninterface ActivityCommentsProps {\n  issueId: string;\n  activity: ActivityEntry[];\n  comments: Comment[];\n}\n\nfunction getInitials(name: string): string {\n  return name\n    .split(' ')\n    .map((n) => n[0])\n    .join('')\n    .toUpperCase()\n    .slice(0, 2);\n}\n\nfunction formatRelativeTime(dateStr: string): string {\n  const date = new Date(dateStr);\n  const now = new Date();\n  const diffMs = now.getTime() - date.getTime();\n  const diffSecs = Math.floor(diffMs / 1000);\n  const diffMins = Math.floor(diffSecs / 60);\n  const diffHours = Math.floor(diffMins / 60);\n  const diffDays = Math.floor(diffHours / 24);\n\n  if (diffSecs < 60) return 'just now';\n  if (diffMins < 60) return `${diffMins}m ago`;\n  if (diffHours < 24) return `${diffHours}h ago`;\n  if (diffDays < 30) return `${diffDays}d ago`;\n  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });\n}\n\nexport default function ActivityComments({ issueId, activity, comments }: ActivityCommentsProps) {\n  const dispatch = useDispatch<AppDispatch>();\n  const [activeTab, setActiveTab] = useState<'activity' | 'comments'>('activity');\n  const [commentText, setCommentText] = useState('');\n  const [submitting, setSubmitting] = useState(false);\n\n  async function handleSubmitComment() {\n    if (!commentText.trim() || submitting) return;\n    setSubmitting(true);\n    await dispatch(addComment({ issueId, content: commentText.trim() }));\n    setCommentText('');\n    setSubmitting(false);\n  }\n\n  function handleCommentKeyDown(e: React.KeyboardEvent) {\n    if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) {\n      e.preventDefault();\n      handleSubmitComment();\n    }\n  }\n\n  return (\n    <div className=\"activity-comments\" data-testid=\"activity-comments\">\n      <div className=\"activity-comments-tabs\" data-testid=\"activity-comments-tabs\">\n        <button\n          className={`activity-comments-tab ${activeTab === 'activity' ? 'activity-comments-tab-active' : ''}`}\n          onClick={() => setActiveTab('activity')}\n          data-testid=\"activity-tab\"\n        >\n          Activity\n        </button>\n        <button\n          className={`activity-comments-tab ${activeTab === 'comments' ? 'activity-comments-tab-active' : ''}`}\n          onClick={() => setActiveTab('comments')}\n          data-testid=\"comments-tab\"\n        >\n          Comments\n        </button>\n      </div>\n\n      <div className=\"activity-comments-content\" data-testid=\"activity-comments-content\">\n        {activeTab === 'activity' ? (\n          <div className=\"activity-list\" data-testid=\"activity-list\">\n            {activity.length === 0 ? (\n              <div className=\"activity-empty\" data-testid=\"activity-empty\">No activity yet</div>\n            ) : (\n              activity.map((entry) => (\n                <div key={entry.id} className=\"activity-entry\" data-testid={`activity-entry-${entry.id}`}>\n                  <div className=\"activity-avatar\">\n                    {entry.memberName ? getInitials(entry.memberName) : '?'}\n                  </div>\n                  <div className=\"activity-info\">\n                    <span className=\"activity-actor\">{entry.memberName || 'Unknown'}</span>\n                    <span className=\"activity-action\">{entry.action}</span>\n                    <span className=\"activity-time\">{formatRelativeTime(entry.createdAt)}</span>\n                  </div>\n                </div>\n              ))\n            )}\n          </div>\n        ) : (\n          <div className=\"comments-list\" data-testid=\"comments-list\">\n            {comments.length === 0 ? (\n              <div className=\"comments-empty\" data-testid=\"comments-empty\">No comments yet</div>\n            ) : (\n              comments.map((comment) => (\n                <div key={comment.id} className=\"comment-entry\" data-testid={`comment-entry-${comment.id}`}>\n                  <div className=\"comment-avatar\">\n                    {comment.memberName ? getInitials(comment.memberName) : '?'}\n                  </div>\n                  <div className=\"comment-body\">\n                    <div className=\"comment-header\">\n                      <span className=\"comment-author\">{comment.memberName || 'Unknown'}</span>\n                      <span className=\"comment-time\">{formatRelativeTime(comment.createdAt)}</span>\n                    </div>\n                    <div className=\"comment-content\" data-testid={`comment-content-${comment.id}`}>\n                      {comment.content}\n                    </div>\n                  </div>\n                </div>\n              ))\n            )}\n          </div>\n        )}\n      </div>\n\n      <div className=\"activity-comments-input\" data-testid=\"comment-input-section\">\n        <textarea\n          className=\"comment-textarea\"\n          placeholder=\"Write a comment...\"\n          value={commentText}\n          onChange={(e) => setCommentText(e.target.value)}\n          onKeyDown={handleCommentKeyDown}\n          rows={2}\n          data-testid=\"comment-input\"\n        />\n        <button\n          className=\"comment-submit-btn\"\n          onClick={handleSubmitComment}\n          disabled={!commentText.trim() || submitting}\n          data-testid=\"comment-submit-btn\"\n        >\n          Comment\n        </button>\n      </div>\n    </div>\n  );\n}\n","numLines":147,"startLine":1,"totalLines":147}}}
