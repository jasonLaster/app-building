    EXCEPTION WHEN duplicate_object THEN NULL;\n    54→    END $$\n    55→  `;\n    56→\n    57→  // Team members\n    58→  await sql`\n    59→    CREATE TABLE IF NOT EXISTS team_members (\n    60→      team_id UUID NOT NULL REFERENCES teams(id) ON DELETE CASCADE,\n    61→      member_id UUID NOT NULL REFERENCES members(id) ON DELETE CASCADE,\n    62→      PRIMARY KEY (team_id, member_id)\n    63→    )\n    64→  `;\n    65→\n    66→  // Labels\n    67→  await sql`\n    68→    CREATE TABLE IF NOT EXISTS labels (\n    69→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    70→      name TEXT NOT NULL UNIQUE,\n    71→      color TEXT NOT NULL\n    72→    )\n    73→  `;\n    74→\n    75→  // Projects\n    76→  await sql`\n    77→    CREATE TABLE IF NOT EXISTS projects (\n    78→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    79→      name TEXT NOT NULL,\n    80→      description TEXT,\n    81→      status TEXT NOT NULL DEFAULT 'planned',\n    82→      target_date DATE,\n    83→      lead_id UUID REFERENCES members(id) ON DELETE SET NULL,\n    84→      created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()\n    85→    )\n    86→  `;\n    87→\n    88→  // Cycles\n    89→  await sql`\n    90→    CREATE TABLE IF NOT EXISTS cycles (\n    91→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    92→      name TEXT NOT NULL,\n    93→      start_date DATE NOT NULL,\n    94→      end_date DATE NOT NULL,\n    95→      team_id UUID NOT NULL REFERENCES teams(id) ON DELETE CASCADE,\n    96→      status TEXT DEFAULT 'active'\n    97→    )\n    98→  `;\n    99→\n   100→  // Issues\n   101→  await sql`\n   102→    CREATE TABLE IF NOT EXISTS issues (\n   103→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n   104→      team_id UUID NOT NULL REFERENCES teams(id) ON DELETE CASCADE,\n   105→      title TEXT NOT NULL,\n   106→      description TEXT,\n   107→      status TEXT NOT NULL DEFAULT 'backlog',\n   108→      priority TEXT NOT NULL DEFAULT 'none',\n   109→      numb