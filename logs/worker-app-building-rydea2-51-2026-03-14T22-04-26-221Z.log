se,\n    71→  error: null,\n    72→};\n    73→\n    74→export const fetchIssueDetail = createAsyncThunk(\n    75→  'issueDetail/fetchIssueDetail',\n    76→  async (issueId: string, { getState, rejectWithValue }) => {\n    77→    const state = getState() as { auth: { token: string | null } };\n    78→    const token = state.auth.token;\n    79→    if (!token) return rejectWithValue('No token');\n    80→    const response = await fetch(`/api/issue-detail?issueId=${issueId}`, {\n    81→      headers: { Authorization: `Bearer ${token}` },\n    82→    });\n    83→    if (!response.ok) {\n    84→      return rejectWithValue('Failed to fetch issue');\n    85→    }\n    86→    return await response.json();\n    87→  }\n    88→);\n    89→\n    90→export const updateIssueField = createAsyncThunk(\n    91→  'issueDetail/updateIssueField',\n    92→  async (\n    93→    payload: { issueId: string; field: string; value: string | null; labelIds?: string[] },\n    94→    { getState, rejectWithValue }\n    95→  ) => {\n    96→    const state = getState() as { auth: { token: string | null } };\n    97→    const token = state.auth.token;\n    98→    if (!token) return rejectWithValue('No token');\n    99→    const response = await fetch('/api/update-issue', {\n   100→      method: 'PUT',\n   101→      headers: {\n   102→        'Content-Type': 'application/json',\n   103→        Authorization: `Bearer ${token}`,\n   104→      },\n   105→      body: JSON.stringify(payload),\n   106→    });\n   107→    if (!response.ok) {\n   108→      return rejectWithValue('Failed to update issue');\n   109→    }\n   110→    return await response.json() as { issue: Issue; activity: ActivityEntry | null };\n   111→  }\n   112→);\n   113→\n   114→export const addComment = createAsyncThunk(\n   115→  'issueDetail/addComment',\n   116→  async (\n   117→    payload: { issueId: string; content: string },\n   118→    { getState, rejectWithValue }\n   119→  ) => {\n   120→    const state = getState() as { auth: { token: string | null } };\n   121→    const token = state.auth.token;\n   122→    if (!token) return rejectWithValue('No token');\n   123→    const response = await fetch('/api/add-comment', {\n   124→      method: 'POST',\n   125→      headers: {\n   126→        'Content-Type': 'application/json',\n   127→        Authorization: `Bearer ${token}`,\n   128→      },\n   129→      body: JSON.stringify(payload),\n   130→    });\n   131→    if (!response.ok) {\n   132→      return rejectWithValue('Failed to add comment');\n   133→    }\n   134→    return await response.json() as { comment: Comment };\n   135→  }\n   136→);\n   137→\n   138→const issueDetailSlice = createSlice({\n   139→  name: 'issueDetail',\n   140→  initialState,\n   141→  reducers: {\n   142→    clearIssueDetail(state) {\n   143→      state.issue = null;\n   144→      state.subIssues = [];\n   145→      state.activity = [];\n   146→      state.comments = [];\n   147→      state.members = [];\n   148→      state.projects = [];\n   149→      state.cycles = [];\n   150→      state.allLabels = [];\n   151→      state.loading = false;\n   152→      state.error = null;\n   153→    },\n   154→  },\n   155→  extraReducers: (builder) => {\n   156→    builder\n   157→      .addCase(fetchIssueDetail.pending, (state) => {\n   158→        if (!state.issue) {\n   159→          state.loading = true;\n   160→        }\n   161→        state.error = null;\n   162→      })\n   163→      .addCase(fetchIssueDetail.fulfilled, (state, action) => {\n   164→        state.loading = false;\n   165→        state.issue = action.payload.issue;\n   166→        state.subIssues = action.payload.subIssues;\n   167→        state.activity = action.payload.activity;\n   168→        state.comments = action.payload.comments;\n   169→        state.members = action.payload.members;\n   170→        state.projects = action.payload.projects;\n   171→        state.cycles = action.payload.cycles;\n   172→        state.allLabels = action.payload.allLabels;\n   173→      })\n   174→      .addCase(fetchIssueDetail.rejected, (state, action) => {\n   175→        state.loading = false;\n   176→        state.error = action.payload as string;\n   177→      })\n   178→      .addCase(updateIssueField.fulfilled, (state, action) => {\n   179→        state.issue = action.payload.issue;\n   180→        if (action.payload.activity) {\n   181→          state.activity.push(action.payload.activity);\n   182→        }\n   183→      })\n   184→      .addCase(addComment.fulfilled, (state, action) => {\n   185→        state.comments.push(action.payload.comment);\n   186→      });\n   187→  },\n   188→});\n   189→\n   190→export const { clearIssueDetail } = issueDetailSlice.actions;\n   191→export default issueDetailSlice.reducer;\n   192→"}]},"parent_tool_use_id":null,"session_id":"7b3a342c-e5c0-4c3a-aec1-6eee419ae688","uuid":"01dec51c-5425-4ac2-a0b5-d736986fd7c7","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/src/slices/issueDetailSlice.ts","content":"import { createSlice, createAsyncThunk } from '@reduxjs/toolkit';\nimport type { Issue, IssueLabel } from './issuesSlice';\n\nexport interface SubIssue {\n  id: string;\n  title: string;\n  status: string;\n  priority: string;\n  identifier: string;\n}\n\nexport interface ActivityEntry {\n  id: string;\n  action: string;\n  createdAt: string;\n  memberId: string;\n  memberName: string | null;\n  memberEmail: string | null;\n}\n\nexport interface Comment {\n  id: string;\n  content: string;\n  createdAt: string;\n  memberId: string;\n  memberName: string | null;\n  memberEmail: string | null;\n}\n\nexport interface TeamMember {\n  id: string;\n  name: string;\n  email: string;\n}\n\nexport interface TeamProject {\n  id: string;\n  name: string;\n}\n\nexport interface TeamCycle {\n  id: string;\n  name: string;\n  start_date: string;\n  end_date: string;\n}\n\ninterface IssueDetailState {\n  issue: Issue | null;\n  subIssues: SubIssue[];\n  activity: ActivityEntry[];\n  comments: Comment[];\n  members: TeamMember[];\n  projects: TeamProject[];\n  cycles: TeamCycle[];\n  allLabels: IssueLabel[];\n  loading: boolean;\n  error: string | null;\n}\n\nconst initialState: IssueDetailState = {\n  issue: null,\n  subIssues: [],\n  activity: [],\n  comments: [],\n  members: [],\n  projects: [],\n  cycles: [],\n  allLabels: [],\n  loading: false,\n  error: null,\n};\n\nexport const fetchIssueDetail = createAsyncThunk(\n  'issueDetail/fetchIssueDetail',\n  async (issueId: string, { getState, rejectWithValue }) => {\n    const state = getState() as { auth: { token: string | null } };\n    const token = state.auth.token;\n    if (!token) return rejectWithValue('No token');\n    const response = await fetch(`/api/issue-detail?issueId=${issueId}`, {\n      headers: { Authorization: `Bearer ${token}` },\n    });\n    if (!response.ok) {\n      return rejectWithValue('Failed to fetch issue');\n    }\n    return await response.json();\n  }\n);\n\nexport const updateIssueField = createAsyncThunk(\n  'issueDetail/updateIssueField',\n  async (\n    payload: { issueId: string; field: string; value: string | null; labelIds?: string[] },\n    { getState, rejectWithValue }\n  ) => {\n    const state = getState() as { auth: { token: string | null } };\n    const token = state.auth.token;\n    if (!token) return rejectWithValue('No token');\n    const response = await fetch('/api/update-issue', {\n      method: 'PUT',\n      headers: {\n        'Content-Type': 'application/json',\n        Authorization: `Bearer ${token}`,\n      },\n      body: JSON.stringify(payload),\n    });\n    if (!response.ok) {\n      return rejectWithValue('Failed to update issue');\n    }\n    return await response.json() as { issue: Issue; activity: ActivityEntry | null };\n  }\n);\n\nexport const addComment = createAsyncThunk(\n  'issueDetail/addComment',\n  async (\n    payload: { issueId: string; content: string },\n    { getState, rejectWithValue }\n  ) => {\n    const state = getState() as { auth: { token: string | null } };\n    const token = state.auth.token;\n    if (!token) return rejectWithValue('No token');\n    const response = await fetch('/api/add-comment', {\n      method: 'POST',\n      headers: {\n        'Content-Type': 'application/json',\n        Authorization: `Bearer ${token}`,\n      },\n      body: JSON.stringify(payload),\n    });\n    if (!response.ok) {\n      return rejectWithValue('Failed to add comment');\n    }\n    return await response.json() as { comment: Comment };\n  }\n);\n\nconst issueDetailSlice = createSlice({\n  name: 'issueDetail',\n  initialState,\n  reducers: {\n    clearIssueDetail(state) {\n      state.issue = null;\n      state.subIssues = [];\n      state.activity = [];\n      state.comments = [];\n      state.members = [];\n      state.projects = [];\n      state.cycles = [];\n      state.allLabels = [];\n      state.loading = false;\n      state.error = null;\n    },\n  },\n  extraReducers: (builder) => {\n    builder\n      .addCase(fetchIssueDetail.pending, (state) => {\n        if (!state.issue) {\n          state.loading = true;\n        }\n        state.error = null;\n      })\n      .addCase(fetchIssueDetail.fulfilled, (state, action) => {\n        state.loading = false;\n        state.issue = action.payload.issue;\n        state.subIssues = action.payload.subIssues;\n        state.activity = action.payload.activity;\n        state.comments = action.payload.comments;\n        state.members = action.payload.members;\n        state.projects = action.payload.projects;\n        state.cycles = action.payload.cycles;\n        state.allLabels = action.payload.allLabels;\n      })\n      .addCase(fetchIssueDetail.rejected, (state, action) => {\n        state.loading = false;\n        state.error = action.payload as string;\n      })\n      .addCase(updateIssueField.fulfilled, (state, action) => {\n        state.issue = action.payload.issue;\n        if (action.payload.activity) {\n          state.activity.push(action.payload.activity);\n        }\n      })\n      .addCase(addComment.fulfilled, (state, action) => {\n        state.comments.push(action.payload.comment);\n      });\n  },\n});\n\nexport const { clearIssueDetail } = issueDetailSlice.actions;\nexport default issueDetailSlice.reducer;\n","numLines":192,"startLine":1,"totalLines":192}}}
