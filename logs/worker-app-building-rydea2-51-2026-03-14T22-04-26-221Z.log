REFERENCES members(id) ON DELETE CASCADE,\n   158→      type TEXT NOT NULL,\n   159→      message TEXT NOT NULL,\n   160→      issue_id UUID REFERENCES issues(id) ON DELETE CASCADE,\n   161→      read BOOLEAN NOT NULL DEFAULT false,\n   162→      archived BOOLEAN NOT NULL DEFAULT false,\n   163→      created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()\n   164→    )\n   165→  `;\n   166→\n   167→  // Project milestones\n   168→  await sql`\n   169→    CREATE TABLE IF NOT EXISTS project_milestones (\n   170→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n   171→      project_id UUID NOT NULL REFERENCES projects(id) ON DELETE CASCADE,\n   172→      name TEXT NOT NULL,\n   173→      target_date DATE,\n   174→      completed BOOLEAN NOT NULL DEFAULT false,\n   175→      created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()\n   176→    )\n   177→  `;\n   178→\n   179→  // Project activity\n   180→  await sql`\n   181→    CREATE TABLE IF NOT EXISTS project_activity (\n   182→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n   183→      project_id UUID NOT NULL REFERENCES projects(id) ON DELETE CASCADE,\n   184→      member_id UUID REFERENCES members(id) ON DELETE SET NULL,\n   185→      action TEXT NOT NULL,\n   186→      created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()\n   187→    )\n   188→  `;\n   189→\n   190→  // Migrations: add columns that CREATE TABLE IF NOT EXISTS can't detect\n   191→  await sql`DO $$ BEGIN ALTER TABLE issues ADD COLUMN parent_id UUID REFERENCES issues(id) ON DELETE SET NULL; EXCEPTION WHEN duplicate_column THEN NULL; END $$`;\n   192→  await sql`DO $$ BEGIN ALTER TABLE activity ADD COLUMN field TEXT; EXCEPTION WHEN duplicate_column THEN NULL; END $$`;\n   193→  await sql`DO $$ BEGIN ALTER TABLE activity ADD COLUMN new_value TEXT; EXCEPTION WHEN duplicate_column THEN NULL; END $$`;\n   194→  await sql`DO $$ BEGIN ALTER TABLE notifications ADD COLUMN archived BOOLEAN NOT NULL DEFAULT false; EXCEPTION WHEN duplicate_column THEN NULL; END $$`;\n   195→  await sql`DO $$ BEGIN ALTER TABLE members ADD COLUMN created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(); EXCEPTION WHEN duplicate_column THEN NULL; END $$`;\n   196→\n   197→  // Indexes for common queries\n   198→  await sql`CREATE INDEX IF NOT EXISTS idx_issues_team_id ON issues(team_id)`;\n   199→  await sql`CREATE INDEX IF NOT EXISTS idx_issues_assignee_id ON issues(assignee_id)`;\n   200→  await sql`CREATE INDEX IF NOT EXISTS idx_issues_project_id ON issues(project_id)`;\n   201→  await sql`CREATE INDEX IF NOT EXISTS idx_issues_cycle_id ON issues(cycle_id)`;\n   202→  await sql`CREATE INDEX IF NOT EXISTS idx_issues_parent_id ON issues(parent_id)`;\n   203→  await sql`CREATE INDEX IF NOT EXISTS idx_issue_labels_issue_id ON issue_labels(issue_id)`;\n   204→  await sql`CREATE INDEX IF NOT EXISTS idx_issue_labels_label_id ON issue_labels(label_id)`;\n   205→  await sql`CREATE INDEX IF NOT EXISTS idx_team_members_team_id ON team_members(team_id)`;\n   206→  await sql`CREATE INDEX IF NOT EXISTS idx_team_members_member_id ON team_members(member_id)`;\n   207→  await sql`CREATE INDEX IF NOT EXISTS idx_sessions_member_id ON sessions(member_id)`;\n   208→  await sql`CREATE INDEX IF NOT EXISTS idx_comments_issue_id ON comments(issue_id)`;\n   209→  await sql`CREATE INDEX IF NOT EXISTS idx_activity_issue_id ON activity(issue_id)`;\n   210→  await sql`CREATE INDEX IF NOT EXISTS idx_notifications_member_id ON notifications(member_id)`;\n   211→  await sql`CREATE INDEX IF NOT EXISTS idx_project_milestones_project_id ON project_milestones(project_id)`;\n   212→  await sql`CREATE INDEX IF NOT EXISTS idx_project_activity_project_id ON project_activity(project_id)`;\n   213→  await sql`CREATE INDEX IF NOT EXISTS idx_cycles_team_id ON cycles(team_id)`;\n   214→}\n   215→\n   216→// CLI: run schema with a database URL argument\n   217→const url = process.argv[2];\n   218→if (url) {\n   219→  initSchema(url).then(() => {\n   220→    console.log('Schema initialized successfully');\n   221→    process.exit(0);\n   222→  }).catch((err) => {\n   223→    console.error('Schema initialization failed:', err);\n   224→    process.exit(1);\n   225→  });\n   226→}\n   227→"}]},"parent_tool_use_id":"toolu_01UFscE12onVg7LEgofmhPYT","session_id":"7b3a342c-e5c0-4c3a-aec1-6eee419ae688","uuid":"77f476e1-2acf-416c-af73-90fb22696c22"}
