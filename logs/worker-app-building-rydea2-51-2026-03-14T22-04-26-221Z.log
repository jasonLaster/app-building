[2026-03-14T21:59:46.887Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MNWKkM9T5GVZfnaRvnUbgk","type":"tool_result","content":"     1→import { useState, useRef, useEffect } from 'react';\n     2→import { useDispatch } from 'react-redux';\n     3→import type { AppDispatch } from '../store';\n     4→import type { Issue } from '../slices/issuesSlice';\n     5→import { updateIssueField } from '../slices/issueDetailSlice';\n     6→import { StatusIcon, STATUS_CONFIG, STATUS_ORDER } from './IssueRow';\n     7→import './IssueHeader.css';\n     8→\n     9→interface IssueHeaderProps {\n    10→  issue: Issue;\n    11→}\n    12→\n    13→export default function IssueHeader({ issue }: IssueHeaderProps) {\n    14→  const dispatch = useDispatch<AppDispatch>();\n    15→  const [editingTitle, setEditingTitle] = useState(false);\n    16→  const [titleValue, setTitleValue] = useState(issue.title);\n    17→  const [titleError, setTitleError] = useState(false);\n    18→  const [statusDropdownOpen, setStatusDropdownOpen] = useState(false);\n    19→  const titleInputRef = useRef<HTMLInputElement>(null);\n    20→  const statusRef = useRef<HTMLDivElement>(null);\n    21→\n    22→  useEffect(() => {\n    23→    setTitleValue(issue.title);\n    24→  }, [issue.title]);\n    25→\n    26→  useEffect(() => {\n    27→    if (editingTitle) {\n    28→      titleInputRef.current?.focus();\n    29→      titleInputRef.current?.select();\n    30→    }\n    31→  }, [editingTitle]);\n    32→\n    33→  useEffect(() => {\n    34→    function handleClickOutside(e: MouseEvent) {\n    35→      if (statusRef.current && !statusRef.current.contains(e.target as Node)) {\n    36→        setStatusDropdownOpen(false);\n    37→      }\n    38→    }\n    39→    if (statusDropdownOpen) {\n    40→      document.addEventListener('mousedown', handleClickOutside);\n    41→    }\n    42→    return () => document.removeEventListener('mousedown', handleClickOutside);\n    43→  }, [statusDropdownOpen]);\n    44→\n    45→  function handleTitleClick() {\n    46→    setEditingTitle(true);\n    47→    setTitleError(false);\n    48→  }\n    49→\n    50→  async function saveTitle() {\n    51→    const trimmed = titleValue.trim();\n    52→    if (!trimmed) {\n    53→      setTitleError(true);\n    54→      return;\n    55→    }\n    56→    if (trimmed !== issue.title) {\n    57→      await dispatch(updateIssueField({ issueId: issue.id, field: 'title', value: trimmed }));\n    58→    }\n    59→    setEditingTitle(false);\n    60→    setTitleError(false);\n    61→  }\n    62→\n    63→  function handleTitleKeyDown(e: React.KeyboardEvent) {\n    64→    if (e.key === 'Enter') {\n    65→      e.preventDefault();\n    66→      saveTitle();\n    67→    } else if (e.key === 'Escape') {\n    68→      setTitleValue(issue.title);\n    69→      setEditingTitle(false);\n    70→      setTitleError(false);\n    71→    }\n    72→  }\n    73→\n    74→  function handleStatusChange(newStatus: string) {\n    75→    dispatch(updateIssueField({ issueId: issue.id, field: 'status', value: newStatus }));\n    76→    setStatusDropdownOpen(false);\n    77→  }\n    78→\n    79→  const statusConfig = STATUS_CONFIG[issue.status] || STATUS_CONFIG.todo;\n    80→\n    81→  return (\n    82→    <div className=\"issue-header\" data-testid=\"issue-header\">\n    83→      <div className=\"issue-header-identifier\" data-testid=\"issue-header-identifier\">\n    84→        {issue.identifier}\n    85→      </div>\n    86→\n    87→      <div className=\"issue-header-title-row\">\n    88→        {editingTitle ? (\n    89→          <input\n    90→            ref={titleInputRef}\n    91→            className={`issue-header-title-input ${titleError ? 'issue-header-title-input-error' : ''}`}\n    92→            value={titleValue}\n    93→            onChange={(e) => { setTitleValue(e.target.value); setTitleError(false); }}\n    94→            onBlur={saveTitle}\n    95→            onKeyDown={handleTitleKeyDown}\n    96→            data-testid=\"issue-header-title-input\"\n    97→          />\n    98→        ) : (\n    99→          <h1\n   100→            className=\"issue-header-title\"\n   101→            onClick={handleTitleClick}\n   102→            data-testid=\"issue-header-title\"\n   103→          >\n   104→            {issue.title}\n   105→          </h1>\n   106→        )}\n   107→      </div>\n   108→\n   109→      <div className=\"issue-header-status-row\" ref={statusRef}>\n   110→        <button\n   111→          className=\"issue-header-status-btn\"\n   112→          onClick={() => setStatusDropdownOpen(!statusDropdownOpen)}\n   113→          data-testid=\"issue-header-status-btn\"\n   114→        >\n   115→          <StatusIcon status={issue.status} color={statusConfig.color} />\n   116→          <span style={{ color: statusConfig.color }}>{statusConfig.label}</span>\n   117→        </button>\n   118→        {statusDropdownOpen && (\n   119→          <div className=\"issue-header-status-dropdown\" data-testid=\"issue-header-status-dropdown\">\n   120→            {STATUS_ORDER.map((s) => {\n   121→              const cfg = STATUS_CONFIG[s];\n   122→              return (\n   123→                <button\n   124→                  key={s}\n   125→                  className={`issue-header-status-option ${issue.status === s ? 'issue-header-status-option-active' : ''}`}\n   126→                  onClick={() => handleStatusChange(s)}\n   127→                  data-testid={`issue-header-status-option-${s}`}\n   128→                >\n   129→                  <StatusIcon status={s} color={cfg.color} />\n   130→                  <span>{cfg.label}</span>\n   131→                </button>\n   132→              );\n   133→            })}\n   134→          </div>\n   135→        )}\n   136→      </div>\n   137→    </div>\n   138→  );\n   139→}\n   140→"}]},"parent_tool_use_id":"toolu_01UFscE12onVg7LEgofmhPYT","session_id":"7b3a342c-e5c0-4c3a-aec1-6eee419ae688","uuid":"1e08de73-d6e9-4410-b997-126382f358cd"}
