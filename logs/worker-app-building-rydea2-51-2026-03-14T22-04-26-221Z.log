[2026-03-14T22:00:38.996Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01W9D5sFq8CHjtWsrjodft6c","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions';\n     2→import { getSql } from './db';\n     3→\n     4→export default async function handler(req: Request, _context: Context) {\n     5→  if (req.method !== 'POST') {\n     6→    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n     7→      status: 405,\n     8→      headers: { 'Content-Type': 'application/json' },\n     9→    });\n    10→  }\n    11→\n    12→  try {\n    13→    const authHeader = req.headers.get('Authorization');\n    14→    if (!authHeader?.startsWith('Bearer ')) {\n    15→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    16→        status: 401,\n    17→        headers: { 'Content-Type': 'application/json' },\n    18→      });\n    19→    }\n    20→\n    21→    const token = authHeader.slice(7);\n    22→    const sql = getSql();\n    23→\n    24→    const sessions = await sql`\n    25→      SELECT s.member_id FROM sessions s\n    26→      WHERE s.token = ${token} AND s.expires_at > NOW()\n    27→    `;\n    28→    const session = sessions[0];\n    29→    if (!session) {\n    30→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    31→        status: 401,\n    32→        headers: { 'Content-Type': 'application/json' },\n    33→      });\n    34→    }\n    35→\n    36→    const body = await req.json();\n    37→    const {\n    38→      teamId,\n    39→      title,\n    40→      description,\n    41→      status,\n    42→      priority,\n    43→      assigneeId,\n    44→      labelIds,\n    45→      projectId,\n    46→      cycleId,\n    47→      dueDate,\n    48→      parentId,\n    49→    } = body;\n    50→\n    51→    if (!teamId || !title) {\n    52→      return new Response(JSON.stringify({ error: 'teamId and title are required' }), {\n    53→        status: 400,\n    54→        headers: { 'Content-Type': 'application/json' },\n    55→      });\n    56→    }\n    57→\n    58→    // Get the next issue number for this team\n    59→    const numberResult = await sql`\n    60→      SELECT COALESCE(MAX(number), 0) + 1 AS next_number\n    61→      FROM issues\n    62→      WHERE team_id = ${teamId}\n    63→    `;\n    64→    const nextNumber = numberResult[0]?.next_number || 1;\n    65→\n    66→    // Get team identifier\n    67→    const teamResult = await sql`\n    68→      SELECT identifier FROM teams WHERE id = ${teamId}\n    69→    `;\n    70→    const team = teamResult[0];\n    71→    if (!team) {\n    72→      return new Response(JSON.stringify({ error: 'Team not found' }), {\n    73→        status: 404,\n    74→        headers: { 'Content-Type': 'application/json' },\n    75→      });\n    76→    }\n    77→\n    78→    const issueStatus = status || 'backlog';\n    79→    const issuePriority = priority || 'none';\n    80→    const issueDueDate = dueDate || null;\n    81→    const issueAssigneeId = assigneeId || null;\n    82→    const issueProjectId = projectId || null;\n    83→    const issueCycleId = cycleId || null;\n    84→    const issueParentId = parentId || null;\n    85→    const issueDescription = description || '';\n    86→\n    87→    const insertResult = await sql`\n    88→      INSERT INTO issues (team_id, title, description, status, priority, number, due_date, assignee_id, project_id, cycle_id, parent_id)\n    89→      VALUES (${teamId}, ${title}, ${issueDescription}, ${issueStatus}, ${issuePriority}, ${nextNumber}, ${issueDueDate}, ${issueAssigneeId}, ${issueProjectId}, ${issueCycleId}, ${issueParentId})\n    90→      RETURNING id, created_at, updated_at\n    91→    `;\n    92→    const newIssue = insertResult[0];\n    93→    if (!newIssue) {\n    94→      return new Response(JSON.stringify({ error: 'Failed to create issue' }), {\n    95→        status: 500,\n    96→        headers: { 'Content-Type': 'application/json' },\n    97→      });\n    98→    }\n    99→\n   100→    // Insert labels\n   101→    const labels: Array<{ id: string; name: string; color: string }> = [];\n   102→    if (labelIds && Array.isArray(labelIds) && labelIds.length > 0) {\n   103→      for (const labelId of labelIds) {\n   104→        await sql`\n   105→          INSERT INTO issue_labels (issue_id, label_id)\n   106→          VALUES (${newIssue.id}, ${labelId})\n   107→        `;\n   108→      }\n   109→      const labelRows = await sql`\n   110→        SELECT id, name, color FROM labels WHERE id = ANY(${labelIds})\n   111→      `;\n   112→      labels.push(...labelRows.map((l) => ({ id: String(l.id), name: String(l.name), color: String(l.color) })));\n   113→    }\n   114→\n   115→    // Create activity history entry\n   116→    await sql`\n   117→      INSERT INTO activity (issue_id, member_id, action, created_at)\n   118→      VALUES (${newIssue.id}, ${session.member_id}, 'created this issue', NOW())\n   119→    `;\n   120→\n   121→    // Create notification for assignee if different from creator\n   122→    if (issueAssigneeId && issueAssigneeId !== session.member_id) {\n   123→      const creatorResult = await sql`\n   124→        SELECT name FROM members WHERE id = ${session.member_id}\n   125→      `;\n   126→      const creator = creatorResult[0];\n   127→      const creatorName = creator ? String(creator.name) : 'Someone';\n   128→      const identifier = `${team.identifier}-${nextNumber}`;\n   129→\n   130→      await sql`\n   131→        INSERT INTO notifications (member_id, type, message, issue_id, created_at)\n   132→        VALUES (${issueAssigneeId}, 'assigned', ${`${creatorName} assigned you to ${identifier}: ${title}`}, ${newIssue.id}, NOW())\n   133→      `;\n   134→    }\n   135→\n   136→    // Fetch assignee name if set\n   137→    let assigneeName: string | null = null;\n   138→    let assigneeEmail: string | null = null;\n   139→    if (issueAssigneeId) {\n   140→      const assigneeResult = await sql`\n   141→        SELECT name, email FROM members WHERE id = ${issueAssigneeId}\n   142→      `;\n   143→      const assignee = assigneeResult[0];\n   144→      if (assignee) {\n   145→        assigneeName = String(assignee.name);\n   146→        assigneeEmail = String(assignee.email);\n   147→      }\n   148→    }\n   149→\n   150→    // Fetch project name if set\n   151→    let projectName: string | null = null;\n   152→    if (issueProjectId) {\n   153→      const projectResult = await sql`\n   154→        SELECT name FROM projects WHERE id = ${issueProjectId}\n   155→      `;\n   156→      const project = projectResult[0];\n   157→      if (project) {\n   158→        projectName = String(project.name);\n   159→      }\n   160→    }\n   161→\n   162→    const identifier = `${team.identifier}-${nextNumber}`;\n   163→\n   164→    return new Response(JSON.stringify({\n   165→      issue: {\n   166→        id: newIssue.id,\n   167→        title,\n   168→        description: issueDescription,\n   169→        status: issueStatus,\n   170→        priority: issuePriority,\n   171→        identifier,\n   172→        number: nextNumber,\n   173→        dueDate: issueDueDate ? String(issueDueDate).split('T')[0] : null,\n   174→        createdAt: newIssue.created_at,\n   175→        updatedAt: newIssue.updated_at,\n   176→        teamId,\n   177→        teamName: '',\n   178→        assigneeId: issueAssigneeId,\n   179→        assigneeName,\n   180→        assigneeEmail,\n   181→        projectId: issueProjectId,\n   182→        projectName,\n   183→        cycleId: issueCycleId,\n   184→        parentId: issueParentId,\n   185→        labels,\n   186→      },\n   187→    }), {\n   188→      status: 201,\n   189→      headers: { 'Content-Type': 'application/json' },\n   190→    });\n   191→  } catch (err) {\n   192→    console.error('Create issue error:', err);\n   193→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n   194→      status: 500,\n   195→      headers: { 'Content-Type': 'application/json' },\n   196→    });\n   197→  }\n   198→}\n   199→"}]},"parent_tool_use_id":null,"session_id":"7b3a342c-e5c0-4c3a-aec1-6eee419ae688","uuid":"da3d3cb6-957a-4191-8823-5adffd1a3571","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/netlify/functions/create-issue.ts","content":"import type { Context } from '@netlify/functions';\nimport { getSql } from './db';\n\nexport default async function handler(req: Request, _context: Context) {\n  if (req.method !== 'POST') {\n    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n      status: 405,\n      headers: { 'Content-Type': 'application/json' },\n    });\n  }\n\n  try {\n    const authHeader = req.headers.get('Authorization');\n    if (!authHeader?.startsWith('Bearer ')) {\n      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n        status: 401,\n        headers: { 'Content-Type': 'application/json' },\n      });\n    }\n\n    const token = authHeader.slice(7);\n    const sql = getSql();\n\n    const sessions = await sql`\n      SELECT s.member_id FROM sessions s\n      WHERE s.token = ${token} AND s.expires_at > NOW()\n    `;\n    const session = sessions[0];\n    if (!session) {\n      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n        status: 401,\n        headers: { 'Content-Type': 'application/json' },\n      });\n    }\n\n    const body = await req.json();\n    const {\n      teamId,\n      title,\n      description,\n      status,\n      priority,\n      assigneeId,\n      labelIds,\n      projectId,\n      cycleId,\n      dueDate,\n      parentId,\n    } = body;\n\n    if (!teamId || !title) {\n      return new Response(JSON.stringify({ error: 'teamId and title are required' }), {\n        status: 400,\n        headers: { 'Content-Type': 'application/json' },\n      });\n    }\n\n    // Get the next issue number for this team\n    const numberResult = await sql`\n      SELECT COALESCE(MAX(number), 0) + 1 AS next_number\n      FROM issues\n      WHERE team_id = ${teamId}\n    `;\n    const nextNumber = numberResult[0]?.next_number || 1;\n\n    // Get team identifier\n    const teamResult = await sql`\n      SELECT identifier FROM teams WHERE id = ${teamId}\n    `;\n    const team = teamResult[0];\n    if (!team) {\n      return new Response(JSON.stringify({ error: 'Team not found' }), {\n        status: 404,\n        headers: { 'Content-Type': 'application/json' },\n      });\n    }\n\n    const issueStatus = status || 'backlog';\n    const issuePriority = priority || 'none';\n    const issueDueDate = dueDate || null;\n    const issueAssigneeId = assigneeId || null;\n    const issueProjectId = projectId || null;\n    const issueCycleId = cycleId || null;\n    const issueParentId = parentId || null;\n    const issueDescription = description || '';\n\n    const insertResult = await sql`\n      INSERT INTO issues (team_id, title, description, status, priority, number, due_date, assignee_id, project_id, cycle_id, parent_id)\n      VALUES (${teamId}, ${title}, ${issueDescription}, ${issueStatus}, ${issuePriority}, ${nextNumber}, ${issueDueDate}, ${issueAssigneeId}, ${issueProjectId}, ${issueCycleId}, ${issueParentId})\n      RETURNING id, created_at, updated_at\n    `;\n    const newIssue = insertResult[0];\n    if (!newIssue) {\n      return new Response(JSON.stringify({ error: 'Failed to create issue' }), {\n        status: 500,\n        headers: { 'Content-Type': 'application/json' },\n      });\n    }\n\n    // Insert labels\n    const labels: Array<{ id: string; name: string; color: string }> = [];\n    if (labelIds && Array.isArray(labelIds) && labelIds.length > 0) {\n      for (const labelId of labelIds) {\n        await sql`\n          INSERT INTO issue_labels (issue_id, label_id)\n          VALUES (${newIssue.id}, ${labelId})\n        `;\n      }\n      const labelRows = await sql`\n        SELECT id, name, color FROM labels WHERE id = ANY(${labelIds})\n      `;\n      labels.push(...labelRows.map((l) => ({ id: String(l.id), name: String(l.name), color: String(l.color) })));\n    }\n\n    // Create activity history entry\n    await sql`\n      INSERT INTO activity (issue_id, member_id, action, created_at)\n      VALUES (${newIssue.id}, ${session.member_id}, 'created this issue', NOW())\n    `;\n\n    // Create notification for assignee if different from creator\n    if (issueAssigneeId && issueAssigneeId !== session.member_id) {\n      const creatorResult = await sql`\n        SELECT name FROM members WHERE id = ${session.member_id}\n      `;\n      const creator = creatorResult[0];\n      const creatorName = creator ? String(creator.name) : 'Someone';\n      const identifier = `${team.identifier}-${nextNumber}`;\n\n      await sql`\n        INSERT INTO notifications (member_id, type, message, issue_id, created_at)\n        VALUES (${issueAssigneeId}, 'assigned', ${`${creatorName} assigned you to ${identifier}: ${title}`}, ${newIssue.id}, NOW())\n      `;\n    }\n\n    // Fetch assignee name if set\n    let assigneeName: string | null = null;\n    let assigneeEmail: string | null = null;\n    if (issueAssigneeId) {\n      const assigneeResult = await sql`\n        SELECT name, email FROM members WHERE id = ${issueAssigneeId}\n      `;\n      const assignee = assigneeResult[0];\n      if (assignee) {\n        assigneeName = String(assignee.name);\n        assigneeEmail = String(assignee.email);\n      }\n    }\n\n    // Fetch project name if set\n    let projectName: string | null = null;\n    if (issueProjectId) {\n      const projectResult = await sql`\n        SELECT name FROM projects WHERE id = ${issueProjectId}\n      `;\n      const project = projectResult[0];\n      if (project) {\n        projectName = String(project.name);\n      }\n    }\n\n    const identifier = `${team.identifier}-${nextNumber}`;\n\n    return new Response(JSON.stringify({\n      issue: {\n        id: newIssue.id,\n        title,\n        description: issueDescription,\n        status: issueStatus,\n        priority: issuePriority,\n        identifier,\n        number: nextNumber,\n        dueDate: issueDueDate ? String(issueDueDate).split('T')[0] : null,\n        createdAt: newIssue.created_at,\n        updatedAt: newIssue.updated_at,\n        teamId,\n        teamName: '',\n        assigneeId: issueAssigneeId,\n        assigneeName,\n        assigneeEmail,\n        projectId: issueProjectId,\n        projectName,\n        cycleId: issueCycleId,\n        parentId: issueParentId,\n        labels,\n      },\n    }), {\n      status: 201,\n      headers: { 'Content-Type': 'application/json' },\n    });\n  } catch (err) {\n    console.error('Create issue error:', err);\n    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n      status: 500,\n      headers: { 'Content-Type': 'application/json' },\n    });\n  }\n}\n","numLines":199,"startLine":1,"totalLines":199}}}
