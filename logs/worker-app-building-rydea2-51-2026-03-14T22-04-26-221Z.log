</button>\n      <button\n        className=\"cia-submit-btn\"\n        onClick={onSubmit}\n        disabled={submitting}\n        data-testid=\"create-issue-submit-btn\"\n      >\n        {submitting ? 'Creating...' : 'Create Issue'}\n      </button>\n    </div>\n  );\n}\n","numLines":31,"startLine":1,"totalLines":31}}}
[2026-03-14T22:00:44.437Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017irE7hFJKNnqZnTmg1bnkQ","type":"tool_result","content":"     1→import { useState, useEffect, useRef, useCallback } from 'react';\n     2→import { useSelector } from 'react-redux';\n     3→import type { RootState } from '../store';\n     4→import { StatusIcon, PriorityIcon, STATUS_CONFIG, STATUS_ORDER } from './IssueRow';\n     5→import './CreateIssueForm.css';\n     6→\n     7→const PRIORITY_ORDER = ['urgent', 'high', 'medium', 'low', 'none'] as const;\n     8→const PRIORITY_LABELS: Record<string, string> = {\n     9→  urgent: 'Urgent',\n    10→  high: 'High',\n    11→  medium: 'Medium',\n    12→  low: 'Low',\n    13→  none: 'No Priority',\n    14→};\n    15→\n    16→interface SearchableIssue {\n    17→  id: string;\n    18→  title: string;\n    19→  identifier: string;\n    20→}\n    21→\n    22→export interface CreateIssueFormData {\n    23→  teamId: string;\n    24→  title: string;\n    25→  description: string;\n    26→  status: string;\n    27→  priority: string;\n    28→  assigneeId: string | null;\n    29→  labelIds: string[];\n    30→  projectId: string | null;\n    31→  cycleId: string | null;\n    32→  dueDate: string | null;\n    33→  parentId: string | null;\n    34→}\n    35→\n    36→interface CreateIssueFormProps {\n    37→  defaultTeamId?: string;\n    38→  formData: CreateIssueFormData;\n    39→  onFormChange: (data: CreateIssueFormData) => void;\n    40→  titleError: string | null;\n    41→}\n    42→\n    43→type DropdownType = 'team' | 'status' | 'priority' | 'assignee' | 'labels' | 'project' | 'cycle' | 'parent' | null;\n    44→\n    45→export default function CreateIssueForm({ defaultTeamId, formData, onFormChange, titleError }: CreateIssueFormProps) {\n    46→  const { items: teams } = useSelector((state: RootState) => state.teams);\n    47→  const { items: labels } = useSelector((state: RootState) => state.labels);\n    48→  const token = useSelector((state: RootState) => state.auth.token);\n    49→\n    50→  const [openDropdown, setOpenDropdown] = useState<DropdownType>(null);\n    51→  const [assigneeSearch, setAssigneeSearch] = useState('');\n    52→  const [projectSearch, setProjectSearch] = useState('');\n    53→  const [parentSearch, setParentSearch] = useState('');\n    54→  const [parentResults, setParentResults] = useState<SearchableIssue[]>([]);\n    55→\n    56→  // Team-specific data (members, projects, cycles)\n    57→  const [teamMembers, setTeamMembers] = useState<Array<{ id: string; name: string; email: string }>>([]);\n    58→  const [teamProjects, setTeamProjects] = useState<Array<{ id: string; name: string }>>([]);\n    59→  const [teamCycles, setTeamCycles] = useState<Array<{ id: string; name: string; start_date: string; end_date: string }>>([]);\n    60→\n    61→  const formRef = useRef<HTMLDivElement>(null);\n    62→  const titleRef = useRef<HTMLInputElement>(null);\n    63→\n    64→  // Focus title on mount\n    65→  useEffect(() => {\n    66→    titleRef.current?.focus();\n    67→  }, []);\n    68→\n    69→  // Set default team\n    70→  useEffect(() => {\n    71→    if (defaultTeamId && !formData.teamId) {\n    72→      onFormChange({ ...formData, teamId: defaultTeamId });\n    73→    } else if (!formData.teamId && teams.length > 0 && teams[0]) {\n    74→      onFormChange({ ...formData, teamId: teams[0].id });\n    75→    }\n    76→  }, [defaultTeamId, teams]); // eslint-disable-line react-hooks/exhaustive-deps\n    77→\n    78→  // Fetch team-specific data when team changes\n    79→  const fetchTeamData = useCallback(async (teamId: string) => {\n    80→    if (!token || !teamId) return;\n    81→    try {\n    82→      const response = await fetch(`/api/team-issues?teamId=${teamId}`, {\n    83→        headers: { Authorization: `Bearer ${token}` },\n    84→      });\n    85→      if (response.ok) {\n    86→        const data = await response.json();\n    87→        setTeamMembers(data.members || []);\n    88→        setTeamProjects(data.projects || []);\n    89→        setTeamCycles(data.cycles || []);\n    90→      }\n    91→    } catch {\n    92→      // silently fail\n    93→    }\n    94→  }, [token]);\n    95→\n    96→  useEffect(() => {\n    97→    if (formData.teamId) {\n    98→      fetchTeamData(formData.teamId);\n    99→    }\n   100→  }, [formData.teamId, fetchTeamData]);\n   101→\n   102→  // Search parent issues\n   103→  useEffect(() => {\n   104→    if (!token || openDropdown !== 'parent') return;\n   105→    const controller = new AbortController();\n   106→    const fetchParents = async () => {\n   107→      try {\n   108→        const params = new URLSearchParams();\n   109→        if (parentSearch) params.set('q', parentSearch);\n   110→        if (formData.teamId) params.set('teamId', formData.teamId);\n   111→        const response = await fetch(`/api/search-issues?${params}`, {\n   112→          headers: { Authorization: `Bearer ${token}` },\n   113→          signal: controller.signal,\n   114→        });\n   115→        if (response.ok) {\n   116→          const data = await response.json();\n   117→          setParentResults(data.issues || []);\n   118→        }\n   119→      } catch {\n   120→        // ignore abort errors\n   121→      }\n   122→    };\n   123→    const timer = setTimeout(fetchParents, 200);\n   124→    return () => {\n   125→      clearTimeout(timer);\n   126→      controller.abort();\n   127→    };\n   128→  }, [parentSearch, formData.teamId, token, openDropdown]);\n   129→\n   130→  // Close dropdown on outside click\n   131→  useEffect(() => {\n   132→    function handleClickOutside(e: MouseEvent) {\n   133→      if (formRef.current && !formRef.current.contains(e.target as Node)) {\n   134→        setOpenDropdown(null);\n   135→      }\n   136→    }\n   137→    if (openDropdown) {\n   138→      document.addEventListener('mousedown', handleClickOutside);\n   139→    }\n   140→    return () => document.removeEventListener('mousedown', handleClickOutside);\n   141→  }, [openDropdown]);\n   142→\n   143→  function updateField<K extends keyof CreateIssueFormData>(key: K, value: CreateIssueFormData[K]) {\n   144→    onFormChange({ ...formData, [key]: value });\n   145→  }\n   146→\n   147→  function toggleDropdown(type: DropdownType) {\n   148→    setOpenDropdown(openDropdown === type ? null : type);\n   149→    if (type === 'assignee') setAssigneeSearch('');\n   150→    if (type === 'project') setProjectSearch('');\n   151→    if (type === 'parent') setParentSearch('');\n   152→  }\n   153→\n   154→  function handleTeamChange(teamId: string) {\n   155→    onFormChange({ ...formData, teamId, cycleId: null });\n   156→    setOpenDropdown(null);\n   157→  }\n   158→\n   159→  function handleLabelToggle(labelId: string) {\n   160→    const current = formData.labelIds;\n   161→    if (current.includes(labelId)) {\n   162→      updateField('labelIds', current.filter((id) => id !== labelId));\n   163→    } else {\n   164→      updateField('labelIds', [...current, labelId]);\n   165→    }\n   166→  }\n   167→\n   168→  function handleRemoveLabel(labelId: string) {\n   169→    updateField('labelIds', formData.labelIds.filter((id) => id !== labelId));\n   170→  }\n   171→\n   172→  const selectedTeam = teams.find((t) => t.id === formData.teamId);\n   173→  const selectedAssignee = teamMembers.find((m) => m.id === formData.assigneeId);\n   174→  const selectedProject = teamProjects.find((p) => p.id === formData.projectId);\n   175→  const selectedCycle = teamCycles.find((c) => c.id === formData.cycleId);\n   176→  const selectedLabels = labels.filter((l) => formData.labelIds.includes(l.id));\n   177→  const selectedParent = parentResults.find((i) => i.id === formData.parentId);\n   178→\n   179→  const filteredMembers = teamMembers.filter((m) =>\n   180→    m.name.toLowerCase().includes(assigneeSearch.toLowerCase())\n   181→  );\n   182→  const filteredProjects = teamProjects.filter((p) =>\n   183→    p.name.toLowerCase().includes(projectSearch.toLowerCase())\n   184→  );\n   185→  const filteredParents = parentResults.filter((i) =>\n   186→    !parentSearch || i.title.toLowerCase().includes(parentSearch.toLowerCase()) || i.identifier.toLowerCase().includes(parentSearch.toLowerCase())\n   187→  );\n   188→\n   189→  const statusConfig = STATUS_CONFIG[formData.status] || STATUS_CONFIG.backlog;\n   190→\n   191→  function formatDueDisplay(dateStr: string): string {\n   192→    const d = new Date(dateStr + 'T00:00:00');\n   193→    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });\n   194→  }\n   195→\n   196→  return (\n   197→    <div className=\"create-issue-form\" ref={formRef} data-testid=\"create-issue-form\">\n   198→      {/* Team Selector */}\n   199→      <div className=\"cif-field\" data-testid=\"create-issue-team-field\">\n   200→        <label className=\"cif-label\">Team</label>\n   201→        <div className=\"cif-dropdown-wrapper\">\n   202→          <button\n   203→            className=\"cif-select-btn\"\n   204→            onClick={() => toggleDropdown('team')}\n   205→            data-testid=\"create-issue-team-selector\"\n   206→          >\n   207→            <span>{selectedTeam ? selectedTeam.name : 'Select team'}</span>\n   208→            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n   209→          </button>\n   210→          {openDropdown === 'team' && (\n   211→            <div className=\"cif-dropdown\" data-testid=\"create-issue-team-dropdown\">\n   212→              {teams.map((team) => (\n   213→                <button\n   214→                  key={team.id}\n   215→                  className={`cif-dropdown-option ${formData.teamId === team.id ? 'cif-dropdown-option-active' : ''}`}\n   216→                  onClick={() => handleTeamChange(team.id)}\n   217→                  data-testid={`create-issue-team-option-${team.id}`}\n   218→                >\n   219→                  {team.name}\n   220→                </button>\n   221→              ))}\n   222→            </div>\n   223→          )}\n   224→        </div>\n   225→      </div>\n   226→\n   227→      {/* Title */}\n   228→      <div className=\"cif-field\" data-testid=\"create-issue-title-field\">\n   229→        <label className=\"cif-label\">Title</label>\n   230→        <input\n   231→          ref={titleRef}\n   232→          type=\"text\"\n   233→          className={`cif-input ${titleError ? 'cif-input-error' : ''}`}\n   234→          placeholder=\"Issue title\"\n   235→          value={formData.title}\n   236→          onChange={(e) => updateField('title', e.target.value)}\n   237→          data-testid=\"create-issue-title-input\"\n   238→        />\n   239→        {titleError && (\n   240→          <span className=\"cif-error\" data-testid=\"create-issue-title-error\">{titleError}</span>\n   241→        )}\n   242→      </div>\n   243→\n   244→      {/* Description */}\n   245→      <div className=\"cif-field\" data-testid=\"create-issue-description-field\">\n   246→        <label className=\"cif-label\">Description</label>\n   247→        <textarea\n   248→          className=\"cif-textarea\"\n   249→          placeholder=\"Add description... (supports markdown)\"\n   250→          value={formData.description}\n   251→          onChange={(e) => updateField('description', e.target.value)}\n   252→          rows={3}\n   253→          data-testid=\"create-issue-description-input\"\n   254→        />\n   255→      </div>\n   256→\n   257→      {/* Status & Priority row */}\n   258→      <div className=\"cif-row\">\n   259→        {/* Status */}\n   260→        <div className=\"cif-field cif-field-half\" data-testid=\"create-issue-status-field\">\n   261→          <label className=\"cif-label\">Status</label>\n   262→          <div className=\"cif-dropdown-wrapper\">\n   263→            <button\n   264→              className=\"cif-select-btn\"\n   265→              onClick={() => toggleDropdown('status')}\n   266→              data-testid=\"create-issue-status-selector\"\n   267→            >\n   268→              <StatusIcon status={formData.status} color={statusConfig.color} />\n   269→              <span>{statusConfig.label}</span>\n   270→              <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n   271→            </button>\n   272→            {openDropdown === 'status' && (\n   273→              <div className=\"cif-dropdown\" data-testid=\"create-issue-status-dropdown\">\n   274→                {STATUS_ORDER.map((s) => {\n   275→                  const cfg = STATUS_CONFIG[s];\n   276→                  return (\n   277→                    <button\n   278→                      key={s}\n   279→                      className={`cif-dropdown-option ${formData.status === s ? 'cif-dropdown-option-active' : ''}`}\n   280→                      onClick={() => { updateField('status', s); setOpenDropdown(null); }}\n   281→                      data-testid={`create-issue-status-option-${s}`}\n   282→                    >\n   283→                      <StatusIcon status={s} color={cfg.color} />\n   284→                      <span>{cfg.label}</span>\n   285→                    </button>\n   286→                  );\n   287→                })}\n   288→              </div>\n   289→            )}\n   290→          </div>\n   291→        </div>\n   292→\n   293→        {/* Priority */}\n   294→        <div className=\"cif-field cif-field-half\" data-testid=\"create-issue-priority-field\">\n   295→          <label className=\"cif-label\">Priority</label>\n   296→          <div className=\"cif-dropdown-wrapper\">\n   297→            <button\n   298→              className=\"cif-select-btn\"\n   299→              onClick={() => toggleDropdown('priority')}\n   300→              data-testid=\"create-issue-priority-selector\"\n   301→            >\n   302→              <PriorityIcon priority={formData.priority} />\n   303→              <span>{PRIORITY_LABELS[formData.priority] || 'No Priority'}</span>\n   304→              <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n   305→            </button>\n   306→            {openDropdown === 'priority' && (\n   307→              <div className=\"cif-dropdown\" data-testid=\"create-issue-priority-dropdown\">\n   308→                {PRIORITY_ORDER.map((p) => (\n   309→                  <button\n   310→                    key={p}\n   311→                    className={`cif-dropdown-option ${formData.priority === p ? 'cif-dropdown-option-active' : ''}`}\n   312→                    onClick={() => { updateField('priority', p); setOpenDropdown(null); }}\n   313→                    data-testid={`create-issue-priority-option-${p}`}\n   314→                  >\n   315→                    <PriorityIcon priority={p} />\n   316→                    <span>{PRIORITY_LABELS[p]}</span>\n   317→                  </button>\n   318→                ))}\n   319→              </div>\n   320→            )}\n   321→          </div>\n   322→        </div>\n   323→      </div>\n   324→\n   325→      {/* Assignee */}\n   326→      <div className=\"cif-field\" data-testid=\"create-issue-assignee-field\">\n   327→        <label className=\"cif-label\">Assignee</label>\n   328→        <div className=\"cif-dropdown-wrapper\">\n   329→          <button\n   330→            className=\"cif-select-btn\"\n   331→            onClick={() => toggleDropdown('assignee')}\n   332→            data-testid=\"create-issue-assignee-selector\"\n   333→          >\n   334→            {selectedAssignee ? (\n   335→              <>\n   336→                <span className=\"cif-avatar\">{selectedAssignee.name.split(' ').map((n) => n[0]).join('').toUpperCase().slice(0, 2)}</span>\n   337→                <span>{selectedAssignee.name}</span>\n   338→              </>\n   339→            ) : (\n   340→              <span className=\"cif-placeholder\">No assignee</span>\n   341→            )}\n   342→            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n   343→          </button>\n   344→          {openDropdown === 'assignee' && (\n   345→            <div className=\"cif-dropdown cif-dropdown-searchable\" data-testid=\"create-issue-assignee-dropdown\">\n   346→              <input\n   347→                className=\"cif-search-input\"\n   348→                placeholder=\"Search members...\"\n   349→                value={assigneeSearch}\n   350→                onChange={(e) => setAssigneeSearch(e.target.value)}\n   351→                autoFocus\n   352→                data-testid=\"create-issue-assignee-search\"\n   353→              />\n   354→              <button\n   355→                className=\"cif-dropdown-option\"\n   356→                onClick={() => { updateField('assigneeId', null); setOpenDropdown(null); }}\n   357→                data-testid=\"create-issue-assignee-option-none\"\n   358→              >\n   359→                <span className=\"cif-avatar cif-avatar-empty\">?</span>\n   360→                <span>No assignee</span>\n   361→              </button>\n   362→              {filteredMembers.map((m) => (\n   363→                <button\n   364→                  key={m.id}\n   365→                  className={`cif-dropdown-option ${formData.assigneeId === m.id ? 'cif-dropdown-option-active' : ''}`}\n   366→                  onClick={() => { updateField('assigneeId', m.id); setOpenDropdown(null); }}\n   367→                  data-testid={`create-issue-assignee-option-${m.id}`}\n   368→                >\n   369→                  <span className=\"cif-avatar\">{m.name.split(' ').map((n) => n[0]).join('').toUpperCase().slice(0, 2)}</span>\n   370→                  <span>{m.name}</span>\n   371→                </button>\n   372→              ))}\n   373→            </div>\n   374→          )}\n   375→        </div>\n   376→      </div>\n   377→\n   378→      {/* Labels */}\n   379→      <div className=\"cif-field\" data-testid=\"create-issue-labels-field\">\n   380→        <label className=\"cif-label\">Labels</label>\n   381→        {selectedLabels.length > 0 && (\n   382→          <div className=\"cif-selected-labels\" data-testid=\"create-issue-selected-labels\">\n   383→            {selectedLabels.map((label) => (\n   384→              <span key={label.id} className=\"cif-label-badge\" style={{ borderColor: label.color }} data-testid={`create-issue-label-badge-${label.id}`}>\n   385→                <span className=\"cif-label-dot\" style={{ backgroundColor: label.color }} />\n   386→                {label.name}\n   387→                <button\n   388→                  className=\"cif-label-remove\"\n   389→                  onClick={() => handleRemoveLabel(label.id)}\n   390→                  data-testid={`create-issue-label-remove-${label.id}`}\n   391→                >\n   392→                  &times;\n   393→                </button>\n   394→              </span>\n   395→            ))}\n   396→          </div>\n   397→        )}\n   398→        <div className=\"cif-dropdown-wrapper\">\n   399→          <button\n   400→            className=\"cif-select-btn\"\n   401→            onClick={() => toggleDropdown('labels')}\n   402→            data-testid=\"create-issue-labels-selector\"\n   403→          >\n   404→            <span className=\"cif-placeholder\">{selectedLabels.length === 0 ? 'Select labels' : 'Add more labels'}</span>\n   405→            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n   406→          </button>\n   407→          {openDropdown === 'labels' && (\n   408→            <div className=\"cif-dropdown\" data-testid=\"create-issue-labels-dropdown\">\n   409→              {labels.map((label) => (\n   410→                <button\n   411→                  key={label.id}\n   412→                  className={`cif-dropdown-option ${formData.labelIds.includes(label.id) ? 'cif-dropdown-option-active' : ''}`}\n   413→                  onClick={() => handleLabelToggle(label.id)}\n   414→                  data-testid={`create-issue-label-option-${label.id}`}\n   415→                >\n   416→                  <span className=\"cif-label-dot\" style={{ backgroundColor: label.color }} />\n   417→                  <span>{label.name}</span>\n   418→                  {formData.labelIds.includes(label.id) && (\n   419→                    <svg className=\"cif-check\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"20 6 9 17 4 12\" /></svg>\n   420→                  )}\n   421→                </button>\n   422→              ))}\n   423→              {labels.length === 0 && (\n   424→                <div className=\"cif-dropdown-empty\">No labels available</div>\n   425→              )}\n   426→            </div>\n   427→          )}\n   428→        </div>\n   429→      </div>\n   430→\n   431→      {/* Project */}\n   432→      <div className=\"cif-field\" data-testid=\"create-issue-project-field\">\n   433→        <label className=\"cif-label\">Project</label>\n   434→        <div className=\"cif-dropdown-wrapper\">\n   435→          <button\n   436→            className=\"cif-select-btn\"\n   437→            onClick={() => toggleDropdown('project')}\n   438→            data-testid=\"create-issue-project-selector\"\n   439→          >\n   440→            <span className={selectedProject ? '' : 'cif-placeholder'}>\n   441→              {selectedProject ? selectedProject.name : 'No project'}\n   442→            </span>\n   443→            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n   444→          </button>\n   445→          {openDropdown === 'project' && (\n   446→            <div className=\"cif-dropdown cif-dropdown-searchable\" data-testid=\"create-issue-project-dropdown\">\n   447→              <input\n   448→                className=\"cif-search-input\"\n   449→                placeholder=\"Search projects...\"\n   450→                value={projectSearch}\n   451→                onChange={(e) => setProjectSearch(e.target.value)}\n   452→                autoFocus\n   453→                data-testid=\"create-issue-project-search\"\n   454→              />\n   455→              <button\n   456→                className=\"cif-dropdown-option\"\n   457→                onClick={() => { updateField('projectId', null); setOpenDropdown(null); }}\n   458→                data-testid=\"create-issue-project-option-none\"\n   459→              >\n   460→                <span>No project</span>\n   461→              </button>\n   462→              {filteredProjects.map((p) => (\n   463→                <button\n   464→                  key={p.id}\n   465→                  className={`cif-dropdown-option ${formData.projectId === p.id ? 'cif-dropdown-option-active' : ''}`}\n   466→                  onClick={() => { updateField('projectId', p.id); setOpenDropdown(null); }}\n   467→                  data-testid={`create-issue-project-option-${p.id}`}\n   468→                >\n   469→                  <span>{p.name}</span>\n   470→                </button>\n   471→              ))}\n   472→            </div>\n   473→          )}\n   474→        </div>\n   475→      </div>\n   476→\n   477→      {/* Cycle */}\n   478→      <div className=\"cif-field\" data-testid=\"create-issue-cycle-field\">\n   479→        <label className=\"cif-label\">Cycle</label>\n   480→        <div className=\"cif-dropdown-wrapper\">\n   481→          <button\n   482→            className=\"cif-select-btn\"\n   483→            onClick={() => toggleDropdown('cycle')}\n   484→            data-testid=\"create-issue-cycle-selector\"\n   485→          >\n   486→            <span className={selectedCycle ? '' : 'cif-placeholder'}>\n   487→              {selectedCycle ? selectedCycle.name : 'No cycle'}\n   488→            </span>\n   489→            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n   490→          </button>\n   491→          {openDropdown === 'cycle' && (\n   492→            <div className=\"cif-dropdown\" data-testid=\"create-issue-cycle-dropdown\">\n   493→              <button\n   494→                className=\"cif-dropdown-option\"\n   495→                onClick={() => { updateField('cycleId', null); setOpenDropdown(null); }}\n   496→                data-testid=\"create-issue-cycle-option-none\"\n   497→              >\n   498→                <span>No cycle</span>\n   499→              </button>\n   500→              {teamCycles.map((c) => {\n   501→                const now = new Date();\n   502→                const start = new Date(c.start_date);\n   503→                const end = new Date(c.end_date);\n   504→                const isActive = now >= start && now <= end;\n   505→                return (\n   506→                  <button\n   507→                    key={c.id}\n   508→                    className={`cif-dropdown-option ${formData.cycleId === c.id ? 'cif-dropdown-option-active' : ''}`}\n   509→                    onClick={() => { updateField('cycleId', c.id); setOpenDropdown(null); }}\n   510→                    data-testid={`create-issue-cycle-option-${c.id}`}\n   511→                  >\n   512→                    <span>{c.name}</span>\n   513→                    {isActive && <span className=\"cif-active-badge\">Active</span>}\n   514→                  </button>\n   515→                );\n   516→              })}\n   517→              {teamCycles.length === 0 && (\n   518→                <div className=\"cif-dropdown-empty\">No cycles available</div>\n   519→              )}\n   520→            </div>\n   521→          )}\n   522→        </div>\n   523→      </div>\n   524→\n   525→      {/* Due Date */}\n   526→      <div className=\"cif-field\" data-testid=\"create-issue-due-date-field\">\n   527→        <label className=\"cif-label\">Due date</label>\n   528→        <div className=\"cif-date-wrapper\">\n   529→          <input\n   530→            type=\"date\"\n   531→            className=\"cif-date-input\"\n   532→            value={formData.dueDate || ''}\n   533→            onChange={(e) => updateField('dueDate', e.target.value || null)}\n   534→            data-testid=\"create-issue-due-date-input\"\n   535→          />\n   536→          {formData.dueDate && (\n   537→            <div className=\"cif-date-display\">\n   538→              <span data-testid=\"create-issue-due-date-display\">{formatDueDisplay(formData.dueDate)}</span>\n   539→              <button\n   540→                className=\"cif-date-clear\"\n   541→                onClick={() => updateField('dueDate', null)}\n   542→                data-testid=\"create-issue-due-date-clear\"\n   543→              >\n   544→                &times;\n   545→              </button>\n   546→            </div>\n   547→          )}\n   548→        </div>\n   549→      </div>\n   550→\n   551→      {/* Parent Issue */}\n   552→      <div className=\"cif-field\" data-testid=\"create-issue-parent-field\">\n   553→        <label className=\"cif-label\">Parent issue</label>\n   554→        <div className=\"cif-dropdown-wrapper\">\n   555→          <button\n   556→            className=\"cif-select-btn\"\n   557→            onClick={() => toggleDropdown('parent')}\n   558→            data-testid=\"create-issue-parent-selector\"\n   559→          >\n   560→            <span className={selectedParent || formData.parentId ? '' : 'cif-placeholder'}>\n   561→              {selectedParent ? `${selectedParent.identifier}: ${selectedParent.title}` : formData.parentId ? 'Loading...' : 'No parent issue'}\n   562→            </span>\n   563→            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n   564→          </button>\n   565→          {openDropdown === 'parent' && (\n   566→            <div className=\"cif-dropdown cif-dropdown-searchable\" data-testid=\"create-issue-parent-dropdown\">\n   567→              <input\n   568→                className=\"cif-search-input\"\n   569→                placeholder=\"Search issues...\"\n   570→                value={parentSearch}\n   571→                onChange={(e) => setParentSearch(e.target.value)}\n   572→                autoFocus\n   573→                data-testid=\"create-issue-parent-search\"\n   574→              />\n   575→              <button\n   576→                className=\"cif-dropdown-option\"\n   577→                onClick={() => { updateField('parentId', null); setOpenDropdown(null); }}\n   578→                data-testid=\"create-issue-parent-option-none\"\n   579→              >\n   580→                <span>No parent issue</span>\n   581→              </button>\n   582→              {filteredParents.map((issue) => (\n   583→                <button\n   584→                  key={issue.id}\n   585→                  className={`cif-dropdown-option ${formData.parentId === issue.id ? 'cif-dropdown-option-active' : ''}`}\n   586→                  onClick={() => { updateField('parentId', issue.id); setOpenDropdown(null); }}\n   587→                  data-testid={`create-issue-parent-option-${issue.id}`}\n   588→                >\n   589→                  <span className=\"cif-parent-identifier\">{issue.identifier}</span>\n   590→                  <span>{issue.title}</span>\n   591→                </button>\n   592→              ))}\n   593→              {filteredParents.length === 0 && parentSearch && (\n   594→                <div className=\"cif-dropdown-empty\">No issues found</div>\n   595→              )}\n   596→            </div>\n   597→          )}\n   598→        </div>\n   599→      </div>\n   600→    </div>\n   601→  );\n   602→}\n   603→"}]},"parent_tool_use_id":null,"session_id":"7b3a342c-e5c0-4c3a-aec1-6eee419ae688","uuid":"61928371-e672-4a18-8139-5e9e7e9c2a8a","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/src/components/CreateIssueForm.tsx","content":"import { useState, useEffect, useRef, useCallback } from 'react';\nimport { useSelector } from 'react-redux';\nimport type { RootState } from '../store';\nimport { StatusIcon, PriorityIcon, STATUS_CONFIG, STATUS_ORDER } from './IssueRow';\nimport './CreateIssueForm.css';\n\nconst PRIORITY_ORDER = ['urgent', 'high', 'medium', 'low', 'none'] as const;\nconst PRIORITY_LABELS: Record<string, string> = {\n  urgent: 'Urgent',\n  high: 'High',\n  medium: 'Medium',\n  low: 'Low',\n  none: 'No Priority',\n};\n\ninterface SearchableIssue {\n  id: string;\n  title: string;\n  identifier: string;\n}\n\nexport interface CreateIssueFormData {\n  teamId: string;\n  title: string;\n  description: string;\n  status: string;\n  priority: string;\n  assigneeId: string | null;\n  labelIds: string[];\n  projectId: string | null;\n  cycleId: string | null;\n  dueDate: string | null;\n  parentId: string | null;\n}\n\ninterface CreateIssueFormProps {\n  defaultTeamId?: string;\n  formData: CreateIssueFormData;\n  onFormChange: (data: CreateIssueFormData) => void;\n  titleError: string | null;\n}\n\ntype DropdownType = 'team' | 'status' | 'priority' | 'assignee' | 'labels' | 'project' | 'cycle' | 'parent' | null;\n\nexport default function CreateIssueForm({ defaultTeamId, formData, onFormChange, titleError }: CreateIssueFormProps) {\n  const { items: teams } = useSelector((state: RootState) => state.teams);\n  const { items: labels } = useSelector((state: RootState) => state.labels);\n  const token = useSelector((state: RootState) => state.auth.token);\n\n  const [openDropdown, setOpenDropdown] = useState<DropdownType>(null);\n  const [assigneeSearch, setAssigneeSearch] = useState('');\n  const [projectSearch, setProjectSearch] = useState('');\n  const [parentSearch, setParentSearch] = useState('');\n  const [parentResults, setParentResults] = useState<SearchableIssue[]>([]);\n\n  // Team-specific data (members, projects, cycles)\n  const [teamMembers, setTeamMembers] = useState<Array<{ id: string; name: string; email: string }>>([]);\n  const [teamProjects, setTeamProjects] = useState<Array<{ id: string; name: string }>>([]);\n  const [teamCycles, setTeamCycles] = useState<Array<{ id: string; name: string; start_date: string; end_date: string }>>([]);\n\n  const formRef = useRef<HTMLDivElement>(null);\n  const titleRef = useRef<HTMLInputElement>(null);\n\n  // Focus title on mount\n  useEffect(() => {\n    titleRef.current?.focus();\n  }, []);\n\n  // Set default team\n  useEffect(() => {\n    if (defaultTeamId && !formData.teamId) {\n      onFormChange({ ...formData, teamId: defaultTeamId });\n    } else if (!formData.teamId && teams.length > 0 && teams[0]) {\n      onFormChange({ ...formData, teamId: teams[0].id });\n    }\n  }, [defaultTeamId, teams]); // eslint-disable-line react-hooks/exhaustive-deps\n\n  // Fetch team-specific data when team changes\n  const fetchTeamData = useCallback(async (teamId: string) => {\n    if (!token || !teamId) return;\n    try {\n      const response = await fetch(`/api/team-issues?teamId=${teamId}`, {\n        headers: { Authorization: `Bearer ${token}` },\n      });\n      if (response.ok) {\n        const data = await response.json();\n        setTeamMembers(data.members || []);\n        setTeamProjects(data.projects || []);\n        setTeamCycles(data.cycles || []);\n      }\n    } catch {\n      // silently fail\n    }\n  }, [token]);\n\n  useEffect(() => {\n    if (formData.teamId) {\n      fetchTeamData(formData.teamId);\n    }\n  }, [formData.teamId, fetchTeamData]);\n\n  // Search parent issues\n  useEffect(() => {\n    if (!token || openDropdown !== 'parent') return;\n    const controller = new AbortController();\n    const fetchParents = async () => {\n      try {\n        const params = new URLSearchParams();\n        if (parentSearch) params.set('q', parentSearch);\n        if (formData.teamId) params.set('teamId', formData.teamId);\n        const response = await fetch(`/api/search-issues?${params}`, {\n          headers: { Authorization: `Bearer ${token}` },\n          signal: controller.signal,\n        });\n        if (response.ok) {\n          const data = await response.json();\n          setParentResults(data.issues || []);\n        }\n      } catch {\n        // ignore abort errors\n      }\n    };\n    const timer = setTimeout(fetchParents, 200);\n    return () => {\n      clearTimeout(timer);\n      controller.abort();\n    };\n  }, [parentSearch, formData.teamId, token, openDropdown]);\n\n  // Close dropdown on outside click\n  useEffect(() => {\n    function handleClickOutside(e: MouseEvent) {\n      if (formRef.current && !formRef.current.contains(e.target as Node)) {\n        setOpenDropdown(null);\n      }\n    }\n    if (openDropdown) {\n      document.addEventListener('mousedown', handleClickOutside);\n    }\n    return () => document.removeEventListener('mousedown', handleClickOutside);\n  }, [openDropdown]);\n\n  function updateField<K extends keyof CreateIssueFormData>(key: K, value: CreateIssueFormData[K]) {\n    onFormChange({ ...formData, [key]: value });\n  }\n\n  function toggleDropdown(type: DropdownType) {\n    setOpenDropdown(openDropdown === type ? null : type);\n    if (type === 'assignee') setAssigneeSearch('');\n    if (type === 'project') setProjectSearch('');\n    if (type === 'parent') setParentSearch('');\n  }\n\n  function handleTeamChange(teamId: string) {\n    onFormChange({ ...formData, teamId, cycleId: null });\n    setOpenDropdown(null);\n  }\n\n  function handleLabelToggle(labelId: string) {\n    const current = formData.labelIds;\n    if (current.includes(labelId)) {\n      updateField('labelIds', current.filter((id) => id !== labelId));\n    } else {\n      updateField('labelIds', [...current, labelId]);\n    }\n  }\n\n  function handleRemoveLabel(labelId: string) {\n    updateField('labelIds', formData.labelIds.filter((id) => id !== labelId));\n  }\n\n  const selectedTeam = teams.find((t) => t.id === formData.teamId);\n  const selectedAssignee = teamMembers.find((m) => m.id === formData.assigneeId);\n  const selectedProject = teamProjects.find((p) => p.id === formData.projectId);\n  const selectedCycle = teamCycles.find((c) => c.id === formData.cycleId);\n  const selectedLabels = labels.filter((l) => formData.labelIds.includes(l.id));\n  const selectedParent = parentResults.find((i) => i.id === formData.parentId);\n\n  const filteredMembers = teamMembers.filter((m) =>\n    m.name.toLowerCase().includes(assigneeSearch.toLowerCase())\n  );\n  const filteredProjects = teamProjects.filter((p) =>\n    p.name.toLowerCase().includes(projectSearch.toLowerCase())\n  );\n  const filteredParents = parentResults.filter((i) =>\n    !parentSearch || i.title.toLowerCase().includes(parentSearch.toLowerCase()) || i.identifier.toLowerCase().includes(parentSearch.toLowerCase())\n  );\n\n  const statusConfig = STATUS_CONFIG[formData.status] || STATUS_CONFIG.backlog;\n\n  function formatDueDisplay(dateStr: string): string {\n    const d = new Date(dateStr + 'T00:00:00');\n    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });\n  }\n\n  return (\n    <div className=\"create-issue-form\" ref={formRef} data-testid=\"create-issue-form\">\n      {/* Team Selector */}\n      <div className=\"cif-field\" data-testid=\"create-issue-team-field\">\n        <label className=\"cif-label\">Team</label>\n        <div className=\"cif-dropdown-wrapper\">\n          <button\n            className=\"cif-select-btn\"\n            onClick={() => toggleDropdown('team')}\n            data-testid=\"create-issue-team-selector\"\n          >\n            <span>{selectedTeam ? selectedTeam.name : 'Select team'}</span>\n            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n          </button>\n          {openDropdown === 'team' && (\n            <div className=\"cif-dropdown\" data-testid=\"create-issue-team-dropdown\">\n              {teams.map((team) => (\n                <button\n                  key={team.id}\n                  className={`cif-dropdown-option ${formData.teamId === team.id ? 'cif-dropdown-option-active' : ''}`}\n                  onClick={() => handleTeamChange(team.id)}\n                  data-testid={`create-issue-team-option-${team.id}`}\n                >\n                  {team.name}\n                </button>\n              ))}\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* Title */}\n      <div className=\"cif-field\" data-testid=\"create-issue-title-field\">\n        <label className=\"cif-label\">Title</label>\n        <input\n          ref={titleRef}\n          type=\"text\"\n          className={`cif-input ${titleError ? 'cif-input-error' : ''}`}\n          placeholder=\"Issue title\"\n          value={formData.title}\n          onChange={(e) => updateField('title', e.target.value)}\n          data-testid=\"create-issue-title-input\"\n        />\n        {titleError && (\n          <span className=\"cif-error\" data-testid=\"create-issue-title-error\">{titleError}</span>\n        )}\n      </div>\n\n      {/* Description */}\n      <div className=\"cif-field\" data-testid=\"create-issue-description-field\">\n        <label className=\"cif-label\">Description</label>\n        <textarea\n          className=\"cif-textarea\"\n          placeholder=\"Add description... (supports markdown)\"\n          value={formData.description}\n          onChange={(e) => updateField('description', e.target.value)}\n          rows={3}\n          data-testid=\"create-issue-description-input\"\n        />\n      </div>\n\n      {/* Status & Priority row */}\n      <div className=\"cif-row\">\n        {/* Status */}\n        <div className=\"cif-field cif-field-half\" data-testid=\"create-issue-status-field\">\n          <label className=\"cif-label\">Status</label>\n          <div className=\"cif-dropdown-wrapper\">\n            <button\n              className=\"cif-select-btn\"\n              onClick={() => toggleDropdown('status')}\n              data-testid=\"create-issue-status-selector\"\n            >\n              <StatusIcon status={formData.status} color={statusConfig.color} />\n              <span>{statusConfig.label}</span>\n              <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n            </button>\n            {openDropdown === 'status' && (\n              <div className=\"cif-dropdown\" data-testid=\"create-issue-status-dropdown\">\n                {STATUS_ORDER.map((s) => {\n                  const cfg = STATUS_CONFIG[s];\n                  return (\n                    <button\n                      key={s}\n                      className={`cif-dropdown-option ${formData.status === s ? 'cif-dropdown-option-active' : ''}`}\n                      onClick={() => { updateField('status', s); setOpenDropdown(null); }}\n                      data-testid={`create-issue-status-option-${s}`}\n                    >\n                      <StatusIcon status={s} color={cfg.color} />\n                      <span>{cfg.label}</span>\n                    </button>\n                  );\n                })}\n              </div>\n            )}\n          </div>\n        </div>\n\n        {/* Priority */}\n        <div className=\"cif-field cif-field-half\" data-testid=\"create-issue-priority-field\">\n          <label className=\"cif-label\">Priority</label>\n          <div className=\"cif-dropdown-wrapper\">\n            <button\n              className=\"cif-select-btn\"\n              onClick={() => toggleDropdown('priority')}\n              data-testid=\"create-issue-priority-selector\"\n            >\n              <PriorityIcon priority={formData.priority} />\n              <span>{PRIORITY_LABELS[formData.priority] || 'No Priority'}</span>\n              <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n            </button>\n            {openDropdown === 'priority' && (\n              <div className=\"cif-dropdown\" data-testid=\"create-issue-priority-dropdown\">\n                {PRIORITY_ORDER.map((p) => (\n                  <button\n                    key={p}\n                    className={`cif-dropdown-option ${formData.priority === p ? 'cif-dropdown-option-active' : ''}`}\n                    onClick={() => { updateField('priority', p); setOpenDropdown(null); }}\n                    data-testid={`create-issue-priority-option-${p}`}\n                  >\n                    <PriorityIcon priority={p} />\n                    <span>{PRIORITY_LABELS[p]}</span>\n                  </button>\n                ))}\n              </div>\n            )}\n          </div>\n        </div>\n      </div>\n\n      {/* Assignee */}\n      <div className=\"cif-field\" data-testid=\"create-issue-assignee-field\">\n        <label className=\"cif-label\">Assignee</label>\n        <div className=\"cif-dropdown-wrapper\">\n          <button\n            className=\"cif-select-btn\"\n            onClick={() => toggleDropdown('assignee')}\n            data-testid=\"create-issue-assignee-selector\"\n          >\n            {selectedAssignee ? (\n              <>\n                <span className=\"cif-avatar\">{selectedAssignee.name.split(' ').map((n) => n[0]).join('').toUpperCase().slice(0, 2)}</span>\n                <span>{selectedAssignee.name}</span>\n              </>\n            ) : (\n              <span className=\"cif-placeholder\">No assignee</span>\n            )}\n            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n          </button>\n          {openDropdown === 'assignee' && (\n            <div className=\"cif-dropdown cif-dropdown-searchable\" data-testid=\"create-issue-assignee-dropdown\">\n              <input\n                className=\"cif-search-input\"\n                placeholder=\"Search members...\"\n                value={assigneeSearch}\n                onChange={(e) => setAssigneeSearch(e.target.value)}\n                autoFocus\n                data-testid=\"create-issue-assignee-search\"\n              />\n              <button\n                className=\"cif-dropdown-option\"\n                onClick={() => { updateField('assigneeId', null); setOpenDropdown(null); }}\n                data-testid=\"create-issue-assignee-option-none\"\n              >\n                <span className=\"cif-avatar cif-avatar-empty\">?</span>\n                <span>No assignee</span>\n              </button>\n              {filteredMembers.map((m) => (\n                <button\n                  key={m.id}\n                  className={`cif-dropdown-option ${formData.assigneeId === m.id ? 'cif-dropdown-option-active' : ''}`}\n                  onClick={() => { updateField('assigneeId', m.id); setOpenDropdown(null); }}\n                  data-testid={`create-issue-assignee-option-${m.id}`}\n                >\n                  <span className=\"cif-avatar\">{m.name.split(' ').map((n) => n[0]).join('').toUpperCase().slice(0, 2)}</span>\n                  <span>{m.name}</span>\n                </button>\n              ))}\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* Labels */}\n      <div className=\"cif-field\" data-testid=\"create-issue-labels-field\">\n        <label className=\"cif-label\">Labels</label>\n        {selectedLabels.length > 0 && (\n          <div className=\"cif-selected-labels\" data-testid=\"create-issue-selected-labels\">\n            {selectedLabels.map((label) => (\n              <span key={label.id} className=\"cif-label-badge\" style={{ borderColor: label.color }} data-testid={`create-issue-label-badge-${label.id}`}>\n                <span className=\"cif-label-dot\" style={{ backgroundColor: label.color }} />\n                {label.name}\n                <button\n                  className=\"cif-label-remove\"\n                  onClick={() => handleRemoveLabel(label.id)}\n                  data-testid={`create-issue-label-remove-${label.id}`}\n                >\n                  &times;\n                </button>\n              </span>\n            ))}\n          </div>\n        )}\n        <div className=\"cif-dropdown-wrapper\">\n          <button\n            className=\"cif-select-btn\"\n            onClick={() => toggleDropdown('labels')}\n            data-testid=\"create-issue-labels-selector\"\n          >\n            <span className=\"cif-placeholder\">{selectedLabels.length === 0 ? 'Select labels' : 'Add more labels'}</span>\n            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n          </button>\n          {openDropdown === 'labels' && (\n            <div className=\"cif-dropdown\" data-testid=\"create-issue-labels-dropdown\">\n              {labels.map((label) => (\n                <button\n                  key={label.id}\n                  className={`cif-dropdown-option ${formData.labelIds.includes(label.id) ? 'cif-dropdown-option-active' : ''}`}\n                  onClick={() => handleLabelToggle(label.id)}\n                  data-testid={`create-issue-label-option-${label.id}`}\n                >\n                  <span className=\"cif-label-dot\" style={{ backgroundColor: label.color }} />\n                  <span>{label.name}</span>\n                  {formData.labelIds.includes(label.id) && (\n                    <svg className=\"cif-check\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"20 6 9 17 4 12\" /></svg>\n                  )}\n                </button>\n              ))}\n              {labels.length === 0 && (\n                <div className=\"cif-dropdown-empty\">No labels available</div>\n              )}\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* Project */}\n      <div className=\"cif-field\" data-testid=\"create-issue-project-field\">\n        <label className=\"cif-label\">Project</label>\n        <div className=\"cif-dropdown-wrapper\">\n          <button\n            className=\"cif-select-btn\"\n            onClick={() => toggleDropdown('project')}\n            data-testid=\"create-issue-project-selector\"\n          >\n            <span className={selectedProject ? '' : 'cif-placeholder'}>\n              {selectedProject ? selectedProject.name : 'No project'}\n            </span>\n            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n          </button>\n          {openDropdown === 'project' && (\n            <div className=\"cif-dropdown cif-dropdown-searchable\" data-testid=\"create-issue-project-dropdown\">\n              <input\n                className=\"cif-search-input\"\n                placeholder=\"Search projects...\"\n                value={projectSearch}\n                onChange={(e) => setProjectSearch(e.target.value)}\n                autoFocus\n                data-testid=\"create-issue-project-search\"\n              />\n              <button\n                className=\"cif-dropdown-option\"\n                onClick={() => { updateField('projectId', null); setOpenDropdown(null); }}\n                data-testid=\"create-issue-project-option-none\"\n              >\n                <span>No project</span>\n              </button>\n              {filteredProjects.map((p) => (\n                <button\n                  key={p.id}\n                  className={`cif-dropdown-option ${formData.projectId === p.id ? 'cif-dropdown-option-active' : ''}`}\n                  onClick={() => { updateField('projectId', p.id); setOpenDropdown(null); }}\n                  data-testid={`create-issue-project-option-${p.id}`}\n                >\n                  <span>{p.name}</span>\n                </button>\n              ))}\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* Cycle */}\n      <div className=\"cif-field\" data-testid=\"create-issue-cycle-field\">\n        <label className=\"cif-label\">Cycle</label>\n        <div className=\"cif-dropdown-wrapper\">\n          <button\n            className=\"cif-select-btn\"\n            onClick={() => toggleDropdown('cycle')}\n            data-testid=\"create-issue-cycle-selector\"\n          >\n            <span className={selectedCycle ? '' : 'cif-placeholder'}>\n              {selectedCycle ? selectedCycle.name : 'No cycle'}\n            </span>\n            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n          </button>\n          {openDropdown === 'cycle' && (\n            <div className=\"cif-dropdown\" data-testid=\"create-issue-cycle-dropdown\">\n              <button\n                className=\"cif-dropdown-option\"\n                onClick={() => { updateField('cycleId', null); setOpenDropdown(null); }}\n                data-testid=\"create-issue-cycle-option-none\"\n              >\n                <span>No cycle</span>\n              </button>\n              {teamCycles.map((c) => {\n                const now = new Date();\n                const start = new Date(c.start_date);\n                const end = new Date(c.end_date);\n                const isActive = now >= start && now <= end;\n                return (\n                  <button\n                    key={c.id}\n                    className={`cif-dropdown-option ${formData.cycleId === c.id ? 'cif-dropdown-option-active' : ''}`}\n                    onClick={() => { updateField('cycleId', c.id); setOpenDropdown(null); }}\n                    data-testid={`create-issue-cycle-option-${c.id}`}\n                  >\n                    <span>{c.name}</span>\n                    {isActive && <span className=\"cif-active-badge\">Active</span>}\n                  </button>\n                );\n              })}\n              {teamCycles.length === 0 && (\n                <div className=\"cif-dropdown-empty\">No cycles available</div>\n              )}\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* Due Date */}\n      <div className=\"cif-field\" data-testid=\"create-issue-due-date-field\">\n        <label className=\"cif-label\">Due date</label>\n        <div className=\"cif-date-wrapper\">\n          <input\n            type=\"date\"\n            className=\"cif-date-input\"\n            value={formData.dueDate || ''}\n            onChange={(e) => updateField('dueDate', e.target.value || null)}\n            data-testid=\"create-issue-due-date-input\"\n          />\n          {formData.dueDate && (\n            <div className=\"cif-date-display\">\n              <span data-testid=\"create-issue-due-date-display\">{formatDueDisplay(formData.dueDate)}</span>\n              <button\n                className=\"cif-date-clear\"\n                onClick={() => updateField('dueDate', null)}\n                data-testid=\"create-issue-due-date-clear\"\n              >\n                &times;\n              </button>\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* Parent Issue */}\n      <div className=\"cif-field\" data-testid=\"create-issue-parent-field\">\n        <label className=\"cif-label\">Parent issue</label>\n        <div className=\"cif-dropdown-wrapper\">\n          <button\n            className=\"cif-select-btn\"\n            onClick={() => toggleDropdown('parent')}\n            data-testid=\"create-issue-parent-selector\"\n          >\n            <span className={selectedParent || formData.parentId ? '' : 'cif-placeholder'}>\n              {selectedParent ? `${selectedParent.identifier}: ${selectedParent.title}` : formData.parentId ? 'Loading...' : 'No parent issue'}\n            </span>\n            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n          </button>\n          {openDropdown === 'parent' && (\n            <div className=\"cif-dropdown cif-dropdown-searchable\" data-testid=\"create-issue-parent-dropdown\">\n              <input\n                className=\"cif-search-input\"\n                placeholder=\"Search issues...\"\n                value={parentSearch}\n                onChange={(e) => setParentSearch(e.target.value)}\n                autoFocus\n                data-testid=\"create-issue-parent-search\"\n              />\n              <button\n                className=\"cif-dropdown-option\"\n                onClick={() => { updateField('parentId', null); setOpenDropdown(null); }}\n                data-testid=\"create-issue-parent-option-none\"\n              >\n                <span>No parent issue</span>\n              </button>\n              {filteredParents.map((issue) => (\n                <button\n                  key={issue.id}\n                  className={`cif-dropdown-option ${formData.parentId === issue.id ? 'cif-dropdown-option-active' : ''}`}\n                  onClick={() => { updateField('parentId', issue.id); setOpenDropdown(null); }}\n                  data-testid={`create-issue-parent-option-${issue.id}`}\n                >\n                  <span className=\"cif-parent-identifier\">{issue.identifier}</span>\n                  <span>{issue.title}</span>\n                </button>\n              ))}\n              {filteredParents.length === 0 && parentSearch && (\n                <div className=\"cif-dropdown-empty\">No issues found</div>\n              )}\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n}\n","numLines":603,"startLine":1,"totalLines":603}}}
