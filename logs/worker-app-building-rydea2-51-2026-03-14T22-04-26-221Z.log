[2026-03-14T21:59:31.908Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01De4ywGDx1NmbKbVi2LkVt8","type":"tool_result","content":"     1→import { useState } from 'react';\n     2→import { useDispatch } from 'react-redux';\n     3→import type { AppDispatch } from '../store';\n     4→import type { ActivityEntry, Comment } from '../slices/issueDetailSlice';\n     5→import { addComment } from '../slices/issueDetailSlice';\n     6→import './ActivityComments.css';\n     7→\n     8→interface ActivityCommentsProps {\n     9→  issueId: string;\n    10→  activity: ActivityEntry[];\n    11→  comments: Comment[];\n    12→}\n    13→\n    14→function getInitials(name: string): string {\n    15→  return name\n    16→    .split(' ')\n    17→    .map((n) => n[0])\n    18→    .join('')\n    19→    .toUpperCase()\n    20→    .slice(0, 2);\n    21→}\n    22→\n    23→function formatRelativeTime(dateStr: string): string {\n    24→  const date = new Date(dateStr);\n    25→  const now = new Date();\n    26→  const diffMs = now.getTime() - date.getTime();\n    27→  const diffSecs = Math.floor(diffMs / 1000);\n    28→  const diffMins = Math.floor(diffSecs / 60);\n    29→  const diffHours = Math.floor(diffMins / 60);\n    30→  const diffDays = Math.floor(diffHours / 24);\n    31→\n    32→  if (diffSecs < 60) return 'just now';\n    33→  if (diffMins < 60) return `${diffMins}m ago`;\n    34→  if (diffHours < 24) return `${diffHours}h ago`;\n    35→  if (diffDays < 30) return `${diffDays}d ago`;\n    36→  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });\n    37→}\n    38→\n    39→export default function ActivityComments({ issueId, activity, comments }: ActivityCommentsProps) {\n    40→  const dispatch = useDispatch<AppDispatch>();\n    41→  const [activeTab, setActiveTab] = useState<'activity' | 'comments'>('activity');\n    42→  const [commentText, setCommentText] = useState('');\n    43→  const [submitting, setSubmitting] = useState(false);\n    44→\n    45→  async function handleSubmitComment() {\n    46→    if (!commentText.trim() || submitting) return;\n    47→    setSubmitting(true);\n    48→    await dispatch(addComment({ issueId, content: commentText.trim() }));\n    49→    setCommentText('');\n    50→    setSubmitting(false);\n    51→  }\n    52→\n    53→  function handleCommentKeyDown(e: React.KeyboardEvent) {\n    54→    if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) {\n    55→      e.preventDefault();\n    56→      handleSubmitComment();\n    57→    }\n    58→  }\n    59→\n    60→  return (\n    61→    <div className=\"activity-comments\" data-testid=\"activity-comments\">\n    62→      <div className=\"activity-comments-tabs\" data-testid=\"activity-comments-tabs\">\n    63→        <button\n    64→          className={`activity-comments-tab ${activeTab === 'activity' ? 'activity-comments-tab-active' : ''}`}\n    65→          onClick={() => setActiveTab('activity')}\n    66→          data-testid=\"activity-tab\"\n    67→        >\n    68→          Activity\n    69→        </button>\n    70→        <button\n    71→          className={`activity-comments-tab ${activeTab === 'comments' ? 'activity-comments-tab-active' : ''}`}\n    72→          onClick={() => setActiveTab('comments')}\n    73→          data-testid=\"comments-tab\"\n    74→        >\n    75→          Comments\n    76→        </button>\n    77→      </div>\n    78→\n    79→      <div className=\"activity-comments-content\" data-testid=\"activity-comments-content\">\n    80→        {activeTab === 'activity' ? (\n    81→          <div className=\"activity-list\" data-testid=\"activity-list\">\n    82→            {activity.length === 0 ? (\n    83→              <div className=\"activity-empty\" data-testid=\"activity-empty\">No activity yet</div>\n    84→            ) : (\n    85→              activity.map((entry) => (\n    86→                <div key={entry.id} className=\"activity-entry\" data-testid={`activity-entry-${entry.id}`}>\n    87→                  <div className=\"activity-avatar\">\n    88→                    {entry.memberName ? getInitials(entry.memberName) : '?'}\n    89→                  </div>\n    90→                  <div className=\"activity-info\">\n    91→                    <span className=\"activity-actor\">{entry.memberName || 'Unknown'}</span>\n    92→                    <span className=\"activity-action\">{entry.action}</span>\n    93→                    <span className=\"activity-time\">{formatRelativeTime(entry.createdAt)}</span>\n    94→                  </div>\n    95→                </div>\n    96→              ))\n    97→            )}\n    98→          </div>\n    99→        ) : (\n   100→          <div className=\"comments-list\" data-testid=\"comments-list\">\n   101→            {comments.length === 0 ? (\n   102→              <div className=\"comments-empty\" data-testid=\"comments-empty\">No comments yet</div>\n   103→            ) : (\n   104→              comments.map((comment) => (\n   105→                <div key={comment.id} className=\"comment-entry\" data-testid={`comment-entry-${comment.id}`}>\n   106→                  <div className=\"comment-avatar\">\n   107→                    {comment.memberName ? getInitials(comment.memberName) : '?'}\n   108→                  </div>\n   109→                  <div className=\"comment-body\">\n   110→                    <div className=\"comment-header\">\n   111→                      <span className=\"comment-author\">{comment.memberName || 'Unknown'}</span>\n   112→                      <span className=\"comment-time\">{formatRelativeTime(comment.createdAt)}</span>\n   113→                    </div>\n   114→                    <div className=\"comment-content\" data-testid={`comment-content-${comment.id}`}>\n   115→                      {comment.content}\n   116→                    </div>\n   117→                  </div>\n   118→                </div>\n   119→              ))\n   120→            )}\n   121→          </div>\n   122→        )}\n   123→      </div>\n   124→\n   125→      <div className=\"activity-comments-input\" data-testid=\"comment-input-section\">\n   126→        <textarea\n   127→          className=\"comment-textarea\"\n   128→          placeholder=\"Write a comment...\"\n   129→          value={commentText}\n   130→          onChange={(e) => setCommentText(e.target.value)}\n   131→          onKeyDown={handleCommentKeyDown}\n   132→          rows={2}\n   133→          data-testid=\"comment-input\"\n   134→        />\n   135→        <button\n   136→          className=\"comment-submit-btn\"\n   137→          onClick={handleSubmitComment}\n   138→          disabled={!commentText.trim() || submitting}\n   139→          data-testid=\"comment-submit-btn\"\n   140→        >\n   141→          Comment\n   142→        </button>\n   143→      </div>\n   144→    </div>\n   145→  );\n   146→}\n   147→"}]},"parent_tool_use_id":"toolu_01UFscE12onVg7LEgofmhPYT","session_id":"7b3a342c-e5c0-4c3a-aec1-6eee419ae688","uuid":"7670d7b5-f2ff-499a-86bf-4916c942222e"}
