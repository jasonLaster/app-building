m-dropdown-option:hover {\n  background-color: var(--color-bg-hover);\n  color: var(--color-text-primary);\n}\n\n.cpm-dropdown-option-active {\n  color: var(--color-text-primary);\n  background-color: rgba(94, 106, 210, 0.1);\n}\n\n.cpm-dropdown-empty {\n  padding: 8px 12px;\n  color: var(--color-text-tertiary);\n  font-size: 12px;\n}\n\n.cpm-avatar {\n  width: 20px;\n  height: 20px;\n  border-radius: 50%;\n  background-color: var(--color-accent);\n  color: #fff;\n  font-size: 9px;\n  font-weight: 600;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n\n.cpm-avatar-empty {\n  background-color: var(--color-border);\n  color: var(--color-text-tertiary);\n}\n\n.cpm-check {\n  margin-left: auto;\n  color: var(--color-accent);\n}\n\n.cpm-date-input {\n  padding: 8px 10px;\n  background-color: var(--color-bg-primary);\n  border: 1px solid var(--color-border);\n  border-radius: 6px;\n  color: var(--color-text-primary);\n  font-size: 13px;\n  outline: none;\n  transition: border-color 150ms ease;\n  color-scheme: dark;\n}\n\n.cpm-date-input:focus {\n  border-color: var(--color-accent);\n}\n\n.cpm-selected-teams {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  margin-bottom: 4px;\n}\n\n.cpm-team-chip {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  padding: 2px 8px;\n  background-color: rgba(94, 106, 210, 0.15);\n  color: var(--color-accent);\n  border-radius: 4px;\n  font-size: 12px;\n  font-weight: 500;\n}\n\n.cpm-team-chip-remove {\n  background: none;\n  border: none;\n  color: var(--color-accent);\n  cursor: pointer;\n  font-size: 14px;\n  padding: 0 2px;\n  line-height: 1;\n  opacity: 0.7;\n}\n\n.cpm-team-chip-remove:hover {\n  opacity: 1;\n}\n\n.cpm-footer {\n  display: flex;\n  justify-content: flex-end;\n  gap: 8px;\n  padding: 0 24px 20px;\n}\n\n.cpm-cancel-btn {\n  padding: 6px 14px;\n  border: 1px solid var(--color-border);\n  border-radius: 6px;\n  background: none;\n  color: var(--color-text-secondary);\n  font-size: 13px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: background-color 150ms ease, color 150ms ease;\n}\n\n.cpm-cancel-btn:hover {\n  background-color: var(--color-bg-hover);\n  color: var(--color-text-primary);\n}\n\n.cpm-submit-btn {\n  padding: 6px 14px;\n  border: none;\n  border-radius: 6px;\n  background-color: var(--color-accent);\n  color: #fff;\n  font-size: 13px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: opacity 150ms ease;\n}\n\n.cpm-submit-btn:hover {\n  opacity: 0.9;\n}\n\n.cpm-submit-btn:disabled {\n  opacity: 0.6;\n  cursor: not-allowed;\n}\n","numLines":310,"startLine":1,"totalLines":310}}}
