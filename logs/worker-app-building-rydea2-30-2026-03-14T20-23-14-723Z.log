               </span>\n              ))}\n            </div>\n            <div className=\"member-row-actions\">\n              <MemberActions\n                member={member}\n                isSelf={isSelf}\n                isLastAdmin={isLastAdmin}\n                onChangeRole={onChangeRole}\n                onRemove={onRemove}\n              />\n            </div>\n          </div>\n        );\n      })}\n    </div>\n  );\n}\n","structuredPatch":[],"originalFile":null}}
