  });\n   111→    if (!response.ok) {\n   112→      return rejectWithValue('Failed to update status');\n   113→    }\n   114→    const data = await response.json();\n   115→    return { issueId, status: data.issue.status as string };\n   116→  }\n   117→);\n   118→\n   119→const issuesSlice = createSlice({\n   120→  name: 'issues',\n   121→  initialState,\n   122→  reducers: {},\n   123→  extraReducers: (builder) => {\n   124→    builder\n   125→      .addCase(fetchMyIssues.pending, (state) => {\n   126→        if (state.myIssues.length === 0) {\n   127→          state.loading = true;\n   128→        }\n   129→        state.error = null;\n   130→      })\n   131→      .addCase(fetchMyIssues.fulfilled, (state, action) => {\n   132→        state.loading = false;\n   133→        state.myIssues = action.payload;\n   134→      })\n   135→      .addCase(fetchMyIssues.rejected, (state, action) => {\n   136→        state.loading = false;\n   137→        state.error = action.payload as string;\n   138→      })\n   139→      .addCase(createIssue.fulfilled, (state, action) => {\n   140→        state.myIssues.unshift(action.payload);\n   141→      })\n   142→      .addCase(updateIssueStatus.fulfilled, (state, action) => {\n   143→        const { issueId, status } = action.payload;\n   144→        const issue = state.myIssues.find((i) => i.id === issueId);\n   145→        if (issue) {\n   146→          issue.status = status;\n   147→        }\n   148→      });\n   149→  },\n   150→});\n   151→\n   152→export default issuesSlice.reducer;\n   153→"}]},"parent_tool_use_id":"toolu_01Lt4kmTNVJcWUKGy4MGpym4","session_id":"0cb8a77f-e3f9-4be7-8a8f-dba07d05e94d","uuid":"9a44bc82-22fb-424b-8491-d94a9102edac"}
