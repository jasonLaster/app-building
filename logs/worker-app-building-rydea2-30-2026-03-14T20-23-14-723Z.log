ject-teams-selector\"\n   309→              >\n   310→                <span className=\"cpm-placeholder\">\n   311→                  {selectedTeams.length === 0 ? 'Select teams' : 'Add more teams'}\n   312→                </span>\n   313→                <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n   314→              </button>\n   315→              {openDropdown === 'teams' && (\n   316→                <div className=\"cpm-dropdown\" data-testid=\"create-project-teams-dropdown\">\n   317→                  {teams.map((t) => {\n   318→                    const checked = formData.teamIds.includes(t.id);\n   319→                    return (\n   320→                      <button\n   321→                        key={t.id}\n   322→                        className={`cpm-dropdown-option ${checked ? 'cpm-dropdown-option-active' : ''}`}\n   323→                        onClick={() => toggleTeam(t.id)}\n   324→                        data-testid={`create-project-team-option-${t.id}`}\n   325→                      >\n   326→                        <span>{t.name}</span>\n   327→                        {checked && (\n   328→                          <svg className=\"cpm-check\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"20 6 9 17 4 12\" /></svg>\n   329→                        )}\n   330→                      </button>\n   331→                    );\n   332→                  })}\n   333→                  {teams.length === 0 && (\n   334→                    <div className=\"cpm-dropdown-empty\">No teams available</div>\n   335→                  )}\n   336→                </div>\n   337→              )}\n   338→            </div>\n   339→          </div>\n   340→        </div>\n   341→\n   342→        <div className=\"cpm-footer\">\n   343→          <button\n   344→            className=\"cpm-