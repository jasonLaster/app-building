[2026-03-14T21:05:37.548Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FoTjqonHQA1JTrj8c6rTtz","type":"tool_result","content":"     1→import { useEffect } from 'react';\n     2→import { Routes, Route, Navigate, useLocation } from 'react-router-dom';\n     3→import { useSelector, useDispatch } from 'react-redux';\n     4→import type { RootState, AppDispatch } from './store';\n     5→import { fetchCurrentUser } from './slices/authSlice';\n     6→import { fetchTeams } from './slices/teamsSlice';\n     7→import { Sidebar } from './components/Sidebar';\n     8→import { KeyboardShortcuts } from './components/KeyboardShortcuts';\n     9→import { CreateIssueModal } from './components/CreateIssueModal';\n    10→import Login from './pages/Login';\n    11→import SignUp from './pages/SignUp';\n    12→import MyIssues from './pages/MyIssues';\n    13→import Inbox from './pages/Inbox';\n    14→import TeamIssues from './pages/TeamIssues';\n    15→import IssueDetail from './pages/IssueDetail';\n    16→import ActiveCycle from './pages/ActiveCycle';\n    17→import Projects from './pages/Projects';\n    18→import ProjectDetail from './pages/ProjectDetail';\n    19→import Members from './pages/Members';\n    20→import Teams from './pages/Teams';\n    21→import Labels from './pages/Labels';\n    22→import Settings from './pages/Settings';\n    23→\n    24→function AuthenticatedLayout() {\n    25→  const dispatch = useDispatch<AppDispatch>();\n    26→\n    27→  useEffect(() => {\n    28→    dispatch(fetchTeams());\n    29→  }, [dispatch]);\n    30→\n    31→  return (\n    32→    <div className=\"app-layout\" data-testid=\"app-layout\">\n    33→      <Sidebar />\n    34→      <main className=\"app-main\">\n    35→        <Routes>\n    36→          <Route path=\"/my-issues\" element={<MyIssues />} />\n    37→          <Route path=\"/inbox\" element={<Inbox />} />\n    38→          <Route path=\"/team/:teamId/issues\" element={<TeamIssues />} />\n    39→          <Route path=\"/team/:teamId/cycles\" element={<ActiveCycle />} />\n    40→          <Route path=\"/issue/:issueId\" element={<IssueDetail />} />\n    41→          <Route path=\"/projects\" element={<Projects />} />\n    42→          <Route path=\"/project/:projectId\" element={<ProjectDetail />} />\n    43→          <Route path=\"/settings/members\" element={<Members />} />\n    44→          <Route path=\"/settings/teams\" element={<Teams />} />\n    45→          <Route path=\"/settings/labels\" element={<Labels />} />\n    46→          <Route path=\"/settings\" element={<Settings />} />\n    47→          <Route path=\"*\" element={<Navigate to=\"/my-issues\" replace />} />\n    48→        </Routes>\n    49→      </main>\n    50→      <KeyboardShortcuts />\n    51→      <CreateIssueModal />\n    52→    </div>\n    53→  );\n    54→}\n    55→\n    56→export default function App() {\n    57→  const dispatch = useDispatch<AppDispatch>();\n    58→  const { token, user } = useSelector((state: RootState) => state.auth);\n    59→  const location = useLocation();\n    60→\n    61→  useEffect(() => {\n    62→    if (token) {\n    63→      dispatch(fetchCurrentUser());\n    64→    }\n    65→  }, [dispatch, token]);\n    66→\n    67→  const isAuthPage = location.pathname === '/login' || location.pathname === '/signup';\n    68→\n    69→  if (!token && !isAuthPage) {\n    70→    return <Navigate to=\"/login\" replace />;\n    71→  }\n    72→\n    73→  if (token && !user) {\n    74→    return (\n    75→      <div className=\"app-loading\" data-testid=\"app-loading\">\n    76→        <div className=\"loading-spinner\" />\n    77→      </div>\n    78→    );\n    79→  }\n    80→\n    81→  if (token && user && isAuthPage) {\n    82→    return <Navigate to=\"/my-issues\" replace />;\n    83→  }\n    84→\n    85→  return (\n    86→    <Routes>\n    87→      <Route path=\"/login\" element={<Login />} />\n    88→      <Route path=\"/signup\" element={<SignUp />} />\n    89→      <Route path=\"/*\" element={<AuthenticatedLayout />} />\n    90→    </Routes>\n    91→  );\n    92→}\n    93→"}]},"parent_tool_use_id":"toolu_012RDVYr85msVNgfPCrKXKhx","session_id":"bba55255-5906-4397-88b6-4f0dfb6b6368","uuid":"b3cb9204-4812-4a3f-bdca-e19f9eee8829"}
