[2026-03-14T21:05:41.008Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016DfFJQQdiC5kViJKk1D4kp","type":"tool_result","content":"     1→import { execSync, spawn } from 'child_process'\n     2→import { writeFileSync, readFileSync, mkdirSync, readdirSync, existsSync } from 'fs'\n     3→import { join } from 'path'\n     4→import { initSchema } from './schema.js'\n     5→import { seedDatabase, resetDatabase } from './seed-db.js'\n     6→\n     7→const appDir = join(import.meta.dirname, '..')\n     8→const logsDir = join(appDir, 'logs')\n     9→\n    10→function getEnvVar(name: string): string {\n    11→  const val = process.env[name]\n    12→  if (!val) {\n    13→    console.error(`Missing required environment variable: ${name}`)\n    14→    process.exit(1)\n    15→  }\n    16→  return val\n    17→}\n    18→\n    19→function loadDotEnv(): void {\n    20→  const envPath = join(appDir, '.env')\n    21→  if (!existsSync(envPath)) return\n    22→  const lines = readFileSync(envPath, 'utf-8').split('\\n')\n    23→  for (const line of lines) {\n    24→    const trimmed = line.trim()\n    25→    if (!trimmed || trimmed.startsWith('#')) continue\n    26→    const eqIdx = trimmed.indexOf('=')\n    27→    if (eqIdx === -1) continue\n    28→    const key = trimmed.slice(0, eqIdx).trim()\n    29→    const value = trimmed.slice(eqIdx + 1).trim().replace(/^[\"']|[\"']$/g, '')\n    30→    if (!process.env[key]) {\n    31→      process.env[key] = value\n    32→    }\n    33→  }\n    34→}\n    35→\n    36→function getNextLogNumber(): number {\n    37→  mkdirSync(logsDir, { recursive: true })\n    38→  const existing = readdirSync(logsDir)\n    39→    .filter(f => /^test-run-\\d+\\.log$/.test(f))\n    40→    .map(f => parseInt(f.match(/test-run-(\\d+)\\.log/)![1]!, 10))\n    41→  return existing.length > 0 ? Math.max(...existing) + 1 : 1\n    42→}\n    43→\n    44→function killStaleProcesses(): void {\n    45→  try { execSync(\"pkill -f 'netlify dev' || true\", { stdio: 'ignore' }) } catch { /* ignore */ }\n    46→  try { execSync(\"pkill -f 'vite' || true\", { stdio: 'ignore' }) } catch { /* ignore */ }\n    47→  execSync('sleep 1', { stdio: 'ignore' })\n    48→}\n    49→\n    50→async function neonApi(method: string, path: string, body?: unknown): Promise<unknown> {\n    51→  const apiKey = getEnvVar('NEON_API_KEY')\n    52→  const res = await fetch(`https://console.neon.tech/api/v2${path}`, {\n    53→    method,\n    54→    headers: {\n    55→      Authorization: `Bearer ${apiKey}`,\n    56→      'Content-Type': 'application/json',\n    57→      Accept: 'application/json',\n    58→    },\n    59→    body: body ? JSON.stringify(body) : undefined,\n    60→  })\n    61→  if (!res.ok) {\n    62→    const text = await res.text()\n    63→    throw new Error(`Neon API ${method} ${path} failed (${res.status}): ${text}`)\n    64→  }\n    65→  const ct = res.headers.get('content-type')\n    66→  if (ct?.includes('application/json')) return res.json()\n    67→  return null\n    68→}\n    69→\n    70→interface NeonBranch { id: string; name: string }\n    71→interface NeonBranchListResponse { branches: NeonBranch[] }\n    72→interface NeonEndpoint { host: string }\n    73→interface NeonEndpointsResponse { endpoints: NeonEndpoint[] }\n    74→interface NeonBranchCreateResponse { branch: NeonBranch; endpoints: NeonEndpoint[] }\n    75→\n    76→async function cleanupStaleBranches(projectId: string): Promise<void> {\n    77→  const data = await neonApi('GET', `/projects/${projectId}/branches`) as NeonBranchListResponse\n    78→  const stale = data.branches.filter(b => b.name.startsWith('test-run-'))\n    79→  for (const branch of stale) {\n    80→    try { await neonApi('DELETE', `/projects/${projectId}/branches/${branch.id}`) } catch { /* best effort */ }\n    81→  }\n    82→}\n    83→\n    84→async function createEphemeralBranch(projectId: string, branchName: string): Promise<string> {\n    85→  const data = await neonApi('POST', `/projects/${projectId}/branches`, {\n    86→    branch: { name: branchName },\n    87→    endpoints: [{ type: 'read_write' }],\n    88→  }) as NeonBranchCreateResponse\n    89→\n    90→  let host = data.endpoints[0]?.host\n    91→  if (!host) {\n    92→    const epData = await neonApi('GET', `/projects/${projectId}/branches/${data.branch.id}/endpoints`) as NeonEndpointsResponse\n    93→    host = epData.endpoints[0]?.host\n    94→    if (!host) throw new Error('No endpoint created for ephemeral branch')\n    95→  }\n    96→  const mainDbUrl = getEnvVar('DATABASE_URL')\n    97→  const url = new URL(mainDbUrl)\n    98→  url.hostname = host\n    99→  return url.toString()\n   100→}\n   101→\n   102→async function deleteBranch(projectId: string, branchName: string): Promise<void> {\n   103→  const data = await neonApi('GET', `/projects/${projectId}/branches`) as NeonBranchListResponse\n   104→  const branch = data.branches.find(b => b.name === branchName)\n   105→  if (branch) {\n   106→    await neonApi('DELETE', `/projects/${projectId}/branches/${branch.id}`)\n   107→  }\n   108→}\n   109→\n   110→interface RecordingEntry {\n   111→  id?: string; kind: string; metadata?: { test?: { result?: string; title?: string }; uri?: string }; duration?: number\n   112→}\n   113→interface ParsedRecording { id: string; testResult: string; testTitle: string; specFile: string; duration: number }\n   114→\n   115→function parseRecordingsLog(): ParsedRecording[] {\n   116→  const logPath = join(process.env.HOME || '~', '.replay', 'recordings.log')\n   117→  if (!existsSync(logPath)) return []\n   118→  const content = readFileSync(logPath, 'utf-8')\n   119→  const lines = content.split('\\n').filter(l => l.trim())\n   120→  const recordings = new Map<string, { id: string; duration: number }>()\n   121→  const metadata = new Map<string, { testResult: string; testTitle: string; specFile: string }>()\n   122→  for (const line of lines) {\n   123→    try {\n   124→      const entry = JSON.parse(line) as RecordingEntry\n   125→      if (entry.kind === 'createRecording' && entry.id) recordings.set(entry.id, { id: entry.id, duration: 0 })\n   126→      if (entry.kind === 'writeFinished' && entry.id) {\n   127→        const rec = recordings.get(entry.id)\n   128→        if (rec && entry.duration) rec.duration = entry.duration\n   129→      }\n   130→      if (entry.kind === 'addMetadata' && entry.id && entry.metadata?.test) {\n   131→        metadata.set(entry.id, {\n   132→          testResult: entry.metadata.test.result || 'unknown',\n   133→          testTitle: entry.metadata.test.title || '',\n   134→          specFile: entry.metadata.uri || '',\n   135→        })\n   136→      }\n   137→    } catch { /* skip */ }\n   138→  }\n   139→  const results: ParsedRecording[] = []\n   140→  for (const [id, rec] of recordings) {\n   141→    const meta = metadata.get(id)\n   142→    if (meta) results.push({ id, ...meta, duration: rec.duration })\n   143→  }\n   144→  return results\n   145→}\n   146→\n   147→async function main(): Promise<void> {\n   148→  loadDotEnv()\n   149→  const testFile = process.argv[2]\n   150→  if (!testFile) { console.error('Usage: npm run test <testFile>'); process.exit(1) }\n   151→\n   152→  const projectId = getEnvVar('NEON_PROJECT_ID')\n   153→  getEnvVar('DATABASE_URL')\n   154→\n   155→  const logNum = getNextLogNumber()\n   156→  const logFile = join(logsDir, `test-run-${logNum}.log`)\n   157→  const branchName = `test-run-${Date.now()}`\n   158→  let playwrightExitCode = 1\n   159→  let ephemeralDbUrl = ''\n   160→\n   161→  killStaleProcesses()\n   162→  await cleanupStaleBranches(projectId)\n   163→\n   164→  try {\n   165→    ephemeralDbUrl = await createEphemeralBranch(projectId, branchName)\n   166→  } catch (err) {\n   167→    console.error(`Failed to create ephemeral branch: ${err}`)\n   168→    process.exit(1)\n   169→  }\n   170→\n   171→  try {\n   172→    await initSchema(ephemeralDbUrl)\n   173→    await seedDatabase(ephemeralDbUrl)\n   174→\n   175→    const netlifyDev = spawn('npx', ['netlify', 'dev', '--port', '8888', '--functions', './netlify/functions'], {\n   176→      cwd: appDir,\n   177→      env: { ...process.env, DATABASE_URL: ephemeralDbUrl },\n   178→      stdio: ['ignore', 'pipe', 'pipe'],\n   179→      detached: true,\n   180→    })\n   181→\n   182→    await new Promise<void>((resolve, reject) => {\n   183→      const timeout = setTimeout(() => reject(new Error('netlify dev failed to start within 60s')), 60000)\n   184→      let output = ''\n   185→      const check = (data: Buffer) => {\n   186→        output += data.toString()\n   187→        if (output.includes('Server ready') || output.includes('ready on') || output.includes('localhost:8888')) {\n   188→          clearTimeout(timeout); resolve()\n   189→        }\n   190→      }\n   191→      netlifyDev.stdout?.on('data', check)\n   192→      netlifyDev.stderr?.on('data', check)\n   193→      netlifyDev.on('error', (err) => { clearTimeout(timeout); reject(err) })\n   194→      netlifyDev.on('exit', (code) => {\n   195→        if (code !== null && code !== 0) { clearTimeout(timeout); reject(new Error(`netlify dev exited ${code}\\n${output}`)) }\n   196→      })\n   197→    })\n   198→\n   199→    try { execSync('npx replayio remove --all', { cwd: appDir, stdio: 'ignore' }) } catch { /* ignore */ }\n   200→\n   201→    await resetDatabase(ephemeralDbUrl)\n   202→\n   203→    try {\n   204→      const pwOutput = execSync(`npx playwright test ${testFile} --retries 0 --workers 1`, {\n   205→        cwd: appDir, encoding: 'utf-8', stdio: ['ignore', 'pipe', 'pipe'],\n   206→        env: { ...process.env, DATABASE_URL: ephemeralDbUrl, TEST_DATABASE_URL: ephemeralDbUrl, BASE_URL: 'http://localhost:8888' },\n   207→        timeout: 300000,\n   208→      })\n   209→      writeFileSync(logFile, pwOutput)\n   210→      playwrightExitCode = 0\n   211→    } catch (e: unknown) {\n   212→      const err = e as { stdout?: string; stderr?: string; status?: number }\n   213→      writeFileSync(logFile, (err.stdout || '') + '\\n' + (err.stderr || ''))\n   214→      playwrightExitCode = err.status || 1\n   215→    }\n   216→\n   217→    let passed = 0, failed = 0, skipped = 0\n   218→    const resultsPath = join(appDir, 'test-results', 'results.json')\n   219→    if (existsSync(resultsPath)) {\n   220→      try {\n   221→        const rj = JSON.parse(readFileSync(resultsPath, 'utf-8'))\n   222→        for (const suite of rj.suites || []) {\n   223→          for (const spec of suite.specs || []) {\n   224→            for (const test of spec.tests || []) {\n   225→              if (test.status === 'expected' || test.status === 'passed') passed++\n   226→              else if (test.status === 'unexpected' || test.status === 'failed') failed++\n   227→              else if (test.status === 'skipped') skipped++\n   228→            }\n   229→          }\n   230→        }\n   231→      } catch { /* ignore */ }\n   232→    }\n   233→\n   234→    let uploadedId = ''\n   235→    if (playwrightExitCode !== 0) {\n   236→      const recs = parseRecordingsLog()\n   237→      if (recs.length > 0) {\n   238→        let block = '\\n=== REPLAY RECORDINGS METADATA ===\\n'\n   239→        for (const r of recs) block += JSON.stringify({ id: r.id, testResult: r.testResult, testTitle: r.testTitle, specFile: r.specFile }) + '\\n'\n   240→        block += '=== END REPLAY RECORDINGS METADATA ===\\n'\n   241→        writeFileSync(logFile, readFileSync(logFile, 'utf-8') + block)\n   242→      }\n   243→      const failedRecs = recs.filter(r => r.testResult === 'failed' || r.testResult === 'timedOut').sort((a, b) => b.duration - a.duration)\n   244→      if (failedRecs[0]) {\n   245→        try {\n   246→          execSync(`npx replayio upload ${failedRecs[0].id}`, { cwd: appDir, encoding: 'utf-8', stdio: 'pipe', timeout: 120000 })\n   247→          uploadedId = failedRecs[0].id\n   248→          writeFileSync(logFile, readFileSync(logFile, 'utf-8') + `\\nREPLAY UPLOADED: ${uploadedId}\\n`)\n   249→        } catch (e: unknown) {\n   250→          const err = e as { status?: number }\n   251→          writeFileSync(logFile, readFileSync(logFile, 'utf-8') + `\\nREPLAY UPLOAD FAILED (exit code ${err.status || 'unknown'})\\n`)\n   252→        }\n   253→      }\n   254→    }\n   255→\n   256→    try { if (netlifyDev.pid) process.kill(-netlifyDev.pid, 'SIGTERM') } catch { /* ignore */ }\n   257→\n   258→    const parts: string[] = []\n   259→    if (passed > 0) parts.push(`${passed} passed`)\n   260→    if (failed > 0) parts.push(`${failed} failed`)\n   261→    if (skipped > 0) parts.push(`${skipped} skipped`)\n   262→    let summary = parts.length > 0 ? parts.join(', ') : (playwrightExitCode === 0 ? 'all passed' : 'tests failed')\n   263→    if (uploadedId) summary += ` (recording: ${uploadedId})`\n   264→    if (playwrightExitCode !== 0) summary += ` — see logs/test-run-${logNum}.log`\n   265→    console.log(summary)\n   266→\n   267→  } finally {\n   268→    try { await deleteBranch(projectId, branchName) } catch { /* ignore */ }\n   269→    try { execSync('npx replayio remove --all', { cwd: appDir, stdio: 'ignore' }) } catch { /* ignore */ }\n   270→    killStaleProcesses()\n   271→  }\n   272→\n   273→  process.exit(playwrightExitCode)\n   274→}\n   275→\n   276→main()\n   277→"}]},"parent_tool_use_id":"toolu_012RDVYr85msVNgfPCrKXKhx","session_id":"bba55255-5906-4397-88b6-4f0dfb6b6368","uuid":"19968f31-981b-4061-96e7-0c02f9308452"}
