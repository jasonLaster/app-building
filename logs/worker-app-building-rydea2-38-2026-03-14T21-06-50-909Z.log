[2026-03-14T21:05:31.471Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FGHbHRLPn1HAm9skQZpXKP","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test';\n     2→\n     3→// Helper to create a test user via signup API\n     4→async function createTestUser(baseURL: string, name: string, email: string, password: string) {\n     5→  const response = await fetch(`${baseURL}/api/signup`, {\n     6→    method: 'POST',\n     7→    headers: { 'Content-Type': 'application/json' },\n     8→    body: JSON.stringify({ name, email, password }),\n     9→  });\n    10→  return response.json();\n    11→}\n    12→\n    13→// Helper to delete all sessions and members created by tests\n    14→async function cleanupTestUsers(baseURL: string) {\n    15→  // We rely on the test script's between-test DB reset (truncate + re-seed)\n    16→  // No additional cleanup needed since seed data is restored each test\n    17→}\n    18→\n    19→test.describe('LoginForm', () => {\n    20→  test('Login form renders with email and password fields', async ({ page }) => {\n    21→    await page.goto('/login');\n    22→\n    23→    // Verify the login form is visible\n    24→    await expect(page.getByTestId('login-form')).toBeVisible({ timeout: 30000 });\n    25→\n    26→    // Verify email input\n    27→    await expect(page.getByTestId('login-email-input')).toBeVisible();\n    28→\n    29→    // Verify password input\n    30→    await expect(page.getByTestId('login-password-input')).toBeVisible();\n    31→\n    32→    // Verify Sign in button\n    33→    await expect(page.getByTestId('login-submit-button')).toBeVisible();\n    34→    await expect(page.getByTestId('login-submit-button')).toHaveText('Sign in');\n    35→\n    36→    // Verify Sign up link\n    37→    await expect(page.getByTestId('login-signup-link')).toBeVisible();\n    38→    await expect(page.getByTestId('login-signup-link')).toHaveText('Sign up');\n    39→  });\n    40→\n    41→  test('Successful login with valid credentials', async ({ page, baseURL }) => {\n    42→    test.slow();\n    43→\n    44→    // Create a test user via API\n    45→    const email = `user-${Date.now()}@test.com`;\n    46→    const password = 'password123';\n    47→    await createTestUser(baseURL!, 'Test User', email, password);\n    48→\n    49→    await page.goto('/login');\n    50→    await expect(page.getByTestId('login-form')).toBeVisible({ timeout: 30000 });\n    51→\n    52→    // Fill in credentials\n    53→    await page.getByTestId('login-email-input').fill(email);\n    54→    await page.getByTestId('login-password-input').fill(password);\n    55→    await page.getByTestId('login-submit-button').click();\n    56→\n    57→    // Verify redirect to /my-issues\n    58→    await expect(page).toHaveURL(/\\/my-issues/, { timeout: 30000 });\n    59→\n    60→    // Verify session token in localStorage\n    61→    const token = await page.evaluate(() => localStorage.getItem('session_token'));\n    62→    expect(token).toBeTruthy();\n    63→\n    64→    // Verify sidebar is visible (authenticated layout)\n    65→    await expect(page.getByTestId('app-layout')).toBeVisible({ timeout: 30000 });\n    66→  });\n    67→\n    68→  test('Login fails with invalid email', async ({ page }) => {\n    69→    await page.goto('/login');\n    70→    await expect(page.getByTestId('login-form')).toBeVisible({ timeout: 30000 });\n    71→\n    72→    // Enter non-existent email\n    73→    await page.getByTestId('login-email-input').fill('nonexistent@test.com');\n    74→    await page.getByTestId('login-password-input').fill('password123');\n    75→    await page.getByTestId('login-submit-button').click();\n    76→\n    77→    // Verify error message\n    78→    await expect(page.getByTestId('login-error')).toBeVisible({ timeout: 30000 });\n    79→    await expect(page.getByTestId('login-error')).toContainText('Invalid email or password');\n    80→\n    81→    // Verify still on login page\n    82→    await expect(page).toHaveURL(/\\/login/);\n    83→\n    84→    // Verify no session token\n    85→    const token = await page.evaluate(() => localStorage.getItem('session_token'));\n    86→    expect(token).toBeFalsy();\n    87→  });\n    88→\n    89→  test('Login fails with incorrect password', async ({ page, baseURL }) => {\n    90→    // Use seeded user alice@acme.com\n    91→    await page.goto('/login');\n    92→    await expect(page.getByTestId('login-form')).toBeVisible({ timeout: 30000 });\n    93→\n    94→    await page.getByTestId('login-email-input').fill('alice@acme.com');\n    95→    await page.getByTestId('login-password-input').fill('wrongpassword');\n    96→    await page.getByTestId('login-submit-button').click();\n    97→\n    98→    // Verify error message\n    99→    await expect(page.getByTestId('login-error')).toBeVisible({ timeout: 30000 });\n   100→    await expect(page.getByTestId('login-error')).toContainText('Invalid email or password');\n   101→\n   102→    // Verify still on login page\n   103→    await expect(page).toHaveURL(/\\/login/);\n   104→  });\n   105→\n   106→  test('Login form validates required fields', async ({ page }) => {\n   107→    await page.goto('/login');\n   108→    await expect(page.getByTestId('login-form')).toBeVisible({ timeout: 30000 });\n   109→\n   110→    // Click sign in without entering anything\n   111→    await page.getByTestId('login-submit-button').click();\n   112→\n   113→    // Verify validation errors for both fields\n   114→    await expect(page.getByTestId('login-email-error')).toBeVisible({ timeout: 10000 });\n   115→    await expect(page.getByTestId('login-email-error')).toContainText('required');\n   116→\n   117→    await expect(page.getByTestId('login-password-error')).toBeVisible();\n   118→    await expect(page.getByTestId('login-password-error')).toContainText('required');\n   119→  });\n   120→\n   121→  test('Login form validates email format', async ({ page }) => {\n   122→    await page.goto('/login');\n   123→    await expect(page.getByTestId('login-form')).toBeVisible({ timeout: 30000 });\n   124→\n   125→    // Enter invalid email format\n   126→    await page.getByTestId('login-email-input').fill('notanemail');\n   127→    await page.getByTestId('login-submit-button').click();\n   128→\n   129→    // Verify email format validation error\n   130→    await expect(page.getByTestId('login-email-error')).toBeVisible({ timeout: 10000 });\n   131→    await expect(page.getByTestId('login-email-error')).toContainText('valid email');\n   132→  });\n   133→\n   134→  test('Navigate to sign up page from login', async ({ page }) => {\n   135→    await page.goto('/login');\n   136→    await expect(page.getByTestId('login-form')).toBeVisible({ timeout: 30000 });\n   137→\n   138→    // Click the sign up link\n   139→    await page.getByTestId('login-signup-link').click();\n   140→\n   141→    // Verify navigation to /signup\n   142→    await expect(page).toHaveURL(/\\/signup/, { timeout: 30000 });\n   143→\n   144→    // Verify the signup page content is shown\n   145→    await expect(page.getByTestId('signup-page')).toBeVisible({ timeout: 30000 });\n   146→  });\n   147→\n   148→  test('Password field masks input', async ({ page }) => {\n   149→    await page.goto('/login');\n   150→    await expect(page.getByTestId('login-form')).toBeVisible({ timeout: 30000 });\n   151→\n   152→    const passwordInput = page.getByTestId('login-password-input');\n   153→\n   154→    // Verify the field type is \"password\" (masks input)\n   155→    await expect(passwordInput).toHaveAttribute('type', 'password');\n   156→\n   157→    // Type something to confirm it accepts input while masked\n   158→    await passwordInput.fill('secretpassword');\n   159→    await expect(passwordInput).toHaveValue('secretpassword');\n   160→  });\n   161→\n   162→  test('Login form can be submitted via Enter key', async ({ page, baseURL }) => {\n   163→    test.slow();\n   164→\n   165→    // Create a test user via API\n   166→    const email = `enterkey-${Date.now()}@test.com`;\n   167→    const password = 'password123';\n   168→    await createTestUser(baseURL!, 'Enter Key User', email, password);\n   169→\n   170→    await page.goto('/login');\n   171→    await expect(page.getByTestId('login-form')).toBeVisible({ timeout: 30000 });\n   172→\n   173→    // Fill in credentials\n   174→    await page.getByTestId('login-email-input').fill(email);\n   175→    await page.getByTestId('login-password-input').fill(password);\n   176→\n   177→    // Press Enter on the password field\n   178→    await page.getByTestId('login-password-input').press('Enter');\n   179→\n   180→    // Verify redirect to /my-issues (same as clicking Sign in)\n   181→    await expect(page).toHaveURL(/\\/my-issues/, { timeout: 30000 });\n   182→\n   183→    // Verify session token stored\n   184→    const token = await page.evaluate(() => localStorage.getItem('session_token'));\n   185→    expect(token).toBeTruthy();\n   186→  });\n   187→\n   188→  test('Login redirects authenticated users', async ({ page, baseURL }) => {\n   189→    test.slow();\n   190→\n   191→    // Create a user and get a valid token\n   192→    const email = `redirect-${Date.now()}@test.com`;\n   193→    const password = 'password123';\n   194→    const data = await createTestUser(baseURL!, 'Redirect User', email, password);\n   195→    const token = data.token;\n   196→\n   197→    // Set the session token in localStorage before navigating\n   198→    await page.goto('/login');\n   199→    await page.evaluate((t) => localStorage.setItem('session_token', t), token);\n   200→\n   201→    // Navigate to /login\n   202→    await page.goto('/login');\n   203→\n   204→    // Should be redirected to /my-issues\n   205→    await expect(page).toHaveURL(/\\/my-issues/, { timeout: 30000 });\n   206→\n   207→    // Should not see the login form\n   208→    await expect(page.getByTestId('login-form')).not.toBeVisible();\n   209→  });\n   210→});\n   211→"}]},"parent_tool_use_id":"toolu_012RDVYr85msVNgfPCrKXKhx","session_id":"bba55255-5906-4397-88b6-4f0dfb6b6368","uuid":"9a1891ad-8ace-49dd-89ed-c40d5963ed0f"}
