[2026-03-14T22:04:59.745Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PDPcHP5GBnQYjc6nSQZ69A","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test';\n     2→\n     3→// Helper to login as Alice and return token\n     4→async function loginAsAlice(baseURL: string): Promise<string> {\n     5→  const response = await fetch(`${baseURL}/api/login`, {\n     6→    method: 'POST',\n     7→    headers: { 'Content-Type': 'application/json' },\n     8→    body: JSON.stringify({ email: 'alice@acme.com', password: 'password123' }),\n     9→  });\n    10→  const data = await response.json();\n    11→  return data.token;\n    12→}\n    13→\n    14→// Helper to get teams via API\n    15→async function getTeams(baseURL: string, token: string) {\n    16→  const response = await fetch(`${baseURL}/api/teams`, {\n    17→    headers: { Authorization: `Bearer ${token}` },\n    18→  });\n    19→  const data = await response.json();\n    20→  return data.teams as Array<{ id: string; name: string; identifier: string }>;\n    21→}\n    22→\n    23→// Helper to authenticate page as Alice\n    24→async function authenticatePage(page: any, baseURL: string): Promise<string> {\n    25→  const token = await loginAsAlice(baseURL);\n    26→  await page.goto('/login');\n    27→  await page.evaluate((t: string) => localStorage.setItem('session_token', t), token);\n    28→  return token;\n    29→}\n    30→\n    31→test.describe('SidebarCollapse', () => {\n    32→  test('Sidebar collapse toggle button is visible', async ({ page, baseURL }) => {\n    33→    await authenticatePage(page, baseURL!);\n    34→    await page.goto('/my-issues');\n    35→    await expect(page.getByTestId('sidebar')).toBeVisible({ timeout: 30000 });\n    36→\n    37→    await expect(page.getByTestId('sidebar-collapse-toggle')).toBeVisible({ timeout: 10000 });\n    38→  });\n    39→\n    40→  test('Sidebar collapses to icon-only mode', async ({ page, baseURL }) => {\n    41→    await authenticatePage(page, baseURL!);\n    42→    await page.goto('/my-issues');\n    43→    await expect(page.getByTestId('sidebar')).toBeVisible({ timeout: 30000 });\n    44→\n    45→    // Verify sidebar is expanded (has text labels)\n    46→    await expect(page.getByTestId('sidebar-link-my-issues')).toContainText('My Issues', { timeout: 10000 });\n    47→\n    48→    // Click collapse toggle\n    49→    await page.getByTestId('sidebar-collapse-toggle').click();\n    50→\n    51→    // Sidebar should have collapsed class\n    52→    await expect(page.getByTestId('sidebar')).toHaveClass(/sidebar-collapsed/, { timeout: 10000 });\n    53→\n    54→    // Text labels should be hidden - \"My Issues\" text should not be visible\n    55→    await expect(page.getByTestId('sidebar-link-my-issues').locator('span')).not.toBeVisible({ timeout: 10000 });\n    56→  });\n    57→\n    58→  test('Sidebar expands from icon-only mode', async ({ page, baseURL }) => {\n    59→    await authenticatePage(page, baseURL!);\n    60→    await page.goto('/my-issues');"}]},"parent_tool_use_id":"toolu_01JH2xeuA7L683JZASFVKtKr","session_id":"677438e1-1261-4d5a-9849-a62a9293ba3b","uuid":"398d40e1-a0c7-498d-99ec-eb7027fd73af"}
