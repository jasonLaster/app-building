[2026-03-14T22:06:07.568Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LUDuRNhyJfXJevcnNn2ucy","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test';\n     2→\n     3→// Helper to login via API and get token\n     4→async function loginViaApi(baseURL: string, email: string, password: string) {\n     5→  const response = await fetch(`${baseURL}/api/login`, {\n     6→    method: 'POST',\n     7→    headers: { 'Content-Type': 'application/json' },\n     8→    body: JSON.stringify({ email, password }),\n     9→  });\n    10→  return response.json();\n    11→}\n    12→\n    13→// Helper to get teams via API\n    14→async function getTeams(baseURL: string, token: string) {\n    15→  const response = await fetch(`${baseURL}/api/teams`, {\n    16→    headers: { Authorization: `Bearer ${token}` },\n    17→  });\n    18→  const data = await response.json();\n    19→  return data.teams;\n    20→}\n    21→\n    22→// Helper to get team issues via API\n    23→async function getTeamIssues(baseURL: string, token: string, teamId: string) {\n    24→  const response = await fetch(`${baseURL}/api/team-issues?teamId=${teamId}`, {\n    25→    headers: { Authorization: `Bearer ${token}` },\n    26→  });\n    27→  const data = await response.json();\n    28→  return data.issues;\n    29→}\n    30→\n    31→// Helper to login and navigate to an issue detail page\n    32→async function loginAndNavigateToIssue(\n    33→  page: import('@playwright/test').Page,\n    34→  baseURL: string,\n    35→  issueNumber: number,\n    36→  email = 'alice@acme.com',\n    37→  password = 'password123'\n    38→) {\n    39→  const data = await loginViaApi(baseURL, email, password);\n    40→  const teams = await getTeams(baseURL, data.token);\n    41→  const engTeam = teams.find((t: { identifier: string }) => t.identifier === 'ENG');\n    42→  const issues = await getTeamIssues(baseURL, data.token, engTeam.id);\n    43→\n    44→  // Find the issue by number\n    45→  const issue = issues.find((i: { number: number }) => i.number === issueNumber);\n    46→\n    47→  await page.goto('/login');\n    48→  await page.evaluate((t) => localStorage.setItem('session_token', t), data.token);\n    49→  await page.goto(`/issue/${issue.id}`);\n    50→  await expect(page.getByTestId('issue-detail-page')).toBeVisible({ timeout: 30000 });\n    51→  await expect(page.getByTestId('issue-header')).toBeVisible({ timeout: 30000 });\n    52→  return { token: data.token, user: data.user, engTeam, issue };\n    53→}\n    54→\n    55→test.describe('IssueDetailHeader', () => {\n    56→  test('Issue header renders identifier and title', async ({ page, baseURL }) => {\n    57→    // ENG-1: \"Fix login session expiration bug\", status: in_progress\n    58→    await loginAndNavigateToIssue(page, baseURL!, 1);\n    59→\n    60→    // Verify identifier is displayed\n    61→    await expect(page.getByTestId('issue-header-identifier')).toBeVisible();\n    62→    await expect(page.getByTestId('issue-header-identifier')).toHaveText('ENG-1');\n    63→\n    64→    // Verify title is displayed\n    65→    await expect(page.getByTestId('issue-header-title')).toBeVisible();\n    66→    await expect(page.getByTestId('issue-header-title')).toHaveText('Fix login session expiration bug');\n    67→\n    68→    // Verify status selector is visible\n    69→    await expect(page.getByTestId('issue-header-status-btn')).toBeVisible();\n    70→    await expect(page.getByTestId('issue-header-status-btn')).toContainText('In Progress');\n    71→  });\n    72→\n    73→  test('Inline edit issue title', async ({ page, baseURL }) => {\n    74→    // ENG-1: \"Fix login session expiration bug\"\n    75→    await loginAndNavigateToIssue(page, baseURL!, 1);\n    76→\n    77→    // Click the title to enter edit mode\n    78→    await page.getByTestId('issue-header-title').click();\n    79→\n    80→    // Verify input appears with current title value\n    81→    const titleInput = page.getByTestId('issue-header-title-input');\n    82→    await expect(titleInput).toBeVisible();\n    83→    await expect(titleInput).toHaveValue('Fix login session expiration bug');\n    84→    await expect(titleInput).toBeFocused();\n    85→  });\n    86→\n    87→  test('Save edited issue title', async ({ page, baseURL }) => {\n    88→    // Use ENG-3 (backlog, unassigned) to avoid conflicts with other tests\n    89→    await loginAndNavigateToIssue(page, baseURL!, 3);\n    90→\n    91→    const uniqueSuffix = Date.now();\n    92→    const newTitle = `Updated dark mode title ${uniqueSuffix}`;\n    93→\n    94→    // Click title to edit\n    95→    await page.getByTestId('issue-header-title').click();\n    96→    const titleInput = page.getByTestId('issue-header-title-input');\n    97→    await expect(titleInput).toBeVisible();\n    98→\n    99→    // Clear and type new title\n   100→    await titleInput.fill(newTitle);\n   101→    await titleInput.press('Enter');\n   102→\n   103→    // Verify title updates in display mode\n   104→    await expect(page.getByTestId('issue-header-title')).toBeVisible({ timeout: 30000 });\n   105→    await expect(page.getByTestId('issue-header-title')).toHaveText(newTitle);\n   106→\n   107→    // Verify input is no longer visible (returned to display mode)\n   108→    await expect(page.getByTestId('issue-header-title-input')).toHaveCount(0);\n   109→  });\n   110→\n   111→  test('Cancel title edit on Escape', async ({ page, baseURL }) => {\n   112→    // ENG-1: \"Fix login session expiration bug\"\n   113→    await loginAndNavigateToIssue(page, baseURL!, 1);\n   114→\n   115→    const originalTitle = 'Fix login session expiration bug';\n   116→\n   117→    // Click title to edit\n   118→    await page.getByTestId('issue-header-title').click();\n   119→    const titleInput = page.getByTestId('issue-header-title-input');\n   120→    await expect(titleInput).toBeVisible();\n   121→\n   122→    // Type some characters\n   123→    await titleInput.fill('Some random text that should not be saved');\n   124→\n   125→    // Press Escape to cancel\n   126→    await titleInput.press('Escape');\n   127→\n   128→    // Verify title reverts to original\n   129→    await expect(page.getByTestId('issue-header-title')).toBeVisible();\n   130→    await expect(page.getByTestId('issue-header-title')).toHaveText(originalTitle);\n   131→\n   132→    // Verify input is gone (display mode)\n   133→    await expect(page.getByTestId('issue-header-title-input')).toHaveCount(0);\n   134→  });\n   135→\n   136→  test('Title edit validates non-empty', async ({ page, baseURL }) => {\n   137→    // ENG-1: \"Fix login session expiration bug\"\n   138→    await loginAndNavigateToIssue(page, baseURL!, 1);\n   139→\n   140→    // Click title to edit\n   141→    await page.getByTestId('issue-header-title').click();\n   142→    const titleInput = page.getByTestId('issue-header-title-input');\n   143→    await expect(titleInput).toBeVisible();\n   144→\n   145→    // Clear the title completely\n   146→    await titleInput.fill('');\n   147→    await titleInput.press('Enter');\n   148→\n   149→    // Verify input still visible (did not save) and has error styling\n   150→    await expect(titleInput).toBeVisible();\n   151→    await expect(titleInput).toHaveClass(/issue-header-title-input-error/);\n   152→  });\n   153→\n   154→  test('Inline status selector displays current status', async ({ page, baseURL }) => {\n   155→    // ENG-1: status is \"in_progress\" -> label \"In Progress\"\n   156→    await loginAndNavigateToIssue(page, baseURL!, 1);\n   157→\n   158→    const statusBtn = page.getByTestId('issue-header-status-btn');\n   159→    await expect(statusBtn).toBeVisible();\n   160→    await expect(statusBtn).toContainText('In Progress');\n   161→  });\n   162→\n   163→  test('Change status via inline selector', async ({ page, baseURL }) => {\n   164→    // ENG-2: status is \"todo\"\n   165→    await loginAndNavigateToIssue(page, baseURL!, 2);\n   166→\n   167→    // Verify current status is Todo\n   168→    await expect(page.getByTestId('issue-header-status-btn')).toContainText('Todo');\n   169→\n   170→    // Click the status selector\n   171→    await page.getByTestId('issue-header-status-btn').click();\n   172→\n   173→    // Verify dropdown appears with all statuses\n   174→    const dropdown = page.getByTestId('issue-header-status-dropdown');\n   175→    await expect(dropdown).toBeVisible();\n   176→    await expect(page.getByTestId('issue-header-status-option-backlog')).toBeVisible();\n   177→    await expect(page.getByTestId('issue-header-status-option-todo')).toBeVisible();\n   178→    await expect(page.getByTestId('issue-header-status-option-in_progress')).toBeVisible();\n   179→    await expect(page.getByTestId('issue-header-status-option-in_review')).toBeVisible();\n   180→    await expect(page.getByTestId('issue-header-status-option-done')).toBeVisible();\n   181→    await expect(page.getByTestId('issue-header-status-option-cancelled')).toBeVisible();\n   182→\n   183→    // Verify each option has correct label text\n   184→    await expect(page.getByTestId('issue-header-status-option-backlog')).toContainText('Backlog');\n   185→    await expect(page.getByTestId('issue-header-status-option-todo')).toContainText('Todo');\n   186→    await expect(page.getByTestId('issue-header-status-option-in_progress')).toContainText('In Progress');\n   187→    await expect(page.getByTestId('issue-header-status-option-in_review')).toContainText('In Review');\n   188→    await expect(page.getByTestId('issue-header-status-option-done')).toContainText('Done');\n   189→    await expect(page.getByTestId('issue-header-status-option-cancelled')).toContainText('Cancelled');\n   190→  });\n   191→\n   192→  test('Select new status from dropdown', async ({ page, baseURL }) => {\n   193→    // Use ENG-7 (backlog, unassigned) to avoid conflicts\n   194→    await loginAndNavigateToIssue(page, baseURL!, 7);\n   195→\n   196→    // Verify current status is Backlog\n   197→    await expect(page.getByTestId('issue-header-status-btn')).toContainText('Backlog');\n   198→\n   199→    // Open dropdown and select \"In Progress\"\n   200→    await page.getByTestId('issue-header-status-btn').click();\n   201→    await expect(page.getByTestId('issue-header-status-dropdown')).toBeVisible();\n   202→    await page.getByTestId('issue-header-status-option-in_progress').click();\n   203→\n   204→    // Verify dropdown closes\n   205→    await expect(page.getByTestId('issue-header-status-dropdown')).toHaveCount(0);\n   206→\n   207→    // Verify status updated to \"In Progress\"\n   208→    await expect(page.getByTestId('issue-header-status-btn')).toContainText('In Progress', { timeout: 30000 });\n   209→  });\n   210→\n   211→  test('Status dropdown closes on outside click', async ({ page, baseURL }) => {\n   212→    await loginAndNavigateToIssue(page, baseURL!, 1);\n   213→\n   214→    // Open the status dropdown\n   215→    await page.getByTestId('issue-header-status-btn').click();\n   216→    await expect(page.getByTestId('issue-header-status-dropdown')).toBeVisible();\n   217→\n   218→    // Click outside the dropdown (on the page body)\n   219→    await page.getByTestId('issue-detail-main').click({ position: { x: 10, y: 10 } });\n   220→\n   221→    // Verify dropdown is closed\n   222→    await expect(page.getByTestId('issue-header-status-dropdown')).toHaveCount(0);\n   223→\n   224→    // Verify status has not changed (still \"In Progress\")\n   225→    await expect(page.getByTestId('issue-header-status-btn')).toContainText('In Progress');\n   226→  });\n   227→});\n   228→"}]},"parent_tool_use_id":null,"session_id":"677438e1-1261-4d5a-9849-a62a9293ba3b","uuid":"3e701104-a67a-49be-81a7-e3c5a0b52090","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/tests/issue-detail-header.spec.ts","content":"import { test, expect } from '@playwright/test';\n\n// Helper to login via API and get token\nasync function loginViaApi(baseURL: string, email: string, password: string) {\n  const response = await fetch(`${baseURL}/api/login`, {\n    method: 'POST',\n    headers: { 'Content-Type': 'application/json' },\n    body: JSON.stringify({ email, password }),\n  });\n  return response.json();\n}\n\n// Helper to get teams via API\nasync function getTeams(baseURL: string, token: string) {\n  const response = await fetch(`${baseURL}/api/teams`, {\n    headers: { Authorization: `Bearer ${token}` },\n  });\n  const data = await response.json();\n  return data.teams;\n}\n\n// Helper to get team issues via API\nasync function getTeamIssues(baseURL: string, token: string, teamId: string) {\n  const response = await fetch(`${baseURL}/api/team-issues?teamId=${teamId}`, {\n    headers: { Authorization: `Bearer ${token}` },\n  });\n  const data = await response.json();\n  return data.issues;\n}\n\n// Helper to login and navigate to an issue detail page\nasync function loginAndNavigateToIssue(\n  page: import('@playwright/test').Page,\n  baseURL: string,\n  issueNumber: number,\n  email = 'alice@acme.com',\n  password = 'password123'\n) {\n  const data = await loginViaApi(baseURL, email, password);\n  const teams = await getTeams(baseURL, data.token);\n  const engTeam = teams.find((t: { identifier: string }) => t.identifier === 'ENG');\n  const issues = await getTeamIssues(baseURL, data.token, engTeam.id);\n\n  // Find the issue by number\n  const issue = issues.find((i: { number: number }) => i.number === issueNumber);\n\n  await page.goto('/login');\n  await page.evaluate((t) => localStorage.setItem('session_token', t), data.token);\n  await page.goto(`/issue/${issue.id}`);\n  await expect(page.getByTestId('issue-detail-page')).toBeVisible({ timeout: 30000 });\n  await expect(page.getByTestId('issue-header')).toBeVisible({ timeout: 30000 });\n  return { token: data.token, user: data.user, engTeam, issue };\n}\n\ntest.describe('IssueDetailHeader', () => {\n  test('Issue header renders identifier and title', async ({ page, baseURL }) => {\n    // ENG-1: \"Fix login session expiration bug\", status: in_progress\n    await loginAndNavigateToIssue(page, baseURL!, 1);\n\n    // Verify identifier is displayed\n    await expect(page.getByTestId('issue-header-identifier')).toBeVisible();\n    await expect(page.getByTestId('issue-header-identifier')).toHaveText('ENG-1');\n\n    // Verify title is displayed\n    await expect(page.getByTestId('issue-header-title')).toBeVisible();\n    await expect(page.getByTestId('issue-header-title')).toHaveText('Fix login session expiration bug');\n\n    // Verify status selector is visible\n    await expect(page.getByTestId('issue-header-status-btn')).toBeVisible();\n    await expect(page.getByTestId('issue-header-status-btn')).toContainText('In Progress');\n  });\n\n  test('Inline edit issue title', async ({ page, baseURL }) => {\n    // ENG-1: \"Fix login session expiration bug\"\n    await loginAndNavigateToIssue(page, baseURL!, 1);\n\n    // Click the title to enter edit mode\n    await page.getByTestId('issue-header-title').click();\n\n    // Verify input appears with current title value\n    const titleInput = page.getByTestId('issue-header-title-input');\n    await expect(titleInput).toBeVisible();\n    await expect(titleInput).toHaveValue('Fix login session expiration bug');\n    await expect(titleInput).toBeFocused();\n  });\n\n  test('Save edited issue title', async ({ page, baseURL }) => {\n    // Use ENG-3 (backlog, unassigned) to avoid conflicts with other tests\n    await loginAndNavigateToIssue(page, baseURL!, 3);\n\n    const uniqueSuffix = Date.now();\n    const newTitle = `Updated dark mode title ${uniqueSuffix}`;\n\n    // Click title to edit\n    await page.getByTestId('issue-header-title').click();\n    const titleInput = page.getByTestId('issue-header-title-input');\n    await expect(titleInput).toBeVisible();\n\n    // Clear and type new title\n    await titleInput.fill(newTitle);\n    await titleInput.press('Enter');\n\n    // Verify title updates in display mode\n    await expect(page.getByTestId('issue-header-title')).toBeVisible({ timeout: 30000 });\n    await expect(page.getByTestId('issue-header-title')).toHaveText(newTitle);\n\n    // Verify input is no longer visible (returned to display mode)\n    await expect(page.getByTestId('issue-header-title-input')).toHaveCount(0);\n  });\n\n  test('Cancel title edit on Escape', async ({ page, baseURL }) => {\n    // ENG-1: \"Fix login session expiration bug\"\n    await loginAndNavigateToIssue(page, baseURL!, 1);\n\n    const originalTitle = 'Fix login session expiration bug';\n\n    // Click title to edit\n    await page.getByTestId('issue-header-title').click();\n    const titleInput = page.getByTestId('issue-header-title-input');\n    await expect(titleInput).toBeVisible();\n\n    // Type some characters\n    await titleInput.fill('Some random text that should not be saved');\n\n    // Press Escape to cancel\n    await titleInput.press('Escape');\n\n    // Verify title reverts to original\n    await expect(page.getByTestId('issue-header-title')).toBeVisible();\n    await expect(page.getByTestId('issue-header-title')).toHaveText(originalTitle);\n\n    // Verify input is gone (display mode)\n    await expect(page.getByTestId('issue-header-title-input')).toHaveCount(0);\n  });\n\n  test('Title edit validates non-empty', async ({ page, baseURL }) => {\n    // ENG-1: \"Fix login session expiration bug\"\n    await loginAndNavigateToIssue(page, baseURL!, 1);\n\n    // Click title to edit\n    await page.getByTestId('issue-header-title').click();\n    const titleInput = page.getByTestId('issue-header-title-input');\n    await expect(titleInput).toBeVisible();\n\n    // Clear the title completely\n    await titleInput.fill('');\n    await titleInput.press('Enter');\n\n    // Verify input still visible (did not save) and has error styling\n    await expect(titleInput).toBeVisible();\n    await expect(titleInput).toHaveClass(/issue-header-title-input-error/);\n  });\n\n  test('Inline status selector displays current status', async ({ page, baseURL }) => {\n    // ENG-1: status is \"in_progress\" -> label \"In Progress\"\n    await loginAndNavigateToIssue(page, baseURL!, 1);\n\n    const statusBtn = page.getByTestId('issue-header-status-btn');\n    await expect(statusBtn).toBeVisible();\n    await expect(statusBtn).toContainText('In Progress');\n  });\n\n  test('Change status via inline selector', async ({ page, baseURL }) => {\n    // ENG-2: status is \"todo\"\n    await loginAndNavigateToIssue(page, baseURL!, 2);\n\n    // Verify current status is Todo\n    await expect(page.getByTestId('issue-header-status-btn')).toContainText('Todo');\n\n    // Click the status selector\n    await page.getByTestId('issue-header-status-btn').click();\n\n    // Verify dropdown appears with all statuses\n    const dropdown = page.getByTestId('issue-header-status-dropdown');\n    await expect(dropdown).toBeVisible();\n    await expect(page.getByTestId('issue-header-status-option-backlog')).toBeVisible();\n    await expect(page.getByTestId('issue-header-status-option-todo')).toBeVisible();\n    await expect(page.getByTestId('issue-header-status-option-in_progress')).toBeVisible();\n    await expect(page.getByTestId('issue-header-status-option-in_review')).toBeVisible();\n    await expect(page.getByTestId('issue-header-status-option-done')).toBeVisible();\n    await expect(page.getByTestId('issue-header-status-option-cancelled')).toBeVisible();\n\n    // Verify each option has correct label text\n    await expect(page.getByTestId('issue-header-status-option-backlog')).toContainText('Backlog');\n    await expect(page.getByTestId('issue-header-status-option-todo')).toContainText('Todo');\n    await expect(page.getByTestId('issue-header-status-option-in_progress')).toContainText('In Progress');\n    await expect(page.getByTestId('issue-header-status-option-in_review')).toContainText('In Review');\n    await expect(page.getByTestId('issue-header-status-option-done')).toContainText('Done');\n    await expect(page.getByTestId('issue-header-status-option-cancelled')).toContainText('Cancelled');\n  });\n\n  test('Select new status from dropdown', async ({ page, baseURL }) => {\n    // Use ENG-7 (backlog, unassigned) to avoid conflicts\n    await loginAndNavigateToIssue(page, baseURL!, 7);\n\n    // Verify current status is Backlog\n    await expect(page.getByTestId('issue-header-status-btn')).toContainText('Backlog');\n\n    // Open dropdown and select \"In Progress\"\n    await page.getByTestId('issue-header-status-btn').click();\n    await expect(page.getByTestId('issue-header-status-dropdown')).toBeVisible();\n    await page.getByTestId('issue-header-status-option-in_progress').click();\n\n    // Verify dropdown closes\n    await expect(page.getByTestId('issue-header-status-dropdown')).toHaveCount(0);\n\n    // Verify status updated to \"In Progress\"\n    await expect(page.getByTestId('issue-header-status-btn')).toContainText('In Progress', { timeout: 30000 });\n  });\n\n  test('Status dropdown closes on outside click', async ({ page, baseURL }) => {\n    await loginAndNavigateToIssue(page, baseURL!, 1);\n\n    // Open the status dropdown\n    await page.getByTestId('issue-header-status-btn').click();\n    await expect(page.getByTestId('issue-header-status-dropdown')).toBeVisible();\n\n    // Click outside the dropdown (on the page body)\n    await page.getByTestId('issue-detail-main').click({ position: { x: 10, y: 10 } });\n\n    // Verify dropdown is closed\n    await expect(page.getByTestId('issue-header-status-dropdown')).toHaveCount(0);\n\n    // Verify status has not changed (still \"In Progress\")\n    await expect(page.getByTestId('issue-header-status-btn')).toContainText('In Progress');\n  });\n});\n","numLines":228,"startLine":1,"totalLines":228}}}
[2026-03-14T22:06:08.009Z] {"type":"assistant","message":{"model":"claude-opus-4-6","id":"msg_01Qwj2f9h3AairP46EEMNGcU","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01QxXoHGnswnif3T2d7X6SvL","name":"Read","input":{"file_path":"/repo/apps/LinearClone/netlify/functions/update-issue.ts"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":34,"cache_creation_input_tokens":8388,"cache_read_input_tokens":29307,"cache_creation":{"ephemeral_5m_input_tokens":8388,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"global"},"context_management":null},"parent_tool_use_id":null,"session_id":"677438e1-1261-4d5a-9849-a62a9293ba3b","uuid":"04dae817-e233-40f3-9240-3b50535d0761"}
[2026-03-14T22:06:08.086Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QxXoHGnswnif3T2d7X6SvL","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions';\n     2→import { getSql } from './db';\n     3→\n     4→export default async function handler(req: Request, _context: Context) {\n     5→  if (req.method !== 'PUT') {\n     6→    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n     7→      status: 405,\n     8→      headers: { 'Content-Type': 'application/json' },\n     9→    });\n    10→  }\n    11→\n    12→  try {\n    13→    const authHeader = req.headers.get('Authorization');\n    14→    if (!authHeader?.startsWith('Bearer ')) {\n    15→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    16→        status: 401,\n    17→        headers: { 'Content-Type': 'application/json' },\n    18→      });\n    19→    }\n    20→\n    21→    const token = authHeader.slice(7);\n    22→    const sql = getSql();\n    23→\n    24→    const sessions = await sql`\n    25→      SELECT s.member_id FROM sessions s\n    26→      WHERE s.token = ${token} AND s.expires_at > NOW()\n    27→    `;\n    28→    const session = sessions[0];\n    29→    if (!session) {\n    30→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    31→        status: 401,\n    32→        headers: { 'Content-Type': 'application/json' },\n    33→      });\n    34→    }\n    35→\n    36→    const body = await req.json();\n    37→    const { issueId, field, value, labelIds } = body;\n    38→\n    39→    if (!issueId || !field) {\n    40→      return new Response(JSON.stringify({ error: 'issueId and field are required' }), {\n    41→        status: 400,\n    42→        headers: { 'Content-Type': 'application/json' },\n    43→      });\n    44→    }\n    45→\n    46→    // Get current issue state for activity logging\n    47→    const currentRows = await sql`\n    48→      SELECT i.*, t.identifier AS team_identifier, m.name AS assignee_name\n    49→      FROM issues i\n    50→      JOIN teams t ON t.id = i.team_id\n    51→      LEFT JOIN members m ON m.id = i.assignee_id\n    52→      WHERE i.id = ${issueId}\n    53→    `;\n    54→    const current = currentRows[0];\n    55→    if (!current) {\n    56→      return new Response(JSON.stringify({ error: 'Issue not found' }), {\n    57→        status: 404,\n    58→        headers: { 'Content-Type': 'application/json' },\n    59→      });\n    60→    }\n    61→\n    62→    const STATUS_LABELS: Record<string, string> = {\n    63→      backlog: 'Backlog',\n    64→      todo: 'Todo',\n    65→      in_progress: 'In Progress',\n    66→      in_review: 'In Review',\n    67→      done: 'Done',\n    68→      cancelled: 'Cancelled',\n    69→    };\n    70→\n    71→    const PRIORITY_LABELS: Record<string, string> = {\n    72→      urgent: 'Urgent',\n    73→      high: 'High',\n    74→      medium: 'Medium',\n    75→      low: 'Low',\n    76→      none: 'No Priority',\n    77→    };\n    78→\n    79→    let activityAction = '';\n    80→\n    81→    if (field === 'title') {\n    82→      await sql`UPDATE issues SET title = ${value}, updated_at = NOW() WHERE id = ${issueId}`;\n    83→      activityAction = `changed title from \"${current.title}\" to \"${value}\"`;\n    84→    } else if (field === 'description') {\n    85→      await sql`UPDATE issues SET description = ${value}, updated_at = NOW() WHERE id = ${issueId}`;\n    86→      activityAction = 'updated the description';\n    87→    } else if (field === 'status') {\n    88→      await sql`UPDATE issues SET status = ${value}, updated_at = NOW() WHERE id = ${issueId}`;\n    89→      const oldLabel = STATUS_LABELS[String(current.status)] || current.status;\n    90→      const newLabel = STATUS_LABELS[String(value)] || value;\n    91→      activityAction = `changed status from ${oldLabel} to ${newLabel}`;\n    92→    } else if (field === 'priority') {\n    93→      await sql`UPDATE issues SET priority = ${value}, updated_at = NOW() WHERE id = ${issueId}`;\n    94→      const oldLabel = PRIORITY_LABELS[String(current.priority)] || current.priority;\n    95→      const newLabel = PRIORITY_LABELS[String(value)] || value;\n    96→      activityAction = `changed priority from ${oldLabel} to ${newLabel}`;\n    97→    } else if (field === 'assigneeId') {\n    98→      const assigneeVal = value || null;\n    99→      await sql`UPDATE issues SET assignee_id = ${assigneeVal}, updated_at = NOW() WHERE id = ${issueId}`;\n   100→      if (assigneeVal) {\n   101→        const aRows = await sql`SELECT name FROM members WHERE id = ${assigneeVal}`;\n   102→        const aRow = aRows[0];\n   103→        const newName = aRow ? String(aRow.name) : 'someone';\n   104→        if (current.assignee_id) {\n   105→          activityAction = `changed assignee from ${current.assignee_name || 'unknown'} to ${newName}`;\n   106→        } else {\n   107→          activityAction = `assigned to ${newName}`;\n   108→        }\n   109→        // Notify new assignee\n   110→        if (assigneeVal !== session.member_id) {\n   111→          const creatorRows = await sql`SELECT name FROM members WHERE id = ${session.member_id}`;\n   112→          const creator = creatorRows[0];\n   113→          const creatorName = creator ? String(creator.name) : 'Someone';\n   114→          const identifier = `${current.team_identifier}-${current.number}`;\n   115→          await sql`\n   116→            INSERT INTO notifications (member_id, type, message, issue_id, created_at)\n   117→            VALUES (${assigneeVal}, 'assigned', ${`${creatorName} assigned you to ${identifier}: ${current.title}`}, ${issueId}, NOW())\n   118→          `;\n   119→        }\n   120→      } else {\n   121→        activityAction = `removed assignee ${current.assignee_name || ''}`;\n   122→      }\n   123→    } else if (field === 'projectId') {\n   124→      const projectVal = value || null;\n   1