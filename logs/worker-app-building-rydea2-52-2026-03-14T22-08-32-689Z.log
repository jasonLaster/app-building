[2026-03-14T22:04:55.072Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QUFaN39deXQBzDirdQS4Jk","type":"tool_result","content":"     1→import { useState, useRef, useEffect } from 'react';\n     2→import { useDispatch } from 'react-redux';\n     3→import type { AppDispatch } from '../store';\n     4→import type { Issue, IssueLabel } from '../slices/issuesSlice';\n     5→import type { TeamMember, TeamProject, TeamCycle } from '../slices/issueDetailSlice';\n     6→import { updateIssueField } from '../slices/issueDetailSlice';\n     7→import { StatusIcon, PriorityIcon, STATUS_CONFIG, PRIORITY_CONFIG, STATUS_ORDER } from './IssueRow';\n     8→import './IssueSidebar.css';\n     9→\n    10→const PRIORITY_ORDER = ['urgent', 'high', 'medium', 'low', 'none'] as const;\n    11→\n    12→interface IssueSidebarProps {\n    13→  issue: Issue;\n    14→  members: TeamMember[];\n    15→  projects: TeamProject[];\n    16→  cycles: TeamCycle[];\n    17→  allLabels: IssueLabel[];\n    18→}\n    19→\n    20→type DropdownType = 'status' | 'priority' | 'assignee' | 'labels' | 'project' | 'cycle' | 'dueDate' | null;\n    21→\n    22→function getInitials(name: string): string {\n    23→  return name\n    24→    .split(' ')\n    25→    .map((n) => n[0])\n    26→    .join('')\n    27→    .toUpperCase()\n    28→    .slice(0, 2);\n    29→}\n    30→\n    31→function formatDate(dateStr: string): string {\n    32→  const date = new Date(dateStr);\n    33→  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });\n    34→}\n    35→\n    36→function formatDueDate(dateStr: string): string {\n    37→  const d = new Date(dateStr + 'T00:00:00');\n    38→  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });\n    39→}\n    40→\n    41→export default function IssueSidebar({ issue, members, projects, cycles, allLabels }: IssueSidebarProps) {\n    42→  const dispatch = useDispatch<AppDispatch>();\n    43→  const [openDropdown, setOpenDropdown] = useState<DropdownType>(null);\n    44→  const [assigneeSearch, setAssigneeSearch] = useState('');\n    45→  const [projectSearch, setProjectSearch] = useState('');\n    46→  const sidebarRef = useRef<HTMLDivElement>(null);\n    47→\n    48→  useEffect(() => {\n    49→    function handleClickOutside(e: MouseEvent) {\n    50→      if (sidebarRef.current && !sidebarRef.current.contains(e.target as Node)) {\n    51→        setOpenDropdown(null);\n    52→      }\n    53→    }\n    54→    if (openDropdown) {\n    55→      document.addEventListener('mousedown', handleClickOutside);\n    56→    }\n    57→    return () => document.removeEventListener('mousedown', handleClickOutside);\n    58→  }, [openDropdown]);\n    59→\n    60→  function toggleDropdown(type: DropdownType) {\n    61→    setOpenDropdown(openDropdown === type ? null : type);\n    62→    if (type === 'assignee') setAssigneeSearch('');\n    63→    if (type === 'project') setProjectSearch('');\n    64→  }\n    65→\n    66→  function handleStatusChange(status: string) {\n    67→    dispatch(updateIssueField({ issueId: issue.id, field: 'status', value: status }));\n    68→    setOpenDropdown(null);\n    69→  }\n    70→\n    71→  function handlePriorityChange(priority: string) {\n    72→    dispatch(updateIssueField({ issueId: issue.id, field: 'priority', value: priority }));\n    73→    setOpenDropdown(null);\n    74→  }\n    75→\n    76→  function handleAssigneeChange(assigneeId: string | null) {\n    77→    dispatch(updateIssueField({ issueId: issue.id, field: 'assigneeId', value: assigneeId }));\n    78→    setOpenDropdown(null);\n    79→  }\n    80→\n    81→  function handleLabelToggle(labelId: string) {\n    82→    const currentIds = issue.labels.map((l) => l.id);\n    83→    let newIds: string[];\n    84→    if (currentIds.includes(labelId)) {\n    85→      newIds = currentIds.filter((id) => id !== labelId);\n    86→    } else {\n    87→      newIds = [...currentIds, labelId];\n    88→    }\n    89→    dispatch(updateIssueField({ issueId: issue.id, field: 'labels', value: null, labelIds: newIds }));\n    90→  }\n    91→\n    92→  function handleProjectChange(projectId: string | null) {\n    93→    dispatch(updateIssueField({ issueId: issue.id, field: 'projectId', value: projectId }));\n    94→    setOpenDropdown(null);\n    95→  }\n    96→\n    97→  function handleCycleChange(cycleId: string | null) {\n    98→    dispatch(updateIssueField({ issueId: issue.id, field: 'cycleId', value: cycleId }));\n    99→    setOpenDropdown(null);\n   100→  }\n   101→\n   102→  function handleDueDateChange(e: React.ChangeEvent<HTMLInputElement>) {\n   103→    const val = e.target.value || null;\n   104→    dispatch(updateIssueField({ issueId: issue.id, field: 'dueDate', value: val }));\n   105→  }\n   106→\n   107→  function handleClearDueDate() {\n   108→    dispatch(updateIssueField({ issueId: issue.id, field: 'dueDate', value: null }));\n   109→  }\n   110→\n   111→  const statusConfig = STATUS_CONFIG[issue.status] || STATUS_CONFIG.todo;\n   112→  const priorityConfig = PRIORITY_CONFIG[issue.priority] || PRIORITY_CONFIG.none;\n   113→  const filteredMembers = members.filter((m) =>\n   114→    m.name.toLowerCase().includes(assigneeSearch.toLowerCase())\n   115→  );\n   116→  const filteredProjects = projects.filter((p) =>\n   117→    p.name.toLowerCase().includes(projectSearch.toLowerCase())\n   118→  );\n   119→  const issueLabelIds = issue.labels.map((l) => l.id);\n   120→\n   121→  return (\n   122→    <div className=\"issue-sidebar\" ref={sidebarRef} data-testid=\"issue-sidebar\">\n   123→      {/* Status */}\n   124→      <div className=\"sidebar-field\" data-testid=\"sidebar-status-field\">\n   125→        <label className=\"sidebar-label\">Status</label>\n   126→        <div className=\"sidebar-dropdown-wrapper\">\n   127→          <button\n   128→            className=\"sidebar-select-btn\"\n   129→            onClick={() => toggleDropdown('status')}\n   130→            data-testid=\"sidebar-status-btn\"\n   131→          >\n   132→            <StatusIcon status={issue.status} color={statusConfig.color} />\n   133→            <span>{statusConfig.label}</span>\n   134→          </button>\n   135→          {openDropdown === 'status' && (\n   136→            <div className=\"sidebar-dropdown\" data-testid=\"sidebar-status-dropdown\">\n   137→              {STATUS_ORDER.map((s) => {\n   138→                const cfg = STATUS_CONFIG[s];\n   139→                return (\n   140→                  <button\n   141→                    key={s}\n   142→                    className={`sidebar-dropdown-option ${issue.status === s ? 'sidebar-dropdown-option-active' : ''}`}\n   143→                    onClick={() => handleStatusChange(s)}\n   144→                    data-testid={`sidebar-status-option-${s}`}\n   145→                  >\n   146→                    <StatusIcon status={s} color={cfg.color} />\n   147→                    <span>{cfg.label}</span>\n   148→                  </button>\n   149→                );\n   150→              })}\n   151→            </div>\n   152→          )}\n   153→        </div>\n   154→      </div>\n   155→\n   156→      {/* Priority */}\n   157→      <div className=\"sidebar-field\" data-testid=\"sidebar-priority-field\">\n   158→        <label className=\"sidebar-label\">Priority</label>\n   159→        <div className=\"sidebar-dropdown-wrapper\">\n   160→          <button\n   161→            className=\"sidebar-select-btn\"\n   162→            onClick={() => toggleDropdown('priority')}\n   163→            data-testid=\"sidebar-priority-btn\"\n   164→          >\n   165→            <PriorityIcon priority={issue.priority} />\n   166→            <span>{priorityConfig.label}</span>\n   167→          </button>\n   168→          {openDropdown === 'priority' && (\n   169→            <div className=\"sidebar-dropdown\" data-testid=\"sidebar-priority-dropdown\">\n   170→              {PRIORITY_ORDER.map((p) => {\n   171→                const cfg = PRIORITY_CONFIG[p] || PRIORITY_CONFIG.none;\n   172→                return (\n   173→                  <button\n   174→                    key={p}\n   175→                    className={`sidebar-dropdown-option ${issue.priority === p ? 'sidebar-dropdown-option-active' : ''}`}\n   176→                    onClick={() => handlePriorityChange(p)}\n   177→                    data-testid={`sidebar-priority-option-${p}`}\n   178→                  >\n   179→                    <PriorityIcon priority={p} />\n   180→                    <span>{cfg.label}</span>\n   181→                  </button>\n   182→                );\n   183→              })}\n   184→            </div>\n   185→          )}\n   186→        </div>\n   187→      </div>\n   188→\n   189→      {/* Assignee */}\n   190→      <div className=\"sidebar-field\" data-testid=\"sidebar-assignee-field\">\n   191→        <label className=\"sidebar-label\">Assignee</label>\n   192→        <div className=\"sidebar-dropdown-wrapper\">\n   193→          <button\n   194→            className=\"sidebar-select-btn\"\n   195→            onClick={() => toggleDropdown('assignee')}\n   196→            data-testid=\"sidebar-assignee-btn\"\n   197→          >\n   198→            {issue.assigneeName ? (\n   199→              <>\n   200→                <span className=\"sidebar-avatar\">{getInitials(issue.assigneeName)}</span>\n   201→                <span>{issue.assigneeName}</span>\n   202→              </>\n   203→            ) : (\n   204→              <span className=\"sidebar-placeholder\">No assignee</span>\n   205→            )}\n   206→          </button>\n   207→          {openDropdown === 'assignee' && (\n   208→            <div className=\"sidebar-dropdown sidebar-dropdown-searchable\" data-testid=\"sidebar-assignee-dropdown\">\n   209→              <input\n   210→                className=\"sidebar-search-input\"\n   211→                placeholder=\"