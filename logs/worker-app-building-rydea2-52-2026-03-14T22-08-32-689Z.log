10M1 14l4.64 4.36A9 9 0 0 0 20.49 15\" />\n   178→                      </svg>\n   179→                      {!sidebarCollapsed && <span>Active Cycle</span>}\n   180→                    </Link>\n   181→                    <Link\n   182→                      to={`/team/${team.id}/projects`}\n   183→                      className={`sidebar-link sidebar-link-nested ${isTeamActive(team.id, 'projects') ? 'sidebar-link-active' : ''}`}\n   184→                      data-testid={`sidebar-link-team-projects-${team.id}`}\n   185→                      title=\"Projects\"\n   186→                    >\n   187→                      <svg className=\"sidebar-icon\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n   188→                        <path d=\"M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z\" />\n   189→                      </svg>\n   190→                      {!sidebarCollapsed && <span>Projects</span>}\n   191→                    </Link>\n   192→                    <Link\n   193→                      to={`/team/${team.id}/views`}\n   194→                      className={`sidebar-link sidebar-link-nested ${isTeamActive(team.id, 'views') ? 'sidebar-link-active' : ''}`}\n   195→                      data-testid={`sidebar-link-team-views-${team.id}`}\n   196→                      title=\"Views\"\n   197→                    >\n   198→                      <svg className=\"sidebar-icon\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n   199→                        <rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" />\n   200→                        <rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" />\n   201→                        <rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" />\n   202→                        <rect x=\"3\" y=\"14\" wid