[2026-03-14T21:09:44.299Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Dmz11dvPiDH5scJnbPoKcC","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions'\n     2→import { getSql } from './db.js'\n     3→\n     4→export default async (request: Request, _context: Context) => {\n     5→  const sql = getSql()\n     6→  const url = new URL(request.url)\n     7→  const headers = { 'Content-Type': 'application/json' }\n     8→\n     9→  if (request.method === 'GET') {\n    10→    const guestId = url.searchParams.get('guest_id')\n    11→    const propertyId = url.searchParams.get('property_id')\n    12→\n    13→    if (guestId) {\n    14→      const reviews = await sql`\n    15→        SELECT r.*, p.title as property_title\n    16→        FROM reviews r\n    17→        JOIN properties p ON p.id = r.property_id\n    18→        WHERE r.guest_id = ${guestId}\n    19→        ORDER BY r.created_at DESC\n    20→      `\n    21→      return new Response(JSON.stringify(reviews), { status: 200, headers })\n    22→    }\n    23→\n    24→    if (propertyId) {\n    25→      const reviews = await sql`\n    26→        SELECT r.*, u.name as guest_name, u.avatar_url as guest_avatar\n    27→        FROM reviews r\n    28→        JOIN users u ON u.id = r.guest_id\n    29→        WHERE r.property_id = ${propertyId}\n    30→        ORDER BY r.created_at DESC\n    31→      `\n    32→      return new Response(JSON.stringify(reviews), { status: 200, headers })\n    33→    }\n    34→\n    35→    return new Response(JSON.stringify({ error: 'guest_id or property_id is required' }), { status: 400, headers })\n    36→  }\n    37→\n    38→  if (request.method === 'POST') {\n    39→    const body = await request.json() as {\n    40→      booking_id: string\n    41→      property_id: string\n    42→      guest_id: string\n    43→      rating: number\n    44→      cleanliness: number\n    45→      accuracy: number\n    46→      communication: number\n    47→      location: number\n    48→      value: number\n    49→      comment?: string | null\n    50→    }\n    51→\n    52→    const { booking_id, property_id, guest_id, rating, cleanliness, accuracy, communication, location, value, comment } = body\n    53→\n    54→    if (!booking_id || !property_id || !guest_id || !rating) {\n    55→      return new Response(JSON.stringify({ error: 'Missing required fields' }), { status: 400, headers })\n    56→    }\n    57→\n    58→    const existingReview = await sql`SELECT id FROM reviews WHERE booking_id = ${booking_id}`\n    59→    if (existingReview.length > 0) {\n    60→      return new Response(JSON.stringify({ error: 'A review already exists for this booking' }), { status: 409, headers })\n    61→    }\n    62→\n    63→    const result = await sql`\n    64→      INSERT INTO reviews (id, booking_id, property_id, guest_id, rating, cleanliness, accuracy, communication, location, value, comment, created_at)\n    65→      VALUES (gen_random_uuid(), ${booking_id}, ${property_id}, ${guest_id}, ${rating}, ${cleanliness}, ${accuracy}, ${communication}, ${location}, ${value}, ${comment || null}, now())\n    66→      RETURNING *\n    67→    `\n    68→    const review = result[0]\n    69→    if (!review) {\n    70→      return new Response(JSON.stringify({ error: 'Failed to create review' }), { status: 500, headers })\n    71→    }\n    72→    return new Response(JSON.stringify(review), { status: 201, headers })\n    73→  }\n    74→\n    75→  if (request.method === 'DELETE') {\n    76→    const segments = url.pathname.split('/').filter(Boolean)\n    77→    const reviewId = segments[2]\n    78→    if (!reviewId) {\n    79→      return new Response(JSON.stringify({ error: 'Review ID is required' }), { status: 400, headers })\n    80→    }\n    81→    const result = await sql`DELETE FROM reviews WHERE id = ${reviewId} RETURNING *`\n    82→    const review = result[0]\n    83→    if (!review) {\n    84→      return new Response(JSON.stringify({ error: 'Review not found' }), { status: 404, headers })\n    85→    }\n    86→    return new Response(JSON.stringify(review), { status: 200, headers })\n    87→  }\n    88→\n    89→  return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers })\n    90→}\n    91→"}]},"parent_tool_use_id":null,"session_id":"4ea715f2-85be-4afc-bddb-cfbe4797b855","uuid":"acf4d7d9-0a4a-42a3-aaba-71a6132a4332","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/netlify/functions/reviews.ts","content":"import type { Context } from '@netlify/functions'\nimport { getSql } from './db.js'\n\nexport default async (request: Request, _context: Context) => {\n  const sql = getSql()\n  const url = new URL(request.url)\n  const headers = { 'Content-Type': 'application/json' }\n\n  if (request.method === 'GET') {\n    const guestId = url.searchParams.get('guest_id')\n    const propertyId = url.searchParams.get('property_id')\n\n    if (guestId) {\n      const reviews = await sql`\n        SELECT r.*, p.title as property_title\n        FROM reviews r\n        JOIN properties p ON p.id = r.property_id\n        WHERE r.guest_id = ${guestId}\n        ORDER BY r.created_at DESC\n      `\n      return new Response(JSON.stringify(reviews), { status: 200, headers })\n    }\n\n    if (propertyId) {\n      const reviews = await sql`\n        SELECT r.*, u.name as guest_name, u.avatar_url as guest_avatar\n        FROM reviews r\n        JOIN users u ON u.id = r.guest_id\n        WHERE r.property_id = ${propertyId}\n        ORDER BY r.created_at DESC\n      `\n      return new Response(JSON.stringify(reviews), { status: 200, headers })\n    }\n\n    return new Response(JSON.stringify({ error: 'guest_id or property_id is required' }), { status: 400, headers })\n  }\n\n  if (request.method === 'POST') {\n    const body = await request.json() as {\n      booking_id: string\n      property_id: string\n      guest_id: string\n      rating: number\n      cleanliness: number\n      accuracy: number\n      communication: number\n      location: number\n      value: number\n      comment?: string | null\n    }\n\n    const { booking_id, property_id, guest_id, rating, cleanliness, accuracy, communication, location, value, comment } = body\n\n    if (!booking_id || !property_id || !guest_id || !rating) {\n      return new Response(JSON.stringify({ error: 'Missing required fields' }), { status: 400, headers })\n    }\n\n    const existingReview = await sql`SELECT id FROM reviews WHERE booking_id = ${booking_id}`\n    if (existingReview.length > 0) {\n      return new Response(JSON.stringify({ error: 'A review already exists for this booking' }), { status: 409, headers })\n    }\n\n    const result = await sql`\n      INSERT INTO reviews (id, booking_id, property_id, guest_id, rating, cleanliness, accuracy, communication, location, value, comment, created_at)\n      VALUES (gen_random_uuid(), ${booking_id}, ${property_id}, ${guest_id}, ${rating}, ${cleanliness}, ${accuracy}, ${communication}, ${location}, ${value}, ${comment || null}, now())\n      RETURNING *\n    `\n    const review = result[0]\n    if (!review) {\n      return new Response(JSON.stringify({ error: 'Failed to create review' }), { status: 500, headers })\n    }\n    return new Response(JSON.stringify(review), { status: 201, headers })\n  }\n\n  if (request.method === 'DELETE') {\n    const segments = url.pathname.split('/').filter(Boolean)\n    const reviewId = segments[2]\n    if (!reviewId) {\n      return new Response(JSON.stringify({ error: 'Review ID is required' }), { status: 400, headers })\n    }\n    const result = await sql`DELETE FROM reviews WHERE id = ${reviewId} RETURNING *`\n    const review = result[0]\n    if (!review) {\n      return new Response(JSON.stringify({ error: 'Review not found' }), { status: 404, headers })\n    }\n    return new Response(JSON.stringify(review), { status: 200, headers })\n  }\n\n  return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers })\n}\n","numLines":91,"startLine":1,"totalLines":91}}}
