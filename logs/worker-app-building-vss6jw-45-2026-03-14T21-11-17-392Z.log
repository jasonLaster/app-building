er-form')).toBeVisible()\n    35→\n    36→      // Toggle back to login\n    37→      await page.getByTestId('auth-toggle-link').click()\n    38→\n    39→      await expect(page.getByTestId('login-form')).toBeVisible()\n    40→      await expect(page.getByTestId('login-email-input')).toBeVisible()\n    41→      await expect(page.getByTestId('login-submit-button')).toHaveText('Log In')\n    42→    })\n    43→\n    44→    test('Toggle preserves no stale input between modes', async ({ page }) => {\n    45→      await page.goto('/login')\n    46→\n    47→      // Type in login email field\n    48→      await page.getByTestId('login-email-input').fill('test@example.com')\n    49→      await expect(page.getByTestId('login-email-input')).toHaveValue('test@example.com')\n    50→\n    51→      // Toggle to register\n    52→      await page.getByTestId('auth-toggle-link').click()\n    53→\n    54→      // Register form fields should be empty\n    55→      await expect(page.getByTestId('register-name-input')).toHaveValue('')\n    56→      await expect(page.getByTestId('register-email-input')).toHaveValue('')\n    57→    })\n    58→  })\n    59→\n    60→  test.describe('LoginForm', () => {\n    61→    test('Login with valid email redirects to home', async ({ page }) => {\n    62→      await page.goto('/login')\n    63→\n    64→      await page.getByTestId('login-email-input').fill('emma@example.com')\n    65→      await page.getByTestId('login-submit-button').click()\n    66→\n    67→      await expect(page).toHaveURL('/', { timeout: 30000 })\n    68→    })\n    69→\n    70→    test('Login with empty email shows validation error', async ({ page }) => {\n    71→      await page.goto('/login')\n    72→\n    73→      await page.getByTestId('login-submit-button').click()\n    74→\n    75→      await expect(page.getByTestId('login-error')).toBeVisible()\n    76→      await expect(page.getByTestId('login-error')).toContainText('Email is required')\n    77→    })\n    78→\n    79→    