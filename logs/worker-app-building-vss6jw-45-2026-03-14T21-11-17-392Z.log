   setSuccessMessage('')\n    50→      return\n    51→    }\n    52→\n    53→    setErrors({})\n    54→    setSaving(true)\n    55→\n    56→    try {\n    57→      await dispatch(updateUser({\n    58→        id: user.id,\n    59→        name: name.trim(),\n    60→        bio: bio.trim() || null,\n    61→        phone: phone.trim() || null,\n    62→        avatar_url: avatarUrl.trim() || null,\n    63→      })).unwrap()\n    64→      setSuccessMessage('Profile updated')\n    65→      setTimeout(() => setSuccessMessage(''), 3000)\n    66→    } catch {\n    67→      setErrors({ form: 'Failed to update profile' })\n    68→    } finally {\n    69→      setSaving(false)\n    70→    }\n    71→  }\n    72→\n    73→  return (\n    74→    <div data-testid=\"profile-form\">\n    75→      {successMessage && (\n    76→        <div data-testid=\"profile-success-message\" className=\"flex items-center gap-2 mb-4 p-3 rounded-lg bg-success/10 text-success text-sm font-medium\">\n    77→          <Check size={16} />\n    78→          {successMessage}\n    79→        </div>\n    80→      )}\n    81→\n    82→      {errors.form && (\n    83→        <div data-testid=\"profile-error-message\" className=\"mb-4 p-3 rounded-lg bg-error/10 text-error text-sm font-medium\">\n    84→          {errors.form}\n    85→        </div>\n    86→      )}\n    87→\n    88→      <div className=\"flex items-center gap-4 mb-6\">\n    89→        <div className=\"w-20 h-20 rounded-full overflow-hidden bg-bg-secondary border border-border shrink-0\">\n    90→          {avatarUrl.trim() && isValidUrl(avatarUrl.trim()) ? (\n    91→            <img\n    92→              data-testid=\"avatar-preview\"\n    93→              src={avatarUrl.trim()}\n    94→              alt=\"Avatar preview\"\n    95→              className=\"w-full h-full object-cover\"\n    96→            />\n    97→          ) : (\n    98→            <div className=\"w-full h-full flex items-center justify-center text-text-secondary\">\n    99→              <UserIcon size={32} />\n   100→            </div>\n   101→          )}\n   102→        </div>\n   103→        <div>\n   104→          <h3 className=\"text-lg font-semibold text-text\">{user.name}</h3>\n   105→          <p className=\"text-sm text-text-secondary\">Member since {new Date(user.created_at.split('T')[0] + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}</p>\n   106→        </div>\n   107→      </div>\n   108→\n   109→      <div className=\"space-y-4\">\n   110→        <div>\n   111→          <label className=\"flex items-center gap-2 text-sm font-medium text-text-secondary mb-1.5\">\n   112→            <UserIcon size={14} />\n   113→            Name\n   114→          </label>\n   115→          <input\n   116→            data-testid=\"profile-name-input\"\n   117→            type=\"text\"\n   118→            value={name}\n   119→            onChange={(e) => setName(e.target.value)}\n   120→            className={`w-full px-3 py-2.5 rounded-lg border ${errors.name ? 'border-error' : 'border-border'} bg-bg text-text focus:outline-none focus:border-primary transition-colors`}\n   121→            placeholder=\"Your name\"\n   122→          />\n   123→          {errors.name && <p data-testid=\"name-error\" className=\"text-error text-xs mt-1\">{errors.name}</p>}\n   124→        </div>\n   125→\n   126→        <div>\n   127→          <label className=\"flex items-center gap-2 text-sm font-medium text-text-secondary mb-1.5\">\n   128→            <Mail size={14} />\n   129→            Email\n   130→          </label>\n   131→          <input\n   132→            data-testid=\"profile-email-input\"\n   133→            type=\"email\"\n   134→            value={user.email}\n   135→            readOnly\n   136→            disabled\n   137→            className=\"w-full px-3 py-2.5 rounded-lg border border-border bg-bg-secondary text-text-secondary cursor-not-allowed\"\n   138→          />\n   139→        </div>\n   140→\n   141→        <div>\n   142→          <label className=\"flex items-center gap-2 text-sm font-medium text-text-secondary mb-1.5\">\n   143→            <FileText size={14} />\n   144→            Bio\n   145→          </label>\n   146→          <textarea\n   147→            data-testid=\"profile-bio-input\"\n   148→            value={bio}\n   149→            onChange={(e) => setBio(e.target.value)}\n   150→            rows={3}\n   151→            className=\"w-full px-3 py-2.5 rounded-lg border border-border bg-bg text-text focus:outline-none focus:border-primary transition-colors resize-none\"\n   152→            placeholder=\"Tell us about yourself\"\n   153→          />\n   154→        </div>\n   155→\n   156→        <div>\n   157→          <label className=\"flex items-center gap-2 text-sm font-medium text-text-secondary mb-1.5\">\n   158→            <Phone size={14} />\n   159→            Phone\n   160→          </label>\n   161→          <input\n   162→            data-testid=\"profile-phone-input\"\n   163→            type=\"text\"\n   164→            value={phone}\n   165→            onChange={(e) => setPhone(e.target.value)}\n   166→            className=\"w-full px-3 py-2.5 rounded-lg border border-border bg-bg text-text focus:outline-none focus:border-primary transition-colors\"\n   167→            placeholder=\"Phone number\"\n   168→          />\n   169→        </div>\n   170→\n   171→        <div>\n   172→          <label className=\"flex items-center gap-2 text-sm font-medium text-text-secondary mb-1.5\">\n   173→            <Image size={14} />\n   174→            Avatar URL\n   175→          </label>\n   176→          <input\n   177→            data-testid=\"profile-avatar-input\"\n   178→            type=\"text\"\n   179→            value={avatarUrl}\n   180→            onChange={(e) => setAvatarUrl(e.target.value)}\n   181→            className={`w-full px-3 py-2.5 rounded-lg border ${errors.avatar_url ? 'border-error' : 'border-border'} bg-bg text-text focus:outline-none focus:border-primary transition-colors`}\n   182→            placeholder=\"https://example.com/avatar.jpg\"\n   183→          />\n   184→          {errors.avatar_url && <p data-testid=\"avatar-url-error\" className=\"text-error text-xs mt-1\">{errors.avatar_url}</p>}\n   185→        </div>\n   186→      </div>\n   187→\n   188→      <button\n   189→        data-testid=\"profile-save-button\"\n   190→        onClick={handleSave}\n   191→        disabled={saving}\n   192→        className=\"mt-6 w-full py-3 rounded-lg bg-primary text-white font-semibold hover:bg-primary-dark transition-colors disabled:opacity-50\"\n   193→      >\n   194→        {saving ? 'Saving...' : 'Save'}\n   195→      </button>\n   196→    </div>\n   197→  )\n   198→}\n   199→"}]},"parent_tool_use_id":null,"session_id":"4ea715f2-85be-4afc-bddb-cfbe4797b855","uuid":"ec0768a6-30ea-4a5c-97a8-bbebbe8c0be2","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/components/ProfileForm.tsx","content":"import { useState, useEffect } from 'react'\nimport { useDispatch } from 'react-redux'\nimport { User, updateUser } from '../slices/authSlice'\nimport type { AppDispatch } from '../store'\nimport { User as UserIcon, Mail, Phone, FileText, Image, Check } from 'lucide-react'\n\ninterface ProfileFormProps {\n  user: User\n}\n\nfunction isValidUrl(str: string): boolean {\n  try {\n    new URL(str)\n    return true\n  } catch {\n    return false\n  }\n}\n\nexport default function ProfileForm({ user }: ProfileFormProps) {\n  const dispatch = useDispatch<AppDispatch>()\n  const [name, setName] = useState(user.name)\n  const [bio, setBio] = useState(user.bio || '')\n  const [phone, setPhone] = useState(user.phone || '')\n  const [avatarUrl, setAvatarUrl] = useState(user.avatar_url || '')\n  const [saving, setSaving] = useState(false)\n  const [successMessage, setSuccessMessage] = useState('')\n  const [errors, setErrors] = useState<Record<string, string>>({})\n\n  useEffect(() => {\n    setName(user.name)\n    setBio(user.bio || '')\n    setPhone(user.phone || '')\n    setAvatarUrl(user.avatar_url || '')\n  }, [user])\n\n  const handleSave = async () => {\n    const newErrors: Record<string, string> = {}\n\n    if (!name.trim()) {\n      newErrors.name = 'Name is required'\n    }\n    if (avatarUrl.trim() && !isValidUrl(avatarUrl.trim())) {\n      newErrors.avatar_url = 'Please enter a valid URL'\n    }\n\n    if (Object.keys(newErrors).length > 0) {\n      setErrors(newErrors)\n      setSuccessMessage('')\n      return\n    }\n\n    setErrors({})\n    setSaving(true)\n\n    try {\n      await dispatch(updateUser({\n        id: user.id,\n        name: name.trim(),\n        bio: bio.trim() || null,\n        phone: phone.trim() || null,\n        avatar_url: avatarUrl.trim() || null,\n      })).unwrap()\n      setSuccessMessage('Profile updated')\n      setTimeout(() => setSuccessMessage(''), 3000)\n    } catch {\n      setErrors({ form: 'Failed to update profile' })\n    } finally {\n      setSaving(false)\n    }\n  }\n\n  return (\n    <div data-testid=\"profile-form\">\n      {successMessage && (\n        <div data-testid=\"profile-success-message\" className=\"flex items-center gap-2 mb-4 p-3 rounded-lg bg-success/10 text-success text-sm font-medium\">\n          <Check size={16} />\n          {successMessage}\n        </div>\n      )}\n\n      {errors.form && (\n        <div data-testid=\"profile-error-message\" className=\"mb-4 p-3 rounded-lg bg-error/10 text-error text-sm font-medium\">\n          {errors.form}\n        </div>\n      )}\n\n      <div className=\"flex items-center gap-4 mb-6\">\n        <div className=\"w-20 h-20 rounded-full overflow-hidden bg-bg-secondary border border-border shrink-0\">\n          {avatarUrl.trim() && isValidUrl(avatarUrl.trim()) ? (\n            <img\n              data-testid=\"avatar-preview\"\n              src={avatarUrl.trim()}\n              alt=\"Avatar preview\"\n              className=\"w-full h-full object-cover\"\n            />\n          ) : (\n            <div className=\"w-full h-full flex items-center justify-center text-text-secondary\">\n              <UserIcon size={32} />\n            </div>\n          )}\n        </div>\n        <div>\n          <h3 className=\"text-lg font-semibold text-text\">{user.name}</h3>\n          <p className=\"text-sm text-text-secondary\">Member since {new Date(user.created_at.split('T')[0] + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}</p>\n        </div>\n      </div>\n\n      <div className=\"space-y-4\">\n        <div>\n          <label className=\"flex items-center gap-2 text-sm font-medium text-text-secondary mb-1.5\">\n            <UserIcon size={14} />\n            Name\n          </label>\n          <input\n            data-testid=\"profile-name-input\"\n            type=\"text\"\n            value={name}\n            onChange={(e) => setName(e.target.value)}\n            className={`w-full px-3 py-2.5 rounded-lg border ${errors.name ? 'border-error' : 'border-border'} bg-bg text-text focus:outline-none focus:border-primary transition-colors`}\n            placeholder=\"Your name\"\n          />\n          {errors.name && <p data-testid=\"name-error\" className=\"text-error text-xs mt-1\">{errors.name}</p>}\n        </div>\n\n        <div>\n          <label className=\"flex items-center gap-2 text-sm font-medium text-text-secondary mb-1.5\">\n            <Mail size={14} />\n            Email\n          </label>\n          <input\n            data-testid=\"profile-email-input\"\n            type=\"email\"\n            value={user.email}\n            readOnly\n            disabled\n            className=\"w-full px-3 py-2.5 rounded-lg border border-border bg-bg-secondary text-text-secondary cursor-not-allowed\"\n          />\n        </div>\n\n        <div>\n          <label className=\"flex items-center gap-2 text-sm font-medium text-text-secondary mb-1.5\">\n            <FileText size={14} />\n            Bio\n          </label>\n          <textarea\n            data-testid=\"profile-bio-input\"\n            value={bio}\n            onChange={(e) => setBio(e.target.value)}\n            rows={3}\n            className=\"w-full px-3 py-2.5 rounded-lg border border-border bg-bg text-text focus:outline-none focus:border-primary transition-colors resize-none\"\n            placeholder=\"Tell us about yourself\"\n          />\n        </div>\n\n        <div>\n          <label className=\"flex items-center gap-2 text-sm font-medium text-text-secondary mb-1.5\">\n            <Phone size={14} />\n            Phone\n          </label>\n          <input\n            data-testid=\"profile-phone-input\"\n            type=\"text\"\n            value={phone}\n            onChange={(e) => setPhone(e.target.value)}\n            className=\"w-full px-3 py-2.5 rounded-lg border border-border bg-bg text-text focus:outline-none focus:border-primary transition-colors\"\n            placeholder=\"Phone number\"\n          />\n        </div>\n\n        <div>\n          <label className=\"flex items-center gap-2 text-sm font-medium text-text-secondary mb-1.5\">\n            <Image size={14} />\n            Avatar URL\n          </label>\n          <input\n            data-testid=\"profile-avatar-input\"\n            type=\"text\"\n            value={avatarUrl}\n            onChange={(e) => setAvatarUrl(e.target.value)}\n            className={`w-full px-3 py-2.5 rounded-lg border ${errors.avatar_url ? 'border-error' : 'border-border'} bg-bg text-text focus:outline-none focus:border-primary transition-colors`}\n            placeholder=\"https://example.com/avatar.jpg\"\n          />\n          {errors.avatar_url && <p data-testid=\"avatar-url-error\" className=\"text-error text-xs mt-1\">{errors.avatar_url}</p>}\n        </div>\n      </div>\n\n      <button\n        data-testid=\"profile-save-button\"\n        onClick={handleSave}\n        disabled={saving}\n        className=\"mt-6 w-full py-3 rounded-lg bg-primary text-white font-semibold hover:bg-primary-dark transition-colors disabled:opacity-50\"\n      >\n        {saving ? 'Saving...' : 'Save'}\n      </button>\n    </div>\n  )\n}\n","numLines":199,"startLine":1,"totalLines":199}}}
