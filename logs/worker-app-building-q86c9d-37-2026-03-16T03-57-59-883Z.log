[2026-03-16T03:56:02.194Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M35NAEeeFWXGp4ayESarcX","type":"tool_result","content":"     1→import { useState, useEffect, useRef, useCallback } from 'react'\n     2→import { SlidersHorizontal, X } from 'lucide-react'\n     3→import { useSelector, useDispatch } from 'react-redux'\n     4→import type { RootState, AppDispatch } from '../store'\n     5→import { fetchAmenities } from '../slices/amenitiesSlice'\n     6→import type { Amenity } from '../slices/propertiesSlice'\n     7→\n     8→interface FiltersPanelProps {\n     9→  minPrice: number\n    10→  maxPrice: number\n    11→  minBedrooms: number\n    12→  minBeds: number\n    13→  minBathrooms: number\n    14→  selectedAmenityIds: string[]\n    15→  onApplyFilters: (filters: {\n    16→    minPrice: number\n    17→    maxPrice: number\n    18→    minBedrooms: number\n    19→    minBeds: number\n    20→    minBathrooms: number\n    21→    amenityIds: string[]\n    22→  }) => void\n    23→  onReset: () => void\n    24→}\n    25→\n    26→export default function FiltersPanel({\n    27→  minPrice,\n    28→  maxPrice,\n    29→  minBedrooms,\n    30→  minBeds,\n    31→  minBathrooms,\n    32→  selectedAmenityIds,\n    33→  onApplyFilters,\n    34→  onReset,\n    35→}: FiltersPanelProps) {\n    36→  const dispatch = useDispatch<AppDispatch>()\n    37→  const amenities = useSelector((state: RootState) => state.amenities.items)\n    38→  const [isOpen, setIsOpen] = useState(false)\n    39→  const panelRef = useRef<HTMLDivElement>(null)\n    40→  const toggleRef = useRef<HTMLButtonElement>(null)\n    41→\n    42→  const [localMinPrice, setLocalMinPrice] = useState(minPrice)\n    43→  const [localMaxPrice, setLocalMaxPrice] = useState(maxPrice)\n    44→  const [localMinBedrooms, setLocalMinBedrooms] = useState(minBedrooms)\n    45→  const [localMinBeds, setLocalMinBeds] = useState(minBeds)\n    46→  const [localMinBathrooms, setLocalMinBathrooms] = useState(minBathrooms)\n    47→  const [localAmenityIds, setLocalAmenityIds] = useState<string[]>(selectedAmenityIds)\n    48→\n    49→  useEffect(() => {\n    50→    if (isOpen && amenities.length === 0) {\n    51→      dispatch(fetchAmenities())\n    52→    }\n    53→  }, [isOpen, amenities.length, dispatch])\n    54→\n    55→  const handleKeyDown = useCallback((e: KeyboardEvent) => {\n    56→    if (e.key === 'Escape') {\n    57→      setIsOpen(false)\n    58→      toggleRef.current?.focus()\n    59→    }\n    60→  }, [])\n    61→\n    62→  useEffect(() => {\n    63→    if (isOpen) {\n    64→      document.addEventListener('keydown', handleKeyDown)\n    65→    }\n    66→    return () => document.removeEventListener('keydown', handleKeyDown)\n    67→  }, [isOpen, handleKeyDown])\n    68→\n    69→  useEffect(() => {\n    70→    setLocalMinPrice(minPrice)\n    71→    setLocalMaxPrice(maxPrice)\n    72→    setLocalMinBedrooms(minBedrooms)\n    73→    setLocalMinBeds(minBeds)\n    74→    setLocalMinBathrooms(minBathrooms)\n    75→    setLocalAmenityIds(selectedAmenityIds)\n    76→  }, [minPrice, maxPrice, minBedrooms, minBeds, minBathrooms, selectedAmenityIds])\n    77→\n    78→  const toggleAmenity = (id: string) => {\n    79→    setLocalAmenityIds((prev) =>\n    80→      prev.includes(id) ? prev.filter((a) => a !== id) : [...prev, id]\n    81→    )\n    82→  }\n    83→\n    84→  const handleApply = () => {\n    85→    onApplyFilters({\n    86→      minPrice: localMinPrice,\n    87→      maxPrice: localMaxPrice,\n    88→      minBedrooms: localMinBedrooms,\n    89→      minBeds: localMinBeds,\n    90→      minBathrooms: localMinBathrooms,\n    91→      amenityIds: localAmenityIds,\n    92→    })\n    93→  }\n    94→\n    95→  const handleReset = () => {\n    96→    setLocalMinPrice(0)\n    97→    setLocalMaxPrice(0)\n    98→    setLocalMinBedrooms(0)\n    99→    setLocalMinBeds(0)\n   100→    setLocalMinBathrooms(0)\n   101→    setLocalAmenityIds([])\n   102→    onReset()\n   103→  }\n   104→\n   105→  // Group amenities by category\n   106→  const grouped = amenities.reduce<Record<string, Amenity[]>>((acc, a) => {\n   107→    const list = acc[a.category]\n   108→    if (!list) {\n   109→      acc[a.category] = [a]\n   110→    } else {\n   111→      list.push(a)\n   112→    }\n   113→    return acc\n   114→  }, {})\n   115→\n   116→  return (\n   117→    <div data-testid=\"filters-panel-container\">\n   118→      <button\n   119→        ref={toggleRef}\n   120→        data-testid=\"filters-toggle\"\n   121→        onClick={() => setIsOpen(!isOpen)}\n   122→        aria-expanded={isOpen}\n   123→        className=\"flex items-center gap-2 rounded-xl border border-border px-4 py-3 text-xs font-semibold text-text hover:border-text transition-colors\"\n   124→      >\n   125→        <SlidersHorizontal size={16} aria-hidden=\"true\" />\n   126→        Filters\n   127→      </button>\n   128→\n   129→      {isOpen && (\n   130→        <div\n   131→          ref={panelRef}\n   132→          data-testid=\"filters-panel\"\n   133→          role=\"dialog\"\n   134→          aria-label=\"Filters\"\n   135→          className=\"mt-3 rounded-xl border border-border bg-bg p-5 shadow-lg\"\n   136→        >\n   137→          <div className=\"flex items-center justify-between mb-4\">\n   138→            <h3 className=\"font-semibold text-text text-lg\">Filters</h3>\n   139→            <button onClick={() => { setIsOpen(false); toggleRef.current?.focus() }} aria-label=\"Close filters\" className=\"text-text-secondary hover:text-text\">\n   140→              <X size={20} aria-hidden=\"true\" />\n   141→            </button>\n   142→          </div>\n   143→\n   144→          {/* Price Range */}\n   145→          <fieldset className=\"mb-5\">\n   146→            <legend className=\"font-medium text-text text-sm mb-2\">Price range</legend>\n   147→            <div className=\"flex items-center gap-3\">\n   148→              <div className=\"flex-1\">\n   149→                <label htmlFor=\"filter-min-price\" className=\"text-xs text-text-secondary\">Min price</label>\n   150→                <input\n   151→                  id=\"filter-min-price\"\n   152→                  data-testid=\"filter-min-price\"\n   153→                  type=\"text\"\n   154→                  inputMode=\"decimal\"\n   155→                  value={localMinPrice || ''}\n   156→                  onChange={(e) => setLocalMinPrice(parseFloat(e.target.value) || 0)}\n   157→                  placeholder=\"$0\"\n   158→                  className=\"w-full mt-1 rounded-lg border border-border px-3 py-2 text-sm outline-none focus:border-text\"\n   159→                />\n   160→              </div>\n   161→              <span className=\"text-text-secondary mt-4\" aria-hidden=\"true\">–</span>\n   162→              <div className=\"flex-1\">\n   163→                <label htmlFor=\"filter-max-price\" className=\"text-xs text-text-secondary\">Max price</label>\n   164→                <input\n   165→                  id=\"filter-max-price\"\n   166→                  data-testid=\"filter-max-price\"\n   167→                  type=\"text\"\n   168→                  inputMode=\"decimal\"\n   169→                  value={localMaxPrice || ''}\n   170→                  onChange={(e) => setLocalMaxPrice(parseFloat(e.target.value) || 0)}\n   171→                  placeholder=\"Any\"\n   172→                  className=\"w-full mt-1 rounded-lg border border-border px-3 py-2 text-sm outline-none focus:border-text\"\n   173→                />\n   174→              </div>\n   175→            </div>\n   176→          </fieldset>\n   177→\n   178→          {/* Rooms */}\n   179→          <fieldset className=\"mb-5\">\n   180→            <legend className=\"font-medium text-text text-sm mb-2\">Rooms and beds</legend>\n   181→            <div className=\"grid grid-cols-3 gap-3\">\n   182→              <div>\n   183→                <label htmlFor=\"filter-min-bedrooms\" className=\"text-xs text-text-secondary\">Bedrooms</label>\n   184→                <select\n   185→                  id=\"filter-min-bedrooms\"\n   186→                  data-testid=\"filter-min-bedrooms\"\n   187→                  value={localMinBedrooms}\n   188→                  onChange={(e) => setLocalMinBedrooms(parseInt(e.target.value, 10))}\n   189→                  className=\"w-full mt-1 rounded-lg border border-border px-3 py-2 text-sm outline-none focus:border-text bg-bg\"\n   190→                >\n   191→                  <option value={0}>Any</option>\n   192→                  {[1, 2, 3, 4, 5, 6, 7, 8].map((n) => (\n   193→                    <option key={n} value={n}>{n}+</option>\n   194→                  ))}\n   195→                </select>\n   196→              </div>\n   197→              <div>\n   198→                <label htmlFor=\"filter-min-beds\" className=\"text-xs text-text-secondary\">Beds</label>\n   199→                <select\n   200→                  id=\"filter-min-beds\"\n   201→                  data-testid=\"filter-min-beds\"\n   202→                  value={localMinBeds}\n   203→                  onChange={(e) => setLocalMinBeds(parseInt(e.target.value, 10))}\n   204→                  className=\"w-full mt-1 rounded-lg border border-border px-3 py-2 text-sm outline-none focus:border-text bg-bg\"\n   205→                >\n   206→                  <option value={0}>Any</option>\n   207→                  {[1, 2, 3, 4, 5, 6, 7, 8].map((n) => (\n   208→                    <option key={n} value={n}>{n}+</option>\n   209→                  ))}\n   210→                </select>\n   211→              </div>\n   212→              <div>\n   213→                <label htmlFor=\"filter-min-bathrooms\" className=\"text-xs text-text-secondary\">Bathrooms</label>\n   214→                <select\n   215→                  id=\"filter-min-bathrooms\"\n   216→                  data-testid=\"filter-min-bathrooms\"\n   217→                  value={localMinBathrooms}\n   218→                  onChange={(e) => setLocalMinBathrooms(parseInt(e.target.value, 10))}\n   219→                  className=\"w-full mt-1 rounded-lg border border-border px-3 py-2 text-sm outline-none focus:border-text bg-bg\"\n   220→                >\n   221→                  <option value={0}>Any</option>\n   222→                  {[1, 2, 3, 4, 5, 6, 7, 8].map((n) => (\n   223→                    <option key={n} value={n}>{n}+</option>\n   224→                  ))}\n   225→                </select>\n   226→              </div>\n   227→            </div>\n   228→          </fieldset>\n   229→\n   230→          {/* Amenities */}\n   231→          {Object.keys(grouped).length > 0 && (\n   232→            <div className=\"mb-5\">\n   233→              <h4 className=\"font-medium text-text text-sm mb-2\">Amenities</h4>\n   234→              {Object.entries(grouped).map(([category, items]) => (\n   235→                <div key={category} className=\"mb-3\">\n   236→                  <p className=\"text-xs text-text-secondary font-medium mb-1.5\">{category}</p>\n   237→                  <div className=\"flex flex-wrap gap-2\">\n   238→                    {items.map((amenity) => (\n   239→                      <label\n   240→                        key={amenity.id}\n   241→                        data-testid={`amenity-checkbox-${amenity.id}`}\n   242→                        className=\"flex items-center gap-1.5 cursor-pointer\"\n   243→                      >\n   244→                        <input\n   245→                          type=\"checkbox\"\n   246→                          checked={localAmenityIds.includes(amenity.id)}\n   247→                          onChange={() => toggleAmenity(amenity.id)}\n   248→                          className=\"rounded accent-primary\"\n   249→                        />\n   250→                        <span className=\"text-sm text-text\">{amenity.name}</span>\n   251→                      </label>\n   2