[2026-03-16T03:56:01.486Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BGfFuvAoHLvTSP1wpnXYLT","type":"tool_result","content":"     1→import { useEffect, useCallback } from 'react'\n     2→import { useSelector, useDispatch } from 'react-redux'\n     3→import type { RootState, AppDispatch } from '../store'\n     4→import { fetchProperties, setFilters, resetFilters, setPage } from '../slices/propertiesSlice'\n     5→import { fetchFavorites } from '../slices/favoritesSlice'\n     6→import SearchBar from '../components/SearchBar'\n     7→import CategoryFilter from '../components/CategoryFilter'\n     8→import PropertyGrid from '../components/PropertyGrid'\n     9→import FiltersPanel from '../components/FiltersPanel'\n    10→import Pagination from '../components/Pagination'\n    11→\n    12→export default function Home() {\n    13→  const dispatch = useDispatch<AppDispatch>()\n    14→  const { items, loading, totalPages, filters } = useSelector((state: RootState) => state.properties)\n    15→  const currentUser = useSelector((state: RootState) => state.auth.currentUser)\n    16→\n    17→  useEffect(() => {\n    18→    dispatch(fetchProperties(filters))\n    19→  }, [dispatch, filters])\n    20→\n    21→  useEffect(() => {\n    22→    if (currentUser) {\n    23→      dispatch(fetchFavorites(currentUser.id))\n    24→    }\n    25→  }, [dispatch, currentUser])\n    26→\n    27→  const handleSearch = useCallback((searchFilters: { city: string; checkIn: string; checkOut: string; guests: number }) => {\n    28→    dispatch(setFilters({\n    29→      city: searchFilters.city,\n    30→      checkIn: searchFilters.checkIn,\n    31→      checkOut: searchFilters.checkOut,\n    32→      guests: searchFilters.guests,\n    33→      page: 1,\n    34→    }))\n    35→  }, [dispatch])\n    36→\n    37→  const handleCategorySelect = useCallback((type: string) => {\n    38→    dispatch(setFilters({ propertyType: type, page: 1 }))\n    39→  }, [dispatch])\n    40→\n    41→  const handleApplyFilters = useCallback((panelFilters: {\n    42→    minPrice: number\n    43→    maxPrice: number\n    44→    minBedrooms: number\n    45→    minBeds: number\n    46→    minBathrooms: number\n    47→    amenityIds: string[]\n    48→  }) => {\n    49→    dispatch(setFilters({ ...panelFilters, page: 1 }))\n    50→  }, [dispatch])\n    51→\n    52→  const handleResetFilters = useCallback(() => {\n    53→    dispatch(resetFilters())\n    54→  }, [dispatch])\n    55→\n    56→  const handlePageChange = useCallback((page: number) => {\n    57→    dispatch(setPage(page))\n    58→    window.scrollTo({ top: 0, behavior: 'smooth' })\n    59→  }, [dispatch])\n    60→\n    61→  return (\n    62→    <div data-testid=\"home-page\">\n    63→      <h1 className=\"sr-only\">Find your next stay</h1>\n    64→\n    65→      {/* Search section */}\n    66→      <div className=\"py-4 px-6 max-sm:px-3 border-b border-border\">\n    67→        <SearchBar\n    68→          onSearch={handleSearch}\n    69→          initialCity={filters.city}\n    70→          initialCheckIn={filters.checkIn}\n    71→          initialCheckOut={filters.checkOut}\n    72→          initialGuests={filters.guests}\n    73→        />\n    74→      </div>\n    75→\n    76→      {/* Category filter + Filters button */}\n    77→      <div className=\"sticky top-[80px] z-40 bg-bg border-b border-border\">\n    78→        <div className=\"max-w-[1280px] mx-auto px-6 max-sm:px-3 flex items-center gap-4\">\n    79→          <div className=\"flex-1 overflow-hidden\">\n    80→            <CategoryFilter\n    81→              selectedType={filters.propertyType}\n    82→              onSelectType={handleCategorySelect}\n    83→            />\n    84→          </div>\n    85→          <FiltersPanel\n    86→            minPrice={filters.minPrice}\n    87→            maxPrice={filters.maxPrice}\n    88→            minBedrooms={filters.minBedrooms}\n    89→            minBeds={filters.minBeds}\n    90→            minBathrooms={filters.minBathrooms}\n    91→            selectedAmenityIds={filters.amenityIds}\n    92→            onApplyFilters={handleApplyFilters}\n    93→            onReset={handleResetFilters}\n    94→          />\n    95→        </div>\n    96→      </div>\n    97→\n    98→      {/* Property grid */}\n    99→      <div className=\"max-w-[1280px] mx-auto px-6 max-sm:px-3 pt-6 pb-8\">\n   100→        <PropertyGrid properties={items} loading={loading} />\n   101→\n   102→        <Pagination\n   103→          currentPage={filters.page}\n   104→          totalPages={totalPages}\n   105→          onPageChange={handlePageChange}\n   106→        />\n   107→      </div>\n   108→    </div>\n   109→  )\n   110→}\n   111→"}]},"parent_tool_use_id":"toolu_01CYGGPhXBEfozbwVpf8WeKw","session_id":"86161195-4169-4a92-bdd7-a3ad98ce3da2","uuid":"b2f139a1-d3fc-44de-8d62-95d634eb4fb4"}
