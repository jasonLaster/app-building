ue={localMinBathrooms}\n   218→                  onChange={(e) => setLocalMinBathrooms(parseInt(e.target.value, 10))}\n   219→                  className=\"w-full mt-1 rounded-lg border border-border px-3 py-2 text-sm outline-none focus:border-text bg-bg\"\n   220→                >\n   221→                  <option value={0}>Any</option>\n   222→                  {[1, 2, 3, 4, 5, 6, 7, 8].map((n) => (\n   223→                    <option key={n} value={n}>{n}+</option>\n   224→                  ))}\n   225→                </select>\n   226→              </div>\n   227→            </div>\n   228→          </fieldset>\n   229→\n   230→          {/* Amenities */}\n   231→          {Object.keys(grouped).length > 0 && (\n   232→            <div className=\"mb-5\">\n   233→              <h4 className=\"font-medium text-text text-sm mb-2\">Amenities</h4>\n   234→              {Object.entries(grouped).map(([category, items]) => (\n   235→                <div key={category} className=\"mb-3\">\n   236→                  <p className=\"text-xs text-text-secondary font-medium mb-1.5\">{category}</p>\n   237→                  <div className=\"flex flex-wrap gap-2\">\n   238→                    {items.map((amenity) => (\n   239→                      <label\n   240→                        key={amenity.id}\n   241→                        data-testid={`amenity-checkbox-${amenity.id}`}\n   242→                        className=\"flex items-center gap-1.5 cursor-pointer\"\n   243→                      >\n   244→                        <input\n   245→                          type=\"checkbox\"\n   246→                          checked={localAmenityIds.includes(amenity.id)}\n   247→                          onChange={() => toggleAmenity(amenity.id)}\n   248→                          className=\"rounded accent-primary\"\n   249→                        />\n   250→                        <span className=\"text-sm text-text\">{amenity.name}</span>\n   251→                      </label>\n   2