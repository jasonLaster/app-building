[2026-03-16T03:56:01.703Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XddPUoHBy3LxLsw8rgRGPW","type":"tool_result","content":"     1→import { useState } from 'react'\n     2→import { Search } from 'lucide-react'\n     3→\n     4→interface SearchBarProps {\n     5→  onSearch: (filters: { city: string; checkIn: string; checkOut: string; guests: number }) => void\n     6→  initialCity?: string\n     7→  initialCheckIn?: string\n     8→  initialCheckOut?: string\n     9→  initialGuests?: number\n    10→}\n    11→\n    12→export default function SearchBar({ onSearch, initialCity = '', initialCheckIn = '', initialCheckOut = '', initialGuests = 0 }: SearchBarProps) {\n    13→  const [city, setCity] = useState(initialCity)\n    14→  const [checkIn, setCheckIn] = useState(initialCheckIn)\n    15→  const [checkOut, setCheckOut] = useState(initialCheckOut)\n    16→  const [guests, setGuests] = useState(initialGuests)\n    17→\n    18→  const today = new Date().toISOString().split('T')[0]\n    19→\n    20→  const checkOutMin = (() => {\n    21→    if (!checkIn) return today\n    22→    const d = new Date(checkIn + 'T00:00:00')\n    23→    d.setDate(d.getDate() + 1)\n    24→    return d.toISOString().split('T')[0]\n    25→  })()\n    26→\n    27→  const handleSubmit = (e: React.FormEvent) => {\n    28→    e.preventDefault()\n    29→    onSearch({ city, checkIn, checkOut, guests })\n    30→  }\n    31→\n    32→  const handleGuestsChange = (value: string) => {\n    33→    const num = parseInt(value, 10)\n    34→    if (isNaN(num) || num < 1) {\n    35→      setGuests(1)\n    36→    } else {\n    37→      setGuests(num)\n    38→    }\n    39→  }\n    40→\n    41→  return (\n    42→    <form\n    43→      data-testid=\"search-bar\"\n    44→      onSubmit={handleSubmit}\n    45→      role=\"search\"\n    46→      aria-label=\"Search properties\"\n    47→      className=\"flex items-center rounded-full border border-border bg-bg shadow-sm hover:shadow-md transition-shadow max-w-[850px] mx-auto\"\n    48→    >\n    49→      <div className=\"flex-1 min-w-0 px-7 py-3.5\">\n    50→        <label htmlFor=\"search-location\" className=\"block text-xs font-bold text-text\">Where</label>\n    51→        <input\n    52→          id=\"search-location\"\n    53→          data-testid=\"search-location\"\n    54→          type=\"text\"\n    55→          placeholder=\"Search destinations\"\n    56→          value={city}\n    57→          onChange={(e) => setCity(e.target.value)}\n    58→          className=\"w-full text-sm text-text-secondary outline-none bg-transparent placeholder-text-secondary mt-0.5\"\n    59→        />\n    60→      </div>\n    61→\n    62→      <div className=\"w-px h-8 bg-border shrink-0\" aria-hidden=\"true\" />\n    63→\n    64→      <div className=\"px-5 py-3.5\">\n    65→        <span className=\"block text-xs font-bold text-text\" id=\"search-when-label\">Check in</span>\n    66→        <div className=\"flex items-center gap-2\" role=\"group\" aria-labelledby=\"search-when-label\">\n    67→          <label htmlFor=\"search-checkin\" className=\"sr-only\">Check-in date</label>\n    68→          <input\n    69→            id=\"search-checkin\"\n    70→            data-testid=\"search-checkin\"\n    71→            type=\"date\"\n    72→            value={checkIn}\n    73→            min={today}\n    74→            onChange={(e) => {\n    75→              setCheckIn(e.target.value)\n    76→              if (checkOut && e.target.value >= checkOut) {\n    77→                setCheckOut('')\n    78→              }\n    79→            }}\n    80→            className=\"text-sm text-text-secondary outline-none bg-transparent w-[120px] mt-0.5\"\n    81→          />\n    82→        </div>\n    83→      </div>\n    84→\n    85→      <div className=\"w-px h-8 bg-border shrink-0\" aria-hidden=\"true\" />\n    86→\n    87→      <div className=\"px-5 py-3.5\">\n    88→        <label htmlFor=\"search-checkout\" className=\"block text-xs font-bold text-text\">Check out</label>\n    89→        <input\n    90→          id=\"search-checkout\"\n    91→          data-testid=\"search-checkout\"\n    92→          type=\"date\"\n    93→          value={checkOut}\n    94→          min={checkOutMin}\n    95→          onChange={(e) => setCheckOut(e.target.value)}\n    96→          className=\"text-sm text-text-secondary outline-none bg-transparent w-[120px] mt-0.5\"\n    97→        />\n    98→      </div>\n    99→\n   100→      <div className=\"w-px h-8 bg-border shrink-0\" aria-hidden=\"true\" />\n   101→\n   102→      <div className=\"flex items-center gap-2 pl-5 pr-2 py-2\">\n   103→        <div>\n   104→          <label htmlFor=\"search-guests\" className=\"block text-xs font-bold text-text\">Who</label>\n   105→          <input\n   106→            id=\"search-guests\"\n   107→            data-testid=\"search-guests\"\n   108→            type=\"number\"\n   109→            min={1}\n   110→            placeholder=\"Add guests\"\n   111→            value={guests || ''}\n   112→            onChange={(e) => handleGuestsChange(e.target.value)}\n   113→            className=\"w-24 text-sm text-text-secondary outline-none bg-transparent placeholder-text-secondary mt-0.5\"\n   114→          />\n   115→        </div>\n   116→        <button\n   117→          data-testid=\"search-button\"\n   118→          type=\"submit\"\n   119→          aria-label=\"Search\"\n   120→          className=\"flex items-center justify-center gap-2 rounded-full bg-primary p-3.5 text-white hover:bg-primary-dark transition-colors shrink-0\"\n   121→        >\n   122→          <Search size={16} aria-hidden=\"true\" />\n   123→        </button>\n   124→      </div>\n   125→    </form>\n   126→  )\n   127→}\n   128→"}]},"parent_tool_use_id":"toolu_01CYGGPhXBEfozbwVpf8WeKw","session_id":"86161195-4169-4a92-bdd7-a3ad98ce3da2","uuid":"160ef9f1-f350-4313-8856-a3143800ebb9"}
