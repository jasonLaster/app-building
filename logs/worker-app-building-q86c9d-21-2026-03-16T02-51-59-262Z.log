stify-center gap-2 py-3 rounded-lg font-semibold text-white transition-colors\"\n    48→          style={{ backgroundColor: '#FF5A5F' }}\n    49→          onMouseEnter={(e) => (e.currentTarget.style.backgroundColor = '#E04E52')}\n    50→          onMouseLeave={(e) => (e.currentTarget.style.backgroundColor = '#FF5A5F')}\n    51→        >\n    52→          <Home size={18} />\n    53→          Become a Host\n    54→        </button>\n    55→      )}\n    56→\n    57→      {showConfirm && (\n    58→        <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/50\" data-testid=\"become-host-dialog\">\n    59→          <div className=\"bg-bg rounded-xl p-6 max-w-sm w-full mx-4 shadow-xl\">\n    60→            <h3 className=\"text-lg font-semibold text-text mb-2\">Become a Host</h3>\n    61→            <p className=\"text-text-secondary text-sm mb-6\">\n    62→              Are you sure you want to become a host? You'll be able to list properties and manage bookings.\n    63→            </p>\n    64→            <div className=\"flex gap-3\">\n    65→              <button\n    66→                data-testid=\"become-host-cancel\"\n    67→                onClick={() => setShowConfirm(false)}\n    68→                disabled={loading}\n    69→                className=\"flex-1 py-2.5 rounded-lg border border-border text-text font-medium hover:bg-bg-secondary transition-colors\"\n    70→              >\n    71→                Cancel\n    72→              </button>\n    73→              <button\n    74→                data-testid=\"become-host-confirm\"\n    75→                onClick={handleConfirm}\n    76→                disabled={loading}\n    77→                className=\"flex-1 py-2.5 rounded-lg bg-primary text-white font-medium hover:bg-primary-dark transition-colors disabled:opacity-50\"\n    78→              >\n    79→                {loading ? 'Processing...' : 'Confirm'}\n    80→              </button>\n    81→            </div>\n    82→          </div>\n    83→        </div>\n    84→      )}\n    85→    </div>\n    86→  )\n    87→}\n    88→"}]},"parent_tool_use_id":null,"session_id":"46aba454-c405-4166-8a7e-41539161faa4","uuid":"7282791b-adc0-4522-ab56-db7ef57f6eed","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/components/BecomeHostButton.tsx","content":"import { useState } from 'react'\nimport { useDispatch } from 'react-redux'\nimport { becomeHost } from '../slices/authSlice'\nimport type { AppDispatch } from '../store'\nimport { Home, Check } from 'lucide-react'\n\ninterface BecomeHostButtonProps {\n  userId: string\n  isHost: boolean\n}\n\nexport default function BecomeHostButton({ userId, isHost }: BecomeHostButtonProps) {\n  const dispatch = useDispatch<AppDispatch>()\n  const [showConfirm, setShowConfirm] = useState(false)\n  const [loading, setLoading] = useState(false)\n  const [successMessage, setSuccessMessage] = useState('')\n\n  if (isHost && !successMessage) return null\n\n  const handleConfirm = async () => {\n    setLoading(true)\n    try {\n      await dispatch(becomeHost(userId)).unwrap()\n      setShowConfirm(false)\n      setSuccessMessage('You are now a host!')\n      setTimeout(() => setSuccessMessage(''), 3000)\n    } catch {\n      // Error handled by slice\n    } finally {\n      setLoading(false)\n    }\n  }\n\n  return (\n    <div data-testid=\"become-host-section\">\n      {successMessage && (\n        <div data-testid=\"become-host-success\" className=\"flex items-center gap-2 mb-4 p-3 rounded-lg bg-success/10 text-success text-sm font-medium\">\n          <Check size={16} />\n          {successMessage}\n        </div>\n      )}\n\n      {!isHost && (\n        <button\n          data-testid=\"become-host-button\"\n          onClick={() => setShowConfirm(true)}\n          className=\"w-full flex items-center justify-center gap-2 py-3 rounded-lg font-semibold text-white transition-colors\"\n          style={{ backgroundColor: '#FF5A5F' }}\n          onMouseEnter={(e) => (e.currentTarget.style.backgroundColor = '#E04E52')}\n          onMouseLeave={(e) => (e.currentTarget.style.backgroundColor = '#FF5A5F')}\n        >\n          <Home size={18} />\n          Become a Host\n        </button>\n      )}\n\n      {showConfirm && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/50\" data-testid=\"become-host-dialog\">\n          <div className=\"bg-bg rounded-xl p-6 max-w-sm w-full mx-4 shadow-xl\">\n            <h3 className=\"text-lg font-semibold text-text mb-2\">Become a Host</h3>\n            <p className=\"text-text-secondary text-sm mb-6\">\n              Are you sure you want to become a host? You'll be able to list properties and manage bookings.\n            </p>\n            <div className=\"flex gap-3\">\n              <button\n                data-testid=\"become-host-cancel\"\n                onClick={() => setShowConfirm(false)}\n                disabled={loading}\n                className=\"flex-1 py-2.5 rounded-lg border border-border text-text font-medium hover:bg-bg-secondary transition-colors\"\n              >\n                Cancel\n              </button>\n              <button\n                data-testid=\"become-host-confirm\"\n                onClick={handleConfirm}\n                disabled={loading}\n                className=\"flex-1 py-2.5 rounded-lg bg-primary text-white font-medium hover:bg-primary-dark transition-colors disabled:opacity-50\"\n              >\n                {loading ? 'Processing...' : 'Confirm'}\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  )\n}\n","numLines":88,"startLine":1,"totalLines":88}}}
