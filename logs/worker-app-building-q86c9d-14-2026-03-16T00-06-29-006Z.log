ill-text text-text\" />\n    42→                <span className=\"font-semibold text-text\">{rating.toFixed(2)}</span>\n    43→                <span className=\"text-text-secondary\">·</span>\n    44→                <span className=\"text-text-secondary underline\">({reviewCount} {reviewCount === 1 ? 'review' : 'reviews'})</span>\n    45→              </button>\n    46→            ) : (\n    47→              <span className=\"text-text-secondary\">New</span>\n    48→            )}\n    49→          </div>\n    50→        </div>\n    51→      </div>\n    52→\n    53→      <div className=\"flex items-center gap-4 mt-6 pt-6 border-t border-border\">\n    54→        <button data-testid=\"host-info\" className=\"flex items-center gap-3 cursor-pointer\" onClick={() => {\n    55→          const el = document.getElementById('host-info-card')\n    56→          if (el) el.scrollIntoView({ behavior: 'smooth' })\n    57→        }}>\n    58→          {property.host_avatar ? (\n    59→            <img\n    60→              data-testid=\"host-avatar\"\n    61→              src={property.host_avatar}\n    62→              alt={property.host_name || 'Host'}\n    63→              className=\"w-10 h-10 rounded-full object-cover\"\n    64→            />\n    65→          ) : (\n    66→            <div data-testid=\"host-avatar\" className=\"w-10 h-10 rounded-full bg-text flex items-center justify-center text-sm font-semibold text-white\">\n    67→              {property.host_name?.charAt(0) || 'H'}\n    68→            </div>\n    69→          )}\n    70→          <div className=\"text-left\">\n    71→            <p className=\"text-sm font-semibold text-text\">Hosted by {property.host_name}</p>\n    72→            {yearsHosting && (\n    73→              <p className=\"text-xs text-text-secondary\">{yearsHosting} {yearsHosting === 1 ? 'year' : 'years'} hosting</p>\n    74→            )}\n    75→          </div>\n    76→        </button>\n    77→      </div>\n    78→    </div>\n    79→  )\n    80→}\n    81→"}]},"parent_tool_use_id":null,"session_id":"a4c6f06f-287c-4f14-81da-eb182281b13a","uuid":"7498f622-8dd2-4e15-87fa-fa0b21a18770","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/components/PropertyHeader.tsx","content":"import { Star } from 'lucide-react'\nimport type { Property } from '../slices/propertiesSlice'\n\ninterface PropertyHeaderProps {\n  property: Property\n}\n\nexport default function PropertyHeader({ property }: PropertyHeaderProps) {\n  const rating = Number(property.avg_rating) || 0\n  const reviewCount = property.review_count || 0\n\n  const scrollToReviews = () => {\n    const el = document.getElementById('reviews-section')\n    if (el) {\n      el.scrollIntoView({ behavior: 'smooth' })\n    }\n  }\n\n  const hostingSince = property.host_since ? new Date(property.host_since) : null\n  const yearsHosting = hostingSince\n    ? Math.max(1, Math.floor((Date.now() - hostingSince.getTime()) / (365.25 * 24 * 60 * 60 * 1000)))\n    : null\n\n  return (\n    <div data-testid=\"property-header\" className=\"pb-6 border-b border-border\">\n      <div className=\"flex items-start justify-between gap-4\">\n        <div className=\"flex-1\">\n          <h1 className=\"text-[22px] font-semibold text-text\">\n            {property.title}\n          </h1>\n          <p className=\"text-sm text-text-secondary mt-1\">\n            {property.city}, {property.country}\n          </p>\n          <div className=\"flex items-center gap-1.5 mt-1 text-sm\">\n            {reviewCount > 0 ? (\n              <button\n                data-testid=\"review-count-link\"\n                className=\"flex items-center gap-1 hover:underline cursor-pointer\"\n                onClick={scrollToReviews}\n              >\n                <Star size={14} className=\"fill-text text-text\" />\n                <span className=\"font-semibold text-text\">{rating.toFixed(2)}</span>\n                <span className=\"text-text-secondary\">·</span>\n                <span className=\"text-text-secondary underline\">({reviewCount} {reviewCount === 1 ? 'review' : 'reviews'})</span>\n              </button>\n            ) : (\n              <span className=\"text-text-secondary\">New</span>\n            )}\n          </div>\n        </div>\n      </div>\n\n      <div className=\"flex items-center gap-4 mt-6 pt-6 border-t border-border\">\n        <button data-testid=\"host-info\" className=\"flex items-center gap-3 cursor-pointer\" onClick={() => {\n          const el = document.getElementById('host-info-card')\n          if (el) el.scrollIntoView({ behavior: 'smooth' })\n        }}>\n          {property.host_avatar ? (\n            <img\n              data-testid=\"host-avatar\"\n              src={property.host_avatar}\n              alt={property.host_name || 'Host'}\n              className=\"w-10 h-10 rounded-full object-cover\"\n            />\n          ) : (\n            <div data-testid=\"host-avatar\" className=\"w-10 h-10 rounded-full bg-text flex items-center justify-center text-sm font-semibold text-white\">\n              {property.host_name?.charAt(0) || 'H'}\n            </div>\n          )}\n          <div className=\"text-left\">\n            <p className=\"text-sm font-semibold text-text\">Hosted by {property.host_name}</p>\n            {yearsHosting && (\n              <p className=\"text-xs text-text-secondary\">{yearsHosting} {yearsHosting === 1 ? 'year' : 'years'} hosting</p>\n            )}\n          </div>\n        </button>\n      </div>\n    </div>\n  )\n}\n","numLines":81,"startLine":1,"totalLines":81}}}
