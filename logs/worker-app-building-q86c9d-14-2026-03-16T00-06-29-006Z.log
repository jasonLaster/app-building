[2026-03-15T23:35:43.620Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01He2B5Xoq6miUJ9ZUpLeS4W","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test'\n     2→import { truncateAndSeed } from '../scripts/seed-db'\n     3→\n     4→test.beforeAll(async () => {\n     5→  const dbUrl = process.env.DATABASE_URL\n     6→  if (dbUrl) {\n     7→    await truncateAndSeed(dbUrl)\n     8→  }\n     9→})\n    10→\n    11→// b1111111: Loft, 4 guests, 1 bedroom, 2 beds, 1 bath, New York, US, host Sarah Chen, 1 review (5.0)\n    12→const PROPERTY_WITH_REVIEWS = 'b1111111-1111-1111-1111-111111111111'\n    13→// b2222222: Villa, 8 guests, 4 bedrooms, 5 beds, 3 bath, Miami, US, host Sarah Chen, 0 reviews\n    14→const PROPERTY_NO_REVIEWS = 'b2222222-2222-2222-2222-222222222222'\n    15→// b4444444: Apartment, 2 guests, 1 bedroom, 1 bed, 1 bath, Austin, TX, host Mike Johnson, 1 review (4.0)\n    16→const PROPERTY_SINGULAR = 'b4444444-4444-4444-4444-444444444444'\n    17→\n    18→test.describe('Property Detail - PropertyHeader', () => {\n    19→  test('Property header displays title, location, rating summary, and host info', async ({ page }) => {\n    20→    await page.goto(`/properties/${PROPERTY_WITH_REVIEWS}`)\n    21→\n    22→    const header = page.getByTestId('property-header')\n    23→    await expect(header).toBeVisible({ timeout: 30000 })\n    24→\n    25→    // Title\n    26→    await expect(header.locator('h1')).toHaveText('Cozy Downtown Loft with City Views')\n    27→\n    28→    // Location\n    29→    await expect(header).toContainText('New York, United States')\n    30→\n    31→    // Rating summary - property has 1 review with rating 5\n    32→    const reviewLink = page.getByTestId('review-count-link')\n    33→    await expect(reviewLink).toBeVisible()\n    34→    await expect(reviewLink).toContainText('5.0')\n    35→    await expect(reviewLink).toContainText('(1 review)')\n    36→\n    37→    // Host info\n    38→    await expect(header).toContainText('Hosted by')\n    39→    await expect(header).toContainText('Sarah Chen')\n    40→\n    41→    // Host avatar\n    42→    const avatar = page.getByTestId('host-avatar')\n    43→    await expect(avatar).toBeVisible()\n    44→  })\n    45→\n    46→  test('Property header shows \"New\" when property has no reviews', async ({ page }) => {\n    47→    await page.goto(`/properties/${PROPERTY_NO_REVIEWS}`)\n    48→\n    49→    const header = page.getByTestId('property-header')\n    50→    await expect(header).toBeVisible({ timeout: 30000 })\n    51→\n    52→    // Should show \"New\" instead of rating\n    53→    await expect(header).toContainText('New')\n    54→\n    55→    // No review count link\n    56→    await expect(page.getByTestId('review-count-link')).not.toBeVisible()\n    57→  })\n    58→\n    59→  test('Clicking review count scrolls to or navigates to reviews section', async ({ page }) => {\n    60→    await page.goto(`/properties/${PROPERTY_WITH_REVIEWS}`)\n    61→\n    62→    const reviewLink = page.getByTestId('review-count-link')\n    63→    await expect(reviewLink).toBeVisible({ timeout: 30000 })\n    64→\n    65→    // Click the review count\n    66→    await reviewLink.click()\n    67→\n    68→    // Reviews section should be visible (scrolled into view)\n    69→    const reviewsSection = page.getByTestId('reviews-section')\n    70→    await expect(reviewsSection).toBeVisible()\n    71→    await expect(reviewsSection).toBeInViewport({ timeout: 5000 })\n    72→  })\n    73→\n    74→  test('Property header displays host avatar as clickable element', async ({ page }) => {\n    75→    await page.goto(`/properties/${PROPERTY_WITH_REVIEWS}`)\n    76→\n    77→    const header = page.getByTestId('property-header')\n    78→    await expect(header).toBeVisible({ timeout: 30000 })\n    79→\n    80→    // Host avatar should be visible and circular (img element)\n    81→    const avatar = page.getByTestId('host-avatar')\n    82→    await expect(avatar).toBeVisible()\n    83→    await expect(avatar).toHaveAttribute('alt', 'Sarah Chen')\n    84→\n    85→    // Avatar should be inside a clickable element\n    86→    const hostInfo = page.getByTestId('host-info')\n    87→    await expect(hostInfo).toBeVisible()\n    88→\n    89→    // Host name displayed next to avatar\n    90→    await expect(hostInfo).toContainText('Sarah Chen')\n    91→  })\n    92→})\n    93→\n    94→test.describe('Property Detail - PropertyInfo', () => {\n    95→  test('Property info section displays all property details', async ({ page }) => {\n    96→    // b2222222: Villa, 8 guests, 4 bedrooms, 5 beds, 3 bathrooms\n    97→    await page.goto(`/properties/${PROPERTY_NO_REVIEWS}`)\n    98→\n    99→    const info = page.getByTestId('property-info')\n   100→    await expect(info).toBeVisible({ timeout: 30000 })\n   101→\n   102→    await expect(info).toContainText('Villa')\n   103→    await expect(info).toContainText('8 guests')\n   104→    await expect(info).toContainText('4 bedrooms')\n   105→    await expect(info).toContainText('5 beds')\n   106→    await expect(info).toContainText('3 bathrooms')\n   107→  })\n   108→\n   109→  test('Property info section displays check-in and check-out times', async ({ page }) => {\n   110→    // Default check_in_time is '15:00', check_out_time is '11:00'\n   111→    await page.goto(`/properties/${PROPERTY_WITH_REVIEWS}`)\n   112→\n   113→    const info = page.getByTestId('property-info')\n   114→    await expect(info).toBeVisible({ timeout: 30000 })\n   115→\n   116→    // 15:00 → 3:00 PM\n   117→    await expect(info).toContainText('Check-in: 3:00 PM')\n   118→    // 11:00 → 11:00 AM\n   119→    await expect(info).toContainText('Check-out: 11:00 AM')\n   120→  })\n   121→\n   122→  test('Property info section handles singular and plural labels correctly', async ({ page }) => {\n   123→    // b4444444: 2 guests, 1 bedroom, 1 bed, 1 bathroom\n   124→    await page.goto(`/properties/${PROPERTY_SINGULAR}`)\n   125→\n   126→    const info = page.getByTestId('property-info')\n   127→    await expect(info).toBeVisible({ timeout: 30000 })\n   128→\n   129→    await expect(info).toContainText('1 bedroom')\n   130→    await expect(info).toContainText('1 bed')\n   131→    await expect(info).toContainText('1 bathroom')\n   132→    // 2 guests should be plural\n   133→    await expect(info).toContainText('2 guests')\n   134→  })\n   135→})\n   136→\n   137→test.describe('Property Detail - PropertyDescription', () => {\n   138→  test('Property description displays full description text', async ({ page }) => {\n   139→    // b4444444 has a short description (under 300 chars)\n   140→    await page.goto(`/properties/${PROPERTY_SINGULAR}`)\n   141→\n   142→    const desc = page.getByTestId('property-description')\n   143→    await expect(desc).toBeVisible({ timeout: 30000 })\n   144→\n   145→    await expect(desc).toContainText('Stylish apartment in the vibrant South Congress neighborhood')\n   146→    await expect(desc).toContainText('Features a rooftop pool and gym access')\n   147→\n   148→    // No Show more button for short description\n   149→    await expect(page.getByTestId('description-toggle')).not.toBeVisible()\n   150→  })\n   151→\n   152→  test('Long description shows a \"Show more\" toggle', async ({ page }) => {\n   153→    // b2222222 has a long description (over 300 chars)\n   154→    await page.goto(`/properties/${PROPERTY_NO_REVIEWS}`)\n   155→\n   156→    const desc = page.getByTestId('property-description')\n   157→    await expect(desc).toBeVisible({ timeout: 30000 })\n   158→\n   159→    // Description should be truncated\n   160→    const descText = desc.locator('p')\n   161→    await expect(descText).toContainText('...')\n   162→\n   163→    // Show more button should be visible\n   164→    const toggle = page.getByTestId('description-toggle')\n   165→    await expect(toggle).toBeVisible()\n   166→    await expect(toggle).toHaveText('Show more')\n   167→  })\n   168→\n   169→  test('Clicking \"Show more\" expands the full description', async ({ page }) => {\n   170→    await page.goto(`/properties/${PROPERTY_NO_REVIEWS}`)\n   171→\n   172→    const desc = page.getByTestId('property-description')\n   173→    await expect(desc).toBeVisible({ timeout: 30000 })\n   174→\n   175→    const toggle = page.getByTestId('description-toggle')\n   176→    await expect(toggle).toHaveText('Show more')\n   177→\n   178→    // Click Show more\n   179→    await toggle.click()\n   180→\n   181→    // Full description should be visible (no ellipsis truncation)\n   182→    const descText = desc.locator('p')\n   183→    await expect(descText).toContainText('sipping your favorite drinks')\n   184→\n   185→    // Toggle should now say Show less\n   186→    await expect(toggle).toHaveText('Show less')\n   187→  })\n   188→\n   189→  test('Clicking \"Show less\" collapses the description back', async ({ page }) => {\n   190→    await page.goto(`/properties/${PROPERTY_NO_REVIEWS}`)\n   191→\n   192→    const desc = page.getByTestId('property-description')\n   193→    await expect(desc).toBeVisible({ timeout: 30000 })\n   194→\n   195→    // Expand first\n   196→    const toggle = page.getByTestId('description-toggle')\n   197→    await toggle.click()\n   198→    await expect(toggle).toHaveText('Show less')\n   199→\n   200→    // Click Show less\n   201→    await toggle.click()\n   202→\n   203→    // Should be truncated again\n   204→    const descText = desc.locator('p')\n   205→    await expect(descText).toContainText('...')\n   206→    await expect(toggle).toHaveText('Show more')\n   207→  })\n   208→\n   209→  test('Show more/less toggle is functional on repeated use', async ({ page }) => {\n   210→    await page.goto(`/properties/${PROPERTY_NO_REVIEWS}`)\n   211→\n   212→    const desc = page.getByTestId('property-description')\n   213→    await expect(desc).toBeVisible({ timeout: 30000 })\n   214→\n   215→    const toggle = page.getByTestId('description-toggle')\n   216→    const descText = desc.locator('p')\n   217→\n   218→    // Click Show more\n   219→    await toggle.click()\n   220→    await expect(toggle).toHaveText('Show less')\n   221→    await expect(descText).not.toContainText('...')\n   222→\n   223→    // Click Show less\n   224→    await toggle.click()\n   225→    await expect(toggle).toHaveText('Show more')\n   226→    await expect(descText).toContainText('...')\n   227→\n   228→    // Click Show more again\n   229→    await toggle.click()\n   230→    await expect(toggle).toHaveText('Show less')\n   231→    await expect(descText).toContainText('sipping your favorite drinks')\n   232→  })\n   233→})\n   234→"}]},"parent_tool_use_id":"toolu_01KwhHSvB5XiLzKPWgrGfp5Z","session_id":"a4c6f06f-287c-4f14-81da-eb182281b13a","uuid":"d1091e6d-b580-4e15-8450-cafd49fbbd24"}
