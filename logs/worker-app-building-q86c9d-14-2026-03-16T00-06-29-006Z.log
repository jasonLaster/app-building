tring, value: string) {\n    49→  const envPath = join(appDir, '.env')\n    50→  let content = ''\n    51→  if (existsSync(envPath)) {\n    52→    content = readFileSync(envPath, 'utf-8')\n    53→    const lines = content.split('\\n')\n    54→    const idx = lines.findIndex(l => l.startsWith(key + '='))\n    55→    if (idx >= 0) {\n    56→      lines[idx] = `${key}=${value}`\n    57→      content = lines.join('\\n')\n    58→    } else {\n    59→      content = content.trimEnd() + '\\n' + `${key}=${value}` + '\\n'\n    60→    }\n    61→  } else {\n    62→    content = `${key}=${value}\\n`\n    63→  }\n    64→  writeFileSync(envPath, content)\n    65→}\n    66→\n    67→function removeEnvValue(key: string) {\n    68→  const envPath = join(appDir, '.env')\n    69→  if (!existsSync(envPath)) return\n    70→  const content = readFileSync(envPath, 'utf-8')\n    71→  const lines = content.split('\\n').filter(l => !l.startsWith(key + '='))\n    72→  writeFileSync(envPath, lines.join('\\n'))\n    73→}\n    74→\n    75→const testFile = process.argv[2]\n    76→if (!testFile) {\n    77→  console.error('Usage: npm run test <test-file>')\n    78→  process.exit(1)\n    79→}\n    80→\n    81→async function run() {\n    82→  const env = readEnv()\n    83→  const neonProjectId = env['NEON_PROJECT_ID'] || process.env['NEON_PROJECT_ID'] || ''\n    84→  const neonApiKey = process.env['NEON_API_KEY'] || ''\n    85→  const replayApiKey = process.env['RECORD_REPLAY_API_KEY'] || ''\n    86→\n    87→  if (!neonProjectId || !neonApiKey) {\n    88→    console.error('Missing NEON_PROJECT_ID or NEON_API_KEY')\n    89→    process.exit(1)\n    90→  }\n    91→\n    92→  // Step 1: Kill stale processes\n    93→  tryExec('pkill -f \"netlify dev\" 2>/dev/null || true', { stdio: 'ignore' })\n    94→  tryExec('pkill -f \"vite\" 2>/dev/null || true', { stdio: 'ignore' })\n    95→\n    96→  // Step 2: Clean up stale test branches\n    97→  try {\n    98→    const branchesResp = execSync(\n    99→      `curl -s \"https://console.neon.tech/api/v2/projects/${neonProjectId}/branches\" -H \"Authorization: Bearer ${neonApiKey}\"`,\n   100→      { encoding: 'utf-8', timeout: 15000 }\n   101→    )\n   102→    const branches = JSON.parse(branchesResp).branches || []\n   103→    for (const b of branches) {\n   104→      if (typeof b.name === 'string' && b.name.startsWith('test-run-')) {\n   105→        tryExec(\n   106→          `curl -s -X DELETE \"https://console.neon.tech/api/v2/projects/${neonProjectId}/branches/${b.id}\" -H \"Authorization: Bearer ${neonApiKey}\"`,\n   107→          { stdio: 'ignore', timeout: 10000 }\n   108→        )\n   109→        log(`Cleaned up stale branch: ${b.name}`)\n   110→      }\n   111→    }\n   112→  } catch { log('Warning: could not clean stale branches') }\n   113→\n   114→  // Step 3: Create ephemeral branch\n   115→  const branchName = `test-run-${Date.now()}`\n   116→  let branchId = ''\n   117→  let testDbUrl = ''\n   118→\n   119→  try {\n   120→    const resp = execSync(\n   121→      `curl -s -X POST \"https://console.neon.tech/api/v2/projects/${neonProjectId}/branches\" -H \"Authorization: Bearer ${neonApiKey}\" -H \"Content-Type: application/json\" -d '{\"branch\": {\"name\": \"${branchName}\"}, \"endpoints\": [{\"type\": \"read_write\"}]}'`,\n   122→      { encoding: 'utf-8', timeout: 30000 }\n   123→    )\n   124→    const data = JSON.parse(resp)\n   125→    branchId = data.branch?.id || ''\n   126→    const connUri = data.connection_uris?.[0]?.connection_uri\n   127→    if (connUri) {\n   128→      testDbUrl = connUri\n   129→    } else {\n   130→      const ep = data.endpoints?.[0]\n   131→      const host = ep?.host || ''\n   132→      const role = data.roles?.[0]?.name || 'neondb_owner'\n   133→      const pwResp = execSync(\n   134→        `curl -s \"https://console.neon.tech/api/v2/projects/${neonProjectId}/branches/${branchId}/roles/${role}/reveal_password\" -H \"Authorization: Bearer ${neonApiKey}\"`,\n   135→        { encoding: 'utf-8', timeout: 10000 }\n   136→      )\n   137→      const password = JSON.parse(pwResp).password || ''\n   138→      testDbUrl = `postgresql://${role}:${password}@${host}/neondb?sslmode=require`\n   139→    }\n   140→    log(`Created branch: ${branchName} (${branchId})`)\n   141→    log(`Test DB URL: ${testDbUrl.replace(/:[^:@]+@/, ':***@')}`)\n   142→  } catch (e) {\n   143→    log(`Failed to create branch: ${e}`)\n   144→    writeLog()\n   145→    console.error('Failed to create Neon test branch')\n   146→    process.exit(1)\n   147→  }\n   148→\n   149→  // Wait for branch to be ready\n   150→  await new Promise(resolve => setTimeout(resolve, 3000))\n   151→\n   152→  // Step 4: Initialize schema and seed\n   153→  try {\n   154→    await initSchema(testDbUrl)\n   155→    log('Schema initialized')\n   156→    await truncateAndSeed(testDbUrl)\n   157→    log('Database seeded')\n   158→  } catch (e) {\n   159→    log(`Schema/seed failed: ${e}`)\n   160→    writeLog()\n   161→    console.error('Schema/seed failed — see ' + logFile)\n   162→    cleanup(branchId, neonProjectId, neonApiKey)\n   163→    process.exit(1)\n   164→  }\n   165→\n   166→  // Step 5: Write DATABASE_URL to .env so netlify dev functions can access it\n   167→  writeEnvValue('DATABASE_URL', testDbUrl)\n   168→\n   169→  // Step 6: Remove stale recordings\n   170→  tryExec('npx replayio remove --all 2>/dev/null || true', { stdio: 'ignore', cwd: appDir })\n   171→\n   172→  // Step 7: Run Playwright\n   173→  let playwrightExitCode = 0\n   174→  try {\n   175→    const pwOutput = execSync(\n   176→      `npx playwright test ${testFile} --retries 0 --workers 1`,\n   177→      {\n   178→        cwd: appDir,\n   179→        encoding: 'utf-8',\n   180→        stdio: ['ignore', 'pipe', 'pipe'],\n   181→        timeout: 300000,\n   182→        env: {\n   183→          ...process.env,\n   184→          DATABASE_URL: testDbUrl,\n   185→          RECORD_REPLAY_API_KEY: replayApiKey,\n   186→        },\n   187→      }\n   188→    )\n   189→    log('=== Playwright Output ===\\n' + pwOutput)\n   190→  } catch (e: unknown) {\n   191→    const err = e as { status?: number; stdout?: string; stderr?: string }\n   192→    playwrightExitCode = err.status || 1\n   193→    log('=== Playwright Output ===\\n' + (err.stdout || '') + '\\n' + (err.stderr || ''))\n   194→  }\n   195→\n   196→  // Step 8: Parse results\n   197→  let passed = 0\n   198→  let failed = 0\n   199→  try {\n   200→    const resultsPath = join(appDir, 'test-results', 'results.json')\n   201→    if (existsSync(resultsPath)) {\n   202→      const results = JSON.parse(readFileSync(resultsPath, 'utf-8'))\n   203→      for (const suite of results.suites || []) {\n   204→        for (const spec of suite.specs || []) {\n   205→          for (const test of spec.tests || []) {\n   206→            if (test.status === 'expected') passed++\n   207→            else if (test.status === 'unexpected') failed++\n   208→          }\n   209→        }\n   210→      }\n   211→    }\n   212→  } catch { /* ok */ }\n   213→\n   214→  // Step 9: Handle failure - upload recordings\n   215→  let uploadedId = ''\n   216→  if (playwrightExitCode !== 0) {\n   217→    try {\n   218→      const recLog = readFileSync(join(process.env['HOME'] || '~', '.replay', 'recordings.log'), 'utf-8')\n   219→      const lines = recLog.trim().split('\\n').filter(l => l.trim())\n   220→      const entries: Array<Record<string, unknown>> = []\n   221→      for (const l of lines) {\n   222→        try { entries.push(JSON.parse(l)) } catch { /* skip */ }\n   223→      }\n   224→\n   225→      const recordings: Record<string, { id: string; duration: number; result: string; title: string }> = {}\n   226→      for (const entry of entries) {\n   227→        if (entry.kind === 'createRecording') {\n   228→          recordings[entry.id as string] = { id: entry.id as string, duration: 0, result: '', title: '' }\n   229→        }\n   230→        if (entry.kind === 'addMetadata') {\n   231→          const meta = entry.metadata as Record<string, Record<string, string>> | undefined\n   232→          const rec = recordings[entry.id as string]\n   233→          if (rec && meta?.test) {\n   234→            rec.result = meta.test.result || ''\n   235→            rec.title = meta.test.title || ''\n   236→          }\n   237→        }\n   238→        if (entry.kind === 'writeFinished') {\n   239→          const rec = recordings[entry.id as string]\n   240→          if (rec) {\n   241→            rec.duration = (entry.duration as number) || 0\n   242→          }\n   243→        }\n   244→      }\n   245→\n   246→      const metadataBlock = Object.values(recordings)\n   247→        .filter(r => r.result)\n   248→        .map(r => JSON.stringify(r))\n   249→      if (metadataBlock.length) {\n   250→        log('\\n=== REPLAY RECORDINGS METADATA ===')\n   251→        for (const m of metadataBlock) log(m)\n   252→        log('=== END REPLAY RECORDINGS METADATA ===')\n   253→      }\n   254→\n   255→      const failedRecs = Object.values(recordings)\n   256→        .filter(r => r.result === 'failed' || r.result === 'timedOut')\n   257→        .sort((a, b) => b.duration - a.duration)\n   258→\n   259→      if (failedRecs[0]) {\n   260→        try {\n   261→          const uploadOut = execSync(`npx replayio upload ${failedRecs[0].id}`, {\n   262→            encoding: 'utf-8',\n   263→            cwd: appDir,\n   264→            timeout: 60000,\n   265→            env: { ...process.env, RECORD_REPLAY_API_KEY: replayApiKey },\n   266→          })\n   267→          uploadedId = failedRecs[0].id\n   268→          log(`REPLAY UPLOADED: ${uploadedId}`)\n   269→          log(uploadOut)\n   270→        } catch (ue) {\n   271→          log(`Replay upload failed: ${ue}`)\n   272→        }\n   273→      }\n   274→    } catch { log('Could not parse recordings') }\n   275→  }\n   276→\n   277→  // Step 10: Cleanup\n   278→  removeEnvValue('DATABASE_URL')\n   279→  cleanup(branchId, neonProjectId, neonApiKey)\n   280→  tryExec('npx replayio remove --all 2>/dev/null || true', { stdio: 'ignore', cwd: appDir })\n   281→\n   282→  writeLog()\n   283→\n   284→  // Step 11: Summary\n   285→  const parts = []\n   286→  if (passed > 0) parts.push(`${passed} passed`)\n   287→  if (failed > 0) parts.push(`${failed} failed`)\n   288→  if (uploadedId) parts.push(`recording: ${uploadedId}`)\n   289→  const summary = parts.length > 0\n   290→    ? parts.join(', ') + ` — see ${logFile}`\n   291→    : `tests completed — see ${logFile}`\n   292→  console.log(summary)\n   293→\n   294→  process.exit(playwrightExitCode)\n   295→}\n   296→\n   297→function cleanup(branchId: string, projectId: string, apiKey: string) {\n   298→  tryExec('pkill -f \"netlify dev\" 2>/dev/null || true', { stdio: 'ignore' })\n   299→  if (branchId) {\n   300→    tryExec(\n   301→      `curl -s -X DELETE \"https://console.neon.tech/api/v2/projects/${projectId}/branches/${branchId}\" -H \"Authorization: Bearer ${apiKey}\"`,\n   302→      { stdio: 'ignore', timeout: 10000 }\n   303→    )\n   304→  }\n   305→}\n   306→\n   307→run()\n   308→"}]},"parent_tool_use_id":null,"session_id":"a4c6f06f-287c-4f14-81da-eb182281b13a","uuid":"6559f8c9-6ae6-4b26-9731-3af0d2626952","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/scripts/test.ts","content":"import { execSync } from 'child_process'\nimport { readFileSync, writeFileSync, mkdirSync, existsSync, readdirSync } from 'fs'\nimport { join } from 'path'\nimport { initSchema } from './schema'\nimport { truncateAndSeed } from './seed-db'\n\nconst appDir = join(import.meta.dirname, '..')\nconst logDir = join(appDir, 'logs')\nmkdirSync(logDir, { recursive: true })\n\n// Find next log number\nconst existingLogs = readdirSync(logDir).filter(f => f.startsWith('test-run-'))\nconst maxNum = existingLogs.reduce((max, f) => {\n  const m = f.match(/test-run-(\\d+)\\.log/)\n  return m ? Math.max(max, parseInt(m[1]!)) : max\n}, 0)\nconst logFile = join(logDir, `test-run-${maxNum + 1}.log`)\nlet logContent = ''\n\nfunction log(msg: string) {\n  logContent += msg + '\\n'\n}\n\nfunction writeLog() {\n  writeFileSync(logFile, logContent)\n}\n\nfunction readEnv(): Record<string, string> {\n  const envPath = join(appDir, '.env')\n  if (!existsSync(envPath)) return {}\n  const lines = readFileSync(envPath, 'utf-8').split('\\n')\n  const env: Record<string, string> = {}\n  for (const line of lines) {\n    const trimmed = line.trim()\n    if (!trimmed || trimmed.startsWith('#')) continue\n    const eqIdx = trimmed.indexOf('=')\n    if (eqIdx > 0) {\n      env[trimmed.slice(0, eqIdx)] = trimmed.slice(eqIdx + 1)\n    }\n  }\n  return env\n}\n\nfunction tryExec(cmd: string, opts?: Parameters<typeof execSync>[1]) {\n  try { execSync(cmd, opts) } catch { /* ignored */ }\n}\n\nfunction writeEnvValue(key: string, value: string) {\n  const envPath = join(appDir, '.env')\n  let content = ''\n  if (existsSync(envPath)) {\n    content = readFileSync(envPath, 'utf-8')\n    const lines = content.split('\\n')\n    const idx = lines.findIndex(l => l.startsWith(key + '='))\n    if (idx >= 0) {\n      lines[idx] = `${key}=${value}`\n      content = lines.join('\\n')\n    } else {\n      content = content.trimEnd() + '\\n' + `${key}=${value}` + '\\n'\n    }\n  } else {\n    content = `${key}=${value}\\n`\n  }\n  writeFileSync(envPath, content)\n}\n\nfunction removeEnvValue(key: string) {\n  const envPath = join(appDir, '.env')\n  if (!existsSync(envPath)) return\n  const content = readFileSync(envPath, 'utf-8')\n  const lines = content.split('\\n').filter(l => !l.startsWith(key + '='))\n  writeFileSync(envPath, lines.join('\\n'))\n}\n\nconst testFile = process.argv[2]\nif (!testFile) {\n  console.error('Usage: npm run test <test-file>')\n  process.exit(1)\n}\n\nasync function run() {\n  const env = readEnv()\n  const neonProjectId = env['NEON_PROJECT_ID'] || process.env['NEON_PROJECT_ID'] || ''\n  const neonApiKey = process.env['NEON_API_KEY'] || ''\n  const replayApiKey = process.env['RECORD_REPLAY_API_KEY'] || ''\n\n  if (!neonProjectId || !neonApiKey) {\n    console.error('Missing NEON_PROJECT_ID or NEON_API_KEY')\n    process.exit(1)\n  }\n\n  // Step 1: Kill stale processes\n  tryExec('pkill -f \"netlify dev\" 2>/dev/null || true', { stdio: 'ignore' })\n  tryExec('pkill -f \"vite\" 2>/dev/null || true', { stdio: 'ignore' })\n\n  // Step 2: Clean up stale test branches\n  try {\n    const branchesResp = execSync(\n      `curl -s \"https://console.neon.tech/api/v2/projects/${neonProjectId}/branches\" -H \"Authorization: Bearer ${neonApiKey}\"`,\n      { encoding: 'utf-8', timeout: 15000 }\n    )\n    const branches = JSON.parse(branchesResp).branches || []\n    for (const b of branches) {\n      if (typeof b.name === 'string' && b.name.startsWith('test-run-')) {\n        tryExec(\n          `curl -s -X DELETE \"https://console.neon.tech/api/v2/projects/${neonProjectId}/branches/${b.id}\" -H \"Authorization: Bearer ${neonApiKey}\"`,\n          { stdio: 'ignore', timeout: 10000 }\n        )\n        log(`Cleaned up stale branch: ${b.name}`)\n      }\n    }\n  } catch { log('Warning: could not clean stale branches') }\n\n  // Step 3: Create ephemeral branch\n  const branchName = `test-run-${Date.now()}`\n  let branchId = ''\n  let testDbUrl = ''\n\n  try {\n    const resp = execSync(\n      `curl -s -X POST \"https://console.neon.tech/api/v2/projects/${neonProjectId}/branches\" -H \"Authorization: Bearer ${neonApiKey}\" -H \"Content-Type: application/json\" -d '{\"branch\": {\"name\": \"${branchName}\"}, \"endpoints\": [{\"type\": \"read_write\"}]}'`,\n      { encoding: 'utf-8', timeout: 30000 }\n    )\n    const data = JSON.parse(resp)\n    branchId = data.branch?.id || ''\n    const connUri = data.connection_uris?.[0]?.connection_uri\n    if (connUri) {\n      testDbUrl = connUri\n    } else {\n      const ep = data.endpoints?.[0]\n      const host = ep?.host || ''\n      const role = data.roles?.[0]?.name || 'neondb_owner'\n      const pwResp = execSync(\n        `curl -s \"https://console.neon.tech/api/v2/projects/${neonProjectId}/branches/${branchId}/roles/${role}/reveal_password\" -H \"Authorization: Bearer ${neonApiKey}\"`,\n        { encoding: 'utf-8', timeout: 10000 }\n      )\n      const password = JSON.parse(pwResp).password || ''\n      testDbUrl = `postgresql://${role}:${password}@${host}/neondb?sslmode=require`\n    }\n    log(`Created branch: ${branchName} (${branchId})`)\n    log(`Test DB URL: ${testDbUrl.replace(/:[^:@]+@/, ':***@')}`)\n  } catch (e) {\n    log(`Failed to create branch: ${e}`)\n    writeLog()\n    console.error('Failed to create Neon test branch')\n    process.exit(1)\n  }\n\n  // Wait for branch to be ready\n  await new Promise(resolve => setTimeout(resolve, 3000))\n\n  // Step 4: Initialize schema and seed\n  try {\n    await initSchema(testDbUrl)\n    log('Schema initialized')\n    await truncateAndSeed(testDbUrl)\n    log('Database seeded')\n  } catch (e) {\n    log(`Schema/seed failed: ${e}`)\n    writeLog()\n    console.error('Schema/seed failed — see ' + logFile)\n    cleanup(branchId, neonProjectId, neonApiKey)\n    process.exit(1)\n  }\n\n  // Step 5: Write DATABASE_URL to .env so netlify dev functions can access it\n  writeEnvValue('DATABASE_URL', testDbUrl)\n\n  // Step 6: Remove stale recordings\n  tryExec('npx replayio remove --all 2>/dev/null || true', { stdio: 'ignore', cwd: appDir })\n\n  // Step 7: Run Playwright\n  let playwrightExitCode = 0\n  try {\n    const pwOutput = execSync(\n      `npx playwright test ${testFile} --retries 0 --workers 1`,\n      {\n        cwd: appDir,\n        encoding: 'utf-8',\n        stdio: ['ignore', 'pipe', 'pipe'],\n        timeout: 300000,\n        env: {\n          ...process.env,\n          DATABASE_URL: testDbUrl,\n          RECORD_REPLAY_API_KEY: replayApiKey,\n        },\n      }\n    )\n    log('=== Playwright Output ===\\n' + pwOutput)\n  } catch (e: unknown) {\n    const err = e as { status?: number; stdout?: string; stderr?: string }\n    playwrightExitCode = err.status || 1\n    log('=== Playwright Output ===\\n' + (err.stdout || '') + '\\n' + (err.stderr || ''))\n  }\n\n  // Step 8: Parse results\n  let passed = 0\n  let failed = 0\n  try {\n    const resultsPath = join(appDir, 'test-results', 'results.json')\n    if (existsSync(resultsPath)) {\n      const results = JSON.parse(readFileSync(resultsPath, 'utf-8'))\n      for (const suite of results.suites || []) {\n        for (const spec of suite.specs || []) {\n          for (const test of spec.tests || []) {\n            if (test.status === 'expected') passed++\n            else if (test.status === 'unexpected') failed++\n          }\n        }\n      }\n    }\n  } catch { /* ok */ }\n\n  // Step 9: Handle failure - upload recordings\n  let uploadedId = ''\n  if (playwrightExitCode !== 0) {\n    try {\n      const recLog = readFileSync(join(process.env['HOME'] || '~', '.replay', 'recordings.log'), 'utf-8')\n      const lines = recLog.trim().split('\\n').filter(l => l.trim())\n      const entries: Array<Record<string, unknown>> = []\n      for (const l of lines) {\n        try { entries.push(JSON.parse(l)) } catch { /* skip */ }\n      }\n\n      const recordings: Record<string, { id: string; duration: number; result: string; title: string }> = {}\n      for (const entry of entries) {\n        if (entry.kind === 'createRecording') {\n          recordings[entry.id as string] = { id: entry.id as string, duration: 0, result: '', title: '' }\n        }\n        if (entry.kind === 'addMetadata') {\n          const meta = entry.metadata as Record<string, Record<string, string>> | undefined\n          const rec = recordings[entry.id as string]\n          if (rec && meta?.test) {\n            rec.result = meta.test.result || ''\n            rec.title = meta.test.title || ''\n          }\n        }\n        if (entry.kind === 'writeFinished') {\n          const rec = recordings[entry.id as string]\n          if (rec) {\n            rec.duration = (entry.duration as number) || 0\n          }\n        }\n      }\n\n      const metadataBlock = Object.values(recordings)\n        .filter(r => r.result)\n        .map(r => JSON.stringify(r))\n      if (metadataBlock.length) {\n        log('\\n=== REPLAY RECORDINGS METADATA ===')\n        for (const m of metadataBlock) log(m)\n        log('=== END REPLAY RECORDINGS METADATA ===')\n      }\n\n      const failedRecs = Object.values(recordings)\n        .filter(r => r.result === 'failed' || r.result === 'timedOut')\n        .sort((a, b) => b.duration - a.duration)\n\n      if (failedRecs[0]) {\n        try {\n          const uploadOut = execSync(`npx replayio upload ${failedRecs[0].id}`, {\n            encoding: 'utf-8',\n            cwd: appDir,\n            timeout: 60000,\n            env: { ...process.env, RECORD_REPLAY_API_KEY: replayApiKey },\n          })\n          uploadedId = failedRecs[0].id\n          log(`REPLAY UPLOADED: ${uploadedId}`)\n          log(uploadOut)\n        } catch (ue) {\n          log(`Replay upload failed: ${ue}`)\n        }\n      }\n    } catch { log('Could not parse recordings') }\n  }\n\n  // Step 10: Cleanup\n  removeEnvValue('DATABASE_URL')\n  cleanup(branchId, neonProjectId, neonApiKey)\n  tryExec('npx replayio remove --all 2>/dev/null || true', { stdio: 'ignore', cwd: appDir })\n\n  writeLog()\n\n  // Step 11: Summary\n  const parts = []\n  if (passed > 0) parts.push(`${passed} passed`)\n  if (failed > 0) parts.push(`${failed} failed`)\n  if (uploadedId) parts.push(`recording: ${uploadedId}`)\n  const summary = parts.length > 0\n    ? parts.join(', ') + ` — see ${logFile}`\n    : `tests completed — see ${logFile}`\n  console.log(summary)\n\n  process.exit(playwrightExitCode)\n}\n\nfunction cleanup(branchId: string, projectId: string, apiKey: string) {\n  tryExec('pkill -f \"netlify dev\" 2>/dev/null || true', { stdio: 'ignore' })\n  if (branchId) {\n    tryExec(\n      `curl -s -X DELETE \"https://console.neon.tech/api/v2/projects/${projectId}/branches/${branchId}\" -H \"Authorization: Bearer ${apiKey}\"`,\n      { stdio: 'ignore', timeout: 10000 }\n    )\n  }\n}\n\nrun()\n","numLines":308,"startLine":1,"totalLines":308}}}
