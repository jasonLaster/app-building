t')).toBeVisible({ timeout: 30000 });\n   240→    const initialRows = page.locator('[data-testid^=\"issue-row-\"]');\n   241→    await expect(initialRows).toHaveCount(8, { timeout: 30000 });\n   242→\n   243→    const uniqueTitle = `New feature request ${Date.now()}`;\n   244→\n   245→    // Open modal and create issue with status \"Todo\"\n   246→    await page.getByTestId('new-issue-btn').click();\n   247→    await expect(page.getByTestId('create-issue-modal')).toBeVisible({ timeout: 30000 });\n   248→\n   249→    await page.getByTestId('create-issue-title-input').fill(uniqueTitle);\n   250→\n   251→    // Set status to Todo\n   252→    await page.getByTestId('create-issue-status-selector').click();\n   253→    await expect(page.getByTestId('create-issue-status-dropdown')).toBeVisible();\n   254→    await page.getByTestId('create-issue-status-option-todo').click();\n   255→\n   256→    await page.getByTestId('create-issue-submit-btn').click();\n   257→    await expect(page.getByTestId('create-issue-success')).toBeVisible({ timeout: 30000 });\n   258→    await expect(page.getByTestId('create-issue-modal')).toHaveCount(0, { timeout: 30000 });\n   259→\n   260→    // Verify the new issue appears in the list (count increased by 1)\n   261→    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(9, { timeout: 30000 });\n   262→\n   263→    // Verify the issue title appears in the todo status group\n   264→    const todoGroup = page.getByTestId('team-issue-group-items-todo');\n   265→    await expect(todoGroup).toContainText(uniqueTitle, { timeout: 30000 });\n   266→  });\n   267→\n   268→  test('Created issue with parent appears as sub-issue', async ({ page, baseURL }) => {\n   269→    test.slow();\n   270→    const { token, team } = await loginAndOpenCreateModal(page, baseURL!);\n   271→\n   272→    const uniqueTitle = `Write unit tests ${Date.now()}`;\n   273→\n   274→    // Fill title\n   275→    await page.getByTestId('create-issue-title-input').