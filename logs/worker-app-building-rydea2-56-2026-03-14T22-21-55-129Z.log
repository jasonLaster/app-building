ateModal(\n    44→  page: import('@playwright/test').Page,\n    45→  baseURL: string,\n    46→  teamIdentifier = 'ENG',\n    47→  email = 'alice@acme.com',\n    48→  password = 'password123'\n    49→) {\n    50→  const result = await loginAndNavigateToTeamIssues(page, baseURL, teamIdentifier, email, password);\n    51→\n    52→  await page.getByTestId('new-issue-btn').click();\n    53→  await expect(page.getByTestId('create-issue-modal')).toBeVisible({ timeout: 30000 });\n    54→\n    55→  return result;\n    56→}\n    57→\n    58→// Helper to delete all non-seed issues via API\n    59→async function deleteCreatedIssues(baseURL: string, token: string, teamId: string) {\n    60→  const response = await fetch(`${baseURL}/api/team-issues?teamId=${teamId}`, {\n    61→    headers: { Authorization: `Bearer ${token}` },\n    62→  });\n    63→  if (response.ok) {\n    64→    const data = await response.json();\n    65→    const issues = data.issues || [];\n    66→    // Seed data has issues numbered 1-8 for ENG; delete any with number > 8\n    67→    for (const issue of issues) {\n    68→      if (issue.number > 8) {\n    69→        try {\n    70→          await fetch(`${baseURL}/api/update-issue`, {\n    71→            method: 'PUT',\n    72→            headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },\n    73→            body: JSON.stringify({ id: issue.id, status: 'cancelled' }),\n    74→          });\n    75→        } catch {\n    76→          // ignore\n    77→        }\n    78→      }\n    79→    }\n    80→  }\n    81→}\n    82→\n    83→test.describe('CreateIssueModalActions', () => {\n    84→  test('Create Issue button is visible and styled', async ({ page, baseURL }) => {\n    85→    await loginAndOpenCreateModal(page, baseURL!);\n    86→\n    87→    // Verify Create Issue button is visible\n    88→    const submitBtn = page.getByTestId('create-issue-submit-btn');\n    89→    await expect(submitBtn).toBeVisible();\n    90→    await e