[2026-03-14T22:21:23.862Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WkjriBeSNiXR5VoF6RrtZk","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test';\n     2→\n     3→// Helper to login via API and get token\n     4→async function loginViaApi(baseURL: string, email: string, password: string) {\n     5→  const response = await fetch(`${baseURL}/api/login`, {\n     6→    method: 'POST',\n     7→    headers: { 'Content-Type': 'application/json' },\n     8→    body: JSON.stringify({ email, password }),\n     9→  });\n    10→  return response.json();\n    11→}\n    12→\n    13→// Helper to get teams via API\n    14→async function getTeams(baseURL: string, token: string) {\n    15→  const response = await fetch(`${baseURL}/api/teams`, {\n    16→    headers: { Authorization: `Bearer ${token}` },\n    17→  });\n    18→  const data = await response.json();\n    19→  return data.teams;\n    20→}\n    21→\n    22→// Helper to login and navigate to team issues page\n    23→async function loginAndNavigateToTeamIssues(\n    24→  page: import('@playwright/test').Page,\n    25→  baseURL: string,\n    26→  teamIdentifier = 'ENG',\n    27→  email = 'alice@acme.com',\n    28→  password = 'password123'\n    29→) {\n    30→  const data = await loginViaApi(baseURL, email, password);\n    31→  const teams = await getTeams(baseURL, data.token);\n    32→  const team = teams.find((t: { identifier: string }) => t.identifier === teamIdentifier);\n    33→\n    34→  await page.goto('/login');\n    35→  await page.evaluate((t) => localStorage.setItem('session_token', t), data.token);\n    36→  await page.goto(`/team/${team.id}/issues`);\n    37→  await expect(page.getByTestId('team-issues-page')).toBeVisible({ timeout: 30000 });\n    38→\n    39→  return { token: data.token, user: data.user, team, teams };\n    40→}\n    41→\n    42→// Helper to login and open create issue modal from a team page\n    43→async function loginAndOpenCreateModal(\n    44→  page: import('@playwright/test').Page,\n    45→  baseURL: string,\n    46→  teamIdentifier = 'ENG',\n    47→  email = 'alice@acme.com',\n    48→  password = 'password123'\n    49→) {\n    50→  const result = await loginAndNavigateToTeamIssues(page, baseURL, teamIdentifier, email, password);\n    51→\n    52→  await page.getByTestId('new-issue-btn').click();\n    53→  await expect(page.getByTestId('create-issue-modal')).toBeVisible({ timeout: 30000 });\n    54→\n    55→  return result;\n    56→}\n    57→\n    58→// Helper to delete all non-seed issues via API\n    59→async function deleteCreatedIssues(baseURL: string, token: string, teamId: string) {\n    60→  const response = await fetch(`${baseURL}/api/team-issues?teamId=${teamId}`, {\n    61→    headers: { Authorization: `Bearer ${token}` },\n    62→  });\n    63→  if (response.ok) {\n    64→    const data = await response.json();\n    65→    const issues = data.issues || [];\n    66→    // Seed data has issues numbered 1-8 for ENG; delete any with number > 8\n    67→    for (const issue of issues) {\n    68→      if (issue.number > 8) {\n    69→        try {\n    70→          await fetch(`${baseURL}/api/update-issue`, {\n    71→            method: 'PUT',\n    72→            headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },\n    73→            body: JSON.stringify({ id: issue.id, status: 'cancelled' }),\n    74→          });\n    75→        } catch {\n    76→          // ignore\n    77→        }\n    78→      }\n    79→    }\n    80→  }\n    81→}\n    82→\n    83→test.describe('CreateIssueModalActions', () => {\n    84→  test('Create Issue button is visible and styled', async ({ page, baseURL }) => {\n    85→    await loginAndOpenCreateModal(page, baseURL!);\n    86→\n    87→    // Verify Create Issue button is visible\n    88→    const submitBtn = page.getByTestId('create-issue-submit-btn');\n    89→    await expect(submitBtn).toBeVisible();\n    90→    await expect(submitBtn).toContainText('Create Issue');\n    91→\n    92→    // Verify it's in the actions area at the bottom of the modal\n    93→    await expect(page.getByTestId('create-issue-actions')).toBeVisible();\n    94→\n    95→    // Verify the button has primary styling (cia-submit-btn class)\n    96→    await expect(submitBtn).toHaveClass(/cia-submit-btn/);\n    97→  });\n    98→\n    99→  test('Cancel button is visible', async ({ page, baseURL }) => {\n   100→    await loginAndOpenCreateModal(page, baseURL!);\n   101→\n   102→    // Verify Cancel button is visible alongside Create Issue button\n   103→    const cancelBtn = page.getByTestId('create-issue-cancel-btn');\n   104→    await expect(cancelBtn).toBeVisible();\n   105→    await expect(cancelBtn).toContainText('Cancel');\n   106→\n   107→    // Both buttons are in the actions area\n   108→    const submitBtn = page.getByTestId('create-issue-submit-btn');\n   109→    await expect(submitBtn).toBeVisible();\n   110→  });\n   111→\n   112→  test('Cancel button closes the modal', async ({ page, baseURL }) => {\n   113→    await loginAndOpenCreateModal(page, baseURL!);\n   114→\n   115→    // Click the Cancel button\n   116→    await page.getByTestId('create-issue-cancel-btn').click();\n   117→\n   118→    // Verify the modal closes\n   119→    await expect(page.getByTestId('create-issue-modal')).toHaveCount(0, { timeout: 10000 });\n   120→\n   121→    // Verify the user is still on the team issues page\n   122→    await expect(page.getByTestId('team-issues-page')).toBeVisible();\n   123→  });\n   124→\n   125→  test('Cancel button discards form data', async ({ page, baseURL }) => {\n   126→    await loginAndOpenCreateModal(page, baseURL!);\n   127→\n   128→    // Enter some data\n   129→    await page.getByTestId('create-issue-title-input').fill('Draft issue');\n   130→\n   131→    // Change priority to High\n   132→    await page.getByTestId('create-issue-priority-selector').click();\n   133→    await expect