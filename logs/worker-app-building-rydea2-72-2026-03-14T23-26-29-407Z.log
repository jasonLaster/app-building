[2026-03-14T23:23:51.360Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CUSYas8Mj3aL18C19eceHf","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions';\n     2→import { getSql } from './db';\n     3→\n     4→async function authenticate(req: Request) {\n     5→  const authHeader = req.headers.get('Authorization');\n     6→  if (!authHeader?.startsWith('Bearer ')) {\n     7→    return null;\n     8→  }\n     9→  const token = authHeader.slice(7);\n    10→  const sql = getSql();\n    11→  const sessions = await sql`\n    12→    SELECT s.member_id FROM sessions s\n    13→    WHERE s.token = ${token} AND s.expires_at > NOW()\n    14→  `;\n    15→  const session = sessions[0];\n    16→  if (!session) return null;\n    17→  return { memberId: session.member_id as string, sql };\n    18→}\n    19→\n    20→function jsonResponse(body: unknown, status = 200) {\n    21→  return new Response(JSON.stringify(body), {\n    22→    status,\n    23→    headers: { 'Content-Type': 'application/json' },\n    24→  });\n    25→}\n    26→\n    27→export default async function handler(req: Request, _context: Context) {\n    28→  try {\n    29→    const auth = await authenticate(req);\n    30→    if (!auth) {\n    31→      return jsonResponse({ error: 'Unauthorized' }, 401);\n    32→    }\n    33→    const { sql } = auth;\n    34→\n    35→    if (req.method === 'GET') {\n    36→      const labels = await sql`\n    37→        SELECT l.id, l.name, l.color,\n    38→          COALESCE(ic.cnt, 0)::int AS issue_count\n    39→        FROM labels l\n    40→        LEFT JOIN (\n    41→          SELECT label_id, COUNT(*)::int AS cnt\n    42→          FROM issue_labels\n    43→          GROUP BY label_id\n    44→        ) ic ON ic.label_id = l.id\n    45→        ORDER BY l.name ASC\n    46→      `;\n    47→      return jsonResponse({ labels });\n    48→    }\n    49→\n    50→    if (req.method === 'POST') {\n    51→      const body = await req.json();\n    52→      const { name, color } = body as { name: string; color: string };\n    53→\n    54→      if (!name?.trim()) {\n    55→        return jsonResponse({ error: 'Label name is required' }, 400);\n    56→      }\n    57→\n    58→      const existing = await sql`\n    59→        SELECT id FROM labels WHERE LOWER(name) = LOWER(${name.trim()})\n    60→      `;\n    61→      if (existing.length > 0) {\n    62→        return jsonResponse({ error: 'A label with this name already exists' }, 409);\n    63→      }\n    64→\n    65→      const rows = await sql`\n    66→        INSERT INTO labels (name, color)\n    67→        VALUES (${name.trim()}, ${color})\n    68→        RETURNING id, name, color\n    69→      `;\n    70→      const label = rows[0];\n    71→      if (!label) {\n    72→        return jsonResponse({ error: 'Failed to create label' }, 500);\n    73→      }\n    74→      return jsonResponse({ label: { ...label, issue_count: 0 } }, 201);\n    75→    }\n    76→\n    77→    if (req.method === 'PUT') {\n    78→      const body = await req.json();\n    79→      const { id, name, color } = body as { id: string; name: string; color: string };\n    80→\n    81→      if (!id) {\n    82→        return jsonResponse({ error: 'Label id is required' }, 400);\n    83→      }\n    84→      if (!name?.trim()) {\n    85→        return jsonResponse({ error: 'Label name is required' }, 400);\n    86→      }\n    87→\n    88→      const existing = await sql`\n    89→        SELECT id FROM labels WHERE LOWER(name) = LOWER(${name.trim()}) AND id != ${id}\n    90→      `;\n    91→      if (existing.length > 0) {\n    92→        return jsonResponse({ error: 'A label with this name already exists' }, 409);\n    93→      }\n    94→\n    95→      const rows = await sql`\n    96→        UPDATE labels SET name = ${name.trim()}, color = ${color}\n    97→        WHERE id = ${id}\n    98→        RETURNING id, name, color\n    99→      `;\n   100→      const updated = rows[0];\n   101→      if (!updated) {\n   102→        return jsonResponse({ error: 'Label not found' }, 404);\n   103→      }\n   104→\n   105→      const countRows = await sql`\n   106→        SELECT COUNT(*)::int AS cnt FROM issue_labels WHERE label_id = ${id}\n   107→      `;\n   108→      const countRow = countRows[0];\n   109→      const issue_count = countRow ? countRow.cnt : 0;\n   110→\n   111→      return jsonResponse({ label: { ...updated, issue_count } });\n   112→    }\n   113→\n   114→    if (req.method === 'DELETE') {\n   115→      const body = await req.json();\n   116→      const { id } = body as { id: string };\n   117→\n   118→      if (!id) {\n   119→        return jsonResponse({ error: 'Label id is required' }, 400);\n   120→      }\n   121→\n   122→      await sql`DELETE FROM issue_labels WHERE label_id = ${id}`;\n   123→      await sql`DELETE FROM labels WHERE id = ${id}`;\n   124→\n   125→      return jsonResponse({ success: true });\n   126→    }\n   127→\n   128→    return jsonResponse({ error: 'Method not allowed' }, 405);\n   129→  } catch (err) {\n   130→    console.error('Labels error:', err);\n   131→    return jsonResponse({ error: 'Internal server error' }, 500);\n   132→  }\n   133→}\n   134→"}]},"parent_tool_use_id":"toolu_01T4xaMBJpXq61wd3VDy2BUs","session_id":"2c440e31-04a9-4252-9689-26512ba806f5","uuid":"4603b128-3d1f-4db7-9f31-7f52b2d9f1ee"}
