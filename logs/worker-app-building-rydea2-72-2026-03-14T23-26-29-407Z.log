ase;\n   151→}\n   152→\n   153→.label-edit-swatch:hover {\n   154→  transform: scale(1.15);\n   155→}\n   156→\n   157→.label-edit-swatch-selected {\n   158→  border-color: #fff;\n   159→  box-shadow: 0 0 0 2px var(--color-accent);\n   160→}\n   161→\n   162→.label-edit-hex-input {\n   163→  width: 100px;\n   164→  padding: 4px 8px;\n   165→  border-radius: 6px;\n   166→  border: 1px solid var(--color-border);\n   167→  background-color: var(--color-bg-primary);\n   168→  color: var(--color-text-primary);\n   169→  font-size: 12px;\n   170→  font-family: monospace;\n   171→  outline: none;\n   172→  transition: border-color 150ms ease;\n   173→}\n   174→\n   175→.label-edit-hex-input:focus {\n   176→  border-color: var(--color-accent);\n   177→}\n   178→\n   179→.label-row-edit-actions {\n   180→  display: flex;\n   181→  justify-content: flex-end;\n   182→  gap: 8px;\n   183→}\n   184→\n   185→.label-edit-cancel-btn {\n   186→  padding: 5px 12px;\n   187→  border-radius: 6px;\n   188→  border: 1px solid var(--color-border);\n   189→  background: transparent;\n   190→  color: var(--color-text-secondary);\n   191→  font-size: 12px;\n   192→  font-weight: 500;\n   193→  cursor: pointer;\n   194→  transition: background-color 150ms ease, color 150ms ease;\n   195→}\n   196→\n   197→.label-edit-cancel-btn:hover {\n   198→  background-color: var(--color-bg-hover);\n   199→  color: var(--color-text-primary);\n   200→}\n   201→\n   202→.label-edit-save-btn {\n   203→  padding: 5px 12px;\n   204→  border-radius: 6px;\n   205→  border: none;\n   206→  background-color: var(--color-accent);\n   207→  color: #fff;\n   208→  font-size: 12px;\n   209→  font-weight: 500;\n   210→  cursor: pointer;\n   211→  transition: opacity 150ms ease;\n   212→}\n   213→\n   214→.label-edit-save-btn:hover {\n   215→  opacity: 0.9;\n   216→}\n   217→\n   218→.label-edit-save-btn:disabled {\n   219→  opacity: 0.5;\n   220→  cursor: not-allowed;\n   221→}\n   222→"}]},"parent_tool_use_id":"toolu