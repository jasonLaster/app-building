[2026-03-14T23:23:54.352Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017ets9iHTddjfaTsFUPcTYa","type":"tool_result","content":"     1→import { createSlice, createAsyncThunk } from '@reduxjs/toolkit';\n     2→\n     3→export interface Label {\n     4→  id: string;\n     5→  name: string;\n     6→  color: string;\n     7→  issue_count: number;\n     8→}\n     9→\n    10→interface LabelsState {\n    11→  items: Label[];\n    12→  loading: boolean;\n    13→  error: string | null;\n    14→}\n    15→\n    16→const initialState: LabelsState = {\n    17→  items: [],\n    18→  loading: false,\n    19→  error: null,\n    20→};\n    21→\n    22→export const fetchLabels = createAsyncThunk(\n    23→  'labels/fetchLabels',\n    24→  async (_, { getState, rejectWithValue }) => {\n    25→    const state = getState() as { auth: { token: string | null } };\n    26→    const token = state.auth.token;\n    27→    if (!token) return rejectWithValue('No token');\n    28→    const response = await fetch('/api/labels', {\n    29→      headers: { Authorization: `Bearer ${token}` },\n    30→    });\n    31→    if (!response.ok) {\n    32→      return rejectWithValue('Failed to fetch labels');\n    33→    }\n    34→    const data = await response.json();\n    35→    return data.labels as Label[];\n    36→  }\n    37→);\n    38→\n    39→export const createLabel = createAsyncThunk(\n    40→  'labels/createLabel',\n    41→  async (payload: { name: string; color: string }, { getState, rejectWithValue }) => {\n    42→    const state = getState() as { auth: { token: string | null } };\n    43→    const token = state.auth.token;\n    44→    if (!token) return rejectWithValue('No token');\n    45→    const response = await fetch('/api/labels', {\n    46→      method: 'POST',\n    47→      headers: {\n    48→        Authorization: `Bearer ${token}`,\n    49→        'Content-Type': 'application/json',\n    50→      },\n    51→      body: JSON.stringify(payload),\n    52→    });\n    53→    if (!response.ok) {\n    54→      const data = await response.json();\n    55→      return rejectWithValue(data.error || 'Failed to create label');\n    56→    }\n    57→    const data = await response.json();\n    58→    return data.label as Label;\n    59→  }\n    60→);\n    61→\n    62→export const updateLabel = createAsyncThunk(\n    63→  'labels/updateLabel',\n    64→  async (payload: { id: string; name: string; color: string }, { getState, rejectWithValue }) => {\n    65→    const state = getState() as { auth: { token: string | null } };\n    66→    const token = state.auth.token;\n    67→    if (!token) return rejectWithValue('No token');\n    68→    const response = await fetch('/api/labels', {\n    69→      method: 'PUT',\n    70→      headers: {\n    71→        Authorization: `Bearer ${token}`,\n    72→        'Content-Type': 'application/json',\n    73→      },\n    74→      body: JSON.stringify(payload),\n    75→    });\n    76→    if (!response.ok) {\n    77→      const data = await response.json();\n    78→      return rejectWithValue(data.error || 'Failed to update label');\n    79→    }\n    80→    const data = await response.json();\n    81→    return data.label as Label;\n    82→  }\n    83→);\n    84→\n    85→export const deleteLabel = createAsyncThunk(\n    86→  'labels/deleteLabel',\n    87→  async (id: string, { getState, rejectWithValue }) => {\n    88→    const state = getState() as { auth: { token: string | null } };\n    89→    const token = state.auth.token;\n    90→    if (!token) return rejectWithValue('No token');\n    91→    const response = await fetch('/api/labels', {\n    92→      method: 'DELETE',\n    93→      headers: {\n    94→        Authorization: `Bearer ${token}`,\n    95→        'Content-Type': 'application/json',\n    96→      },\n    97→      body: JSON.stringify({ id }),\n    98→    });\n    99→    if (!response.ok) {\n   100→      return rejectWithValue('Failed to delete label');\n   101→    }\n   102→    return id;\n   103→  }\n   104→);\n   105→\n   106→const labelsSlice = createSlice({\n   107→  name: 'labels',\n   108→  initialState,\n   109→  reducers: {},\n   110→  extraReducers: (builder) => {\n   111→    builder\n   112→      .addCase(fetchLabels.pending, (state) => {\n   113→        if (state.items.length === 0) {\n   114→          state.loading = true;\n   115→        }\n   116→        state.error = null;\n   117→      })\n   118→      .addCase(fetchLabels.fulfilled, (state, action) => {\n   119→        state.loading = false;\n   120→        state.items = action.payload;\n   121→      })\n   122→      .addCase(fetchLabels.rejected, (state, action) => {\n   123→        state.loading = false;\n   124→        state.error = action.payload as string;\n   125→      })\n   126→      .addCase(createLabel.fulfilled, (state, action) => {\n   127→        state.items.push(action.payload);\n   128→      })\n   129→      .addCase(updateLabel.fulfilled, (state, action) => {\n   130→        const index = state.items.findIndex((l) => l.id === action.payload.id);\n   131→        if (index !== -1) {\n   132→          state.items[index] = action.payload;\n   133→        }\n   134→      })\n   135→      .addCase(deleteLabel.fulfilled, (state, action) => {\n   136→        state.items = state.items.filter((l) => l.id !== action.payload);\n   137→      });\n   138→  },\n   139→});\n   140→\n   141→export default labelsSlice.reducer;\n   142→"}]},"parent_tool_use_id":"toolu_01T4xaMBJpXq61wd3VDy2BUs","session_id":"2c440e31-04a9-4252-9689-26512ba806f5","uuid":"da6e3e75-ac74-4548-b5e1-f113dd6a7e3d"}
