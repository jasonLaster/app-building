[2026-03-14T23:23:58.590Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016pRYC8XUJLFSB46wkCe4Bv","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test';\n     2→\n     3→// Helper to login as Alice and return token\n     4→async function loginAsAlice(baseURL: string): Promise<string> {\n     5→  const response = await fetch(`${baseURL}/api/login`, {\n     6→    method: 'POST',\n     7→    headers: { 'Content-Type': 'application/json' },\n     8→    body: JSON.stringify({ email: 'alice@acme.com', password: 'password123' }),\n     9→  });\n    10→  const data = await response.json();\n    11→  return data.token;\n    12→}\n    13→\n    14→// Helper to get teams via API\n    15→async function getTeams(baseURL: string, token: string) {\n    16→  const response = await fetch(`${baseURL}/api/teams`, {\n    17→    headers: { Authorization: `Bearer ${token}` },\n    18→  });\n    19→  const data = await response.json();\n    20→  return data.teams as Array<{ id: string; name: string; identifier: string }>;\n    21→}\n    22→\n    23→// Helper to get notifications via API\n    24→async function getNotifications(baseURL: string, token: string) {\n    25→  const response = await fetch(`${baseURL}/api/notifications`, {\n    26→    headers: { Authorization: `Bearer ${token}` },\n    27→  });\n    28→  const data = await response.json();\n    29→  return data.notifications as Array<{ id: string; read: boolean }>;\n    30→}\n    31→\n    32→// Helper to mark notification as read via API\n    33→async function markNotificationRead(baseURL: string, token: string, notificationId: string) {\n    34→  await fetch(`${baseURL}/api/notifications/${notificationId}/read`, {\n    35→    method: 'PUT',\n    36→    headers: { Authorization: `Bearer ${token}` },\n    37→  });\n    38→}\n    39→\n    40→// Helper to authenticate page as Alice\n    41→async function authenticatePage(page: any, baseURL: string): Promise<string> {\n    42→  const token = await loginAsAlice(baseURL);\n    43→  await page.goto('/login');\n    44→  await page.evaluate((t: string) => localStorage.setItem('session_token', t), token);\n    45→  return token;\n    46→}\n    47→\n    48→test.describe('Sidebar', () => {\n    49→  test('Sidebar renders workspace header', async ({ page, baseURL }) => {\n    50→    const token = await authenticatePage(page, baseURL!);\n    51→    await page.goto('/my-issues');\n    52→    await expect(page.getByTestId('sidebar')).toBeVisible({ timeout: 30000 });\n    53→    await expect(page.getByTestId('sidebar-workspace-name')).toBeVisible({ timeout: 30000 });\n    54→    await expect(page.getByTestId('sidebar-workspace-name')).toContainText('Acme Corp');\n    55→  });\n    56→\n    57→  test('Sidebar workspace header navigates to home', async ({ page, baseURL }) => {\n    58→    const token = await authenticatePage(page, baseURL!);\n    59→    const teams = await getTeams(baseURL!, token);\n    60→    const engTeam = teams.find((t) => t.identifier === 'ENG')!;\n    61→\n    62→    await page.goto(`/team/${engTeam.id}/issues`);\n    63→    await expect(page.getByTestId('sidebar')).toBeVisible({ timeout: 30000 });\n    64→\n    65→    await page.getByTestId('sidebar-workspace-name').click();\n    66→    await expect(page).toHaveURL(/\\/my-issues/, { timeout: 30000 });\n    67→  });\n    68→\n    69→  test('Sidebar renders main navigation links', async ({ page, baseURL }) => {\n    70→    await authenticatePage(page, baseURL!);\n    71→    await page.goto('/my-issues');\n    72→    await expect(page.getByTestId('sidebar')).toBeVisible({ timeout: 30000 });\n    73→\n    74→    await expect(page.getByTestId('sidebar-link-my-issues')).toBeVisible();\n    75→    await expect(page.getByTestId('sidebar-link-my-issues')).toContainText('My Issues');\n    76→\n    77→    await expect(page.getByTestId('sidebar-link-inbox')).toBeVisible();\n    78→    await expect(page.getByTestId('sidebar-link-inbox')).toContainText('Inbox');\n    79→  });\n    80→\n    81→  test('Sidebar My Issues link navigates correctly', async ({ page, baseURL }) => {\n    82→    await authenticatePage(page, baseURL!);\n    83→    await page.goto('/inbox');\n    84→    await expect(page.getByTestId('sidebar')).toBeVisible({ timeout: 30000 });\n    85→\n    86→    await page.getByTestId('sidebar-link-my-issues').click();\n    87→    await expect(page).toHaveURL(/\\/my-issues/, { timeout: 30000 });\n    88→\n    89→    // Verify active state\n    90→    await expect(page.getByTestId('sidebar-link-my-issues')).toHaveClass(/sidebar-link-active/, { timeout: 10000 });\n    91→  });\n    92→\n    93→  test('Sidebar Inbox link navigates correctly', async ({ page, baseURL }) => {\n    94→    await authenticatePage(page, baseURL!);\n    95→    await page.goto('/my-issues');\n    96→    await expect(page.getByTestId('sidebar')).toBeVisible({ timeout: 30000 });\n    97→\n    98→    await page.getByTestId('sidebar-link-inbox').click();\n    99→    await expect(page).toHaveURL(/\\/inbox/, { timeout: 30000 });\n   100→\n   101→    // Verify active state\n   102→    await expect(page.getByTestId('sidebar-link-inbox')).toHaveClass(/sidebar-link-active/, { timeout: 10000 });\n   103→  });\n   104→\n   105→  test('Sidebar Inbox shows unread notification count badge', async ({ page, baseURL }) => {\n   106→    await authenticatePage(page, baseURL!);\n   107→    await page.goto('/my-issues');\n   108→    await expect(page.getByTestId('sidebar')).toBeVisible({ timeout: 30000 });\n   109→\n   110→    // Alice has 3 unread notifications in seed\n   111→    await expect(page.getByTestId('sidebar-inbox-badge')).toBeVisible({ timeout: 30000 });\n   112→    await expect(page.getByTestId('sidebar-inbox-badge')).toHaveText('3');\n   113→  });\n   114→\n   115→  test('Sidebar Inbox badge updates when notifications are read', async ({ page, baseURL }) => {\n   116→    const token = await authenticatePage(page, baseURL!);\n   117→    await page.goto('/my-issues');\n   118→    await expect(page.getByTestId('sidebar')).toBeVisible({ timeout: 30000 });\n   119→\n   120→    // Verify initial badge shows 3\n   121→    await expect(page.getByTestId('sidebar-inbox-badge')).toHaveText('3', { timeout: 30000 });\n   122→\n   123→    // Navigate to inbox\n   124→    await page.getByTestId('sidebar-link-inbox').click();\n   125→    await expect(page).toHaveURL(/\\/inbox/, { timeout: 30000 });\n   126→\n   127→    // Wait for notifications to load\n   128→    await expect(page.getByTestId('notification-list')).toBeVisible({ timeout: 30000 });\n   129→\n   130→    // Get notifications to find an unread one\n   131→    const notifications = await getNotifications(baseURL!, token);\n   132→    const unreadNotification = notifications.find((n) => !n.read);\n   133→\n   134→    if (unreadNotification) {\n   135→      // Click the notification row to mark it as read\n   136→      await page.getByTestId(`notification-row-${unreadNotification.id}`).click();\n   137→\n   138→      // Badge should update to 2\n   139→      await expect(page.getByTestId('sidebar-inbox-badge')).toHaveText('2', { timeout: 30000 });\n   140→    }\n   141→  });\n   142→\n   143→  test('Sidebar Inbox badge not shown when no unread notifications', async ({ page, baseURL }) => {\n   144→    const token = await authenticatePage(page, baseURL!);\n   145→\n   146→    // Mark all notifications as read via API\n   147→    const notifications = await getNotifications(baseURL!, token);\n   148→    for (const notification of notifications) {\n   149→      if (!notification.read) {\n   150→        await markNotificationRead(baseURL!, token, notification.id);\n   151→      }\n   152→    }\n   153→\n   154→    await page.goto('/my-issues');\n   155→    await expect(page.getByTestId('sidebar')).toBeVisible({ timeout: 30000 });\n   156→\n   157→    // Badge should not be visible\n   158→    await expect(page.getByTestId('sidebar-inbox-badge')).not.toBeVisible({ timeout: 10000 });\n   159→  });\n   160→\n   161→  test('Sidebar renders team sections', async ({ page, baseURL }) => {\n   162→    const token = await authenticatePage(page, baseURL!);\n   163→    await page.goto('/my-issues');\n   164→    await expect(page.getByTestId('sidebar')).toBeVisible({ timeout: 30000 });\n   165→\n   166→    // Teams section should be visible\n   167→    await expect(page.getByTestId('sidebar-teams-section')).toBeVisible({ timeout: 30000 });\n   168→\n   169→    const teams = await getTeams(baseURL!, token);\n   170→    const engTeam = teams.find((t) => t.identifier === 'ENG')!;\n   171→    const desTeam = teams.find((t) => t.identifier === 'DES')!;\n   172→\n   173→    // Both team headers should be visible\n   174→    await expect(page.getByTestId(`sidebar-team-header-${engTeam.id}`)).toBeVisible();\n   175→    await expect(page.getByTestId(`sidebar-team-header-${desTeam.id}`)).toBeVisible();\n   176→\n   177→    // Sub-links should be visible (teams start expanded)\n   178→    await expect(page.getByTestId(`sidebar-link-team-issues-${engTeam.id}`)).toBeVisible();\n   179→    await expect(page.getByTestId(`sidebar-link-team-cycles-${engTeam.id}`)).toBeVisible();\n   180→    await expect(page.getByTestId(`sidebar-link-team-projects-${engTeam.id}`)).toBeVisible();\n   181→    await expect(page.getByTestId(`sidebar-link-team-views-${engTeam.id}`)).toBeVisible();\n   182→  });\n   183→\n   184→  test('Sidebar team section is collapsible', async ({ page, baseURL }) => {\n   185→    const token = await authenticatePage(page, baseURL!);\n   186→    await page.goto('/my-issues');\n   187→    await expect(page.getByTestId('sidebar')).toBeVisible({ timeout: 30000 });\n   188→\n   189→    const teams = await getTeams(baseURL!, token);\n   190→    const engTeam = teams.find((t) => t.identifier === 'ENG')!;\n   191→\n   192→    // Team links should be visible initially (expanded)\n   193→    await expect(page.getByTestId(`sidebar-team-links-${engTeam.id}`)).toBeVisible({ timeout: 30000 });\n   194→\n   195→    // Collapse by clicking header\n   196→    await page.getByTestId(`sidebar-team-header-${engTeam.id}`).click();\n   197→    await expect(page.getByTestId(`sidebar-team-links-${engTeam.id}`)).not.toBeVisible({ timeout: 10000 });\n   198→\n   199→    // Expand again\n   200→    await page.getByTestId(`sidebar-team-header-${engTeam.id}`).click();\n   201→    await expect(page.getByTestId(`sidebar-team-links-${engTeam.id}`)).toBeVisible({ timeout: 10000 });\n   202→  });\n   203→\n   204→  test('Sidebar team section collapse toggles multiple times', async ({ page, baseURL }) => {\n   205→    const token = await authenticatePage(page, baseURL!);\n   206→    await page.goto('/my-issues');\n   207→    await expect(page.getByTestId('sidebar')).toBeVisible({ timeout: 30000 });\n   208→\n   209→    const teams = await getTeams(baseURL!, token);\n   210→    const engTeam = teams.find((t) => t.identifier === 'ENG')!;\n   211→\n   212→    // Initially expanded\n   213→    await expect(page.getByTestId(`sidebar-team-links-${engTeam.id}`)).toBeVisible({ timeout: 30000 });\n   214→\n   215→    // Click 1: collapse\n   216→    await page.getByTestId(`sidebar-team-header-${engTeam.id}`).click();\n   217→    await expect(page.getByTestId(`sidebar-team-links-${engTeam.id}`)).not.toBeVisible({ timeout: 10000 });\n   218→\n   219→    // Click 2: expand\n   220→    await page.getByTestId(`sidebar-team-header-${engTeam.id}`).click();\n   221→    await expect(page.getByTestId(`sidebar-team-links-${engTeam.id}`)).toBeVisible({ timeout: 10000 });\n   222→\n   223→    // Click 3: collapse again\n   224→    await page.getByTestId(`sidebar-team-header-${engTeam.id}`).click();\n   225→    await expect(page.getByTestId(`sidebar-team-links-${engTeam.id}`)).not.toBeVisible({ timeout: 10000 });\n   226→  });\n   227→\n   228→  test('Sidebar team Issues link navigates to team issues page', async ({ page, baseURL }) => {\n   