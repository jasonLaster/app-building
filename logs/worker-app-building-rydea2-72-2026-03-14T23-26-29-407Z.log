[2026-03-14T23:23:54.210Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018suHG9X9iaH6i3Pa3Xg5za","type":"tool_result","content":"     1→import { useState, useRef, useEffect } from 'react';\n     2→import './CreateLabel.css';\n     3→\n     4→const PRESET_COLORS = [\n     5→  { name: 'Red', hex: '#ef4444' },\n     6→  { name: 'Orange', hex: '#f97316' },\n     7→  { name: 'Yellow', hex: '#eab308' },\n     8→  { name: 'Green', hex: '#22c55e' },\n     9→  { name: 'Blue', hex: '#3b82f6' },\n    10→  { name: 'Purple', hex: '#8b5cf6' },\n    11→  { name: 'Pink', hex: '#ec4899' },\n    12→  { name: 'Gray', hex: '#6b7280' },\n    13→];\n    14→\n    15→interface CreateLabelProps {\n    16→  open: boolean;\n    17→  onClose: () => void;\n    18→  onSubmit: (name: string, color: string) => Promise<void>;\n    19→  existingNames: string[];\n    20→}\n    21→\n    22→function isValidHex(value: string): boolean {\n    23→  return /^#[0-9a-fA-F]{6}$/.test(value);\n    24→}\n    25→\n    26→export default function CreateLabel({ open, onClose, onSubmit, existingNames }: CreateLabelProps) {\n    27→  const [name, setName] = useState('');\n    28→  const [color, setColor] = useState(PRESET_COLORS[0]!.hex);\n    29→  const [customHex, setCustomHex] = useState('');\n    30→  const [nameError, setNameError] = useState<string | null>(null);\n    31→  const [colorError, setColorError] = useState<string | null>(null);\n    32→  const [submitting, setSubmitting] = useState(false);\n    33→  const nameRef = useRef<HTMLInputElement>(null);\n    34→\n    35→  useEffect(() => {\n    36→    if (open) {\n    37→      setName('');\n    38→      setColor(PRESET_COLORS[0]!.hex);\n    39→      setCustomHex('');\n    40→      setNameError(null);\n    41→      setColorError(null);\n    42→      setSubmitting(false);\n    43→      setTimeout(() => nameRef.current?.focus(), 50);\n    44→    }\n    45→  }, [open]);\n    46→\n    47→  function handlePresetClick(hex: string) {\n    48→    setColor(hex);\n    49→    setCustomHex('');\n    50→    setColorError(null);\n    51→  }\n    52→\n    53→  function handleCustomHexChange(value: string) {\n    54→    setCustomHex(value);\n    55→    setColorError(null);\n    56→    const normalized = value.startsWith('#') ? value : `#${value}`;\n    57→    if (isValidHex(normalized)) {\n    58→      setColor(normalized);\n    59→    }\n    60→  }\n    61→\n    62→  async function handleSubmit() {\n    63→    let hasError = false;\n    64→    setNameError(null);\n    65→    setColorError(null);\n    66→\n    67→    if (!name.trim()) {\n    68→      setNameError('Label name is required');\n    69→      hasError = true;\n    70→    } else if (existingNames.includes(name.trim().toLowerCase())) {\n    71→      setNameError('A label with this name already exists');\n    72→      hasError = true;\n    73→    }\n    74→\n    75→    if (customHex) {\n    76→      const normalized = customHex.startsWith('#') ? customHex : `#${customHex}`;\n    77→      if (!isValidHex(normalized)) {\n    78→        setColorError('Invalid color format');\n    79→        hasError = true;\n    80→      }\n    81→    }\n    82→\n    83→    if (hasError) return;\n    84→\n    85→    setSubmitting(true);\n    86→    try {\n    87→      const finalColor = customHex\n    88→        ? (customHex.startsWith('#') ? customHex : `#${customHex}`)\n    89→        : color;\n    90→      await onSubmit(name.trim(), finalColor);\n    91→    } catch (err) {\n    92→      if (err instanceof Error) {\n    93→        setNameError(err.message);\n    94→      } else {\n    95→        setNameError('Failed to create label');\n    96→      }\n    97→      setSubmitting(false);\n    98→    }\n    99→  }\n   100→\n   101→  function handleKeyDown(e: React.KeyboardEvent) {\n   102→    if (e.key === 'Enter') {\n   103→      e.preventDefault();\n   104→      handleSubmit();\n   105→    }\n   106→  }\n   107→\n   108→  if (!open) return null;\n   109→\n   110→  const activeColor = customHex\n   111→    ? (isValidHex(customHex.startsWith('#') ? customHex : `#${customHex}`) ? (customHex.startsWith('#') ? customHex : `#${customHex}`) : color)\n   112→    : color;\n   113→\n   114→  return (\n   115→    <div className=\"create-label\" data-testid=\"create-label-form\" onKeyDown={handleKeyDown}>\n   116→      <div className=\"create-label-body\">\n   117→        <div className=\"create-label-field\">\n   118→          <label className=\"create-label-field-label\">Name</label>\n   119→          <div className=\"create-label-name-row\">\n   120→            <span\n   121→              className=\"create-label-preview-dot\"\n   122→              style={{ backgroundColor: activeColor }}\n   123→              data-testid=\"create-label-color-preview\"\n   124→            />\n   125→            <input\n   126→              ref={nameRef}\n   127→              type=\"text\"\n   128→              className={`create-label-input ${nameError ? 'create-label-input-error' : ''}`}\n   129→              placeholder=\"Label name\"\n   130→              value={name}\n   131→              onChange={(e) => { setName(e.target.value); setNameError(null); }}\n   132→              data-testid=\"create-label-name-input\"\n   133→            />\n   134→          </div>\n   135→          {nameError && (\n   136→            <span className=\"create-label-error\" data-testid=\"create-label-name-error\">{nameError}</span>\n   137→          )}\n   138→        </div>\n   139→\n   140→        <div className=\"create-label-field\">\n   141→          <label className=\"create-label-field-label\">Color</label>\n   142→          <div className=\"create-label-color-picker\" data-testid=\"create-label-color-picker\">\n   143→            <div className=\"create-label-presets\">\n   144→              {PRESET_COLORS.map((preset) => (\n   145→                <button\n   146→                  key={preset.hex}\n   147→                  className={`create-label-swatch ${color === preset.hex && !customHex ? 'create-label-swatch-selected' : ''}`}\n   148→                  style={{ backgroundColor: preset.hex }}\n   149→                  onClick={() => handlePresetClick(preset.hex)}\n   150→                  title={preset.name}\n   151→                  data-testid={`create-label-swatch-${preset.name.toLowerCase()}`}\n   152→                  type=\"button\"\n   153→                />\n   154→              ))}\n   155→            </div>\n   156→            <div className=\"create-label-custom-hex\">\n   157→              <input\n   158→                type=\"text\"\n   159→                className={`create-label-hex-input ${colorError ? 'create-label-input-error' : ''}`}\n   160→                placeholder=\"#hex\"\n   161→                value={customHex}\n   162→                onChange={(e) => handleCustomHexChange(e.target.value)}\n   163→                data-testid=\"create-label-hex-input\"\n   164→              />\n   165→            </div>\n   166→          </div>\n   167→          {colorError && (\n   168→            <span className=\"create-label-error\" data-testid=\"create-label-color-error\">{colorError}</span>\n   169→          )}\n   170→        </div>\n   171→      </div>\n   172→\n   173→      <div className=\"create-label-actions\">\n   174→        <button\n   175→          className=\"create-label-cancel-btn\"\n   176→          onClick={onClose}\n   177→          data-testid=\"create-label-cancel-btn\"\n   178→          type=\"button\"\n   179→        >\n   180→          Cancel\n   181→        </button>\n   182→        <button\n   183→          className=\"create-label-submit-btn\"\n   184→          onClick={handleSubmit}\n   185→          disabled={submitting}\n   186→          data-testid=\"create-label-submit-btn\"\n   187→          type=\"button\"\n   188→        >\n   189→          {submitting ? 'Creating...' : 'Create'}\n   190→        </button>\n   191→      </div>\n   192→    </div>\n   193→  );\n   194→}\n   195→"}]},"parent_tool_use_id":"toolu_01T4xaMBJpXq61wd3VDy2BUs","session_id":"2c440e31-04a9-4252-9689-26512ba806f5","uuid":"a11ebd8a-d089-4cce-89c5-12996b2fdfb8"}
