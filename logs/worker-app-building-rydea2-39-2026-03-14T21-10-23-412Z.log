[2026-03-14T21:08:10.549Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Pmujr6iJFj7ZyQHzoM7xYj","type":"tool_result","content":"     1→import { useNavigate } from 'react-router-dom';\n     2→import { useDispatch } from 'react-redux';\n     3→import type { AppDispatch } from '../store';\n     4→import type { Notification } from '../slices/notificationsSlice';\n     5→import { markNotificationRead, archiveNotification } from '../slices/notificationsSlice';\n     6→import './NotificationRow.css';\n     7→\n     8→function formatRelativeTime(dateStr: string): string {\n     9→  const now = Date.now();\n    10→  const date = new Date(dateStr).getTime();\n    11→  const diff = now - date;\n    12→  const seconds = Math.floor(diff / 1000);\n    13→  const minutes = Math.floor(seconds / 60);\n    14→  const hours = Math.floor(minutes / 60);\n    15→  const days = Math.floor(hours / 24);\n    16→\n    17→  if (seconds < 60) return 'just now';\n    18→  if (minutes < 60) return `${minutes}m ago`;\n    19→  if (hours < 24) return `${hours}h ago`;\n    20→  if (days < 30) return `${days}d ago`;\n    21→  return `${Math.floor(days / 30)}mo ago`;\n    22→}\n    23→\n    24→function AssignmentIcon() {\n    25→  return (\n    26→    <svg className=\"notification-type-icon notification-type-icon-assignment\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n    27→      <path d=\"M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\" />\n    28→      <circle cx=\"8.5\" cy=\"7\" r=\"4\" />\n    29→      <line x1=\"20\" y1=\"8\" x2=\"20\" y2=\"14\" />\n    30→      <line x1=\"23\" y1=\"11\" x2=\"17\" y2=\"11\" />\n    31→    </svg>\n    32→  );\n    33→}\n    34→\n    35→function UpdateIcon() {\n    36→  return (\n    37→    <svg className=\"notification-type-icon notification-type-icon-update\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n    38→      <polyline points=\"23 4 23 10 17 10\" />\n    39→      <polyline points=\"1 20 1 14 7 14\" />\n    40→      <path d=\"M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15\" />\n    41→    </svg>\n    42→  );\n    43→}\n    44→\n    45→function MentionIcon() {\n    46→  return (\n    47→    <svg className=\"notification-type-icon notification-type-icon-mention\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n    48→      <circle cx=\"12\" cy=\"12\" r=\"4\" />\n    49→      <path d=\"M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-3.92 7.94\" />\n    50→    </svg>\n    51→  );\n    52→}\n    53→\n    54→function ArchiveIcon() {\n    55→  return (\n    56→    <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n    57→      <polyline points=\"21 8 21 21 3 21 3 8\" />\n    58→      <rect x=\"1\" y=\"3\" width=\"22\" height=\"5\" />\n    59→      <line x1=\"10\" y1=\"12\" x2=\"14\" y2=\"12\" />\n    60→    </svg>\n    61→  );\n    62→}\n    63→\n    64→function getTypeIcon(type: string) {\n    65→  switch (type) {\n    66→    case 'assignment':\n    67→      return <AssignmentIcon />;\n    68→    case 'update':\n    69→      return <UpdateIcon />;\n    70→    case 'mention':\n    71→      return <MentionIcon />;\n    72→    default:\n    73→      return <UpdateIcon />;\n    74→  }\n    75→}\n    76→\n    77→interface NotificationRowProps {\n    78→  notification: Notification;\n    79→}\n    80→\n    81→export default function NotificationRow({ notification }: NotificationRowProps) {\n    82→  const dispatch = useDispatch<AppDispatch>();\n    83→  const navigate = useNavigate();\n    84→\n    85→  function handleClick() {\n    86→    if (!notification.read) {\n    87→      dispatch(markNotificationRead(notification.id));\n    88→    }\n    89→    navigate(`/issue/${notification.issue_id}`);\n    90→  }\n    91→\n    92→  function handleArchive(e: React.MouseEvent) {\n    93→    e.stopPropagation();\n    94→    dispatch(archiveNotification(notification.id));\n    95→  }\n    96→\n    97→  return (\n    98→    <div\n    99→      className={`notification-row ${!notification.read ? 'notification-row-unread' : ''}`}\n   100→      data-testid={`notification-row-${notification.id}`}\n   101→      onClick={handleClick}\n   102→      role=\"button\"\n   103→      tabIndex={0}\n   104→      onKeyDown={(e) => { if (e.key === 'Enter') handleClick(); }}\n   105→    >\n   106→      <div className=\"notification-row-left\">\n   107→        <span className=\"notification-row-icon\" data-testid={`notification-icon-${notification.id}`}>\n   108→          {getTypeIcon(notification.type)}\n   109→        </span>\n   110→        <span className=\"notification-row-identifier\" data-testid={`notification-identifier-${notification.id}`}>\n   111→          {notification.issue_identifier}\n   112→        </span>\n   113→        <span className=\"notification-row-description\" data-testid={`notification-description-${notification.id}`}>\n   114→          {notification.description}\n   115→        </span>\n   116→      </div>\n   117→      <div className=\"notification-row-right\">\n   118→        <span className=\"notification-row-timestamp\" data-testid={`notification-timestamp-${notification.id}`}>\n   119→          {formatRelativeTime(notification.created_at)}\n   120→        </span>\n   121→        <button\n   122→          className=\"notification-row-archive-btn\"\n   123→          onClick={handleArchive}\n   124→          title=\"Archive\"\n   125→          data-testid={`notification-archive-btn-${notification.id}`}\n   126→        >\n   127→          <ArchiveIcon />\n   128→        </button>\n   129→      </div>\n   130→    </div>\n   131→  );\n   132→}\n   133→"}]},"parent_tool_use_id":"toolu_01KKkME1JvERX5U4kAf57VDJ","session_id":"082cad4c-aeb8-4793-9f14-2c9a8624c360","uuid":"07f91b07-a476-4953-a06c-2f65bb654885"}
