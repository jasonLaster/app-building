[2026-03-14T21:07:22.222Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PnffrNBzUYisYFs8h3jJNc","type":"tool_result","content":"     1→import { neon } from '@neondatabase/serverless';\n     2→import { randomBytes, pbkdf2Sync } from 'crypto';\n     3→\n     4→export async function truncateAndSeed(databaseUrl: string) {\n     5→  const sql = neon(databaseUrl);\n     6→\n     7→  // Truncate all tables in dependency order\n     8→  await sql`TRUNCATE project_activity, project_milestones, notifications, activity, comments, issue_labels, issues, cycles, team_members, sessions, projects, labels, teams, members, workspaces CASCADE`;\n     9→\n    10→  await seedDatabase(databaseUrl);\n    11→}\n    12→\n    13→export async function seedDatabase(databaseUrl: string) {\n    14→  const sql = neon(databaseUrl);\n    15→\n    16→  // Helper to hash passwords\n    17→  function hashPassword(password: string) {\n    18→    const salt = randomBytes(16).toString('hex');\n    19→    const hash = pbkdf2Sync(password, salt, 10000, 64, 'sha512').toString('hex');\n    20→    return { hash, salt };\n    21→  }\n    22→\n    23→  // Create workspace\n    24→  const wsRows = await sql`\n    25→    INSERT INTO workspaces (name) VALUES ('Acme Corp')\n    26→    RETURNING id\n    27→  `;\n    28→  const _workspaceId = wsRows[0]?.id;\n    29→\n    30→  // Create members\n    31→  const pw1 = hashPassword('password123');\n    32→  const pw2 = hashPassword('password123');\n    33→  const pw3 = hashPassword('password123');\n    34→\n    35→  const m1Rows = await sql`\n    36→    INSERT INTO members (name, email, password_hash, password_salt, role)\n    37→    VALUES ('Alice Johnson', 'alice@acme.com', ${pw1.hash}, ${pw1.salt}, 'admin')\n    38→    RETURNING id\n    39→  `;\n    40→  const m2Rows = await sql`\n    41→    INSERT INTO members (name, email, password_hash, password_salt, role)\n    42→    VALUES ('Bob Smith', 'bob@acme.com', ${pw2.hash}, ${pw2.salt}, 'member')\n    43→    RETURNING id\n    44→  `;\n    45→  const m3Rows = await sql`\n    46→    INSERT INTO members (name, email, password_hash, password_salt, role)\n    47→    VALUES ('Carol Davis', 'carol@acme.com', ${pw3.hash}, ${pw3.salt}, 'member')\n    48→    RETURNING id\n    49→  `;\n    50→\n    51→  const aliceId = m1Rows[0]?.id;\n    52→  const bobId = m2Rows[0]?.id;\n    53→  const carolId = m3Rows[0]?.id;\n    54→\n    55→  // Create teams\n    56→  const t1Rows = await sql`\n    57→    INSERT INTO teams (name, identifier, description)\n    58→    VALUES ('Engineering', 'ENG', 'Core product engineering team')\n    59→    RETURNING id\n    60→  `;\n    61→  const t2Rows = await sql`\n    62→    INSERT INTO teams (name, identifier, description)\n    63→    VALUES ('Design', 'DES', 'Product design and UX team')\n    64→    RETURNING id\n    65→  `;\n    66→\n    67→  const engId = t1Rows[0]?.id;\n    68→  const desId = t2Rows[0]?.id;\n    69→\n    70→  // Set default team on workspace\n    71→  await sql`UPDATE workspaces SET default_team_id = ${engId} WHERE name = 'Acme Corp'`;\n    72→\n    73→  // Team members\n    74→  await sql`INSERT INTO team_members (team_id, member_id) VALUES (${engId}, ${aliceId})`;\n    75→  await sql`INSERT INTO team_members (team_id, member_id) VALUES (${engId}, ${bobId})`;\n    76→  await sql`INSERT INTO team_members (team_id, member_id) VALUES (${engId}, ${carolId})`;\n    77→  await sql`INSERT INTO team_members (team_id, member_id) VALUES (${desId}, ${aliceId})`;\n    78→  await sql`INSERT INTO team_members (team_id, member_id) VALUES (${desId}, ${carolId})`;\n    79→\n    80→  // Create labels\n    81→  const l1Rows = await sql`INSERT INTO labels (name, color) VALUES ('Bug', '#ef4444') RETURNING id`;\n    82→  const l2Rows = await sql`INSERT INTO labels (name, color) VALUES ('Feature', '#22c55e') RETURNING id`;\n    83→  const l3Rows = await sql`INSERT INTO labels (name, color) VALUES ('Improvement', '#3b82f6') RETURNING id`;\n    84→  const l4Rows = await sql`INSERT INTO labels (name, color) VALUES ('Documentation', '#a855f7') RETURNING id`;\n    85→\n    86→  const bugLabelId = l1Rows[0]?.id;\n    87→  const featureLabelId = l2Rows[0]?.id;\n    88→  const improvementLabelId = l3Rows[0]?.id;\n    89→  const docLabelId = l4Rows[0]?.id;\n    90→\n    91→  // Create project\n    92→  const p1Rows = await sql`\n    93→    INSERT INTO projects (name, description, status, target_date, lead_id)\n    94→    VALUES ('V2 Launch', 'Version 2.0 product launch with new features', 'in_progress', '2026-06-30', ${aliceId})\n    95→    RETURNING id\n    96→  `;\n    97→  const projectId = p1Rows[0]?.id;\n    98→\n    99→  // Create cycle\n   100→  const c1Rows = await sql`\n   101→    INSERT INTO cycles (name, start_date, end_date, team_id, status)\n   102→    VALUES ('Sprint 12', '2026-03-10', '2026-03-24', ${engId}, 'active')\n   103→    RETURNING id\n   104→  `;\n   105→  const cycleId = c1Rows[0]?.id;\n   106→\n   107→  // Create issues for Engineering team\n   108→  const issueData = [\n   109→    { title: 'Fix login session expiration bug', status: 'in_progress', priority: 'high', number: 1, assigneeId: aliceId, projectId, cycleId, labelId: bugLabelId },\n   110→    { title: 'Implement real-time notifications', status: 'todo', priority: 'medium', number: 2, assigneeId: bobId, projectId, cycleId, labelId: featureLabelId },\n   111→    { title: 'Add dark mode toggle', status: 'backlog', priority: 'low', number: 3, assigneeId: null, projectId, cycleId: null, labelId: featureLabelId },\n   112→    { title: 'Optimize database queries for issue list', status: 'in_review', priority: 'high', number: 4, assigneeId: carolId, projectId, cycleId, labelId: improvementLabelId },\n   113→    { title: 'Write API documentation', status: 'done', priority: 'medium', number: 5, assigneeId: bobId, projectId: null, cycleId: null, labelId: docLabelId },\n   114→    { title: 'Fix broken pagination on team view', status: 'todo', priority: 'urgent', number: 6, assigneeId: aliceId, projectId, cycleId, labelId: bugLabelId },\n   115→    { title: 'Add keyboard shortcuts help modal', status: 'backlog', priority: 'none', number: 7, assigneeId: null, projectId: null, cycleId: null, labelId: improvementLabelId },\n   116→    { title: 'Implement issue search with fuzzy matching', status: 'in_progress', priority: 'medium', number: 8, assigneeId: bobId, projectId, cycleId, labelId: featureLabelId },\n   117→  ];\n   118→\n   119→  for (const issue of issueData) {\n   120→    const rows = await sql`\n   121→      INSERT INTO issues (team_id, title, status, priority, number, assignee_id, project_id, cycle_id)\n   122→      VALUES (${engId}, ${issue.title}, ${issue.status}, ${issue.priority}, ${issue.number},\n   123→              ${issue.assigneeId}, ${issue.projectId}, ${issue.cycleId})\n   124→      RETURNING id\n   125→    `;\n   126→    const issueId = rows[0]?.id;\n   127→    if (issueId && issue.labelId) {\n   128→      await sql`INSERT INTO issue_labels (issue_id, label_id) VALUES (${issueId}, ${issue.labelId})`;\n   129→    }\n   130→  }\n   131→\n   132→  // Create issues for Design team\n   133→  const designIssues = [\n   134→    { title: 'Redesign settings page', status: 'in_progress', priority: 'medium', number: 1, assigneeId: carolId, labelId: improvementLabelId },\n   135→    { title: 'Create icon set for issue priorities', status: 'done', priority: 'high', number: 2, assigneeId: carolId, labelId: featureLabelId },\n   136→    { title: 'Design empty states for all pages', status: 'todo', priority: 'low', number: 3, assigneeId: aliceId, labelId: improvementLabelId },\n   137→  ];\n   138→\n   139→  for (const issue of designIssues) {\n   140→    const rows = await sql`\n   141→      INSERT INTO issues (team_id, title, status, priority, number, assignee_id, project_id)\n   142→      VALUES (${desId}, ${issue.title}, ${issue.status}, ${issue.priority}, ${issue.number},\n   143→              ${issue.assigneeId}, ${projectId})\n   144→      RETURNING id\n   145→    `;\n   146→    const issueId = rows[0]?.id;\n   147→    if (issueId && issue.labelId) {\n   148→      await sql`INSERT INTO issue_labels (issue_id, label_id) VALUES (${issueId}, ${issue.labelId})`;\n   149→    }\n   150→  }\n   151→\n   152→  // Create project milestones\n   153→  await sql`\n   154→    INSERT INTO project_milestones (project_id, name, target_date, completed)\n   155→    VALUES (${projectId}, 'API Complete', '2026-04-15', false)\n   156→  `;\n   157→  await sql`\n   158→    INSERT INTO project_milestones (project_id, name, target_date, completed)\n   159→    VALUES (${projectId}, 'Beta Launch', '2026-05-30', false)\n   160→  `;\n   161→\n   162→  // Create some notifications for Alice\n   163→  const firstEngIssueRows = await sql`SELECT id FROM issues WHERE team_id = ${engId} AND number = 2 LIMIT 1`;\n   164→  const notifIssueId = firstEngIssueRows[0]?.id;\n   165→\n   166→  if (notifIssueId) {\n   167→    await sql`\n   168→      INSERT INTO notifications (member_id, type, message, issue_id, read, archived)\n   169→      VALUES (${aliceId}, 'assigned', 'You were assigned to ENG-2: Implement real-time notifications', ${notifIssueId}, false, false)\n   170→    `;\n   171→    await sql`\n   172→      INSERT INTO notifications (member_id, type, message, issue_id, read, archived)\n   173→      VALUES (${aliceId}, 'comment', 'Bob commented on ENG-2: Implement real-time notifications', ${notifIssueId}, false, false)\n   174→    `;\n   175→  }\n   176→\n   177→  console.log('Database seeded successfully');\n   178→}\n   179→\n   180→export async function resetDatabase(databaseUrl: string) {\n   181→  await truncateAndSeed(databaseUrl);\n   182→}\n   183→\n   184→// CLI\n   185→const url = process.argv[2];\n   186→if (url) {\n   187→  truncateAndSeed(url).then(() => {\n   188→    process.exit(0);\n   189→  }).catch((err) => {\n   190→    console.error('Seed failed:', err);\n   191→    process.exit(1);\n   192→  });\n   193→}\n   194→"}]},"parent_tool_use_id":"toolu_014eR7wVX7AcLMUqBVwwRoLL","session_id":"082cad4c-aeb8-4793-9f14-2c9a8624c360","uuid":"9c16384d-093c-410c-bf07-475f6cf13249"}
