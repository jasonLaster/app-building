 className=\"flex items-center gap-1 text-sm text-text-secondary mt-1\">\n              <MapPin size={14} aria-hidden=\"true\" />\n              {booking.property_city}\n              {booking.property_country ? `, ${booking.property_country}` : ''}\n            </p>\n          )}\n          <p className=\"flex items-center gap-1 text-sm text-text-secondary mt-1\">\n            <Calendar size={14} aria-hidden=\"true\" />\n            {formatDateRange(booking.check_in, booking.check_out)}\n          </p>\n        </div>\n\n        <div className=\"flex items-center justify-between mt-2\">\n          <p className=\"text-sm font-semibold text-text\">\n            ${Number(booking.total_price).toFixed(0)}\n          </p>\n          <div className=\"flex gap-2\" onClick={(e) => e.stopPropagation()}>\n            {canCancel && (\n              <button\n                data-testid={`cancel-button-${booking.id}`}\n                onClick={onCancel}\n                aria-label={`Cancel booking for ${title}`}\n                className=\"text-xs font-semibold px-3 py-1.5 rounded-lg border border-border text-text hover:bg-bg-secondary transition-colors\"\n              >\n                Cancel\n              </button>\n            )}\n            {canReview && (\n              <button\n                data-testid={`review-button-${booking.id}`}\n                onClick={() => navigate(`/trips/${booking.id}/review`)}\n<<<<<<< HEAD\n                className=\"text-xs font-semibold px-3 py-1.5 rounded-lg bg-text text-white hover:opacity-90 transition-opacity\"\n=======\n                aria-label={`Write review for ${title}`}\n                className=\"text-xs font-medium px-3 py-1.5 rounded-lg bg-primary text-white hover:bg-primary-dark transition-colors\"\n>>>>>>> origin/feature/airbnb-clone\n              >\n                Write Review\n              </button>\n            )}\n            {booking.status === 'completed' && booking.has_review && (\n              <span\n                data-testid={`reviewed-badge-${booking.id}`}\n                className=\"text-xs font-medium px-3 py-1.5 text-status-confirmed\"\n              >\n                Reviewed\n              </span>\n            )}\n          </div>\n        </div>\n      </div>\n    </article>\n  )\n}\n","structuredPatch":[{"oldStart":105,"oldLines":12,"newStart":105,"newLines":8,"lines":["               <button","                 data-testid={`review-button-${booking.id}`}","                 onClick={() => navigate(`/trips/${booking.id}/review`)}","-<<<<<<< HEAD","-                className=\"text-xs font-semibold px-3 py-1.5 rounded-lg bg-text text-white hover:opacity-90 transition-opacity\"","-=======","                 aria-label={`Write review for ${title}`}","-                className=\"text-xs font-medium px-3 py-1.5 rounded-lg bg-primary text-white hover:bg-primary-dark transition-colors\"","->>>>>>> origin/feature/airbnb-clone","+                className=\"text-xs font-semibold px-3 py-1.5 rounded-lg bg-text text-white hover:opacity-90 transition-opacity\"","               >","                 Write Review","               </button>"]}],"userModified":false,"replaceAll":false}}
