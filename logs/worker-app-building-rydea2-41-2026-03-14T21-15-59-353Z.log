er, setCreatedIdentifier] = useState<string | null>(null);\n    39→\n    40→  // Reset form when modal opens\n    41→  useEffect(() => {\n    42→    if (createIssueModalOpen) {\n    43→      setFormData({\n    44→        ...INITIAL_FORM_DATA,\n    45→        parentId: createIssueDefaultParentId || null,\n    46→        teamId: createIssueDefaultTeamId || '',\n    47→      });\n    48→      setTitleError(null);\n    49→      setSubmitting(false);\n    50→      setCreatedIdentifier(null);\n    51→    }\n    52→  }, [createIssueModalOpen, createIssueDefaultParentId, createIssueDefaultTeamId]);\n    53→\n    54→  const handleClose = useCallback(() => {\n    55→    dispatch(closeCreateIssueModal());\n    56→  }, [dispatch]);\n    57→\n    58→  // Handle Escape key\n    59→  useEffect(() => {\n    60→    if (!createIssueModalOpen) return;\n    61→    function handleKeyDown(e: KeyboardEvent) {\n    62→      if (e.key === 'Escape') {\n    63→        handleClose();\n    64→      }\n    65→    }\n    66→    document.addEventListener('keydown', handleKeyDown);\n    67→    return () => document.removeEventListener('keydown', handleKeyDown);\n    68→  }, [createIssueModalOpen, handleClose]);\n    69→\n    70→  async function handleSubmit() {\n    71→    if (!formData.title.trim()) {\n    72→      setTitleError('Title is required');\n    73→      return;\n    74→    }\n    75→    setTitleError(null);\n    76→    setSubmitting(true);\n    77→\n    78→    try {\n    79→      const result = await dispatch(createIssue({\n    80→        teamId: formData.teamId,"}]},"parent_tool_use_id":"toolu_015XV1nQJhKbMR1qoiNUWMsD","session_id":"2c607231-e59c-4294-b7c7-ee3262a8a78e","uuid":"cbb42710-1474-4486-9502-fb70e6a6828c"}
