align-items: center;\n  gap: 6px;\n  padding: 8px 16px;\n  border-radius: var(--radius-full);\n  border: 1px solid var(--color-border);\n  background: var(--color-surface);\n  color: var(--color-text-primary);\n  font-size: 14px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: background 0.15s, border-color 0.15s, box-shadow 0.15s;\n  white-space: nowrap;\n}\n\n.search-summary-bar__chip:hover {\n  background: var(--color-primary-light);\n  border-color: var(--color-primary);\n}\n\n.search-summary-bar__chip--active {\n  background: var(--color-primary-light);\n  border-color: var(--color-primary);\n  color: var(--color-primary);\n}\n\n.search-summary-bar__chip-icon {\n  font-size: 14px;\n}\n\n.search-summary-bar__arrow {\n  color: var(--color-text-secondary);\n  font-size: 16px;\n  font-weight: 500;\n}\n\n.search-summary-bar__divider {\n  width: 1px;\n  height: 24px;\n  background: var(--color-border-light);\n  margin: 0 4px;\n}\n\n.search-summary-bar__chip-wrapper {\n  position: relative;\n}\n\n.search-summary-bar__editor {\n  position: absolute;\n  top: calc(100% + 8px);\n  left: 0;\n  z-index: 100;\n  background: var(--color-surface);\n  border-radius: var(--radius-md);\n  box-shadow: 0 4px 16px var(--color-shadow-hover);\n  padding: 8px;\n  min-width: 280px;\n}\n\n.search-summary-bar__editor--wide {\n  min-width: 320px;\n}\n\n.search-summary-bar__apply-btn {\n  display: block;\n  width: 100%;\n  margin-top: 8px;\n  padding: 8px 16px;\n  background: var(--color-primary);\n  color: white;\n  border: none;\n  border-radius: var(--radius-md);\n  font-size: 14px;\n  font-weight: 500;\n  cursor: pointer;\n  transition: background 0.15s;\n}\n\n.search-summary-bar__apply-btn:hover {\n  background: var(--color-primary-dark);\n}\n\n@media (max-width: 640px) {\n  .search-summary-bar {\n    padding: 8px 12px;\n  }\n\n  .search-summary-bar__chips {\n    gap: 6px;\n  }\n\n  .search-summary-bar__chip {\n    padding: 6px 12px;\n    font-size: 13px;\n  }\n\n  .search-summary-bar__divider {\n    display: none;\n  }\n}\n","numLines":117,"startLine":1,"totalLines":117}}}
