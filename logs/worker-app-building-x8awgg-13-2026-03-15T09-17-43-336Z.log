[2026-03-15T09:01:05.884Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CWhJrXv8FcyVJaMw5WngcM","type":"tool_result","content":"     1→import { useState, useRef, useEffect } from 'react'\n     2→import './DatePicker.css'\n     3→\n     4→interface DatePickerProps {\n     5→  value: string | null\n     6→  onChange: (date: string | null) => void\n     7→  placeholder: string\n     8→  minDate?: string | null\n     9→  error?: string\n    10→  testIdPrefix: string\n    11→  initiallyOpen?: boolean\n    12→}\n    13→\n    14→function DatePicker({ value, onChange, placeholder, minDate, error, testIdPrefix, initiallyOpen }: DatePickerProps) {\n    15→  const [isOpen, setIsOpen] = useState(initiallyOpen ?? false)\n    16→  const [viewDate, setViewDate] = useState(() => {\n    17→    if (value) return new Date(value + 'T00:00:00')\n    18→    return new Date()\n    19→  })\n    20→  const ref = useRef<HTMLDivElement>(null)\n    21→\n    22→  useEffect(() => {\n    23→    function handleClickOutside(e: MouseEvent) {\n    24→      if (ref.current && !ref.current.contains(e.target as Node)) {\n    25→        setIsOpen(false)\n    26→      }\n    27→    }\n    28→    if (isOpen) {\n    29→      document.addEventListener('mousedown', handleClickOutside)\n    30→      return () => document.removeEventListener('mousedown', handleClickOutside)\n    31→    }\n    32→  }, [isOpen])\n    33→\n    34→  const today = new Date()\n    35→  today.setHours(0, 0, 0, 0)\n    36→\n    37→  const currentMonthStart = new Date()\n    38→  currentMonthStart.setDate(1)\n    39→  currentMonthStart.setHours(0, 0, 0, 0)\n    40→\n    41→  function formatDateDisplay(dateStr: string): string {\n    42→    const d = new Date(dateStr + 'T00:00:00')\n    43→    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })\n    44→  }\n    45→\n    46→  function formatYMD(d: Date): string {\n    47→    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`\n    48→  }\n    49→\n    50→  function getDaysInMonth(year: number, month: number): number {\n    51→    return new Date(year, month + 1, 0).getDate()\n    52→  }\n    53→\n    54→  function getFirstDayOfMonth(year: number, month: number): number {\n    55→    return new Date(year, month, 1).getDay()\n    56→  }\n    57→\n    58→  function isDateDisabled(dateStr: string): boolean {\n    59→    const d = new Date(dateStr + 'T00:00:00')\n    60→    if (d < today) return true\n    61→    if (minDate) {\n    62→      const min = new Date(minDate + 'T00:00:00')\n    63→      if (d < min) return true\n    64→    }\n    65→    return false\n    66→  }\n    67→\n    68→  function canGoPrev(): boolean {\n    69→    const viewMonth = new Date(viewDate.getFullYear(), viewDate.getMonth(), 1)\n    70→    return viewMonth > currentMonthStart\n    71→  }\n    72→\n    73→  function goToPrevMonth() {\n    74→    if (!canGoPrev()) return\n    75→    setViewDate(new Date(viewDate.getFullYear(), viewDate.getMonth() - 1, 1))\n    76→  }\n    77→\n    78→  function goToNextMonth() {\n    79→    setViewDate(new Date(viewDate.getFullYear(), viewDate.getMonth() + 1, 1))\n    80→  }\n    81→\n    82→  function handleDateClick(dateStr: string) {\n    83→    if (isDateDisabled(dateStr)) return\n    84→    onChange(dateStr)\n    85→    setIsOpen(false)\n    86→  }\n    87→\n    88→  const year = viewDate.getFullYear()\n    89→  const month = viewDate.getMonth()\n    90→  const daysInMonth = getDaysInMonth(year, month)\n    91→  const firstDay = getFirstDayOfMonth(year, month)\n    92→  const monthLabel = viewDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })\n    93→\n    94→  const days: (string | null)[] = []\n    95→  for (let i = 0; i < firstDay; i++) days.push(null)\n    96→  for (let d = 1; d <= daysInMonth; d++) {\n    97→    days.push(formatYMD(new Date(year, month, d)))\n    98→  }\n    99→\n   100→  return (\n   101→    <div className={`date-picker ${error ? 'date-picker--error' : ''}`} ref={ref} data-testid={`${testIdPrefix}-container`}>\n   102→      <button\n   103→        className=\"date-picker__trigger\"\n   104→        onClick={() => {\n   105→          setIsOpen(!isOpen)\n   106→          if (!isOpen && value) {\n   107→            setViewDate(new Date(value + 'T00:00:00'))\n   108→          }\n   109→        }}\n   110→        data-testid={`${testIdPrefix}-trigger`}\n   111→      >\n   112→        <span className=\"date-picker__icon\">📅</span>\n   113→        <span className={value ? '' : 'date-picker__placeholder'}>\n   114→          {value ? formatDateDisplay(value) : placeholder}\n   115→        </span>\n   116→      </button>\n   117→      {error && <span className=\"date-picker__error\" data-testid={`${testIdPrefix}-error`}>{error}</span>}\n   118→      {isOpen && (\n   119→        <div className=\"date-picker__calendar\" data-testid={`${testIdPrefix}-calendar`}>\n   120→          <div className=\"date-picker__header\">\n   121→            <button\n   122→              className=\"date-picker__nav-btn\"\n   123→              onClick={goToPrevMonth}\n   124→              disabled={!canGoPrev()}\n   125→              data-testid={`${testIdPrefix}-prev-month`}\n   126→            >\n   127→              ◀\n   128→            </button>\n   129→            <span className=\"date-picker__month-label\" data-testid={`${testIdPrefix}-month-label`}>{monthLabel}</span>\n   130→            <button\n   131→              className=\"date-picker__nav-btn\"\n   132→              onClick={goToNextMonth}\n   133→              data-testid={`${testIdPrefix}-next-month`}\n   134→            >\n   135→              ▶\n   136→            </button>\n   137→          </div>\n   138→          <div className=\"date-picker__weekdays\">\n   139→            {['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].map((d) => (\n   140→              <span key={d} className=\"date-picker__weekday\">{d}</span>\n   141→            ))}\n   142→          </div>\n   143→          <div className=\"date-picker__days\">\n   144→            {days.map((dateStr, i) => {\n   145→              if (!dateStr) return <span key={`empty-${i}`} className=\"date-picker__day-empty\" />\n   146→              const disabled = isDateDisabled(dateStr)\n   147→              const selected = value === dateStr\n   148→              const dayNum = new Date(dateStr + 'T00:00:00').getDate()\n   149→              return (\n   150→                <button\n   151→                  key={dateStr}\n   152→                  className={`date-picker__day ${disabled ? 'date-picker__day--disabled' : ''} ${selected ? 'date-picker__day--selected' : ''}`}\n   153→                  onClick={() => handleDateClick(dateStr)}\n   154→                  disabled={disabled}\n   155→                  data-testid={`${testIdPrefix}-day-${dateStr}`}\n   156→                >\n   157→                  {dayNum}\n   158→                </button>\n   159→              )\n   160→            })}\n   161→          </div>\n   162→        </div>\n   163→      )}\n   164→    </div>\n   165→  )\n   166→}\n   167→\n   168→export default DatePicker\n   169→"}]},"parent_tool_use_id":"toolu_01PV2mVyTiebvsJBtBLRaVCW","session_id":"eb525227-e996-4510-92e8-ef0d46b50769","uuid":"a316c3d9-b9e3-4a4d-bb84-bd33b2dc56b9"}
