[2026-03-15T09:01:09.362Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Lg7UkkjsombXHPAiKQUQZg","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test'\n     2→\n     3→/**\n     4→ * Helper to build a results page URL with search parameters.\n     5→ */\n     6→function buildResultsUrl(params?: {\n     7→  origin?: string\n     8→  destination?: string\n     9→  departureDate?: string\n    10→  returnDate?: string\n    11→  tripType?: string\n    12→  cabinClass?: string\n    13→  adults?: number\n    14→  children?: number\n    15→  infants?: number\n    16→}): string {\n    17→  const nextMonth = new Date()\n    18→  nextMonth.setMonth(nextMonth.getMonth() + 1)\n    19→  const year = nextMonth.getFullYear()\n    20→  const month = String(nextMonth.getMonth() + 1).padStart(2, '0')\n    21→  const defaultDeparture = `${year}-${month}-25`\n    22→  const defaultReturn = `${year}-${month}-30`\n    23→\n    24→  const sp = new URLSearchParams({\n    25→    origin: params?.origin ?? 'LAX',\n    26→    destination: params?.destination ?? 'JFK',\n    27→    departureDate: params?.departureDate ?? defaultDeparture,\n    28→    tripType: params?.tripType ?? 'round_trip',\n    29→    cabinClass: params?.cabinClass ?? 'economy',\n    30→    adults: String(params?.adults ?? 1),\n    31→    children: String(params?.children ?? 0),\n    32→    infants: String(params?.infants ?? 0),\n    33→  })\n    34→  if (params?.returnDate !== undefined) {\n    35→    sp.set('returnDate', params.returnDate)\n    36→  } else if ((params?.tripType ?? 'round_trip') === 'round_trip') {\n    37→    sp.set('returnDate', defaultReturn)\n    38→  }\n    39→  return `/results?${sp.toString()}`\n    40→}\n    41→\n    42→test.describe('SearchSummaryBar', () => {\n    43→  test.beforeEach(async ({ page }) => {\n    44→    const url = buildResultsUrl()\n    45→    await page.goto(url)\n    46→    await expect(page.getByTestId('search-results-page')).toBeVisible({ timeout: 15000 })\n    47→    // Wait for search summary bar to be visible\n    48→    await expect(page.getByTestId('search-summary-bar')).toBeVisible({ timeout: 10000 })\n    49→  })\n    50→\n    51→  test('SearchSummaryBar displays search parameters after search', async ({ page }) => {\n    52→    // Verify origin chip displays LAX\n    53→    await expect(page.getByTestId('summary-origin')).toContainText('LAX')\n    54→    // Verify destination chip displays JFK\n    55→    await expect(page.getByTestId('summary-destination')).toContainText('JFK')\n    56→    // Verify dates chip is visible with formatted date\n    57→    await expect(page.getByTestId('summary-dates')).toBeVisible()\n    58→    // Verify passengers chip displays \"1 adult\"\n    59→    await expect(page.getByTestId('summary-passengers')).toContainText('1 adult')\n    60→    // Verify cabin class chip displays \"Economy\"\n    61→    await expect(page.getByTestId('summary-cabin-class')).toContainText('Economy')\n    62→\n    63→    // Each chip should be clickable (buttons)\n    64→    await expect(page.getByTestId('summary-origin')).toBeEnabled()\n    65→    await expect(page.getByTestId('summary-destination')).toBeEnabled()\n    66→    await expect(page.getByTestId('summary-dates')).toBeEnabled()\n    67→    await expect(page.getByTestId('summary-passengers')).toBeEnabled()\n    68→    await expect(page.getByTestId('summary-cabin-class')).toBeEnabled()\n    69→  })\n    70→\n    71→  test('SearchSummaryBar inline edit origin airport', async ({ page }) => {\n    72→    // Click origin chip to open editor\n    73→    await page.getByTestId('summary-origin').click()\n    74→    await expect(page.getByTestId('summary-origin-editor')).toBeVisible()\n    75→\n    76→    // Type SFO in the autocomplete\n    77→    const originInput = page.getByTestId('summary-origin-autocomplete-input')\n    78→    await originInput.click()\n    79→    await originInput.fill('San')\n    80→    await expect(page.getByTestId('summary-origin-autocomplete-dropdown')).toBeVisible({ timeout: 10000 })\n    81→    await page.getByTestId('summary-origin-autocomplete-suggestion-SFO').click()\n    82→\n    83→    // Editor should close\n    84→    await expect(page.getByTestId('summary-origin-editor')).not.toBeVisible()\n    85→\n    86→    // URL should update with new origin\n    87→    await expect(page).toHaveURL(/origin=SFO/, { timeout: 10000 })\n    88→    // Summary bar should show SFO\n    89→    await expect(page.getByTestId('summary-origin')).toContainText('SFO')\n    90→  })\n    91→\n    92→  test('SearchSummaryBar inline edit destination airport', async ({ page }) => {\n    93→    // Click destination chip to open editor\n    94→    await page.getByTestId('summary-destination').click()\n    95→    await expect(page.getByTestId('summary-destination-editor')).toBeVisible()\n    96→\n    97→    // Type ORD in the autocomplete\n    98→    const destInput = page.getByTestId('summary-dest-autocomplete-input')\n    99→    await destInput.click()\n   100→    await destInput.fill('Chicago')\n   101→    await expect(page.getByTestId('summary-dest-autocomplete-dropdown')).toBeVisible({ timeout: 10000 })\n   102→    await page.getByTestId('summary-dest-autocomplete-suggestion-ORD').click()\n   103→\n   104→    // Editor should close\n   105→    await expect(page.getByTestId('summary-destination-editor')).not.toBeVisible()\n   106→\n   107→    // URL should update with new destination\n   108→    await expect(page).toHaveURL(/destination=ORD/, { timeout: 10000 })\n   109→    // Summary bar should show ORD\n   110→    await expect(page.getByTestId('summary-destination')).toContainText('ORD')\n   111→  })\n   112→\n   113→  test('SearchSummaryBar inline edit departure date', async ({ page }) => {\n   114→    // Click dates chip to open departure date editor\n   115→    await page.getByTestId('summary-dates').click()\n   116→    await expect(page.getByTestId('summary-departure-editor')).toBeVisible()\n   117→\n   118→    // The calendar should be visible\n   119→    await expect(page.getByTestId('summary-departure-calendar')).toBeVisible()\n   120→\n   121→    // Pick a different day (28th of the same month)\n   122→    const nextMonth = new Date()\n   123→    nextMonth.setMonth(nextMonth.getMonth() + 1)\n   124→    const year = nextMonth.getFullYear()\n   125→    const month = String(nextMonth.getMonth() + 1).padStart(2, '0')\n   126→    const newDateStr = `${year}-${month}-28`\n   127→    await page.getByTestId(`summary-departure-day-${newDateStr}`).click()\n   128→\n   129→    // Editor should close\n   130→    await expect(page.getByTestId('summary-departure-editor')).not.toBeVisible()\n   131→\n   132→    // URL should update with new departure date\n   133→    await expect(page).toHaveURL(new RegExp(`departureDate=${newDateStr}`), { timeout: 10000 })\n   134→  })\n   135→\n   136→  test('SearchSummaryBar inline edit return date', async ({ page }) => {\n   137→    // Verify return date chip is visible for round trip\n   138→    await expect(page.getByTestId('summary-return-date')).toBeVisible()\n   139→\n   140→    // Click return date chip\n   141→    await page.getByTestId('summary-return-date').click()\n   142→    await expect(page.getByTestId('summary-return-editor')).toBeVisible()\n   143→\n   144→    // The calendar should be visible\n   145→    await expect(page.getByTestId('summary-return-calendar')).toBeVisible()\n   146→\n   147→    // Pick a different return date (28th)\n   148→    const nextMonth = new Date()\n   149→    nextMonth.setMonth(nextMonth.getMonth() + 1)\n   150→    const year = nextMonth.getFullYear()\n   151→    const month = String(nextMonth.getMonth() + 1).padStart(2, '0')\n   152→    const newReturnStr = `${year}-${month}-28`\n   153→    await page.getByTestId(`summary-return-day-${newReturnStr}`).click()\n   154→\n   155→    // Editor should close\n   156→    await expect(page.getByTestId('summary-return-editor')).not.toBeVisible()\n   157→\n   158→    // URL should update with new return date\n   159→    await expect(page).toHaveURL(new RegExp(`returnDate=${newReturnStr}`), { timeout: 10000 })\n   160→  })\n   161→\n   162→  test('SearchSummaryBar inline edit passengers', async ({ page }) => {\n   163→    // Click passengers chip\n   164→    await page.getByTestId('summary-passengers').click()\n   165→    await expect(page.getByTestId('summary-passengers-editor')).toBeVisible()\n   166→\n   167→    // Verify adults count is 1\n   168→    await expect(page.getByTestId('adults-count')).toHaveText('1')\n   169→\n   170→    // Increment adults to 2\n   171→    await page.getByTestId('adults-increment').click()\n   172→    await expect(page.getByTestId('adults-count')).toHaveText('2')\n   173→\n   174→    // Click Done to apply\n   175→    await page.getByTestId('summary-passengers-done').click()\n   176→\n   177→    // Editor should close\n   178→    await expect(page.getByTestId('summary-passengers-editor')).not.toBeVisible()\n   179→\n   180→    // URL should update with adults=2\n   181→    await expect(page).toHaveURL(/adults=2/, { timeout: 10000 })\n   182→    // Summary should show \"2 passengers\"\n   183→    await expect(page.getByTestId('summary-passengers')).toContainText('2 passengers')\n   184→  })\n   185→\n   186→  test('SearchSummaryBar inline edit cabin class', async ({ page }) => {\n   187→    // Click cabin class chip\n   188→    await page.getByTestId('summary-cabin-class').click()\n   189→    await expect(page.getByTestId('summary-cabin-editor')).toBeVisible()\n   190→\n   191→    // Verify dropdown is visible\n   192→    await expect(page.getByTestId('cabin-class-dropdown')).toBeVisible()\n   193→\n   194→    // Select Business\n   195→    await page.getByTestId('cabin-class-option-business').click()\n   196→\n   197→    // Click Done to apply\n   198→    await page.getByTestId('summary-cabin-done').click()\n   199→\n   200→    // Editor should close\n   201→    await expect(page.getByTestId('summary-cabin-editor')).not.toBeVisible()\n   202→\n   203→    // URL should update with cabinClass=business\n   204→    await expect(page).toHaveURL(/cabinClass=business/, { timeout: 10000 })\n   205→    // Summary should show \"Business\"\n   206→    await expect(page.getByTestId('summary-cabin-class')).toContainText('Business')\n   207→  })\n   208→\n   209→  test('SearchSummaryBar inline editor closes without changes on outside click', async ({ page }) => {\n   210→    // Record current URL\n   211→    const urlBefore = page.url()\n   212→\n   213→    // Click origin chip to open editor\n   214→    await page.getByTestId('summary-origin').click()\n   215→    await expect(page.getByTestId('summary-origin-editor')).toBeVisible()\n   216→\n   217→    // Click outside the summary bar (on the results page body)\n   218→    await page.getByTestId('search-results-page').click({ position: { x: 5, y: 500 } })\n   219→\n   220→    // Editor should close\n   221→    await expect(page.getByTestId('summary-origin-editor')).not.toBeVisible()\n   222→\n   223→    // URL should remain unchanged\n   224→    expect(page.url()).toBe(urlBefore)\n   225→\n   226→    // Summary bar values should remain the same\n   227→    await expect(page.getByTestId('summary-origin')).toContainText('LAX')\n   228→  })\n   229→\n   230→  test('SearchSummaryBar can be edited multiple times in sequence', async ({ page }) => {\n   231→    test.slow()\n   232→\n   233→    // First edit: change origin to SFO\n   234→    await page.getByTestId('summary-origin').click()\n   235→    await expect(page.getByTestId('summary-origin-editor')).toBeVisible()\n   236→    const originInput = page.getByTestId('summary-origin-autocomplete-input')\n   237→    await originInput.click()\n   238→    await originInput.fill('San')\n   239→    await expect(page.getByTestId('summary-origin-autocomplete-dropdown')).toBeVisible({ timeout: 10000 })\n   240→    await page.getByTestId('summary-origin-autocomplete-suggestion-SFO').click()\n   241→\n   242→    // Wait for URL to update\n   243→    await expect(page).toHaveURL(/origin=SFO/, { timeout: 10000 })\n   244→    await expect(page.getByTestId('summary-origin')).toContainText('SFO')\n   245→\n   246→    // Second edit: change cabin class to Business\n   247→    await page.getByTestId('summary-cabin-class').click()\n   248→    await expect(page.getByTestId('summary-cabin-editor')).toBeVisible()\n   249→    await page.getByTestId('cabin-class-option-business').click()\n   250→    await page.getByTestId('summary-cabin-done').click()\n   251→\n   252→    // Wait for URL to update with both changes\n   253→    await expect(page).toHaveURL(/cabinClass=business/, { timeout: 10000 })\n   254→    await expect(page).toHaveURL(/origin=SFO/, { timeout: 10000 })\n   255→\n   256→    // Verify summary bar reflects all changes\n   257→    await expect(page.getByTestId('summary-origin')).toContainText('SFO')\n   258→    await expect(page.getByTestId('summary-destination')).toContainText('JFK')\n   259→    await expect(page.getByTestId('summary-cabin-class')).toContainText('Business')\n   260→  })\n   261→})\n   262→"}]},"parent_tool_use_id":"toolu_01PV2mVyTiebvsJBtBLRaVCW","session_id":"eb525227-e996-4510-92e8-ef0d46b50769","uuid":"b368c758-0e76-4eca-bfbf-29b93e504e0d"}
