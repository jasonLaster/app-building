[2026-03-15T09:02:27.554Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01J8YRKk2mNzu3F3SsLZNbpA","type":"tool_result","content":"     1→import { execSync, spawn } from 'child_process'\n     2→import { readFileSync, writeFileSync, mkdirSync, readdirSync, existsSync } from 'fs'\n     3→import { join } from 'path'\n     4→import { initSchema } from './schema.ts'\n     5→import { truncateAndSeed } from './seed-db.ts'\n     6→\n     7→const appDir = join(import.meta.dirname, '..')\n     8→const logDir = join(appDir, 'logs')\n     9→mkdirSync(logDir, { recursive: true })\n    10→\n    11→// Determine log file number\n    12→const existingLogs = readdirSync(logDir).filter(f => f.match(/^test-run-\\d+\\.log$/))\n    13→const maxNum = existingLogs.reduce((max, f) => {\n    14→  const m = f.match(/test-run-(\\d+)\\.log/)\n    15→  return m ? Math.max(max, parseInt(m[1]!)) : max\n    16→}, 0)\n    17→const logNum = maxNum + 1\n    18→const logPath = join(logDir, `test-run-${logNum}.log`)\n    19→let logContent = ''\n    20→function log(msg: string) { logContent += msg + '\\n' }\n    21→\n    22→// Read .env\n    23→function readEnv(): Record<string, string> {\n    24→  const envPath = join(appDir, '.env')\n    25→  if (!existsSync(envPath)) return {}\n    26→  const lines = readFileSync(envPath, 'utf-8').split('\\n')\n    27→  const env: Record<string, string> = {}\n    28→  for (const line of lines) {\n    29→    const idx = line.indexOf('=')\n    30→    if (idx > 0 && !line.startsWith('#')) {\n    31→      env[line.slice(0, idx).trim()] = line.slice(idx + 1).trim()\n    32→    }\n    33→  }\n    34→  return env\n    35→}\n    36→\n    37→const testFile = process.argv[2]\n    38→if (!testFile) {\n    39→  console.error('Usage: npm run test <test-file>')\n    40→  process.exit(1)\n    41→}\n    42→\n    43→const NEON_API_KEY = (process.env.NEON_API_KEY || '').trim()\n    44→const RECORD_REPLAY_API_KEY = process.env.RECORD_REPLAY_API_KEY || ''\n    45→const envVars = readEnv()\n    46→const NEON_PROJECT_ID = envVars.NEON_PROJECT_ID || ''\n    47→const DATABASE_URL = envVars.DATABASE_URL || ''\n    48→\n    49→if (!NEON_API_KEY || !NEON_PROJECT_ID || !DATABASE_URL) {\n    50→  console.error('Missing required env vars (NEON_API_KEY, NEON_PROJECT_ID, DATABASE_URL)')\n    51→  process.exit(1)\n    52→}\n    53→\n    54→async function neonApi(method: string, path: string, body?: unknown) {\n    55→  const opts: RequestInit = {\n    56→    method,\n    57→    headers: {\n    58→      'Authorization': `Bearer ${NEON_API_KEY}`,\n    59→      'Content-Type': 'application/json',\n    60→    },\n    61→  }\n    62→  if (body) opts.body = JSON.stringify(body)\n    63→  const res = await fetch(`https://console.neon.tech/api/v2${path}`, opts)\n    64→  return res.json()\n    65→}\n    66→\n    67→async function main() {\n    68→  // Step 1: Kill stale processes\n    69→  try { execSync('pkill -f \"netlify dev\" 2>/dev/null || true', { stdio: 'ignore' }) } catch { /* ignore */ }\n    70→  try { execSync('pkill -f \"functions-server\" 2>/dev/null || true', { stdio: 'ignore' }) } catch { /* ignore */ }\n    71→  try { execSync('pkill -f \"node.*vite\" 2>/dev/null || true', { stdio: 'ignore' }) } catch { /* ignore */ }\n    72→  // Wait for ports to be released\n    73→  await new Promise(r => setTimeout(r, 1000))\n    74→\n    75→  // Step 2: Clean up stale Neon test branches\n    76→  const branchesRes = await neonApi('GET', `/projects/${NEON_PROJECT_ID}/branches`) as { branches?: { id: string; name: string }[] }\n    77→  const branches = branchesRes.branches || []\n    78→  for (const b of branches) {\n    79→    if (b.name.startsWith('test-run-')) {\n    80→      log(`Deleting stale branch: ${b.name}`)\n    81→      await neonApi('DELETE', `/projects/${NEON_PROJECT_ID}/branches/${b.id}`)\n    82→    }\n    83→  }\n    84→\n    85→  // Step 3: Create ephemeral Neon branch\n    86→  const branchName = `test-run-${Date.now()}`\n    87→  log(`Creating branch: ${branchName}`)\n    88→  const branchRes = await neonApi('POST', `/projects/${NEON_PROJECT_ID}/branches`, {\n    89→    branch: { name: branchName },\n    90→    endpoints: [{ type: 'read_write' }],\n    91→  }) as {\n    92→    branch?: { id: string };\n    93→    endpoints?: { host: string }[];\n    94→    roles?: { name: string; password?: string }[];\n    95→    connection_uris?: { connection_uri: string }[];\n    96→  }\n    97→\n    98→  const branchId = branchRes.branch?.id\n    99→  if (!branchId) {\n   100→    log('Failed to create branch: ' + JSON.stringify(branchRes))\n   101→    writeFileSync(logPath, logContent)\n   102→    console.log(`0 passed, 0 failed — see logs/test-run-${logNum}.log`)\n   103→    process.exit(1)\n   104→  }\n   105→\n   106→  let testDbUrl = ''\n   107→  if (branchRes.connection_uris?.[0]?.connection_uri) {\n   108→    testDbUrl = branchRes.connection_uris[0].connection_uri\n   109→  } else {\n   110→    const host = branchRes.endpoints?.[0]?.host || ''\n   111→    const roleName = branchRes.roles?.[0]?.name || 'neondb_owner'\n   112→    let password = branchRes.roles?.[0]?.password || ''\n   113→    if (!password) {\n   114→      const pwRes = await neonApi('GET', `/projects/${NEON_PROJECT_ID}/branches/${branchId}/roles/${roleName}/reveal_password`) as { password?: string }\n   115→      password = pwRes.password || ''\n   116→    }\n   117→    testDbUrl = `postgresql://${roleName}:${password}@${host}/neondb?sslmode=require`\n   118→  }\n   119→\n   120→  log(`Branch DB URL: ${testDbUrl.replace(/:[^:@]+@/, ':***@')}`)\n   121→\n   122→  let playwrightExit = 1\n   123→\n   124→  try {\n   125→    // Step 4: Initialize and seed (with retry for endpoint readiness)\n   126→    log('Initializing schema...')\n   127→    for (let attempt = 1; attempt <= 5; attempt++) {\n   128→      try {\n   129→        await initSchema(testDbUrl)\n   130→        break\n   131→      } catch (e: unknown) {\n   132→        const msg = e instanceof Error ? e.message : String(e)\n   133→        if (attempt < 5 && msg.includes('endpoint could not be found')) {\n   134→          log(`Schema init attempt ${attempt} failed (endpoint not ready), retrying in 3s...`)\n   135→          await new Promise(r => setTimeout(r, 3000))\n   136→        } else {\n   137→          throw e\n   138→        }\n   139→      }\n   140→    }\n   141→    log('Schema initialized')\n   142→\n   143→    log('Seeding database...')\n   144→    for (let attempt = 1; attempt <= 5; attempt++) {\n   145→      try {\n   146→        await truncateAndSeed(testDbUrl)\n   147→        break\n   148→      } catch (e: unknown) {\n   149→        const msg = e instanceof Error ? e.message : String(e)\n   150→        if (attempt < 5 && msg.includes('endpoint could not be found')) {\n   151→          log(`Seed attempt ${attempt} failed (endpoint not ready), retrying in 3s...`)\n   152→          await new Promise(r => setTimeout(r, 3000))\n   153→        } else {\n   154→          throw e\n   155→        }\n   156→      }\n   157→    }\n   158→    log('Database seeded')\n   159→\n   160→    // Step 5a: Start custom functions server\n   161→    log('Starting functions server...')\n   162→    const functionsProc = spawn('npx', ['tsx', 'scripts/functions-server.ts', '9999'], {\n   163→      cwd: appDir,\n   164→      env: { ...process.env, DATABASE_URL: testDbUrl },\n   165→      stdio: ['ignore', 'pipe', 'pipe'],\n   166→    })\n   167→\n   168→    let functionsOutput = ''\n   169→    functionsProc.stdout.on('data', (d: Buffer) => {\n   170→      functionsOutput += d.toString()\n   171→      log('[functions] ' + d.toString().trim())\n   172→    })\n   173→    functionsProc.stderr.on('data', (d: Buffer) => { functionsOutput += d.toString() })\n   174→    functionsProc.on('error', (e: Error) => { log('Functions process error: ' + e.message) })\n   175→    functionsProc.on('exit', (code: number | null) => { log('Functions process exited with code: ' + code) })\n   176→\n   177→    // Wait for functions server\n   178→    await new Promise<void>((resolve, reject) => {\n   179→      const timeout = setTimeout(() => {\n   180→        log('Functions output at timeout:\\n' + functionsOutput)\n   181→        reject(new Error('Functions server start timeout'))\n   182→      }, 30000)\n   183→      const check = setInterval(async () => {\n   184→        if (functionsOutput.includes('Functions server ready')) {\n   185→          clearInterval(check)\n   186→          clearTimeout(timeout)\n   187→          resolve()\n   188→        }\n   189→      }, 200)\n   190→    })\n   191→    log('Functions server ready')\n   192→\n   193→    // Step 5b: Start vite dev server (proxies /api to functions server on 9999)\n   194→    log('Starting vite dev server...')\n   195→    const serverProc = spawn('npx', ['vite', '--host', '127.0.0.1', '--port', '8888', '--strictPort'], {\n   196→      cwd: appDir,\n   197→      env: { ...process.env, DATABASE_URL: testDbUrl },\n   198→      stdio: ['ignore', 'pipe', 'pipe'],\n   199→    })\n   200→\n   201→    let serverOutput = ''\n   202→    serverProc.stdout.on('data', (d: Buffer) => { serverOutput += d.toString() })\n   203→    serverProc.stderr.on('data', (d: Buffer) => { serverOutput += d.toString() })\n   204→    serverProc.on('error', (e: Error) => { log('Server process error: ' + e.message) })\n   205→    serverProc.on('exit', (code: number | null) => { log('Server process exited with code: ' + code) })\n   206→\n   207→    // Wait for vite to be ready\n   208→    await new Promise<void>((resolve, reject) => {\n   209→      const timeout = setTimeout(() => {\n   210→        log('Server output at timeout:\\n' + serverOutput)\n   211→        reject(new Error('Server start timeout'))\n   212→      }, 30000)\n   213→      const check = setInterval(async () => {\n   214→        try {\n   215→          const res = await fetch('http://localhost:8888', { signal: AbortSignal.timeout(2000) })\n   216→          if (res.ok || res.status === 200 || res.status === 304) {\n   217→            clearInterval(check)\n   218→            clearTimeout(timeout)\n   219→            resolve()\n   220→          }\n   221→        } catch { /* not ready yet */ }\n   222→      }, 500)\n   223→    })\n   224→\n   225→    log('Server ready')\n   226→\n   227→    // Step 6: Remove stale recordings\n   228→    try { execSync('npx replayio remove --all 2>/dev/null || true', { cwd: appDir, stdio: 'ignore' }) } catch { /* ignore */ }\n   229→\n   230→    // Step 7: Run Playwright\n   231→    log(`Running: npx playwright test ${testFile} --retries 0 --workers 1`)\n   232→\n   233→    // Create a reset script for between tests\n   234→    const resetEnv = { ...process.env, DATABASE_URL: testDbUrl }\n   235→\n   236→    try {\n   237→      const pwOutput = execSync(\n   238→        `npx playwright test ${testFile} --retries 0 --workers 1`,\n   239→        {\n   240→          cwd: appDir,\n   241→          env: { ...resetEnv, RECORD_REPLAY_API_KEY, PW_TEST_REUSE_CONTEXT: '0' },\n   242→          stdio: ['ignore', 'pipe', 'pipe'],\n   243→          timeout: 300000,\n   244→        }\n   245→      )\n   246→      log('=== Playwright Output ===')\n   247→      log(pwOutput.toString())\n   248→      playwrightExit = 0\n   249→    } catch (e: unknown) {\n   250→      const err = e as { stdout?: Buffer; stderr?: Buffer; status?: number }\n   251→      log('=== Playwright Output ===')\n   252→      log((err.stdout?.toString() || '') + '\\n' + (err.stderr?.toString() || ''))\n   253→      playwrightExit = err.status || 1\n   254→    }\n   255→\n   256→    log('=== Server Output ===')\n   257→    log(serverOutput)\n   258→\n   259→    // Step 8: Parse results\n   260→    const resultsPath = join(appDir, 'test-results', 'results.json')\n   261→    let passed = 0, failed = 0, _skipped = 0\n   262→    if (existsSync(resultsPath)) {\n   263→      try {\n   264→        const results = JSON.parse(readFileSync(resultsPath, 'utf-8'))\n   265→        for (const suite of (results.suites || [])) {\n   266→          for (const spec of (suite.specs || [])) {\n   267→            for (const test of (spec.tests || [])) {\n   268→              if (test.status === 'expected') passed++\n   269→              else if (test.status === 'unexpected') failed++\n   270→              else if (test.status === 'skipped') _skipped++\n   271→            }\n   272→          }\n   273→        }\n   274→      } catch { /* ignore parse errors */ }\n   275→    }\n   276→\n   277→    // Step 9: On failure, handle recordings\n   278→    let uploadedId = ''\n   279→    if (playwrightExit !== 0) {\n   280→      const recordingsLogPath = join(process.env.HOME || '~', '.replay', 'recordings.log')\n   281→      if (existsSync(recordingsLogPath)) {\n   282→        const lines = readFileSync(recordingsLogPath, 'utf-8').split('\\n').filter(Boolean)\n   283→        const recordings: Record<string, { id: string; duration?: number; result?: string; finished?: boolean }> = {}\n   284→\n   285→        for (const line of lines) {\n   286→          try {\n   287→            const entry = JSON.parse(line)\n   288→            if (entry.kind === 'createRecording') {\n   289→              recordings[entry.id] = { id: entry.id, duration: 0, finished: false }\n   290→            } else if (entry.kind === 'writeFinished' && recordings[entry.id]) {\n   291→              recordings[entry.id]!.finished = true\n   292→            } else if (entry.kind === 'addMetadata' && recordings[entry.id]) {\n   293→              const testResult = entry.metadata?.test?.result\n   294→              if (testResult) recordings[entry.id]!.result = testResult\n   295→              if (entry.metadata?.test?.duration) recordings[entry.id]!.duration = entry.metadata.test.duration\n   296→            }\n   297→          } catch { /* skip bad lines */ }\n   298→        }\n   299→\n   300→        // Find failed recordings\n   301→        const failedRecs = Object.values(recordings).filter(\n   302→          r => r.finished && (r.result === 'failed' || r.result === 'timedOut')\n   303→        )\n   304→\n   305→        log('\\n=== REPLAY RECORDINGS METADATA ===')\n   306→        for (const r of Object.values(recordings)) {\n   307→          log(JSON.stringify(r))\n   308→        }\n   309→        log('=== END REPLAY RECORDINGS METADATA ===')\n   310→\n   311→        if (failedRecs.length > 0) {\n   312→          // Pick the longest duration one\n   313→          failedRecs.sort((a, b) => (b.duration || 0) - (a.duration || 0))\n   314→          const toUpload = failedRecs[0]!\n   315→          log(`\\nUploading recording: ${toUpload.id}`)\n   316→          try {\n   317→            execSync(`npx replayio upload ${toUpload.id}`, {\n   318→              cwd: appDir,\n   319→              env: { ...process.env, RECORD_REPLAY_API_KEY },\n   320→              stdio: ['ignore', 'pipe', 'pipe'],\n   321→              timeout: 60000,\n   322→            })\n   323→            uploadedId = toUpload.id\n   324→            log(`REPLAY UPLOADED: ${uploadedId}`)\n   325→          } catch (ue: unknown) {\n   326→            const uploadErr = ue as { status?: number }\n   327→            log(`Upload failed with exit code: ${uploadErr.status}`)\n   328→          }\n   329→        }\n   330→      }\n   331→    }\n   332→\n   333→    // Clean up server\n   334→    serverProc.kill('SIGTERM')\n   335→    functionsProc.kill('SIGTERM')\n   336→\n   337→    // Step 10: Print summary\n   338→    writeFileSync(logPath, logContent)\n   339→\n   340→    let summary = ''\n   341→    if (failed > 0) {\n   342→      summary = `${passed} passed, ${failed} failed`\n   343→      if (uploadedId) summary += ` (recording: ${uploadedId})`\n   344→    } else if (passed > 0) {\n   345→      summary = `${passed} passed`\n   346→    } else {\n   347→      summary = playwrightExit === 0 ? 'Tests completed' : 'Tests failed'\n   348→    }\n   349→    summary += ` — see logs/test-run-${logNum}.log`\n   350→    console.log(summary)\n   351→  } finally {\n   352→    // Step 10: Clean up Neon branch\n   353→    try {\n   354→      await neonApi('DELETE', `/projects/${NEON_PROJECT_ID}/branches/${branchId}`)\n   355→      log('Cleaned up test branch')\n   356→    } catch { /* ignore */ }\n   357→\n   358→    // Remove local recordings\n   359→    try { execSync('npx replayio remove --all 2>/dev/null || true', { cwd: appDir, stdio: 'ignore' }) } catch { /* ignore */ }\n   360→\n   361→    writeFileSync(logPath, logContent)\n   362→  }\n   363→\n   364→  process.exit(playwrightExit)\n   365→}\n   366→\n   367→main().catch(e => {\n   368→  console.error(e)\n   369→  process.exit(1)\n   370→})\n   371→"}]},"parent_tool_use_id":null,"session_id":"eb525227-e996-4510-92e8-ef0d46b50769","uuid":"22c2bbe4-9b9d-4dc7-8ca6-abde896e0995","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/GoogleFlights/scripts/test.ts","content":"import { execSync, spawn } from 'child_process'\nimport { readFileSync, writeFileSync, mkdirSync, readdirSync, existsSync } from 'fs'\nimport { join } from 'path'\nimport { initSchema } from './schema.ts'\nimport { truncateAndSeed } from './seed-db.ts'\n\nconst appDir = join(import.meta.dirname, '..')\nconst logDir = join(appDir, 'logs')\nmkdirSync(logDir, { recursive: true })\n\n// Determine log file number\nconst existingLogs = readdirSync(logDir).filter(f => f.match(/^test-run-\\d+\\.log$/))\nconst maxNum = existingLogs.reduce((max, f) => {\n  const m = f.match(/test-run-(\\d+)\\.log/)\n  return m ? Math.max(max, parseInt(m[1]!)) : max\n}, 0)\nconst logNum = maxNum + 1\nconst logPath = join(logDir, `test-run-${logNum}.log`)\nlet logContent = ''\nfunction log(msg: string) { logContent += msg + '\\n' }\n\n// Read .env\nfunction readEnv(): Record<string, string> {\n  const envPath = join(appDir, '.env')\n  if (!existsSync(envPath)) return {}\n  const lines = readFileSync(envPath, 'utf-8').split('\\n')\n  const env: Record<string, string> = {}\n  for (const line of lines) {\n    const idx = line.indexOf('=')\n    if (idx > 0 && !line.startsWith('#')) {\n      env[line.slice(0, idx).trim()] = line.slice(idx + 1).trim()\n    }\n  }\n  return env\n}\n\nconst testFile = process.argv[2]\nif (!testFile) {\n  console.error('Usage: npm run test <test-file>')\n  process.exit(1)\n}\n\nconst NEON_API_KEY = (process.env.NEON_API_KEY || '').trim()\nconst RECORD_REPLAY_API_KEY = process.env.RECORD_REPLAY_API_KEY || ''\nconst envVars = readEnv()\nconst NEON_PROJECT_ID = envVars.NEON_PROJECT_ID || ''\nconst DATABASE_URL = envVars.DATABASE_URL || ''\n\nif (!NEON_API_KEY || !NEON_PROJECT_ID || !DATABASE_URL) {\n  console.error('Missing required env vars (NEON_API_KEY, NEON_PROJECT_ID, DATABASE_URL)')\n  process.exit(1)\n}\n\nasync function neonApi(method: string, path: string, body?: unknown) {\n  const opts: RequestInit = {\n    method,\n    headers: {\n      'Authorization': `Bearer ${NEON_API_KEY}`,\n      'Content-Type': 'application/json',\n    },\n  }\n  if (body) opts.body = JSON.stringify(body)\n  const res = await fetch(`https://console.neon.tech/api/v2${path}`, opts)\n  return res.json()\n}\n\nasync function main() {\n  // Step 1: Kill stale processes\n  try { execSync('pkill -f \"netlify dev\" 2>/dev/null || true', { stdio: 'ignore' }) } catch { /* ignore */ }\n  try { execSync('pkill -f \"functions-server\" 2>/dev/null || true', { stdio: 'ignore' }) } catch { /* ignore */ }\n  try { execSync('pkill -f \"node.*vite\" 2>/dev/null || true', { stdio: 'ignore' }) } catch { /* ignore */ }\n  // Wait for ports to be released\n  await new Promise(r => setTimeout(r, 1000))\n\n  // Step 2: Clean up stale Neon test branches\n  const branchesRes = await neonApi('GET', `/projects/${NEON_PROJECT_ID}/branches`) as { branches?: { id: string; name: string }[] }\n  const branches = branchesRes.branches || []\n  for (const b of branches) {\n    if (b.name.startsWith('test-run-')) {\n      log(`Deleting stale branch: ${b.name}`)\n      await neonApi('DELETE', `/projects/${NEON_PROJECT_ID}/branches/${b.id}`)\n    }\n  }\n\n  // Step 3: Create ephemeral Neon branch\n  const branchName = `test-run-${Date.now()}`\n  log(`Creating branch: ${branchName}`)\n  const branchRes = await neonApi('POST', `/projects/${NEON_PROJECT_ID}/branches`, {\n    branch: { name: branchName },\n    endpoints: [{ type: 'read_write' }],\n  }) as {\n    branch?: { id: string };\n    endpoints?: { host: string }[];\n    roles?: { name: string; password?: string }[];\n    connection_uris?: { connection_uri: string }[];\n  }\n\n  const branchId = branchRes.branch?.id\n  if (!branchId) {\n    log('Failed to create branch: ' + JSON.stringify(branchRes))\n    writeFileSync(logPath, logContent)\n    console.log(`0 passed, 0 failed — see logs/test-run-${logNum}.log`)\n    process.exit(1)\n  }\n\n  let testDbUrl = ''\n  if (branchRes.connection_uris?.[0]?.connection_uri) {\n    testDbUrl = branchRes.connection_uris[0].connection_uri\n  } else {\n    const host = branchRes.endpoints?.[0]?.host || ''\n    const roleName = branchRes.roles?.[0]?.name || 'neondb_owner'\n    let password = branchRes.roles?.[0]?.password || ''\n    if (!password) {\n      const pwRes = await neonApi('GET', `/projects/${NEON_PROJECT_ID}/branches/${branchId}/roles/${roleName}/reveal_password`) as { password?: string }\n      password = pwRes.password || ''\n    }\n    testDbUrl = `postgresql://${roleName}:${password}@${host}/neondb?sslmode=require`\n  }\n\n  log(`Branch DB URL: ${testDbUrl.replace(/:[^:@]+@/, ':***@')}`)\n\n  let playwrightExit = 1\n\n  try {\n    // Step 4: Initialize and seed (with retry for endpoint readiness)\n    log('Initializing schema...')\n    for (let attempt = 1; attempt <= 5; attempt++) {\n      try {\n        await initSchema(testDbUrl)\n        break\n      } catch (e: unknown) {\n        const msg = e instanceof Error ? e.message : String(e)\n        if (attempt < 5 && msg.includes('endpoint could not be found')) {\n          log(`Schema init attempt ${attempt} failed (endpoint not ready), retrying in 3s...`)\n          await new Promise(r => setTimeout(r, 3000))\n        } else {\n          throw e\n        }\n      }\n    }\n    log('Schema initialized')\n\n    log('Seeding database...')\n    for (let attempt = 1; attempt <= 5; attempt++) {\n      try {\n        await truncateAndSeed(testDbUrl)\n        break\n      } catch (e: unknown) {\n        const msg = e instanceof Error ? e.message : String(e)\n        if (attempt < 5 && msg.includes('endpoint could not be found')) {\n          log(`Seed attempt ${attempt} failed (endpoint not ready), retrying in 3s...`)\n          await new Promise(r => setTimeout(r, 3000))\n        } else {\n          throw e\n        }\n      }\n    }\n    log('Database seeded')\n\n    // Step 5a: Start custom functions server\n    log('Starting functions server...')\n    const functionsProc = spawn('npx', ['tsx', 'scripts/functions-server.ts', '9999'], {\n      cwd: appDir,\n      env: { ...process.env, DATABASE_URL: testDbUrl },\n      stdio: ['ignore', 'pipe', 'pipe'],\n    })\n\n    let functionsOutput = ''\n    functionsProc.stdout.on('data', (d: Buffer) => {\n      functionsOutput += d.toString()\n      log('[functions] ' + d.toString().trim())\n    })\n    functionsProc.stderr.on('data', (d: Buffer) => { functionsOutput += d.toString() })\n    functionsProc.on('error', (e: Error) => { log('Functions process error: ' + e.message) })\n    functionsProc.on('exit', (code: number | null) => { log('Functions process exited with code: ' + code) })\n\n    // Wait for functions server\n    await new Promise<void>((resolve, reject) => {\n      const timeout = setTimeout(() => {\n        log('Functions output at timeout:\\n' + functionsOutput)\n        reject(new Error('Functions server start timeout'))\n      }, 30000)\n      const check = setInterval(async () => {\n        if (functionsOutput.includes('Functions server ready')) {\n          clearInterval(check)\n          clearTimeout(timeout)\n          resolve()\n        }\n      }, 200)\n    })\n    log('Functions server ready')\n\n    // Step 5b: Start vite dev server (proxies /api to functions server on 9999)\n    log('Starting vite dev server...')\n    const serverProc = spawn('npx', ['vite', '--host', '127.0.0.1', '--port', '8888', '--strictPort'], {\n      cwd: appDir,\n      env: { ...process.env, DATABASE_URL: testDbUrl },\n      stdio: ['ignore', 'pipe', 'pipe'],\n    })\n\n    let serverOutput = ''\n    serverProc.stdout.on('data', (d: Buffer) => { serverOutput += d.toString() })\n    serverProc.stderr.on('data', (d: Buffer) => { serverOutput += d.toString() })\n    serverProc.on('error', (e: Error) => { log('Server process error: ' + e.message) })\n    serverProc.on('exit', (code: number | null) => { log('Server process exited with code: ' + code) })\n\n    // Wait for vite to be ready\n    await new Promise<void>((resolve, reject) => {\n      const timeout = setTimeout(() => {\n        log('Server output at timeout:\\n' + serverOutput)\n        reject(new Error('Server start timeout'))\n      }, 30000)\n      const check = setInterval(async () => {\n        try {\n          const res = await fetch('http://localhost:8888', { signal: AbortSignal.timeout(2000) })\n          if (res.ok || res.status === 200 || res.status === 304) {\n            clearInterval(check)\n            clearTimeout(timeout)\n            resolve()\n          }\n        } catch { /* not ready yet */ }\n      }, 500)\n    })\n\n    log('Server ready')\n\n    // Step 6: Remove stale recordings\n    try { execSync('npx replayio remove --all 2>/dev/null || true', { cwd: appDir, stdio: 'ignore' }) } catch { /* ignore */ }\n\n    // Step 7: Run Playwright\n    log(`Running: npx playwright test ${testFile} --retries 0 --workers 1`)\n\n    // Create a reset script for between tests\n    const resetEnv = { ...process.env, DATABASE_URL: testDbUrl }\n\n    try {\n      const pwOutput = execSync(\n        `npx playwright test ${testFile} --retries 0 --workers 1`,\n        {\n          cwd: appDir,\n          env: { ...resetEnv, RECORD_REPLAY_API_KEY, PW_TEST_REUSE_CONTEXT: '0' },\n          stdio: ['ignore', 'pipe', 'pipe'],\n          timeout: 300000,\n        }\n      )\n      log('=== Playwright Output ===')\n      log(pwOutput.toString())\n      playwrightExit = 0\n    } catch (e: unknown) {\n      const err = e as { stdout?: Buffer; stderr?: Buffer; status?: number }\n      log('=== Playwright Output ===')\n      log((err.stdout?.toString() || '') + '\\n' + (err.stderr?.toString() || ''))\n      playwrightExit = err.status || 1\n    }\n\n    log('=== Server Output ===')\n    log(serverOutput)\n\n    // Step 8: Parse results\n    const resultsPath = join(appDir, 'test-results', 'results.json')\n    let passed = 0, failed = 0, _skipped = 0\n    if (existsSync(resultsPath)) {\n      try {\n        const results = JSON.parse(readFileSync(resultsPath, 'utf-8'))\n        for (const suite of (results.suites || [])) {\n          for (const spec of (suite.specs || [])) {\n            for (const test of (spec.tests || [])) {\n              if (test.status === 'expected') passed++\n              else if (test.status === 'unexpected') failed++\n              else if (test.status === 'skipped') _skipped++\n            }\n          }\n        }\n      } catch { /* ignore parse errors */ }\n    }\n\n    // Step 9: On failure, handle recordings\n    let uploadedId = ''\n    if (playwrightExit !== 0) {\n      const recordingsLogPath = join(process.env.HOME || '~', '.replay', 'recordings.log')\n      if (existsSync(recordingsLogPath)) {\n        const lines = readFileSync(recordingsLogPath, 'utf-8').split('\\n').filter(Boolean)\n        const recordings: Record<string, { id: string; duration?: number; result?: string; finished?: boolean }> = {}\n\n        for (const line of lines) {\n          try {\n            const entry = JSON.parse(line)\n            if (entry.kind === 'createRecording') {\n              recordings[entry.id] = { id: entry.id, duration: 0, finished: false }\n            } else if (entry.kind === 'writeFinished' && recordings[entry.id]) {\n              recordings[entry.id]!.finished = true\n            } else if (entry.kind === 'addMetadata' && recordings[entry.id]) {\n              const testResult = entry.metadata?.test?.result\n              if (testResult) recordings[entry.id]!.result = testResult\n              if (entry.metadata?.test?.duration) recordings[entry.id]!.duration = entry.metadata.test.duration\n            }\n          } catch { /* skip bad lines */ }\n        }\n\n        // Find failed recordings\n        const failedRecs = Object.values(recordings).filter(\n          r => r.finished && (r.result === 'failed' || r.result === 'timedOut')\n        )\n\n        log('\\n=== REPLAY RECORDINGS METADATA ===')\n        for (const r of Object.values(recordings)) {\n          log(JSON.stringify(r))\n        }\n        log('=== END REPLAY RECORDINGS METADATA ===')\n\n        if (failedRecs.length > 0) {\n          // Pick the longest duration one\n          failedRecs.sort((a, b) => (b.duration || 0) - (a.duration || 0))\n          const toUpload = failedRecs[0]!\n          log(`\\nUploading recording: ${toUpload.id}`)\n          try {\n            execSync(`npx replayio upload ${toUpload.id}`, {\n              cwd: appDir,\n              env: { ...process.env, RECORD_REPLAY_API_KEY },\n              stdio: ['ignore', 'pipe', 'pipe'],\n              timeout: 60000,\n            })\n            uploadedId = toUpload.id\n            log(`REPLAY UPLOADED: ${uploadedId}`)\n          } catch (ue: unknown) {\n            const uploadErr = ue as { status?: number }\n            log(`Upload failed with exit code: ${uploadErr.status}`)\n          }\n        }\n      }\n    }\n\n    // Clean up server\n    serverProc.kill('SIGTERM')\n    functionsProc.kill('SIGTERM')\n\n    // Step 10: Print summary\n    writeFileSync(logPath, logContent)\n\n    let summary = ''\n    if (failed > 0) {\n      summary = `${passed} passed, ${failed} failed`\n      if (uploadedId) summary += ` (recording: ${uploadedId})`\n    } else if (passed > 0) {\n      summary = `${passed} passed`\n    } else {\n      summary = playwrightExit === 0 ? 'Tests completed' : 'Tests failed'\n    }\n    summary += ` — see logs/test-run-${logNum}.log`\n    console.log(summary)\n  } finally {\n    // Step 10: Clean up Neon branch\n    try {\n      await neonApi('DELETE', `/projects/${NEON_PROJECT_ID}/branches/${branchId}`)\n      log('Cleaned up test branch')\n    } catch { /* ignore */ }\n\n    // Remove local recordings\n    try { execSync('npx replayio remove --all 2>/dev/null || true', { cwd: appDir, stdio: 'ignore' }) } catch { /* ignore */ }\n\n    writeFileSync(logPath, logContent)\n  }\n\n  process.exit(playwrightExit)\n}\n\nmain().catch(e => {\n  console.error(e)\n  process.exit(1)\n})\n","numLines":371,"startLine":1,"totalLines":371}}}
