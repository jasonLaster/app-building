ectedDisplay)\n   219→\n   220→    // Switch back to Round trip\n   221→    await page.getByTestId('trip-type-selector-trigger').click()\n   222→    await page.getByTestId('trip-type-option-round_trip').click()\n   223→\n   224→    // Departure date should still be retained\n   225→    await expect(page.getByTestId('departure-date-trigger')).toContainText(expectedDisplay)\n   226→  })\n   227→\n   228→  test('DatePicker can be used repeatedly', async ({ page }) => {\n   229→    // Set departure date to 25th of next month\n   230→    await page.getByTestId('departure-date-trigger').click()\n   231→    await expect(page.getByTestId('departure-date-calendar')).toBeVisible()\n   232→    await page.getByTestId('departure-date-next-month').click()\n   233→\n   234→    const nextMonth = new Date()\n   235→    nextMonth.setMonth(nextMonth.getMonth() + 1)\n   236→    const year = nextMonth.getFullYear()\n   237→    const month = String(nextMonth.getMonth() + 1).padStart(2, '0')\n   238→    const firstDateStr = `${year}-${month}-25`\n   239→    await page.getByTestId(`departure-date-day-${firstDateStr}`).click()\n   240→    await expect(page.getByTestId('departure-date-calendar')).not.toBeVisible()\n   241→\n   242→    const firstDisplay = new Date(firstDateStr + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })\n   243→    await expect(page.getByTestId('departure-date-trigger')).toContainText(firstDisplay)\n   244→\n   245→    // Now click again and select a different date (28th)\n   246→    await page.getByTestId('departure-date-trigger').click()\n   247→    await expect(page.getByTestId('departure-date-calendar')).toBeVisible()\n   248→\n   249→    const secondDateStr = `${year}-${month}-28`\n   250→    await page.getByTestId(`departure-date-day-${secondDateStr}`).click()\n   251→    await expect(page.getByTestId('departure-date-calendar')).not.toBeVisible()\n   252→\n   253→    const secondDisplay = new Date(secondDateStr + 'T00