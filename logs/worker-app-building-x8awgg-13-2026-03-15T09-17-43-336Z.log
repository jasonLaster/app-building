[2026-03-15T09:01:09.784Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ru8mCShobmyx6RbHs6V141","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test'\n     2→\n     3→test.describe('DatePicker', () => {\n     4→  test.beforeEach(async ({ page }) => {\n     5→    await page.goto('/')\n     6→    await expect(page.getByTestId('search-page')).toBeVisible({ timeout: 10000 })\n     7→  })\n     8→\n     9→  test('DatePicker departure field shows placeholder', async ({ page }) => {\n    10→    const departureTrigger = page.getByTestId('departure-date-trigger')\n    11→    await expect(departureTrigger).toBeVisible()\n    12→    await expect(departureTrigger).toContainText('Departure')\n    13→  })\n    14→\n    15→  test('DatePicker return field shows placeholder when Round trip', async ({ page }) => {\n    16→    // Default trip type is Round trip\n    17→    await expect(page.getByTestId('trip-type-selector-trigger')).toContainText('Round trip')\n    18→\n    19→    const returnTrigger = page.getByTestId('return-date-trigger')\n    20→    await expect(returnTrigger).toBeVisible()\n    21→    await expect(returnTrigger).toContainText('Return')\n    22→  })\n    23→\n    24→  test('DatePicker opens calendar on departure field click', async ({ page }) => {\n    25→    // Calendar should not be visible initially\n    26→    await expect(page.getByTestId('departure-date-calendar')).not.toBeVisible()\n    27→\n    28→    // Click the departure date trigger\n    29→    await page.getByTestId('departure-date-trigger').click()\n    30→\n    31→    // Calendar should now be visible\n    32→    await expect(page.getByTestId('departure-date-calendar')).toBeVisible()\n    33→\n    34→    // Should show the current month label\n    35→    const now = new Date()\n    36→    const expectedMonth = now.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })\n    37→    await expect(page.getByTestId('departure-date-month-label')).toHaveText(expectedMonth)\n    38→\n    39→    // Navigation buttons should be present\n    40→    await expect(page.getByTestId('departure-date-prev-month')).toBeVisible()\n    41→    await expect(page.getByTestId('departure-date-next-month')).toBeVisible()\n    42→\n    43→    // Previous month button should be disabled for current month\n    44→    await expect(page.getByTestId('departure-date-prev-month')).toBeDisabled()\n    45→  })\n    46→\n    47→  test('DatePicker selects a departure date', async ({ page }) => {\n    48→    // Open departure calendar\n    49→    await page.getByTestId('departure-date-trigger').click()\n    50→    await expect(page.getByTestId('departure-date-calendar')).toBeVisible()\n    51→\n    52→    // Navigate to next month to pick a future date\n    53→    await page.getByTestId('departure-date-next-month').click()\n    54→\n    55→    const nextMonth = new Date()\n    56→    nextMonth.setMonth(nextMonth.getMonth() + 1)\n    57→    const year = nextMonth.getFullYear()\n    58→    const month = String(nextMonth.getMonth() + 1).padStart(2, '0')\n    59→    const dateStr = `${year}-${month}-25`\n    60→\n    61→    // Click the 25th\n    62→    await page.getByTestId(`departure-date-day-${dateStr}`).click()\n    63→\n    64→    // Calendar should close\n    65→    await expect(page.getByTestId('departure-date-calendar')).not.toBeVisible()\n    66→\n    67→    // Departure trigger should show the selected date\n    68→    const expectedDisplay = new Date(dateStr + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })\n    69→    await expect(page.getByTestId('departure-date-trigger')).toContainText(expectedDisplay)\n    70→  })\n    71→\n    72→  test('DatePicker selects a return date after departure', async ({ page }) => {\n    73→    // First set departure date to next month 25th\n    74→    await page.getByTestId('departure-date-trigger').click()\n    75→    await expect(page.getByTestId('departure-date-calendar')).toBeVisible()\n    76→    await page.getByTestId('departure-date-next-month').click()\n    77→\n    78→    const nextMonth = new Date()\n    79→    nextMonth.setMonth(nextMonth.getMonth() + 1)\n    80→    const year = nextMonth.getFullYear()\n    81→    const month = String(nextMonth.getMonth() + 1).padStart(2, '0')\n    82→    const depDateStr = `${year}-${month}-25`\n    83→    await page.getByTestId(`departure-date-day-${depDateStr}`).click()\n    84→    await expect(page.getByTestId('departure-date-calendar')).not.toBeVisible()\n    85→\n    86→    // Now open return calendar\n    87→    await page.getByTestId('return-date-trigger').click()\n    88→    await expect(page.getByTestId('return-date-calendar')).toBeVisible()\n    89→\n    90→    // Navigate to the month after next to pick April 1\n    91→    const returnMonth = new Date()\n    92→    returnMonth.setMonth(returnMonth.getMonth() + 2)\n    93→    const retYear = returnMonth.getFullYear()\n    94→    const retMonth = String(returnMonth.getMonth() + 1).padStart(2, '0')\n    95→\n    96→    // The return calendar opens at current month, navigate to the right month\n    97→    // We need to navigate forward twice (once past current, once past next)\n    98→    await page.getByTestId('return-date-next-month').click()\n    99→    await page.getByTestId('return-date-next-month').click()\n   100→\n   101→    const retDateStr = `${retYear}-${retMonth}-01`\n   102→    await page.getByTestId(`return-date-day-${retDateStr}`).click()\n   103→    await expect(page.getByTestId('return-date-calendar')).not.toBeVisible()\n   104→\n   105→    // Return trigger should show the selected date\n   106→    const expectedDisplay = new Date(retDateStr + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })\n   107→    await expect(page.getByTestId('return-date-trigger')).toContainText(expectedDisplay)\n   108→  })\n   109→\n   110→  test('DatePicker preven