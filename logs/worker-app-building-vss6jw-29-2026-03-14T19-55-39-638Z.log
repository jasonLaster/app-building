[2]\n    49→if (!testFile) {\n    50→  console.error('Usage: npm run test <test-file>')\n    51→  process.exit(1)\n    52→}\n    53→\n    54→async function run() {\n    55→  const env = readEnv()\n    56→  const neonProjectId = env['NEON_PROJECT_ID'] || process.env['NEON_PROJECT_ID'] || ''\n    57→  const neonApiKey = process.env['NEON_API_KEY'] || ''\n    58→  const replayApiKey = process.env['RECORD_REPLAY_API_KEY'] || ''\n    59→\n    60→  if (!neonProjectId || !neonApiKey) {\n    61→    console.error('Missing NEON_PROJECT_ID or NEON_API_KEY')\n    62→    process.exit(1)\n    63→  }\n    64→\n    65→  // Step 1: Kill stale processes\n    66→  tryExec('pkill -f \"netlify dev\" 2>/dev/null || true', { stdio: 'ignore' })\n    67→  tryExec('pkill -f \"vite\" 2>/dev/null || true', { stdio: 'ignore' })\n    68→\n    69→  // Step 2: Clean up stale test branches\n    70→  try {\n    71→    const branchesResp = execSync(\n    72→      `curl -s \"https://console.neon.tech/api/v2/projects/${neonProjectId}/branches\" -H \"Authorization: Bearer ${neonApiKey}\"`,\n    73→      { encoding: 'utf-8', timeout: 15000 }\n    74→    )\n    75→    const branches = JSON.parse(branchesResp).branches || []\n    76→    for (const b of branches) {\n    77→      if (typeof b.name === 'string' && b.name.startsWith('test-run-')) {\n    78→        tryExec(\n    79→          `curl -s -X DELETE \"https://console.neon.tech/api/v2/projects/${neonProjectId}/branches/${b.id}\" -H \"Authorization: Bearer ${neonApiKey}\"`,\n    80→          { stdio: 'ignore', timeout: 10000 }\n    81→        )\n    82→        log(`Cleaned up stale branch: ${b.name}`)\n    83→      }\n    84→    }\n    85→  } catch { log('Warning: could not clean stale branches') }\n    86→\n    87→  // Step 3: Create ephemeral branch\n    88→  const branchName = `test-run-${Date.now()}`\n    89→  let branchId = ''\n    90→  let testDbUrl = ''\n    91→\n    92→  try {\n    93→    const resp = execSync(\n    94→      `curl -s -X POST \"https://console.neon.tech/api/v2/projects/${neonProjectId}/branches\" -H \"Authorization: Bearer ${neonApiKey}\" -H \"Content-Type: application/json\" -d '{\"branch\": {\"name\": \"${branchName}\"}, \"endpoints\": [{\"type\": \"read_write\"}]}'`,\n    95→      { encoding: 'utf-8', timeout: 30000 }\n    96→    )\n    97→    const data = JSON.parse(resp)\n    98→    branchId = data.branch?.id || ''\n    99→    const connUri = data.connection_uris?.[0]?.connection_uri\n   100→    if (connUri) {\n   101→      testDbUrl = connUri\n   102→    } else {\n   103→      const ep = data.endpoints?.[0]\n   104→      const host = ep?.host || ''\n   105→      const role = data.roles?.[0]?.name || 'neondb_owner'\n   106→      const pwResp = execSync(\n   107→        `curl -s \"https://console.neon.tech/api/v2/projects/${neonProjectId}/branches/${branchId}/roles/${role}/reveal_password\" -H \"Authorization: Bearer ${neonApiKey}\"`,\n   108→        { encoding: 'utf-8', timeout: 10000 }\n   109→      )\n   110→      const password = JSON.parse(pwResp).password || ''\n   111→      testDbUrl = `postgresql://${role}:${password}@${host}/neondb?sslmode=require`\n   112→    }\n   113→    log(`Created branch: ${branchName} (${branchId})`)\n   114→    log(`Test DB URL: ${testDbUrl.replace(/:[^:@]+@/, ':***@')}`)\n   115→  } catch (e) {\n   116→    log(`Failed to create branch: ${e}`)\n   117→    writeLog()\n   118→    console.error('Failed to create Neon test branch')\n   119→    process.exit(1)\n   120→  }\n   121→\n   122→  // Wait for branch to be ready\n   123→  await new Promise(resolve => setTimeout(resolve, 3000))\n   124→\n   125→  // Step 4: Initialize schema and seed\n   126→  try {\n   127→    await initSchema(testDbUrl)\n   128→    log('Schema initialized')\n   129→    await truncateAndSeed(testDbUrl)\n   130→    log('Database seeded')\n   131→  } catch (e) {\n   132→    log(`Schema/seed failed: ${e}`)\n   133→    writeLog()\n   134→    console.error('Schema/seed failed — see ' + logFile)\n   135→    cleanup(branchId, neonProjectId, neonApiKey)\n   136→    process.exit(1)\n   137→  }\n   138→\n   139→  // Step 5 & 6: Remove stale recordings\n   140→  tryExec('npx replayio remove --all 2>/dev/null || true', { stdio: 'ignore', cwd: appDir })\n   141→\n   142→  // Step 7: Run Playwright\n   143→  let playwrightExitCode = 0\n   144→  try {\n   145→    const pwOutput = execSync(\n   146→      `npx playwright test ${testFile} --retries 0 --workers 1`,\n   147→      {\n   148→        cwd: appDir,\n   149→        encoding: 'utf-8',\n   150→        stdio: ['ignore', 'pipe', 'pipe'],\n   151→        timeout: 300000,\n   152→        env: {\n   153→          ...process.env,\n   154→          DATABASE_URL: testDbUrl,\n   155→          RECORD_REPLAY_API_KEY: replayApiKey,\n   156→        },\n   157→      }\n   158→    )\n   159→    log('=== Playwright Output ===\\n' + pwOutput)\n   160→  } catch (e: unknown) {\n   161→    const err = e as { status?: number; stdout?: string; stderr?: string }\n   162→    playwrightExitCode = err.status || 1\n   163→    log('=== Playwright Output ===\\n' + (err.stdout || '') + '\\n' + (err.stderr || ''))\n   164→  }\n   165→\n   166→  // Step 8: Parse results\n   167→  let passed = 0\n   168→  let failed = 0\n   169→  try {\n   170→    const resultsPath = join(appDir, 'test-results', 'results.json')\n   171→    if (existsSync(resultsPath)) {\n   172→      const results = JSON.parse(readFileSync(resultsPath, 'utf-8'))\n   173→      for (const suite of results.suites || []) {\n   174→        for (const spec of suite.specs || []) {\n   175→          for (const test of spec.tests || []) {\n   176→            if (test.status === 'expected') passed++\n   177→            else if (test.status === 'unexpected') failed++\n   178→          }\n   179→        }\n   180→      }\n   181→    }\n   182→  } catch { /* ok */ }\n   183→\n   184→  // Step 9: Handle failure - upload recordings\n   185→  let uploadedId = ''\n   186→  if (playwrightExitCode !== 0) {\n   187→    try {\n   188→      const recLog = readFileSync(join(process.env['HOME'] || '~', '.replay', 'recordings.log'), 'utf-8')\n   189→      const lines = recLog.trim().split('\\n').filter(l => l.trim())\n   190→      const entries: Array<Record<string, unknown>> = []\n   191→      for (const l of lines) {\n   192→        try { entries.push(JSON.parse(l)) } catch { /* skip */ }\n   193→      }\n   194→\n   195→      const recordings: Record<string, { id: string; duration: number; result: string; title: string }> = {}\n   196→      for (const entry of entries) {\n   197→        if (entry.kind === 'createRecording') {\n   198→          recordings[entry.id as string] = { id: entry.id as string, duration: 0, result: '', title: '' }\n   199→        }\n   200→        if (entry.kind === 'addMetadata') {\n   201→          const meta = entry.metadata as Record<string, Record<string, string>> | undefined\n   202→          const rec = recordings[entry.id as string]\n   203→          if (rec && meta?.test) {\n   204→            rec.result = meta.test.result || ''\n   205→            rec.title = meta.test.title || ''\n   206→          }\n   207→        }\n   208→        if (entry.kind === 'writeFinished') {\n   209→          const rec = recordings[entry.id as string]\n   210→          if (rec) {\n   211→            rec.duration = (entry.duration as number) || 0\n   212→          }\n   213→        }\n   214→      }\n   215→\n   216→      const metadataBlock = Object.values(recordings)\n   217→        .filter(r => r.result)\n   218→        .map(r => JSON.stringify(r))\n   219→      if (metadataBlock.length) {\n   220→        log('\\n=== REPLAY RECORDINGS METADATA ===')\n   221→        for (const m of metadataBlock) log(m)\n   222→        log('=== END REPLAY RECORDINGS METADATA ===')\n   223→      }\n   224→\n   225→      const failedRecs = Object.values(recordings)\n   226→        .filter(r => r.result === 'failed' || r.result === 'timedOut')\n   227→        .sort((a, b) => b.duration - a.duration)\n   228→\n   229→      if (failedRecs[0]) {\n   230→        try {\n   231→          const uploadOut = execSync(`npx replayio upload ${failedRecs[0].id}`, {\n   232→            encoding: 'utf-8',\n   233→            cwd: appDir,\n   234→            timeout: 60000,\n   235→            env: { ...process.env, RECORD_REPLAY_API_KEY: replayApiKey },\n   236→          })\n   237→          uploadedId = failedRecs[0].id\n   238→          log(`REPLAY UPLOADED: ${uploadedId}`)\n   239→          log(uploadOut)\n   240→        } catch (ue) {\n   241→          log(`Replay upload failed: ${ue}`)\n   242→        }\n   243→      }\n   244→    } catch { log('Could not parse recordings') }\n   245→  }\n   246→\n   247→  // Step 10: Cleanup\n   248→  cleanup(branchId, neonProjectId, neonApiKey)\n   249→  tryExec('npx replayio remove --all 2>/dev/null || true', { stdio: 'ignore', cwd: appDir })\n   250→\n   251→  writeLog()\n   252→\n   253→  // Step 11: Summary\n   254→  const parts = []\n   255→  if (passed > 0) parts.push(`${passed} passed`)\n   256→  if (failed > 0) parts.push(`${failed} failed`)\n   257→  if (uploadedId) parts.push(`recording: ${uploadedId}`)\n   258→  const summary = parts.length > 0\n   259→    ? parts.join(', ') + ` — see ${logFile}`\n   260→    : `tests completed — see ${logFile}`\n   261→  console.log(summary)\n   262→\n   263→  process.exit(playwrightExitCode)\n   264→}\n   265→\n   266→function cleanup(branchId: string, projectId: string, apiKey: string) {\n   267→  tryExec('pkill -f \"netlify dev\" 2>/dev/null || true', { stdio: 'ignore' })\n   268→  if (branchId) {\n   269→    tryExec(\n   270→      `curl -s -X DELETE \"https://console.neon.tech/api/v2/projects/${projectId}/branches/${branchId}\" -H \"Authorization: Bearer ${apiKey}\"`,\n   271→      { stdio: 'ignore', timeout: 10000 }\n   272→    )\n   273→  }\n   274→}\n   275→\n   276→run()\n   277→"}]},"parent_tool_use_id":null,"session_id":"a786a10b-f37f-4561-9861-ba9a77a4272d","uuid":"5f4707ea-35c6-4e04-b6e6-ddc45340e614","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/scripts/test.ts","content":"import { execSync } from 'child_process'\nimport { readFileSync, writeFileSync, mkdirSync, existsSync, readdirSync } from 'fs'\nimport { join } from 'path'\nimport { initSchema } from './schema'\nimport { truncateAndSeed } from './seed-db'\n\nconst appDir = join(import.meta.dirname, '..')\nconst logDir = join(appDir, 'logs')\nmkdirSync(logDir, { recursive: true })\n\n// Find next log number\nconst existingLogs = readdirSync(logDir).filter(f => f.startsWith('test-run-'))\nconst maxNum = existingLogs.reduce((max, f) => {\n  const m = f.match(/test-run-(\\d+)\\.log/)\n  return m ? Math.max(max, parseInt(m[1]!)) : max\n}, 0)\nconst logFile = join(logDir, `test-run-${maxNum + 1}.log`)\nlet logContent = ''\n\nfunction log(msg: string) {\n  logContent += msg + '\\n'\n}\n\nfunction writeLog() {\n  writeFileSync(logFile, logContent)\n}\n\nfunction readEnv(): Record<string, string> {\n  const envPath = join(appDir, '.env')\n  if (!existsSync(envPath)) return {}\n  const lines = readFileSync(envPath, 'utf-8').split('\\n')\n  const env: Record<string, string> = {}\n  for (const line of lines) {\n    const trimmed = line.trim()\n    if (!trimmed || trimmed.startsWith('#')) continue\n    const eqIdx = trimmed.indexOf('=')\n    if (eqIdx > 0) {\n      env[trimmed.slice(0, eqIdx)] = trimmed.slice(eqIdx + 1)\n    }\n  }\n  return env\n}\n\nfunction tryExec(cmd: string, opts?: Parameters<typeof execSync>[1]) {\n  try { execSync(cmd, opts) } catch { /* ignored */ }\n}\n\nconst testFile = process.argv[2]\nif (!testFile) {\n  console.error('Usage: npm run test <test-file>')\n  process.exit(1)\n}\n\nasync function run() {\n  const env = readEnv()\n  const neonProjectId = env['NEON_PROJECT_ID'] || process.env['NEON_PROJECT_ID'] || ''\n  const neonApiKey = process.env['NEON_API_KEY'] || ''\n  const replayApiKey = process.env['RECORD_REPLAY_API_KEY'] || ''\n\n  if (!neonProjectId || !neonApiKey) {\n    console.error('Missing NEON_PROJECT_ID or NEON_API_KEY')\n    process.exit(1)\n  }\n\n  // Step 1: Kill stale processes\n  tryExec('pkill -f \"netlify dev\" 2>/dev/null || true', { stdio: 'ignore' })\n  tryExec('pkill -f \"vite\" 2>/dev/null || true', { stdio: 'ignore' })\n\n  // Step 2: Clean up stale test branches\n  try {\n    const branchesResp = execSync(\n      `curl -s \"https://console.neon.tech/api/v2/projects/${neonProjectId}/branches\" -H \"Authorization: Bearer ${neonApiKey}\"`,\n      { encoding: 'utf-8', timeout: 15000 }\n    )\n    const branches = JSON.parse(branchesResp).branches || []\n    for (const b of branches) {\n      if (typeof b.name === 'string' && b.name.startsWith('test-run-')) {\n        tryExec(\n          `curl -s -X DELETE \"https://console.neon.tech/api/v2/projects/${neonProjectId}/branches/${b.id}\" -H \"Authorization: Bearer ${neonApiKey}\"`,\n          { stdio: 'ignore', timeout: 10000 }\n        )\n        log(`Cleaned up stale branch: ${b.name}`)\n      }\n    }\n  } catch { log('Warning: could not clean stale branches') }\n\n  // Step 3: Create ephemeral branch\n  const branchName = `test-run-${Date.now()}`\n  let branchId = ''\n  let testDbUrl = ''\n\n  try {\n    const resp = execSync(\n      `curl -s -X POST \"https://console.neon.tech/api/v2/projects/${neonProjectId}/branches\" -H \"Authorization: Bearer ${neonApiKey}\" -H \"Content-Type: application/json\" -d '{\"branch\": {\"name\": \"${branchName}\"}, \"endpoints\": [{\"type\": \"read_write\"}]}'`,\n      { encoding: 'utf-8', timeout: 30000 }\n    )\n    const data = JSON.parse(resp)\n    branchId = data.branch?.id || ''\n    const connUri = data.connection_uris?.[0]?.connection_uri\n    if (connUri) {\n      testDbUrl = connUri\n    } else {\n      const ep = data.endpoints?.[0]\n      const host = ep?.host || ''\n      const role = data.roles?.[0]?.name || 'neondb_owner'\n      const pwResp = execSync(\n        `curl -s \"https://console.neon.tech/api/v2/projects/${neonProjectId}/branches/${branchId}/roles/${role}/reveal_password\" -H \"Authorization: Bearer ${neonApiKey}\"`,\n        { encoding: 'utf-8', timeout: 10000 }\n      )\n      const password = JSON.parse(pwResp).password || ''\n      testDbUrl = `postgresql://${role}:${password}@${host}/neondb?sslmode=require`\n    }\n    log(`Created branch: ${branchName} (${branchId})`)\n    log(`Test DB URL: ${testDbUrl.replace(/:[^:@]+@/, ':***@')}`)\n  } catch (e) {\n    log(`Failed to create branch: ${e}`)\n    writeLog()\n    console.error('Failed to create Neon test branch')\n    process.exit(1)\n  }\n\n  // Wait for branch to be ready\n  await new Promise(resolve => setTimeout(resolve, 3000))\n\n  // Step 4: Initialize schema and seed\n  try {\n    await initSchema(testDbUrl)\n    log('Schema initialized')\n    await truncateAndSeed(testDbUrl)\n    log('Database seeded')\n  } catch (e) {\n    log(`Schema/seed failed: ${e}`)\n    writeLog()\n    console.error('Schema/seed failed — see ' + logFile)\n    cleanup(branchId, neonProjectId, neonApiKey)\n    process.exit(1)\n  }\n\n  // Step 5 & 6: Remove stale recordings\n  tryExec('npx replayio remove --all 2>/dev/null || true', { stdio: 'ignore', cwd: appDir })\n\n  // Step 7: Run Playwright\n  let playwrightExitCode = 0\n  try {\n    const pwOutput = execSync(\n      `npx playwright test ${testFile} --retries 0 --workers 1`,\n      {\n        cwd: appDir,\n        encoding: 'utf-8',\n        stdio: ['ignore', 'pipe', 'pipe'],\n        timeout: 300000,\n        env: {\n          ...process.env,\n          DATABASE_URL: testDbUrl,\n          RECORD_REPLAY_API_KEY: replayApiKey,\n        },\n      }\n    )\n    log('=== Playwright Output ===\\n' + pwOutput)\n  } catch (e: unknown) {\n    const err = e as { status?: number; stdout?: string; stderr?: string }\n    playwrightExitCode = err.status || 1\n    log('=== Playwright Output ===\\n' + (err.stdout || '') + '\\n' + (err.stderr || ''))\n  }\n\n  // Step 8: Parse results\n  let passed = 0\n  let failed = 0\n  try {\n    const resultsPath = join(appDir, 'test-results', 'results.json')\n    if (existsSync(resultsPath)) {\n      const results = JSON.parse(readFileSync(resultsPath, 'utf-8'))\n      for (const suite of results.suites || []) {\n        for (const spec of suite.specs || []) {\n          for (const test of spec.tests || []) {\n            if (test.status === 'expected') passed++\n            else if (test.status === 'unexpected') failed++\n          }\n        }\n      }\n    }\n  } catch { /* ok */ }\n\n  // Step 9: Handle failure - upload recordings\n  let uploadedId = ''\n  if (playwrightExitCode !== 0) {\n    try {\n      const recLog = readFileSync(join(process.env['HOME'] || '~', '.replay', 'recordings.log'), 'utf-8')\n      const lines = recLog.trim().split('\\n').filter(l => l.trim())\n      const entries: Array<Record<string, unknown>> = []\n      for (const l of lines) {\n        try { entries.push(JSON.parse(l)) } catch { /* skip */ }\n      }\n\n      const recordings: Record<string, { id: string; duration: number; result: string; title: string }> = {}\n      for (const entry of entries) {\n        if (entry.kind === 'createRecording') {\n          recordings[entry.id as string] = { id: entry.id as string, duration: 0, result: '', title: '' }\n        }\n        if (entry.kind === 'addMetadata') {\n          const meta = entry.metadata as Record<string, Record<string, string>> | undefined\n          const rec = recordings[entry.id as string]\n          if (rec && meta?.test) {\n            rec.result = meta.test.result || ''\n            rec.title = meta.test.title || ''\n          }\n        }\n        if (entry.kind === 'writeFinished') {\n          const rec = recordings[entry.id as string]\n          if (rec) {\n            rec.duration = (entry.duration as number) || 0\n          }\n        }\n      }\n\n      const metadataBlock = Object.values(recordings)\n        .filter(r => r.result)\n        .map(r => JSON.stringify(r))\n      if (metadataBlock.length) {\n        log('\\n=== REPLAY RECORDINGS METADATA ===')\n        for (const m of metadataBlock) log(m)\n        log('=== END REPLAY RECORDINGS METADATA ===')\n      }\n\n      const failedRecs = Object.values(recordings)\n        .filter(r => r.result === 'failed' || r.result === 'timedOut')\n        .sort((a, b) => b.duration - a.duration)\n\n      if (failedRecs[0]) {\n        try {\n          const uploadOut = execSync(`npx replayio upload ${failedRecs[0].id}`, {\n            encoding: 'utf-8',\n            cwd: appDir,\n            timeout: 60000,\n            env: { ...process.env, RECORD_REPLAY_API_KEY: replayApiKey },\n          })\n          uploadedId = failedRecs[0].id\n          log(`REPLAY UPLOADED: ${uploadedId}`)\n          log(uploadOut)\n        } catch (ue) {\n          log(`Replay upload failed: ${ue}`)\n        }\n      }\n    } catch { log('Could not parse recordings') }\n  }\n\n  // Step 10: Cleanup\n  cleanup(branchId, neonProjectId, neonApiKey)\n  tryExec('npx replayio remove --all 2>/dev/null || true', { stdio: 'ignore', cwd: appDir })\n\n  writeLog()\n\n  // Step 11: Summary\n  const parts = []\n  if (passed > 0) parts.push(`${passed} passed`)\n  if (failed > 0) parts.push(`${failed} failed`)\n  if (uploadedId) parts.push(`recording: ${uploadedId}`)\n  const summary = parts.length > 0\n    ? parts.join(', ') + ` — see ${logFile}`\n    : `tests completed — see ${logFile}`\n  console.log(summary)\n\n  process.exit(playwrightExitCode)\n}\n\nfunction cleanup(branchId: string, projectId: string, apiKey: string) {\n  tryExec('pkill -f \"netlify dev\" 2>/dev/null || true', { stdio: 'ignore' })\n  if (branchId) {\n    tryExec(\n      `curl -s -X DELETE \"https://console.neon.tech/api/v2/projects/${projectId}/branches/${branchId}\" -H \"Authorization: Bearer ${apiKey}\"`,\n      { stdio: 'ignore', timeout: 10000 }\n    )\n  }\n}\n\nrun()\n","numLines":277,"startLine":1,"totalLines":277}}}
