*\n    42→    `\n    43→    const user = result[0]\n    44→    if (!user) {\n    45→      return new Response(JSON.stringify({ error: 'User not found' }), { status: 404, headers })\n    46→    }\n    47→    return new Response(JSON.stringify(user), { status: 200, headers })\n    48→  }\n    49→\n    50→  if (request.method === 'PUT') {\n    51→    const body = await request.json() as {\n    52→      name?: string\n    53→      bio?: string | null\n    54→      phone?: string | null\n    55→      avatar_url?: string | null\n    56→    }\n    57→\n    58→    const existing = await sql`SELECT * FROM users WHERE id = ${userId}`\n    59→    const existingUser = existing[0]\n    60→    if (!existingUser) {\n    61→      return new Response(JSON.stringify({ error: 'User not found' }), { status: 404, headers })\n    62→    }\n    63→\n    64→    const eu = existingUser as Record<string, unknown>\n    65→    const result = await sql`\n    66→      UPDATE users SET\n    67→        name = ${body.name !== undefined ? body.name : eu.name as string},\n    68→        bio = ${body.bio !== undefined ? (body.bio || null) : eu.bio as string | null},\n    69→        phone = ${body.phone !== undefined ? (body.phone || null) : eu.phone as string | null},\n    70→        avatar_url = ${body.avatar_url !== undefined ? (body.avatar_url || null) : eu.avatar_url as string | null}\n    71→      WHERE id = ${userId}\n    72→      RETURNING *\n    73→    `\n    74→    const user = result[0]\n    75→    return new Response(JSON.stringify(user), { status: 200, headers })\n    76→  }\n    77→\n    78→  return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers })\n    79→  } catch {\n    80→    return new Response(JSON.stringify({ error: 'Internal server error' }), { status: 500, headers })\n    81→  }\n    82→}\n    83→"}]},"parent_tool_use_id":null,"session_id":"9279a8c4-8876-4b62-a18c-3bb060c7f03c","uuid":"c675dfae-b3c6-4793-b237-bdacbe26cae7","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/netlify/functions/users.ts","content":"import type { Context } from '@netlify/functions'\nimport { getSql } from './db.js'\n\nexport default async (request: Request, _context: Context) => {\n  const sql = getSql()\n  const url = new URL(request.url)\n  const segments = url.pathname.split('/').filter(Boolean)\n  const userIdx = segments.indexOf('users')\n  const userId = userIdx >= 0 ? segments[userIdx + 1] : undefined\n  const action = userIdx >= 0 ? segments[userIdx + 2] : undefined\n\n  const headers = { 'Content-Type': 'application/json' }\n\n  if (!userId) {\n    return new Response(JSON.stringify({ error: 'User ID is required' }), { status: 400, headers })\n  }\n\n  try {\n  if (request.method === 'GET') {\n    const result = await sql`SELECT * FROM users WHERE id = ${userId}`\n    const user = result[0]\n    if (!user) {\n      return new Response(JSON.stringify({ error: 'User not found' }), { status: 404, headers })\n    }\n    return new Response(JSON.stringify(user), { status: 200, headers })\n  }\n\n  if (request.method === 'POST' && action === 'become-host') {\n    const result = await sql`\n      UPDATE users SET is_host = true WHERE id = ${userId} RETURNING *\n    `\n    const user = result[0]\n    if (!user) {\n      return new Response(JSON.stringify({ error: 'User not found' }), { status: 404, headers })\n    }\n    return new Response(JSON.stringify(user), { status: 200, headers })\n  }\n\n  if (request.method === 'POST' && action === 'reset-host') {\n    const result = await sql`\n      UPDATE users SET is_host = false WHERE id = ${userId} RETURNING *\n    `\n    const user = result[0]\n    if (!user) {\n      return new Response(JSON.stringify({ error: 'User not found' }), { status: 404, headers })\n    }\n    return new Response(JSON.stringify(user), { status: 200, headers })\n  }\n\n  if (request.method === 'PUT') {\n    const body = await request.json() as {\n      name?: string\n      bio?: string | null\n      phone?: string | null\n      avatar_url?: string | null\n    }\n\n    const existing = await sql`SELECT * FROM users WHERE id = ${userId}`\n    const existingUser = existing[0]\n    if (!existingUser) {\n      return new Response(JSON.stringify({ error: 'User not found' }), { status: 404, headers })\n    }\n\n    const eu = existingUser as Record<string, unknown>\n    const result = await sql`\n      UPDATE users SET\n        name = ${body.name !== undefined ? body.name : eu.name as string},\n        bio = ${body.bio !== undefined ? (body.bio || null) : eu.bio as string | null},\n        phone = ${body.phone !== undefined ? (body.phone || null) : eu.phone as string | null},\n        avatar_url = ${body.avatar_url !== undefined ? (body.avatar_url || null) : eu.avatar_url as string | null}\n      WHERE id = ${userId}\n      RETURNING *\n    `\n    const user = result[0]\n    return new Response(JSON.stringify(user), { status: 200, headers })\n  }\n\n  return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers })\n  } catch {\n    return new Response(JSON.stringify({ error: 'Internal server error' }), { status: 500, headers })\n  }\n}\n","numLines":83,"startLine":1,"totalLines":83}}}
