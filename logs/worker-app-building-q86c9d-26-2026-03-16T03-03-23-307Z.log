ringify(image), { status: 201, headers })\n  }\n\n  if (request.method === 'DELETE' && imageId) {\n    const result = await sql`\n      DELETE FROM property_images WHERE id = ${imageId} RETURNING *\n    `\n    const image = result[0]\n    if (!image) {\n      return new Response(JSON.stringify({ error: 'Image not found' }), { status: 404, headers })\n    }\n    return new Response(JSON.stringify(image), { status: 200, headers })\n  }\n\n  return new Response(JSON.stringify({ error: 'Method not allowed' }), { status: 405, headers })\n}\n","structuredPatch":[{"oldStart":27,"oldLines":6,"newStart":27,"newLines":9,"lines":["       RETURNING *","     `","     const image = result[0]","+    if (!image) {","+      return new Response(JSON.stringify({ error: 'Failed to create image' }), { status: 500, headers })","+    }","     return new Response(JSON.stringify(image), { status: 201, headers })","   }"," "]}],"userModified":false,"replaceAll":false}}
