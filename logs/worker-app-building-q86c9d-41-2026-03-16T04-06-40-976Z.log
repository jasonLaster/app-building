[2026-03-16T04:06:02.807Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XymN628vuXX9cA4CDAdBsB","type":"tool_result","content":"     1→import { useState, useEffect } from 'react'\n     2→import { useDispatch } from 'react-redux'\n     3→import { User, updateUser } from '../slices/authSlice'\n     4→import type { AppDispatch } from '../store'\n     5→import { User as UserIcon, Mail, Phone, FileText, Image, Check } from 'lucide-react'\n     6→\n     7→interface ProfileFormProps {\n     8→  user: User\n     9→}\n    10→\n    11→function isValidUrl(str: string): boolean {\n    12→  try {\n    13→    new URL(str)\n    14→    return true\n    15→  } catch {\n    16→    return false\n    17→  }\n    18→}\n    19→\n    20→export default function ProfileForm({ user }: ProfileFormProps) {\n    21→  const dispatch = useDispatch<AppDispatch>()\n    22→  const [name, setName] = useState(user.name)\n    23→  const [bio, setBio] = useState(user.bio || '')\n    24→  const [phone, setPhone] = useState(user.phone || '')\n    25→  const [avatarUrl, setAvatarUrl] = useState(user.avatar_url || '')\n    26→  const [saving, setSaving] = useState(false)\n    27→  const [successMessage, setSuccessMessage] = useState('')\n    28→  const [errors, setErrors] = useState<Record<string, string>>({})\n    29→\n    30→  useEffect(() => {\n    31→    setName(user.name)\n    32→    setBio(user.bio || '')\n    33→    setPhone(user.phone || '')\n    34→    setAvatarUrl(user.avatar_url || '')\n    35→  }, [user])\n    36→\n    37→  const handleSave = async () => {\n    38→    const newErrors: Record<string, string> = {}\n    39→\n    40→    if (!name.trim()) {\n    41→      newErrors.name = 'Name is required'\n    42→    }\n    43→    if (avatarUrl.trim() && !isValidUrl(avatarUrl.trim())) {\n    44→      newErrors.avatar_url = 'Please enter a valid URL'\n    45→    }\n    46→\n    47→    if (Object.keys(newErrors).length > 0) {\n    48→      setErrors(newErrors)\n    49→   