essageSquare size={20} aria-hidden=\"true\" />\n    46→        My Reviews\n    47→      </h2>\n    48→\n    49→      {reviews.length === 0 ? (\n    50→        <div data-testid=\"reviews-empty-state\" className=\"text-center py-8 text-text-secondary border border-border rounded-xl\">\n    51→          You haven't written any reviews yet\n    52→        </div>\n    53→      ) : (\n    54→        <ul className=\"space-y-3 list-none p-0 m-0\">\n    55→          {reviews.map((review) => (\n    56→            <li\n    57→              key={review.id}\n    58→              data-testid={`review-card-${review.id}`}\n    59→              className=\"rounded-xl border border-border p-4 hover:shadow-md transition-shadow\"\n    60→            >\n    61→              <div className=\"flex items-start justify-between gap-2 mb-2\">\n    62→                <button\n    63→                  data-testid={`review-property-link-${review.id}`}\n    64→                  onClick={() => navigate(`/properties/${review.property_id}`)}\n    65→                  className=\"text-primary font-semibold hover:underline text-left\"\n    66→                >\n    67→                  {review.property_title}\n    68→                </button>\n    69→                <span className=\"text-xs text-text-secondary whitespace-nowrap\">\n    70→                  {formatDate(review.created_at)}\n    71→                </span>\n    72→              </div>\n    73→\n    74→              <StarRating rating={review.rating} />\n    75→\n    76→              {review.comment && (\n    77→                <p className=\"text-sm text-text mt-2\">{review.comment}</p>\n    78→              )}\n    79→            </li>\n    80→          ))}\n    81→        </ul>\n    82→      )}\n    83→    </section>\n    84→  )\n    85→}\n    86→"}]},"parent_tool_use_id":null,"session_id":"fa1aa98d-d1b9-4519-93eb-29f8120f30e9","uuid":"891e7b26-0b9f-4e50-bf57-5ea9724c1bb6","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/components/UserReviewsList.tsx","content":"import { useNavigate } from 'react-router-dom'\nimport { Star, MessageSquare } from 'lucide-react'\nimport type { UserReview } from '../slices/userReviewsSlice'\n\ninterface UserReviewsListProps {\n  reviews: UserReview[]\n  loading: boolean\n}\n\nfunction formatDate(dateStr: string): string {\n  const date = new Date(dateStr.split('T')[0] + 'T12:00:00')\n  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })\n}\n\nfunction StarRating({ rating }: { rating: number }) {\n  return (\n    <div className=\"flex items-center gap-0.5\" data-testid=\"star-rating\" role=\"img\" aria-label={`${rating} out of 5 stars`}>\n      {[1, 2, 3, 4, 5].map((star) => (\n        <Star\n          key={star}\n          size={16}\n          aria-hidden=\"true\"\n          className={star <= rating ? 'text-primary fill-primary' : 'text-border'}\n          fill={star <= rating ? 'currentColor' : 'none'}\n        />\n      ))}\n    </div>\n  )\n}\n\nexport default function UserReviewsList({ reviews, loading }: UserReviewsListProps) {\n  const navigate = useNavigate()\n\n  if (loading) {\n    return (\n      <div data-testid=\"reviews-loading\" aria-live=\"polite\" className=\"text-center py-8 text-text-secondary\">\n        Loading reviews...\n      </div>\n    )\n  }\n\n  return (\n    <section data-testid=\"user-reviews-list\" aria-labelledby=\"my-reviews-heading\">\n      <h2 id=\"my-reviews-heading\" className=\"text-xl font-semibold text-text mb-4 flex items-center gap-2\">\n        <MessageSquare size={20} aria-hidden=\"true\" />\n        My Reviews\n      </h2>\n\n      {reviews.length === 0 ? (\n        <div data-testid=\"reviews-empty-state\" className=\"text-center py-8 text-text-secondary border border-border rounded-xl\">\n          You haven't written any reviews yet\n        </div>\n      ) : (\n        <ul className=\"space-y-3 list-none p-0 m-0\">\n          {reviews.map((review) => (\n            <li\n              key={review.id}\n              data-testid={`review-card-${review.id}`}\n              className=\"rounded-xl border border-border p-4 hover:shadow-md transition-shadow\"\n            >\n              <div className=\"flex items-start justify-between gap-2 mb-2\">\n                <button\n                  data-testid={`review-property-link-${review.id}`}\n                  onClick={() => navigate(`/properties/${review.property_id}`)}\n                  className=\"text-primary font-semibold hover:underline text-left\"\n                >\n                  {review.property_title}\n                </button>\n                <span className=\"text-xs text-text-secondary whitespace-nowrap\">\n                  {formatDate(review.created_at)}\n                </span>\n              </div>\n\n              <StarRating rating={review.rating} />\n\n              {review.comment && (\n                <p className=\"text-sm text-text mt-2\">{review.comment}</p>\n              )}\n            </li>\n          ))}\n        </ul>\n      )}\n    </section>\n  )\n}\n","numLines":86,"startLine":1,"totalLines":86}}}
