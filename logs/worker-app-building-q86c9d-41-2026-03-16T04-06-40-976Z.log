            <div className=\"w-full h-full flex items-center justify-center text-text-secondary\" aria-hidden=\"true\">\n   101→              <UserIcon size={32} />\n   102→            </div>\n   103→          )}\n   104→        </div>\n   105→        <div>\n   106→          <h3 className=\"text-lg font-semibold text-text\">{user.name}</h3>\n   107→          <p className=\"text-sm text-text-secondary\">Member since {new Date(user.created_at.split('T')[0] + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}</p>\n   108→        </div>\n   109→      </div>\n   110→\n   111→      <div className=\"space-y-4\">\n   112→        <div>\n   113→          <label htmlFor=\"profile-name\" className=\"flex items-center gap-2 text-sm font-medium text-text-secondary mb-1.5\">\n   114→            <UserIcon size={14} aria-hidden=\"true\" />\n   115→            Name\n   116→          </label>\n   117→          <input\n   118→            id=\"profile-name\"\n   119→            data-testid=\"profile-name-input\"\n   120→            type=\"text\"\n   121→            value={name}\n   122→            onChange={(e) => setName(e.target.value)}\n   123→            aria-required=\"true\"\n   124→            aria-invalid={!!errors.name}\n   125→            aria-describedby={errors.name ? 'name-error' : undefined}\n   126→            className={`w-full px-3 py-2.5 rounded-lg border ${errors.name ? 'border-error' : 'border-border'} bg-bg text-text focus:outline-none focus:border-primary transition-colors`}\n   127→            placeholder=\"Your name\"\n   128→          />\n   129→          {errors.name && <p id=\"name-error\" data-testid=\"name-error\" role=\"alert\" className=\"text-error text-xs mt-1\">{errors.name}</p>}\n   130→        </div>\n   131→\n   132→        <div>\n   133→          <label htmlFor=\"profile-email\" className=\"flex items-center gap-2 text-sm font-medium text-text-secondary mb-1.5\">\n   134→            <Mail size={14} aria-hidden=\"true\" />\