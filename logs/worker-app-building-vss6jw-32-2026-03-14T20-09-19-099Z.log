ES properties(id) ON DELETE CASCADE,\n    50→      url TEXT NOT NULL,\n    51→      caption TEXT,\n    52→      display_order INTEGER DEFAULT 0\n    53→    )\n    54→  `\n    55→\n    56→  await sql`\n    57→    CREATE TABLE IF NOT EXISTS amenities (\n    58→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    59→      name TEXT UNIQUE NOT NULL,\n    60→      icon TEXT,\n    61→      category TEXT NOT NULL\n    62→    )\n    63→  `\n    64→\n    65→  await sql`\n    66→    CREATE TABLE IF NOT EXISTS property_amenities (\n    67→      property_id UUID NOT NULL REFERENCES properties(id) ON DELETE CASCADE,\n    68→      amenity_id UUID NOT NULL REFERENCES amenities(id) ON DELETE CASCADE,\n    69→      PRIMARY KEY (property_id, amenity_id)\n    70→    )\n    71→  `\n    72→\n    73→  await sql`\n    74→    CREATE TABLE IF NOT EXISTS bookings (\n    75→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    76→      property_id UUID NOT NULL REFERENCES properties(id),\n    77→      guest_id UUID NOT NULL REFERENCES users(id),\n    78→      check_in DATE NOT NULL,\n    79→      check_out DATE NOT NULL,\n    80→      num_guests INTEGER NOT NULL,\n    81→      total_price NUMERIC NOT NULL,\n    82→      status TEXT NOT NULL DEFAULT 'pending',\n    83→      special_requests TEXT,\n    84→      created_at TIMESTAMP DEFAULT now()\n    85→    )\n    86→  `\n    87→\n    88→  await sql`\n    89→    CREATE TABLE IF NOT EXISTS reviews (\n    90→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    91→      booking_id UUID UNIQUE NOT NULL REFERENCES bookings(id),\n    92→      property_id UUID NOT NULL REFERENCES properties(id),\n    93→      guest_id UUID NOT NULL REFERENCES users(id),\n    94→      rating INTEGER NOT NULL CHECK (rating >= 1 AND rating <= 5),\n    95→      cleanliness INTEGER NOT NULL CHECK (cleanliness >= 1 AND cleanliness <= 5),\n    96→      accuracy INTEGER NOT NULL CHECK (accuracy >= 1 AND accuracy <= 5),\n    97→      communication INTEGER NOT NULL CHECK (communication >= 1 AND communication <= 5),\n    98→      location INTEGER NOT NULL CHECK (location >= 1 AND location <= 5),\n    99→      value INTEGER NOT NULL CHECK (value >= 1 AND value <= 5),\n   100→      comment TEXT,\n   101→      created_at TIMESTAMP DEFAULT now()\n   102→    )\n   103→  `\n   104→\n   105→  await sql`\n   106→    CREATE TABLE IF NOT EXISTS favorites (\n   107→      user_id UUID NOT NULL REFERENCES users(id),\n   108→      property_id UUID NOT NULL REFERENCES properties(id) ON DELETE CASCADE,\n   109→      created_at TIMESTAMP DEFAULT now(),\n   110→      PRIMARY KEY (user_id, property_id)\n   111→    )\n   112→  `\n   113→\n   114→  // Indices for common queries\n   115→  await sql`CREATE INDEX IF NOT EXISTS idx_properties_host_id ON properties(host_id)`\n   116→  await sql`CREATE INDEX IF NOT EXISTS idx_properties_city ON properties(city)`\n   117→  await sql`CREATE INDEX IF NOT EXISTS idx_properties_property_type ON properties(property_type)`\n   118→  await sql`CREATE INDEX IF NOT EXISTS idx_properties_is_active ON properties(is_active)`\n   119→  await sql`CREATE INDEX IF NOT EXISTS idx_property_images_property_id ON property_images(property_id)`\n   120→  await sql`CREATE INDEX IF NOT EXISTS idx_bookings_property_id ON bookings(property_id)`\n   121→  await sql`CREATE INDEX IF NOT EXISTS idx_bookings_guest_id ON bookings(guest_id)`\n   122→  await sql`CREATE INDEX IF NOT EXISTS idx_bookings_status ON bookings(status)`\n   123→  await sql`CREATE INDEX IF NOT EXISTS idx_reviews_property_id ON reviews(property_id)`\n   124→  await sql`CREATE INDEX IF NOT EXISTS idx_reviews_guest_id ON reviews(guest_id)`\n   125→  await sql`CREATE INDEX IF NOT EXISTS idx_favorites_user_id ON favorites(user_id)`\n   126→}\n   127→\n   128→// Allow running directly: npx tsx scripts/schema.ts <DATABASE_URL>\n   129→const url = process.argv[2]\n   130→if (url) {\n   131→  initSchema(url).then(() => {\n   132→    console.log('Schema initialized succes