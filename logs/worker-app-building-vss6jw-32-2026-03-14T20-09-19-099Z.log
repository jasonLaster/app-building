[2026-03-14T20:08:48.447Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013aBLqxaTVVb5a5D1A4AKcu","type":"tool_result","content":"     1→import { useState } from 'react'\n     2→import { Search } from 'lucide-react'\n     3→\n     4→interface SearchBarProps {\n     5→  onSearch: (filters: { city: string; checkIn: string; checkOut: string; guests: number }) => void\n     6→  initialCity?: string\n     7→  initialCheckIn?: string\n     8→  initialCheckOut?: string\n     9→  initialGuests?: number\n    10→}\n    11→\n    12→export default function SearchBar({ onSearch, initialCity = '', initialCheckIn = '', initialCheckOut = '', initialGuests = 0 }: SearchBarProps) {\n    13→  const [city, setCity] = useState(initialCity)\n    14→  const [checkIn, setCheckIn] = useState(initialCheckIn)\n    15→  const [checkOut, setCheckOut] = useState(initialCheckOut)\n    16→  const [guests, setGuests] = useState(initialGuests)\n    17→\n    18→  const today = new Date().toISOString().split('T')[0]\n    19→\n    20→  const checkOutMin = (() => {\n    21→    if (!checkIn) return today\n    22→    const d = new Date(checkIn + 'T00:00:00')\n    23→    d.setDate(d.getDate() + 1)\n    24→    return d.toISOString().split('T')[0]\n    25→  })()\n    26→\n    27→  const handleSubmit = (e: React.FormEvent) => {\n    28→    e.preventDefault()\n    29→    onSearch({ city, checkIn, checkOut, guests })\n    30→  }\n    31→\n    32→  const handleGuestsChange = (value: string) => {\n    33→    const num = parseInt(value, 10)\n    34→    if (isNaN(num) || num < 1) {\n    35→      setGuests(1)\n    36→    } else {\n    37→      setGuests(num)\n    38→    }\n    39→  }\n    40→\n    41→  return (\n    42→    <form\n    43→      data-testid=\"search-bar\"\n    44→      onSubmit={handleSubmit}\n    45→      className=\"flex flex-wrap items-center gap-3 rounded-full border border-border bg-bg p-2 shadow-md\"\n    46→    >\n    47→      <div className=\"flex-1 min-w-[160px]\">\n    48→        <input\n    49→          data-testid=\"search-location\"\n    50→          type=\"text\"\n    51→          placeholder=\"Where are you going?\"\n    52→          value={city}\n    53→          onChange={(e) => setCity(e.target.value)}\n    54→          className=\"w-full rounded-full px-4 py-2 text-sm text-text outline-none bg-transparent\"\n    55→        />\n    56→      </div>\n    57→      <div className=\"border-l border-border pl-3\">\n    58→        <input\n    59→          data-testid=\"search-checkin\"\n    60→          type=\"date\"\n    61→          value={checkIn}\n    62→          min={today}\n    63→          onChange={(e) => {\n    64→            setCheckIn(e.target.value)\n    65→            if (checkOut && e.target.value >= checkOut) {\n    66→              setCheckOut('')\n    67→            }\n    68→          }}\n    69→          className=\"rounded-full px-3 py-2 text-sm text-text outline-none bg-transparent\"\n    70→        />\n    71→      </div>\n    72→      <div className=\"border-l border-border pl-3\">\n    73→        <input\n    74→          data-testid=\"search-checkout\"\n    75→          type=\"date\"\n    76→          value={checkOut}\n    77→          min={checkOutMin}\n    78→          onChange={(e) => setCheckOut(e.target.value)}\n    79→          className=\"rounded-full px-3 py-2 text-sm text-text outline-none bg-transparent\"\n    80→        />\n    81→      </div>\n    82→      <div className=\"border-l border-border pl-3 flex items-center gap-2\">\n    83→        <input\n    84→          data-testid=\"search-guests\"\n    85→          type=\"number\"\n    86→          min={1}\n    87→          placeholder=\"Guests\"\n    88→          value={guests || ''}\n    89→          onChange={(e) => handleGuestsChange(e.target.value)}\n    90→          className=\"w-20 rounded-full px-3 py-2 text-sm text-text outline-none bg-transparent\"\n    91→        />\n    92→      </div>\n    93→      <button\n    94→        data-testid=\"search-button\"\n    95→        type=\"submit\"\n    96→        className=\"flex items-center justify-center rounded-full bg-primary p-3 text-white hover:bg-primary-dark transition-colors\"\n    97→      >\n    98→        <Search size={18} />\n    99→      </button>\n   100→    </form>\n   101→  )\n   102→}\n   103→"}]},"parent_tool_use_id":null,"session_id":"9fde50cc-e279-414b-9cdd-3033c6d151e4","uuid":"2c5678e9-0dee-4b44-bbe5-b093bf4f69aa","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/components/SearchBar.tsx","content":"import { useState } from 'react'\nimport { Search } from 'lucide-react'\n\ninterface SearchBarProps {\n  onSearch: (filters: { city: string; checkIn: string; checkOut: string; guests: number }) => void\n  initialCity?: string\n  initialCheckIn?: string\n  initialCheckOut?: string\n  initialGuests?: number\n}\n\nexport default function SearchBar({ onSearch, initialCity = '', initialCheckIn = '', initialCheckOut = '', initialGuests = 0 }: SearchBarProps) {\n  const [city, setCity] = useState(initialCity)\n  const [checkIn, setCheckIn] = useState(initialCheckIn)\n  const [checkOut, setCheckOut] = useState(initialCheckOut)\n  const [guests, setGuests] = useState(initialGuests)\n\n  const today = new Date().toISOString().split('T')[0]\n\n  const checkOutMin = (() => {\n    if (!checkIn) return today\n    const d = new Date(checkIn + 'T00:00:00')\n    d.setDate(d.getDate() + 1)\n    return d.toISOString().split('T')[0]\n  })()\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault()\n    onSearch({ city, checkIn, checkOut, guests })\n  }\n\n  const handleGuestsChange = (value: string) => {\n    const num = parseInt(value, 10)\n    if (isNaN(num) || num < 1) {\n      setGuests(1)\n    } else {\n      setGuests(num)\n    }\n  }\n\n  return (\n    <form\n      data-testid=\"search-bar\"\n      onSubmit={handleSubmit}\n      className=\"flex flex-wrap items-center gap-3 rounded-full border border-border bg-bg p-2 shadow-md\"\n    >\n      <div className=\"flex-1 min-w-[160px]\">\n        <input\n          data-testid=\"search-location\"\n          type=\"text\"\n          placeholder=\"Where are you going?\"\n          value={city}\n          onChange={(e) => setCity(e.target.value)}\n          className=\"w-full rounded-full px-4 py-2 text-sm text-text outline-none bg-transparent\"\n        />\n      </div>\n      <div className=\"border-l border-border pl-3\">\n        <input\n          data-testid=\"search-checkin\"\n          type=\"date\"\n          value={checkIn}\n          min={today}\n          onChange={(e) => {\n            setCheckIn(e.target.value)\n            if (checkOut && e.target.value >= checkOut) {\n              setCheckOut('')\n            }\n          }}\n          className=\"rounded-full px-3 py-2 text-sm text-text outline-none bg-transparent\"\n        />\n      </div>\n      <div className=\"border-l border-border pl-3\">\n        <input\n          data-testid=\"search-checkout\"\n          type=\"date\"\n          value={checkOut}\n          min={checkOutMin}\n          onChange={(e) => setCheckOut(e.target.value)}\n          className=\"rounded-full px-3 py-2 text-sm text-text outline-none bg-transparent\"\n        />\n      </div>\n      <div className=\"border-l border-border pl-3 flex items-center gap-2\">\n        <input\n          data-testid=\"search-guests\"\n          type=\"number\"\n          min={1}\n          placeholder=\"Guests\"\n          value={guests || ''}\n          onChange={(e) => handleGuestsChange(e.target.value)}\n          className=\"w-20 rounded-full px-3 py-2 text-sm text-text outline-none bg-transparent\"\n        />\n      </div>\n      <button\n        data-testid=\"search-button\"\n        type=\"submit\"\n        className=\"flex items-center justify-center rounded-full bg-primary p-3 text-white hover:bg-primary-dark transition-colors\"\n      >\n        <Search size={18} />\n      </button>\n    </form>\n  )\n}\n","numLines":103,"startLine":1,"totalLines":103}}}
