 41→    }\n    42→    if (!checkIn || !checkOut || isOwnProperty) return\n    43→\n    44→    dispatch(clearBookingError())\n    45→    const result = await dispatch(\n    46→      createBooking({\n    47→        property_id: property.id,\n    48→        guest_id: currentUser.id,\n    49→        check_in: checkIn,\n    50→        check_out: checkOut,\n    51→        num_guests: guests,\n    52→        total_price: total,\n    53→      })\n    54→    )\n    55→    if (createBooking.fulfilled.match(result)) {\n    56→      setSuccess(true)\n    57→      setTimeout(() => navigate('/trips'), 1500)\n    58→    }\n    59→  }\n    60→\n    61→  return (\n    62→    <div data-testid=\"booking-card\" className=\"border border-border rounded-xl p-6 shadow-md sticky top-6\">\n    63→      <div className=\"flex items-baseline gap-1 mb-4\">\n    64→        <span className=\"text-xl font-semibold text-text\">${Number(property.price_per_night).toFixed(0)}</span>\n    65→        <span className=\"text-text-secondary\">/ night</span>\n    66→      </div>\n    67→\n    68→      <div className=\"border border-border rounded-lg overflow-hidden mb-4\">\n    69→        <div className=\"grid grid-cols-2\">\n    70→          <div className=\"p-3 border-r border-border\">\n    71→            <label className=\"block text-xs font-semibold text-text uppercase mb-1\">Check-in</label>\n    72→            <input\n    73→              data-testid=\"booking-checkin\"\n    74→              type=\"date\"\n    75→              value={checkIn}\n    76→              min={today}\n    77→              onChange={(e) => {\n    78→                setCheckIn(e.target.value)\n    79→                if (checkOut && e.target.value >= checkOut) {\n    80→                  setCheckOut('')\n    81→                }\n    82→              }}\n    83→              className=\"w-full text-sm text-text bg-transparent outline-none\"\n    84→            />\n    85→          </div>\n    86→          <div className=\"p-3\">\n    87→            <label className=\"block text-xs font-semibold text-text uppercase mb-1\">Check-out</label>\n    88→            <input\n    89→              data-testid=\"booking-checkout\"\n    90→              type=\"date\"\n    91→              value={checkOut}\n    92→              min={checkIn || today}\n    93→              onChange={(e) => setCheckOut(e.target.value)}\n    94→              className=\"w-full text-sm text-text bg-transparent outline-none\"\n    95→            />\n    96→          </div>\n    97→        </div>\n    98→        <div className=\"border-t border-border p-3\">\n    99→          <label className=\"block text-xs font-semibold text-text uppercase mb-1\">Guests</label>\n   100→          <select\n   101→            data-testid=\"booking-guests\"\n   102→            value={guests}\n   103→            onChange={(e) => setGuests(Number(e.target.value))}\n   104→            className=\"w-full text-sm text-text bg-transparent outline-none\"\n   105→          >\n   106→            {Array.from({ length: property.max_guests }, (_, i) => i + 1).map((n) => (\n   107→              <option key={n} value={n}>\n   108→                {n} {n === 1 ? 'guest' : 'guests'}\n   109→              </option>\n   110→            ))}\n   111→          </select>\n   112→        </div>\n   113→      </div>\n   114→\n   115→      {nights > 0 && (\n   116→        <div data-testid=\"price-breakdown\" className=\"mb-4 space-y-2 text-sm\">\n   117→          <div className=\"flex justify-between text-text-secondary\">\n   118→            <span>${Number(property.price_per_night).toFixed(0)} x {nights} {nights === 1 ? 'night' : 'nights'}</span>\n   119→            <span>${nightlyTotal.toFixed(0)}</span>\n   120→          </div>\n   121→          <div className=\"flex justify-between text-text-secondary\">\n   122→            <span>Cleaning fee</span>\n   123→            <span>${cleaningFee.toFixed(0)}</span>\n   124→          </div>\n   125→          <div className=\"flex justify-between font-semibold text-text pt-2 border-t border-border\">\n   126→            <span>Total</span>\n   127→            <span>${total.toFixed(0)}</span>\n   128→          </div>\n   129→        </div>\n   130→      )}\n   131→\n   132→      {isOwnProperty ? (\n   133→        <p data-testid=\"own-property-message\" className=\"text-center text-text-secondary text-sm mb-2\">\n   134→          You cannot book your own property\n   135→        </p>\n   136→      ) : !currentUser ? (\n   137→        <button\n   138→          data-testid=\"booking-login-prompt\"\n   139→          className=\"w-full py-3 rounded-lg bg-primary text-white font-semibold hover:bg-primary-dark transition-colors cursor-pointer\"\n   140→          onClick={() => navigate('/login')}\n   141→        >\n   142→          Log in to reserve\n   143→        </button>\n   144→      ) : (\n   145→        <button\n   146→          data-testid=\"reserve-button\"\n   147→          className=\"w-full py-3 rounded-lg bg-primary text-white font-semibold hover:bg-primary-dark transition-colors disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer\"\n   148→          disabled={!canReserve}\n   149→          onClick={handleReserve}\n   150→        >\n   151→          {loading ? 'Reserving...' : 'Reserve'}\n   152→        </button>\n   153→      )}\n   154→\n   155→      {!checkIn && !checkOut && currentUser && !isOwnProperty && (\n   156→        <p className=\"text-center text-text-secondary text-xs mt-2\">Select dates to book</p>\n   157→      )}\n   158→\n   159→      {error && (\n   160→        <p data-testid=\"booking-error\" className=\"text-error text-sm mt-2 text-center\">{error}</p>\n   161→      )}\n   162→\n   163→      {success && (\n   164→        <p data-testid=\"booking-success\" className=\"text-success text-sm mt-2 text-center font-semibold\">\n   165→          Booking confirmed! Redirecting...\n   166→        </p>\n   167→      )}\n   168→    </div>\n   169→  )\n   170→}\n   171→"}]},"parent_tool_use_id":null,"session_id":"cd3c410d-9cf5-43fa-a4b5-cf8b0a16bc4d","uuid":"a5b0ac3b-9580-4562-b09b-47a50f41079e","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/components/BookingCard.tsx","content":"import { useState } from 'react'\nimport { useSelector, useDispatch } from 'react-redux'\nimport { useNavigate } from 'react-router-dom'\nimport type { RootState, AppDispatch } from '../store'\nimport type { Property } from '../slices/propertiesSlice'\nimport { createBooking, clearBookingError } from '../slices/bookingsSlice'\n\ninterface BookingCardProps {\n  property: Property\n}\n\nexport default function BookingCard({ property }: BookingCardProps) {\n  const dispatch = useDispatch<AppDispatch>()\n  const navigate = useNavigate()\n  const currentUser = useSelector((state: RootState) => state.auth.currentUser)\n  const { loading, error } = useSelector((state: RootState) => state.bookings)\n\n  const [checkIn, setCheckIn] = useState('')\n  const [checkOut, setCheckOut] = useState('')\n  const [guests, setGuests] = useState(1)\n  const [success, setSuccess] = useState(false)\n\n  const today = new Date().toISOString().split('T')[0]!\n  const isOwnProperty = currentUser?.id === property.host_id\n\n  const nights =\n    checkIn && checkOut\n      ? Math.max(0, Math.round((new Date(checkOut).getTime() - new Date(checkIn).getTime()) / (1000 * 60 * 60 * 24)))\n      : 0\n\n  const nightlyTotal = nights * Number(property.price_per_night)\n  const cleaningFee = Number(property.cleaning_fee)\n  const total = nightlyTotal + cleaningFee\n\n  const canReserve = checkIn && checkOut && nights > 0 && !isOwnProperty && currentUser && !loading\n\n  const handleReserve = async () => {\n    if (!currentUser) {\n      navigate('/login')\n      return\n    }\n    if (!checkIn || !checkOut || isOwnProperty) return\n\n    dispatch(clearBookingError())\n    const result = await dispatch(\n      createBooking({\n        property_id: property.id,\n        guest_id: currentUser.id,\n        check_in: checkIn,\n        check_out: checkOut,\n        num_guests: guests,\n        total_price: total,\n      })\n    )\n    if (createBooking.fulfilled.match(result)) {\n      setSuccess(true)\n      setTimeout(() => navigate('/trips'), 1500)\n    }\n  }\n\n  return (\n    <div data-testid=\"booking-card\" className=\"border border-border rounded-xl p-6 shadow-md sticky top-6\">\n      <div className=\"flex items-baseline gap-1 mb-4\">\n        <span className=\"text-xl font-semibold text-text\">${Number(property.price_per_night).toFixed(0)}</span>\n        <span className=\"text-text-secondary\">/ night</span>\n      </div>\n\n      <div className=\"border border-border rounded-lg overflow-hidden mb-4\">\n        <div className=\"grid grid-cols-2\">\n          <div className=\"p-3 border-r border-border\">\n            <label className=\"block text-xs font-semibold text-text uppercase mb-1\">Check-in</label>\n            <input\n              data-testid=\"booking-checkin\"\n              type=\"date\"\n              value={checkIn}\n              min={today}\n              onChange={(e) => {\n                setCheckIn(e.target.value)\n                if (checkOut && e.target.value >= checkOut) {\n                  setCheckOut('')\n                }\n              }}\n              className=\"w-full text-sm text-text bg-transparent outline-none\"\n            />\n          </div>\n          <div className=\"p-3\">\n            <label className=\"block text-xs font-semibold text-text uppercase mb-1\">Check-out</label>\n            <input\n              data-testid=\"booking-checkout\"\n              type=\"date\"\n              value={checkOut}\n              min={checkIn || today}\n              onChange={(e) => setCheckOut(e.target.value)}\n              className=\"w-full text-sm text-text bg-transparent outline-none\"\n            />\n          </div>\n        </div>\n        <div className=\"border-t border-border p-3\">\n          <label className=\"block text-xs font-semibold text-text uppercase mb-1\">Guests</label>\n          <select\n            data-testid=\"booking-guests\"\n            value={guests}\n            onChange={(e) => setGuests(Number(e.target.value))}\n            className=\"w-full text-sm text-text bg-transparent outline-none\"\n          >\n            {Array.from({ length: property.max_guests }, (_, i) => i + 1).map((n) => (\n              <option key={n} value={n}>\n                {n} {n === 1 ? 'guest' : 'guests'}\n              </option>\n            ))}\n          </select>\n        </div>\n      </div>\n\n      {nights > 0 && (\n        <div data-testid=\"price-breakdown\" className=\"mb-4 space-y-2 text-sm\">\n          <div className=\"flex justify-between text-text-secondary\">\n            <span>${Number(property.price_per_night).toFixed(0)} x {nights} {nights === 1 ? 'night' : 'nights'}</span>\n            <span>${nightlyTotal.toFixed(0)}</span>\n          </div>\n          <div className=\"flex justify-between text-text-secondary\">\n            <span>Cleaning fee</span>\n            <span>${cleaningFee.toFixed(0)}</span>\n          </div>\n          <div className=\"flex justify-between font-semibold text-text pt-2 border-t border-border\">\n            <span>Total</span>\n            <span>${total.toFixed(0)}</span>\n          </div>\n        </div>\n      )}\n\n      {isOwnProperty ? (\n        <p data-testid=\"own-property-message\" className=\"text-center text-text-secondary text-sm mb-2\">\n          You cannot book your own property\n        </p>\n      ) : !currentUser ? (\n        <button\n          data-testid=\"booking-login-prompt\"\n          className=\"w-full py-3 rounded-lg bg-primary text-white font-semibold hover:bg-primary-dark transition-colors cursor-pointer\"\n          onClick={() => navigate('/login')}\n        >\n          Log in to reserve\n        </button>\n      ) : (\n        <button\n          data-testid=\"reserve-button\"\n          className=\"w-full py-3 rounded-lg bg-primary text-white font-semibold hover:bg-primary-dark transition-colors disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer\"\n          disabled={!canReserve}\n          onClick={handleReserve}\n        >\n          {loading ? 'Reserving...' : 'Reserve'}\n        </button>\n      )}\n\n      {!checkIn && !checkOut && currentUser && !isOwnProperty && (\n        <p className=\"text-center text-text-secondary text-xs mt-2\">Select dates to book</p>\n      )}\n\n      {error && (\n        <p data-testid=\"booking-error\" className=\"text-error text-sm mt-2 text-center\">{error}</p>\n      )}\n\n      {success && (\n        <p data-testid=\"booking-success\" className=\"text-success text-sm mt-2 text-center font-semibold\">\n          Booking confirmed! Redirecting...\n        </p>\n      )}\n    </div>\n  )\n}\n","numLines":171,"startLine":1,"totalLines":171}}}
