[2026-03-14T20:27:45.226Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013TZN6Hfj5qbqR5UazwtgtZ","type":"tool_result","content":"     1→import { useState } from 'react'\n     2→import { useSelector, useDispatch } from 'react-redux'\n     3→import { useNavigate } from 'react-router-dom'\n     4→import type { RootState, AppDispatch } from '../store'\n     5→import type { Property } from '../slices/propertiesSlice'\n     6→import { createBooking, clearBookingError } from '../slices/bookingsSlice'\n     7→\n     8→interface BookingCardProps {\n     9→  property: Property\n    10→}\n    11→\n    12→export default function BookingCard({ property }: BookingCardProps) {\n    13→  const dispatch = useDispatch<AppDispatch>()\n    14→  const navigate = useNavigate()\n    15→  const currentUser = useSelector((state: RootState) => state.auth.currentUser)\n    16→  const { loading, error } = useSelector((state: RootState) => state.bookings)\n    17→\n    18→  const [checkIn, setCheckIn] = useState('')\n    19→  const [checkOut, setCheckOut] = useState('')\n    20→  const [guests, setGuests] = useState(1)\n    21→  const [success, setSuccess] = useState(false)\n    22→\n    23→  const today = new Date().toISOString().split('T')[0]!\n    24→  const isOwnProperty = currentUser?.id === property.host_id\n    25→\n    26→  const nights =\n    27→    checkIn && checkOut\n    28→      ? Math.max(0, Math.round((new Date(checkOut).getTime() - new Date(checkIn).getTime()) / (1000 * 60 * 60 * 24)))\n    29→      : 0\n    30→\n    31→  const nightlyTotal = nights * Number(property.price_per_night)\n    32→  const cleaningFee = Number(property.cleaning_fee)\n    33→  const total = nightlyTotal + cleaningFee\n    34→\n    35→  const canReserve = checkIn && checkOut && nights > 0 && !isOwnProperty && currentUser && !loading\n    36→\n    37→  const handleReserve = async () => {\n    38→    if (!currentUser) {\n    39→      navigate('/login')\n    40→      return\n    41→    }\n    42→    if (!checkIn || !checkOut || isOwnProperty) return\n    43→\n    44→    dispatch(clearBookingError())\n    45→    const result = await dispatch(\n    46→      createBooking({\n    47→        property_id: property.id,\n    48→        guest_id: currentUser.id,\n    49→        check_in: checkIn,\n    50→        check_out: checkOut,\n    51→        num_guests: guests,\n    52→        total_price: total,\n    53→      })\n    54→    )\n    55→    if (createBooking.fulfilled.match(result)) {\n    56→      setSuccess(true)\n    57→      setTimeout(() => navigate('/trips'), 1500)\n    58→    }\n    59→  }\n    60→\n    61→  return (\n    62→    <div data-testid=\"booking-card\" className=\"border border-border rounded-xl p-6 shadow-md sticky top-6\">\n    63→      <div className=\"flex items-baseline gap-1 mb-4\">\n    64→        <span className=\"text-xl font-semibold text-text\">${Number(property.price_per_night).toFixed(0)}</span>\n    65→        <span className=\"text-text-secondary\">/ night</span>\n    66→      </div>\n    67→\n    68→      <div className=\"border border-border rounded-lg overflow-hidden mb-4\">\n    69→        <div className=\"grid grid-cols-2\">\n    70→          <div className=\"p-3 border-r border-border\">\n    71→            <label className=\"block text-xs font-semibold text-text uppercase mb-1\">Check-in</label>\n    72→            <input\n    73→              data-testid=\"booking-checkin\"\n    74→              type=\"date\"\n    75→              value={checkIn}\n    76→              min={today}\n    77→              onChange={(e) => {\n    78→                setCheckIn(e.target.value)\n    79→                if (checkOut && e.target.value >= checkOut) {\n    80→                  setCheckOut('')\n    81→                }\n    82→              }}\n    83→              className=\"w-full text-sm text-text bg-transparent outline-none\"\n    84→            />\n    85→          </div>\n    86→          <div className=\"p-3\">\n    87→            <label className=\"block text-xs font-semibold text-text uppercase mb-1\">Check-out</label>\n    88→            <input\n    89→              data-testid=\"booking-checkout\"\n    90→              type=\"date\"\n    91→              value={checkOut}\n    92→              min={checkIn || today}\n    93→              onChange={(e) => setCheckOut(e.target.value)}\n    94→              className=\"w-full text-sm text-text bg-transparent outline-none\"\n    95→            />\n    96→          </div>\n    97→        </div>\n    98→        <div className=\"border-t border-border p-3\">\n    99→          <label className=\"block text-xs font-semibold text-text uppercase mb-1\">Guests</label>\n   100→          <select\n   101→            data-testid=\"booking-guests\"\n   102→            value={guests}\n   103→            onChange={(e) => setGuests(Number(e.target.value))}\n   104→            className=\"w-full text-sm text-text bg-transparent outline-none\"\n   105→          >\n   106→            {Array.from({ length: property.max_guests }, (_, i) => i + 1).map((n) => (\n   107→              <option key={n} value={n}>\n   108→                {n} {n === 1 ? 'guest' : 'guests'}\n   109→              </option>\n   110→            ))}\n   111→          </select>\n   112→        </div>\n   113→      </div>\n   114→\n   115→      {nights > 0 && (\n   116→        <div data-testid=\"price-breakdown\" className=\"mb-4 space-y-2 text-sm\">\n   117→          <div className=\"flex justify-between text-text-secondary\">\n   118→            <span>${Number(property.price_per_night).toFixed(0)} x {nights} {nights === 1 ? 'night' : 'nights'}</span>\n   119→            <span>${nightlyTotal.toFixed(0)}</span>\n   120→          </div>\n   121→          <div className=\"flex justify-between text-text-secondary\">\n   122→            <span>Cleaning fee</span>\n   123→            <span>${cleaningFee.toFixed(0)}</span>\n   124→          </div>\n   125→          <div className=\"flex justify-between font-semibold text-text pt-2 border-t border-border\">\n   126→            <span>Total</span>\n   127→            <span>${total.toFixed(0)}</span>\n   128→          </div>\n   129→        </div>\n   130→      )}\n   131→\n   132→      {isOwnProperty ? (\n   133→        <p data-testid=\"own-property-message\" className=\"text-center text-text-secondary text-sm mb-2\">\n   134→          You cannot book your own property\n   135→        </p>\n   136→      ) : !currentUser ? (\n   137→        <button\n   138→          data-testid=\"booking-login-prompt\"\n   139→          className=\"w-full py-3 rounded-lg bg-primary text-white font-semibold hover:bg-primary-dark transition-colors cursor-pointer\"\n   140→          onClick={() => navigate('/login')}\n   141→        >\n   142→          Log in to reserve\n   143→        </button>\n   144→      ) : (\n   145→        <button\n   146→          data-testid=\"reserve-button\"\n   147→          className=\"w-full py-3 rounded-lg bg-primary text-white font-semibold hover:bg-primary-dark transition-colors disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer\"\n   148→          disabled={!canReserve}\n   149→          onClick={handleReserve}\n   150→        >\n   151→          {loading ? 'Reserving...' : 'Reserve'}\n   152→        </button>\n   153→      )}\n   154→\n   155→      {!checkIn && !checkOut && currentUser && !isOwnProperty && (\n   156→        <p className=\"text-center text-text-secondary text-xs mt-2\">Select dates to book</p>\n   157→      )}\n   158→\n   159→      {error && (\n   160→        <p data-testid=\"booking-error\" className=\"text-error text-sm mt-2 text-center\">{error}</p>\n   161→      )}\n   162→\n   163→      {success && (\n   164→        <p data-testid=\"booking-success\" className=\"text-success text-sm mt-2 text-center font-semibold\">\n   165→          Booking confirmed! Redirecting...\n   166→        </p>\n   167→      )}\n   168→    </div>\n   169→  )\n   170→}\n   171→"}]},"parent_tool_use_id":"toolu_01FeTQuBkDPpAGvyoeT61UCM","session_id":"cd3c410d-9cf5-43fa-a4b5-cf8b0a16bc4d","uuid":"b2b090ab-0c7d-47c8-9291-b76a37e6902c"}
