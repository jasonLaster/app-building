t req.json();\n    50→      const { name, default_team_id } = body;\n    51→\n    52→      const workspaces = await sql`SELECT id FROM workspaces LIMIT 1`;\n    53→      const workspace = workspaces[0];\n    54→      if (!workspace) {\n    55→        return new Response(JSON.stringify({ error: 'No workspace found' }), {\n    56→          status: 404,\n    57→          headers: { 'Content-Type': 'application/json' },\n    58→        });\n    59→      }\n    60→\n    61→      if (name !== undefined) {\n    62→        if (!name || !name.trim()) {\n    63→          return new Response(JSON.stringify({ error: 'Workspace name is required' }), {\n    64→            status: 400,\n    65→            headers: { 'Content-Type': 'application/json' },\n    66→          });\n    67→        }\n    68→        await sql`UPDATE workspaces SET name = ${name.trim()} WHERE id = ${workspace.id}`;\n    69→      }\n    70→\n    71→      if (default_team_id !== undefined) {\n    72→        const teamId = default_team_id || null;\n    73→        await sql`UPDATE workspaces SET default_team_id = ${teamId} WHERE id = ${workspace.id}`;\n    74→      }\n    75→\n    76→      const updated = await sql`\n    77→        SELECT id, name, default_team_id FROM workspaces WHERE id = ${workspace.id}\n    78→      `;\n    79→      const updatedWorkspace = updated[0];\n    80→\n    81→      return new Response(JSON.stringify({ workspace: updatedWorkspace }), {\n    82→        status: 200,\n    83→        headers: { 'Content-Type': 'application/json' },\n    84→      });\n    85→    }\n    86→\n    87→    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n    88→      status: 405,\n    89→      headers: { 'Content-Type': 'application/json' },\n    90→    });\n    91→  } catch (err) {\n    92→    console.error('Workspace error:', err);\n    93→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n    94→      status: 500,\n    95→      headers: { 'Content-Type':