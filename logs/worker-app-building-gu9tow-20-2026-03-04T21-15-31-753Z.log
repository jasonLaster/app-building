14→    await expect(saveButton).toBeVisible()\n   215→    await expect(saveButton).toHaveText('Save')\n   216→  })\n   217→\n   218→  test('Cancel button discards changes and closes the modal', async ({ page }) => {\n   219→    // Use 'Walk the dog' - priority medium\n   220→    await page.goto('/')\n   221→    await page.getByTestId('todo-text').filter({ hasText: 'Walk the dog' }).click()\n   222→    await expect(page.getByTestId('edit-modal')).toBeVisible({ timeout: 10000 })\n   223→\n   224→    // Make changes\n   225→    await page.getByTestId('edit-title').clear()\n   226→    await page.getByTestId('edit-title').fill('Changed title')\n   227→    await page.getByTestId('edit-priority').click()\n   228→    await page.getByTestId('priority-option-high').click()\n   229→\n   230→    // Cancel\n   231→    await page.getByTestId('edit-cancel').click()\n   232→\n   233→    await expect(page.getByTestId('edit-modal')).not.toBeVisible({ timeout: 10000 })\n   234→\n   235→    // Verify original values preserved\n   236→    await expect(page.getByTestId('todo-text').filter({ hasText: 'Walk the dog' })).toBeVisible()\n   237→    const todoItem = page.getByTestId('todo-item').filter({ hasText: 'Walk the dog' })\n   238→    await expect(todoItem.getByTestId('priority-badge')).toContainText('Medium')\n   239→  })\n   240→\n   241→  test('Cancel button appearance', async ({ page }) => {\n   242→    await page.goto('/')\n   243→    await page.getByTestId('todo-text').first().click()\n   244→    await expect(page.getByTestId('edit-modal')).toBeVisible({ timeout: 10000 })\n   245→\n   246→    const cancelButton = page.getByTestId('edit-cancel')\n   247→    await expect(cancelButton).toBeVisible()\n   248→    await expect(cancelButton).toHaveText('Cancel')\n   249→  })\n   250→\n   251→  test('Clicking outside the modal discards changes and closes it', async ({ page }) => {\n   252→    await page.goto('/')\n   253→    await page.getByTestId('todo-text').filter({ hasText: 'Walk the