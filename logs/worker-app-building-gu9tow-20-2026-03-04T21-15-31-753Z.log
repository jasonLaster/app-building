ck()\n   140→    await expect(page.getByTestId('edit-modal')).toBeVisible({ timeout: 10000 })\n   141→    await expect(page.getByTestId('edit-notes')).toHaveValue('Remember to check the figures')\n   142→  })\n   143→\n   144→  test('Edit existing notes', async ({ page }) => {\n   145→    // Use 'Buy groceries' which has notes 'Milk, eggs, bread'\n   146→    await page.goto('/')\n   147→    await page.getByTestId('todo-text').filter({ hasText: 'Buy groceries' }).click()\n   148→    await expect(page.getByTestId('edit-modal')).toBeVisible({ timeout: 10000 })\n   149→    await expect(page.getByTestId('edit-notes')).toHaveValue('Milk, eggs, bread')\n   150→\n   151→    await page.getByTestId('edit-notes').clear()\n   152→    await page.getByTestId('edit-notes').fill('New notes content')\n   153→    await page.getByTestId('edit-save').click()\n   154→\n   155→    await expect(page.getByTestId('edit-modal')).not.toBeVisible({ timeout: 10000 })\n   156→\n   157→    // Re-open modal to verify notes updated\n   158→    await page.getByTestId('todo-text').filter({ hasText: 'Buy groceries' }).click()\n   159→    await expect(page.getByTestId('edit-modal')).toBeVisible({ timeout: 10000 })\n   160→    await expect(page.getByTestId('edit-notes')).toHaveValue('New notes content')\n   161→  })\n   162→\n   163→  test('Notes textarea supports multiline text', async ({ page }) => {\n   164→    await page.goto('/')\n   165→    await page.getByTestId('todo-text').filter({ hasText: 'Walk the dog' }).click()\n   166→    await expect(page.getByTestId('edit-modal')).toBeVisible({ timeout: 10000 })\n   167→\n   168→    await page.getByTestId('edit-notes').fill('Line 1\\nLine 2\\nLine 3')\n   169→    await page.getByTestId('edit-save').click()\n   170→\n   171→    await expect(page.getByTestId('edit-modal')).not.toBeVisible({ timeout: 10000 })\n   172→\n   173→    // Re-open modal to verify multiline notes preserved\n   174→    await page.getByTestId('todo-text').filter({ hasText: 'Walk the