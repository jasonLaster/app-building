gs,\n            getUpdatedConfig,\n            importMapFromTOML: config.functions?.['*'].deno_import_map,\n            projectDir,\n            runIsolate,\n            servePath,\n        });\n        return registry;\n    }\n    catch (error) {\n        return logAndThrowError(error instanceof Error ? error.message : error?.toString());\n    }\n};\n//# sourceMappingURL=proxy.js.map","numLines":41,"startLine":113,"totalLines":153}}}
