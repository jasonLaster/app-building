sponse(JSON.stringify({ error: 'Todo ID required' }), { status: 400, headers })\n    47→      }\n    48→      const body = await req.json()\n    49→      const title = body.title !== undefined ? body.title : undefined\n    50→      const completed = body.completed !== undefined ? body.completed : undefined\n    51→      const priority = body.priority !== undefined ? body.priority : undefined\n    52→      const dueDate = body.due_date !== undefined ? (body.due_date || null) : undefined\n    53→      const notes = body.notes !== undefined ? (body.notes || null) : undefined\n    54→\n    55→      let rows;\n    56→      if (title !== undefined && completed !== undefined && priority !== undefined && dueDate !== undefined && notes !== undefined) {\n    57→        rows = await sql`\n    58→          UPDATE todos SET title = ${title}, completed = ${completed}, priority = ${priority},\n    59→          due_date = ${dueDate}, notes = ${notes}, updated_at = NOW()\n    60→          WHERE id = ${todoId} RETURNING *\n    61→        `\n    62→      } else if (completed !== undefined && title === undefined && priority === undefined && dueDate === undefined && notes === undefined) {\n    63→        rows = await sql`\n    64→          UPDATE todos SET completed = ${completed}, updated_at = NOW()\n    65→          WHERE id = ${todoId} RETURNING *\n    66→        `\n    67→      } else {\n    68→        const t = title !== undefined ? title : null\n    69→        const c = completed !== undefined ? completed : null\n    70→        const p = priority !== undefined ? priority : null\n    71→        const d = dueDate !== undefined ? dueDate : null\n    72→        const n = notes !== undefined ? notes : null\n    73→        rows = await sql`\n    74→          UPDATE todos SET\n    75→            title = COALESCE(${t}, title),\n    76→            completed = COALESCE(${c}, completed),\n    77→            priority = COALESCE(${p}, priority),\n    78→            due_date = CASE WHEN ${dueDa