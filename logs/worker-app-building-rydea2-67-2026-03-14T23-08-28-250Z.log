already on this team' }), {\n    45→          status: 409,\n    46→          headers: { 'Content-Type': 'application/json' },\n    47→        });\n    48→      }\n    49→\n    50→      await sql`\n    51→        INSERT INTO team_members (team_id, member_id)\n    52→        VALUES (${teamId}, ${memberIdToAdd})\n    53→      `;\n    54→\n    55→      const addedMembers = await sql`\n    56→        SELECT m.id, m.name, m.email\n    57→        FROM members m WHERE m.id = ${memberIdToAdd}\n    58→      `;\n    59→      const addedMember = addedMembers[0];\n    60→\n    61→      return new Response(JSON.stringify({ member: addedMember }), {\n    62→        status: 201,\n    63→        headers: { 'Content-Type': 'application/json' },\n    64→      });\n    65→    }\n    66→\n    67→    if (req.method === 'DELETE') {\n    68→      const body = await req.json();\n    69→      const { teamId, memberIdToRemove } = body as { teamId: string; memberIdToRemove: string };\n    70→\n    71→      if (!teamId || !memberIdToRemove) {\n    72→        return new Response(JSON.stringify({ error: 'teamId and memberIdToRemove are required' }), {\n    73→          status: 400,\n    74→          headers: { 'Content-Type': 'application/json' },\n    75→        });\n    76→      }\n    77→\n    78→      await sql`\n    79→        DELETE FROM team_members WHERE team_id = ${teamId} AND member_id = ${memberIdToRemove}\n    80→      `;\n    81→\n    82→      return new Response(JSON.stringify({ success: true }), {\n    83→        status: 200,\n    84→        headers: { 'Content-Type': 'application/json' },\n    85→      });\n    86→    }\n    87→\n    88→    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n    89→      status: 405,\n    90→      headers: { 'Content-Type': 'application/json' },\n    91→    });\n    92→  } catch (err) {\n    93→    console.error('Team members error:', err);\n    94→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n    95→      status: 500,\n    96→      headers: { 'Content-Type': 'application/json' },\n    97→    });\n    98→  }\n    99→}\n   100→"}]},"parent_tool_use_id":"toolu_016SKs4LhrQk7ADjDzYFUYrH","session_id":"fcb6b53d-bb9b-46d6-b424-732f94121451","uuid":"c7fce069-6313-421a-94f2-ea31b6ce195c"}
