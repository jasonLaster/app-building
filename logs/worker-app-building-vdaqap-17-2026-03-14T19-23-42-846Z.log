ite setup\n    98→  if (!env.NETLIFY_SITE_ID) {\n    99→    log('Creating Netlify site...')\n   100→    try {\n   101→      const siteName = `google-flights-${Date.now()}`\n   102→      const output = execSync(\n   103→        `LC_ALL=C npx netlify sites:create --account-slug ${NETLIFY_ACCOUNT_SLUG} --name ${siteName}`,\n   104→        { cwd: appDir, env: { ...process.env, NETLIFY_AUTH_TOKEN }, encoding: 'utf-8', stdio: ['ignore', 'pipe', 'pipe'] }\n   105→      )\n   106→      log(output)\n   107→      // Extract site ID from output\n   108→      const siteIdMatch = output.match(/Site ID:\\s+([a-f0-9-]+)/i) || output.match(/([a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12})/)\n   109→      if (siteIdMatch?.[1]) {\n   110→        writeEnvVar('NETLIFY_SITE_ID', siteIdMatch[1])\n   111→        env = readEnv()\n   112→        log(`Created Netlify site: ${siteIdMatch[1]}`)\n   113→      }\n   114→    } catch (e: unknown) {\n   115→      const err = e as { stdout?: string; stderr?: string }\n   116→      log('Site creation output: ' + (err.stdout || '') + (err.stderr || ''))\n   117→    }\n   118→  }\n   119→\n   120→  // Ensure public/_redirects exists for SPA routing\n   121→  const publicDir = join(appDir, 'public')\n   122→  mkdirSync(publicDir, { recursive: true })\n   123→  writeFileSync(join(publicDir, '_redirects'), '/* /index.html 200\\n')\n   124→\n   125→  // Step 5: Build\n   126→  log('Building app...')\n   127→  try {\n   128→    const buildOutput = execSync('npx vite build', {\n   129→      cwd: appDir,\n   130→      encoding: 'utf-8',\n   131→      stdio: ['ignore', 'pipe', 'pipe'],\n   132→      env: { ...process.env },\n   133→    })\n   134→    log('=== Build Output ===\\n' + buildOutput)\n   135→  } catch (e: unknown) {\n   136→    const err = e as { stdout?: string; stderr?: string }\n   137→    log('=== Build Failed ===\\n' + (err.stdout || '') + '\\n' + (err.stderr || ''))\n   138→    writeFileSync(logPath, logContent)\n   139→    conso