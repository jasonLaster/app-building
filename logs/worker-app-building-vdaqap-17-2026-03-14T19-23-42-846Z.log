[2026-03-14T19:23:32.981Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011hG7PdVz12TwDJoDiym8qC","type":"tool_result","content":"     1→import { execSync, spawn } from 'child_process'\n     2→import { readFileSync, writeFileSync, mkdirSync, readdirSync, existsSync } from 'fs'\n     3→import { join } from 'path'\n     4→import { initSchema } from './schema.ts'\n     5→import { truncateAndSeed } from './seed-db.ts'\n     6→\n     7→const appDir = join(import.meta.dirname, '..')\n     8→const logDir = join(appDir, 'logs')\n     9→mkdirSync(logDir, { recursive: true })\n    10→\n    11→// Determine log file number\n    12→const existingLogs = readdirSync(logDir).filter(f => f.match(/^test-run-\\d+\\.log$/))\n    13→const maxNum = existingLogs.reduce((max, f) => {\n    14→  const m = f.match(/test-run-(\\d+)\\.log/)\n    15→  return m ? Math.max(max, parseInt(m[1]!)) : max\n    16→}, 0)\n    17→const logNum = maxNum + 1\n    18→const logPath = join(logDir, `test-run-${logNum}.log`)\n    19→let logContent = ''\n    20→function log(msg: string) { logContent += msg + '\\n' }\n    21→\n    22→// Read .env\n    23→function readEnv(): Record<string, string> {\n    24→  const envPath = join(appDir, '.env')\n    25→  if (!existsSync(envPath)) return {}\n    26→  const lines = readFileSync(envPath, 'utf-8').split('\\n')\n    27→  const env: Record<string, string> = {}\n    28→  for (const line of lines) {\n    29→    const idx = line.indexOf('=')\n    30→    if (idx > 0 && !line.startsWith('#')) {\n    31→      env[line.slice(0, idx).trim()] = line.slice(idx + 1).trim()\n    32→    }\n    33→  }\n    34→  return env\n    35→}\n    36→\n    37→const testFile = process.argv[2]\n    38→if (!testFile) {\n    39→  console.error('Usage: npm run test <test-file>')\n    40→  process.exit(1)\n    41→}\n    42→\n    43→const NEON_API_KEY = (process.env.NEON_API_KEY || '').trim()\n    44→const RECORD_REPLAY_API_KEY = process.env.RECORD_REPLAY_API_KEY || ''\n    45→const envVars = readEnv()\n    46→const NEON_PROJECT_ID = envVars.NEON_PROJECT_ID || ''\n    47→const DATABASE_URL = envVars.DATABASE_URL || ''\n    48→\n    49→if (!NEON_API_KEY || !NEON_PROJECT_ID || !DATABASE_URL) {\n    50→  console.error('Missing required env vars (NEON_API_KEY, NEON_PROJECT_ID, DATABASE_URL)')\n    51→  process.exit(1)\n    52→}\n    53→\n    54→async function neonApi(method: string, path: string, body?: unknown) {\n    55→  const opts: RequestInit = {\n    56→    method,\n    57→    headers: {\n    58→      'Authorization': `Bearer ${NEON_API_KEY}`,\n    59→      'Content-Type': 'application/json',\n    60→    },\n    61→  }\n    62→  if (body) opts.body = JSON.stringify(body)\n    63→  const res = await fetch(`https://console.neon.tech/api/v2${path}`, opts)\n    64→  return res.json()\n    65→}\n    66→\n    67→async function main() {\n    68→  // Step 1: Kill stale processes\n    69→  try { execSync('pkill -f \"netlify dev\" 2>/dev/null || true', { stdio: 'ignore' }) } catch { /* ignore */ }\n    70→  try { execSync('pkill -f \"vite\" 2>/dev/null || true', { stdio: 'ignore' }) } catch { /* ignore */ }\n    71→\n    72→  // Step 2: Clean up stale Neon test branches\n    73→  const branchesRes = await neonApi('GET', `/projects/${NEON_PROJECT_ID}/branches`) as { branches?: { id: string; name: string }[] }\n    74→  const branches = branchesRes.branches || []\n    75→  for (const b of branches) {\n    76→    if (b.name.startsWith('test-run-')) {\n    77→      log(`Deleting stale branch: ${b.name}`)\n    78→      await neonApi('DELETE', `/projects/${NEON_PROJECT_ID}/branches/${b.id}`)\n    79→    }\n    80→  }\n    81→\n    82→  // Step 3: Create ephemeral Neon branch\n    83→  const branchName = `test-run-${Date.now()}`\n    84→  log(`Creating branch: ${branchName}`)\n    85→  const branchRes = await neonApi('POST', `/projects/${NEON_PROJECT_ID}/branches`, {\n    86→    branch: { name: branchName },\n    87→    endpoints: [{ type: 'read_write' }],\n    88→  }) as {\n    89→    branch?: { id: string };\n    90→    endpoints?: { host: string }[];\n    91→    roles?: { name: string; password?: string }[];\n    92→    connection_uris?: { connection_uri: string }[];\n    93→  }\n    94→\n    95→  const branchId = branchRes.branch?.id\n    96→  if (!branchId) {\n    97→    log('Failed to create branch: ' + JSON.stringify(branchRes))\n    98→    writeFileSync(logPath, logContent)\n    99→    console.log(`0 passed, 0 failed — see logs/test-run-${logNum}.log`)\n   100→    process.exit(1)\n   101→  }\n   102→\n   103→  let testDbUrl = ''\n   104→  if (branchRes.connection_uris?.[0]?.connection_uri) {\n   105→    testDbUrl = branchRes.connection_uris[0].connection_uri\n   106→  } else {\n   107→    const host = branchRes.endpoints?.[0]?.host || ''\n   108→    const roleName = branchRes.roles?.[0]?.name || 'neondb_owner'\n   109→    let password = branchRes.roles?.[0]?.password || ''\n   110→    if (!password) {\n   111→      const pwRes = await neonApi('GET', `/projects/${NEON_PROJECT_ID}/branches/${branchId}/roles/${roleName}/reveal_password`) as { password?: string }\n   112→      password = pwRes.password || ''\n   113→    }\n   114→    testDbUrl = `postgresql://${roleName}:${password}@${host}/neondb?sslmode=require`\n   115→  }\n   116→\n   117→  log(`Branch DB URL: ${testDbUrl.replace(/:[^:@]+@/, ':***@')}`)\n   118→\n   119→  let playwrightExit = 1\n   120→\n   121→  try {\n   122→    // Step 4: Initialize and seed\n   123→    log('Initializing schema...')\n   124→    await initSchema(testDbUrl)\n   125→    log('Schema initialized')\n   126→\n   127→    log('Seeding database...')\n   128→    await truncateAndSeed(testDbUrl)\n   129→    log('Database seeded')\n   130→\n   131→    // Step 5: Start netlify dev\n   132→    log('Starting netlify dev...')\n   133→    const serverProc = spawn('npx', ['netlify', 'dev', '--port', '8888', '--functions', './netlify/functions'], {\n   134→      cwd: appDir,\n   135→      env: { ...process.env, DATABASE_URL: testDbUrl, LC_ALL: 'C' },\n   136→      stdio: ['ignore', 'pipe', 'pipe'],\n   137→    })\n   138→\n   139→    let serverOutput = ''\n   140→    serverProc.stdout.on('data', (d: Buffer) => { serverOutput += d.toString() })\n   141→    serverProc.stderr.on('data', (d: Buffer) => { serverOutput += d.toString() })\n   142→\n   143→    // Wait for server to be ready\n   144→    await new Promise<void>((resolve, reject) => {\n   145→      const timeout = setTimeout(() => reject(new Error('Server start timeout')), 30000)\n   146→      const check = setInterval(async () => {\n   147→        try {\n   148→          const res = await fetch('http://localhost:8888', { signal: AbortSignal.timeout(2000) })\n   149→          if (res.ok || res.status === 200 || res.status === 304) {\n   150→            clearInterval(check)\n   151→            clearTimeout(timeout)\n   152→            resolve()\n   153→          }\n   154→        } catch { /* not ready yet */ }\n   155→      }, 1000)\n   156→    })\n   157→\n   158→    log('Server ready')\n   159→\n   160→    // Step 6: Remove stale recordings\n   161→    try { execSync('npx replayio remove --all 2>/dev/null || true', { cwd: appDir, stdio: 'ignore' }) } catch { /* ignore */ }\n   162→\n   163→    // Step 7: Run Playwright\n   164→    log(`Running: npx playwright test ${testFile} --retries 0 --workers 1`)\n   165→\n   166→    // Create a reset script for between tests\n   167→    const resetEnv = { ...process.env, DATABASE_URL: testDbUrl }\n   168→\n   169→    try {\n   170→      const pwOutput = execSync(\n   171→        `npx playwright test ${testFile} --retries 0 --workers 1`,\n   172→        {\n   173→          cwd: appDir,\n   174→          env: { ...resetEnv, RECORD_REPLAY_API_KEY, PW_TEST_REUSE_CONTEXT: '0' },\n   175→          stdio: ['ignore', 'pipe', 'pipe'],\n   176→          timeout: 300000,\n   177→        }\n   178→      )\n   179→      log('=== Playwright Output ===')\n   180→      log(pwOutput.toString())\n   181→      playwrightExit = 0\n   182→    } catch (e: unknown) {\n   183→      const err = e as { stdout?: Buffer; stderr?: Buffer; status?: number }\n   184→      log('=== Playwright Output ===')\n   185→      log((err.stdout?.toString() || '') + '\\n' + (err.stderr?.toString() || ''))\n   186→      playwrightExit = err.status || 1\n   187→    }\n   188→\n   189→    log('=== Server Output ===')\n   190→    log(serverOutput)\n   191→\n   192→    // Step 8: Parse results\n   193→    const resultsPath = join(appDir, 'test-results', 'results.json')\n   194→    let passed = 0, failed = 0, _skipped = 0\n   195→    if (existsSync(resultsPath)) {\n   196→      try {\n   197→        const results = JSON.parse(readFileSync(resultsPath, 'utf-8'))\n   198→        for (const suite of (results.suites || [])) {\n   199→          for (const spec of (suite.specs || [])) {\n   200→            for (const test of (spec.tests || [])) {\n   201→              if (test.status === 'expected') passed++\n   202→              else if (test.status === 'unexpected') failed++\n   203→              else if (test.status === 'skipped') _skipped++\n   204→            }\n   205→          }\n   206→        }\n   207→      } catch { /* ignore parse errors */ }\n   208→    }\n   209→\n   210→    // Step 9: On failure, handle recordings\n   211→    let uploadedId = ''\n   212→    if (playwrightExit !== 0) {\n   213→      const recordingsLogPath = join(process.env.HOME || '~', '.replay', 'recordings.log')\n   214→      if (existsSync(recordingsLogPath)) {\n   215→        const lines = readFileSync(recordingsLogPath, 'utf-8').split('\\n').filter(Boolean)\n   216→        const recordings: Record<string, { id: string; duration?: number; result?: string; finished?: boolean }> = {}\n   217→\n   218→        for (const line of lines) {\n   219→          try {\n   220→            const entry = JSON.parse(line)\n   221→            if (entry.kind === 'createRecording') {\n   222→              recordings[entry.id] = { id: entry.id, duration: 0, finished: false }\n   223→            } else if (entry.kind === 'writeFinished' && recordings[entry.id]) {\n   224→              recordings[entry.id]!.finished = true\n   225→            } else if (entry.kind === 'addMetadata' && recordings[entry.id]) {\n   226→              const testResult = entry.metadata?.test?.result\n   227→              if (testResult) recordings[entry.id]!.result = testResult\n   228→              if (entry.metadata?.test?.duration) recordings[entry.id]!.duration = entry.metadata.test.duration\n   229→            }\n   230→          } catch { /* skip bad lines */ }\n   231→        }\n   232→\n   233→        // Find failed recordings\n   234→        const failedRecs = Object.values(recordings).filter(\n   235→          r => r.finished && (r.result === 'failed' || r.result === 'timedOut')\n   236→        )\n   237→\n   238→        log('\\n=== REPLAY RECORDINGS METADATA ===')\n   239→        for (const r of Object.values(recordings)) {\n   240→          log(JSON.stringify(r))\n   241→        }\n   242→        log('=== END REPLAY RECORDINGS METADATA ===')\n   243→\n   244→        if (failedRecs.length > 0) {\n   245→          // Pick the longest duration one\n   246→          failedRecs.sort((a, b) => (b.duration || 0) - (a.duration || 0))\n   247→          const toUpload = failedRecs[0]!\n   248→          log(`\\nUploading recording: ${toUpload.id}`)\n   249→          try {\n   250→            execSync(`npx replayio upload ${toUpload.id}`, {\n   251→              cwd: appDir,\n   252→              env: { ...process.env, RECORD_REPLAY_API_KEY },\n   253→              stdio: ['ignore', 'pipe', 'pipe'],\n   254→              timeout: 60000,\n   255→            })\n   256→            uploadedId = toUpload.id\n   257→            log(`REPLAY UPLOADED: ${uploadedId}`)\n   258→          } catch (ue: unknown) {\n   259→            const uploadErr = ue as { status?: number }\n   260→            log(`Upload failed with exit code: ${uploadErr.status}`)\n   261→          }\n   262→        }\n   263→      }\n   264→    }\n   265→\n   266→    // Clean up server\n   267→    serverProc.kill('SIGTERM')\n   268→\n   269→    // Step 10: Print summary\n   270→    writeFileSync(logPath, logContent)\n   271→\n   272→    let summary = ''\n   273→    if (failed > 0) {\n   274→      summary = `${passed} passed, ${failed} failed`\n   275→      if (uploadedId) summary += ` (recording: ${uploadedId})`\n   276→    } else if (passed > 0) {\n   277→      summary = `${passed} passed`\n   278→    } else {\n   279→      summary = playwrightExit === 0 ? 'Tests completed' : 'Tests failed'\n   280→    }\n   281→    summary += ` — see logs/test-run-${logNum}.log`\n   282→    console.log(summary)\n   283→  } finally {\n   284→    // Step 10: Clean up Neon branch\n   285→    try {\n   286→      await neonApi('DELETE', `/projects/${NEON_PROJECT_ID}/branches/${branchId}`)\n   287→      log('Cleaned up test branch')\n   288→    } catch { /* ignore */ }\n   289→\n   290→    // Remove local recordings\n   291→    try { execSync('npx replayio remove --all 2>/dev/null || true', { cwd: appDir, stdio: 'ignore' }) } catch { /* ignore */ }\n   292→\n   293→    writeFileSync(logPath, logContent)\n   294→  }\n   295→\n   296→  process.exit(playwrightExit)\n   297→}\n   298→\n   299→main().catch(e => {\n   300→  console.error(e)\n   301→  process.exit(1)\n   302→})\n   303→"}]},"parent_tool_use_id":null,"session_id":"b7fe4173-4587-477f-bea2-02f6fa247ae7","uuid":"c54cb745-e9a1-4525-b4be-2fa4bf0d2978","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/GoogleFlights/scripts/test.ts","content":"import { execSync, spawn } from 'child_process'\nimport { readFileSync, writeFileSync, mkdirSync, readdirSync, existsSync } from 'fs'\nimport { join } from 'path'\nimport { initSchema } from './schema.ts'\nimport { truncateAndSeed } from './seed-db.ts'\n\nconst appDir = join(import.meta.dirname, '..')\nconst logDir = join(appDir, 'logs')\nmkdirSync(logDir, { recursive: true })\n\n// Determine log file number\nconst existingLogs = readdirSync(logDir).filter(f => f.match(/^test-run-\\d+\\.log$/))\nconst maxNum = existingLogs.reduce((max, f) => {\n  const m = f.match(/test-run-(\\d+)\\.log/)\n  return m ? Math.max(max, parseInt(m[1]!)) : max\n}, 0)\nconst logNum = maxNum + 1\nconst logPath = join(logDir, `test-run-${logNum}.log`)\nlet logContent = ''\nfunction log(msg: string) { logContent += msg + '\\n' }\n\n// Read .env\nfunction readEnv(): Record<string, string> {\n  const envPath = join(appDir, '.env')\n  if (!existsSync(envPath)) return {}\n  const lines = readFileSync(envPath, 'utf-8').split('\\n')\n  const env: Record<string, string> = {}\n  for (const line of lines) {\n    const idx = line.indexOf('=')\n    if (idx > 0 && !line.startsWith('#')) {\n      env[line.slice(0, idx).trim()] = line.slice(idx + 1).trim()\n    }\n  }\n  return env\n}\n\nconst testFile = process.argv[2]\nif (!testFile) {\n  console.error('Usage: npm run test <test-file>')\n  process.exit(1)\n}\n\nconst NEON_API_KEY = (process.env.NEON_API_KEY || '').trim()\nconst RECORD_REPLAY_API_KEY = process.env.RECORD_REPLAY_API_KEY || ''\nconst envVars = readEnv()\nconst NEON_PROJECT_ID = envVars.NEON_PROJECT_ID || ''\nconst DATABASE_URL = envVars.DATABASE_URL || ''\n\nif (!NEON_API_KEY || !NEON_PROJECT_ID || !DATABASE_URL) {\n  console.error('Missing required env vars (NEON_API_KEY, NEON_PROJECT_ID, DATABASE_URL)')\n  process.exit(1)\n}\n\nasync function neonApi(method: string, path: string, body?: unknown) {\n  const opts: RequestInit = {\n    method,\n    headers: {\n      'Authorization': `Bearer ${NEON_API_KEY}`,\n      'Content-Type': 'application/json',\n    },\n  }\n  if (body) opts.body = JSON.stringify(body)\n  const res = await fetch(`https://console.neon.tech/api/v2${path}`, opts)\n  return res.json()\n}\n\nasync function main() {\n  // Step 1: Kill stale processes\n  try { execSync('pkill -f \"netlify dev\" 2>/dev/null || true', { stdio: 'ignore' }) } catch { /* ignore */ }\n  try { execSync('pkill -f \"vite\" 2>/dev/null || true', { stdio: 'ignore' }) } catch { /* ignore */ }\n\n  // Step 2: Clean up stale Neon test branches\n  const branchesRes = await neonApi('GET', `/projects/${NEON_PROJECT_ID}/branches`) as { branches?: { id: string; name: string }[] }\n  const branches = branchesRes.branches || []\n  for (const b of branches) {\n    if (b.name.startsWith('test-run-')) {\n      log(`Deleting stale branch: ${b.name}`)\n      await neonApi('DELETE', `/projects/${NEON_PROJECT_ID}/branches/${b.id}`)\n    }\n  }\n\n  // Step 3: Create ephemeral Neon branch\n  const branchName = `test-run-${Date.now()}`\n  log(`Creating branch: ${branchName}`)\n  const branchRes = await neonApi('POST', `/projects/${NEON_PROJECT_ID}/branches`, {\n    branch: { name: branchName },\n    endpoints: [{ type: 'read_write' }],\n  }) as {\n    branch?: { id: string };\n    endpoints?: { host: string }[];\n    roles?: { name: string; password?: string }[];\n    connection_uris?: { connection_uri: string }[];\n  }\n\n  const branchId = branchRes.branch?.id\n  if (!branchId) {\n    log('Failed to create branch: ' + JSON.stringify(branchRes))\n    writeFileSync(logPath, logContent)\n    console.log(`0 passed, 0 failed — see logs/test-run-${logNum}.log`)\n    process.exit(1)\n  }\n\n  let testDbUrl = ''\n  if (branchRes.connection_uris?.[0]?.connection_uri) {\n    testDbUrl = branchRes.connection_uris[0].connection_uri\n  } else {\n    const host = branchRes.endpoints?.[0]?.host || ''\n    const roleName = branchRes.roles?.[0]?.name || 'neondb_owner'\n    let password = branchRes.roles?.[0]?.password || ''\n    if (!password) {\n      const pwRes = await neonApi('GET', `/projects/${NEON_PROJECT_ID}/branches/${branchId}/roles/${roleName}/reveal_password`) as { password?: string }\n      password = pwRes.password || ''\n    }\n    testDbUrl = `postgresql://${roleName}:${password}@${host}/neondb?sslmode=require`\n  }\n\n  log(`Branch DB URL: ${testDbUrl.replace(/:[^:@]+@/, ':***@')}`)\n\n  let playwrightExit = 1\n\n  try {\n    // Step 4: Initialize and seed\n    log('Initializing schema...')\n    await initSchema(testDbUrl)\n    log('Schema initialized')\n\n    log('Seeding database...')\n    await truncateAndSeed(testDbUrl)\n    log('Database seeded')\n\n    // Step 5: Start netlify dev\n    log('Starting netlify dev...')\n    const serverProc = spawn('npx', ['netlify', 'dev', '--port', '8888', '--functions', './netlify/functions'], {\n      cwd: appDir,\n      env: { ...process.env, DATABASE_URL: testDbUrl, LC_ALL: 'C' },\n      stdio: ['ignore', 'pipe', 'pipe'],\n    })\n\n    let serverOutput = ''\n    serverProc.stdout.on('data', (d: Buffer) => { serverOutput += d.toString() })\n    serverProc.stderr.on('data', (d: Buffer) => { serverOutput += d.toString() })\n\n    // Wait for server to be ready\n    await new Promise<void>((resolve, reject) => {\n      const timeout = setTimeout(() => reject(new Error('Server start timeout')), 30000)\n      const check = setInterval(async () => {\n        try {\n          const res = await fetch('http://localhost:8888', { signal: AbortSignal.timeout(2000) })\n          if (res.ok || res.status === 200 || res.status === 304) {\n            clearInterval(check)\n            clearTimeout(timeout)\n            resolve()\n          }\n        } catch { /* not ready yet */ }\n      }, 1000)\n    })\n\n    log('Server ready')\n\n    // Step 6: Remove stale recordings\n    try { execSync('npx replayio remove --all 2>/dev/null || true', { cwd: appDir, stdio: 'ignore' }) } catch { /* ignore */ }\n\n    // Step 7: Run Playwright\n    log(`Running: npx playwright test ${testFile} --retries 0 --workers 1`)\n\n    // Create a reset script for between tests\n    const resetEnv = { ...process.env, DATABASE_URL: testDbUrl }\n\n    try {\n      const pwOutput = execSync(\n        `npx playwright test ${testFile} --retries 0 --workers 1`,\n        {\n          cwd: appDir,\n          env: { ...resetEnv, RECORD_REPLAY_API_KEY, PW_TEST_REUSE_CONTEXT: '0' },\n          stdio: ['ignore', 'pipe', 'pipe'],\n          timeout: 300000,\n        }\n      )\n      log('=== Playwright Output ===')\n      log(pwOutput.toString())\n      playwrightExit = 0\n    } catch (e: unknown) {\n      const err = e as { stdout?: Buffer; stderr?: Buffer; status?: number }\n      log('=== Playwright Output ===')\n      log((err.stdout?.toString() || '') + '\\n' + (err.stderr?.toString() || ''))\n      playwrightExit = err.status || 1\n    }\n\n    log('=== Server Output ===')\n    log(serverOutput)\n\n    // Step 8: Parse results\n    const resultsPath = join(appDir, 'test-results', 'results.json')\n    let passed = 0, failed = 0, _skipped = 0\n    if (existsSync(resultsPath)) {\n      try {\n        const results = JSON.parse(readFileSync(resultsPath, 'utf-8'))\n        for (const suite of (results.suites || [])) {\n          for (const spec of (suite.specs || [])) {\n            for (const test of (spec.tests || [])) {\n              if (test.status === 'expected') passed++\n              else if (test.status === 'unexpected') failed++\n              else if (test.status === 'skipped') _skipped++\n            }\n          }\n        }\n      } catch { /* ignore parse errors */ }\n    }\n\n    // Step 9: On failure, handle recordings\n    let uploadedId = ''\n    if (playwrightExit !== 0) {\n      const recordingsLogPath = join(process.env.HOME || '~', '.replay', 'recordings.log')\n      if (existsSync(recordingsLogPath)) {\n        const lines = readFileSync(recordingsLogPath, 'utf-8').split('\\n').filter(Boolean)\n        const recordings: Record<string, { id: string; duration?: number; result?: string; finished?: boolean }> = {}\n\n        for (const line of lines) {\n          try {\n            const entry = JSON.parse(line)\n            if (entry.kind === 'createRecording') {\n              recordings[entry.id] = { id: entry.id, duration: 0, finished: false }\n            } else if (entry.kind === 'writeFinished' && recordings[entry.id]) {\n              recordings[entry.id]!.finished = true\n            } else if (entry.kind === 'addMetadata' && recordings[entry.id]) {\n              const testResult = entry.metadata?.test?.result\n              if (testResult) recordings[entry.id]!.result = testResult\n              if (entry.metadata?.test?.duration) recordings[entry.id]!.duration = entry.metadata.test.duration\n            }\n          } catch { /* skip bad lines */ }\n        }\n\n        // Find failed recordings\n        const failedRecs = Object.values(recordings).filter(\n          r => r.finished && (r.result === 'failed' || r.result === 'timedOut')\n        )\n\n        log('\\n=== REPLAY RECORDINGS METADATA ===')\n        for (const r of Object.values(recordings)) {\n          log(JSON.stringify(r))\n        }\n        log('=== END REPLAY RECORDINGS METADATA ===')\n\n        if (failedRecs.length > 0) {\n          // Pick the longest duration one\n          failedRecs.sort((a, b) => (b.duration || 0) - (a.duration || 0))\n          const toUpload = failedRecs[0]!\n          log(`\\nUploading recording: ${toUpload.id}`)\n          try {\n            execSync(`npx replayio upload ${toUpload.id}`, {\n              cwd: appDir,\n              env: { ...process.env, RECORD_REPLAY_API_KEY },\n              stdio: ['ignore', 'pipe', 'pipe'],\n              timeout: 60000,\n            })\n            uploadedId = toUpload.id\n            log(`REPLAY UPLOADED: ${uploadedId}`)\n          } catch (ue: unknown) {\n            const uploadErr = ue as { status?: number }\n            log(`Upload failed with exit code: ${uploadErr.status}`)\n          }\n        }\n      }\n    }\n\n    // Clean up server\n    serverProc.kill('SIGTERM')\n\n    // Step 10: Print summary\n    writeFileSync(logPath, logContent)\n\n    let summary = ''\n    if (failed > 0) {\n      summary = `${passed} passed, ${failed} failed`\n      if (uploadedId) summary += ` (recording: ${uploadedId})`\n    } else if (passed > 0) {\n      summary = `${passed} passed`\n    } else {\n      summary = playwrightExit === 0 ? 'Tests completed' : 'Tests failed'\n    }\n    summary += ` — see logs/test-run-${logNum}.log`\n    console.log(summary)\n  } finally {\n    // Step 10: Clean up Neon branch\n    try {\n      await neonApi('DELETE', `/projects/${NEON_PROJECT_ID}/branches/${branchId}`)\n      log('Cleaned up test branch')\n    } catch { /* ignore */ }\n\n    // Remove local recordings\n    try { execSync('npx replayio remove --all 2>/dev/null || true', { cwd: appDir, stdio: 'ignore' }) } catch { /* ignore */ }\n\n    writeFileSync(logPath, logContent)\n  }\n\n  process.exit(playwrightExit)\n}\n\nmain().catch(e => {\n  console.error(e)\n  process.exit(1)\n})\n","numLines":303,"startLine":1,"totalLines":303}}}
