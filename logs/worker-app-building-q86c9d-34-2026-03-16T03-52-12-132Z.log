[2026-03-16T03:49:07.345Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01S46ArH1sBPLnf1xjGNxsCS","type":"tool_result","content":"     1→import { createSlice, createAsyncThunk } from '@reduxjs/toolkit'\n     2→\n     3→export interface UserReview {\n     4→  id: string\n     5→  booking_id: string\n     6→  property_id: string\n     7→  guest_id: string\n     8→  rating: number\n     9→  cleanliness: number\n    10→  accuracy: number\n    11→  communication: number\n    12→  location: number\n    13→  value: number\n    14→  comment: string | null\n    15→  created_at: string\n    16→  property_title: string\n    17→}\n    18→\n    19→interface UserReviewsState {\n    20→  items: UserReview[]\n    21→  loading: boolean\n    22→  error: string | null\n    23→}\n    24→\n    25→const initialState: UserReviewsState = {\n    26→  items: [],\n    27→  loading: false,\n    28→  error: null,\n    29→}\n    30→\n    31→export const fetchUserReviews = createAsyncThunk(\n    32→  'userReviews/fetchUserReviews',\n    33→  async (guestId: string, { rejectWithValue }) => {\n    34→    const response = await fetch(`/api/reviews?guest_id=${guestId}`)\n    35→    const data = await response.json()\n    36→    if (!response.ok) {\n    37→      return rejectWithValue(data.error || 'Failed to fetch reviews')\n    38→    }\n    39→    return data as UserReview[]\n    40→  }\n    41→)\n    42→\n    43→const userReviewsSlice = createSlice({\n    44→  name: 'userReviews',\n    45→  initialState,\n    46→  reducers: {},\n    47→  extraReducers: (builder) => {\n    48→    builder\n    49→      .addCase(fetchUserReviews.pending, (state) => {\n    50→        if (state.items.length === 0) {\n    51→          state.loading = true\n    52→        }\n    53→        state.error = null\n    54→      })\n    55→      .addCase(fetchUserReviews.fulfilled, (state, action) => {\n    56→        state.loading = false\n    57→        state.items = action.payload\n    58→      })\n    59→      .addCase(fetchUserReviews.rejected, (state, action) => {\n    60→        state.loading = false\n    61→        state.error = action.payload as string\n    62→      })\n    63→  },\n    64→})\n    65→\n    66→export default userReviewsSlice.reducer\n    67→"}]},"parent_tool_use_id":"toolu_01PDJUBRPMcJZBRtJxrp6ito","session_id":"d2015f33-7e41-4354-a03c-200e58f28506","uuid":"01b2ddf2-8920-4f35-996f-5e6dfdc0559f"}
