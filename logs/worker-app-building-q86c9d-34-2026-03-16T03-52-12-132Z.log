[2026-03-16T03:49:03.641Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GiY2nDJoXSDhpo1HZRFuvQ","type":"tool_result","content":"     1→import { useEffect } from 'react'\n     2→import { useNavigate } from 'react-router-dom'\n     3→import { useSelector, useDispatch } from 'react-redux'\n     4→import type { RootState, AppDispatch } from '../store'\n     5→import { fetchUserReviews } from '../slices/userReviewsSlice'\n     6→import ProfileForm from '../components/ProfileForm'\n     7→import BecomeHostButton from '../components/BecomeHostButton'\n     8→import UserReviewsList from '../components/UserReviewsList'\n     9→\n    10→export default function Profile() {\n    11→  const dispatch = useDispatch<AppDispatch>()\n    12→  const navigate = useNavigate()\n    13→  const { currentUser } = useSelector((state: RootState) => state.auth)\n    14→  const { items: reviews, loading: reviewsLoading } = useSelector((state: RootState) => state.userReviews)\n    15→\n    16→  useEffect(() => {\n    17→    if (!currentUser) {\n    18→      navigate('/login')\n    19→      return\n    20→    }\n    21→    dispatch(fetchUserReviews(currentUser.id))\n    22→  }, [currentUser, dispatch, navigate])\n    23→\n    24→  if (!currentUser) {\n    25→    return null\n    26→  }\n    27→\n    28→  return (\n    29→    <div className=\"max-w-[1120px] mx-auto px-6 max-sm:px-3 py-8\" data-testid=\"profile-page\">\n    30→      <div className=\"max-w-2xl\">\n    31→        <h1 className=\"text-[32px] font-bold text-text mb-8\">Personal info</h1>\n    32→\n    33→        <div className=\"rounded-xl border border-border p-6 mb-8\">\n    34→          <ProfileForm user={currentUser} />\n    35→        </div>\n    36→\n    37→        <div className=\"mb-8\">\n    38→          <BecomeHostButton userId={currentUser.id} isHost={currentUser.is_host} />\n    39→        </div>\n    40→\n    41→        <UserReviewsList reviews={reviews} loading={reviewsLoading} />\n    42→      </div>\n    43→    </div>\n    44→  )\n    45→}\n    46→"}]},"parent_tool_use_id":"toolu_01PDJUBRPMcJZBRtJxrp6ito","session_id":"d2015f33-7e41-4354-a03c-200e58f28506","uuid":"5cfc2293-4da0-4c13-aa17-0c882e0eefd4"}
