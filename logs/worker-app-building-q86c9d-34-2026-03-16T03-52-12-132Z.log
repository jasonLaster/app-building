[2026-03-16T03:49:03.825Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LWrzcAYZQTdEVWCppFe27P","type":"tool_result","content":"     1→import { useState, useEffect } from 'react'\n     2→import { useDispatch } from 'react-redux'\n     3→import { User, updateUser } from '../slices/authSlice'\n     4→import type { AppDispatch } from '../store'\n     5→import { User as UserIcon, Mail, Phone, FileText, Image, Check } from 'lucide-react'\n     6→\n     7→interface ProfileFormProps {\n     8→  user: User\n     9→}\n    10→\n    11→function isValidUrl(str: string): boolean {\n    12→  try {\n    13→    new URL(str)\n    14→    return true\n    15→  } catch {\n    16→    return false\n    17→  }\n    18→}\n    19→\n    20→export default function ProfileForm({ user }: ProfileFormProps) {\n    21→  const dispatch = useDispatch<AppDispatch>()\n    22→  const [name, setName] = useState(user.name)\n    23→  const [bio, setBio] = useState(user.bio || '')\n    24→  const [phone, setPhone] = useState(user.phone || '')\n    25→  const [avatarUrl, setAvatarUrl] = useState(user.avatar_url || '')\n    26→  const [saving, setSaving] = useState(false)\n    27→  const [successMessage, setSuccessMessage] = useState('')\n    28→  const [errors, setErrors] = useState<Record<string, string>>({})\n    29→\n    30→  useEffect(() => {\n    31→    setName(user.name)\n    32→    setBio(user.bio || '')\n    33→    setPhone(user.phone || '')\n    34→    setAvatarUrl(user.avatar_url || '')\n    35→  }, [user])\n    36→\n    37→  const handleSave = async () => {\n    38→    const newErrors: Record<string, string> = {}\n    39→\n    40→    if (!name.trim()) {\n    41→      newErrors.name = 'Name is required'\n    42→    }\n    43→    if (avatarUrl.trim() && !isValidUrl(avatarUrl.trim())) {\n    44→      newErrors.avatar_url = 'Please enter a valid URL'\n    45→    }\n    46→\n    47→    if (Object.keys(newErrors).length > 0) {\n    48→      setErrors(newErrors)\n    49→      setSuccessMessage('')\n    50→      return\n    51→    }\n    52→\n    53→    setErrors({})\n    54→    setSaving(true)\n    55→\n    56→    try {\n    57→      await dispatch(updateUser({\n    58→        id: user.id,\n    59→        name: name.trim(),\n    60→        bio: bio.trim() || null,\n    61→        phone: phone.trim() || null,\n    62→        avatar_url: avatarUrl.trim() || null,\n    63→      })).unwrap()\n    64→      setSuccessMessage('Profile updated')\n    65→      setTimeout(() => setSuccessMessage(''), 3000)\n    66→    } catch {\n    67→      setErrors({ form: 'Failed to update profile' })\n    68→    } finally {\n    69→      setSaving(false)\n    70→    }\n    71→  }\n    72→\n    73→  return (\n    74→    <div data-testid=\"profile-form\">\n    75→      {successMessage && (\n    76→        <div data-testid=\"profile-success-message\" className=\"flex items-center gap-2 mb-4 p-3 rounded-lg bg-success/10 text-success text-sm font-medium\">\n    77→          <Check size={16} />\n    78→          {successMessage}\n    79→        </div>\n    80→      )}\n    81→\n    82→      {errors.form && (\n    83→        <div data-testid=\"profile-error-message\" className=\"mb-4 p-3 rounded-lg bg-error/10 text-error text-sm font-medium\">\n    84→          {errors.form}\n    85→        </div>\n    86→      )}\n    87→\n    88→      <div className=\"flex items-center gap-4 mb-6\">\n    89→        <div className=\"w-20 h-20 rounded-full overflow-hidden bg-bg-secondary border border-border shrink-0\">\n    90→          {avatarUrl.trim() && isValidUrl(avatarUrl.trim()) ? (\n    91→            <img\n    92→              data-testid=\"avatar-preview\"\n    93→              src={avatarUrl.trim()}\n    94→              alt=\"Avatar preview\"\n    95→              className=\"w-full h-full object-cover\"\n    96→            />\n    97→          ) : (\n    98→            <div className=\"w-full h-full flex items-center justify-center text-text-secondary\">\n    99→              <UserIcon size={32} />\n   100→            </div>\n   101→          )}\n   102→        </div>\n   103→        <div>\n   104→          <h3 className=\"text-lg font-semibold text-text\">{user.name}</h3>\n   105→          <p className=\"text-sm text-text-secondary\">Member since {new Date(user.created_at.split('T')[0] + 'T12:00:00').toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}</p>\n   106→        </div>\n   107→      </div>\n   108→\n   109→      <div className=\"space-y-4\">\n   110→        <div>\n   111→          <label className=\"flex items-center gap-2 text-sm font-medium text-text-secondary mb-1.5\">\n   112→            <UserIcon size={14} />\n   113→            Name\n   114→          </label>\n   115→          <input\n   116→            data-testid=\"profile-name-input\"\n   117→            type=\"text\"\n   118→            value={name}\n   119→            onChange={(e) => setName(e.target.value)}\n   120→            className={`w-full px-3 py-2.5 rounded-lg border ${errors.name ? 'border-error' : 'border-border'} bg-bg text-text focus:outline-none focus:border-primary transition-colors`}\n   121→            placeholder=\"Your name\"\n   122→          />\n   123→          {errors.name && <p data-testid=\"name-error\" className=\"text-error text-xs mt-1\">{errors.name}</p>}\n   124→        </div>\n   125→\n   126→        <div>\n   127→          <label className=\"flex items-center gap-2 text-sm font-medium text-text-secondary mb-1.5\">\n   128→            <Mail size={14} />\n   129→            Email\n   130→          </label>\n   131→          <input\n   132→            data-testid=\"profile-email-input\"\n   133→            type=\"email\"\n   134→            value={user.email}\n   135→            readOnly\n   136→            disabled\n   137→            className=\"w-full px-3 py-2.5 rounded-lg border border-border bg-bg-secondary text-text-secondary cursor-not-allowed\"\n   138→          />\n   139→        </div>\n   140→\n   141→        <div>\n   142→          <label className=\"flex items-center gap-2 text-sm font-medium text-text-secondary mb-1.5\">\n   143→            <FileText size={14} />\n   144→            Bio\n   145→          </label>\n   146→          <textarea\n   147→            data-testid=\"profile-bio-input\"\n   148→            value={bio}\n   149→            onChange={(e) => setBio(e.target.value)}\n   150→            rows={3}\n   151→            className=\"w-full px-3 py-2.5 rounded-lg border border-border bg-bg text-text focus:outline-none focus:border-primary transition-colors resize-none\"\n   152→            placeholder=\"Tell us about yourself\"\n   153→          />\n   154→        </div>\n   155→\n   156→        <div>\n   157→          <label className=\"flex items-center gap-2 text-sm font-medium text-text-secondary mb-1.5\">\n   158→            <Phone size={14} />\n   159→            Phone\n   160→          </label>\n   161→          <input\n   162→            data-testid=\"profile-phone-input\"\n   163→            type=\"text\"\n   164→            value={phone}\n   165→            onChange={(e) => setPhone(e.target.value)}\n   166→            className=\"w-full px-3 py-2.5 rounded-lg border border-border bg-bg text-text focus:outline-none focus:border-primary transition-colors\"\n   167→            placeholder=\"Phone number\"\n   168→          />\n   169→        </div>\n   170→\n   171→        <div>\n   172→          <label className=\"flex items-center gap-2 text-sm font-medium text-text-secondary mb-1.5\">\n   173→            <Image size={14} />\n   174→            Avatar URL\n   175→          </label>\n   176→          <input\n   177→            data-testid=\"profile-avatar-input\"\n   178→            type=\"text\"\n   179→            value={avatarUrl}\n   180→            onChange={(e) => setAvatarUrl(e.target.value)}\n   181→            className={`w-full px-3 py-2.5 rounded-lg border ${errors.avatar_url ? 'border-error' : 'border-border'} bg-bg text-text focus:outline-none focus:border-primary transition-colors`}\n   182→            placeholder=\"https://example.com/avatar.jpg\"\n   183→          />\n   184→          {errors.avatar_url && <p data-testid=\"avatar-url-error\" className=\"text-error text-xs mt-1\">{errors.avatar_url}</p>}\n   185→        </div>\n   186→      </div>\n   187→\n   188→      <button\n   189→        data-testid=\"profile-save-button\"\n   190→        onClick={handleSave}\n   191→        disabled={saving}\n   192→        className=\"mt-6 w-full py-3 rounded-lg bg-primary text-white font-semibold hover:bg-primary-dark transition-colors disabled:opacity-50\"\n   193→      >\n   194→        {saving ? 'Saving...' : 'Save'}\n   195→      </button>\n   196→    </div>\n   197→  )\n   198→}\n   199→"}]},"parent_tool_use_id":"toolu_01PDJUBRPMcJZBRtJxrp6ito","session_id":"d2015f33-7e41-4354-a03c-200e58f28506","uuid":"5274c992-0e59-48dd-9099-7c50fb4f075a"}
