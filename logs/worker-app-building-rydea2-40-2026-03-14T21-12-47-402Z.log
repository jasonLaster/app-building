[2026-03-14T21:11:02.543Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DZKkMiBiLKjzsc2S6hRNHZ","type":"tool_result","content":"     1→import { createSlice, createAsyncThunk } from '@reduxjs/toolkit';\n     2→\n     3→export interface Notification {\n     4→  id: string;\n     5→  type: 'assignment' | 'update' | 'mention';\n     6→  issue_id: string;\n     7→  description: string;\n     8→  read: boolean;\n     9→  archived: boolean;\n    10→  created_at: string;\n    11→  issue_identifier: string;\n    12→  issue_title: string;\n    13→}\n    14→\n    15→interface NotificationsState {\n    16→  unreadCount: number;\n    17→  items: Notification[];\n    18→  loading: boolean;\n    19→}\n    20→\n    21→const initialState: NotificationsState = {\n    22→  unreadCount: 0,\n    23→  items: [],\n    24→  loading: false,\n    25→};\n    26→\n    27→export const fetchUnreadCount = createAsyncThunk(\n    28→  'notifications/fetchUnreadCount',\n    29→  async (_, { getState, rejectWithValue }) => {\n    30→    const state = getState() as { auth: { token: string | null } };\n    31→    const token = state.auth.token;\n    32→    if (!token) return rejectWithValue('No token');\n    33→    const response = await fetch('/api/notifications-count', {\n    34→      headers: { Authorization: `Bearer ${token}` },\n    35→    });\n    36→    if (!response.ok) {\n    37→      return rejectWithValue('Failed to fetch notifications');\n    38→    }\n    39→    const data = await response.json();\n    40→    return data.count as number;\n    41→  }\n    42→);\n    43→\n    44→export const fetchNotifications = createAsyncThunk(\n    45→  'notifications/fetchNotifications',\n    46→  async (_, { getState, rejectWithValue }) => {\n    47→    const state = getState() as { auth: { token: string | null } };\n    48→    const token = state.auth.token;\n    49→    if (!token) return rejectWithValue('No token');\n    50→    const response = await fetch('/api/notifications', {\n    51→      headers: { Authorization: `Bearer ${token}` },\n    52→    });\n    53→    if (!response.ok) {\n    54→      return rejectWithValue('Failed to fetch notifications');\n    55→    }\n    56→    const data = await response.json();\n    57→    return data.notifications as Notification[];\n    58→  }\n    59→);\n    60→\n    61→export const markNotificationRead = createAsyncThunk(\n    62→  'notifications/markRead',\n    63→  async (notificationId: string, { getState, rejectWithValue }) => {\n    64→    const state = getState() as { auth: { token: string | null } };\n    65→    const token = state.auth.token;\n    66→    if (!token) return rejectWithValue('No token');\n    67→    const response = await fetch(`/api/notifications/${notificationId}/read`, {\n    68→      method: 'PUT',\n    69→      headers: { Authorization: `Bearer ${token}` },\n    70→    });\n    71→    if (!response.ok) {\n    72→      return rejectWithValue('Failed to mark as read');\n    73→    }\n    74→    return notificationId;\n    75→  }\n    76→);\n    77→\n    78→export const archiveNotification = createAsyncThunk(\n    79→  'notifications/archive',\n    80→  async (notificationId: string, { getState, rejectWithValue }) => {\n    81→    const state = getState() as { auth: { token: string | null } };\n    82→    const token = state.auth.token;\n    83→    if (!token) return rejectWithValue('No token');\n    84→    const response = await fetch(`/api/notifications/${notificationId}/archive`, {\n    85→      method: 'PUT',\n    86→      headers: { Authorization: `Bearer ${token}` },\n    87→    });\n    88→    if (!response.ok) {\n    89→      return rejectWithValue('Failed to archive notification');\n    90→    }\n    91→    return notificationId;\n    92→  }\n    93→);\n    94→\n    95→const notificationsSlice = createSlice({\n    96→  name: 'notifications',\n    97→  initialState,\n    98→  reducers: {\n    99→    decrementUnreadCount(state) {\n   100→      if (state.unreadCount > 0) {\n   101→        state.unreadCount -= 1;\n   102→      }\n   103→    },\n   104→    setUnreadCount(state, action) {\n   105→      state.unreadCount = action.payload;\n   106→    },\n   107→  },\n   108→  extraReducers: (builder) => {\n   109→    builder\n   110→      .addCase(fetchUnreadCount.fulfilled, (state, action) => {\n   111→        state.unreadCount = action.payload;\n   112→      })\n   113→      .addCase(fetchNotifications.pending, (state) => {\n   114→        if (state.items.length === 0) {\n   115→          state.loading = true;\n   116→        }\n   117→      })\n   118→      .addCase(fetchNotifications.fulfilled, (state, action) => {\n   119→        state.loading = false;\n   120→        state.items = action.payload;\n   121→        state.unreadCount = action.payload.filter((n) => !n.read).length;\n   122→      })\n   123→      .addCase(fetchNotifications.rejected, (state) => {\n   124→        state.loading = false;\n   125→      })\n   126→      .addCase(markNotificationRead.fulfilled, (state, action) => {\n   127→        const notification = state.items.find((n) => n.id === action.payload);\n   128→        if (notification && !notification.read) {\n   129→          notification.read = true;\n   130→          state.unreadCount = Math.max(0, state.unreadCount - 1);\n   131→        }\n   132→      })\n   133→      .addCase(archiveNotification.fulfilled, (state, action) => {\n   134→        const notification = state.items.find((n) => n.id === action.payload);\n   135→        if (notification && !notification.read) {\n   136→          state.unreadCount = Math.max(0, state.unreadCount - 1);\n   137→        }\n   138→        state.items = state.items.filter((n) => n.id !== action.payload);\n   139→      });\n   140→  },\n   141→});\n   142→\n   143→export const { decrementUnreadCount, setUnreadCount } = notificationsSlice.actions;\n   144→export default notificationsSlice.reducer;\n   145→"}]},"parent_tool_use_id":"toolu_018WWq7zXkHJAu1SUeGgHdW6","session_id":"7feafea7-a64a-4b51-bd68-f1d9a8576d81","uuid":"59393358-4d88-4752-9e83-7c2ecdcb3490"}
