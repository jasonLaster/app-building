[2026-03-14T19:27:00.586Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01A5C5p4qunQSZmJVvc8Hi8E","type":"tool_result","content":"     1→import { createSlice, createAsyncThunk, type PayloadAction } from '@reduxjs/toolkit'\n     2→\n     3→export interface Airport {\n     4→  id: string\n     5→  iata_code: string\n     6→  name: string\n     7→  city: string\n     8→  country: string\n     9→  latitude?: number\n    10→  longitude?: number\n    11→}\n    12→\n    13→export interface RecentSearch {\n    14→  id: string\n    15→  origin_code: string\n    16→  origin_name: string\n    17→  origin_city: string\n    18→  dest_code: string\n    19→  dest_name: string\n    20→  dest_city: string\n    21→  departure_date: string\n    22→  return_date: string | null\n    23→  passengers_adults: number\n    24→  passengers_children: number\n    25→  passengers_infants: number\n    26→  cabin_class: string\n    27→  trip_type: string\n    28→  searched_at: string\n    29→}\n    30→\n    31→export interface PopularDestination {\n    32→  id: string\n    33→  iata_code: string\n    34→  city: string\n    35→  country: string\n    36→  gradient: string\n    37→  min_price: number | null\n    38→}\n    39→\n    40→export type TripType = 'round_trip' | 'one_way' | 'multi_city'\n    41→export type CabinClass = 'economy' | 'premium_economy' | 'business' | 'first'\n    42→\n    43→interface SearchState {\n    44→  tripType: TripType\n    45→  passengers: {\n    46→    adults: number\n    47→    children: number\n    48→    infants: number\n    49→  }\n    50→  cabinClass: CabinClass\n    51→  origin: Airport | null\n    52→  destination: Airport | null\n    53→  departureDate: string | null\n    54→  returnDate: string | null\n    55→  recentSearches: RecentSearch[]\n    56→  recentSearchesLoading: boolean\n    57→  popularDestinations: PopularDestination[]\n    58→  popularDestinationsLoading: boolean\n    59→  sessionToken: string\n    60→  validationErrors: Record<string, string>\n    61→}\n    62→\n    63→function getOrCreateSessionToken(): string {\n    64→  const key = 'gf_session_token'\n    65→  let token = localStorage.getItem(key)\n    66→  if (!token) {\n    67→    token = crypto.randomUUID()\n    68→    localStorage.setItem(key, token)\n    69→  }\n    70→  return token\n    71→}\n    72→\n    73→const initialState: SearchState = {\n    74→  tripType: 'round_trip',\n    75→  passengers: { adults: 1, children: 0, infants: 0 },\n    76→  cabinClass: 'economy',\n    77→  origin: null,\n    78→  destination: null,\n    79→  departureDate: null,\n    80→  returnDate: null,\n    81→  recentSearches: [],\n    82→  recentSearchesLoading: false,\n    83→  popularDestinations: [],\n    84→  popularDestinationsLoading: false,\n    85→  sessionToken: typeof window !== 'undefined' ? getOrCreateSessionToken() : '',\n    86→  validationErrors: {},\n    87→}\n    88→\n    89→export const fetchRecentSearches = createAsyncThunk(\n    90→  'search/fetchRecentSearches',\n    91→  async (sessionToken: string) => {\n    92→    const res = await fetch(`/api/recent-searches?session=${encodeURIComponent(sessionToken)}`)\n    93→    return res.json() as Promise<RecentSearch[]>\n    94→  }\n    95→)\n    96→\n    97→export const saveRecentSearch = createAsyncThunk(\n    98→  'search/saveRecentSearch',\n    99→  async (params: {\n   100→    sessionToken: string\n   101→    originCode: string\n   102→    destCode: string\n   103→    departureDate: string\n   104→    returnDate: string | null\n   105→    adults: number\n   106→    children: number\n   107→    infants: number\n   108→    cabinClass: string\n   109→    tripType: string\n   110→  }) => {\n   111→    await fetch('/api/recent-searches', {\n   112→      method: 'POST',\n   113→      headers: { 'Content-Type': 'application/json' },\n   114→      body: JSON.stringify(params),\n   115→    })\n   116→  }\n   117→)\n   118→\n   119→export const fetchPopularDestinations = createAsyncThunk(\n   120→  'search/fetchPopularDestinations',\n   121→  async () => {\n   122→    const res = await fetch('/api/popular-destinations')\n   123→    return res.json() as Promise<PopularDestination[]>\n   124→  }\n   125→)\n   126→\n   127→const searchSlice = createSlice({\n   128→  name: 'search',\n   129→  initialState,\n   130→  reducers: {\n   131→    setTripType(state, action: PayloadAction<TripType>) {\n   132→      state.tripType = action.payload\n   133→      if (action.payload === 'one_way') {\n   134→        state.returnDate = null\n   135→      }\n   136→    },\n   137→    setPassengers(state, action: PayloadAction<{ adults: number; children: number; infants: number }>) {\n   138→      state.passengers = action.payload\n   139→    },\n   140→    setCabinClass(state, action: PayloadAction<CabinClass>) {\n   141→      state.cabinClass = action.payload\n   142→    },\n   143→    setOrigin(state, action: PayloadAction<Airport | null>) {\n   144→      state.origin = action.payload\n   145→      delete state.validationErrors['origin']\n   146→    },\n   147→    setDestination(state, action: PayloadAction<Airport | null>) {\n   148→      state.destination = action.payload\n   149→      delete state.validationErrors['destination']\n   150→    },\n   151→    swapAirports(state) {\n   152→      const temp = state.origin\n   153→      state.origin = state.destination\n   154→      state.destination = temp\n   155→    },\n   156→    setDepartureDate(state, action: PayloadAction<string | null>) {\n   157→      state.departureDate = action.payload\n   158→      delete state.validationErrors['departureDate']\n   159→    },\n   160→    setReturnDate(state, action: PayloadAction<string | null>) {\n   161→      state.returnDate = action.payload\n   162→      delete state.validationErrors['returnDate']\n   163→    },\n   164→    setValidationErrors(state, action: PayloadAction<Record<string, string>>) {\n   165→      state.validationErrors = action.payload\n   166→    },\n   167→    clearValidationErrors(state) {\n   168→      state.validationErrors = {}\n   169→    },\n   170→  },\n   171→  extraReducers: (builder) => {\n   172→    builder\n   173→      .addCase(fetchRecentSearches.pending, (state) => {\n   174→        if (state.recentSearches.length === 0) {\n   175→          state.recentSearchesLoading = true\n   176→        }\n   177→      })\n   178→      .addCase(fetchRecentSearches.fulfilled, (state, action) => {\n   179→        state.recentSearches = action.payload\n   180→        state.recentSearchesLoading = false\n   181→      })\n   182→      .addCase(fetchRecentSearches.rejected, (state) => {\n   183→        state.recentSearchesLoading = false\n   184→      })\n   185→      .addCase(fetchPopularDestinations.pending, (state) => {\n   186→        if (state.popularDestinations.length === 0) {\n   187→          state.popularDestinationsLoading = true\n   188→        }\n   189→      })\n   190→      .addCase(fetchPopularDestinations.fulfilled, (state, action) => {\n   191→        state.popularDestinations = action.payload\n   192→        state.popularDestinationsLoading = false\n   193→      })\n   194→      .addCase(fetchPopularDestinations.rejected, (state) => {\n   195→        state.popularDestinationsLoading = false\n   196→      })\n   197→  },\n   198→})\n   199→\n   200→export const {\n   201→  setTripType,\n   202→  setPassengers,\n   203→  setCabinClass,\n   204→  setOrigin,\n   205→  setDestination,\n   206→  swapAirports,\n   207→  setDepartureDate,\n   208→  setReturnDate,\n   209→  setValidationErrors,\n   210→  clearValidationErrors,\n   211→} = searchSlice.actions\n   212→\n   213→export default searchSlice.reducer\n   214→"}]},"parent_tool_use_id":"toolu_01RKSMZeMuvbJBPNHcEBrpFF","session_id":"9e060c47-3db7-484c-89af-8f76629d5d6b","uuid":"91a39303-426c-4c56-9fe0-eba2e954a671"}
