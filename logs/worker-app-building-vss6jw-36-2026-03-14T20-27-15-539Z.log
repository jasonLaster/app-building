erty.host_since && (\n            <p className=\"text-text-secondary text-sm flex items-center gap-1 mt-1\">\n              <Shield size={14} />\n              Member since {formatMemberSince(property.host_since)}\n            </p>\n          )}\n          <div className=\"flex items-center gap-1 text-text-secondary text-sm mt-1\">\n            <Home size={14} />\n            <span>{listingCount} {listingCount === 1 ? 'listing' : 'listings'}</span>\n          </div>\n          {property.host_bio && (\n            <p className=\"text-text-secondary text-sm mt-3 leading-relaxed\">{property.host_bio}</p>\n          )}\n        </div>\n      </div>\n    </div>\n  )\n}\n","structuredPatch":[{"oldStart":14,"oldLines":7,"newStart":14,"newLines":7,"lines":["   const listingCount = property.host_listing_count || 0"," ","   return (","-    <div data-testid=\"host-info-card\" className=\"py-6\">","+    <div id=\"host-info-card\" data-testid=\"host-info-card\" className=\"py-6\">","       <h2 className=\"text-lg font-semibold text-text mb-4\">Meet your host</h2>","       <div className=\"flex items-start gap-4\">","         <div className=\"shrink-0\">"]}],"userModified":false,"replaceAll":false}}
