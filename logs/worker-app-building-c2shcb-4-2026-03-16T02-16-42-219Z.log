console.error('Fetch notifications count error:', err);\n    50→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n    51→      status: 500,\n    52→      headers: { 'Content-Type': 'application/json' },\n    53→    });\n    54→  }\n    55→}\n    56→"}]},"parent_tool_use_id":null,"session_id":"1e17ab70-0a33-4d2a-af23-66b102e400e2","uuid":"a4906aaf-7198-4a4e-b6e9-2cbfd4ed6fa4","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/netlify/functions/notifications-count.ts","content":"import type { Context } from '@netlify/functions';\nimport { getSql } from './db';\n\nexport default async function handler(req: Request, _context: Context) {\n  if (req.method !== 'GET') {\n    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n      status: 405,\n      headers: { 'Content-Type': 'application/json' },\n    });\n  }\n\n  try {\n    const authHeader = req.headers.get('Authorization');\n    if (!authHeader?.startsWith('Bearer ')) {\n      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n        status: 401,\n        headers: { 'Content-Type': 'application/json' },\n      });\n    }\n\n    const token = authHeader.slice(7);\n    const sql = getSql();\n\n    const sessions = await sql`\n      SELECT s.member_id FROM sessions s\n      WHERE s.token = ${token} AND s.expires_at > NOW()\n    `;\n    const session = sessions[0];\n    if (!session) {\n      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n        status: 401,\n        headers: { 'Content-Type': 'application/json' },\n      });\n    }\n\n    const result = await sql`\n      SELECT COUNT(*)::int AS count\n      FROM notifications\n      WHERE member_id = ${session.member_id} AND read = false AND archived = false\n    `;\n    const row = result[0];\n    const count = row ? row.count : 0;\n\n    return new Response(JSON.stringify({ count }), {\n      status: 200,\n      headers: { 'Content-Type': 'application/json' },\n    });\n  } catch (err) {\n    console.error('Fetch notifications count error:', err);\n    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n      status: 500,\n      headers: { 'Content-Type': 'application/json' },\n    });\n  }\n}\n","numLines":56,"startLine":1,"totalLines":56}}}
