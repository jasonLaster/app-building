[2026-03-16T01:56:53.182Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RmKF4425LuyRY9Q6Y1NezT","type":"tool_result","content":"     1→import { useState, useEffect, useCallback } from 'react';\n     2→import { useSelector, useDispatch } from 'react-redux';\n     3→import { useNavigate, useParams } from 'react-router-dom';\n     4→import type { RootState, AppDispatch } from '../store';\n     5→import { closeCreateIssueModal } from '../slices/uiSlice';\n     6→import { createIssue } from '../slices/issuesSlice';\n     7→import { fetchTeamIssues } from '../slices/teamIssuesSlice';\n     8→import { fetchIssueDetail } from '../slices/issueDetailSlice';\n     9→import CreateIssueForm from './CreateIssueForm';\n    10→import type { CreateIssueFormData } from './CreateIssueForm';\n    11→import CreateIssueActions from './CreateIssueActions';\n    12→import './CreateIssueModal.css';\n    13→\n    14→const INITIAL_FORM_DATA: CreateIssueFormData = {\n    15→  teamId: '',\n    16→  title: '',\n    17→  description: '',\n    18→  status: 'backlog',\n    19→  priority: 'none',\n    20→  assigneeId: null,\n    21→  labelIds: [],\n    22→  projectId: null,\n    23→  cycleId: null,\n    24→  dueDate: null,\n    25→  parentId: null,\n    26→};\n    27→\n    28→export default function CreateIssueModal() {\n    29→  const dispatch = useDispatch<AppDispatch>();\n    30→  const navigate = useNavigate();\n    31→  const params = useParams<{ teamId?: string }>();\n    32→  const { createIssueModalOpen, createIssueDefaultParentId, createIssueDefaultTeamId } = useSelector((state: RootState) => state.ui);\n    33→  const { workspace } = useSelector((state: RootState) => state.workspace);\n    34→\n    35→  const [formData, setFormData] = useState<CreateIssueFormData>({ ...INITIAL_FORM_DATA });\n    36→  const [titleError, setTitleError] = useState<string | null>(null);\n    37→  const [submitting, setSubmitting] = useState(false);\n    38→  const [createdIdentifier, setCreatedIdentifier] = useState<string | null>(null);\n    39→\n    40→  // Reset form when modal opens\n    41→  useEffect(() => {\n    42→    if (createIssueModalOpen) {\n    43→      setFormData({\n    44→        ...INITIAL_FORM_DATA,\n    45→        parentId: createIssueDefaultParentId || null,\n    46→        teamId: createIssueDefaultTeamId || '',\n    47→      });\n    48→      setTitleError(null);\n    49→      setSubmitting(false);\n    50→      setCreatedIdentifier(null);\n    51→    }\n    52→  }, [createIssueModalOpen, createIssueDefaultParentId, createIssueDefaultTeamId]);\n    53→\n    54→  const handleClose = useCallback(() => {\n    55→    dispatch(closeCreateIssueModal());\n    56→  }, [dispatch]);\n    57→\n    58→  // Handle Escape key\n    59→  useEffect(() => {\n    60→    if (!createIssueModalOpen) return;\n    61→    function handleKeyDown(e: KeyboardEvent) {\n    62→      if (e.key === 'Escape') {\n    63→        handleClose();\n    64→      }\n    65→    }\n    66→    document.addEventListener('keydown', handleKeyDown);\n    67→    return () => document.removeEventListener('keydown', handleKeyDown);\n    68→  }, [createIssueModalOpen, handleClose]);\n    69→\n    70→  async function handleSubmit() {\n    71→    if (!formData.title.trim()) {\n    72→      setTitleError('Title is required');\n    73→      return;\n    74→    }\n    75→    setTitleError(null);\n    76→    setSubmitting(true);\n    77→\n    78→    try {\n    79→      const result = await dispatch(createIssue({\n    80→        teamId: formData.teamId,\n    81→        title: formData.title.trim(),\n    82→        description: formData.description,\n    83→        status: formData.status,\n    84→        priority: formData.priority,\n    85→        assigneeId: formData.assigneeId,\n    86→        labelIds: formData.labelIds,\n    87→        projectId: formData.projectId,\n    88→        cycleId: formData.cycleId,\n    89→        dueDate: formData.dueDate,\n    90→        parentId: formData.parentId,\n    91→      })).unwrap();\n    92→\n    93→      // Show created identifier briefly\n    94→      setCreatedIdentifier(result.identifier);\n    95→\n    96→      // Refetch team issues if on a team page\n    97→      if (formData.teamId) {\n    98→        dispatch(fetchTeamIssues(formData.teamId));\n    99→      }\n   100→\n   101→      // Refetch issue detail if this was a sub-issue creation\n   102→      if (formData.parentId) {\n   103→        dispatch(fetchIssueDetail(formData.parentId));\n   104→      }\n   105→\n   106→      // Close after a brief delay to show identifier\n   107→      setTimeout(() => {\n   108→        dispatch(closeCreateIssueModal());\n   109→        // Navigate to team issues if we have a team and not on issue detail\n   110→        if (formData.teamId && !params.teamId && !formData.parentId) {\n   111→          navigate(`/team/${formData.teamId}/issues`);\n   112→        }\n   113→      }, 1500);\n   114→    } catch {\n   115→      setSubmitting(false);\n   116→    }\n   117→  }\n   118→\n   119→  function handleCancel() {\n   120→    handleClose();\n   121→  }\n   122→\n   123→  function handleOverlayClick(e: React.MouseEvent) {\n   124→    if (e.target === e.currentTarget) {\n   125→      handleClose();\n   126→    }\n   127→  }\n   128→\n   129→  if (!createIssueModalOpen) return null;\n   130→\n   131→  return (\n   132→    <div\n   133→      className=\"create-issue-overlay\"\n   134→      onClick={handleOverlayClick}\n   135→      data-testid=\"create-issue-modal-overlay\"\n   136→    >\n   137→      <div className=\"create-issue-modal\" data-testid=\"create-issue-modal\">\n   138→        <div className=\"cim-header\">\n   139→          <h2 className=\"cim-title\">Create Issue</h2>\n   140→        </div>\n   141→\n   142→        {createdIdentifier ? (\n   143→          <div className=\"cim-success\" data-testid=\"create-issue-success\">\n   144→            <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--color-status-done)\" strokeWidth=\"2\">\n   145→              <circle cx=\"12\" cy=\"12\" r=\"10\" />\n   146→              <path d=\"M8 12l3 3 5-5\" />\n   147→            </svg>\n   148→            <span>Created <strong>{createdIdentifier}</strong></span>\n   149→          </div>\n   150→        ) : (\n   151→          <>\n   152→            <div className=\"cim-body\">\n   153→              <CreateIssueForm\n   154→                defaultTeamId={params.teamId || workspace?.default_team_id || undefined}\n   155→                formData={formData}\n   156→                onFormChange={setFormData}\n   157→                titleError={titleError}\n   158→              />\n   159→            </div>\n   160→            <div className=\"cim-footer\">\n   161→              <CreateIssueActions\n   162→                onSubmit={handleSubmit}\n   163→                onCancel={handleCancel}\n   164→                submitting={submitting}\n   165→              />\n   166→            </div>\n   167→          </>\n   168→        )}\n   169→      </div>\n   170→    </div>\n   171→  );\n   172→}\n   173→"}]},"parent_tool_use_id":"toolu_01QyWc7QHB8fZMZKWySD58UN","session_id":"1e17ab70-0a33-4d2a-af23-66b102e400e2","uuid":"8180f133-8f72-4810-b2b9-015b67e3874e"}
