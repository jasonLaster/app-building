lassName=\"cif-label\">Cycle</label>\n   480→        <div className=\"cif-dropdown-wrapper\">\n   481→          <button\n   482→            className=\"cif-select-btn\"\n   483→            onClick={() => toggleDropdown('cycle')}\n   484→            data-testid=\"create-issue-cycle-selector\"\n   485→          >\n   486→            <span className={selectedCycle ? '' : 'cif-placeholder'}>\n   487→              {selectedCycle ? selectedCycle.name : 'No cycle'}\n   488→            </span>\n   489→            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n   490→          </button>\n   491→          {openDropdown === 'cycle' && (\n   492→            <div className=\"cif-dropdown\" data-testid=\"create-issue-cycle-dropdown\">\n   493→              <button\n   494→                className=\"cif-dropdown-option\"\n   495→                onClick={() => { updateField('cycleId', null); setOpenDropdown(null); }}\n   496→                data-testid=\"create-issue-cycle-option-none\"\n   497→              >\n   498→                <span>No cycle</span>\n   499→              </button>\n   500→              {teamCycles.map((c) => {\n   501→                const now = new Date();\n   502→                const start = new Date(c.start_date);\n   503→                const end = new Date(c.end_date);\n   504→                const isActive = now >= start && now <= end;\n   505→                return (\n   506→                  <button\n   507→                    key={c.id}\n   508→                    className={`cif-dropdown-option ${formData.cycleId === c.id ? 'cif-dropdown-option-active' : ''}`}\n   509→                    onClick={() => { updateField('cycleId', c.id); setOpenDropdown(null); }}\n   510→                    data-testid={`create-issue-cycle-option-${c.id}`}\n   511→                  >\n   512→                    <span>{c.name}</span>\n   513→                    {isActive && <span className=\"cif-active-badge\">Active</span>}\n   514→                  </button>\n   515→                );\n   516→              })}\n   517→              {teamCycles.length === 0 && (\n   518→                <div className=\"cif-dropdown-empty\">No cycles available</div>\n   519→              )}\n   520→            </div>\n   521→          )}\n   522→        </div>\n   523→      </div>\n   524→\n   525→      {/* Due Date */}\n   526→      <div className=\"cif-field\" data-testid=\"create-issue-due-date-field\">\n   527→        <label className=\"cif-label\">Due date</label>\n   528→        <div className=\"cif-date-wrapper\">\n   529→          <input\n   530→            type=\"date\"\n   531→            className=\"cif-date-input\"\n   532→            value={formData.dueDate || ''}\n   533→            onChange={(e) => updateField('dueDate', e.target.value || null)}\n   534→            data-testid=\"create-issue-due-date-input\"\n   535→          />\n   536→          {formData.dueDate && (\n   537→            <div className=\"cif-date-display\">\n   538→              <span data-testid=\"create-issue-due-date-display\">{formatDueDisplay(formData.dueDate)}</span>\n   539→              <button\n   540→                className=\"cif-date-clear\"\n   541→                onClick={() => updateField('dueDate', null)}\n   542→                data-testid=\"create-issue-due-date-clear\"\n   543→              >\n   544→                &times;\n   545→              </button>\n   546→            </div>\n   547→          )}\n   548→        </div>\n   549→      </div>\n   550→\n   551→      {/* Parent Issue */}\n   552→      <div className=\"cif-field\" data-testid=\"create-issue-parent-field\">\n   553→        <label className=\"cif-label\">Parent issue</label>\n   554→        <div className=\"cif-dropdown-wrapper\">\n   555→          <button\n   556→            className=\"cif-select-btn\"\n   557→            onClick={() => toggleDropdown('parent')}\n   558→            data-testid=\"create-issue-parent-selector\"\n   559→          >\n   560→            <span className={selectedParent || formData.parentId ? '' : 'cif-placeholder'}>\n   561→              {selectedParent ? `${selectedParent.identifier}: ${selectedParent.title}` : formData.parentId ? 'Loading...' : 'No parent issue'}\n   562→            </span>\n   563→            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n   564→          </button>\n   565→          {openDropdown === 'parent' && (\n   566→            <div className=\"cif-dropdown cif-dropdown-searchable\" data-testid=\"create-issue-parent-dropdown\">\n   567→              <input\n   568→                className=\"cif-search-input\"\n   569→                placeholder=\"Search issues...\"\n   570→                value={parentSearch}\n   571→                onChange={(e) => setParentSearch(e.target.value)}\n   572→                autoFocus\n   573→                data-testid=\"create-issue-parent-search\"\n   574→              />\n   575→              <button\n   576→                className=\"cif-dropdown-option\"\n   577→                onClick={() => { updateField('parentId', null); setOpenDropdown(null); }}\n   578→                data-testid=\"create-issue-parent-option-none\"\n   579→              >\n   580→                <span>No parent issue</span>\n   581→              </button>\n   582→              {filteredParents.map((issue) => (\n   583→                <button\n   584→                  key={issue.id}\n   585→                  className={`cif-dropdown-option ${formData.parentId === issue.id ? 'cif-dropdown-option-active' : ''}`}\n   586→                  onClick={() => { updateField('parentId', issue.id); setOpenDropdown(null); }}\n   587→                  data-testid={`create-issue-parent-option-${issue.id}`}\n   588→                >\n   589→                  <span className=\"cif-parent-identifier\">{issue.identifier}</span>\n   590→                  <span>{issue.title}</span>\n   591→                </button>\n   592→              ))}\n   593→              {filteredParents.length === 0 && parentSearch && (\n   594→                <div className=\"cif-dropdown-empty\">No issues found</div>\n   595→              )}\n   596→            </div>\n   597→          )}\n   598→        </div>\n   599→      </div>\n   600→    </div>\n   601→  );\n   602→}\n   603→"}]},"parent_tool_use_id":"toolu_01Bjh7s4r2SZg4SRnjxrnAnw","session_id":"1e17ab70-0a33-4d2a-af23-66b102e400e2","uuid":"84992eba-b260-4751-b08f-c178eefc30bd"}
