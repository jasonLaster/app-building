[2026-03-16T01:45:05.781Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PBjY59FnjrGXiw8GeEhDgG","type":"tool_result","content":"     1→import { execSync, spawn } from 'child_process'\n     2→import { writeFileSync, readFileSync, mkdirSync, readdirSync, existsSync } from 'fs'\n     3→import { join } from 'path'\n     4→import { initSchema } from './schema.js'\n     5→import { seedDatabase, resetDatabase } from './seed-db.js'\n     6→\n     7→const appDir = join(import.meta.dirname, '..')\n     8→const logsDir = join(appDir, 'logs')\n     9→\n    10→function getEnvVar(name: string): string {\n    11→  const val = process.env[name]\n    12→  if (!val) {\n    13→    console.error(`Missing required environment variable: ${name}`)\n    14→    process.exit(1)\n    15→  }\n    16→  return val\n    17→}\n    18→\n    19→function loadDotEnv(): void {\n    20→  const envPath = join(appDir, '.env')\n    21→  if (!existsSync(envPath)) return\n    22→  const lines = readFileSync(envPath, 'utf-8').split('\\n')\n    23→  for (const line of lines) {\n    24→    const trimmed = line.trim()\n    25→    if (!trimmed || trimmed.startsWith('#')) continue\n    26→    const eqIdx = trimmed.indexOf('=')\n    27→    if (eqIdx === -1) continue\n    28→    const key = trimmed.slice(0, eqIdx).trim()\n    29→    const value = trimmed.slice(eqIdx + 1).trim().replace(/^[\"']|[\"']$/g, '')\n    30→    if (!process.env[key]) {\n    31→      process.env[key] = value\n    32→    }\n    33→  }\n    34→}\n    35→\n    36→function getNextLogNumber(): number {\n    37→  mkdirSync(logsDir, { recursive: true })\n    38→  const existing = readdirSync(logsDir)\n    39→    .filter(f => /^test-run-\\d+\\.log$/.test(f))\n    40→    .map(f => parseInt(f.match(/test-run-(\\d+)\\.log/)![1]!, 10))\n    41→  return existing.length > 0 ? Math.max(...existing) + 1 : 1\n    42→}\n    43→\n    44→function killStaleProcesses(): void {\n    45→  try { execSync(\"pkill -f 'netlify dev' || true\", { stdio: 'ignore' }) } catch { /* ignore */ }\n    46→  try { execSync(\"pkill -f 'dev-server' || true\", { stdio: 'ignore' }) } catch { /* ignore */ }\n    47→  try { execSync(\"pkill -f 'vite' || true\", { stdio: 'ignore' }) } catch { /* ignore */ }\n    48→  try { execSync(\"fuser -k 8888/tcp 2>/dev/null || true\", { stdio: 'ignore' }) } catch { /* ignore */ }\n    49→  try { execSync(\"fuser -k 5173/tcp 2>/dev/null || true\", { stdio: 'ignore' }) } catch { /* ignore */ }\n    50→  execSync('sleep 1', { stdio: 'ignore' })\n    51→}\n    52→\n    53→async function neonApi(method: string, path: string, body?: unknown): Promise<unknown> {\n    54→  const apiKey = getEnvVar('NEON_API_KEY')\n    55→  const res = await fetch(`https://console.neon.tech/api/v2${path}`, {\n    56→    method,\n    57→    headers: {\n    58→      Authorization: `Bearer ${apiKey}`,\n    59→      'Content-Type': 'application/json',\n    60→      Accept: 'application/json',\n    61→    },\n    62→    body: body ? JSON.stringify(body) : undefined,\n    63→  })\n    64→  if (!res.ok) {\n    65→    const text = await res.text()\n    66→    throw new Error(`Neon API ${method} ${path} failed (${res.status}): ${text}`)\n    67→  }\n    68→  const ct = res.headers.get('content-type')\n    69→  if (ct?.includes('application/json')) return res.json()\n    70→  return null\n    71→}\n    72→\n    73→interface NeonBranch { id: string; name: string }\n    74→interface NeonBranchListResponse { branches: NeonBranch[] }\n    75→interface NeonEndpoint { host: string }\n    76→interface NeonEndpointsResponse { endpoints: NeonEndpoint[] }\n    77→interface NeonBranchCreateResponse { branch: NeonBranch; endpoints: NeonEndpoint[] }\n    78→\n    79→async function cleanupStaleBranches(projectId: string): Promise<void> {\n    80→  const data = await neonApi('GET', `/projects/${projectId}/branches`) as NeonBranchListResponse\n    81→  const stale = data.branches.filter(b => b.name.startsWith('test-run-'))\n    82→  for (const branch of stale) {\n    83→    try { await neonApi('DELETE', `/projects/${projectId}/branches/${branch.id}`) } catch { /* best effort */ }\n    84→  }\n    85→}\n    86→\n    87→async function createEphemeralBranch(projectId: string, branchName: string): Promise<string> {\n    88→  const data = await neonApi('POST', `/projects/${projectId}/branches`, {\n    89→    branch: { name: branchName },\n    90→    endpoints: [{ type: 'read_write' }],\n    91→  }) as NeonBranchCreateResponse\n    92→\n    93→  let host = data.endpoints[0]?.host\n    94→  if (!host) {\n    95→    const epData = await neonApi('GET', `/projects/${projectId}/branches/${data.branch.id}/endpoints`) as NeonEndpointsResponse\n    96→    host = epData.endpoints[0]?.host\n    97→    if (!host) throw new Error('No endpoint created for ephemeral branch')\n    98→  }\n    99→  const mainDbUrl = getEnvVar('DATABASE_URL')\n   100→  const url = new URL(mainDbUrl)\n   101→  url.hostname = host\n   102→  return url.toString()\n   103→}\n   104→\n   105→async function deleteBranch(projectId: string, branchName: string): Promise<void> {\n   106→  const data = await neonApi('GET', `/projects/${projectId}/branches`) as NeonBranchListResponse\n   107→  const branch = data.branches.find(b => b.name === branchName)\n   108→  if (branch) {\n   109→    await neonApi('DELETE', `/projects/${projectId}/branches/${branch.id}`)\n   110→  }\n   111→}\n   112→\n   113→interface RecordingEntry {\n   114→  id?: string; kind: string; metadata?: { test?: { result?: string; title?: string }; uri?: string }; duration?: number\n   115→}\n   116→interface ParsedRecording { id: string; testResult: string; testTitle: string; specFile: string; duration: number }\n   117→\n   118→function parseRecordingsLog(): ParsedRecording[] {\n   119→  const logPath = join(process.env.HOME || '~', '.replay', 'recordings.log')\n   120→  if (!existsSync(logPath)) return []\n   121→  const content = readFileSync(logPath, 'utf-8')\n   122→ 