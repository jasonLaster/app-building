[2026-03-16T01:44:18.700Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ay3d5dvFfWXTENMWyH9U4P","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test';\n     2→\n     3→// Helper to create a test user via signup API\n     4→async function createTestUser(baseURL: string, name: string, email: string, password: string) {\n     5→  const response = await fetch(`${baseURL}/api/signup`, {\n     6→    method: 'POST',\n     7→    headers: { 'Content-Type': 'application/json' },\n     8→    body: JSON.stringify({ name, email, password }),\n     9→  });\n    10→  return response.json();\n    11→}\n    12→\n    13→// Helper to delete all sessions and members created by tests\n    14→async function cleanupTestUsers(baseURL: string) {\n    15→  // We rely on the test script's between-test DB reset (truncate + re-seed)\n    16→  // No additional cleanup needed since seed data is restored each test\n    17→}\n    18→\n    19→test.describe('LoginForm', () => {\n    20→  test('Login form renders with email and password fields', async ({ page }) => {\n    21→    await page.goto('/login');\n    22→\n    23→    // Verify the login form is visible\n    24→    await expect(page.getByTestId('login-form')).toBeVisible({ timeout: 30000 });\n    25→\n    26→    // Verify email input\n    27→    await expect(page.getByTestId('login-email-input')).toBeVisible();\n    28→\n    29→    // Verify password input\n    30→    await expect(page.getByTestId('login-password-input')).toBeVisible();\n    31→\n    32→    // Verify Sign in button\n    33→    await expect(page.getByTestId('login-submit-button')).toBeVisible();\n    34→    await expect(page.getByTestId('login-submit-button')).toHaveText('Sign in');\n    35→\n    36→    // Verify Sign up link\n    37→    await expect(page.getByTestId('login-signup-link')).toBeVisible();\n    38→    await expect(page.getByTestId('login-signup-link')).toHaveText('Sign up');\n    39→  });\n    40→\n    41→  test('Successful login with valid credentials', async ({ page, baseURL }) => {\n    42→    test.slow();\n    43→\n    44→    // Create a test user via API\n    45→    const email = `user-${Date.now()}@test.com`;\n    46→    const password = 'password123';\n    47→    await createTestUser(baseURL!, 'Test User', email, password);\n    48→\n    49→    await page.goto('/login');\n    50→    await expect(page.getByTestId('login-form')).toBeVisible({ timeout: 30000 });\n    51→\n    52→    // Fill in credentials\n    53→    await page.getByTestId('login-email-input').fill(email);\n    54→    await page.getByTestId('login-password-input').fill(password);\n    55→    await page.getByTestId('login-submit-button').click();\n    56→\n    57→    // Verify redirect to /my-issues\n    58→    await expect(page).toHaveURL(/\\/my-issues/, { timeout: 30000 });\n    59→\n    60→    // Verify session token in localStorage\n    61→    const token = await page.evaluate(() => localStorage.getItem('session_token'));\n    62→    expect(token).toBeTruthy();\n    63→\n    64→    // Verify sidebar is visible (authenticated layout)\n    65→    await expect(page.getByTestId('app-layout')).toBeVisible({ timeout: 30000 });\n    66→  });\n    67→\n    68→  test('Login fails with invalid email', async ({ page }) => {\n    69→    await page.goto('/login');\n    70→    await expect(page.getByTestId('login-form')).toBeVisible({ timeout: 30000 });\n    71→\n    72→    // Enter non-existent email\n    73→    await page.getByTestId('login-email-input').fill('nonexistent@test.com');\n    74→    await page.getByTestId('login-password-input').fill('password123');\n    75→    await page.getByTestId('login-submit-button').click();\n    76→\n    77→    // Verify error message\n    78→    await expect(page.getByTestId('login-error')).toBeVisible({ timeout: 30000 });\n    79→    await expect(page.getByTestId('login-error')).toContainText('Invalid email or password');\n    80→"}]},"parent_tool_use_id":"toolu_012ZM9PKQLoNPrunaMM29F46","session_id":"1e17ab70-0a33-4d2a-af23-66b102e400e2","uuid":"ca92c983-c386-4e60-9ff4-5b443b15758b"}
