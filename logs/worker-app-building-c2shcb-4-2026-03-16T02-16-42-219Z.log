 '-', i.number) ILIKE ${'%' + query + '%'})\n    47→        ${teamId ? sql`AND i.team_id = ${teamId}` : sql``}\n    48→        ORDER BY i.id, i.created_at DESC\n    49→        LIMIT 20\n    50→      `;\n    51→    } else if (teamId) {\n    52→      issues = await sql`\n    53→        SELECT i.id, i.title, i.number, t.identifier AS team_identifier\n    54→        FROM issues i\n    55→        JOIN teams t ON t.id = i.team_id\n    56→        WHERE i.team_id = ${teamId}\n    57→        ORDER BY i.created_at DESC\n    58→        LIMIT 20\n    59→      `;\n    60→    } else {\n    61→      issues = await sql`\n    62→        SELECT i.id, i.title, i.number, t.identifier AS team_identifier\n    63→        FROM issues i\n    64→        JOIN teams t ON t.id = i.team_id\n    65→        ORDER BY i.created_at DESC\n    66→        LIMIT 20\n    67→      `;\n    68→    }\n    69→\n    70→    const results = issues.map((i) => ({\n    71→      id: i.id,\n    72→      title: i.title,\n    73→      identifier: `${i.team_identifier}-${i.number}`,\n    74→    }));\n    75→\n    76→    return new Response(JSON.stringify({ issues: results }), {\n    77→      status: 200,\n    78→      headers: { 'Content-Type': 'application/json' },\n    79→    });\n    80→  } catch (err) {\n    81→    console.error('Search issues error:', err);\n    82→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n    83→      status: 500,\n    84→      headers: { 'Content-Type': 'application/json' },\n    85→    });\n    86→  }\n    87→}\n    88→"}]},"parent_tool_use_id":"toolu_01QyWc7QHB8fZMZKWySD58UN","session_id":"1e17ab70-0a33-4d2a-af23-66b102e400e2","uuid":"f98747f5-8134-46b7-abf3-3c4d547cd45c"}
