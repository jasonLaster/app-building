[2026-03-16T01:56:53.442Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014Giro1KCQgjMWbDGXbj78m","type":"tool_result","content":"     1→import { useState, useEffect, useRef, useCallback } from 'react';\n     2→import { useSelector } from 'react-redux';\n     3→import type { RootState } from '../store';\n     4→import { StatusIcon, PriorityIcon, STATUS_CONFIG, STATUS_ORDER } from './IssueRow';\n     5→import './CreateIssueForm.css';\n     6→\n     7→const PRIORITY_ORDER = ['urgent', 'high', 'medium', 'low', 'none'] as const;\n     8→const PRIORITY_LABELS: Record<string, string> = {\n     9→  urgent: 'Urgent',\n    10→  high: 'High',\n    11→  medium: 'Medium',\n    12→  low: 'Low',\n    13→  none: 'No Priority',\n    14→};\n    15→\n    16→interface SearchableIssue {\n    17→  id: string;\n    18→  title: string;\n    19→  identifier: string;\n    20→}\n    21→\n    22→export interface CreateIssueFormData {\n    23→  teamId: string;\n    24→  title: string;\n    25→  description: string;\n    26→  status: string;\n    27→  priority: string;\n    28→  assigneeId: string | null;\n    29→  labelIds: string[];\n    30→  projectId: string | null;\n    31→  cycleId: string | null;\n    32→  dueDate: string | null;\n    33→  parentId: string | null;\n    34→}\n    35→\n    36→interface CreateIssueFormProps {\n    37→  defaultTeamId?: string;\n    38→  formData: CreateIssueFormData;\n    39→  onFormChange: (data: CreateIssueFormData) => void;\n    40→  titleError: string | null;\n    41→}\n    42→\n    43→type DropdownType = 'team' | 'status' | 'priority' | 'assignee' | 'labels' | 'project' | 'cycle' | 'parent' | null;\n    44→\n    45→export default function CreateIssueForm({ defaultTeamId, formData, onFormChange, titleError }: CreateIssueFormProps) {\n    46→  const { items: teams } = useSelector((state: RootState) => state.teams);\n    47→  const { items: labels } = useSelector((state: RootState) => state.labels);\n    48→  const token = useSelector((state: RootState) => state.auth.token);\n    49→\n    50→  const [openDropdown, setOpenDropdown] = useState<DropdownType>(null);\n    51→  const [assigneeSearch, setAssigneeSearch] = useState('');\n    52→  const [projectSearch, setProjectSearch] = useState('');\n    53→  const [parentSearch, setParentSearch] = useState('');\n    54→  const [parentResults, setParentResults] = useState<SearchableIssue[]>([]);\n    55→\n    56→  // Team-specific data (members, projects, cycles)\n    57→  const [teamMembers, setTeamMembers] = useState<Array<{ id: string; name: string; email: string }>>([]);\n    58→  const [teamProjects, setTeamProjects] = useState<Array<{ id: string; name: string }>>([]);\n    59→  const [teamCycles, setTeamCycles] = useState<Array<{ id: string; name: string; start_date: string; end_date: string }>>([]);\n    60→\n    61→  const formRef = useRef<HTMLDivElement>(null);\n    62→  const titleRef = useRef<HTMLInputElement>(null);\n    63→\n    64→  // Focus title on mount\n    65→  useEffect(() => {\n    66→    titleRef.current?.focus();\n    67→  }, []);\n    68→\n    69→  // Set default team\n    70→  useEffect(() => {\n    71→    if (defaultTeamId && !formData.teamId) {\n    72→      onFormChange({ ...formData, teamId: defaultTeamId });\n    73→    } else if (!formData.teamId && teams.length > 0 && teams[0]) {\n    74→      onFormChange({ ...formData, teamId: teams[0].id });\n    75→    }\n    76→  }, [defaultTeamId, teams]); // eslint-disable-line react-hooks/exhaustive-deps\n    77→\n    78→  // Fetch team-specific data when team changes\n    79→  const fetchTeamData = useCallback(async (teamId: string) => {\n    80→    if (!token || !teamId) return;\n    81→    try {\n    82→      const response = await fetch(`/api/team-issues?teamId=${teamId}`, {\n    83→        headers: { Authorization: `Bearer ${token}` },\n    84→      });\n    85→      if (response.ok) {\n    86→        const data = await response.json();\n    87→        setTeamMembers(data.members || []);\n    88→        setTeamProjects(data.projects || []);\n    89→        setTeamCycles(data.cycles || []);\n    90→      }\n    91→    } catch {\n    92→      // silently fail\n    93→    }\n    94→  }, [token]);\n    95→\n    96→  useEffect(() => {\n    97→    if (formData.teamId) {\n    98→      fetchTeamData(formData.teamId);\n    99→    }\n   100→  }, [formData.teamId, fetchTeamData]);\n   101→\n   102→  // Search parent issues\n   103→  useEffect(() => {\n   104→    if (!token || openDropdown !== 'parent') return;\n   105→    const controller = new AbortController();\n   106→    const fetchParents = async () => {\n   107→      try {\n   108→        const params = new URLSearchParams();\n   109→        if (parentSearch) params.set('q', parentSearch);\n   110→        if (formData.teamId) params.set('teamId', formData.teamId);\n   111→        const response = await fetch(`/api/search-issues?${params}`, {\n   112→          headers: { Authorization: `Bearer ${token}` },\n   113→          signal: controller.signal,\n   114→        });\n   115→        if (response.ok) {\n   116→          const data = await response.json();\n   117→          setParentResults(data.issues || []);\n   118→        }\n   119→      } catch {\n   120→        // ignore abort errors\n   121→      }\n   122→    };\n   123→    const timer = setTimeout(fetchParents, 200);\n   124→    return () => {\n   125→      clearTimeout(timer);\n   126→      controller.abort();\n   127→    };\n   128→  }, [parentSearch, formData.teamId, token, openDropdown]);\n   129→\n   130→  // Close dropdown on outside click or click on non-dropdown form elements\n   131→  useEffect(() => {\n   132→    function handleClickOutside(e: MouseEvent) {\n   133→      const target = e.target as HTMLElement;\n   134→      // Close if click is outside the form entirely\n   135→      if (formRef.current && !formRef.current.contains(target)) {\n   136→        setOpenDropdown(null);\n   137→        return;\n   138→      }\n   139→      // Close if click is inside the form but outside any dropdown wrapper\n   140→      if (!target.closest('.cif-dropdown-wrapper')) {\n   141→        setOpenDropdown(null);\n   142→      }\n   143→    }\n   144→    if (openDropdown) {\n   145→      document.addEventListener('mousedown', handleClickOutside);\n   146→    }\n   147→    return () => document.removeEventListener('mousedown', handleClickOutside);\n   148→  }, [openDropdown]);\n   149→\n   150→  function updateField<K extends keyof CreateIssueFormData>(key: K, value: CreateIssueFormData[K]) {\n   151→    onFormChange({ ...formData, [key]: value });\n   152→  }\n   153→\n   154→  function toggleDropdown(type: DropdownType) {\n   155→    setOpenDropdown(openDropdown === type ? null : type);\n   156→    if (type === 'assignee') setAssigneeSearch('');\n   157→    if (type === 'project') setProjectSearch('');\n   158→    if (type === 'parent') setParentSearch('');\n   159→  }\n   160→\n   161→  function handleTeamChange(teamId: string) {\n   162→    onFormChange({ ...formData, teamId, cycleId: null });\n   163→    setOpenDropdown(null);\n   164→  }\n   165→\n   166→  function handleLabelToggle(labelId: string) {\n   167→    const current = formData.labelIds;\n   168→    if (current.includes(labelId)) {\n   169→      updateField('labelIds', current.filter((id) => id !== labelId));\n   170→    } else {\n   171→      updateField('labelIds', [...current, labelId]);\n   172→    }\n   173→  }\n   174→\n   175→  function handleRemoveLabel(labelId: string) {\n   176→    updateField('labelIds', formData.labelIds.filter((id) => id !== labelId));\n   177→  }\n   178→\n   179→  const selectedTeam = teams.find((t) => t.id === formData.teamId);\n   180→  const selectedAssignee = teamMembers.find((m) => m.id === formData.assigneeId);\n   181→  const selectedProject = teamProjects.find((p) => p.id === formData.projectId);\n   182→  const selectedCycle = teamCycles.find((c) => c.id === formData.cycleId);\n   183→  const selectedLabels = labels.filter((l) => formData.labelIds.includes(l.id));\n   184→  const selectedParent = parentResults.find((i) => i.id === formData.parentId);\n   185→\n   186→  const filteredMembers = teamMembers.filter((m) =>\n   187→    m.name.toLowerCase().includes(assigneeSearch.toLowerCase())\n   188→  );\n   189→  const filteredProjects = teamProjects.filter((p) =>\n   190→    p.name.toLowerCase().includes(projectSearch.toLowerCase())\n   191→  );\n   192→  const filteredParents = parentResults.filter((i) =>\n   193→    !parentSearch || i.title.toLowerCase().includes(parentSearch.toLowerCase()) || i.identifier.toLowerCase().includes(parentSearch.toLowerCase())\n   194→  );\n   195→\n   196→  const statusConfig = STATUS_CONFIG[formData.status] || STATUS_CONFIG.backlog;\n   197→\n   198→  function formatDueDisplay(dateStr: string): string {\n   199→    const d = new Date(dateStr + 'T00:00:00');\n   200→    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });\n   201→  }\n   202→\n   203→  return (\n   204→    <div className=\"create-issue-form\" ref={formRef} data-testid=\"create-issue-form\">\n   205→      {/* Team Selector */}\n   206→      <div className=\"cif-field\" data-testid=\"create-issue-team-field\">\n   207→        <label className=\"cif-label\">Team</label>\n   208→        <div className=\"cif-dropdown-wrapper\">\n   209→          <button\n   210→            className=\"cif-select-btn\"\n   211→            onClick={() => toggleDropdown('team')}\n   212→            data-testid=\"create-issue-team-selector\"\n   213→          >\n   214→            <span>{selectedTeam ? selectedTeam.name : 'Select team'}</span>\n   215→            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n   216→          </button>\n   217→          {openDropdown === 'team' && (\n   218→            <div className=\"cif-dropdown\" data-testid=\"create-issue-team-dropdown\">\n   219→              {teams.map((team) => (\n   220→                <button\n   221→                  key={team.id}\n   222→                  className={`cif-dropdown-option ${formData.teamId === team.id ? 'cif-dropdown-option-active' : ''}`}\n   223→                  onClick={() => handleTeamChange(team.id)}\n   224→                  data-testid={`create-issue-team-option-${team.id}`}\n   225→                >\n   226→                  {team.name}\n   227→                </button>\n   228→              ))}\n   229→            </div>\n   230→          )}\n   231→        </div>\n   232→      </div>\n   233→\n   234→      {/* Title */}\n   235→      <div className=\"cif-field\" data-testid=\"create-issue-title-field\">\n   236→        <label className=\"cif-label\">Title</label>\n   237→        <input\n   238→          ref={titleRef}\n   239→          type=\"text\"\n   240→          className={`cif-input ${titleError ? 'cif-input-error' : ''}`}\n   241→          placeholder=\"Issue title\"\n   242→          value={formData.title}\n   243→          onChange={(e) => updateField('title', e.target.value)}\n   244→          data-testid=\"create-issue-title-input\"\n   245→        />\n   246→        {titleError && (\n   247→          <span className=\"cif-error\" data-testid=\"create-issue-title-error\">{titleError}</span>\n   248→        )}\n   249→      </div>\n   250→\n   251→      {/* Description */}\n   252→      <div className=\"cif-field\" data-testid=\"create-issue-description-field\">\n   253→        <label className=\"cif-label\">Description</label>\n   254→        <textarea\n   255→          className=\"cif-textarea\"\n   256→          placeholder=\"Add description... (supports markdown)\"\n   257→          value={formData.description}\n   258→          onChange={(e) => updateField('description', e.target.value)}\n   259→          rows={3}\n   260→          data-testid=\"create-issue-description-input\"\n   261→        />\n   262→      </div>\n   263→\n   264→      {/* Status & Priority row */}\n   265→      <div className=\"cif-row\">\n   266→        {/* Status */}\n   267→        <div className=\"cif-field cif-field-half\" data-testid=\"create-issue-status-field\">\n   268→          <label className=\"cif-label\">Status</label>\n   269→          <div className=\"cif-dropdown-wrapper\">\n   270→            <button\n   271→              className=\"cif-select-btn\"\n   272→              onClick={() => toggleDropdown('status')}\n   273→              data-testid=\"create-issue-status-selector\"\n   274→            >\n   275→              <StatusIcon status={formData.status} color={statusConfig.color} />\n   276→              <span>{statusConfig.label}</span>\n   277→              <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n   278→            </button>\n   279→            {openDropdown === 'status' && (\n   280→              <div className=\"cif-dropdown\" data-testid=\"create-issue-status-dropdown\">\n   281→                {STATUS_ORDER.map((s) => {\n   282→                  const cfg = STATUS_CONFIG[s];\n   283→                  return (\n   284→                    <button\n   285→                      key={s}\n   286→                      className={`cif-dropdown-option ${formData.status === s ? 'cif-dropdown-option-active' : ''}`}\n   287→                      onClick={() => { updateField('status', s); setOpenDropdown(null); }}\n   288→                      data-testid={`create-issue-status-option-${s}`}\n   289→                    >\n   290→                      <StatusIcon status={s} color={cfg.color} />\n   291→                      <span>{cfg.label}</span>\n   292→                    </button>\n   293→                  );\n   294→                })}\n   295→              </div>\n   296→            )}\n   297→          </div>\n   298→        </div>\n   299→