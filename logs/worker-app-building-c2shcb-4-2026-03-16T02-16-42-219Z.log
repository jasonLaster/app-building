[2026-03-16T01:43:38.184Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014Wb8J1pv92Js6mMzarZ8cL","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions';\n     2→import { getSql } from './db';\n     3→\n     4→async function authenticate(req: Request) {\n     5→  const authHeader = req.headers.get('Authorization');\n     6→  if (!authHeader?.startsWith('Bearer ')) return null;\n     7→  const token = authHeader.slice(7);\n     8→  const sql = getSql();\n     9→  const sessions = await sql`\n    10→    SELECT s.member_id FROM sessions s\n    11→    WHERE s.token = ${token} AND s.expires_at > NOW()\n    12→  `;\n    13→  const session = sessions[0];\n    14→  return session ? session.member_id as string : null;\n    15→}\n    16→\n    17→export default async function handler(req: Request, _context: Context) {\n    18→  try {\n    19→    const memberId = await authenticate(req);\n    20→    if (!memberId) {\n    21→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    22→        status: 401,\n    23→        headers: { 'Content-Type': 'application/json' },\n    24→      });\n    25→    }\n    26→\n    27→    const sql = getSql();\n    28→    const url = new URL(req.url);\n    29→    const pathParts = url.pathname.split('/').filter(Boolean);\n    30→    // In Netlify, path is /.netlify/functions/teams/<teamId>\n    31→    const funcIndex = pathParts.indexOf('teams');\n    32→    const teamId = funcIndex >= 0 ? pathParts[funcIndex + 1] || null : null;\n    33→\n    34→    if (req.method === 'GET' && !teamId) {\n    35→      const teams = await sql`\n    36→        SELECT t.id, t.name, t.identifier, t.description,\n    37→          (SELECT COUNT(*)::int FROM team_members tm WHERE tm.team_id = t.id) AS member_count,\n    38→          (SELECT c.name FROM cycles c WHERE c.team_id = t.id AND c.status = 'active' LIMIT 1) AS active_cycle_name\n    39→        FROM teams t\n    40→        ORDER BY t.name ASC\n    41→      `;\n    42→      return new Response(JSON.stringify({ teams }), {\n    43→        status: 200,\n    44→        headers: { 'Content-Type': 'application/json' },\n    45→      });\n    46→    }\n    47→\n    48→    if (req.method === 'GET' && teamId) {\n    49→      const teams = await sql`\n    50→        SELECT t.id, t.name, t.identifier, t.description\n    51→        FROM teams t WHERE t.id = ${teamId}\n    52→      `;\n    53→      const team = teams[0];\n    54→      if (!team) {\n    55→        return new Response(JSON.stringify({ error: 'Team not found' }), {\n    56→          status: 404,\n    57→          headers: { 'Content-Type': 'application/json' },\n    58→        });\n    59→      }\n    60→\n    61→      const members = await sql`\n    62→        SELECT m.id, m.name, m.email\n    63→        FROM members m\n    64→        JOIN team_members tm ON tm.member_id = m.id\n    65→        WHERE tm.team_id = ${teamId}\n    66→        ORDER BY m.name ASC\n    67→      `;\n    68→\n    69→      const allMembers = await sql`\n    70→        SELECT m.id, m.name, m.email\n    71→        FROM members m\n    72→        WHERE m.id NOT IN (\n    73→          SELECT tm.member_id FROM team_members tm WHERE tm.team_id = ${teamId}\n    74→        )\n    75→        ORDER BY m.name ASC\n    76→      `;\n    77→\n    78→      return new Response(JSON.stringify({ team, members, availableMembers: allMembers }), {\n    79→        status: 200,\n    80→        headers: { 'Content-Type': 'application/json' },\n    81→      });\n    82→    }\n    83→\n    84→    if (req.method === 'POST') {\n    85→      const body = await req.json();\n    86→      const { name, identifier, description } = body as { name: string; identifier: string; description?: string };\n    87→\n    88→      if (!name?.trim()) {\n    89→        return new Response(JSON.stringify({ error: 'Name is required' }), {\n    90→          status: 400,\n    91→          headers: { 'Content-Type': 'application/json' },\n    92→        });\n    93→      }\n    94→      if (!identifier?.trim()) {\n    95→        return new Response(JSON.stringify({ error: 'Identifier prefix is required' }), {\n    96→          status: 400,\n    97→          headers: { 'Content-Type': 'application/json' },\n    98→        });\n    99→      }\n   100→\n   101→      const upperIdentifier = identifier.trim().toUpperCase();\n   102→      if (upperIdentifier.length < 2 || upperIdentifier.length > 5) {\n   103→        return new Response(JSON.stringify({ error: 'Identifier prefix must be 2-5 characters' }), {\n   104→          status: 400,\n   105→          headers: { 'Content-Type': 'application/json' },\n   106→        });\n   107→      }\n   108→\n   109→      const existing = await sql`\n   110→        SELECT id FROM teams WHERE UPPER(identifier) = ${upperIdentifier}\n   111→      `;\n   112→      if (existing.length > 0) {\n   113→        return new Response(JSON.stringify({ error: `A team with prefix '${upperIdentifier}' already exists` }), {\n   114→          status: 409,\n   115→          headers: { 'Content-Type': 'application/json' },\n   116→        });\n   117→      }\n   118→\n   119→      const newTeams = await sql`\n   120→        INSERT INTO teams (name, identifier, description)\n   121→        VALUES (${name.trim()}, ${upperIdentifier}, ${description?.trim() || ''})\n   122→        RETURNING id, name, identifier, description\n   123→      `;\n   124→      const newTeam = newTeams[0];\n   125→\n   126→      return new Response(JSON.stringify({ team: { ...newTeam, member_count: 0, active_cycle_name: null } }), {\n   127→        status: 201,\n   128→        headers: { 'Content-Type': 'application/json' },\n   129→      });\n   130→    }\n   131→\n   132→    if (req.method === 'PUT' && teamId) {\n   133→      const body = await req.json();\n   134→      const { name, identifier, description } = body as { name?: string; identifier?: string; description?: string };\n   135→\n   136→      if (name !== undefined && !name.trim()) {\n   137→        return new Response(JSON.stringify({ error: 'Team name cannot be empty' }), {\n   138→          status: 400,\n   139→          headers: { 'Content-Type': 'application/json' },\n   140→        });\n   141→      }\n   142→\n   143→      if (identifier !== undefined) {\n   144→        const upperIdentifier = identifier.trim().toUpperCase();\n   145→        if (upperIdentifier.length < 2 || upperIdentifier.length > 5) {\n   146→          return new Response(JSON.stringify({ error: 'Identifier prefix must be 2-5 characters' }), {\n   147→            status: 400,\n   148→            headers: { 'Content-Type': 'application/json' },\n   149→          });\n   150→        }\n   151→\n   152→        const existing = await sql`\n   153→          SELECT id FROM teams WHERE UPPER(identifier) = ${upperIdentifier} AND id != ${teamId}\n   154→        `;\n   155→        if (existing.length > 0) {\n   156→          return new Response(JSON.stringify({ error: `A team with prefix '${upperIdentifier}' already exists` }), {\n   157→            status: 409,\n   158→            headers: { 'Content-Type': 'application/json' },\n   159→          });\n   160→        }\n   161→      }\n   162→\n   163→      const nameVal = name !== undefined ? name.trim() : null;\n   164→      const identVal = identifier !== undefined ? identifier.trim().toUpperCase() : null;\n   165→      const descVal = description !== undefined ? description : null;\n   166→      const descProvided = description !== undefined;\n   167→\n   168→      const updatedTeams = await sql`\n   169→        UPDATE teams\n   170→        SET\n   171→          name = CASE WHEN ${nameVal} IS NOT NULL THEN ${nameVal} ELSE name END,\n   172→          identifier = CASE WHEN ${identVal} IS NOT NULL THEN ${identVal} ELSE identifier END,\n   173→          description = CASE WHEN ${descProvided} THEN ${descVal} ELSE description END\n   174→        WHERE id = ${teamId}\n   175→        RETURNING id, name, identifier, description\n   176→      `;\n   177→      const updated = updatedTeams[0];\n   178→      if (!updated) {\n   179→        return new Response(JSON.stringify({ error: 'Team not found' }), {\n   180→          status: 404,\n   181→          headers: { 'Content-Type': 'application/json' },\n   182→        });\n   183→      }\n   184→\n   185→      return new Response(JSON.stringify({ team: updated }), {\n   186→        status: 200,\n   187→        headers: { 'Content-Type': 'application/json' },\n   188→      });\n   189→    }\n   190→\n   191→    if (req.method === 'DELETE' && teamId) {\n   192→      await sql`DELETE FROM team_members WHERE team_id = ${teamId}`;\n   193→      await sql`UPDATE issues SET cycle_id = NULL WHERE cycle_id IN (SELECT id FROM cycles WHERE team_id = ${teamId})`;\n   194→      await sql`UPDATE issues SET team_id = NULL WHERE team_id = ${teamId}`;\n   195→      await sql`DELETE FROM cycles WHERE team_id = ${teamId}`;\n   196→      await sql`DELETE FROM teams WHERE id = ${teamId}`;\n   197→\n   198→      return new Response(JSON.stringify({ success: true }), {\n   199→        status: 200,\n   200→        headers: { 'Content-Type': 'application/json' },\n   201→      });\n   202→    }\n   203→\n   204→    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n   205→      status: 405,\n   206→      headers: { 'Content-Type': 'application/json' },\n   207→    });\n   208→  } catch (err) {\n   209→    console.error('Teams error:', err);\n   210→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n   211→      status: 500,\n   212→      headers: { 'Content-Type': 'application/json' },\n   213→    });\n   214→  }\n   215→}\n   216→"}]},"parent_tool_use_id":"toolu_012LQTtKEHRNUyqmvUg8re3L","session_id":"1e17ab70-0a33-4d2a-af23-66b102e400e2","uuid":"a516ac95-4119-46da-88c3-3cfb04b256ca"}
