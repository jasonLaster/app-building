[2026-03-16T01:41:24.795Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SPg6ysNuXDtxrC5jDySon9","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test';\n     2→\n     3→// Helper to login via API and get token\n     4→async function loginViaApi(baseURL: string, email: string, password: string) {\n     5→  const response = await fetch(`${baseURL}/api/login`, {\n     6→    method: 'POST',\n     7→    headers: { 'Content-Type': 'application/json' },\n     8→    body: JSON.stringify({ email, password }),\n     9→  });\n    10→  return response.json();\n    11→}\n    12→\n    13→// Helper to get teams via API\n    14→async function getTeams(baseURL: string, token: string) {\n    15→  const response = await fetch(`${baseURL}/api/teams`, {\n    16→    headers: { Authorization: `Bearer ${token}` },\n    17→  });\n    18→  const data = await response.json();\n    19→  return data.teams;\n    20→}\n    21→\n    22→// Helper to login and navigate to team issues page\n    23→async function loginAndNavigateToTeamIssues(\n    24→  page: import('@playwright/test').Page,\n    25→  baseURL: string,\n    26→  teamIdentifier = 'ENG',\n    27→  email = 'alice@acme.com',\n    28→  password = 'password123'\n    29→) {\n    30→  const data = await loginViaApi(baseURL, email, password);\n    31→  const teams = await getTeams(baseURL, data.token);\n    32→  const team = teams.find((t: { identifier: string }) => t.identifier === teamIdentifier);\n    33→\n    34→  await page.goto('/login');\n    35→  await page.evaluate((t) => localStorage.setItem('session_token', t), data.token);\n    36→  await page.goto(`/team/${team.id}/issues`);\n    37→  await expect(page.getByTestId('team-issues-page')).toBeVisible({ timeout: 30000 });\n    38→\n    39→  return { token: data.token, user: data.user, team, teams };\n    40→}\n    41→\n    42→// Helper to login and open create issue modal from a team page\n    43→async function loginAndOpenCreateModal(\n    44→  page: import('@playwright/test').Page,\n    45→  baseURL: string,\n    46→  teamIdentifier = 'ENG',\n    47→  email = 'alice@acme.com',\n    48→  password = 'password123'\n    49→) {\n    50→  const result = await loginAndNavigateToTeamIssues(page, baseURL, teamIdentifier, email, password);\n    51→\n    52→  await page.getByTestId('new-issue-btn').click();\n    53→  await expect(page.getByTestId('create-issue-modal')).toBeVisible({ timeout: 30000 });\n    54→\n    55→  return result;\n    56→}\n    57→\n    58→// Helper to delete all non-seed issues via API\n    59→async function deleteCreatedIssues(baseURL: string, token: string, teamId: string) {\n    60→  const response = await fetch(`${baseURL}/api/team-issues?teamId=${teamId}`, {\n    61→    headers: { Authorization: `Bearer ${token}` },\n    62→  });\n    63→  if (response.ok) {\n    64→    const data = await response.json();\n    65→    const issues = data.issues || [];\n    66→    // Seed data has issues numbered 1-8 for ENG; delete any with number > 8\n    67→    for (const issue of issues) {\n    68→      if (issue.number > 8) {\n    69→        try {\n    70→          await fetch(`${baseURL}/api/update-issue`, {\n    71→            method: 'PUT',\n    72→            headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },\n    73→            body: JSON.stringify({ id: issue.id, status: 'cancelled' }),\n    74→          });\n    75→        } catch {\n    76→          // ignore\n    77→        }\n    78→      }\n    79→    }\n    80→  }\n    81→}\n    82→\n    83→test.describe('CreateIssueModalActions', () => {\n    84→  test('Create Issue button is visible and styled', async ({ page, baseURL }) => {\n    85→    await loginAndOpenCreateModal(page, baseURL!);\n    86→\n    87→    // Verify Create Issue button is visible\n    88→    const submitBtn = page.getByTestId('create-issue-submit-btn');\n    89→    await expect(submitBtn).toBeVisible();\n    90→    await expect(submitBtn).toContainText('Create Issue');\n    91→\n    92→    // Verify it's in the actions area at the bottom of the modal\n    93→    await expect(page.getByTestId('create-issue-actions')).toBeVisible();\n    94→\n    95→    // Verify the button has primary styling (cia-submit-btn class)\n    96→    await expect(submitBtn).toHaveClass(/cia-submit-btn/);\n    97→  });\n    98→\n    99→  test('Cancel button is visible', async ({ page, baseURL }) => {\n   100→    await loginAndOpenCreateModal(page, baseURL!);\n   101→\n   102→    // Verify Cancel button is visible alongside Create Issue button\n   103→    const cancelBtn = page.getByTestId('create-issue-cancel-btn');\n   104→    await expect(cancelBtn).toBeVisible();\n   105→    await expect(cancelBtn).toContainText('Cancel');\n   106→\n   107→    // Both buttons are in the actions area\n   108→    const submitBtn = page.getByTestId('create-issue-submit-btn');\n   109→    await expect(submitBtn).toBeVisible();\n   110→  });\n   111→\n   112→  test('Cancel button closes the modal', async ({ page, baseURL }) => {\n   113→    await loginAndOpenCreateModal(page, baseURL!);\n   114→\n   115→    // Click the Cancel button\n   116→    await page.getByTestId('create-issue-cancel-btn').click();\n   117→\n   118→    // Verify the modal closes\n   119→    await expect(page.getByTestId('create-issue-modal')).toHaveCount(0, { timeout: 10000 });\n   120→\n   121→    // Verify the user is still on the team issues page\n   122→    await expect(page.getByTestId('team-issues-page')).toBeVisible();\n   123→  });\n   124→\n   125→  test('Cancel button discards form data', async ({ page, baseURL }) => {\n   126→    await loginAndOpenCreateModal(page, baseURL!);\n   127→\n   128→    // Enter some data\n   129→    await page.getByTestId('create-issue-title-input').fill('Draft issue');\n   130→\n   131→    // Change priority to High\n   132→    await page.getByTestId('create-issue-priority-selector').click();\n   133→    await expect(page.getByTestId('create-issue-priority-dropdown')).toBeVisible();\n   134→    await page.getByTestId('create-issue-priority-option-high').click();\n   135→    await expect(page.getByTestId('create-issue-priority-selector')).toContainText('High');\n   136→\n   137→    // Click Cancel\n   138→    await page.getByTestId('create-issue-cancel-btn').click();\n   139→    await expect(page.getByTestId('create-issue-modal')).toHaveCount(0, { timeout: 10000 });\n   140→\n   141→    // Re-open the modal\n   142→    await page.getByTestId('new-issue-btn').click();\n   143→    await expect(page.getByTestId('create-issue-modal')).toBeVisible({ timeout: 30000 });\n   144→\n   145→    // Verify all fields are reset to defaults\n   146→    await expect(page.getByTestId('create-issue-title-input')).toHaveValue('');\n   147→    await expect(page.getByTestId('create-issue-status-selector')).toContainText('Backlog');\n   148→    await expect(page.getByTestId('create-issue-priority-selector')).toContainText('No Priority');\n   149→  });\n   150→\n   151→  test('Create Issue button submits the form with all fields', async ({ page, baseURL }) => {\n   152→    test.slow();\n   153→    const { token, team } = await loginAndOpenCreateModal(page, baseURL!);\n   154→\n   155→    const uniqueTitle = `Implement OAuth ${Date.now()}`;\n   156→\n   157→    // Fill in all fields\n   158→    await page.getByTestId('create-issue-title-input').fill(uniqueTitle);\n   159→    await page.getByTestId('create-issue-description-input').fill('Add OAuth support');\n   160→\n   161→    // Set status to Todo\n   162→    await page.getByTestId('create-issue-status-selector').click();\n   163→    await expect(page.getByTestId('create-issue-status-dropdown')).toBeVisible();\n   164→    await page.getByTestId('create-issue-status-option-todo').click();\n   165→\n   166→    // Set priority to High\n   167→    await page.getByTestId('create-issue-priority-selector').click();\n   168→    await expect(page.getByTestId('create-issue-priority-dropdown')).toBeVisible();\n   169→    await page.getByTestId('create-issue-priority-option-high').click();\n   170→\n   171→    // Set assignee to Alice Johnson\n   172→    await page.getByTestId('create-issue-assignee-selector').click();\n   173→    await expect(page.getByTestId('create-issue-assignee-dropdown')).toBeVisible();\n   174→    await page.getByTestId('create-issue-assignee-search').fill('Alice');\n   175→    const aliceOption = page.getByTestId('create-issue-assignee-dropdown').locator('button').filter({ hasText: /Alice Johnson/ });\n   176→    await expect(aliceOption).toBeVisible({ timeout: 10000 });\n   177→    await aliceOption.click();\n   178→\n   179→    // Set label to Feature\n   180→    await page.getByTestId('create-issue-labels-selector').click();\n   181→    await expect(page.getByTestId('create-issue-labels-dropdown')).toBeVisible();\n   182→    const featureOption = page.getByTestId('create-issue-labels-dropdown').locator('button').filter({ hasText: /^Feature$/ });\n   183→    await featureOption.click();\n   184→    await page.getByTestId('create-issue-title-input').click(); // close labels dropdown\n   185→\n   186→    // Set project to V2 Launch\n   187→    await page.getByTestId('create-issue-project-selector').click();\n   188→    await expect(page.getByTestId('create-issue-project-dropdown')).toBeVisible();\n   189→    const projectOption = page.getByTestId('create-issue-project-dropdown').locator('button').filter({ hasText: /V2 Launch/ });\n   190→    await expect(projectOption).toBeVisible({ timeout: 10000 });\n   191→    await projectOption.click();\n   192→\n   193→    // Set cycle to Sprint 12\n   194→    await page.getByTestId('create-issue-cycle-selector').click();\n   195→    await expect(page.getByTestId('create-issue-cycle-dropdown')).toBeVisible();\n   196→    const cycleOption = page.getByTestId('create-issue-cycle-dropdown').locator('button').filter({ hasText: /Sprint 12/ });\n   197→    await expect(cycleOption).toBeVisible({ timeout: 10000 });\n   198→    await cycleOption.click();\n   199→\n   200→    // Set due date\n   201→    await page.getByTestId('create-issue-due-date-input').fill('2026-03-25');\n   202→\n   203→    // Click Create Issue\n   204→    await page.getByTestId('create-issue-submit-btn').click();\n   205→\n   206→    // Verify success indicator with issue identifier\n   207→    await expect(page.getByTestId('create-issue-success')).toBeVisible({ timeout: 30000 });\n   208→    await expect(page.getByTestId('create-issue-success')).toContainText('ENG-');\n   209→\n   210→    // Verify modal closes\n   211→    await expect(page.getByTestId('create-issue-modal')).toHaveCount(0, { timeout: 30000 });\n   212→  });\n   213→\n   214→  test('Create Issue with only required fields', async ({ page, baseURL }) => {\n   215→    test.slow();\n   216→    await loginAndOpenCreateModal(page, baseURL!);\n   217→\n   218→    const uniqueTitle = `Quick bug fix ${Date.now()}`;\n   219→\n   220→    // Only fill in title (required) - team is already pre-selected\n   221→    await page.getByTestId('create-issue-title-input').fill(uniqueTitle);\n   222→\n   223→    // Click Create Issue\n   224→    await page.getByTestId('create-issue-submit-btn').click();\n   225→\n   226→    // Verify success indicator with issue identifier\n   227→    await expect(page.getByTestId('create-issue-success')).toBeVisible({ timeout: 30000 });\n   228→    await expect(page.getByTestId('create-issue-success')).toContainText('ENG-');\n   229→\n   230→    // Verify modal closes\n   231→    await expect(page.getByTestId('create-issue-modal')).toHaveCount(0, { timeout: 30000 });\n   232→  });\n   233→\n   234→  test('Created issue appears in the team issues list', async ({ page, baseURL }) => {\n   235→    test.slow();\n   236→    await loginAndNavigateToTeamIssues(page, baseURL!);\n   237→\n   238→    // Wait for issues to load\n   239→    await expect(page.getByTestId('team-issues-list')).toBeVisible({ timeout: 30000 });\n   240→    const initialRows = page.locator('[data-testid^=\"issue-row-\"]');\n   241→    await expect(initialRows).toHaveCount(8, { timeout: 30000 });\n   242→\n   243→    const uniqueTitle = `New feature request ${Date.now()}`;\n   244→\n   245→    // Open modal and create issue with status \"Todo\"\n   246→    await page.getByTestId('new-issue-btn').click();\n   247→    await expect(page.getByTestId('create-issue-modal')).toBeVisible({ timeout: 30000 });\n   248→\n   249→    await page.getByTestId('create-issue-title-input').fill(uniqueTitle);\n   250→\n   251→    // Set status to Todo\n   252→    await page.getByTestId('create-issue-status-selector').click();\n   253→    await expect(page.getByTestId('create-issue-status-dropdown')).toBeVisible();\n   254→    await page.getByTestId('create-issue-status-option-todo').click();\n   255→\n   256→    await page.getByTestId('create-issue-submit-btn').click();\n   257→    await expect(page.getByTestId('create-issue-success')).toBeVisible({ timeout: 30000 });\n   258→    await expect(page.getByTestId('create-issue-modal')).toHaveCount(0, { timeout: 30000 });\n   259→\n   260→    // Verify the new issue appears in the list (count increased by 1)\n   261→    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(9, { timeout: 30000 });\n   262→\n   263→    // Verify the issue title appears in the todo status group\n   264→    const todoGroup = page.getByTestId('team-issue-group-items-todo');\n   265→    await expect(todoGroup).toContainText(uniqueTitle, { timeout: 30000 });\n   266→  });\n   267→\n   268→  test('Created issue with parent appears as sub-issue', async ({ page, baseURL }) => {\n   269→    test.slow();\n   270→    const { token, team } = await loginAndOpenCreateModal(page, baseURL!);\n   271→\n   272→    const uniqueTitle = `Write unit tests ${Date.now()}`;\n   273→\n   274→    // Fill title\n   275→    await page.getByTestId('create-issue-title-input').fill(uniqueTitle);\n   276→\n   277→    // Select parent issue: ENG-1 (Fix login session expiration bug)\n   278→    await page.getByTestId('create-issue-parent-selector').click();\n   279→    await expect(page.getByTestId('create-issue-parent-dropdown')).toBeVisible();\n   280→    await page.getByTestId('create-issue-parent-search').fill('Fix login');\n   281→    const parentOption = page.getByTestId('create-issue-parent-dropdown').locator('button').filter({ hasText: /Fix login session expiration bug/ });\n   282→    await expect(parentOption).toBeVisible({ timeout: 10000 });\n   283→    await parentOption.click();\n   284→    await expect(page.getByTestId('create-issue-parent-selector')).toContainText('ENG-1');\n   285→\n   286→    // Submit\n   287→    await page.getByTestId('create-issue-submit-btn').click();\n   288→    await expect(page.getByTestId('create-issue-success')).toBeVisible({ timeout: 30000 });\n   289→    await expect(page.getByTestId('create-issue-modal')).toHaveCount(0, { timeout: 30000 });\n   290→\n   291→    // Navigate to the parent issue detail page (ENG-1)\n   292→    // First find the parent issue ID via search API\n   293→    const searchResp = await fetch(`${baseURL}/api/search-issues?q=Fix+login&teamId=${team.id}`, {\n   294→      headers: { Authorization: `Bearer ${token}` },\n   295→    });\n   296→    const searchData = await searchResp.json();\n   297→    const parentIssue = searchData.issues.find((i: { identifier: string }) => i.identifier === 'ENG-1');\n   298→\n   299→    await page.goto(`/issue/${parentIssue.id}`);\n   300→    await expect(page.getByTestId('issue-detail-page')).toBeVisible({ timeout: 30000 });\n   301→\n   302→    // Verify sub-issues section shows the new issue\n   303→    await expect(page.getByTestId('sub-issues')).toBeVisible({ timeout: 30000 });\n   304→    await expect(page.getByTestId('sub-issues-list')).toBeVisible({ timeout: 30000 });\n   305→    await expect(page.getByTestId('sub-issues-list')).toContainText(uniqueTitle, { timeout: 30000 });\n   306→  });\n   307→\n   308→  test('Created issue generates activity history entry', async ({ page, baseURL }) => {\n   309→    test.slow();\n   310→    await loginAndOpenCreateModal(page, baseURL!);\n   311→\n   312→    const uniqueTitle = `Track history ${Date.now()}`;\n   313→\n   314→    // Create issue\n   315→    await page.getByTestId('create-issue-title-input').fill(uniqueTitle);\n   316→    await page.getByTestId('create-issue-submit-btn').click();\n   317→\n   318→    // Wait for success and get the identifier\n   319→    await expect(page.getByTestId('create-issue-success')).toBeVisible({ timeout: 30000 });\n   320→    const successText = await page.getByTestId('create-issue-success').textContent();\n   321→    // Extract identifier like \"ENG-9\" from \"Created ENG-9\"\n   322→    const identifierMatch = successText?.match(/(ENG-\\d+)/);\n   323→    const identifier = identifierMatch ? identifierMatch[1] : '';\n   324→\n   325→    await expect(page.getByTestId('create-issue-modal')).toHaveCount(0, { timeout: 30000 });\n   326→\n   327→    // Find the issue ID via search API\n   328→    const loginData = await loginViaApi(baseURL!, 'alice@acme.com', 'password123');\n   329→    const teams = await getTeams(baseURL!, loginData.token);\n   330→    const engTeam = teams.find((t: { identifier: string }) => t.identifier === 'ENG');\n   331→\n   332→    const searchResp = await fetch(`${baseURL}/api/search-issues?q=${encodeURIComponent(uniqueTitle)}&teamId=${engTeam.id}`, {\n   333→      headers: { Authorization: `Bearer ${loginData.token}` },\n   334→    });\n   335→    const searchData = await searchResp.json();\n   336→    const createdIssue = searchData.issues.find((i: { title: string }) => i.title === uniqueTitle);\n   337→\n   338→    // Navigate to the issue detail page\n   339→    await page.goto(`/issue/${createdIssue.id}`);\n   340→    await expect(page.getByTestId('issue-detail-page')).toBeVisible({ timeout: 30000 });\n   341→\n   342→    // Click on Activity tab\n   343→    await page.getByTestId('activity-tab').click();\n   344→\n   345→    // Verify \"created this issue\" activity entry exists\n   346→    await expect(page.getByTestId('activity-list')).toBeVisible({ timeout: 30000 });\n   347→    await expect(page.getByTestId('activity-list')).toContainText('created this issue', { timeout: 30000 });\n   348→    await expect(page.getByTestId('activity-list')).toContainText('Alice Johnson', { timeout: 30000 });\n   349→\n   350→    // Verify there's exactly one activity entry (the creation)\n   351→    const activityEntries = page.getByTestId('activity-list').locator('[data-testid^=\"activity-entry-\"]');\n   352→    await expect(activityEntries).toHaveCount(1, { timeout: 30000 });\n   353→  });\n   354→\n   355→  test('Create Issue button is disabled during submission', async ({ page, baseURL }) => {\n   356→    test.slow();\n   357→    await loginAndOpenCreateModal(page, baseURL!);\n   358→\n   359→    const uniqueTitle = `Disabled btn test ${Date.now()}`;\n   360→    await page.getByTestId('create-issue-title-input').fill(uniqueTitle);\n   361→\n   362→    const submitBtn = page.getByTestId('create-issue-submit-btn');\n   363→\n   364→    // Click Create Issue\n   365→    await submitBtn.click();\n   366→\n   367→    // The button should become disabled while submitting\n   368→    await expect(submitBtn).toBeDisabled({ timeout: 10000 });\n   369→    await expect(submitBtn).toContainText('Creating...');\n   370→\n   371→    // After submission completes, wait for success or the modal to close\n   372→    await expect(page.getByTestId('create-issue-success')).toBeVisible({ timeout: 30000 });\n   373→    await expect(page.getByTestId('create-issue-modal')).toHaveCount(0, { timeout: 30000 });\n   374→  });\n   375→\n   376→  test('Clicking outside the modal closes it', async ({ page, baseURL }) => {\n   377→    await loginAndOpenCreateModal(page, baseURL!);\n   378→\n   379→    // Click on the overlay (outside the modal)\n   380→    const overlay = page.getByTestId('create-issue-modal-overlay');\n   381→    // Click the overlay at position near the edge to ensure it's outside the modal\n   382→    await overlay.click({ position: { x: 10, y: 10 } });\n   383→\n   384→    // Verify the modal closes without creating an issue\n   385→    await expect(page.getByTestId('create-issue-modal')).toHaveCount(0, { timeout: 10000 });\n   386→\n   387→    // Verify we're still on the team issues page\n   388→    await expect(page.getByTestId('team-issues-page')).toBeVisible();\n   389→  });\n   390→\n   391→  test('Pressing Escape closes the modal', async ({ page, baseURL }) => {\n   392→    await loginAndOpenCreateModal(page, baseURL!);\n   393→\n   394→    // Press the Escape key\n   395→    await page.keyboard.press('Escape');\n   396→\n   397→    // Verify the modal closes without creating an issue\n   398→    await expect(page.getByTestId('create-issue-modal')).toHaveCount(0, { timeout: 10000 });\n   399→\n   400→    // Verify we're still on the team issues page\n   401→    await expect(page.getByTestId('team-issues-page')).toBeVisible();\n   402→  });\n   403→\n   404→  test('Creating multiple issues in sequence works correctly', async ({ page, baseURL }) => {\n   405→    test.slow();\n   406→    const { token, team } = await loginAndNavigateToTeamIssues(page, baseURL!);\n   407→\n   408→    const firstTitle = `First task ${Date.now()}`;\n   409→    const secondTitle = `Second task ${Date.now()}`;\n   410→\n   411→    // Create first issue\n   412→    await page.getByTestId('new-issue-btn').click();\n   413→    await expect(page.getByTestId('create-issue-modal')).toBeVisible({ timeout: 30000 });\n   414→    await page.getByTestId('create-issue-title-input').fill(firstTitle);\n   415→    await page.getByTestId('create-issue-submit-btn').click();\n   416→\n   417→    // Wait for success and capture identifier\n   418→    await expect(page.getByTestId('create-issue-success')).toBeVisible({ timeout: 30000 });\n   419→    const firstSuccessText = await page.getByTestId('create-issue-success').textContent();\n   420→    const firstIdentifierMatch = firstSuccessText?.match(/(ENG-\\d+)/);\n   421→    const firstIdentifier = firstIdentifierMatch ? firstIdentifierMatch[1] : '';\n   422→    expect(firstIdentifier).toBeTruthy();\n   423→\n   424→    // Wait for modal to close\n   425→    await expect(page.getByTestId('create-issue-modal')).toHaveCount(0, { timeout: 30000 });\n   426→\n   427→    // Create second issue\n   428→    await page.getByTestId('new-issue-btn').click();\n   429→    await expect(page.getByTestId('create-issue-modal')).toBeVisible({ timeout: 30000 });\n   430→\n   431→    // Verify the modal has reset - title should be empty\n   432→    await expect(page.getByTestId('create-issue-title-input')).toHaveValue('');\n   433→\n   434→    await page.getByTestId('create-issue-title-input').fill(secondTitle);\n   435→    await page.getByTestId('create-issue-submit-btn').click();\n   436→\n   437→    // Wait for success and capture identifier\n   438→    await expect(page.getByTestId('create-issue-success')).toBeVisible({ timeout: 30000 });\n   439→    const secondSuccessText = await page.getByTestId('create-issue-success').textContent();\n   440→    const secondIdentifierMatch = secondSuccessText?.match(/(ENG-\\d+)/);\n   441→    const secondIdentifier = secondIdentifierMatch ? secondIdentifierMatch[1] : '';\n   442→    expect(secondIdentifier).toBeTruthy();\n   443→\n   444→    // Verify sequential identifiers\n   445→    const firstNum = parseInt(firstIdentifier.replace('ENG-', ''));\n   446→    const secondNum = parseInt(secondIdentifier.replace('ENG-', ''));\n   447→    expect(secondNum).toBe(firstNum + 1);\n   448→\n   449→    // Wait for modal to close\n   450→    await expect(page.getByTestId('create-issue-modal')).toHaveCount(0, { timeout: 30000 });\n   451→\n   452→    // Verify both issues appear in the team issues list\n   453→    await expect(page.getByTestId('team-issues-list')).toContainText(firstTitle, { timeout: 30000 });\n   454→    await expect(page.getByTestId('team-issues-list')).toContainText(secondTitle, { timeout: 30000 });\n   455→  });\n   456→\n   457→  test('Created issue generates inbox notification for assignee', async ({ page, baseURL }) => {\n   458→    test.slow();\n   459→\n   460→    // Login as Alice and create an issue assigned to Bob\n   461→    const { token, team } = await loginAndOpenCreateModal(page, baseURL!);\n   462→\n   463→    const uniqueTitle = `Review PR ${Date.now()}`;\n   464→\n   465→    await page.getByTestId('create-issue-title-input').fill(uniqueTitle);\n   466→\n   467→    // Assign to Bob Smith\n   468→    await page.getByTestId('create-issue-assignee-selector').click();\n   469→    await expect(page.getByTestId('create-issue-assignee-dropdown')).toBeVisible();\n   470→    await page.getByTestId('create-issue-assignee-search').fill('Bob');\n   471→    const bobOption = page.getByTestId('create-issue-assignee-dropdown').locator('button').filter({ hasText: /Bob Smith/ });\n   472→    await expect(bobOption).toBeVisible({ timeout: 10000 });\n   473→    await bobOption.click();\n   474→    await expect(page.getByTestId('create-issue-assignee-selector')).toContainText('Bob Smith');\n   475→\n   476→    // Submit\n   477→    await page.getByTestId('create-issue-submit-btn').click();\n   478→    await expect(page.getByTestId('create-issue-success')).toBeVisible({ timeout: 30000 });\n   479→    await expect(page.getByTestId('create-issue-modal')).toHaveCount(0, { timeout: 30000 });\n   480→\n   481→    // Now login as Bob and check inbox\n   482→    const bobData = await loginViaApi(baseURL!, 'bob@acme.com', 'password123');\n   483→    await page.evaluate((t) => localStorage.setItem('session_token', t), bobData.token);\n   484→    await page.goto('/inbox');\n   485→    await expect(page.getByTestId('inbox-page')).toBeVisible({ timeout: 30000 });\n   486→\n   487→    // Verify a notification exists for the assigned issue\n   488→    await expect(page.getByTestId('notification-list-items')).toBeVisible({ timeout: 30000 });\n   489→\n   490→    // The notification message should contain \"Alice Johnson assigned you to ENG-X: Review PR ...\"\n   491→    const notificationItems = page.getByTestId('notification-list-items');\n   492→    await expect(notificationItems).toContainText('Alice Johnson assigned you to', { timeout: 30000 });\n   493→    await expect(notificationItems).toContainText(uniqueTitle, { timeout: 30000 });\n   494→  });\n   495→});\n   496→"}]},"parent_tool_use_id":null,"session_id":"1e17ab70-0a33-4d2a-af23-66b102e400e2","uuid":"f6e5e6b2-60fb-4ee8-a71f-99e23b2d6509","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/tests/create-issue-modal-actions-integration.spec.ts","content":"import { test, expect } from '@playwright/test';\n\n// Helper to login via API and get token\nasync function loginViaApi(baseURL: string, email: string, password: string) {\n  const response = await fetch(`${baseURL}/api/login`, {\n    method: 'POST',\n    headers: { 'Content-Type': 'application/json' },\n    body: JSON.stringify({ email, password }),\n  });\n  return response.json();\n}\n\n// Helper to get teams via API\nasync function getTeams(baseURL: string, token: string) {\n  const response = await fetch(`${baseURL}/api/teams`, {\n    headers: { Authorization: `Bearer ${token}` },\n  });\n  const data = await response.json();\n  return data.teams;\n}\n\n// Helper to login and navigate to team issues page\nasync function loginAndNavigateToTeamIssues(\n  page: import('@playwright/test').Page,\n  baseURL: string,\n  teamIdentifier = 'ENG',\n  email = 'alice@acme.com',\n  password = 'password123'\n) {\n  const data = await loginViaApi(baseURL, email, password);\n  const teams = await getTeams(baseURL, data.token);\n  const team = teams.find((t: { identifier: string }) => t.identifier === teamIdentifier);\n\n  await page.goto('/login');\n  await page.evaluate((t) => localStorage.setItem('session_token', t), data.token);\n  await page.goto(`/team/${team.id}/issues`);\n  await expect(page.getByTestId('team-issues-page')).toBeVisible({ timeout: 30000 });\n\n  return { token: data.token, user: data.user, team, teams };\n}\n\n// Helper to login and open create issue modal from a team page\nasync function loginAndOpenCreateModal(\n  page: import('@playwright/test').Page,\n  baseURL: string,\n  teamIdentifier = 'ENG',\n  email = 'alice@acme.com',\n  password = 'password123'\n) {\n  const result = await loginAndNavigateToTeamIssues(page, baseURL, teamIdentifier, email, password);\n\n  await page.getByTestId('new-issue-btn').click();\n  await expect(page.getByTestId('create-issue-modal')).toBeVisible({ timeout: 30000 });\n\n  return result;\n}\n\n// Helper to delete all non-seed issues via API\nasync function deleteCreatedIssues(baseURL: string, token: string, teamId: string) {\n  const response = await fetch(`${baseURL}/api/team-issues?teamId=${teamId}`, {\n    headers: { Authorization: `Bearer ${token}` },\n  });\n  if (response.ok) {\n    const data = await response.json();\n    const issues = data.issues || [];\n    // Seed data has issues numbered 1-8 for ENG; delete any with number > 8\n    for (const issue of issues) {\n      if (issue.number > 8) {\n        try {\n          await fetch(`${baseURL}/api/update-issue`, {\n            method: 'PUT',\n            headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },\n            body: JSON.stringify({ id: issue.id, status: 'cancelled' }),\n          });\n        } catch {\n          // ignore\n        }\n      }\n    }\n  }\n}\n\ntest.describe('CreateIssueModalActions', () => {\n  test('Create Issue button is visible and styled', async ({ page, baseURL }) => {\n    await loginAndOpenCreateModal(page, baseURL!);\n\n    // Verify Create Issue button is visible\n    const submitBtn = page.getByTestId('create-issue-submit-btn');\n    await expect(submitBtn).toBeVisible();\n    await expect(submitBtn).toContainText('Create Issue');\n\n    // Verify it's in the actions area at the bottom of the modal\n    await expect(page.getByTestId('create-issue-actions')).toBeVisible();\n\n    // Verify the button has primary styling (cia-submit-btn class)\n    await expect(submitBtn).toHaveClass(/cia-submit-btn/);\n  });\n\n  test('Cancel button is visible', async ({ page, baseURL }) => {\n    await loginAndOpenCreateModal(page, baseURL!);\n\n    // Verify Cancel button is visible alongside Create Issue button\n    const cancelBtn = page.getByTestId('create-issue-cancel-btn');\n    await expect(cancelBtn).toBeVisible();\n    await expect(cancelBtn).toContainText('Cancel');\n\n    // Both buttons are in the actions area\n    const submitBtn = page.getByTestId('create-issue-submit-btn');\n    await expect(submitBtn).toBeVisible();\n  });\n\n  test('Cancel button closes the modal', async ({ page, baseURL }) => {\n    await loginAndOpenCreateModal(page, baseURL!);\n\n    // Click the Cancel button\n    await page.getByTestId('create-issue-cancel-btn').click();\n\n    // Verify the modal closes\n    await expect(page.getByTestId('create-issue-modal')).toHaveCount(0, { timeout: 10000 });\n\n    // Verify the user is still on the team issues page\n    await expect(page.getByTestId('team-issues-page')).toBeVisible();\n  });\n\n  test('Cancel button discards form data', async ({ page, baseURL }) => {\n    await loginAndOpenCreateModal(page, baseURL!);\n\n    // Enter some data\n    await page.getByTestId('create-issue-title-input').fill('Draft issue');\n\n    // Change priority to High\n    await page.getByTestId('create-issue-priority-selector').click();\n    await expect(page.getByTestId('create-issue-priority-dropdown')).toBeVisible();\n    await page.getByTestId('create-issue-priority-option-high').click();\n    await expect(page.getByTestId('create-issue-priority-selector')).toContainText('High');\n\n    // Click Cancel\n    await page.getByTestId('create-issue-cancel-btn').click();\n    await expect(page.getByTestId('create-issue-modal')).toHaveCount(0, { timeout: 10000 });\n\n    // Re-open the modal\n    await page.getByTestId('new-issue-btn').click();\n    await expect(page.getByTestId('create-issue-modal')).toBeVisible({ timeout: 30000 });\n\n    // Verify all fields are reset to defaults\n    await expect(page.getByTestId('create-issue-title-input')).toHaveValue('');\n    await expect(page.getByTestId('create-issue-status-selector')).toContainText('Backlog');\n    await expect(page.getByTestId('create-issue-priority-selector')).toContainText('No Priority');\n  });\n\n  test('Create Issue button submits the form with all fields', async ({ page, baseURL }) => {\n    test.slow();\n    const { token, team } = await loginAndOpenCreateModal(page, baseURL!);\n\n    const uniqueTitle = `Implement OAuth ${Date.now()}`;\n\n    // Fill in all fields\n    await page.getByTestId('create-issue-title-input').fill(uniqueTitle);\n    await page.getByTestId('create-issue-description-input').fill('Add OAuth support');\n\n    // Set status to Todo\n    await page.getByTestId('create-issue-status-selector').click();\n    await expect(page.getByTestId('create-issue-status-dropdown')).toBeVisible();\n    await page.getByTestId('create-issue-status-option-todo').click();\n\n    // Set priority to High\n    await page.getByTestId('create-issue-priority-selector').click();\n    await expect(page.getByTestId('create-issue-priority-dropdown')).toBeVisible();\n    await page.getByTestId('create-issue-priority-option-high').click();\n\n    // Set assignee to Alice Johnson\n    await page.getByTestId('create-issue-assignee-selector').click();\n    await expect(page.getByTestId('create-issue-assignee-dropdown')).toBeVisible();\n    await page.getByTestId('create-issue-assignee-search').fill('Alice');\n    const aliceOption = page.getByTestId('create-issue-assignee-dropdown').locator('button').filter({ hasText: /Alice Johnson/ });\n    await expect(aliceOption).toBeVisible({ timeout: 10000 });\n    await aliceOption.click();\n\n    // Set label to Feature\n    await page.getByTestId('create-issue-labels-selector').click();\n    await expect(page.getByTestId('create-issue-labels-dropdown')).toBeVisible();\n    const featureOption = page.getByTestId('create-issue-labels-dropdown').locator('button').filter({ hasText: /^Feature$/ });\n    await featureOption.click();\n    await page.getByTestId('create-issue-title-input').click(); // close labels dropdown\n\n    // Set project to V2 Launch\n    await page.getByTestId('create-issue-project-selector').click();\n    await expect(page.getByTestId('create-issue-project-dropdown')).toBeVisible();\n    const projectOption = page.getByTestId('create-issue-project-dropdown').locator('button').filter({ hasText: /V2 Launch/ });\n    await expect(projectOption).toBeVisible({ timeout: 10000 });\n    await projectOption.click();\n\n    // Set cycle to Sprint 12\n    await page.getByTestId('create-issue-cycle-selector').click();\n    await expect(page.getByTestId('create-issue-cycle-dropdown')).toBeVisible();\n    const cycleOption = page.getByTestId('create-issue-cycle-dropdown').locator('button').filter({ hasText: /Sprint 12/ });\n    await expect(cycleOption).toBeVisible({ timeout: 10000 });\n    await cycleOption.click();\n\n    // Set due date\n    await page.getByTestId('create-issue-due-date-input').fill('2026-03-25');\n\n    // Click Create Issue\n    await page.getByTestId('create-issue-submit-btn').click();\n\n    // Verify success indicator with issue identifier\n    await expect(page.getByTestId('create-issue-success')).toBeVisible({ timeout: 30000 });\n    await expect(page.getByTestId('create-issue-success')).toContainText('ENG-');\n\n    // Verify modal closes\n    await expect(page.getByTestId('create-issue-modal')).toHaveCount(0, { timeout: 30000 });\n  });\n\n  test('Create Issue with only required fields', async ({ page, baseURL }) => {\n    test.slow();\n    await loginAndOpenCreateModal(page, baseURL!);\n\n    const uniqueTitle = `Quick bug fix ${Date.now()}`;\n\n    // Only fill in title (required) - team is already pre-selected\n    await page.getByTestId('create-issue-title-input').fill(uniqueTitle);\n\n    // Click Create Issue\n    await page.getByTestId('create-issue-submit-btn').click();\n\n    // Verify success indicator with issue identifier\n    await expect(page.getByTestId('create-issue-success')).toBeVisible({ timeout: 30000 });\n    await expect(page.getByTestId('create-issue-success')).toContainText('ENG-');\n\n    // Verify modal closes\n    await expect(page.getByTestId('create-issue-modal')).toHaveCount(0, { timeout: 30000 });\n  });\n\n  test('Created issue appears in the team issues list', async ({ page, baseURL }) => {\n    test.slow();\n    await loginAndNavigateToTeamIssues(page, baseURL!);\n\n    // Wait for issues to load\n    await expect(page.getByTestId('team-issues-list')).toBeVisible({ timeout: 30000 });\n    const initialRows = page.locator('[data-testid^=\"issue-row-\"]');\n    await expect(initialRows).toHaveCount(8, { timeout: 30000 });\n\n    const uniqueTitle = `New feature request ${Date.now()}`;\n\n    // Open modal and create issue with status \"Todo\"\n    await page.getByTestId('new-issue-btn').click();\n    await expect(page.getByTestId('create-issue-modal')).toBeVisible({ timeout: 30000 });\n\n    await page.getByTestId('create-issue-title-input').fill(uniqueTitle);\n\n    // Set status to Todo\n    await page.getByTestId('create-issue-status-selector').click();\n    await expect(page.getByTestId('create-issue-status-dropdown')).toBeVisible();\n    await page.getByTestId('create-issue-status-option-todo').click();\n\n    await page.getByTestId('create-issue-submit-btn').click();\n    await expect(page.getByTestId('create-issue-success')).toBeVisible({ timeout: 30000 });\n    await expect(page.getByTestId('create-issue-modal')).toHaveCount(0, { timeout: 30000 });\n\n    // Verify the new issue appears in the list (count increased by 1)\n    await expect(page.locator('[data-testid^=\"issue-row-\"]')).toHaveCount(9, { timeout: 30000 });\n\n    // Verify the issue title appears in the todo status group\n    const todoGroup = page.getByTestId('team-issue-group-items-todo');\n    await expect(todoGroup).toContainText(uniqueTitle, { timeout: 30000 });\n  });\n\n  test('Created issue with parent appears as sub-issue', async ({ page, baseURL }) => {\n    test.slow();\n    const { token, team } = await loginAndOpenCreateModal(page, baseURL!);\n\n    const uniqueTitle = `Write unit tests ${Date.now()}`;\n\n    // Fill title\n    await page.getByTestId('create-issue-title-input').fill(uniqueTitle);\n\n    // Select parent issue: ENG-1 (Fix login session expiration bug)\n    await page.getByTestId('create-issue-parent-selector').click();\n    await expect(page.getByTestId('create-issue-parent-dropdown')).toBeVisible();\n    await page.getByTestId('create-issue-parent-search').fill('Fix login');\n    const parentOption = page.getByTestId('create-issue-parent-dropdown').locator('button').filter({ hasText: /Fix login session expiration bug/ });\n    await expect(parentOption).toBeVisible({ timeout: 10000 });\n    await parentOption.click();\n    await expect(page.getByTestId('create-issue-parent-selector')).toContainText('ENG-1');\n\n    // Submit\n    await page.getByTestId('create-issue-submit-btn').click();\n    await expect(page.getByTestId('create-issue-success')).toBeVisible({ timeout: 30000 });\n    await expect(page.getByTestId('create-issue-modal')).toHaveCount(0, { timeout: 30000 });\n\n    // Navigate to the parent issue detail page (ENG-1)\n    // First find the parent issue ID via search API\n    const searchResp = await fetch(`${baseURL}/api/search-issues?q=Fix+login&teamId=${team.id}`, {\n      headers: { Authorization: `Bearer ${token}` },\n    });\n    const searchData = await searchResp.json();\n    const parentIssue = searchData.issues.find((i: { identifier: string }) => i.identifier === 'ENG-1');\n\n    await page.goto(`/issue/${parentIssue.id}`);\n    await expect(page.getByTestId('issue-detail-page')).toBeVisible({ timeout: 30000 });\n\n    // Verify sub-issues section shows the new issue\n    await expect(page.getByTestId('sub-issues')).toBeVisible({ timeout: 30000 });\n    await expect(page.getByTestId('sub-issues-list')).toBeVisible({ timeout: 30000 });\n    await expect(page.getByTestId('sub-issues-list')).toContainText(uniqueTitle, { timeout: 30000 });\n  });\n\n  test('Created issue generates activity history entry', async ({ page, baseURL }) => {\n    test.slow();\n    await loginAndOpenCreateModal(page, baseURL!);\n\n    const uniqueTitle = `Track history ${Date.now()}`;\n\n    // Create issue\n    await page.getByTestId('create-issue-title-input').fill(uniqueTitle);\n    await page.getByTestId('create-issue-submit-btn').click();\n\n    // Wait for success and get the identifier\n    await expect(page.getByTestId('create-issue-success')).toBeVisible({ timeout: 30000 });\n    const successText = await page.getByTestId('create-issue-success').textContent();\n    // Extract identifier like \"ENG-9\" from \"Created ENG-9\"\n    const identifierMatch = successText?.match(/(ENG-\\d+)/);\n    const identifier = identifierMatch ? identifierMatch[1] : '';\n\n    await expect(page.getByTestId('create-issue-modal')).toHaveCount(0, { timeout: 30000 });\n\n    // Find the issue ID via search API\n    const loginData = await loginViaApi(baseURL!, 'alice@acme.com', 'password123');\n    const teams = await getTeams(baseURL!, loginData.token);\n    const engTeam = teams.find((t: { identifier: string }) => t.identifier === 'ENG');\n\n    const searchResp = await fetch(`${baseURL}/api/search-issues?q=${encodeURIComponent(uniqueTitle)}&teamId=${engTeam.id}`, {\n      headers: { Authorization: `Bearer ${loginData.token}` },\n    });\n    const searchData = await searchResp.json();\n    const createdIssue = searchData.issues.find((i: { title: string }) => i.title === uniqueTitle);\n\n    // Navigate to the issue detail page\n    await page.goto(`/issue/${createdIssue.id}`);\n    await expect(page.getByTestId('issue-detail-page')).toBeVisible({ timeout: 30000 });\n\n    // Click on Activity tab\n    await page.getByTestId('activity-tab').click();\n\n    // Verify \"created this issue\" activity entry exists\n    await expect(page.getByTestId('activity-list')).toBeVisible({ timeout: 30000 });\n    await expect(page.getByTestId('activity-list')).toContainText('created this issue', { timeout: 30000 });\n    await expect(page.getByTestId('activity-list')).toContainText('Alice Johnson', { timeout: 30000 });\n\n    // Verify there's exactly one activity entry (the creation)\n    const activityEntries = page.getByTestId('activity-list').locator('[data-testid^=\"activity-entry-\"]');\n    await expect(activityEntries).toHaveCount(1, { timeout: 30000 });\n  });\n\n  test('Create Issue button is disabled during submission', async ({ page, baseURL }) => {\n    test.slow();\n    await loginAndOpenCreateModal(page, baseURL!);\n\n    const uniqueTitle = `Disabled btn test ${Date.now()}`;\n    await page.getByTestId('create-issue-title-input').fill(uniqueTitle);\n\n    const submitBtn = page.getByTestId('create-issue-submit-btn');\n\n    // Click Create Issue\n    await submitBtn.click();\n\n    // The button should become disabled while submitting\n    await expect(submitBtn).toBeDisabled({ timeout: 10000 });\n    await expect(submitBtn).toContainText('Creating...');\n\n    // After submission completes, wait for success or the modal to close\n    await expect(page.getByTestId('create-issue-success')).toBeVisible({ timeout: 30000 });\n    await expect(page.getByTestId('create-issue-modal')).toHaveCount(0, { timeout: 30000 });\n  });\n\n  test('Clicking outside the modal closes it', async ({ page, baseURL }) => {\n    await loginAndOpenCreateModal(page, baseURL!);\n\n    // Click on the overlay (outside the modal)\n    const overlay = page.getByTestId('create-issue-modal-overlay');\n    // Click the overlay at position near the edge to ensure it's outside the modal\n    await overlay.click({ position: { x: 10, y: 10 } });\n\n    // Verify the modal closes without creating an issue\n    await expect(page.getByTestId('create-issue-modal')).toHaveCount(0, { timeout: 10000 });\n\n    // Verify we're still on the team issues page\n    await expect(page.getByTestId('team-issues-page')).toBeVisible();\n  });\n\n  test('Pressing Escape closes the modal', async ({ page, baseURL }) => {\n    await loginAndOpenCreateModal(page, baseURL!);\n\n    // Press the Escape key\n    await page.keyboard.press('Escape');\n\n    // Verify the modal closes without creating an issue\n    await expect(page.getByTestId('create-issue-modal')).toHaveCount(0, { timeout: 10000 });\n\n    // Verify we're still on the team issues page\n    await expect(page.getByTestId('team-issues-page')).toBeVisible();\n  });\n\n  test('Creating multiple issues in sequence works correctly', async ({ page, baseURL }) => {\n    test.slow();\n    const { token, team } = await loginAndNavigateToTeamIssues(page, baseURL!);\n\n    const firstTitle = `First task ${Date.now()}`;\n    const secondTitle = `Second task ${Date.now()}`;\n\n    // Create first issue\n    await page.getByTestId('new-issue-btn').click();\n    await expect(page.getByTestId('create-issue-modal')).toBeVisible({ timeout: 30000 });\n    await page.getByTestId('create-issue-title-input').fill(firstTitle);\n    await page.getByTestId('create-issue-submit-btn').click();\n\n    // Wait for success and capture identifier\n    await expect(page.getByTestId('create-issue-success')).toBeVisible({ timeout: 30000 });\n    const firstSuccessText = await page.getByTestId('create-issue-success').textContent();\n    const firstIdentifierMatch = firstSuccessText?.match(/(ENG-\\d+)/);\n    const firstIdentifier = firstIdentifierMatch ? firstIdentifierMatch[1] : '';\n    expect(firstIdentifier).toBeTruthy();\n\n    // Wait for modal to close\n    await expect(page.getByTestId('create-issue-modal')).toHaveCount(0, { timeout: 30000 });\n\n    // Create second issue\n    await page.getByTestId('new-issue-btn').click();\n    await expect(page.getByTestId('create-issue-modal')).toBeVisible({ timeout: 30000 });\n\n    // Verify the modal has reset - title should be empty\n    await expect(page.getByTestId('create-issue-title-input')).toHaveValue('');\n\n    await page.getByTestId('create-issue-title-input').fill(secondTitle);\n    await page.getByTestId('create-issue-submit-btn').click();\n\n    // Wait for success and capture identifier\n    await expect(page.getByTestId('create-issue-success')).toBeVisible({ timeout: 30000 });\n    const secondSuccessText = await page.getByTestId('create-issue-success').textContent();\n    const secondIdentifierMatch = secondSuccessText?.match(/(ENG-\\d+)/);\n    const secondIdentifier = secondIdentifierMatch ? secondIdentifierMatch[1] : '';\n    expect(secondIdentifier).toBeTruthy();\n\n    // Verify sequential identifiers\n    const firstNum = parseInt(firstIdentifier.replace('ENG-', ''));\n    const secondNum = parseInt(secondIdentifier.replace('ENG-', ''));\n    expect(secondNum).toBe(firstNum + 1);\n\n    // Wait for modal to close\n    await expect(page.getByTestId('create-issue-modal')).toHaveCount(0, { timeout: 30000 });\n\n    // Verify both issues appear in the team issues list\n    await expect(page.getByTestId('team-issues-list')).toContainText(firstTitle, { timeout: 30000 });\n    await expect(page.getByTestId('team-issues-list')).toContainText(secondTitle, { timeout: 30000 });\n  });\n\n  test('Created issue generates inbox notification for assignee', async ({ page, baseURL }) => {\n    test.slow();\n\n    // Login as Alice and create an issue assigned to Bob\n    const { token, team } = await loginAndOpenCreateModal(page, baseURL!);\n\n    const uniqueTitle = `Review PR ${Date.now()}`;\n\n    await page.getByTestId('create-issue-title-input').fill(uniqueTitle);\n\n    // Assign to Bob Smith\n    await page.getByTestId('create-issue-assignee-selector').click();\n    await expect(page.getByTestId('create-issue-assignee-dropdown')).toBeVisible();\n    await page.getByTestId('create-issue-assignee-search').fill('Bob');\n    const bobOption = page.getByTestId('create-issue-assignee-dropdown').locator('button').filter({ hasText: /Bob Smith/ });\n    await expect(bobOption).toBeVisible({ timeout: 10000 });\n    await bobOption.click();\n    await expect(page.getByTestId('create-issue-assignee-selector')).toContainText('Bob Smith');\n\n    // Submit\n    await page.getByTestId('create-issue-submit-btn').click();\n    await expect(page.getByTestId('create-issue-success')).toBeVisible({ timeout: 30000 });\n    await expect(page.getByTestId('create-issue-modal')).toHaveCount(0, { timeout: 30000 });\n\n    // Now login as Bob and check inbox\n    const bobData = await loginViaApi(baseURL!, 'bob@acme.com', 'password123');\n    await page.evaluate((t) => localStorage.setItem('session_token', t), bobData.token);\n    await page.goto('/inbox');\n    await expect(page.getByTestId('inbox-page')).toBeVisible({ timeout: 30000 });\n\n    // Verify a notification exists for the assigned issue\n    await expect(page.getByTestId('notification-list-items')).toBeVisible({ timeout: 30000 });\n\n    // The notification message should contain \"Alice Johnson assigned you to ENG-X: Review PR ...\"\n    const notificationItems = page.getByTestId('notification-list-items');\n    await expect(notificationItems).toContainText('Alice Johnson assigned you to', { timeout: 30000 });\n    await expect(notificationItems).toContainText(uniqueTitle, { timeout: 30000 });\n  });\n});\n","numLines":496,"startLine":1,"totalLines":496}}}
