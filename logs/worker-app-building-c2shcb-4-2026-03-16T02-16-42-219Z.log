[2026-03-16T01:46:48.862Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HWZGikH7RXMkLk3aPB32yn","type":"tool_result","content":"     1→import { useState, useEffect, useRef, useCallback } from 'react';\n     2→import { useSelector } from 'react-redux';\n     3→import type { RootState } from '../store';\n     4→import { StatusIcon, PriorityIcon, STATUS_CONFIG, STATUS_ORDER } from './IssueRow';\n     5→import './CreateIssueForm.css';\n     6→\n     7→const PRIORITY_ORDER = ['urgent', 'high', 'medium', 'low', 'none'] as const;\n     8→const PRIORITY_LABELS: Record<string, string> = {\n     9→  urgent: 'Urgent',\n    10→  high: 'High',\n    11→  medium: 'Medium',\n    12→  low: 'Low',\n    13→  none: 'No Priority',\n    14→};\n    15→\n    16→interface SearchableIssue {\n    17→  id: string;\n    18→  title: string;\n    19→  identifier: string;\n    20→}\n    21→\n    22→export interface CreateIssueFormData {\n    23→  teamId: string;\n    24→  title: string;\n    25→  description: string;\n    26→  status: string;\n    27→  priority: string;\n    28→  assigneeId: string | null;\n    29→  labelIds: string[];\n    30→  projectId: string | null;\n    31→  cycleId: string | null;\n    32→  dueDate: string | null;\n    33→  parentId: string | null;\n    34→}\n    35→\n    36→interface CreateIssueFormProps {\n    37→  defaultTeamId?: string;\n    38→  formData: CreateIssueFormData;\n    39→  onFormChange: (data: CreateIssueFormData) => void;\n    40→  titleError: string | null;\n    41→}\n    42→\n    43→type DropdownType = 'team' | 'status' | 'priority' | 'assignee' | 'labels' | 'project' | 'cycle' | 'parent' | null;\n    44→\n    45→export default function CreateIssueForm({ defaultTeamId, formData, onFormChange, titleError }: CreateIssueFormProps) {\n    46→  const { items: teams } = useSelector((state: RootState) => state.teams);\n    47→  const { items: labels } = useSelector((state: RootState) => state.labels);\n    48→  const token = useSelector((state: RootState) => state.auth.token);\n    49→\n    50→  const [openDropdown, setOpenDropdown] = useState<DropdownType>(null);\n    51→  const [assigneeSearch, setAssigneeSearch] = useState('');\n    52→  const [projectSearch, setProjectSearch] = useState('');\n    53→  const [parentSearch, setParentSearch] = useState('');\n    54→  const [parentResults, setParentResults] = useState<SearchableIssue[]>([]);\n    55→\n    56→  // Team-specific data (members, projects, cycles)\n    57→  const [teamMembers, setTeamMembers] = useState<Array<{ id: string; name: string; email: string }>>([]);\n    58→  const [teamProjects, setTeamProjects] = useState<Array<{ id: string; name: string }>>([]);\n    59→  const [teamCycles, setTeamCycles] = useState<Array<{ id: string; name: string; start_date: string; end_date: string }>>([]);\n    60→\n    61→  const formRef = useRef<HTMLDivElement>(null);\n    62→  const titleRef = useRef<HTMLInputElement>(null);\n    63→\n    64→  // Focus title on mount\n    65→  useEffect(() => {\n    66→    titleRef.current?.focus();\n    67→  }, []);\n    68→\n    69→  // Set default team\n    70→  useEffect(() => {\n    71→    if (defaultTeamId && !formData.teamId) {\n    72→      onFormChange({ ...formData, teamId: defaultTeamId });\n    73→    } else if (!formData.teamId && teams.length > 0 && teams[0]) {\n    74→      onFormChange({ ...formData, teamId: teams[0].id });\n    75→    }\n    76→  }, [defaultTeamId, teams]); // eslint-disable-line react-hooks/exhaustive-deps\n    77→\n    78→  // Fetch team-specific data when team changes\n    79→  const fetchTeamData = useCallback(async (teamId: string) => {\n    80→    if (!token || !teamId) return;\n    81→    try {\n    82→      const response = await fetch(`/api/team-issues?teamId=${teamId}`, {\n    83→        headers: { Authorization: `Bearer ${token}` },\n    84→      });\n    85→      if (response.ok) {\n    86→        const data = await response.json();\n    87→        setTeamMembers(data.members || []);\n    88→        setTeamProjects(data.projects || []);\n    89→        setTeamCycles(data.cycles || []);\n    90→      }\n    91→    } catch {\n    92→      // silently fail\n    93→    }\n    94→  }, [token]);\n    95→\n    96→  useEffect(() => {\n    97→    if (formData.teamId) {\n    98→      fetchTeamData(formData.teamId);\n    99→    }\n   100→  }, [formData.teamId, fetchTeamData]);\n   101→\n   102→  // Search parent issues\n   103→  useEffect(() => {\n   104→    if (!token || openDropdown !== 'parent') return;\n   105→    const controller = new AbortController();\n   106→    const fetchParents = async () => {\n   107→      try {\n   108→        const params = new URLSearchParams();\n   109→        if (parentSearch) params.set('q', parentSearch);\n   110→        if (formData.teamId) params.set('teamId', formData.teamId);\n   111→        const response = await fetch(`/api/search-issues?${params}`, {\n   112→          headers: { Authorization: `Bearer ${token}` },\n   113→          signal: controller.signal,\n   114→        });\n   115→        if (response.ok) {\n   116→          const data = await response.json();\n   117→          setParentResults(data.issues || []);\n   118→        }\n   119→      } catch {\n   120→        // ignore abort errors\n   121→      }\n   122→    };\n   123→    const timer = setTimeout(fetchParents, 200);\n   124→    return () => {\n   125→      clearTimeout(timer);\n   126→      controller.abort();\n   127→    };\n   128→  }, [parentSearch, formData.teamId, token, openDropdown]);\n   129→\n   130→  // Close dropdown on outside click\n   131→  useEffect(() => {\n   132→    function handleClickOutside(e: MouseEvent) {\n   133→      if (formRef.current && !formRef.current.contains(e.target as Node)) {\n   134→        setOpenDropdown(null);\n   135→      }\n   136→    }\n   137→    if (openDropdown) {\n   138→      document.addEventListener('mousedown', handleClickOutside);\n   139→    }\n   140→    return () => document.removeEventListener('mousedown', handleClickOutside);\n   141→  }, [openDropdown]);\n   142→\n   143→  function updateField<K extends keyof CreateIssueFormData>(key: K, value: CreateIssueFormData[K]) {\n   144→    onFormChange({ ...formData, [key]: value });\n   145→  }\n   146→\n   147→  function toggleDropdown(type: DropdownType) {\n   148→    setOpenDropdown(openDropdown === type ? null : type);\n   149→    if (type === 'assignee') setAssigneeSearch('');\n   150→    if (type === 'project') setProjectSearch('');\n   151→    if (type === 'parent') setParentSearch('');\n   152→  }\n   153→\n   154→  function handleTeamChange(teamId: string) {\n   155→    onFormChange({ ...formData, teamId, cycleId: null });\n   156→    setOpenDropdown(null);\n   157→  }\n   158→\n   159→  function handleLabelToggle(labelId: string) {\n   160→    const current = formData.labelIds;\n   161→    if (current.includes(labelId)) {\n   162→      updateField('labelIds', current.filter((id) => id !== labelId));\n   163→    } else {\n   164→      updateField('labelIds', [...current, labelId]);\n   165→    }\n   166→  }\n   167→\n   168→  function handleRemoveLabel(labelId: string) {\n   169→    updateField('labelIds', formData.labelIds.filter((id) => id !== labelId));\n   170→  }"}]},"parent_tool_use_id":null,"session_id":"1e17ab70-0a33-4d2a-af23-66b102e400e2","uuid":"8d3b41b1-83e0-4b45-a684-d4a8a8d5d988","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/src/components/CreateIssueForm.tsx","content":"import { useState, useEffect, useRef, useCallback } from 'react';\nimport { useSelector } from 'react-redux';\nimport type { RootState } from '../store';\nimport { StatusIcon, PriorityIcon, STATUS_CONFIG, STATUS_ORDER } from './IssueRow';\nimport './CreateIssueForm.css';\n\nconst PRIORITY_ORDER = ['urgent', 'high', 'medium', 'low', 'none'] as const;\nconst PRIORITY_LABELS: Record<string, string> = {\n  urgent: 'Urgent',\n  high: 'High',\n  medium: 'Medium',\n  low: 'Low',\n  none: 'No Priority',\n};\n\ninterface SearchableIssue {\n  id: string;\n  title: string;\n  identifier: string;\n}\n\nexport interface CreateIssueFormData {\n  teamId: string;\n  title: string;\n  description: string;\n  status: string;\n  priority: string;\n  assigneeId: string | null;\n  labelIds: string[];\n  projectId: string | null;\n  cycleId: string | null;\n  dueDate: string | null;\n  parentId: string | null;\n}\n\ninterface CreateIssueFormProps {\n  defaultTeamId?: string;\n  formData: CreateIssueFormData;\n  onFormChange: (data: CreateIssueFormData) => void;\n  titleError: string | null;\n}\n\ntype DropdownType = 'team' | 'status' | 'priority' | 'assignee' | 'labels' | 'project' | 'cycle' | 'parent' | null;\n\nexport default function CreateIssueForm({ defaultTeamId, formData, onFormChange, titleError }: CreateIssueFormProps) {\n  const { items: teams } = useSelector((state: RootState) => state.teams);\n  const { items: labels } = useSelector((state: RootState) => state.labels);\n  const token = useSelector((state: RootState) => state.auth.token);\n\n  const [openDropdown, setOpenDropdown] = useState<DropdownType>(null);\n  const [assigneeSearch, setAssigneeSearch] = useState('');\n  const [projectSearch, setProjectSearch] = useState('');\n  const [parentSearch, setParentSearch] = useState('');\n  const [parentResults, setParentResults] = useState<SearchableIssue[]>([]);\n\n  // Team-specific data (members, projects, cycles)\n  const [teamMembers, setTeamMembers] = useState<Array<{ id: string; name: string; email: string }>>([]);\n  const [teamProjects, setTeamProjects] = useState<Array<{ id: string; name: string }>>([]);\n  const [teamCycles, setTeamCycles] = useState<Array<{ id: string; name: string; start_date: string; end_date: string }>>([]);\n\n  const formRef = useRef<HTMLDivElement>(null);\n  const titleRef = useRef<HTMLInputElement>(null);\n\n  // Focus title on mount\n  useEffect(() => {\n    titleRef.current?.focus();\n  }, []);\n\n  // Set default team\n  useEffect(() => {\n    if (defaultTeamId && !formData.teamId) {\n      onFormChange({ ...formData, teamId: defaultTeamId });\n    } else if (!formData.teamId && teams.length > 0 && teams[0]) {\n      onFormChange({ ...formData, teamId: teams[0].id });\n    }\n  }, [defaultTeamId, teams]); // eslint-disable-line react-hooks/exhaustive-deps\n\n  // Fetch team-specific data when team changes\n  const fetchTeamData = useCallback(async (teamId: string) => {\n    if (!token || !teamId) return;\n    try {\n      const response = await fetch(`/api/team-issues?teamId=${teamId}`, {\n        headers: { Authorization: `Bearer ${token}` },\n      });\n      if (response.ok) {\n        const data = await response.json();\n        setTeamMembers(data.members || []);\n        setTeamProjects(data.projects || []);\n        setTeamCycles(data.cycles || []);\n      }\n    } catch {\n      // silently fail\n    }\n  }, [token]);\n\n  useEffect(() => {\n    if (formData.teamId) {\n      fetchTeamData(formData.teamId);\n    }\n  }, [formData.teamId, fetchTeamData]);\n\n  // Search parent issues\n  useEffect(() => {\n    if (!token || openDropdown !== 'parent') return;\n    const controller = new AbortController();\n    const fetchParents = async () => {\n      try {\n        const params = new URLSearchParams();\n        if (parentSearch) params.set('q', parentSearch);\n        if (formData.teamId) params.set('teamId', formData.teamId);\n        const response = await fetch(`/api/search-issues?${params}`, {\n          headers: { Authorization: `Bearer ${token}` },\n          signal: controller.signal,\n        });\n        if (response.ok) {\n          const data = await response.json();\n          setParentResults(data.issues || []);\n        }\n      } catch {\n        // ignore abort errors\n      }\n    };\n    const timer = setTimeout(fetchParents, 200);\n    return () => {\n      clearTimeout(timer);\n      controller.abort();\n    };\n  }, [parentSearch, formData.teamId, token, openDropdown]);\n\n  // Close dropdown on outside click\n  useEffect(() => {\n    function handleClickOutside(e: MouseEvent) {\n      if (formRef.current && !formRef.current.contains(e.target as Node)) {\n        setOpenDropdown(null);\n      }\n    }\n    if (openDropdown) {\n      document.addEventListener('mousedown', handleClickOutside);\n    }\n    return () => document.removeEventListener('mousedown', handleClickOutside);\n  }, [openDropdown]);\n\n  function updateField<K extends keyof CreateIssueFormData>(key: K, value: CreateIssueFormData[K]) {\n    onFormChange({ ...formData, [key]: value });\n  }\n\n  function toggleDropdown(type: DropdownType) {\n    setOpenDropdown(openDropdown === type ? null : type);\n    if (type === 'assignee') setAssigneeSearch('');\n    if (type === 'project') setProjectSearch('');\n    if (type === 'parent') setParentSearch('');\n  }\n\n  function handleTeamChange(teamId: string) {\n    onFormChange({ ...formData, teamId, cycleId: null });\n    setOpenDropdown(null);\n  }\n\n  function handleLabelToggle(labelId: string) {\n    const current = formData.labelIds;\n    if (current.includes(labelId)) {\n      updateField('labelIds', current.filter((id) => id !== labelId));\n    } else {\n      updateField('labelIds', [...current, labelId]);\n    }\n  }\n\n  function handleRemoveLabel(labelId: string) {\n    updateField('labelIds', formData.labelIds.filter((id) => id !== labelId));\n  }","numLines":170,"startLine":1,"totalLines":603}}}
