[2026-03-16T02:11:04.585Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01P87X7akMcQUA56mbDtGVdy","type":"tool_result","content":"     1→import { useState, useEffect, useRef, useCallback } from 'react';\n     2→import { useSelector } from 'react-redux';\n     3→import type { RootState } from '../store';\n     4→import { StatusIcon, PriorityIcon, STATUS_CONFIG, STATUS_ORDER } from './IssueRow';\n     5→import './CreateIssueForm.css';\n     6→\n     7→const PRIORITY_ORDER = ['urgent', 'high', 'medium', 'low', 'none'] as const;\n     8→const PRIORITY_LABELS: Record<string, string> = {\n     9→  urgent: 'Urgent',\n    10→  high: 'High',\n    11→  medium: 'Medium',\n    12→  low: 'Low',\n    13→  none: 'No Priority',\n    14→};\n    15→\n    16→interface SearchableIssue {\n    17→  id: string;\n    18→  title: string;\n    19→  identifier: string;\n    20→}\n    21→\n    22→export interface CreateIssueFormData {\n    23→  teamId: string;\n    24→  title: string;\n    25→  description: string;\n    26→  status: string;\n    27→  priority: string;\n    28→  assigneeId: string | null;\n    29→  labelIds: string[];\n    30→  projectId: string | null;\n    31→  cycleId: string | null;\n    32→  dueDate: string | null;\n    33→  parentId: string | null;\n    34→}\n    35→\n    36→interface CreateIssueFormProps {\n    37→  defaultTeamId?: string;\n    38→  formData: CreateIssueFormData;\n    39→  onFormChange: (data: CreateIssueFormData) => void;\n    40→  titleError: string | null;\n    41→}\n    42→\n    43→type DropdownType = 'team' | 'status' | 'priority' | 'assignee' | 'labels' | 'project' | 'cycle' | 'parent' | null;\n    44→\n    45→export default function CreateIssueForm({ defaultTeamId, formData, onFormChange, titleError }: CreateIssueFormProps) {\n    46→  const { items: teams } = useSelector((state: RootState) => state.teams);\n    47→  const { items: labels } = useSelector((state: RootState) => state.labels);\n    48→  const token = useSelector((state: RootState) => state.auth.token);\n    49→\n    50→  const [openDropdown, setOpenDropdown] = useState<DropdownType>(null);\n    51→  const [assigneeSearch, setAssigneeSearch] = useState('');\n    52→  const [projectSearch, setProjectSearch] = useState('');\n    53→  const [parentSearch, setParentSearch] = useState('');\n    54→  const [parentResults, setParentResults] = useState<SearchableIssue[]>([]);\n    55→\n    56→  // Team-specific data (members, projects, cycles)\n    57→  const [teamMembers, setTeamMembers] = useState<Array<{ id: string; name: string; email: string }>>([]);\n    58→  const [teamProjects, setTeamProjects] = useState<Array<{ id: string; name: string }>>([]);\n    59→  const [teamCycles, setTeamCycles] = useState<Array<{ id: string; name: string; start_date: string; end_date: string }>>([]);\n    60→\n    61→  const formRef = useRef<HTMLDivElement>(null);\n    62→  const titleRef = useRef<HTMLInputElement>(null);\n    63→\n    64→  // Focus title on mount\n    65→  useEffect(() => {\n    66→    titleRef.current?.focus();\n    67→  }, []);\n    68→\n    69→  // Set default team\n    70→  useEffect(() => {\n    71→    if (defaultTeamId && !formData.teamId) {\n    72→      onFormChange({ ...formData, teamId: defaultTeamId });\n    73→    } else if (!formData.teamId && teams.length > 0 && teams[0]) {\n    74→      onFormChange({ ...formData, teamId: teams[0].id });\n    75→    }\n    76→  }, [defaultTeamId, teams]); // eslint-disable-line react-hooks/exhaustive-deps\n    77→\n    78→  // Fetch team-specific data when team changes\n    79→  const fetchTeamData = useCallback(async (teamId: string) => {\n    80→    if (!token || !teamId) return;\n    81→    try {\n    82→      const response = await fetch(`/api/team-issues?teamId=${teamId}`, {\n    83→        headers: { Authorization: `Bearer ${token}` },\n    84→      });\n    85→      if (response.ok) {\n    86→        const data = await response.json();\n    87→        setTeamMembers(data.members || []);\n    88→        setTeamProjects(data.projects || []);\n    89→        setTeamCycles(data.cycles || []);\n    90→      }\n    91→    } catch {\n    92→      // silently fail\n    93→    }\n    94→  }, [token]);\n    95→\n    96→  useEffect(() => {\n    97→    if (formData.teamId) {\n    98→      fetchTeamData(formData.teamId);\n    99→    }\n   100→  }, [formData.teamId, fetchTeamData]);\n   101→\n   102→  // Search parent issues\n   103→  useEffect(() => {\n   104→    if (!token || openDropdown !== 'parent') return;\n   105→    const controller = new AbortController();\n   106→    const fetchParents = async () => {\n   107→      try {\n   108→        const params = new URLSearchParams();\n   109→        if (parentSearch) params.set('q', parentSearch);\n   110→        if (formData.teamId) params.set('teamId', formData.teamId);\n   111→        const response = await fetch(`/api/search-issues?${params}`, {\n   112→          headers: { Authorization: `Bearer ${token}` },\n   113→          signal: controller.signal,\n   114→        });\n   115→        if (response.ok) {\n   116→          const data = await response.json();\n   117→          setParentResults(data.issues || []);\n   118→        }\n   119→      } catch {\n   120→        // ignore abort errors\n   121→      }\n   122→    };\n   123→    const timer = setTimeout(fetchParents, 200);\n   124→    return () => {\n   125→      clearTimeout(timer);\n   126→      controller.abort();\n   127→    };\n   128→  }, [parentSearch, formData.teamId, token, openDropdown]);\n   129→\n   130→  // Close dropdown on outside click or click on non-dropdown form elements\n   131→  useEffect(() => {\n   132→    function handleClickOutside(e: MouseEvent) {\n   133→      const target = e.target as HTMLElement;\n   134→      // Close if click is outside the form entirely\n   135→      if (formRef.current && !formRef.current.contains(target)) {\n   136→        setOpenDropdown(null);\n   137→        return;\n   138→      }\n   139→      // Close if click is inside the form but outside any dropdown wrapper\n   140→      if (!target.closest('.cif-dropdown-wrapper')) {\n   141→        setOpenDropdown(null);\n   142→      }\n   143→    }\n   144→    if (openDropdown) {\n   145→      document.addEventListener('mousedown', handleClickOutside);\n   146→    }\n   147→    return () => document.removeEventListener('mousedown', handleClickOutside);\n   148→  }, [openDropdown]);\n   149→\n   150→  function updateField<K extends keyof CreateIssueFormData>(key: K, value: CreateIssueFormData[K]) {\n   151→    onFormChange({ ...formData, [key]: value });\n   152→  }\n   153→\n   154→  function toggleDropdown(type: DropdownType) {\n   155→    setOpenDropdown(openDropdown === type ? null : type);\n   156→    if (type === 'assignee') setAssigneeSearch('');\n   157→    if (type === 'project') setProjectSearch('');\n   158→    if (type === 'parent') setParentSearch('');\n   159→  }\n   160→\n   161→  function handleTeamChange(teamId: string) {\n   162→    onFormChange({ ...formData, teamId, cycleId: null });\n   163→    setOpenDropdown(null);\n   164→  }\n   165→\n   166→  function handleLabelToggle(labelId: string) {\n   167→    const current = formData.labelIds;\n   168→    if (current.includes(labelId)) {\n   169→      updateField('labelIds', current.filter((id) => id !== labelId));\n   170→    } else {\n   171→      updateField('labelIds', [...current, labelId]);\n   172→    }\n   173→  }\n   174→\n   175→  function handleRemoveLabel(labelId: string) {\n   176→    updateField('labelIds', formData.labelIds.filter((id) => id !== labelId));\n   177→  }\n   178→\n   179→  const selectedTeam = teams.find((t) => t.id === formData.teamId);\n   180→  const selectedAssignee = teamMembers.find((m) => m.id === formData.assigneeId);\n   181→  const selectedProject = teamProjects.find((p) => p.id === formData.projectId);\n   182→  const selectedCycle = teamCycles.find((c) => c.id === formData.cycleId);\n   183→  const selectedLabels = labels.filter((l) => formData.labelIds.includes(l.id));\n   184→  const selectedParent = parentResults.find((i) => i.id === formData.parentId);\n   185→\n   186→  const filteredMembers = teamMembers.filter((m) =>\n   187→    m.name.toLowerCase().includes(assigneeSearch.toLowerCase())\n   188→  );\n   189→  const filteredProjects = teamProjects.filter((p) =>\n   190→    p.name.toLowerCase().includes(projectSearch.toLowerCase())\n   191→  );\n   192→  const filteredParents = parentResults.filter((i) =>\n   193→    !parentSearch || i.title.toLowerCase().includes(parentSearch.toLowerCase()) || i.identifier.toLowerCase().includes(parentSearch.toLowerCase())\n   194→  );\n   195→\n   196→  const statusConfig = STATUS_CONFIG[formData.status] || STATUS_CONFIG.backlog;\n   197→\n   198→  function formatDueDisplay(dateStr: string): string {\n   199→    const d = new Date(dateStr + 'T00:00:00');\n   200→    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });\n   201→  }\n   202→\n   203→  return (\n   204→    <div className=\"create-issue-form\" ref={formRef} data-testid=\"create-issue-form\">\n   205→      {/* Team Selector */}\n   206→      <div className=\"cif-field\" data-testid=\"create-issue-team-field\">\n   207→        <label className=\"cif-label\">Team</label>\n   208→        <div className=\"cif-dropdown-wrapper\">\n   209→          <button\n   210→            className=\"cif-select-btn\"\n   211→            onClick={() => toggleDropdown('team')}\n   212→            data-testid=\"create-issue-team-selector\"\n   213→          >\n   214→            <span>{selectedTeam ? selectedTeam.name : 'Select team'}</span>\n   215→            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n   216→          </button>\n   217→          {openDropdown === 'team' && (\n   218→            <div className=\"cif-dropdown\" data-testid=\"create-issue-team-dropdown\">\n   219→              {teams.map((team) => (\n   220→                <button\n   221→                  key={team.id}\n   222→                  className={`cif-dropdown-option ${formData.teamId === team.id ? 'cif-dropdown-option-active' : ''}`}\n   223→                  onClick={() => handleTeamChange(team.id)}\n   224→                  data-testid={`create-issue-team-option-${team.id}`}\n   225→                >\n   226→                  {team.name}\n   227→                </button>\n   228→              ))}\n   229→            </div>\n   230→          )}\n   231→        </div>\n   232→      </div>\n   233→\n   234→      {/* Title */}\n   235→      <div className=\"cif-field\" data-testid=\"create-issue-title-field\">\n   236→        <label className=\"cif-label\">Title</label>\n   237→        <input\n   238→          ref={titleRef}\n   239→          type=\"text\"\n   240→          className={`cif-input ${titleError ? 'cif-input-error' : ''}`}\n   241→          placeholder=\"Issue title\"\n   242→          value={formData.title}\n   243→          onChange={(e) => updateField('title', e.target.value)}\n   244→          data-testid=\"create-issue-title-input\"\n   245→        />\n   246→        {titleError && (\n   247→          <span className=\"cif-error\" data-testid=\"create-issue-title-error\">{titleError}</span>\n   248→        )}\n   249→      </div>\n   250→\n   251→      {/* Description */}\n   252→      <div className=\"cif-field\" data-testid=\"create-issue-description-field\">\n   253→        <label className=\"cif-label\">Description</label>\n   254→        <textarea\n   255→          className=\"cif-textarea\"\n   256→          placeholder=\"Add description... (supports markdown)\"\n   257→          value={formData.description}\n   258→          onChange={(e) => updateField('description', e.target.value)}\n   259→          rows={3}\n   260→          data-testid=\"create-issue-description-input\"\n   261→        />\n   262→      </div>\n   263→\n   264→      {/* Status & Priority row */}\n   265→      <div className=\"cif-row\">\n   266→        {/* Status */}\n   267→        <div className=\"cif-field cif-field-half\" data-testid=\"create-issue-status-field\">\n   268→          <label className=\"cif-label\">Status</label>\n   269→          <div className=\"cif-dropdown-wrapper\">\n   270→            <button\n   271→              className=\"cif-select-btn\"\n   272→              onClick={() => toggleDropdown('status')}\n   273→              data-testid=\"create-issue-status-selector\"\n   274→            >\n   275→              <StatusIcon status={formData.status} color={statusConfig.color} />\n   276→              <span>{statusConfig.label}</span>\n   277→              <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n   278→            </button>\n   279→            {openDropdown === 'status' && (\n   280→              <div className=\"cif-dropdown\" data-testid=\"create-issue-status-dropdown\">\n   281→                {STATUS_ORDER.map((s) => {\n   282→                  const cfg = STATUS_CONFIG[s];\n   283→                  return (\n   284→                    <button\n   285→                      key={s}\n   286→                      className={`cif-dropdown-option ${formData.status === s ? 'cif-dropdown-option-active' : ''}`}\n   287→                      onClick={() => { updateField('status', s); setOpenDropdown(null); }}\n   288→                      data-testid={`create-issue-status-option-${s}`}\n   289→                    >\n   290→                      <StatusIcon status={s} color={cfg.color} />\n   291→                      <span>{cfg.label}</span>\n   292→                    </button>\n   293→                  );\n   294→                })}\n   295→              </div>\n   296→            )}\n   297→          </div>\n   298→        </div>\n   299→\n   300→        {/* Priority */}\n   301→        <div className=\"cif-field cif-field-half\" data-testid=\"create-issue-priority-field\">\n   302→          <label className=\"cif-label\">Priority</label>\n   303→          <div className=\"cif-dropdown-wrapper\">\n   304→            <button\n   305→              className=\"cif-select-btn\"\n   306→              onClick={() => toggleDropdown('priority')}\n   307→              data-testid=\"create-issue-priority-selector\"\n   308→            >\n   309→              <PriorityIcon priority={formData.priority} />\n   310→              <span>{PRIORITY_LABELS[formData.priority] || 'No Priority'}</span>\n   311→              <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n   312→            </button>\n   313→            {openDropdown === 'priority' && (\n   314→              <div className=\"cif-dropdown\" data-testid=\"create-issue-priority-dropdown\">\n   315→                {PRIORITY_ORDER.map((p) => (\n   316→                  <button\n   317→                    key={p}\n   318→                    className={`cif-dropdown-option ${formData.priority === p ? 'cif-dropdown-option-active' : ''}`}\n   319→                    onClick={() => { updateField('priority', p); setOpenDropdown(null); }}\n   320→                    data-testid={`create-issue-priority-option-${p}`}\n   321→                  >\n   322→                    <PriorityIcon priority={p} />\n   323→                    <span>{PRIORITY_LABELS[p]}</span>\n   324→                  </button>\n   325→                ))}\n   326→              </div>\n   327→            )}\n   328→          </div>\n   329→        </div>\n   330→      </div>\n   331→\n   332→      {/* Assignee */}\n   333→      <div className=\"cif-field\" data-testid=\"create-issue-assignee-field\">\n   334→        <label className=\"cif-label\">Assignee</label>\n   335→        <div className=\"cif-dropdown-wrapper\">\n   336→          <button\n   337→            className=\"cif-select-btn\"\n   338→            onClick={() => toggleDropdown('assignee')}\n   339→            data-testid=\"create-issue-assignee-selector\"\n   340→          >\n   341→            {selectedAssignee ? (\n   342→              <>\n   343→                <span className=\"cif-avatar\">{selectedAssignee.name.split(' ').map((n) => n[0]).join('').toUpperCase().slice(0, 2)}</span>\n   344→                <span>{selectedAssignee.name}</span>\n   345→              </>\n   346→            ) : (\n   347→              <span className=\"cif-placeholder\">No assignee</span>\n   348→            )}\n   349→            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n   350→          </button>\n   351→          {openDropdown === 'assignee' && (\n   352→            <div className=\"cif-dropdown cif-dropdown-searchable\" data-testid=\"create-issue-assignee-dropdown\">\n   353→              <input\n   354→                className=\"cif-search-input\"\n   355→                placeholder=\"Search members...\"\n   356→                value={assigneeSearch}\n   357→                onChange={(e) => setAssigneeSearch(e.target.value)}\n   358→                autoFocus\n   359→                data-testid=\"create-issue-assignee-search\"\n   360→              />\n   361→              <button\n   362→                className=\"cif-dropdown-option\"\n   363→                onClick={() => { updateField('assigneeId', null); setOpenDropdown(null); }}\n   364→                data-testid=\"create-issue-assignee-option-none\"\n   365→              >\n   366→                <span className=\"cif-avatar cif-avatar-empty\">?</span>\n   367→                <span>No assignee</span>\n   368→              </button>\n   369→              {filteredMembers.map((m) => (\n   370→                <button\n   371→                  key={m.id}\n   372→                  className={`cif-dropdown-option ${formData.assigneeId === m.id ? 'cif-dropdown-option-active' : ''}`}\n   373→                  onClick={() => { updateField('assigneeId', m.id); setOpenDropdown(null); }}\n   374→                  data-testid={`create-issue-assignee-option-${m.id}`}\n   375→                >\n   376→                  <span className=\"cif-avatar\">{m.name.split(' ').map((n) => n[0]).join('').toUpperCase().slice(0, 2)}</span>\n   377→                  <span>{m.name}</span>\n   378→                </button>\n   379→              ))}\n   380→            </div>\n   381→          )}\n   382→        </div>\n   383→      </div>\n   384→\n   385→      {/* Labels */}\n   386→      <div className=\"cif-field\" data-testid=\"create-issue-labels-field\">\n   387→        <label className=\"cif-label\">Labels</label>\n   388→        {selectedLabels.length > 0 && (\n   389→          <div className=\"cif-selected-labels\" data-testid=\"create-issue-selected-labels\">\n   390→            {selectedLabels.map((label) => (\n   391→              <span key={label.id} className=\"cif-label-badge\" style={{ borderColor: label.color }} data-testid={`create-issue-label-badge-${label.id}`}>\n   392→                <span className=\"cif-label-dot\" style={{ backgroundColor: label.color }} />\n   393→                {label.name}\n   394→                <button\n   395→                  className=\"cif-label-remove\"\n   396→                  onClick={() => handleRemoveLabel(label.id)}\n   397→                  data-testid={`create-issue-label-remove-${label.id}`}\n   398→                >\n   399→                  &times;\n   400→                </button>\n   401→              </span>\n   402→            ))}\n   403→          </div>\n   404→        )}\n   405→        <div className=\"cif-dropdown-wrapper\">\n   406→          <button\n   407→            className=\"cif-select-btn\"\n   408→            onClick={() => toggleDropdown('labels')}\n   409→            data-testid=\"create-issue-labels-selector\"\n   410→          >\n   411→            <span className=\"cif-placeholder\">{selectedLabels.length === 0 ? 'Select labels' : 'Add more labels'}</span>\n   412→            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n   413→          </button>\n   414→          {openDropdown === 'labels' && (\n   415→            <div className=\"cif-dropdown\" data-testid=\"create-issue-labels-dropdown\">\n   416→              {labels.map((label) => (\n   417→                <button\n   418→                  key={label.id}\n   419→                  className={`cif-dropdown-option ${formData.labelIds.includes(label.id) ? 'cif-dropdown-option-active' : ''}`}\n   420→                  onClick={() => handleLabelToggle(label.id)}\n   421→                  data-testid={`create-issue-label-option-${label.id}`}\n   422→                >\n   423→                  <span className=\"cif-label-dot\" style={{ backgroundColor: label.color }} />\n   424→                  <span>{label.name}</span>\n   425→                  {formData.labelIds.includes(label.id) && (\n   426→                    <svg className=\"cif-check\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"20 6 9 17 4 12\" /></svg>\n   427→                  )}\n   428→                </button>\n   429→              ))}\n   430→              {labels.length === 0 && (\n   431→                <div className=\"cif-dropdown-empty\">No labels available</div>\n   432→              )}\n   433→            </div>\n   434→          )}\n   435→        </div>\n   436→      </div>\n   437→\n   438→      {/* Project */}\n   439→      <div className=\"cif-field\" data-testid=\"create-issue-project-field\">\n   440→        <label className=\"cif-label\">Project</label>\n   441→        <div className=\"cif-dropdown-wrapper\">\n   442→          <button\n   443→            className=\"cif-select-btn\"\n   444→            onClick={() => toggleDropdown('project')}\n   445→            data-testid=\"create-issue-project-selector\"\n   446→          >\n   447→            <span className={selectedProject ? '' : 'cif-placeholder'}>\n   448→              {selectedProject ? selectedProject.name : 'No project'}\n   449→            </span>\n   450→            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n   451→          </button>\n   452→          {openDropdown === 'project' && (\n   453→            <div className=\"cif-dropdown cif-dropdown-searchable\" data-testid=\"create-issue-project-dropdown\">\n   454→              <input\n   455→                className=\"cif-search-input\"\n   456→                placeholder=\"Search projects...\"\n   457→                value={projectSearch}\n   458→                onChange={(e) => setProjectSearch(e.target.value)}\n   459→                autoFocus\n   460→                data-testid=\"create-issue-project-search\"\n   461→              />\n   462→              <button\n   463→                className=\"cif-dropdown-option\"\n   464→                onClick={() => { updateField('projectId', null); setOpenDropdown(null); }}\n   465→                data-testid=\"create-issue-project-option-none\"\n   466→              >\n   467→                <span>No project</span>\n   468→              </button>\n   469→              {filteredProjects.map((p) => (\n   470→                <button\n   471→                  key={p.id}\n   472→                  className={`cif-dropdown-option ${formData.projectId === p.id ? 'cif-dropdown-option-active' : ''}`}\n   473→                  onClick={() => { updateField('projectId', p.id); setOpenDropdown(null); }}\n   474→                  data-testid={`create-issue-project-option-${p.id}`}\n   475→                >\n   476→                  <span>{p.name}</span>\n   477→                </button>\n   478→              ))}\n   479→            </div>\n   480→          )}\n   481→        </div>\n   482→      </div>\n   483→\n   484→      {/* Cycle */}\n   485→      <div className=\"cif-field\" data-testid=\"create-issue-cycle-field\">\n   486→        <label className=\"cif-label\">Cycle</label>\n   487→        <div className=\"cif-dropdown-wrapper\">\n   488→          <button\n   489→            className=\"cif-select-btn\"\n   490→            onClick={() => toggleDropdown('cycle')}\n   491→            data-testid=\"create-issue-cycle-selector\"\n   492→          >\n   493→            <span className={selectedCycle ? '' : 'cif-placeholder'}>\n   494→              {selectedCycle ? selectedCycle.name : 'No cycle'}\n   495→            </span>\n   496→            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n   497→          </button>\n   498→          {openDropdown === 'cycle' && (\n   499→            <div className=\"cif-dropdown\" data-testid=\"create-issue-cycle-dropdown\">\n   500→              <button\n   501→                className=\"cif-dropdown-option\"\n   502→                onClick={() => { updateField('cycleId', null); setOpenDropdown(null); }}\n   503→                data-testid=\"create-issue-cycle-option-none\"\n   504→              >\n   505→                <span>No cycle</span>\n   506→              </button>\n   507→              {teamCycles.map((c) => {\n   508→                const now = new Date();\n   509→                const start = new Date(c.start_date);\n   510→                const end = new Date(c.end_date);\n   511→                const isActive = now >= start && now <= end;\n   512→                return (\n   513→                  <button\n   514→                    key={c.id}\n   515→                    className={`cif-dropdown-option ${formData.cycleId === c.id ? 'cif-dropdown-option-active' : ''}`}\n   516→                    onClick={() => { updateField('cycleId', c.id); setOpenDropdown(null); }}\n   517→                    data-testid={`create-issue-cycle-option-${c.id}`}\n   518→                  >\n   519→                    <span>{c.name}</span>\n   520→                    {isActive && <span className=\"cif-active-badge\">Active</span>}\n   521→                  </button>\n   522→                );\n   523→              })}\n   524→              {teamCycles.length === 0 && (\n   525→                <div className=\"cif-dropdown-empty\">No cycles available</div>\n   526→              )}\n   527→            </div>\n   528→          )}\n   529→        </div>\n   530→      </div>\n   531→\n   532→      {/* Due Date */}\n   533→      <div className=\"cif-field\" data-testid=\"create-issue-due-date-field\">\n   534→        <label className=\"cif-label\">Due date</label>\n   535→        <div className=\"cif-date-wrapper\">\n   536→          <input\n   537→            type=\"date\"\n   538→            className=\"cif-date-input\"\n   539→            value={formData.dueDate || ''}\n   540→            onChange={(e) => updateField('dueDate', e.target.value || null)}\n   541→            data-testid=\"create-issue-due-date-input\"\n   542→          />\n   543→          {formData.dueDate && (\n   544→            <div className=\"cif-date-display\">\n   545→              <span data-testid=\"create-issue-due-date-display\">{formatDueDisplay(formData.dueDate)}</span>\n   546→              <button\n   547→                className=\"cif-date-clear\"\n   548→                onClick={() => updateField('dueDate', null)}\n   549→                data-testid=\"create-issue-due-date-clear\"\n   550→              >\n   551→                &times;\n   552→              </button>\n   553→            </div>\n   554→          )}\n   555→        </div>\n   556→      </div>\n   557→\n   558→      {/* Parent Issue */}\n   559→      <div className=\"cif-field\" data-testid=\"create-issue-parent-field\">\n   560→        <label className=\"cif-label\">Parent issue</label>\n   561→        <div className=\"cif-dropdown-wrapper\">\n   562→          <button\n   563→            className=\"cif-select-btn\"\n   564→            onClick={() => toggleDropdown('parent')}\n   565→            data-testid=\"create-issue-parent-selector\"\n   566→          >\n   567→            <span className={selectedParent || formData.parentId ? '' : 'cif-placeholder'}>\n   568→              {selectedParent ? `${selectedParent.identifier}: ${selectedParent.title}` : formData.parentId ? 'Loading...' : 'No parent issue'}\n   569→            </span>\n   570→            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n   571→          </button>\n   572→          {openDropdown === 'parent' && (\n   573→            <div className=\"cif-dropdown cif-dropdown-searchable\" data-testid=\"create-issue-parent-dropdown\">\n   574→              <input\n   575→                className=\"cif-search-input\"\n   576→                placeholder=\"Search issues...\"\n   577→                value={parentSearch}\n   578→                onChange={(e) => setParentSearch(e.target.value)}\n   579→                autoFocus\n   580→                data-testid=\"create-issue-parent-search\"\n   581→              />\n   582→              <button\n   583→                className=\"cif-dropdown-option\"\n   584→                onClick={() => { updateField('parentId', null); setOpenDropdown(null); }}\n   585→                data-testid=\"create-issue-parent-option-none\"\n   586→              >\n   587→                <span>No parent issue</span>\n   588→              </button>\n   589→              {filteredParents.map((issue) => (\n   590→                <button\n   591→                  key={issue.id}\n   592→                  className={`cif-dropdown-option ${formData.parentId === issue.id ? 'cif-dropdown-option-active' : ''}`}\n   593→                  onClick={() => { updateField('parentId', issue.id); setOpenDropdown(null); }}\n   594→                  data-testid={`create-issue-parent-option-${issue.id}`}\n   595→                >\n   596→                  <span className=\"cif-parent-identifier\">{issue.identifier}</span>\n   597→                  <span>{issue.title}</span>\n   598→                </button>\n   599→              ))}\n   600→              {filteredParents.length === 0 && parentSearch && (\n   601→                <div className=\"cif-dropdown-empty\">No issues found</div>\n   602→              )}\n   603→            </div>\n   604→          )}\n   605→        </div>\n   606→      </div>\n   607→    </div>\n   608→  );\n   609→}\n   610→"}]},"parent_tool_use_id":null,"session_id":"1e17ab70-0a33-4d2a-af23-66b102e400e2","uuid":"736a26d4-db90-46ce-acad-0959726475a5","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/src/components/CreateIssueForm.tsx","content":"import { useState, useEffect, useRef, useCallback } from 'react';\nimport { useSelector } from 'react-redux';\nimport type { RootState } from '../store';\nimport { StatusIcon, PriorityIcon, STATUS_CONFIG, STATUS_ORDER } from './IssueRow';\nimport './CreateIssueForm.css';\n\nconst PRIORITY_ORDER = ['urgent', 'high', 'medium', 'low', 'none'] as const;\nconst PRIORITY_LABELS: Record<string, string> = {\n  urgent: 'Urgent',\n  high: 'High',\n  medium: 'Medium',\n  low: 'Low',\n  none: 'No Priority',\n};\n\ninterface SearchableIssue {\n  id: string;\n  title: string;\n  identifier: string;\n}\n\nexport interface CreateIssueFormData {\n  teamId: string;\n  title: string;\n  description: string;\n  status: string;\n  priority: string;\n  assigneeId: string | null;\n  labelIds: string[];\n  projectId: string | null;\n  cycleId: string | null;\n  dueDate: string | null;\n  parentId: string | null;\n}\n\ninterface CreateIssueFormProps {\n  defaultTeamId?: string;\n  formData: CreateIssueFormData;\n  onFormChange: (data: CreateIssueFormData) => void;\n  titleError: string | null;\n}\n\ntype DropdownType = 'team' | 'status' | 'priority' | 'assignee' | 'labels' | 'project' | 'cycle' | 'parent' | null;\n\nexport default function CreateIssueForm({ defaultTeamId, formData, onFormChange, titleError }: CreateIssueFormProps) {\n  const { items: teams } = useSelector((state: RootState) => state.teams);\n  const { items: labels } = useSelector((state: RootState) => state.labels);\n  const token = useSelector((state: RootState) => state.auth.token);\n\n  const [openDropdown, setOpenDropdown] = useState<DropdownType>(null);\n  const [assigneeSearch, setAssigneeSearch] = useState('');\n  const [projectSearch, setProjectSearch] = useState('');\n  const [parentSearch, setParentSearch] = useState('');\n  const [parentResults, setParentResults] = useState<SearchableIssue[]>([]);\n\n  // Team-specific data (members, projects, cycles)\n  const [teamMembers, setTeamMembers] = useState<Array<{ id: string; name: string; email: string }>>([]);\n  const [teamProjects, setTeamProjects] = useState<Array<{ id: string; name: string }>>([]);\n  const [teamCycles, setTeamCycles] = useState<Array<{ id: string; name: string; start_date: string; end_date: string }>>([]);\n\n  const formRef = useRef<HTMLDivElement>(null);\n  const titleRef = useRef<HTMLInputElement>(null);\n\n  // Focus title on mount\n  useEffect(() => {\n    titleRef.current?.focus();\n  }, []);\n\n  // Set default team\n  useEffect(() => {\n    if (defaultTeamId && !formData.teamId) {\n      onFormChange({ ...formData, teamId: defaultTeamId });\n    } else if (!formData.teamId && teams.length > 0 && teams[0]) {\n      onFormChange({ ...formData, teamId: teams[0].id });\n    }\n  }, [defaultTeamId, teams]); // eslint-disable-line react-hooks/exhaustive-deps\n\n  // Fetch team-specific data when team changes\n  const fetchTeamData = useCallback(async (teamId: string) => {\n    if (!token || !teamId) return;\n    try {\n      const response = await fetch(`/api/team-issues?teamId=${teamId}`, {\n        headers: { Authorization: `Bearer ${token}` },\n      });\n      if (response.ok) {\n        const data = await response.json();\n        setTeamMembers(data.members || []);\n        setTeamProjects(data.projects || []);\n        setTeamCycles(data.cycles || []);\n      }\n    } catch {\n      // silently fail\n    }\n  }, [token]);\n\n  useEffect(() => {\n    if (formData.teamId) {\n      fetchTeamData(formData.teamId);\n    }\n  }, [formData.teamId, fetchTeamData]);\n\n  // Search parent issues\n  useEffect(() => {\n    if (!token || openDropdown !== 'parent') return;\n    const controller = new AbortController();\n    const fetchParents = async () => {\n      try {\n        const params = new URLSearchParams();\n        if (parentSearch) params.set('q', parentSearch);\n        if (formData.teamId) params.set('teamId', formData.teamId);\n        const response = await fetch(`/api/search-issues?${params}`, {\n          headers: { Authorization: `Bearer ${token}` },\n          signal: controller.signal,\n        });\n        if (response.ok) {\n          const data = await response.json();\n          setParentResults(data.issues || []);\n        }\n      } catch {\n        // ignore abort errors\n      }\n    };\n    const timer = setTimeout(fetchParents, 200);\n    return () => {\n      clearTimeout(timer);\n      controller.abort();\n    };\n  }, [parentSearch, formData.teamId, token, openDropdown]);\n\n  // Close dropdown on outside click or click on non-dropdown form elements\n  useEffect(() => {\n    function handleClickOutside(e: MouseEvent) {\n      const target = e.target as HTMLElement;\n      // Close if click is outside the form entirely\n      if (formRef.current && !formRef.current.contains(target)) {\n        setOpenDropdown(null);\n        return;\n      }\n      // Close if click is inside the form but outside any dropdown wrapper\n      if (!target.closest('.cif-dropdown-wrapper')) {\n        setOpenDropdown(null);\n      }\n    }\n    if (openDropdown) {\n      document.addEventListener('mousedown', handleClickOutside);\n    }\n    return () => document.removeEventListener('mousedown', handleClickOutside);\n  }, [openDropdown]);\n\n  function updateField<K extends keyof CreateIssueFormData>(key: K, value: CreateIssueFormData[K]) {\n    onFormChange({ ...formData, [key]: value });\n  }\n\n  function toggleDropdown(type: DropdownType) {\n    setOpenDropdown(openDropdown === type ? null : type);\n    if (type === 'assignee') setAssigneeSearch('');\n    if (type === 'project') setProjectSearch('');\n    if (type === 'parent') setParentSearch('');\n  }\n\n  function handleTeamChange(teamId: string) {\n    onFormChange({ ...formData, teamId, cycleId: null });\n    setOpenDropdown(null);\n  }\n\n  function handleLabelToggle(labelId: string) {\n    const current = formData.labelIds;\n    if (current.includes(labelId)) {\n      updateField('labelIds', current.filter((id) => id !== labelId));\n    } else {\n      updateField('labelIds', [...current, labelId]);\n    }\n  }\n\n  function handleRemoveLabel(labelId: string) {\n    updateField('labelIds', formData.labelIds.filter((id) => id !== labelId));\n  }\n\n  const selectedTeam = teams.find((t) => t.id === formData.teamId);\n  const selectedAssignee = teamMembers.find((m) => m.id === formData.assigneeId);\n  const selectedProject = teamProjects.find((p) => p.id === formData.projectId);\n  const selectedCycle = teamCycles.find((c) => c.id === formData.cycleId);\n  const selectedLabels = labels.filter((l) => formData.labelIds.includes(l.id));\n  const selectedParent = parentResults.find((i) => i.id === formData.parentId);\n\n  const filteredMembers = teamMembers.filter((m) =>\n    m.name.toLowerCase().includes(assigneeSearch.toLowerCase())\n  );\n  const filteredProjects = teamProjects.filter((p) =>\n    p.name.toLowerCase().includes(projectSearch.toLowerCase())\n  );\n  const filteredParents = parentResults.filter((i) =>\n    !parentSearch || i.title.toLowerCase().includes(parentSearch.toLowerCase()) || i.identifier.toLowerCase().includes(parentSearch.toLowerCase())\n  );\n\n  const statusConfig = STATUS_CONFIG[formData.status] || STATUS_CONFIG.backlog;\n\n  function formatDueDisplay(dateStr: string): string {\n    const d = new Date(dateStr + 'T00:00:00');\n    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });\n  }\n\n  return (\n    <div className=\"create-issue-form\" ref={formRef} data-testid=\"create-issue-form\">\n      {/* Team Selector */}\n      <div className=\"cif-field\" data-testid=\"create-issue-team-field\">\n        <label className=\"cif-label\">Team</label>\n        <div className=\"cif-dropdown-wrapper\">\n          <button\n            className=\"cif-select-btn\"\n            onClick={() => toggleDropdown('team')}\n            data-testid=\"create-issue-team-selector\"\n          >\n            <span>{selectedTeam ? selectedTeam.name : 'Select team'}</span>\n            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n          </button>\n          {openDropdown === 'team' && (\n            <div className=\"cif-dropdown\" data-testid=\"create-issue-team-dropdown\">\n              {teams.map((team) => (\n                <button\n                  key={team.id}\n                  className={`cif-dropdown-option ${formData.teamId === team.id ? 'cif-dropdown-option-active' : ''}`}\n                  onClick={() => handleTeamChange(team.id)}\n                  data-testid={`create-issue-team-option-${team.id}`}\n                >\n                  {team.name}\n                </button>\n              ))}\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* Title */}\n      <div className=\"cif-field\" data-testid=\"create-issue-title-field\">\n        <label className=\"cif-label\">Title</label>\n        <input\n          ref={titleRef}\n          type=\"text\"\n          className={`cif-input ${titleError ? 'cif-input-error' : ''}`}\n          placeholder=\"Issue title\"\n          value={formData.title}\n          onChange={(e) => updateField('title', e.target.value)}\n          data-testid=\"create-issue-title-input\"\n        />\n        {titleError && (\n          <span className=\"cif-error\" data-testid=\"create-issue-title-error\">{titleError}</span>\n        )}\n      </div>\n\n      {/* Description */}\n      <div className=\"cif-field\" data-testid=\"create-issue-description-field\">\n        <label className=\"cif-label\">Description</label>\n        <textarea\n          className=\"cif-textarea\"\n          placeholder=\"Add description... (supports markdown)\"\n          value={formData.description}\n          onChange={(e) => updateField('description', e.target.value)}\n          rows={3}\n          data-testid=\"create-issue-description-input\"\n        />\n      </div>\n\n      {/* Status & Priority row */}\n      <div className=\"cif-row\">\n        {/* Status */}\n        <div className=\"cif-field cif-field-half\" data-testid=\"create-issue-status-field\">\n          <label className=\"cif-label\">Status</label>\n          <div className=\"cif-dropdown-wrapper\">\n            <button\n              className=\"cif-select-btn\"\n              onClick={() => toggleDropdown('status')}\n              data-testid=\"create-issue-status-selector\"\n            >\n              <StatusIcon status={formData.status} color={statusConfig.color} />\n              <span>{statusConfig.label}</span>\n              <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n            </button>\n            {openDropdown === 'status' && (\n              <div className=\"cif-dropdown\" data-testid=\"create-issue-status-dropdown\">\n                {STATUS_ORDER.map((s) => {\n                  const cfg = STATUS_CONFIG[s];\n                  return (\n                    <button\n                      key={s}\n                      className={`cif-dropdown-option ${formData.status === s ? 'cif-dropdown-option-active' : ''}`}\n                      onClick={() => { updateField('status', s); setOpenDropdown(null); }}\n                      data-testid={`create-issue-status-option-${s}`}\n                    >\n                      <StatusIcon status={s} color={cfg.color} />\n                      <span>{cfg.label}</span>\n                    </button>\n                  );\n                })}\n              </div>\n            )}\n          </div>\n        </div>\n\n        {/* Priority */}\n        <div className=\"cif-field cif-field-half\" data-testid=\"create-issue-priority-field\">\n          <label className=\"cif-label\">Priority</label>\n          <div className=\"cif-dropdown-wrapper\">\n            <button\n              className=\"cif-select-btn\"\n              onClick={() => toggleDropdown('priority')}\n              data-testid=\"create-issue-priority-selector\"\n            >\n              <PriorityIcon priority={formData.priority} />\n              <span>{PRIORITY_LABELS[formData.priority] || 'No Priority'}</span>\n              <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n            </button>\n            {openDropdown === 'priority' && (\n              <div className=\"cif-dropdown\" data-testid=\"create-issue-priority-dropdown\">\n                {PRIORITY_ORDER.map((p) => (\n                  <button\n                    key={p}\n                    className={`cif-dropdown-option ${formData.priority === p ? 'cif-dropdown-option-active' : ''}`}\n                    onClick={() => { updateField('priority', p); setOpenDropdown(null); }}\n                    data-testid={`create-issue-priority-option-${p}`}\n                  >\n                    <PriorityIcon priority={p} />\n                    <span>{PRIORITY_LABELS[p]}</span>\n                  </button>\n                ))}\n              </div>\n            )}\n          </div>\n        </div>\n      </div>\n\n      {/* Assignee */}\n      <div className=\"cif-field\" data-testid=\"create-issue-assignee-field\">\n        <label className=\"cif-label\">Assignee</label>\n        <div className=\"cif-dropdown-wrapper\">\n          <button\n            className=\"cif-select-btn\"\n            onClick={() => toggleDropdown('assignee')}\n            data-testid=\"create-issue-assignee-selector\"\n          >\n            {selectedAssignee ? (\n              <>\n                <span className=\"cif-avatar\">{selectedAssignee.name.split(' ').map((n) => n[0]).join('').toUpperCase().slice(0, 2)}</span>\n                <span>{selectedAssignee.name}</span>\n              </>\n            ) : (\n              <span className=\"cif-placeholder\">No assignee</span>\n            )}\n            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n          </button>\n          {openDropdown === 'assignee' && (\n            <div className=\"cif-dropdown cif-dropdown-searchable\" data-testid=\"create-issue-assignee-dropdown\">\n              <input\n                className=\"cif-search-input\"\n                placeholder=\"Search members...\"\n                value={assigneeSearch}\n                onChange={(e) => setAssigneeSearch(e.target.value)}\n                autoFocus\n                data-testid=\"create-issue-assignee-search\"\n              />\n              <button\n                className=\"cif-dropdown-option\"\n                onClick={() => { updateField('assigneeId', null); setOpenDropdown(null); }}\n                data-testid=\"create-issue-assignee-option-none\"\n              >\n                <span className=\"cif-avatar cif-avatar-empty\">?</span>\n                <span>No assignee</span>\n              </button>\n              {filteredMembers.map((m) => (\n                <button\n                  key={m.id}\n                  className={`cif-dropdown-option ${formData.assigneeId === m.id ? 'cif-dropdown-option-active' : ''}`}\n                  onClick={() => { updateField('assigneeId', m.id); setOpenDropdown(null); }}\n                  data-testid={`create-issue-assignee-option-${m.id}`}\n                >\n                  <span className=\"cif-avatar\">{m.name.split(' ').map((n) => n[0]).join('').toUpperCase().slice(0, 2)}</span>\n                  <span>{m.name}</span>\n                </button>\n              ))}\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* Labels */}\n      <div className=\"cif-field\" data-testid=\"create-issue-labels-field\">\n        <label className=\"cif-label\">Labels</label>\n        {selectedLabels.length > 0 && (\n          <div className=\"cif-selected-labels\" data-testid=\"create-issue-selected-labels\">\n            {selectedLabels.map((label) => (\n              <span key={label.id} className=\"cif-label-badge\" style={{ borderColor: label.color }} data-testid={`create-issue-label-badge-${label.id}`}>\n                <span className=\"cif-label-dot\" style={{ backgroundColor: label.color }} />\n                {label.name}\n                <button\n                  className=\"cif-label-remove\"\n                  onClick={() => handleRemoveLabel(label.id)}\n                  data-testid={`create-issue-label-remove-${label.id}`}\n                >\n                  &times;\n                </button>\n              </span>\n            ))}\n          </div>\n        )}\n        <div className=\"cif-dropdown-wrapper\">\n          <button\n            className=\"cif-select-btn\"\n            onClick={() => toggleDropdown('labels')}\n            data-testid=\"create-issue-labels-selector\"\n          >\n            <span className=\"cif-placeholder\">{selectedLabels.length === 0 ? 'Select labels' : 'Add more labels'}</span>\n            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n          </button>\n          {openDropdown === 'labels' && (\n            <div className=\"cif-dropdown\" data-testid=\"create-issue-labels-dropdown\">\n              {labels.map((label) => (\n                <button\n                  key={label.id}\n                  className={`cif-dropdown-option ${formData.labelIds.includes(label.id) ? 'cif-dropdown-option-active' : ''}`}\n                  onClick={() => handleLabelToggle(label.id)}\n                  data-testid={`create-issue-label-option-${label.id}`}\n                >\n                  <span className=\"cif-label-dot\" style={{ backgroundColor: label.color }} />\n                  <span>{label.name}</span>\n                  {formData.labelIds.includes(label.id) && (\n                    <svg className=\"cif-check\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"20 6 9 17 4 12\" /></svg>\n                  )}\n                </button>\n              ))}\n              {labels.length === 0 && (\n                <div className=\"cif-dropdown-empty\">No labels available</div>\n              )}\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* Project */}\n      <div className=\"cif-field\" data-testid=\"create-issue-project-field\">\n        <label className=\"cif-label\">Project</label>\n        <div className=\"cif-dropdown-wrapper\">\n          <button\n            className=\"cif-select-btn\"\n            onClick={() => toggleDropdown('project')}\n            data-testid=\"create-issue-project-selector\"\n          >\n            <span className={selectedProject ? '' : 'cif-placeholder'}>\n              {selectedProject ? selectedProject.name : 'No project'}\n            </span>\n            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n          </button>\n          {openDropdown === 'project' && (\n            <div className=\"cif-dropdown cif-dropdown-searchable\" data-testid=\"create-issue-project-dropdown\">\n              <input\n                className=\"cif-search-input\"\n                placeholder=\"Search projects...\"\n                value={projectSearch}\n                onChange={(e) => setProjectSearch(e.target.value)}\n                autoFocus\n                data-testid=\"create-issue-project-search\"\n              />\n              <button\n                className=\"cif-dropdown-option\"\n                onClick={() => { updateField('projectId', null); setOpenDropdown(null); }}\n                data-testid=\"create-issue-project-option-none\"\n              >\n                <span>No project</span>\n              </button>\n              {filteredProjects.map((p) => (\n                <button\n                  key={p.id}\n                  className={`cif-dropdown-option ${formData.projectId === p.id ? 'cif-dropdown-option-active' : ''}`}\n                  onClick={() => { updateField('projectId', p.id); setOpenDropdown(null); }}\n                  data-testid={`create-issue-project-option-${p.id}`}\n                >\n                  <span>{p.name}</span>\n                </button>\n              ))}\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* Cycle */}\n      <div className=\"cif-field\" data-testid=\"create-issue-cycle-field\">\n        <label className=\"cif-label\">Cycle</label>\n        <div className=\"cif-dropdown-wrapper\">\n          <button\n            className=\"cif-select-btn\"\n            onClick={() => toggleDropdown('cycle')}\n            data-testid=\"create-issue-cycle-selector\"\n          >\n            <span className={selectedCycle ? '' : 'cif-placeholder'}>\n              {selectedCycle ? selectedCycle.name : 'No cycle'}\n            </span>\n            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n          </button>\n          {openDropdown === 'cycle' && (\n            <div className=\"cif-dropdown\" data-testid=\"create-issue-cycle-dropdown\">\n              <button\n                className=\"cif-dropdown-option\"\n                onClick={() => { updateField('cycleId', null); setOpenDropdown(null); }}\n                data-testid=\"create-issue-cycle-option-none\"\n              >\n                <span>No cycle</span>\n              </button>\n              {teamCycles.map((c) => {\n                const now = new Date();\n                const start = new Date(c.start_date);\n                const end = new Date(c.end_date);\n                const isActive = now >= start && now <= end;\n                return (\n                  <button\n                    key={c.id}\n                    className={`cif-dropdown-option ${formData.cycleId === c.id ? 'cif-dropdown-option-active' : ''}`}\n                    onClick={() => { updateField('cycleId', c.id); setOpenDropdown(null); }}\n                    data-testid={`create-issue-cycle-option-${c.id}`}\n                  >\n                    <span>{c.name}</span>\n                    {isActive && <span className=\"cif-active-badge\">Active</span>}\n                  </button>\n                );\n              })}\n              {teamCycles.length === 0 && (\n                <div className=\"cif-dropdown-empty\">No cycles available</div>\n              )}\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* Due Date */}\n      <div className=\"cif-field\" data-testid=\"create-issue-due-date-field\">\n        <label className=\"cif-label\">Due date</label>\n        <div className=\"cif-date-wrapper\">\n          <input\n            type=\"date\"\n            className=\"cif-date-input\"\n            value={formData.dueDate || ''}\n            onChange={(e) => updateField('dueDate', e.target.value || null)}\n            data-testid=\"create-issue-due-date-input\"\n          />\n          {formData.dueDate && (\n            <div className=\"cif-date-display\">\n              <span data-testid=\"create-issue-due-date-display\">{formatDueDisplay(formData.dueDate)}</span>\n              <button\n                className=\"cif-date-clear\"\n                onClick={() => updateField('dueDate', null)}\n                data-testid=\"create-issue-due-date-clear\"\n              >\n                &times;\n              </button>\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* Parent Issue */}\n      <div className=\"cif-field\" data-testid=\"create-issue-parent-field\">\n        <label className=\"cif-label\">Parent issue</label>\n        <div className=\"cif-dropdown-wrapper\">\n          <button\n            className=\"cif-select-btn\"\n            onClick={() => toggleDropdown('parent')}\n            data-testid=\"create-issue-parent-selector\"\n          >\n            <span className={selectedParent || formData.parentId ? '' : 'cif-placeholder'}>\n              {selectedParent ? `${selectedParent.identifier}: ${selectedParent.title}` : formData.parentId ? 'Loading...' : 'No parent issue'}\n            </span>\n            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\"><polyline points=\"6 9 12 15 18 9\" /></svg>\n          </button>\n          {openDropdown === 'parent' && (\n            <div className=\"cif-dropdown cif-dropdown-searchable\" data-testid=\"create-issue-parent-dropdown\">\n              <input\n                className=\"cif-search-input\"\n                placeholder=\"Search issues...\"\n                value={parentSearch}\n                onChange={(e) => setParentSearch(e.target.value)}\n                autoFocus\n                data-testid=\"create-issue-parent-search\"\n              />\n              <button\n                className=\"cif-dropdown-option\"\n                onClick={() => { updateField('parentId', null); setOpenDropdown(null); }}\n                data-testid=\"create-issue-parent-option-none\"\n              >\n                <span>No parent issue</span>\n              </button>\n              {filteredParents.map((issue) => (\n                <button\n                  key={issue.id}\n                  className={`cif-dropdown-option ${formData.parentId === issue.id ? 'cif-dropdown-option-active' : ''}`}\n                  onClick={() => { updateField('parentId', issue.id); setOpenDropdown(null); }}\n                  data-testid={`create-issue-parent-option-${issue.id}`}\n                >\n                  <span className=\"cif-parent-identifier\">{issue.identifier}</span>\n                  <span>{issue.title}</span>\n                </button>\n              ))}\n              {filteredParents.length === 0 && parentSearch && (\n                <div className=\"cif-dropdown-empty\">No issues found</div>\n              )}\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n}\n","numLines":610,"startLine":1,"totalLines":610}}}
