[2026-03-16T01:44:18.899Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01W3cBssVANwfrS6QEdjFwEy","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test';\n     2→\n     3→// Helper to login via API and get token\n     4→async function loginViaApi(baseURL: string, email: string, password: string) {\n     5→  const response = await fetch(`${baseURL}/api/login`, {\n     6→    method: 'POST',\n     7→    headers: { 'Content-Type': 'application/json' },\n     8→    body: JSON.stringify({ email, password }),\n     9→  });\n    10→  return response.json();\n    11→}\n    12→\n    13→// Helper to get teams via API\n    14→async function getTeams(baseURL: string, token: string) {\n    15→  const response = await fetch(`${baseURL}/api/teams`, {\n    16→    headers: { Authorization: `Bearer ${token}` },\n    17→  });\n    18→  const data = await response.json();\n    19→  return data.teams;\n    20→}\n    21→\n    22→// Helper to login and navigate to team issues page\n    23→async function loginAndNavigateToTeamIssues(\n    24→  page: import('@playwright/test').Page,\n    25→  baseURL: string,\n    26→  email = 'alice@acme.com',\n    27→  password = 'password123'\n    28→) {\n    29→  const data = await loginViaApi(baseURL, email, password);\n    30→  const teams = await getTeams(baseURL, data.token);\n    31→  const engTeam = teams.find((t: { identifier: string }) => t.identifier === 'ENG');\n    32→\n    33→  await page.goto('/login');\n    34→  await page.evaluate((t) => localStorage.setItem('session_token', t), data.token);\n    35→  await page.goto(`/team/${engTeam.id}/issues`);\n    36→  await expect(page.getByTestId('team-issues-page')).toBeVisible({ timeout: 30000 });\n    37→  return { token: data.token, user: data.user, engTeam };\n    38→}\n    39→\n    40→test.describe('TeamIssuesList', () => {\n    41→  test('Team Issues page renders with header showing team name', async ({ page, baseURL }) => {\n    42→    await loginAndNavigateToTeamIssues(page, baseURL!);\n    43→\n    44→    // Verify header with team name\n    45→    await expect(page.getByTestId('team-issues-title')).toBeVisible({ timeout: 30000 });\n    46→    await expect(page.getByTestId('team-issues-title')).toContainText('Engineering');\n    47→    await expect(page.getByTestId('team-issues-title')).toContainText('Issues');\n    48→\n    49→    // Verify New Issue button is visible\n    50→    await expect(page.getByTestId('new-issue-btn')).toBeVisible();\n    51→  });\n    52→\n    53→  test('Team Issues page shows issues grouped by status (default)', async ({ page, baseURL }) => {\n    54→    await loginAndNavigateToTeamIssues(page, baseURL!);\n    55→\n    56→    // Wait for issues to load\n    57→    await expect(page.getByTestId('team-issues-list')).toBeVisible({ timeout: 30000 });\n    58→\n    59→    // Seed data groups for ENG:\n    60→    // backlog: ENG-3, ENG-7 (2 issues)\n    61→    // todo: ENG-2, ENG-6 (2 issues)\n    62→    // in_progress: ENG-1, ENG-8 (2 issues)\n    63→    // in_review: ENG-4 (1 issue)\n    64→    // done: ENG-5 (1 issue)\n    65→\n    66→    // Verify backlog group\n    67→    await expect(page.getByTestId('team-issue-group-backlog')).toBeVisible();\n    68→    await expect(page.getByTestId('team-issue-group-header-backlog')).toContainText('Backlog');\n    69→    await expect(page.getByTestId('team-issue-group-header-backlog')).toContainText('(2)');\n    70→\n    71→    // Verify todo group\n    72→    await expect(page.getByTestId('team-issue-group-todo')).toBeVisible();\n    73→    await expect(page.getByTestId('team-issue-group-header-todo')).toContainText('Todo');\n    74→    await expect(page.getByTestId('team-issue-group-header-todo')).toContainText('(2)');\n    75→\n    76→    // Verify in_progress group\n    77→    await expect(page.getByTestId('team-issue-group-in_progress')).toBeVisible();\n    78→    await expect(page.getByTestId('team-issue-group-header-in_progress')).toContainText('In Progress');\n    79→    await expect(page.getByTestId('team-issue-group-header-in_progress')).toContainText('(2)');\n    80→"}]},"parent_tool_use_id":"toolu_012ZM9PKQLoNPrunaMM29F46","session_id":"1e17ab70-0a33-4d2a-af23-66b102e400e2","uuid":"a76b47ee-f4ee-42e6-82d0-0b45244b7a2a"}
