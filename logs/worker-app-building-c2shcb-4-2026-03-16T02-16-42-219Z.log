 166→\n   167→  try {\n   168→    ephemeralDbUrl = await createEphemeralBranch(projectId, branchName)\n   169→  } catch (err) {\n   170→    console.error(`Failed to create ephemeral branch: ${err}`)\n   171→    process.exit(1)\n   172→  }\n   173→\n   174→  try {\n   175→    await initSchema(ephemeralDbUrl)\n   176→    await seedDatabase(ephemeralDbUrl)\n   177→\n   178→    const netlifyDev = spawn('npx', ['tsx', 'scripts/dev-server.ts'], {\n   179→      cwd: appDir,\n   180→      env: { ...process.env, DATABASE_URL: ephemeralDbUrl, DEV_PORT: '8888' },\n   181→      stdio: ['ignore', 'pipe', 'pipe'],\n   182→      detached: true,\n   183→    })\n   184→\n   185→    await new Promise<void>((resolve, reject) => {\n   186→      const timeout = setTimeout(() => reject(new Error('dev server failed to start within 60s')), 60000)\n   187→      let output = ''\n   188→      let resolved = false\n   189→      const check = (data: Buffer) => {\n   190→        output += data.toString()\n   191→        if (!resolved && (output.includes('Dev server ready') || output.includes('localhost:8888'))) {\n   192→          resolved = true\n   193→          setTimeout(() => { clearTimeout(timeout); resolve() }, 2000)\n   194→        }\n   195→      }\n   196→      netlifyDev.stdout?.on('data', check)\n   197→      netlifyDev.stderr?.on('data', check)\n   198→      netlifyDev.on('error', (err) => { if (!resolved) { clearTimeout(timeout); reject(err) } })\n   199→      netlifyDev.on('exit', (code) => {\n   200→        if (!resolved && code !== null && code !== 0) { clearTimeout(timeout); reject(new Error(`dev server exited ${code}\\n${output}`)) }\n   201→      })\n   202→    })\n   203→\n   204→    try { execSync('npx replayio remove --all', { cwd: appDir, stdio: 'ignore' }) } catch { /* ignore */ }\n   205→\n   206→    // Retry resetDatabase in case the Neon endpoint needs time to become available\n   207→    for (let attempt = 0; attempt < 3; attempt++) {\n   208→      try {\n   209→    