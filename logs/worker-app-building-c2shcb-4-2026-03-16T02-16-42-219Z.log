ary);\n   306→  font-size: 12px;\n   307→  font-weight: 500;\n   308→  flex-shrink: 0;\n   309→}\n   310→"}]},"parent_tool_use_id":"toolu_01Bjh7s4r2SZg4SRnjxrnAnw","session_id":"1e17ab70-0a33-4d2a-af23-66b102e400e2","uuid":"c8d551a5-3e72-442b-803f-41169dd6f85a"}
