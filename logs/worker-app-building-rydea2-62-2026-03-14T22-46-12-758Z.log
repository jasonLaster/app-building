[2026-03-14T22:43:17.490Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CZQvnJEkAoTMvj92NEMEXv","type":"tool_result","content":"     1→import { useState, useRef, useEffect } from 'react';\n     2→import { useSelector, useDispatch } from 'react-redux';\n     3→import type { RootState, AppDispatch } from '../store';\n     4→import {\n     5→  updateProjectField,\n     6→  createMilestone,\n     7→  updateMilestone,\n     8→  deleteMilestone,\n     9→} from '../slices/projectDetailSlice';\n    10→import './ProjectOverviewTab.css';\n    11→\n    12→function formatDate(dateStr: string): string {\n    13→  const d = new Date(dateStr + 'T00:00:00');\n    14→  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });\n    15→}\n    16→\n    17→function simpleMarkdown(text: string): string {\n    18→  let html = text\n    19→    .replace(/&/g, '&amp;')\n    20→    .replace(/</g, '&lt;')\n    21→    .replace(/>/g, '&gt;');\n    22→  // Headings\n    23→  html = html.replace(/^## (.+)$/gm, '<h3>$1</h3>');\n    24→  html = html.replace(/^# (.+)$/gm, '<h2>$1</h2>');\n    25→  // Bold\n    26→  html = html.replace(/\\*\\*(.+?)\\*\\*/g, '<strong>$1</strong>');\n    27→  // Italic\n    28→  html = html.replace(/\\*(.+?)\\*/g, '<em>$1</em>');\n    29→  // Unordered lists\n    30→  html = html.replace(/^- (.+)$/gm, '<li>$1</li>');\n    31→  html = html.replace(/(<li>.*<\\/li>\\n?)+/gs, (match) => `<ul>${match}</ul>`);\n    32→  // Line breaks for remaining text\n    33→  html = html.replace(/\\n/g, '<br>');\n    34→  // Clean up double brs inside ul\n    35→  html = html.replace(/<ul><br>/g, '<ul>');\n    36→  html = html.replace(/<br><\\/ul>/g, '</ul>');\n    37→  return html;\n    38→}\n    39→\n    40→export default function ProjectOverviewTab() {\n    41→  const dispatch = useDispatch<AppDispatch>();\n    42→  const { project, milestones } = useSelector((state: RootState) => state.projectDetail);\n    43→\n    44→  // Description editing\n    45→  const [editingDesc, setEditingDesc] = useState(false);\n    46→  const [descValue, setDescValue] = useState(project?.description || '');\n    47→  const descRef = useRef<HTMLTextAreaElement>(null);\n    48→\n    49→  // Milestone add form\n    50→  const [showAddMilestone, setShowAddMilestone] = useState(false);\n    51→  const [newMilestoneName, setNewMilestoneName] = useState('');\n    52→  const [newMilestoneDate, setNewMilestoneDate] = useState('');\n    53→\n    54→  // Milestone editing\n    55→  const [editingMilestoneId, setEditingMilestoneId] = useState<string | null>(null);\n    56→  const [editMilestoneName, setEditMilestoneName] = useState('');\n    57→  const [editMilestoneDate, setEditMilestoneDate] = useState('');\n    58→\n    59→  // Delete confirmation\n    60→  const [deletingMilestoneId, setDeletingMilestoneId] = useState<string | null>(null);\n    61→\n    62→  useEffect(() => {\n    63→    setDescValue(project?.description || '');\n    64→  }, [project?.description]);\n    65→\n    66→  useEffect(() => {\n    67→    if (editingDesc) {\n    68→      descRef.current?.focus();\n    69→    }\n    70→  }, [editingDesc]);\n    71→\n    72→  if (!project) return null;\n    73→\n    74→  // Description handlers\n    75→  function handleDescClick() {\n    76→    setEditingDesc(true);\n    77→  }\n    78→\n    79→  async function saveDescription() {\n    80→    const val = descValue.trim() || null;\n    81→    if (val !== (project?.description || null)) {\n    82→      await dispatch(updateProjectField({ projectId: project!.id, field: 'description', value: val }));\n    83→    }\n    84→    setEditingDesc(false);\n    85→  }\n    86→\n    87→  function handleDescKeyDown(e: React.KeyboardEvent) {\n    88→    if (e.key === 'Escape') {\n    89→      setDescValue(project?.description || '');\n    90→      setEditingDesc(false);\n    91→    }\n    92→  }\n    93→\n    94→  // Milestone handlers\n    95→  async function handleAddMilestone() {\n    96→    if (!newMilestoneName.trim()) return;\n    97→    await dispatch(createMilestone({\n    98→      projectId: project!.id,\n    99→      name: newMilestoneName.trim(),\n   100→      targetDate: newMilestoneDate || null,\n   101→    }));\n   102→    setNewMilestoneName('');\n   103→    setNewMilestoneDate('');\n   104→    setShowAddMilestone(false);\n   105→  }\n   106→\n   107→  function handleCancelAddMilestone() {\n   108→    setNewMilestoneName('');\n   109→    setNewMilestoneDate('');\n   110→    setShowAddMilestone(false);\n   111→  }\n   112→\n   113→  async function handleToggleMilestoneComplete(milestoneId: string, currentCompleted: boolean) {\n   114→    dispatch(updateMilestone({\n   115→      milestoneId,\n   116→      projectId: project!.id,\n   117→      completed: !currentCompleted,\n   118→    }));\n   119→  }\n   120→\n   121→  function startEditMilestone(milestoneId: string, name: string, targetDate: string | null) {\n   122→    setEditingMilestoneId(milestoneId);\n   123→    setEditMilestoneName(name);\n   124→    setEditMilestoneDate(targetDate || '');\n   125→  }\n   126→\n   127→  async function saveEditMilestone() {\n   128→    if (!editingMilestoneId || !editMilestoneName.trim()) return;\n   129→    await dispatch(updateMilestone({\n   130→      milestoneId: editingMilestoneId,\n   131→      projectId: project!.id,\n   132→      name: editMilestoneName.trim(),\n   133→      targetDate: editMilestoneDate || null,\n   134→    }));\n   135→    setEditingMilestoneId(null);\n   136→  }\n   137→\n   138→  async function confirmDeleteMilestone() {\n   139→    if (!deletingMilestoneId) return;\n   140→    await dispatch(deleteMilestone({\n   141→      milestoneId: deletingMilestoneId,\n   142→      projectId: project!.id,\n   143→    }));\n   144→    setDeletingMilestoneId(null);\n   145→  }\n   146→\n   147→  // Key metrics\n   148→  const totalIssues = project.totalIssues;\n   149→  const completedIssues = project.completedIssues;\n   150→  const inProgressIssues = project.inProgressIssues;\n   151→  const remainingIssues = totalIssues - completedIssues;\n   152→  const completionPercentage = totalIssues > 0 ? Math.round((completedIssues / totalIssues) * 100) : 0;\n   153→\n   154→  return (\n   155→    <div className=\"project-overview-tab\" data-testid=\"project-overview-tab\">\n   156→      {/* Description */}\n   157→      <div className=\"project-overview-section\" data-testid=\"project-overview-description-section\">\n   158→        <h3 className=\"project-overview-section-title\">Description</h3>\n   159→        {editingDesc ? (\n   160→          <div className=\"project-overview-desc-edit\">\n   161→            <textarea\n   162→              ref={descRef}\n   163→              className=\"project-overview-desc-textarea\"\n   164→              value={descValue}\n   165→              onChange={(e) => setDescValue(e.target.value)}\n   166→              onBlur={saveDescription}\n   167→              onKeyDown={handleDescKeyDown}\n   168→              placeholder=\"Add a description...\"\n   169→              data-testid=\"project-overview-description-input\"\n   170→            />\n   171→          </div>\n   172→        ) : (\n   173→          <div\n   174→            className={`project-overview-desc-display ${!project.description ? 'project-overview-desc-placeholder' : ''}`}\n   175→            onClick={handleDescClick}\n   176→            data-testid=\"project-overview-description\"\n   177→          >\n   178→            {project.description ? (\n   179→              <div\n   180→                className=\"project-overview-desc-rendered\"\n   181→                dangerouslySetInnerHTML={{ __html: simpleMarkdown(project.description) }}\n   182→              />\n   183→            ) : (\n   184→              <span>Add a description...</span>\n   185→            )}\n   186→          </div>\n   187→        )}\n   188→      </div>\n   189→\n   190→      {/* Milestones */}\n   191→      <div className=\"project-overview-section\" data-testid=\"project-overview-milestones-section\">\n   192→        <div className=\"project-overview-section-header\">\n   193→          <h3 className=\"project-overview-section-title\">Milestones</h3>\n   194→          <button\n   195→            className=\"project-overview-add-btn\"\n   196→            onClick={() => setShowAddMilestone(true)}\n   197→            data-testid=\"project-overview-add-milestone-btn\"\n   198→          >\n   199→            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n   200→              <line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\" />\n   201→              <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\" />\n   202→            </svg>\n   203→            Add Milestone\n   204→          </button>\n   205→        </div>\n   206→\n   207→        {/* Add milestone form */}\n   208→        {showAddMilestone && (\n   209→          <div className=\"project-overview-milestone-form\" data-testid=\"project-overview-milestone-form\">\n   210→            <input\n   211→              className=\"project-overview-milestone-name-input\"\n   212→              placeholder=\"Milestone name\"\n   213→              value={newMilestoneName}\n   214→              onChange={(e) => setNewMilestoneName(e.target.value)}\n   215→              data-testid=\"project-overview-milestone-name-input\"\n   216→            />\n   217→            <input\n   218→              type=\"date\"\n   219→              className=\"project-overview-milestone-date-input\"\n   220→              value={newMilestoneDate}\n   221→              onChange={(e) => setNewMilestoneDate(e.target.value)}\n   222→              data-testid=\"project-overview-milestone-date-input\"\n   223→            />\n   224→            <div className=\"project-overview-milestone-form-actions\">\n   225→              <button\n   226→                className=\"project-overview-milestone-save-btn\"\n   227→                onClick={handleAddMilestone}\n   228→                data-testid=\"project-overview-milestone-save-btn\"\n   229→              >\n   230→                Save\n   231→              </button>\n   232→              <button\n   233→                className=\"project-overview-milestone-cancel-btn\"\n   234→                onClick={handleCancelAddMilestone}\n   235→                data-testid=\"project-overview-milestone-cancel-btn\"\n   236→              >\n   237→                Cancel\n   238→              </button>\n   239→            </div>\n   240→          </div>\n   241→        )}\n   242→\n   243→        {/* Milestone list */}\n   244→        {milestones.length === 0 && !showAddMilestone ? (\n   245→          <div className=\"project-overview-milestones-empty\" data-testid=\"project-overview-milestones-empty\">\n   246→            <p>No milestones yet. Add one to track progress.</p>\n   247→          </div>\n   248→        ) : (\n   249→          <div className=\"project-overview-milestones-list\" data-testid=\"project-overview-milestones-list\">\n   250→            {milestones.map((ms) => (\n   251→              <div\n   252→                key={ms.id}\n   253→                className={`project-overview-milestone ${ms.completed ? 'project-overview-milestone-completed' : ''}`}\n   254→                data-testid={`project-overview-milestone-${ms.id}`}\n   255→              >\n   256→                {editingMilestoneId === ms.id ? (\n   257→                  <div className=\"project-overview-milestone-edit-row\">\n   258→                    <input\n   259→                      className=\"project-overview-milestone-name-input\"\n   260→                      value={editMilestoneName}\n   261→                      onChange={(e) => setEditMilestoneName(e.target.value)}\n   262→                      data-testid={`project-overview-milestone-edit-name-${ms.id}`}\n   263→                    />\n   264→                    <input\n   265→                      type=\"date\"\n   266→                      className=\"project-overview-milestone-date-input\"\n   267→                      value={editMilestoneDate}\n   268→                      onChange={(e) => setEditMilestoneDate(e.target.value)}\n   269→                      data-testid={`project-overview-milestone-edit-date-${ms.id}`}\n   270→                    />\n   271→                    <button\n   272→                      className=\"project-overview-milestone-save-btn\"\n   273→                      onClick={saveEditMilestone}\n   274→                      data-testid={`project-overview-milestone-edit-save-${ms.id}`}\n   275→                    >\n   276→                      Save\n   277→                    </button>\n   278→                    <button\n   279→                      className=\"project-overview-milestone-cancel-btn\"\n   280→                      onClick={() => setEditingMilestoneId(null)}\n   281→                      data-testid={`project-overview-milestone-edit-cancel-${ms.id}`}\n   282→                    >\n   283→                      Cancel\n   284→                    </button>\n   285→                  </div>\n   286→                ) : (\n   287→                  <>\n   288→                    <label className=\"project-overview-milestone-check\" data-testid={`project-overview-milestone-toggle-${ms.id}`}>\n   289→                      <input\n   290→                        type=\"checkbox\"\n   291→                        checked={ms.completed}\n   292→                        onChange={() => handleToggleMilestoneComplete(ms.id, ms.completed)}\n   293→                      />\n   294→                    </label>\n   295→                    <div className=\"project-overview-milestone-info\">\n   296→                      <span\n   297→                        className={`project-overview-milestone-name ${ms.completed ? 'project-overview-milestone-name-done' : ''}`}\n   298→                        onClick={() => startEditMilestone(ms.id, ms.name, ms.targetDate)}\n   299→                        data-testid={`project-overview-milestone-name-${ms.id}`}\n   300→                      >\n   301→                        {ms.name}\n   302→                      </span>\n   303→                      {ms.targetDate && (\n   304→                        <span\n   305→                          className=\"project-overview-milestone-date\"\n   306→                          onClick={() => startEditMilestone(ms.id, ms.name, ms.targetDate)}\n   307→                          data-testid={`project-overview-milestone-date-${ms.id}`}\n   308→                        >\n   309→                          {formatDate(ms.targetDate)}\n   310→                        </span>\n   311→                      )}\n   312→                    </div>\n   313→                    <button\n   314→                      className=\"project-overview-milestone-delete-btn\"\n   315→                      onClick={() => setDeletingMilestoneId(ms.id)}\n   316→                      data-testid={`project-overview-milestone-delete-btn-${ms.id}`}\n   317→                    >\n   318→                      <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n   319→                        <polyline points=\"3 6 5 6 21 6\" />\n   320→                        <path d=\"M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2\" />\n   321→                      </svg>\n   322→                    </button>\n   323→                  </>\n   324→                )}\n   325→              </div>\n   326→            ))}\n   327→          </div>\n   328→        )}\n   329→\n   330→        {/* Delete confirmation dialog */}\n   331→        {deletingMilestoneId && (\n   332→          <div className=\"project-overview-delete-dialog-overlay\" data-testid=\"project-overview-delete-dialog\">\n   333→            <div className=\"project-overview-delete-dialog\">\n   334→              <p>Are you sure you want to delete this milestone?</p>\n   335→              <div className=\"project-overview-delete-dialog-actions\">\n   336→                <button\n   337→                  className=\"project-overview-delete-confirm-btn\"\n   338→                  onClick={confirmDeleteMilestone}\n   339→                  data-testid=\"project-overview-delete-confirm-btn\"\n   340→                >\n   341→                  Delete\n   342→                </button>\n   343→                <button\n   344→                  className=\"project-overview-delete-cancel-btn\"\n   345→                  onClick={() => setDeletingMilestoneId(null)}\n   346→                  data-testid=\"project-overview-delete-cancel-btn\"\n   347→                >\n   348→                  Cancel\n   349→                </button>\n   350→              </div>\n   351→            </div>\n   352→          </div>\n   353→        )}\n   354→      </div>\n   355→\n   356→      {/* Key Metrics */}\n   357→      <div className=\"project-overview-section\" data-testid=\"project-overview-metrics-section\">\n   358→        <h3 className=\"project-overview-section-title\">Key Metrics</h3>\n   359→        <div className=\"project-overview-metrics\" data-testid=\"project-overview-metrics\">\n   360→          <div className=\"project-overview-metric\" data-testid=\"project-overview-metric-total\">\n   361→            <span className=\"project-overview-metric-value\">{totalIssues}</span>\n   362→            <span className=\"project-overview-metric-label\">Total Issues</span>\n   363→          </div>\n   364→          <div className=\"project-overview-metric\" data-testid=\"project-overview-metric-completed\">\n   365→            <span className=\"project-overview-metric-value project-overview-metric-green\">{completedIssues}</span>\n   366→            <span className=\"project-overview-metric-label\">Completed</span>\n   367→          </div>\n   368→          <div className=\"project-overview-metric\" data-testid=\"project-overview-metric-in-progress\">\n   369→            <span className=\"project-overview-metric-value project-overview-metric-accent\">{inProgressIssues}</span>\n   370→            <span className=\"project-overview-metric-label\">In Progress</span>\n   371→          </div>\n   372→          <div className=\"project-overview-metric\" data-testid=\"project-overview-metric-remaining\">\n   373→            <span className=\"project-overview-metric-value\">{remainingIssues}</span>\n   374→            <span className=\"project-overview-metric-label\">Remaining</span>\n   375→          </div>\n   376→          <div className=\"project-overview-metric\" data-testid=\"project-overview-metric-percentage\">\n   377→            <span className=\"project-overview-metric-value project-overview-metric-green\">{completionPercentage}%</span>\n   378→            <span className=\"project-overview-metric-label\">Complete</span>\n   379→          </div>\n   380→        </div>\n   381→      </div>\n   382→    </div>\n   383→  );\n   384→}\n   385→"}]},"parent_tool_use_id":null,"session_id":"305e5aa9-79a1-4a8e-aa5e-6b1bfad647a9","uuid":"5bff811f-be21-40a0-a47c-54c0932ad4a5","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/src/components/ProjectOverviewTab.tsx","content":"import { useState, useRef, useEffect } from 'react';\nimport { useSelector, useDispatch } from 'react-redux';\nimport type { RootState, AppDispatch } from '../store';\nimport {\n  updateProjectField,\n  createMilestone,\n  updateMilestone,\n  deleteMilestone,\n} from '../slices/projectDetailSlice';\nimport './ProjectOverviewTab.css';\n\nfunction formatDate(dateStr: string): string {\n  const d = new Date(dateStr + 'T00:00:00');\n  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });\n}\n\nfunction simpleMarkdown(text: string): string {\n  let html = text\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;');\n  // Headings\n  html = html.replace(/^## (.+)$/gm, '<h3>$1</h3>');\n  html = html.replace(/^# (.+)$/gm, '<h2>$1</h2>');\n  // Bold\n  html = html.replace(/\\*\\*(.+?)\\*\\*/g, '<strong>$1</strong>');\n  // Italic\n  html = html.replace(/\\*(.+?)\\*/g, '<em>$1</em>');\n  // Unordered lists\n  html = html.replace(/^- (.+)$/gm, '<li>$1</li>');\n  html = html.replace(/(<li>.*<\\/li>\\n?)+/gs, (match) => `<ul>${match}</ul>`);\n  // Line breaks for remaining text\n  html = html.replace(/\\n/g, '<br>');\n  // Clean up double brs inside ul\n  html = html.replace(/<ul><br>/g, '<ul>');\n  html = html.replace(/<br><\\/ul>/g, '</ul>');\n  return html;\n}\n\nexport default function ProjectOverviewTab() {\n  const dispatch = useDispatch<AppDispatch>();\n  const { project, milestones } = useSelector((state: RootState) => state.projectDetail);\n\n  // Description editing\n  const [editingDesc, setEditingDesc] = useState(false);\n  const [descValue, setDescValue] = useState(project?.description || '');\n  const descRef = useRef<HTMLTextAreaElement>(null);\n\n  // Milestone add form\n  const [showAddMilestone, setShowAddMilestone] = useState(false);\n  const [newMilestoneName, setNewMilestoneName] = useState('');\n  const [newMilestoneDate, setNewMilestoneDate] = useState('');\n\n  // Milestone editing\n  const [editingMilestoneId, setEditingMilestoneId] = useState<string | null>(null);\n  const [editMilestoneName, setEditMilestoneName] = useState('');\n  const [editMilestoneDate, setEditMilestoneDate] = useState('');\n\n  // Delete confirmation\n  const [deletingMilestoneId, setDeletingMilestoneId] = useState<string | null>(null);\n\n  useEffect(() => {\n    setDescValue(project?.description || '');\n  }, [project?.description]);\n\n  useEffect(() => {\n    if (editingDesc) {\n      descRef.current?.focus();\n    }\n  }, [editingDesc]);\n\n  if (!project) return null;\n\n  // Description handlers\n  function handleDescClick() {\n    setEditingDesc(true);\n  }\n\n  async function saveDescription() {\n    const val = descValue.trim() || null;\n    if (val !== (project?.description || null)) {\n      await dispatch(updateProjectField({ projectId: project!.id, field: 'description', value: val }));\n    }\n    setEditingDesc(false);\n  }\n\n  function handleDescKeyDown(e: React.KeyboardEvent) {\n    if (e.key === 'Escape') {\n      setDescValue(project?.description || '');\n      setEditingDesc(false);\n    }\n  }\n\n  // Milestone handlers\n  async function handleAddMilestone() {\n    if (!newMilestoneName.trim()) return;\n    await dispatch(createMilestone({\n      projectId: project!.id,\n      name: newMilestoneName.trim(),\n      targetDate: newMilestoneDate || null,\n    }));\n    setNewMilestoneName('');\n    setNewMilestoneDate('');\n    setShowAddMilestone(false);\n  }\n\n  function handleCancelAddMilestone() {\n    setNewMilestoneName('');\n    setNewMilestoneDate('');\n    setShowAddMilestone(false);\n  }\n\n  async function handleToggleMilestoneComplete(milestoneId: string, currentCompleted: boolean) {\n    dispatch(updateMilestone({\n      milestoneId,\n      projectId: project!.id,\n      completed: !currentCompleted,\n    }));\n  }\n\n  function startEditMilestone(milestoneId: string, name: string, targetDate: string | null) {\n    setEditingMilestoneId(milestoneId);\n    setEditMilestoneName(name);\n    setEditMilestoneDate(targetDate || '');\n  }\n\n  async function saveEditMilestone() {\n    if (!editingMilestoneId || !editMilestoneName.trim()) return;\n    await dispatch(updateMilestone({\n      milestoneId: editingMilestoneId,\n      projectId: project!.id,\n      name: editMilestoneName.trim(),\n      targetDate: editMilestoneDate || null,\n    }));\n    setEditingMilestoneId(null);\n  }\n\n  async function confirmDeleteMilestone() {\n    if (!deletingMilestoneId) return;\n    await dispatch(deleteMilestone({\n      milestoneId: deletingMilestoneId,\n      projectId: project!.id,\n    }));\n    setDeletingMilestoneId(null);\n  }\n\n  // Key metrics\n  const totalIssues = project.totalIssues;\n  const completedIssues = project.completedIssues;\n  const inProgressIssues = project.inProgressIssues;\n  const remainingIssues = totalIssues - completedIssues;\n  const completionPercentage = totalIssues > 0 ? Math.round((completedIssues / totalIssues) * 100) : 0;\n\n  return (\n    <div className=\"project-overview-tab\" data-testid=\"project-overview-tab\">\n      {/* Description */}\n      <div className=\"project-overview-section\" data-testid=\"project-overview-description-section\">\n        <h3 className=\"project-overview-section-title\">Description</h3>\n        {editingDesc ? (\n          <div className=\"project-overview-desc-edit\">\n            <textarea\n              ref={descRef}\n              className=\"project-overview-desc-textarea\"\n              value={descValue}\n              onChange={(e) => setDescValue(e.target.value)}\n              onBlur={saveDescription}\n              onKeyDown={handleDescKeyDown}\n              placeholder=\"Add a description...\"\n              data-testid=\"project-overview-description-input\"\n            />\n          </div>\n        ) : (\n          <div\n            className={`project-overview-desc-display ${!project.description ? 'project-overview-desc-placeholder' : ''}`}\n            onClick={handleDescClick}\n            data-testid=\"project-overview-description\"\n          >\n            {project.description ? (\n              <div\n                className=\"project-overview-desc-rendered\"\n                dangerouslySetInnerHTML={{ __html: simpleMarkdown(project.description) }}\n              />\n            ) : (\n              <span>Add a description...</span>\n            )}\n          </div>\n        )}\n      </div>\n\n      {/* Milestones */}\n      <div className=\"project-overview-section\" data-testid=\"project-overview-milestones-section\">\n        <div className=\"project-overview-section-header\">\n          <h3 className=\"project-overview-section-title\">Milestones</h3>\n          <button\n            className=\"project-overview-add-btn\"\n            onClick={() => setShowAddMilestone(true)}\n            data-testid=\"project-overview-add-milestone-btn\"\n          >\n            <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n              <line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\" />\n              <line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\" />\n            </svg>\n            Add Milestone\n          </button>\n        </div>\n\n        {/* Add milestone form */}\n        {showAddMilestone && (\n          <div className=\"project-overview-milestone-form\" data-testid=\"project-overview-milestone-form\">\n            <input\n              className=\"project-overview-milestone-name-input\"\n              placeholder=\"Milestone name\"\n              value={newMilestoneName}\n              onChange={(e) => setNewMilestoneName(e.target.value)}\n              data-testid=\"project-overview-milestone-name-input\"\n            />\n            <input\n              type=\"date\"\n              className=\"project-overview-milestone-date-input\"\n              value={newMilestoneDate}\n              onChange={(e) => setNewMilestoneDate(e.target.value)}\n              data-testid=\"project-overview-milestone-date-input\"\n            />\n            <div className=\"project-overview-milestone-form-actions\">\n              <button\n                className=\"project-overview-milestone-save-btn\"\n                onClick={handleAddMilestone}\n                data-testid=\"project-overview-milestone-save-btn\"\n              >\n                Save\n              </button>\n              <button\n                className=\"project-overview-milestone-cancel-btn\"\n                onClick={handleCancelAddMilestone}\n                data-testid=\"project-overview-milestone-cancel-btn\"\n              >\n                Cancel\n              </button>\n            </div>\n          </div>\n        )}\n\n        {/* Milestone list */}\n        {milestones.length === 0 && !showAddMilestone ? (\n          <div className=\"project-overview-milestones-empty\" data-testid=\"project-overview-milestones-empty\">\n            <p>No milestones yet. Add one to track progress.</p>\n          </div>\n        ) : (\n          <div className=\"project-overview-milestones-list\" data-testid=\"project-overview-milestones-list\">\n            {milestones.map((ms) => (\n              <div\n                key={ms.id}\n                className={`project-overview-milestone ${ms.completed ? 'project-overview-milestone-completed' : ''}`}\n                data-testid={`project-overview-milestone-${ms.id}`}\n              >\n                {editingMilestoneId === ms.id ? (\n                  <div className=\"project-overview-milestone-edit-row\">\n                    <input\n                      className=\"project-overview-milestone-name-input\"\n                      value={editMilestoneName}\n                      onChange={(e) => setEditMilestoneName(e.target.value)}\n                      data-testid={`project-overview-milestone-edit-name-${ms.id}`}\n                    />\n                    <input\n                      type=\"date\"\n                      className=\"project-overview-milestone-date-input\"\n                      value={editMilestoneDate}\n                      onChange={(e) => setEditMilestoneDate(e.target.value)}\n                      data-testid={`project-overview-milestone-edit-date-${ms.id}`}\n                    />\n                    <button\n                      className=\"project-overview-milestone-save-btn\"\n                      onClick={saveEditMilestone}\n                      data-testid={`project-overview-milestone-edit-save-${ms.id}`}\n                    >\n                      Save\n                    </button>\n                    <button\n                      className=\"project-overview-milestone-cancel-btn\"\n                      onClick={() => setEditingMilestoneId(null)}\n                      data-testid={`project-overview-milestone-edit-cancel-${ms.id}`}\n                    >\n                      Cancel\n                    </button>\n                  </div>\n                ) : (\n                  <>\n                    <label className=\"project-overview-milestone-check\" data-testid={`project-overview-milestone-toggle-${ms.id}`}>\n                      <input\n                        type=\"checkbox\"\n                        checked={ms.completed}\n                        onChange={() => handleToggleMilestoneComplete(ms.id, ms.completed)}\n                      />\n                    </label>\n                    <div className=\"project-overview-milestone-info\">\n                      <span\n                        className={`project-overview-milestone-name ${ms.completed ? 'project-overview-milestone-name-done' : ''}`}\n                        onClick={() => startEditMilestone(ms.id, ms.name, ms.targetDate)}\n                        data-testid={`project-overview-milestone-name-${ms.id}`}\n                      >\n                        {ms.name}\n                      </span>\n                      {ms.targetDate && (\n                        <span\n                          className=\"project-overview-milestone-date\"\n                          onClick={() => startEditMilestone(ms.id, ms.name, ms.targetDate)}\n                          data-testid={`project-overview-milestone-date-${ms.id}`}\n                        >\n                          {formatDate(ms.targetDate)}\n                        </span>\n                      )}\n                    </div>\n                    <button\n                      className=\"project-overview-milestone-delete-btn\"\n                      onClick={() => setDeletingMilestoneId(ms.id)}\n                      data-testid={`project-overview-milestone-delete-btn-${ms.id}`}\n                    >\n                      <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\">\n                        <polyline points=\"3 6 5 6 21 6\" />\n                        <path d=\"M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2\" />\n                      </svg>\n                    </button>\n                  </>\n                )}\n              </div>\n            ))}\n          </div>\n        )}\n\n        {/* Delete confirmation dialog */}\n        {deletingMilestoneId && (\n          <div className=\"project-overview-delete-dialog-overlay\" data-testid=\"project-overview-delete-dialog\">\n            <div className=\"project-overview-delete-dialog\">\n              <p>Are you sure you want to delete this milestone?</p>\n              <div className=\"project-overview-delete-dialog-actions\">\n                <button\n                  className=\"project-overview-delete-confirm-btn\"\n                  onClick={confirmDeleteMilestone}\n                  data-testid=\"project-overview-delete-confirm-btn\"\n                >\n                  Delete\n                </button>\n                <button\n                  className=\"project-overview-delete-cancel-btn\"\n                  onClick={() => setDeletingMilestoneId(null)}\n                  data-testid=\"project-overview-delete-cancel-btn\"\n                >\n                  Cancel\n                </button>\n              </div>\n            </div>\n          </div>\n        )}\n      </div>\n\n      {/* Key Metrics */}\n      <div className=\"project-overview-section\" data-testid=\"project-overview-metrics-section\">\n        <h3 className=\"project-overview-section-title\">Key Metrics</h3>\n        <div className=\"project-overview-metrics\" data-testid=\"project-overview-metrics\">\n          <div className=\"project-overview-metric\" data-testid=\"project-overview-metric-total\">\n            <span className=\"project-overview-metric-value\">{totalIssues}</span>\n            <span className=\"project-overview-metric-label\">Total Issues</span>\n          </div>\n          <div className=\"project-overview-metric\" data-testid=\"project-overview-metric-completed\">\n            <span className=\"project-overview-metric-value project-overview-metric-green\">{completedIssues}</span>\n            <span className=\"project-overview-metric-label\">Completed</span>\n          </div>\n          <div className=\"project-overview-metric\" data-testid=\"project-overview-metric-in-progress\">\n            <span className=\"project-overview-metric-value project-overview-metric-accent\">{inProgressIssues}</span>\n            <span className=\"project-overview-metric-label\">In Progress</span>\n          </div>\n          <div className=\"project-overview-metric\" data-testid=\"project-overview-metric-remaining\">\n            <span className=\"project-overview-metric-value\">{remainingIssues}</span>\n            <span className=\"project-overview-metric-label\">Remaining</span>\n          </div>\n          <div className=\"project-overview-metric\" data-testid=\"project-overview-metric-percentage\">\n            <span className=\"project-overview-metric-value project-overview-metric-green\">{completionPercentage}%</span>\n            <span className=\"project-overview-metric-label\">Complete</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n","numLines":385,"startLine":1,"totalLines":385}}}
