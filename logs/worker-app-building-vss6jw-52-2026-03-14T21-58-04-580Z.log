[2026-03-14T21:53:46.099Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012n3QG25oskKm2udi8trUKm","type":"tool_result","content":"     1→import { useState, useEffect, useCallback } from 'react'\n     2→import { useSelector, useDispatch } from 'react-redux'\n     3→import { useNavigate } from 'react-router-dom'\n     4→import type { RootState, AppDispatch } from '../store'\n     5→import {\n     6→  fetchHostStats,\n     7→  fetchHostListings,\n     8→  fetchHostBookings,\n     9→  deactivateProperty,\n    10→  activateProperty,\n    11→  updateHostBookingStatus,\n    12→} from '../slices/hostSlice'\n    13→import type { Property } from '../slices/propertiesSlice'\n    14→import StatsOverview from '../components/StatsOverview'\n    15→import ListingsTab from '../components/ListingsTab'\n    16→import BookingsTab from '../components/BookingsTab'\n    17→import AddListingForm from '../components/AddListingForm'\n    18→\n    19→type Tab = 'listings' | 'bookings'\n    20→\n    21→export default function HostDashboard() {\n    22→  const dispatch = useDispatch<AppDispatch>()\n    23→  const navigate = useNavigate()\n    24→  const currentUser = useSelector((state: RootState) => state.auth.currentUser)\n    25→  const { stats, listings, bookings, statsLoading, listingsLoading, bookingsLoading } = useSelector(\n    26→    (state: RootState) => state.host\n    27→  )\n    28→  const [activeTab, setActiveTab] = useState<Tab>('listings')\n    29→  const [showAddForm, setShowAddForm] = useState(false)\n    30→\n    31→  useEffect(() => {\n    32→    if (!currentUser) {\n    33→      navigate('/login')\n    34→    }\n    35→  }, [currentUser, navigate])\n    36→\n    37→  useEffect(() => {\n    38→    if (currentUser?.is_host) {\n    39→      dispatch(fetchHostStats(currentUser.id))\n    40→      dispatch(fetchHostListings(currentUser.id))\n    41→      dispatch(fetchHostBookings(currentUser.id))\n    42→    }\n    43→  }, [dispatch, currentUser])\n    44→\n    45→  const handleDeactivate = useCallback(async (property: Property) => {\n    46→    await dispatch(deactivateProperty(property.id))\n    47→  }, [dispatch])\n    48→\n    49→  const handleActivate = useCallback(async (property: Property) => {\n    50→    await dispatch(activateProperty(property.id))\n    51→  }, [dispatch])\n    52→\n    53→  const handleConfirmBooking = useCallback(async (bookingId: string) => {\n    54→    await dispatch(updateHostBookingStatus({ bookingId, status: 'confirmed' }))\n    55→  }, [dispatch])\n    56→\n    57→  const handleCancelBooking = useCallback(async (bookingId: string) => {\n    58→    await dispatch(updateHostBookingStatus({ bookingId, status: 'cancelled' }))\n    59→  }, [dispatch])\n    60→\n    61→  const handleAddListingSuccess = useCallback(() => {\n    62→    setShowAddForm(false)\n    63→    if (currentUser) {\n    64→      dispatch(fetchHostStats(currentUser.id))\n    65→      dispatch(fetchHostListings(currentUser.id))\n    66→    }\n    67→  }, [dispatch, currentUser])\n    68→\n    69→  if (!currentUser) {\n    70→    return null\n    71→  }\n    72→\n    73→  if (!currentUser.is_host) {\n    74→    return (\n    75→      <div data-testid=\"host-dashboard\" className=\"p-6 max-sm:p-3\">\n    76→        <div className=\"max-w-lg mx-auto text-center py-16\">\n    77→          <h1 className=\"text-2xl font-bold text-text mb-4\">Become a Host</h1>\n    78→          <p className=\"text-text-secondary mb-6\">\n    79→            You need to become a host to access this page. Visit your profile to get started.\n    80→          </p>\n    81→          <button\n    82→            data-testid=\"become-host-link\"\n    83→            onClick={() => navigate('/profile')}\n    84→            className=\"bg-primary text-white px-6 py-3 rounded-lg font-medium hover:bg-primary-dark transition-colors\"\n    85→          >\n    86→            Go to Profile\n    87→          </button>\n    88→        </div>\n    89→      </div>\n    90→    )\n    91→  }\n    92→\n    93→  return (\n    94→    <div data-testid=\"host-dashboard\" className=\"p-6 max-sm:p-3\">\n    95→      <div className=\"max-w-6xl mx-auto\">\n    96→        <h1 className=\"text-2xl font-bold text-text mb-6\">Host Dashboard</h1>\n    97→\n    98→        <StatsOverview stats={stats} loading={statsLoading} />\n    99→\n   100→        <div className=\"mt-8 mb-6\">\n   101→          <div className=\"flex border-b border-border\">\n   102→            <button\n   103→              data-testid=\"tab-listings\"\n   104→              onClick={() => setActiveTab('listings')}\n   105→              className={`px-6 py-3 text-sm font-medium border-b-2 transition-colors ${\n   106→                activeTab === 'listings'\n   107→                  ? 'border-primary text-primary'\n   108→                  : 'border-transparent text-text-secondary hover:text-text'\n   109→              }`}\n   110→            >\n   111→              Listings\n   112→            </button>\n   113→            <button\n   114→              data-testid=\"tab-bookings\"\n   115→              onClick={() => setActiveTab('bookings')}\n   116→              className={`px-6 py-3 text-sm font-medium border-b-2 transition-colors ${\n   117→                activeTab === 'bookings'\n   118→                  ? 'border-primary text-primary'\n   119→                  : 'border-transparent text-text-secondary hover:text-text'\n   120→              }`}\n   121→            >\n   122→              Bookings\n   123→            </button>\n   124→          </div>\n   125→        </div>\n   126→\n   127→        {activeTab === 'listings' && (\n   128→          <ListingsTab\n   129→            listings={listings}\n   130→            loading={listingsLoading}\n   131→            onDeactivate={handleDeactivate}\n   132→            onActivate={handleActivate}\n   133→            onAddListing={() => setShowAddForm(true)}\n   134→          />\n   135→        )}\n   136→\n   137→        {activeTab === 'bookings' && (\n   138→          <BookingsTab\n   139→            bookings={bookings}\n   140→            loading={bookingsLoading}\n   141→            onConfirm={handleConfirmBooking}\n   142→            onCancel={handleCancelBooking}\n   143→          />\n   144→        )}\n   145→\n   146→        {showAddForm && (\n   147→          <AddListingForm\n   148→            hostId={currentUser.id}\n   149→            onClose={() => setShowAddForm(false)}\n   150→            onSuccess={handleAddListingSuccess}\n   151→          />\n   152→        )}\n   153→      </div>\n   154→    </div>\n   155→  )\n   156→}\n   157→"}]},"parent_tool_use_id":null,"session_id":"b8ef0c01-5338-4db1-a807-d3d6ec6d21f8","uuid":"af275633-c385-4b0c-893e-cef33a4d1db5","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/AirbnbClone/src/pages/HostDashboard.tsx","content":"import { useState, useEffect, useCallback } from 'react'\nimport { useSelector, useDispatch } from 'react-redux'\nimport { useNavigate } from 'react-router-dom'\nimport type { RootState, AppDispatch } from '../store'\nimport {\n  fetchHostStats,\n  fetchHostListings,\n  fetchHostBookings,\n  deactivateProperty,\n  activateProperty,\n  updateHostBookingStatus,\n} from '../slices/hostSlice'\nimport type { Property } from '../slices/propertiesSlice'\nimport StatsOverview from '../components/StatsOverview'\nimport ListingsTab from '../components/ListingsTab'\nimport BookingsTab from '../components/BookingsTab'\nimport AddListingForm from '../components/AddListingForm'\n\ntype Tab = 'listings' | 'bookings'\n\nexport default function HostDashboard() {\n  const dispatch = useDispatch<AppDispatch>()\n  const navigate = useNavigate()\n  const currentUser = useSelector((state: RootState) => state.auth.currentUser)\n  const { stats, listings, bookings, statsLoading, listingsLoading, bookingsLoading } = useSelector(\n    (state: RootState) => state.host\n  )\n  const [activeTab, setActiveTab] = useState<Tab>('listings')\n  const [showAddForm, setShowAddForm] = useState(false)\n\n  useEffect(() => {\n    if (!currentUser) {\n      navigate('/login')\n    }\n  }, [currentUser, navigate])\n\n  useEffect(() => {\n    if (currentUser?.is_host) {\n      dispatch(fetchHostStats(currentUser.id))\n      dispatch(fetchHostListings(currentUser.id))\n      dispatch(fetchHostBookings(currentUser.id))\n    }\n  }, [dispatch, currentUser])\n\n  const handleDeactivate = useCallback(async (property: Property) => {\n    await dispatch(deactivateProperty(property.id))\n  }, [dispatch])\n\n  const handleActivate = useCallback(async (property: Property) => {\n    await dispatch(activateProperty(property.id))\n  }, [dispatch])\n\n  const handleConfirmBooking = useCallback(async (bookingId: string) => {\n    await dispatch(updateHostBookingStatus({ bookingId, status: 'confirmed' }))\n  }, [dispatch])\n\n  const handleCancelBooking = useCallback(async (bookingId: string) => {\n    await dispatch(updateHostBookingStatus({ bookingId, status: 'cancelled' }))\n  }, [dispatch])\n\n  const handleAddListingSuccess = useCallback(() => {\n    setShowAddForm(false)\n    if (currentUser) {\n      dispatch(fetchHostStats(currentUser.id))\n      dispatch(fetchHostListings(currentUser.id))\n    }\n  }, [dispatch, currentUser])\n\n  if (!currentUser) {\n    return null\n  }\n\n  if (!currentUser.is_host) {\n    return (\n      <div data-testid=\"host-dashboard\" className=\"p-6 max-sm:p-3\">\n        <div className=\"max-w-lg mx-auto text-center py-16\">\n          <h1 className=\"text-2xl font-bold text-text mb-4\">Become a Host</h1>\n          <p className=\"text-text-secondary mb-6\">\n            You need to become a host to access this page. Visit your profile to get started.\n          </p>\n          <button\n            data-testid=\"become-host-link\"\n            onClick={() => navigate('/profile')}\n            className=\"bg-primary text-white px-6 py-3 rounded-lg font-medium hover:bg-primary-dark transition-colors\"\n          >\n            Go to Profile\n          </button>\n        </div>\n      </div>\n    )\n  }\n\n  return (\n    <div data-testid=\"host-dashboard\" className=\"p-6 max-sm:p-3\">\n      <div className=\"max-w-6xl mx-auto\">\n        <h1 className=\"text-2xl font-bold text-text mb-6\">Host Dashboard</h1>\n\n        <StatsOverview stats={stats} loading={statsLoading} />\n\n        <div className=\"mt-8 mb-6\">\n          <div className=\"flex border-b border-border\">\n            <button\n              data-testid=\"tab-listings\"\n              onClick={() => setActiveTab('listings')}\n              className={`px-6 py-3 text-sm font-medium border-b-2 transition-colors ${\n                activeTab === 'listings'\n                  ? 'border-primary text-primary'\n                  : 'border-transparent text-text-secondary hover:text-text'\n              }`}\n            >\n              Listings\n            </button>\n            <button\n              data-testid=\"tab-bookings\"\n              onClick={() => setActiveTab('bookings')}\n              className={`px-6 py-3 text-sm font-medium border-b-2 transition-colors ${\n                activeTab === 'bookings'\n                  ? 'border-primary text-primary'\n                  : 'border-transparent text-text-secondary hover:text-text'\n              }`}\n            >\n              Bookings\n            </button>\n          </div>\n        </div>\n\n        {activeTab === 'listings' && (\n          <ListingsTab\n            listings={listings}\n            loading={listingsLoading}\n            onDeactivate={handleDeactivate}\n            onActivate={handleActivate}\n            onAddListing={() => setShowAddForm(true)}\n          />\n        )}\n\n        {activeTab === 'bookings' && (\n          <BookingsTab\n            bookings={bookings}\n            loading={bookingsLoading}\n            onConfirm={handleConfirmBooking}\n            onCancel={handleCancelBooking}\n          />\n        )}\n\n        {showAddForm && (\n          <AddListingForm\n            hostId={currentUser.id}\n            onClose={() => setShowAddForm(false)}\n            onSuccess={handleAddListingSuccess}\n          />\n        )}\n      </div>\n    </div>\n  )\n}\n","numLines":157,"startLine":1,"totalLines":157}}}
