n className=\"cabin-class-selector__arrow\">{isOpen ? '▲' : '▼'}</span>\n    43→      </button>\n    44→      {isOpen && (\n    45→        <div className=\"cabin-class-selector__dropdown\" data-testid=\"cabin-class-dropdown\">\n    46→          {cabinClasses.map((cls) => (\n    47→            <button\n    48→              key={cls.value}\n    49→              className={`cabin-class-selector__option ${cabinClass === cls.value ? 'cabin-class-selector__option--selected' : ''}`}\n    50→              onClick={() => {\n    51→                dispatch(setCabinClass(cls.value))\n    52→                setIsOpen(false)\n    53→              }}\n    54→              data-testid={`cabin-class-option-${cls.value}`}\n    55→            >\n    56→              {cls.label}\n    57→            </button>\n    58→          ))}\n    59→        </div>\n    60→      )}\n    61→    </div>\n    62→  )\n    63→}\n    64→\n    65→export default CabinClassSelector\n    66→"}]},"parent_tool_use_id":"toolu_01QZJ4zn53xoKnrVbvYzW6Vh","session_id":"67e5fc58-8ab1-425d-a7ae-dd3f15c6c632","uuid":"490c5cfc-495e-43a4-b6f7-dbb0f500f1b0"}
