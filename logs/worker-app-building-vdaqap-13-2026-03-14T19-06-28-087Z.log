[2026-03-14T19:00:01.276Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011MYByBE5SbquofgfKAZzZh","type":"tool_result","content":"     1→import { useState, useRef, useEffect } from 'react'\n     2→import { useSelector } from 'react-redux'\n     3→import type { RootState } from '../store'\n     4→import type { Airport } from '../slices/searchSlice'\n     5→import AirportAutocomplete from './AirportAutocomplete'\n     6→import DatePicker from './DatePicker'\n     7→import PassengerCountSelector from './PassengerCountSelector'\n     8→import CabinClassSelector from './CabinClassSelector'\n     9→import './SearchSummaryBar.css'\n    10→\n    11→type EditingField = 'origin' | 'destination' | 'departureDate' | 'returnDate' | 'passengers' | 'cabinClass' | null\n    12→\n    13→interface SearchSummaryBarProps {\n    14→  origin: string\n    15→  destination: string\n    16→  departureDate: string\n    17→  returnDate: string | null\n    18→  tripType: string\n    19→  cabinClass: string\n    20→  adults: number\n    21→  children: number\n    22→  infants: number\n    23→  onSearch: (params: {\n    24→    origin?: Airport\n    25→    destination?: Airport\n    26→    departureDate?: string\n    27→    returnDate?: string | null\n    28→    cabinClass?: string\n    29→    adults?: number\n    30→    children?: number\n    31→    infants?: number\n    32→  }) => void\n    33→}\n    34→\n    35→function formatDate(dateStr: string): string {\n    36→  const date = new Date(dateStr + 'T00:00:00')\n    37→  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })\n    38→}\n    39→\n    40→function formatCabinClass(cls: string): string {\n    41→  const map: Record<string, string> = {\n    42→    economy: 'Economy',\n    43→    premium_economy: 'Premium Economy',\n    44→    business: 'Business',\n    45→    first: 'First',\n    46→  }\n    47→  return map[cls] || cls\n    48→}\n    49→\n    50→function formatPassengers(adults: number, children: number, infants: number): string {\n    51→  const total = adults + children + infants\n    52→  if (total === 1) return '1 adult'\n    53→  return `${total} passengers`\n    54→}\n    55→\n    56→function SearchSummaryBar({\n    57→  origin, destination, departureDate, returnDate, tripType,\n    58→  cabinClass, adults, children, infants, onSearch,\n    59→}: SearchSummaryBarProps) {\n    60→  const [editing, setEditing] = useState<EditingField>(null)\n    61→  const containerRef = useRef<HTMLDivElement>(null)\n    62→\n    63→  const searchState = useSelector((state: RootState) => state.search)\n    64→\n    65→  useEffect(() => {\n    66→    function handleClickOutside(e: MouseEvent) {\n    67→      if (containerRef.current && !containerRef.current.contains(e.target as Node)) {\n    68→        setEditing(null)\n    69→      }\n    70→    }\n    71→    document.addEventListener('mousedown', handleClickOutside)\n    72→    return () => document.removeEventListener('mousedown', handleClickOutside)\n    73→  }, [])\n    74→\n    75→  function handleOriginSelect(airport: Airport | null) {\n    76→    if (airport) {\n    77→      onSearch({ origin: airport })\n    78→      setEditing(null)\n    79→    }\n    80→  }\n    81→\n    82→  function handleDestinationSelect(airport: Airport | null) {\n    83→    if (airport) {\n    84→      onSearch({ destination: airport })\n    85→      setEditing(null)\n    86→    }\n    87→  }\n    88→\n    89→  function handleDepartureDateSelect(date: string | null) {\n    90→    if (date) {\n    91→      onSearch({ departureDate: date })\n    92→      setEditing(null)\n    93→    }\n    94→  }\n    95→\n    96→  function handleReturnDateSelect(date: string | null) {\n    97→    if (date) {\n    98→      onSearch({ returnDate: date })\n    99→      setEditing(null)\n   100→    }\n   101→  }\n   102→\n   103→  const dateDisplay = returnDate\n   104→    ? `${formatDate(departureDate)} – ${formatDate(returnDate)}`\n   105→    : formatDate(departureDate)\n   106→\n   107→  return (\n   108→    <div className=\"search-summary-bar\" ref={containerRef} data-testid=\"search-summary-bar\">\n   109→      <div className=\"search-summary-bar__chips\">\n   110→        <div className=\"search-summary-bar__chip-wrapper\" style={{ position: 'relative' }}>\n   111→          <button\n   112→            className={`search-summary-bar__chip ${editing === 'origin' ? 'search-summary-bar__chip--active' : ''}`}\n   113→            onClick={() => setEditing(editing === 'origin' ? null : 'origin')}\n   114→            data-testid=\"summary-origin\"\n   115→          >\n   116→            <span className=\"search-summary-bar__chip-icon\">✈</span>\n   117→            {origin}\n   118→          </button>\n   119→          {editing === 'origin' && (\n   120→            <div className=\"search-summary-bar__editor\" data-testid=\"summary-origin-editor\">\n   121→              <AirportAutocomplete\n   122→                value={searchState.origin}\n   123→                onChange={handleOriginSelect}\n   124→                placeholder=\"Where from?\"\n   125→                testIdPrefix=\"summary-origin-autocomplete\"\n   126→              />\n   127→            </div>\n   128→          )}\n   129→        </div>\n   130→\n   131→        <span className=\"search-summary-bar__arrow\">→</span>\n   132→\n   133→        <div className=\"search-summary-bar__chip-wrapper\" style={{ position: 'relative' }}>\n   134→          <button\n   135→            className={`search-summary-bar__chip ${editing === 'destination' ? 'search-summary-bar__chip--active' : ''}`}\n   136→            onClick={() => setEditing(editing === 'destination' ? null : 'destination')}\n   137→            data-testid=\"summary-destination\"\n   138→          >\n   139→            <span className=\"search-summary-bar__chip-icon\">✈</span>\n   140→            {destination}\n   141→          </button>\n   142→          {editing === 'destination' && (\n   143→            <div className=\"search-summary-bar__editor\" data-testid=\"summary-destination-editor\">\n   144→              <AirportAutocomplete\n   145→                value={searchState.destination}\n   146→                onChange={handleDestinationSelect}\n   147→                placeholder=\"Where to?\"\n   148→                testIdPrefix=\"summary-dest-autocomplete\"\n   149→              />\n   150→            </div>\n   151→          )}\n   152→        </div>\n   153→\n   154→        <div className=\"search-summary-bar__divider\" />\n   155→\n   156→        <div className=\"search-summary-bar__chip-wrapper\" style={{ position: 'relative' }}>\n   157→          <button\n   158→            className={`search-summary-bar__chip ${editing === 'departureDate' ? 'search-summary-bar__chip--active' : ''}`}\n   159→            onClick={() => setEditing(editing === 'departureDate' ? null : 'departureDate')}\n   160→            data-testid=\"summary-dates\"\n   161→          >\n   162→            <span className=\"search-summary-bar__chip-icon\">📅</span>\n   163→            {dateDisplay}\n   164→          </button>\n   165→          {editing === 'departureDate' && (\n   166→            <div className=\"search-summary-bar__editor\" data-testid=\"summary-departure-editor\">\n   167→              <DatePicker\n   168→                value={departureDate}\n   169→                onChange={handleDepartureDateSelect}\n   170→                placeholder=\"Departure\"\n   171→                testIdPrefix=\"summary-departure\"\n   172→              />\n   173→            </div>\n   174→          )}\n   175→          {editing === 'returnDate' && tripType === 'round_trip' && (\n   176→            <div className=\"search-summary-bar__editor\" data-testid=\"summary-return-editor\">\n   177→              <DatePicker\n   178→                value={returnDate}\n   179→                onChange={handleReturnDateSelect}\n   180→                placeholder=\"Return\"\n   181→                minDate={departureDate}\n   182→                testIdPrefix=\"summary-return\"\n   183→              />\n   184→            </div>\n   185→          )}\n   186→        </div>\n   187→\n   188→        {tripType === 'round_trip' && returnDate && (\n   189→          <div className=\"search-summary-bar__chip-wrapper\" style={{ position: 'relative' }}>\n   190→            <button\n   191→              className={`search-summary-bar__chip ${editing === 'returnDate' ? 'search-summary-bar__chip--active' : ''}`}\n   192→              onClick={() => setEditing(editing === 'returnDate' ? null : 'returnDate')}\n   193→              data-testid=\"summary-return-date\"\n   194→            >\n   195→              <span className=\"search-summary-bar__chip-icon\">📅</span>\n   196→              Return: {formatDate(returnDate)}\n   197→            </button>\n   198→            {editing === 'returnDate' && (\n   199→              <div className=\"search-summary-bar__editor\" data-testid=\"summary-return-editor\">\n   200→                <DatePicker\n   201→                  value={returnDate}\n   202→                  onChange={handleReturnDateSelect}\n   203→                  placeholder=\"Return\"\n   204→                  minDate={departureDate}\n   205→                  testIdPrefix=\"summary-return\"\n   206→                />\n   207→              </div>\n   208→            )}\n   209→          </div>\n   210→        )}\n   211→\n   212→        <div className=\"search-summary-bar__divider\" />\n   213→\n   214→        <div className=\"search-summary-bar__chip-wrapper\" style={{ position: 'relative' }}>\n   215→          <button\n   216→            className={`search-summary-bar__chip ${editing === 'passengers' ? 'search-summary-bar__chip--active' : ''}`}\n   217→            onClick={() => setEditing(editing === 'passengers' ? null : 'passengers')}\n   218→            data-testid=\"summary-passengers\"\n   219→          >\n   220→            <span className=\"search-summary-bar__chip-icon\">👤</span>\n   221→            {formatPassengers(adults, children, infants)}\n   222→          </button>\n   223→          {editing === 'passengers' && (\n   224→            <div className=\"search-summary-bar__editor search-summary-bar__editor--wide\" data-testid=\"summary-passengers-editor\">\n   225→              <PassengerCountSelector />\n   226→            </div>\n   227→          )}\n   228→        </div>\n   229→\n   230→        <div className=\"search-summary-bar__chip-wrapper\" style={{ position: 'relative' }}>\n   231→          <button\n   232→            className={`search-summary-bar__chip ${editing === 'cabinClass' ? 'search-summary-bar__chip--active' : ''}`}\n   233→            onClick={() => setEditing(editing === 'cabinClass' ? null : 'cabinClass')}\n   234→            data-testid=\"summary-cabin-class\"\n   235→          >\n   236→            <span className=\"search-summary-bar__chip-icon\">💺</span>\n   237→            {formatCabinClass(cabinClass)}\n   238→          </button>\n   239→          {editing === 'cabinClass' && (\n   240→            <div className=\"search-summary-bar__editor\" data-testid=\"summary-cabin-editor\">\n   241→              <CabinClassSelector />\n   242→            </div>\n   243→          )}\n   244→        </div>\n   245→      </div>\n   246→    </div>\n   247→  )\n   248→}\n   249→\n   250→export default SearchSummaryBar\n   251→"}]},"parent_tool_use_id":"toolu_01QZJ4zn53xoKnrVbvYzW6Vh","session_id":"67e5fc58-8ab1-425d-a7ae-dd3f15c6c632","uuid":"23b5ef80-8340-4a6b-8913-440cb3b7db74"}
