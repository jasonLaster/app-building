[2026-03-14T18:59:26.596Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017JECeKxtjhGAZzxApPq3Do","type":"tool_result","content":"     1→import { neon } from '@neondatabase/serverless'\n     2→\n     3→export async function initSchema(databaseUrl: string) {\n     4→  const sql = neon(databaseUrl)\n     5→\n     6→  await sql`\n     7→    CREATE TABLE IF NOT EXISTS airports (\n     8→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n     9→      iata_code VARCHAR(3) UNIQUE NOT NULL,\n    10→      name TEXT NOT NULL,\n    11→      city TEXT NOT NULL,\n    12→      country TEXT NOT NULL,\n    13→      latitude DECIMAL,\n    14→      longitude DECIMAL,\n    15→      timezone TEXT\n    16→    )\n    17→  `\n    18→\n    19→  await sql`\n    20→    CREATE TABLE IF NOT EXISTS airlines (\n    21→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    22→      iata_code VARCHAR(2) UNIQUE NOT NULL,\n    23→      name TEXT NOT NULL,\n    24→      logo_color VARCHAR(7)\n    25→    )\n    26→  `\n    27→\n    28→  await sql`\n    29→    CREATE TABLE IF NOT EXISTS flights (\n    30→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    31→      airline_id UUID REFERENCES airlines(id),\n    32→      flight_number TEXT NOT NULL,\n    33→      origin_airport_id UUID REFERENCES airports(id),\n    34→      destination_airport_id UUID REFERENCES airports(id),\n    35→      departure_time TIMESTAMP NOT NULL,\n    36→      arrival_time TIMESTAMP NOT NULL,\n    37→      duration_minutes INTEGER NOT NULL,\n    38→      aircraft_type TEXT,\n    39→      has_wifi BOOLEAN DEFAULT false,\n    40→      has_power BOOLEAN DEFAULT false,\n    41→      has_entertainment BOOLEAN DEFAULT false,\n    42→      co2_kg INTEGER\n    43→    )\n    44→  `\n    45→\n    46→  await sql`\n    47→    CREATE TABLE IF NOT EXISTS flight_legs (\n    48→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    49→      flight_id UUID REFERENCES flights(id) ON DELETE CASCADE,\n    50→      leg_order INTEGER NOT NULL,\n    51→      origin_airport_id UUID REFERENCES airports(id),\n    52→      destination_airport_id UUID REFERENCES airports(id),\n    53→      departure_time TIMESTAMP NOT NULL,\n    54→      arrival_time TIMESTAMP NOT NULL,\n    55→      duration_minutes INTEGER NOT NULL,\n    56→      airline_id UUID REFERENCES airlines(id),\n    57→      flight_number TEXT,\n    58→      aircraft_type TEXT,\n    59→      terminal_departure TEXT,\n    60→      terminal_arrival TEXT\n    61→    )\n    62→  `\n    63→\n    64→  await sql`\n    65→    CREATE TABLE IF NOT EXISTS prices (\n    66→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    67→      flight_id UUID REFERENCES flights(id) ON DELETE CASCADE,\n    68→      cabin_class TEXT NOT NULL,\n    69→      base_price_cents INTEGER NOT NULL,\n    70→      taxes_cents INTEGER NOT NULL,\n    71→      total_price_cents INTEGER NOT NULL,\n    72→      available_seats INTEGER,\n    73→      created_at TIMESTAMP DEFAULT now()\n    74→    )\n    75→  `\n    76→\n    77→  await sql`\n    78→    CREATE TABLE IF NOT EXISTS sessions (\n    79→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    80→      session_token TEXT UNIQUE NOT NULL,\n    81→      created_at TIMESTAMP DEFAULT now()\n    82→    )\n    83→  `\n    84→\n    85→  await sql`\n    86→    CREATE TABLE IF NOT EXISTS recent_searches (\n    87→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n    88→      session_id UUID REFERENCES sessions(id) ON DELETE CASCADE,\n    89→      origin_airport_id UUID REFERENCES airports(id),\n    90→      destination_airport_id UUID REFERENCES airports(id),\n    91→      departure_date DATE NOT NULL,\n    92→      return_date DATE,\n    93→      passengers_adults INTEGER DEFAULT 1,\n    94→      passengers_children INTEGER DEFAULT 0,\n    95→      passengers_infants INTEGER DEFAULT 0,\n    96→      cabin_class TEXT DEFAULT 'economy',\n    97→      trip_type TEXT DEFAULT 'round_trip',\n    98→      searched_at TIMESTAMP DEFAULT now()\n    99→    )\n   100→  `\n   101→\n   102→  await sql`\n   103→    CREATE TABLE IF NOT EXISTS bookings (\n   104→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n   105→      session_id UUID REFERENCES sessions(id) ON DELETE CASCADE,\n   106→      flight_id UUID REFERENCES flights(id),\n   107→      return_flight_id UUID REFERENCES flights(id),\n   108→      booking_reference TEXT UNIQUE NOT NULL,\n   109→      cabin_class TEXT NOT NULL,\n   110→      total_price_cents INTEGER NOT NULL,\n   111→      status TEXT DEFAULT 'confirmed',\n   112→      created_at TIMESTAMP DEFAULT now()\n   113→    )\n   114→  `\n   115→\n   116→  await sql`\n   117→    CREATE TABLE IF NOT EXISTS booking_passengers (\n   118→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n   119→      booking_id UUID REFERENCES bookings(id) ON DELETE CASCADE,\n   120→      first_name TEXT NOT NULL,\n   121→      last_name TEXT NOT NULL,\n   122→      date_of_birth DATE,\n   123→      gender TEXT,\n   124→      email TEXT,\n   125→      phone TEXT,\n   126→      passenger_type TEXT DEFAULT 'adult'\n   127→    )\n   128→  `\n   129→\n   130→  await sql`\n   131→    CREATE TABLE IF NOT EXISTS tracked_routes (\n   132→      id UUID PRIMARY KEY DEFAULT gen_random_uuid(),\n   133→      session_id UUID REFERENCES sessions(id) ON DELETE CASCADE,\n   134→      origin_airport_id UUID REFERENCES airports(id),\n   135→      destination_airport_id UUID REFERENCES airports(id),\n   136→      departure_date_start DATE,\n   137→      departure_date_end DATE,\n   138→      cabin_class TEXT DEFAULT 'economy',\n   139→      created_at TIMESTAMP DEFAULT now()\n   140→    )\n   141→  `\n   142→\n   143→  // Indices\n   144→  await sql`CREATE INDEX IF NOT EXISTS idx_flights_origin ON flights(origin_airport_id)`\n   145→  await sql`CREATE INDEX IF NOT EXISTS idx_flights_destination ON flights(destination_airport_id)`\n   146→  await sql`CREATE INDEX IF NOT EXISTS idx_flights_departure ON flights(departure_time)`\n   147→  await sql`CREATE INDEX IF NOT EXISTS idx_prices_flight ON prices(flight_id)`\n   148→  await sql`CREATE INDEX IF NOT EXISTS idx_prices_cabin ON prices(cabin_class)`\n   149→  await sql`CREATE INDEX IF NOT EXISTS idx_recent_searches_session ON recent_searches(session_id)`\n   150→  await sql`CREATE INDEX IF NOT EXISTS idx_bookings_session ON bookings(session_id)`\n   151→  await sql`CREATE INDEX IF NOT EXISTS idx_airports_iata ON airports(iata_code)`\n   152→}\n   153→\n   154→// CLI entry point\n   155→if (process.argv[1] && import.meta.url.endsWith(process.argv[1].replace(/\\\\/g, '/'))) {\n   156→  const dbUrl = process.argv[2]\n   157→  if (!dbUrl) {\n   158→    console.error('Usage: tsx scripts/schema.ts <DATABASE_URL>')\n   159→    process.exit(1)\n   160→  }\n   161→  initSchema(dbUrl).then(() => console.log('Schema initialized')).catch(e => { console.error(e); process.exit(1) })\n   162→}\n   163→"}]},"parent_tool_use_id":"toolu_01QZJ4zn53xoKnrVbvYzW6Vh","session_id":"67e5fc58-8ab1-425d-a7ae-dd3f15c6c632","uuid":"5abc8934-8087-4d5d-a506-cef4be816c84"}
