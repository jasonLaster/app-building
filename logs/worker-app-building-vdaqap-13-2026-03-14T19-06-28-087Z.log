us {\n  box-shadow: 0 0 0 2px rgba(217, 48, 37, 0.15);\n}\n\n.passenger-subform__dropdown {\n  padding: 10px 12px;\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-sm);\n  font-size: 14px;\n  color: var(--color-text-primary);\n  background: var(--color-surface);\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  transition: border-color 0.15s;\n  user-select: none;\n}\n\n.passenger-subform__dropdown:hover {\n  border-color: var(--color-text-tertiary);\n}\n\n.passenger-subform__dropdown--error {\n  border-color: var(--color-error);\n}\n\n.passenger-subform__placeholder {\n  color: var(--color-text-tertiary);\n}\n\n.passenger-subform__dropdown-arrow {\n  font-size: 12px;\n  color: var(--color-text-tertiary);\n}\n\n.passenger-subform__dropdown-menu {\n  position: absolute;\n  top: 100%;\n  left: 0;\n  right: 0;\n  background: var(--color-surface);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-sm);\n  box-shadow: 0 4px 12px var(--color-shadow);\n  z-index: 100;\n  margin-top: 4px;\n}\n\n.passenger-subform__dropdown-option {\n  padding: 10px 12px;\n  font-size: 14px;\n  cursor: pointer;\n  transition: background 0.1s;\n}\n\n.passenger-subform__dropdown-option:hover {\n  background: var(--color-primary-light);\n}\n\n.passenger-subform__dropdown-option--selected {\n  color: var(--color-primary);\n  font-weight: 500;\n}\n\n.passenger-subform__error {\n  font-size: 12px;\n  color: var(--color-error);\n}\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":354,"cache_read_input_tokens":65246,"cache_creation":{"ephemeral_5m_input_tokens":354,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"global"},"context_management":null},"parent_tool_use_id":null,"session_id":"67e5fc58-8ab1-425d-a7ae-dd3f15c6c632","uuid":"3a4e527c-c17c-449d-80c6-652d21d7db9c"}
