198→  const total = nightlyTotal + cleaningFee\n   199→\n   200→  const canReserve = checkIn && checkOut && nights > 0 && !isOwnProperty && currentUser && !loading\n   201→\n   202→  const handleReserve = async () => {\n   203→    if (!currentUser) {\n   204→      navigate('/login')\n   205→      return\n   206→    }\n   207→    if (!checkIn || !checkOut || isOwnProperty) return\n   208→\n   209→    dispatch(clearBookingError())\n   210→    const result = await dispatch(\n   211→      createBooking({\n   212→        property_id: property.id,\n   213→        guest_id: currentUser.id,\n   214→        check_in: checkIn,\n   215→        check_out: checkOut,\n   216→        num_guests: guests,\n   217→        total_price: total,\n   218→      })\n   219→    )\n   220→    if (createBooking.fulfilled.match(result)) {\n   221→      setSuccess(true)\n   222→      setTimeout(() => navigate('/trips'), 1500)\n   223→    }\n   224→  }\n   225→\n   226→  const formatDisplayDate = (d: string) => {\n   227→    if (!d) return ''\n   228→    const date = new Date(d + 'T00:00:00')\n   229→    return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })\n   230→  }\n   231→\n   232→  return (\n   233→    <div data-testid=\"booking-card\" className=\"border border-border rounded-xl p-6 shadow-lg sticky top-[96px]\">\n   234→      {nights > 0 ? (\n   235→        <div className=\"flex items-baseline gap-1 mb-5\">\n   236→          <span className=\"text-[22px] font-semibold text-text\">${Number(property.price_per_night).toFixed(0)}</span>\n   237→          <span className=\"text-text-secondary\">night</span>\n   238→        </div>\n   239→      ) : (\n   240→        <p className=\"text-[22px] font-semibold text-text mb-5\">Add dates for prices</p>\n   241→      )}\n   242→\n   243→      <div className=\"border border-border rounded-lg overflow-hidden mb-4\">\n   244→        <div className=\"grid grid-cols-2 cursor-pointer\" onClick={() => setCalendarOpen(!c