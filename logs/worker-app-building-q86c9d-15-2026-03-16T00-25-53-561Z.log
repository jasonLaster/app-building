[2026-03-16T00:07:14.129Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DF94ZHRjC1uwB6cMLN1SvX","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test'\n     2→import { truncateAndSeed } from '../scripts/seed-db'\n     3→\n     4→test.beforeAll(async () => {\n     5→  const dbUrl = process.env.DATABASE_URL\n     6→  if (dbUrl) {\n     7→    await truncateAndSeed(dbUrl)\n     8→  }\n     9→})\n    10→\n    11→// b1111111: Loft, $150/night, $75 cleaning, 4 max guests, host: Sarah (a1111111)\n    12→const PROPERTY_LOFT = 'b1111111-1111-1111-1111-111111111111'\n    13→// b3333333: Cabin, $200/night, $50 cleaning, 6 max guests, host: Mike (a2222222)\n    14→const PROPERTY_CABIN = 'b3333333-3333-3333-3333-333333333333'\n    15→// Guest user: Emma Wilson (a3333333)\n    16→const GUEST_EMAIL = 'emma@example.com'\n    17→// Host user: Sarah Chen (a1111111) — owns b1111111\n    18→const HOST_EMAIL = 'sarah@example.com'\n    19→const EMMA_ID = 'a3333333-3333-3333-3333-333333333333'\n    20→\n    21→async function loginAs(page: import('@playwright/test').Page, email: string) {\n    22→  await page.goto('/login')\n    23→  await page.getByTestId('login-email-input').fill(email)\n    24→  await page.getByTestId('login-submit-button').click()\n    25→  await expect(page).toHaveURL('/', { timeout: 30000 })\n    26→}\n    27→\n    28→async function deleteAllBookings(page: import('@playwright/test').Page, guestId: string) {\n    29→  const res = await page.request.get(`/api/bookings?guest_id=${guestId}`)\n    30→  const bookings = await res.json()\n    31→  for (const booking of bookings) {\n    32→    await page.request.put(`/api/bookings/${booking.id}`, {\n    33→      data: { status: 'cancelled' },\n    34→    })\n    35→  }\n    36→}\n    37→\n    38→test.describe('Property Detail - BookingCard', () => {\n    39→  test.beforeEach(async ({ request }) => {\n    40→    // Clean up any non-seed bookings created by Emma\n    41→    const res = await request.get(`/api/bookings?guest_id=${EMMA_ID}`)\n    42→    if (res.ok()) {\n    43→      const bookings = await res.json()\n    44→      const seedBookingIds = [\n    45→        'e1111111-1111-1111-1111-111111111111',\n    46→        'e2222222-2222-2222-2222-222222222222',\n    47→        'e3333333-3333-3333-3333-333333333333',\n    48→        'e4444444-4444-4444-4444-444444444444',\n    49→        'e5555555-5555-5555-5555-555555555555',\n    50→        'e6666666-6666-6666-6666-666666666666',\n    51→      ]\n    52→      for (const booking of bookings) {\n    53→        if (!seedBookingIds.includes(booking.id)) {\n    54→          await request.put(`/api/bookings/${booking.id}`, {\n    55→            data: { status: 'cancelled' },\n    56→          })\n    57→        }\n    58→      }\n    59→    }\n    60→  })\n    61→\n    62→  test('Booking card displays price per night', async ({ page }) => {\n    63→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n    64→\n    65→    const card = page.getByTestId('booking-card')\n    66→    await expect(card).toBeVisible({ timeout: 30000 })\n    67→\n    68→    // $150 / night\n    69→    await expect(card).toContainText('$150')\n    70→    await expect(card).toContainText('/ night')\n    71→  })\n    72→\n    73→  test('Booking card displays check-in and check-out date pickers', async ({ page }) => {\n    74→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n    75→\n    76→    const card = page.getByTestId('booking-card')\n    77→    await expect(card).toBeVisible({ timeout: 30000 })\n    78→\n    79→    const checkin = page.getByTestId('booking-checkin')\n    80→    const checkout = page.getByTestId('booking-checkout')\n    81→\n    82→    await expect(checkin).toBeVisible()\n    83→    await expect(checkout).toBeVisible()\n    84→\n    85→    // Both should be date inputs and initially empty\n    86→    await expect(checkin).toHaveAttribute('type', 'date')\n    87→    await expect(checkout