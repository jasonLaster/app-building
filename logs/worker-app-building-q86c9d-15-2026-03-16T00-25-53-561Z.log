">Add your travel dates for exact pricing</p>\n   280→          </div>\n   281→          <div className=\"flex items-center justify-between mb-2\">\n   282→            <button\n   283→              onClick={handlePrevMonth}\n   284→              className=\"p-1 rounded-full hover:bg-bg-secondary cursor-pointer\"\n   285→            >\n   286→              <ChevronLeft size={20} />\n   287→            </button>\n   288→            <div />\n   289→            <button\n   290→              onClick={handleNextMonth}\n   291→              className=\"p-1 rounded-full hover:bg-bg-secondary cursor-pointer\"\n   292→            >\n   293→              <ChevronRight size={20} />\n   294→            </button>\n   295→          </div>\n   296→          <div className=\"grid grid-cols-2 gap-6\">\n   297→            <CalendarMonth\n   298→              year={calYear}\n   299→              month={calMonth}\n   300→              todayStr={todayStr}\n   301→              bookedRanges={bookedRanges}\n   302→              checkIn={checkIn}\n   303→              checkOut={checkOut}\n   304→              onSelectDate={handleSelectDate}\n   305→            />\n   306→            <CalendarMonth\n   307→              year={nextYear}\n   308→              month={nextMonth}\n   309→              todayStr={todayStr}\n   310→              bookedRanges={bookedRanges}\n   311→              checkIn={checkIn}\n   312→              checkOut={checkOut}\n   313→              onSelectDate={handleSelectDate}\n   314→            />\n   315→          </div>\n   316→          <div className=\"flex items-center justify-end gap-3 mt-4 pt-3 border-t border-border\">\n   317→            <button\n   318→              onClick={() => { setCheckIn(''); setCheckOut('') }}\n   319→              className=\"text-sm font-semibold text-text underline hover:no-underline cursor-pointer\"\n   320→            >\n   321→              Clear dates\n   322→            </button>\n   323→            <button\n   324→           