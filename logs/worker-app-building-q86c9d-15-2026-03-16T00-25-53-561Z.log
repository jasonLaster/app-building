→    // Cleaning fee: $75\n   133→    await expect(breakdown).toContainText('Cleaning fee')\n   134→    await expect(breakdown).toContainText('$75')\n   135→\n   136→    // Total: $525\n   137→    await expect(breakdown).toContainText('Total')\n   138→    await expect(breakdown).toContainText('$525')\n   139→  })\n   140→\n   141→  test('Price breakdown updates when dates change', async ({ page }) => {\n   142→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   143→\n   144→    const card = page.getByTestId('booking-card')\n   145→    await expect(card).toBeVisible({ timeout: 30000 })\n   146→\n   147→    // Initial: 3 nights\n   148→    await page.getByTestId('booking-checkin').fill('2026-05-01')\n   149→    await page.getByTestId('booking-checkout').fill('2026-05-04')\n   150→\n   151→    const breakdown = page.getByTestId('price-breakdown')\n   152→    await expect(breakdown).toContainText('$150 x 3 nights')\n   153→    await expect(breakdown).toContainText('$525')\n   154→\n   155→    // Change to 5 nights\n   156→    await page.getByTestId('booking-checkout').fill('2026-05-06')\n   157→\n   158→    // $150 x 5 nights = $750, Total: $825\n   159→    await expect(breakdown).toContainText('$150 x 5 nights')\n   160→    await expect(breakdown).toContainText('$750')\n   161→    await expect(breakdown).toContainText('$825')\n   162→  })\n   163→\n   164→  test('Reserve button creates a booking when logged in', async ({ page }) => {\n   165→    test.slow()\n   166→    await loginAs(page, GUEST_EMAIL)\n   167→\n   168→    // Clean up any existing bookings for this guest\n   169→    await deleteAllBookings(page, 'a3333333-3333-3333-3333-333333333333')\n   170→\n   171→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   172→\n   173→    const card = page.getByTestId('booking-card')\n   174→    await expect(card).toBeVisible({ timeout: 30000 })\n   175→\n   176→    // Select dates and guests\n   177→    await page.getByTestId('booking-checkin').fill('2026-07-01')\n   178→    await page.getByTestId('booking-checkout').fill('2026-07-04')\n   179→    await page.getByTestId('booking-guests').selectOption('2')\n   180→\n   181→    // Click Reserve\n   182→    const reserveBtn = page.getByTestId('reserve-button')\n   183→    await expect(reserveBtn).toBeEnabled()\n   184→    await reserveBtn.click()\n   185→\n   186→    // Success message should appear\n   187→    await expect(page.getByTestId('booking-success')).toContainText('Booking confirmed', { timeout: 30000 })\n   188→\n   189→    // Should redirect to /trips\n   190→    await expect(page).toHaveURL('/trips', { timeout: 30000 })\n   191→  })\n   192→\n   193→  test('Reserve button is disabled when dates are not selected', async ({ page }) => {\n   194→    test.slow()\n   195→    await loginAs(page, GUEST_EMAIL)\n   196→\n   197→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   198→\n   199→    const card = page.getByTestId('booking-card')\n   200→    await expect(card).toBeVisible({ timeout: 30000 })\n   201→\n   202→    // No dates selected - reserve button should be disabled\n   203→    const reserveBtn = page.getByTestId('reserve-button')\n   204→    await expect(reserveBtn).toBeVisible()\n   205→    await expect(reserveBtn).toBeDisabled()\n   206→\n   207→    // Should show hint text\n   208→    await expect(card).toContainText('Select dates to book')\n   209→  })\n   210→\n   211→  test('Reserve button prompts login when user is not logged in', async ({ page }) => {\n   212→    await page.goto(`/properties/${PROPERTY_LOFT}`)\n   213→\n   214→    const card = page.getByTestId('booking-card')\n   215→    await expect(card).toBeVisible({ timeout: 30000 })\n   216→\n   217→    // Not logged in - should show login prompt button\n   218→    const loginPrompt = page.getByTestId('booking-login-prompt')\n   219→    await expect(loginPrompt).toBeVisible()\n   220→    await expect(loginPrompt).toContainText('Log in to reserve')\n   221→\n   222→    // Click login prompt\n  