[2026-03-16T00:06:45.489Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011YUuvG7Batx7HaLMNvYPLv","type":"tool_result","content":"     1→import { useState, useEffect, useCallback } from 'react'\n     2→import { useSelector, useDispatch } from 'react-redux'\n     3→import { useNavigate } from 'react-router-dom'\n     4→import { ChevronLeft, ChevronRight } from 'lucide-react'\n     5→import type { RootState, AppDispatch } from '../store'\n     6→import type { Property } from '../slices/propertiesSlice'\n     7→import { createBooking, clearBookingError } from '../slices/bookingsSlice'\n     8→\n     9→interface BookingCardProps {\n    10→  property: Property\n    11→}\n    12→\n    13→interface BookedRange {\n    14→  check_in: string\n    15→  check_out: string\n    16→}\n    17→\n    18→function getDaysInMonth(year: number, month: number): number {\n    19→  return new Date(year, month + 1, 0).getDate()\n    20→}\n    21→\n    22→function getFirstDayOfWeek(year: number, month: number): number {\n    23→  return new Date(year, month, 1).getDay()\n    24→}\n    25→\n    26→function formatDateStr(year: number, month: number, day: number): string {\n    27→  return `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`\n    28→}\n    29→\n    30→function isDateBooked(dateStr: string, bookedRanges: BookedRange[]): boolean {\n    31→  for (const range of bookedRanges) {\n    32→    if (dateStr >= range.check_in && dateStr < range.check_out) {\n    33→      return true\n    34→    }\n    35→  }\n    36→  return false\n    37→}\n    38→\n    39→function isDateInPast(dateStr: string, todayStr: string): boolean {\n    40→  return dateStr < todayStr\n    41→}\n    42→\n    43→const MONTH_NAMES = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']\n    44→const DAY_NAMES = ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa']\n    45→\n    46→function CalendarMonth({\n    47→  year,\n    48→  month,\n    49→  todayStr,\n    50→  bookedRanges,\n    51→  checkIn,\n    52→  checkOut,\n    53→  onSelectDate,\n    54→}: {\n    55→  year: number\n    56→  month: number\n    57→  todayStr: string\n    58→  bookedRanges: BookedRange[]\n    59→  checkIn: string\n    60→  checkOut: string\n    61→  onSelectDate: (dateStr: string) => void\n    62→}) {\n    63→  const daysInMonth = getDaysInMonth(year, month)\n    64→  const firstDay = getFirstDayOfWeek(year, month)\n    65→\n    66→  const cells: (number | null)[] = []\n    67→  for (let i = 0; i < firstDay; i++) cells.push(null)\n    68→  for (let d = 1; d <= daysInMonth; d++) cells.push(d)\n    69→\n    70→  return (\n    71→    <div>\n    72→      <div className=\"text-center text-sm font-semibold text-text mb-3\">\n    73→        {MONTH_NAMES[month]} {year}\n    74→      </div>\n    75→      <div className=\"grid grid-cols-7 gap-0\">\n    76→        {DAY_NAMES.map((d) => (\n    77→          <div key={d} className=\"text-center text-xs font-semibold text-text-secondary py-1\">\n    78→            {d}\n    79→          </div>\n    80→        ))}\n    81→        {cells.map((day, idx) => {\n    82→          if (day === null) {\n    83→            return <div key={`empty-${idx}`} className=\"h-10\" />\n    84→          }\n    85→          const dateStr = formatDateStr(year, month, day)\n    86→          const isPast = isDateInPast(dateStr, todayStr)\n    87→          const booked = isDateBooked(dateStr, bookedRanges)\n    88→          const disabled = isPast || booked\n    89→          const isCheckIn = dateStr === checkIn\n    90→          const isCheckOut = dateStr === checkOut\n    91→          const isSelected = isCheckIn || isCheckOut\n    92→          const inRange = checkIn && checkOut && dateStr > checkIn && dateStr < checkOut\n    93→\n    94→          return (\n    95→            <button\n    96→              key={dateStr}\n    97→              data-testid={`calendar-day-${dateStr}`}\n    98→              disabled={disabled}\n    99→              onClick={() => !disabled && onSelectDate(dateStr)}\n   100→              className={`h-10 w-full text-sm rounded-full transition-colors cursor-pointer\n   101→                ${disabled ? 'text-border line-through cursor-not-allowed' : 'hover:bg-bg-secondary text-text'}\n   102→                ${isSelected ? 'bg-text text-white hover:bg-text' : ''}\n   103→                ${inRange ? 'bg-bg-secondary' : ''}\n   104→                ${booked ? 'bg-bg-secondary' : ''}\n   105→              `}\n   106→            >\n   107→              {day}\n   108→            </button>\n   109→          )\n   110→        })}\n   111→      </div>\n   112→    </div>\n   113→  )\n   114→}\n   115→\n   116→export default function BookingCard({ property }: BookingCardProps) {\n   117→  const dispatch = useDispatch<AppDispatch>()\n   118→  const navigate = useNavigate()\n   119→  const currentUser = useSelector((state: RootState) => state.auth.currentUser)\n   120→  const { loading, error } = useSelector((state: RootState) => state.bookings)\n   121→\n   122→  const [checkIn, setCheckIn] = useState('')\n   123→  const [checkOut, setCheckOut] = useState('')\n   124→  const [guests, setGuests] = useState(1)\n   125→  const [success, setSuccess] = useState(false)\n   126→  const [calendarOpen, setCalendarOpen] = useState(false)\n   127→  const [bookedRanges, setBookedRanges] = useState<BookedRange[]>([])\n   128→\n   129→  const now = new Date()\n   130→  const todayStr = formatDateStr(now.getFullYear(), now.getMonth(), now.getDate())\n   131→  const [calMonth, setCalMonth] = useState(now.getMonth())\n   132→  const [calYear, setCalYear] = useState(now.getFullYear())\n   133→\n   134→  const isOwnProperty = currentUser?.id === property.host_id\n   135→\n   136→  useEffect(() => {\n   137→    fetch(`/api/bookings?property_id=${property.id}`)\n   138→      .then((r) => r.json())\n   139→      .then((data) => {\n   140→        if (Array.isArray(data)) {\n   141→          setBookedRanges(data as BookedRange[])\n   142→        }\n   143→      })\n   144→      .catch(() => {})\n   145→  }, [property.id])\n   146→\n   147→  const handleSelectDate = useCallback((dateStr: string) => {\n   148→    if (!checkIn || (checkIn && checkOut)) {\n   149→      setCheckIn(dateStr)\n   150→      setCheckOut('')\n   151→    } else {\n   152→      if (dateStr <= checkIn) {\n   153→        setCheckIn(dateStr)\n   154→        setCheckOut('')\n   155→      } else {\n   156→        // Check if any booked date is between checkIn and this date\n   157→        const hasBlockedInRange = bookedRanges.some(\n   158→          (r) => r.check_in < dateStr && r.check_out > checkIn\n   159→        )\n   160→        if (hasBlockedInRange) {\n   161→          setCheckIn(dateStr)\n   162→          setCheckOut('')\n   163→        } else {\n   164→          setCheckOut(dateStr)\n   165→        }\n   166→      }\n   167→    }\n   168→  }, [checkIn, checkOut, bookedRanges])\n   169→\n   170→  const handlePrevMonth = () => {\n   171→    if (calMonth === 0) {\n   172→      setCalMonth(11)\n   173→      setCalYear(calYear - 1)\n   174→    } else {\n   175→      setCalMonth(calMonth - 1)\n   176→    }\n   177→  }\n   178→\n   179→  const handleNextMonth = () => {\n   180→    if (calMonth === 11) {\n   181→      setCalMonth(0)\n   182→      setCalYear(calYear + 1)\n   183→    } else {\n   184→      setCalMonth(calMonth + 1)\n   185→    }\n   186→  }\n   187→\n   188→  const nextMonth = calMonth === 11 ? 0 : calMonth + 1\n   189→  const nextYear = calMonth === 11 ? calYear + 1 : calYear\n   190→\n   191→  const nights =\n   192→    checkIn && checkOut\n   193→      ? Math.max(0, Math.round((new Date(checkOut).getTime() - new Date(checkIn).getTime()) / (1000 * 60 * 60 * 24)))\n   194→      : 0\n   195→\n   196→  const nightlyTotal = nights * Number(property.price_per_night)\n   197→  const cleaningFee = Number(property.cleaning_fee)\n   