[2026-03-16T00:18:48.184Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UX44BWtHq82x5BVZKuLkE5","type":"tool_result","content":"     1→import { execSync } from 'child_process'\n     2→import { readFileSync, writeFileSync, mkdirSync, existsSync, readdirSync } from 'fs'\n     3→import { join } from 'path'\n     4→import { initSchema } from './schema'\n     5→import { truncateAndSeed } from './seed-db'\n     6→\n     7→const appDir = join(import.meta.dirname, '..')\n     8→const logDir = join(appDir, 'logs')\n     9→mkdirSync(logDir, { recursive: true })\n    10→\n    11→// Find next log number\n    12→const existingLogs = readdirSync(logDir).filter(f => f.startsWith('test-run-'))\n    13→const maxNum = existingLogs.reduce((max, f) => {\n    14→  const m = f.match(/test-run-(\\d+)\\.log/)\n    15→  return m ? Math.max(max, parseInt(m[1]!)) : max\n    16→}, 0)\n    17→const logFile = join(logDir, `test-run-${maxNum + 1}.log`)\n    18→let logContent = ''\n    19→\n    20→function log(msg: string) {\n    21→  logContent += msg + '\\n'\n    22→}\n    23→\n    24→function writeLog() {\n    25→  writeFileSync(logFile, logContent)\n    26→}\n    27→\n    28→function readEnv(): Record<string, string> {\n    29→  const envPath = join(appDir, '.env')\n    30→  if (!existsSync(envPath)) return {}\n    31→  const lines = readFileSync(envPath, 'utf-8').split('\\n')\n    32→  const env: Record<string, string> = {}\n    33→  for (const line of lines) {\n    34→    const trimmed = line.trim()\n    35→    if (!trimmed || trimmed.startsWith('#')) continue\n    36→    const eqIdx = trimmed.indexOf('=')\n    37→    if (eqIdx > 0) {\n    38→      env[trimmed.slice(0, eqIdx)] = trimmed.slice(eqIdx + 1)\n    39→    }\n    40→  }\n    41→  return env\n    42→}\n    43→\n    44→function tryExec(cmd: string, opts?: Parameters<typeof execSync>[1]) {\n    45→  try { execSync(cmd, opts) } catch { /* ignored */ }\n    46→}\n    47→\n    48→function writeEnvValue(key: string, value: string) {\n    49→  const envPath = join(appDir, '.env')\n    50→  let content = ''\n    51→  if (existsSync(envPath)) {\n    52→    content = readFileSync(envPath, 'utf-8')\n    53→    const lines = content.split('\\n')\n    54→    const idx = lines.findIndex(l => l.startsWith(key + '='))\n    55→    if (idx >= 0) {\n    56→      lines[idx] = `${key}=${value}`\n    57→      content = lines.join('\\n')\n    58→    } else {\n    59→      content = content.trimEnd() + '\\n' + `${key}=${value}` + '\\n'\n    60→    }\n    61→  } else {\n    62→    content = `${key}=${value}\\n`\n    63→  }\n    64→  writeFileSync(envPath, content)\n    65→}\n    66→\n    67→function removeEnvValue(key: string) {\n    68→  const envPath = join(appDir, '.env')\n    69→  if (!existsSync(envPath)) return\n    70→  const content = readFileSync(envPath, 'utf-8')\n    71→  const lines = content.split('\\n').filter(l => !l.startsWith(key + '='))\n    72→  writeFileSync(envPath, lines.join('\\n'))\n    73→}\n    74→\n    75→const testFile = process.argv[2]\n    76→if (!testFile) {\n    77→  console.error('Usage: npm run test <test-file>')\n    78→  process.exit(1)\n    79→}\n    80→\n    81→async function run() {\n    82→  const env = readEnv()\n    83→  const neonProjectId = env['NEON_PROJECT_ID'] || process.env['NEON_PROJECT_ID'] || ''\n    84→  const neonApiKey = process.env['NEON_API_KEY'] || ''\n    85→  const replayApiKey = process.env['RECORD_REPLAY_API_KEY'] || ''\n    86→\n    87→  if (!neonProjectId || !neonApiKey) {\n    88→    console.error('Missing NEON_PROJECT_ID or NEON_API_KEY')\n    89→    process.exit(1)\n    90→  }\n    91→\n    92→  // Step 1: Kill stale processes\n    93→  tryExec('pkill -f \"netlify dev\" 2>/dev/null || true', { stdio: 'ignore' })\n    94→  tryExec('pkill -f \"vite\" 2>/dev/null || true', { stdio: 'ignore' })\n    95→\n    96→  // Step 2: Clean up stale test branches\n    97→  try {\n    98→    const branchesResp = execSync(\n    99→      `curl -s \"https://console.neon.tech/api/v2/projects/${neonProjectId}/branches\" -H \"Authorization: Bearer ${neonApiKey}\"`,\n   100→      { encoding: 'utf-8', timeout: 15000 }\n   101→    )\n   102→    const branches = JSON.parse(branchesResp).branches || []\n   103→    for (const b of branches) {\n   104→      if (typeof b.name === 'string' && b.name.startsWith('test-run-')) {\n   105→        tryExec(\n   106→          `curl -s -X DELETE \"https://console.neon.tech/api/v2/projects/${neonProjectId}/branches/${b.id}\" -H \"Authorization: Bearer ${neonApiKey}\"`,\n   107→          { stdio: 'ignore', timeout: 10000 }\n   108→        )\n   109→        log(`Cleaned up stale branch: ${b.name}`)\n   110→      }\n   111→    }\n   112→  } catch { log('Warning: could not clean stale branches') }\n   113→\n   114→  // Step 3: Create ephemeral branch\n   115→  const branchName = `test-run-${Date.now()}`\n   116→  let branchId = ''\n   117→  let testDbUrl = ''\n   118→\n   119→  try {\n   120→    const resp = execSync(\n   121→      `curl -s -X POST \"https://console.neon.tech/api/v2/projects/${neonProjectId}/branches\" -H \"Authorization: Bearer ${neonApiKey}\" -H \"Content-Type: application/json\" -d '{\"branch\": {\"name\": \"${branchName}\"}, \"endpoints\": [{\"type\": \"read_write\"}]}'`,\n   122→      { encoding: 'utf-8', timeout: 30000 }\n   123→    )\n   124→    const data = JSON.parse(resp)\n   125→    branchId = data.branch?.id || ''\n   126→    const connUri = data.connection_uris?.[0]?.connection_uri\n   127→    if (connUri) {\n   128→      testDbUrl = connUri\n   129→    } else {\n   130→      const ep = data.endpoints?.[0]\n   131→      const host = ep?.host || ''\n   132→      const role = data.roles?.[0]?.name || 'neondb_owner'\n   133→      const pwResp = execSync(\n   134→        `curl -s \"https://console.neon.tech/api/v2/projects/${neonProjectId}/branches/${branchId}/roles/${role}/reveal_password\" -H \"Authorization: Bearer ${neonApiKey}\"`,\n   135→        { encoding: 'utf-8', timeout: 10000 }\n   136→      )\n   137→      const password = JSON.parse(pwResp).password || ''\n   138→      testDbUrl = `postgresql://${role}:${password}@${host}/neondb?sslmode=require`\n   139→    }\n   140→    log(`Created branch: ${branchName} (${branchId})`)\n   141→    log(`Test DB URL: ${testDbUrl.replace(/:[^:@]+@/, ':***@')}`)\n   142→  } catch (e) {\n   143→    log(`Failed to create branch: ${e}`)\n   144→    writeLog()\n   145→    console.error('Failed to create Neon test branch')\n   146→    process.exit(1)\n   147→  }\n   148→\n   149→  // Wait for branch to be ready\n   150→  await new Promise(resolve => setTimeout(resolve, 3000))\n   151→\n   152→  // Step 4: Initialize schema and seed\n   153→  try {\n   154→    await initSchema(testDbUrl)\n   155→    log('Schema initialized')\n   156→    await truncateAndSeed(testDbUrl)\n   157→    log('Database seeded')\n   158→  } catch (e) {\n   159→    log(`Schema/seed failed: ${e}`)\n   160→    writeLog()\n   161→    console.error('Schema/seed failed — see ' + logFile)\n   162→    cleanup(branchId, neonProjectId, neonApiKey)\n   163→    process.exit(1)\n   164→  }\n   165→\n   166→  // Step 5: Write DATABASE_URL to .env so netlify dev functions can access it\n   167→  writeEnvValue('DATABASE_URL', testDbUrl)\n   168→\n   169→  // Step 6: Remove stale recordings\n   170→  tryExec('npx replayio remove --all 2>/dev/null || true', { stdio: 'ignore', cwd: appDir })\n   171→\n   172→  // Step 7: Run Playwright\n   173→  let playwrightExitCode = 0\n   174→  try {\n   175→    const pwOutput = execSync(\n   176→      `npx playwright test ${testFile} --retries 0 --workers 1`,\n   177→      {\n   178→        cwd: appDir,\n   179→        encoding: 'utf-8',\n   180→        stdio: ['ignore', 'pipe', 'pipe'],\n   181→        timeout: 300000,\n   182→        env: {\n   183→          ...process.env,\n   184→          DATABASE_URL: testDbUrl,\n   185→          RECORD_REPLAY_API_KEY: replayApiKey,\n   186→        },\n   187→      }\n   188→    )\n   189→    log('=== Playwright Output ===\\n' + pwOutput)\n   190→  } catch (e: unknown) {\n   191→    const err = e as { status?: number; stdout?: string; stderr?: string }\n   192→    playwrightExitCode = err.status || 1\n   193→    log('=== Playwright Output ===\\n' + (err.stdout || '') + '\\n' + (err.stderr || ''))\n   194→  }\n   195→\n   196→  // Step 8: Parse results\n   197→  let passed = 0\n   198→  let failed = 0\n   199→  try {\n   200→    const resultsPath = join(appDir, 'test-results', 'results.json')\n   201→    if (existsSync(resultsPath)) {\n   202→      const results = JSON.parse(readFileSync(resultsPath, 'utf-8'))\n   203→      for (const suite of results.suites || []) {\n   204→        for (const spec of suite.specs || []) {\n   205→          for (const test of spec.tests || []) {\n   206→            if (test.status === 'expected') passed++\n   207→            else if (test.status === 'unexpected') failed++\n   208→          }\n   209→        }\n   210→      }\n   211→    }\n   212→  } catch { /* ok */ }\n   213→\n   214→  // Step 9: Handle failure - upload recordings\n   215→  let uploadedId = ''\n   216→  if (playwrightExitCode !== 0) {\n   217→    try {\n   218→      const recLog = readFileSync(join(process.env['HOME'] || '~', '.replay', 'recordings.log'), 'utf-8')\n   219→      const lines = recLog.trim().split('\\n').filter(l => l.trim())\n   220→      const entries: Array<Record<string, unknown>> = []\n   221→      for (const l of lines) {\n   222→        try { entries.push(JSON.parse(l)) } catch { /* skip */ }\n   223→      }\n   224→\n   225→      const recordings: Record<string, { id: string; duration: number; result: string; title: string }> = {}\n   226→      for (const entry of entries) {\n   227→        if (entry.kind === 'createRecording') {\n   228→          recordings[entry.id as string] = { id: entry.id as string, duration: 0, result: '', title: '' }\n   229→        }\n   230→        if (entry.kind === 'addMetadata') {\n   231→          const meta = entry.metadata as Record<string, Record<string, string>> | undefined\n   232→          const rec = recordings[entry.id as string]\n   233→          if (rec && meta?.test) {\n   234→            rec.result = meta.test.result || ''\n   235→            rec.title = meta.test.title || ''\n   236→          }\n   237→        }\n   238→        if (entry.kind === 'writeFinished') {\n   239→          const rec = recordings[entry.id as string]\n   240→          if (rec) {\n   241→            rec.duration = (entry.duration as number) || 0\n   242→          }\n   243→        }\n   244→      }\n   245→\n   246→      const metadataBlock = Object.values(recordings)\n   247→        .filter(r => r.result)\n   248→        .map(r => JSON.stringify(r))\n   249→      if (metadataBlock.length) {\n   250→        log('\\n=== REPLAY RECORDINGS METADATA ===')\n   251→        for (const m of metadataBlock) log(m)\n   252→        log('=== END REPLAY RECORDINGS METADATA ===')\n   253→      }\n   254→\n   255→      const failedRecs = Object.values(recordings)\n   256→        .filter(r => r.result === 'failed' || r.result === 'timedOut')\n   257→        .sort((a, b) => b.duration - a.duration)\n   258→\n   259→      if (failedRecs[0]) {\n   260→        try {\n   261→          const uploadOut = execSync(`npx replayio upload ${failedRecs[0].id}`, {\n   262→            encoding: 'utf-8',\n   263→            cwd: appDir,\n   264→            timeout: 60000,\n   265→            env: { ...process.env, RECORD_REPLAY_API_KEY: replayApiKey },\n   266→          })\n   267→          uploadedId = failedRecs[0].id\n   268→          log(`REPLAY UPLOADED: ${uploadedId}`)\n   269→          log(uploadOut)\n   270→        } catch (ue) {\n   271→          log(`Replay upload failed: ${ue}`)\n   272→        }\n   273→      }\n   274→    } catch { log('Could not parse recordings') }\n   275→  }\n   276→\n   277→  // Step 10: Cleanup\n   278→  removeEnvValue('DAT