[2026-03-14T20:17:33.454Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M7WiC2nzRG2mQTMn6RRhC4","type":"tool_result","content":"     1→import { ChevronLeft, ChevronRight } from 'lucide-react'\n     2→\n     3→interface PaginationProps {\n     4→  currentPage: number\n     5→  totalPages: number\n     6→  onPageChange: (page: number) => void\n     7→}\n     8→\n     9→export default function Pagination({ currentPage, totalPages, onPageChange }: PaginationProps) {\n    10→  if (totalPages <= 1) return null\n    11→\n    12→  const getPageNumbers = () => {\n    13→    const pages: (number | string)[] = []\n    14→    if (totalPages <= 7) {\n    15→      for (let i = 1; i <= totalPages; i++) pages.push(i)\n    16→    } else {\n    17→      pages.push(1)\n    18→      if (currentPage > 3) pages.push('...')\n    19→      for (let i = Math.max(2, currentPage - 1); i <= Math.min(totalPages - 1, currentPage + 1); i++) {\n    20→        pages.push(i)\n    21→      }\n    22→      if (currentPage < totalPages - 2) pages.push('...')\n    23→      pages.push(totalPages)\n    24→    }\n    25→    return pages\n    26→  }\n    27→\n    28→  return (\n    29→    <nav data-testid=\"pagination\" className=\"flex items-center justify-center gap-1 mt-8\">\n    30→      <button\n    31→        data-testid=\"pagination-previous\"\n    32→        onClick={() => onPageChange(currentPage - 1)}\n    33→        disabled={currentPage <= 1}\n    34→        className=\"flex items-center justify-center w-9 h-9 rounded-full text-text disabled:opacity-30 disabled:cursor-not-allowed hover:bg-bg-secondary transition-colors\"\n    35→        aria-label=\"Previous page\"\n    36→      >\n    37→        <ChevronLeft size={18} />\n    38→      </button>\n    39→\n    40→      {getPageNumbers().map((page, index) =>\n    41→        typeof page === 'string' ? (\n    42→          <span key={`ellipsis-${index}`} className=\"w-9 h-9 flex items-center justify-center text-text-secondary text-sm\">\n    43→            ...\n    44→          </span>\n    45→        ) : (\n    46→          <button\n    47→            key={page}\n    48→            data-testid={`pagination-page-${page}`}\n    49→            onClick={() => onPageChange(page)}\n    50→            className={`w-9 h-9 rounded-full text-sm font-medium transition-colors ${\n    51→              page === currentPage\n    52→                ? 'bg-text text-bg'\n    53→                : 'text-text hover:bg-bg-secondary'\n    54→            }`}\n    55→          >\n    56→            {page}\n    57→          </button>\n    58→        )\n    59→      )}\n    60→\n    61→      <button\n    62→        data-testid=\"pagination-next\"\n    63→        onClick={() => onPageChange(currentPage + 1)}\n    64→        disabled={currentPage >= totalPages}\n    65→        className=\"flex items-center justify-center w-9 h-9 rounded-full text-text disabled:opacity-30 disabled:cursor-not-allowed hover:bg-bg-secondary transition-colors\"\n    66→        aria-label=\"Next page\"\n    67→      >\n    68→        <ChevronRight size={18} />\n    69→      </button>\n    70→    </nav>\n    71→  )\n    72→}\n    73→"}]},"parent_tool_use_id":"toolu_01FLUvQRzTj8MMmeZak2tShv","session_id":"7bb5263e-5376-4969-a996-fe1b348ef266","uuid":"8217919d-5fa2-48f7-84c4-26afdde3b99e"}
