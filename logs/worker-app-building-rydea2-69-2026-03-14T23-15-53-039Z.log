[2026-03-14T23:12:49.721Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VU9wVNDJaECUo6rve1Gw5t","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test';\n     2→\n     3→// Helper to login via API and get token\n     4→async function loginViaApi(baseURL: string, email: string, password: string) {\n     5→  const response = await fetch(`${baseURL}/api/login`, {\n     6→    method: 'POST',\n     7→    headers: { 'Content-Type': 'application/json' },\n     8→    body: JSON.stringify({ email, password }),\n     9→  });\n    10→  return response.json();\n    11→}\n    12→\n    13→// Helper to get teams via API\n    14→async function getTeams(baseURL: string, token: string) {\n    15→  const response = await fetch(`${baseURL}/api/teams`, {\n    16→    headers: { Authorization: `Bearer ${token}` },\n    17→  });\n    18→  const data = await response.json();\n    19→  return data.teams;\n    20→}\n    21→\n    22→// Helper to delete all teams via API\n    23→async function deleteAllTeams(baseURL: string, token: string) {\n    24→  const teams = await getTeams(baseURL, token);\n    25→  for (const team of teams) {\n    26→    await fetch(`${baseURL}/api/teams/${team.id}`, {\n    27→      method: 'DELETE',\n    28→      headers: { Authorization: `Bearer ${token}` },\n    29→    });\n    30→  }\n    31→}\n    32→\n    33→// Helper to create a team via API\n    34→async function createTeamViaApi(\n    35→  baseURL: string,\n    36→  token: string,\n    37→  data: { name: string; identifier: string; description?: string }\n    38→) {\n    39→  const response = await fetch(`${baseURL}/api/teams`, {\n    40→    method: 'POST',\n    41→    headers: {\n    42→      'Content-Type': 'application/json',\n    43→      Authorization: `Bearer ${token}`,\n    44→    },\n    45→    body: JSON.stringify(data),\n    46→  });\n    47→  return response.json();\n    48→}\n    49→\n    50→// Helper to login and navigate to teams page\n    51→async function loginAndNavigateToTeams(\n    52→  page: import('@playwright/test').Page,\n    53→  baseURL: string,\n    54→  email = 'alice@acme.com',\n    55→  password = 'password123'\n    56→) {\n    57→  const data = await loginViaApi(baseURL, email, password);\n    58→  await page.goto('/login');\n    59→  await page.evaluate((t) => localStorage.setItem('session_token', t), data.token);\n    60→  await page.goto('/settings/teams');\n    61→  await expect(page.getByTestId('teams-page')).toBeVisible({ timeout: 30000 });\n    62→  return { token: data.token, user: data.user };\n    63→}\n    64→\n    65→test.describe.serial('Teams Page', () => {\n    66→  test('Teams page renders with list of all teams as cards', async ({ page, baseURL }) => {\n    67→    await loginAndNavigateToTeams(page, baseURL!);\n    68→\n    69→    // Verify the page title\n    70→    await expect(page.getByTestId('teams-title')).toBeVisible();\n    71→    await expect(page.getByTestId('teams-title')).toHaveText('Teams');\n    72→\n    73→    // Verify the teams grid is visible\n    74→    await expect(page.getByTestId('teams-grid')).toBeVisible({ timeout: 30000 });\n    75→\n    76→    // Verify team cards are rendered (seed has 2 teams: Engineering, Design)\n    77→    const teamCards = page.locator('[data-testid^=\"team-card-\"]:not([data-testid*=\"-prefix-\"]):not([data-testid*=\"-name-\"]):not([data-testid*=\"-members-\"]):not([data-testid*=\"-cycle-\"])');\n    78→    await expect(teamCards).toHaveCount(2, { timeout: 30000 });\n    79→  });\n    80→\n    81→  test('Team card displays team name prominently', async ({ page, baseURL }) => {\n    82→    const { token } = await loginAndNavigateToTeams(page, baseURL!);\n    83→    const teams = await getTeams(baseURL!, token);\n    84→\n    85→    await expect(page.getByTestId('teams-grid')).toBeVisible({ timeout: 30000 });\n    86→\n    87→    // Verify each team card displays its name\n    88→    for (const team of teams) {\n    89→      const nameEl = page.getByTestId(`team-card-name-${team.id}`);\n    90→      await expect(nameEl).toBeVisible();\n    91→      await expect(nameEl).toHaveText(team.name);\n    92→    }\n    93→  });\n    94→\n    95→  test('Team card displays identifier prefix', async ({ page, baseURL }) => {\n    96→    const { token } = await loginAndNavigateToTeams(page, baseURL!);\n    97→    const teams = await getTeams(baseURL!, token);\n    98→\n    99→    await expect(page.getByTestId('teams-grid')).toBeVisible({ timeout: 30000 });\n   100→\n   101→    // Verify each team card displays its identifier prefix\n   102→    for (const team of teams) {\n   103→      const prefixEl = page.getByTestId(`team-card-prefix-${team.id}`);\n   104→      await expect(prefixEl).toBeVisible();\n   105→      await expect(prefixEl).toHaveText(team.identifier);\n   106→    }\n   107→  });\n   108→\n   109→  test('Team card displays member count', async ({ page, baseURL }) => {\n   110→    const { token } = await loginAndNavigateToTeams(page, baseURL!);\n   111→    const teams = await getTeams(baseURL!, token);\n   112→\n   113→    await expect(page.getByTestId('teams-grid')).toBeVisible({ timeout: 30000 });\n   114→\n   115→    // Verify each team card displays member count\n   116→    for (const team of teams) {\n   117→      const membersEl = page.getByTestId(`team-card-members-${team.id}`);\n   118→      await expect(membersEl).toBeVisible();\n   119→      const memberText = team.member_count === 1 ? '1 member' : `${team.member_count} members`;\n   120→      await expect(membersEl).toContainText(memberText);\n   121→    }\n   122→  });\n   123→\n   124→  test('Team card displays active cycle name when team has an active cycle', async ({ page, baseURL }) => {\n   125→    const { token } = await loginAndNavigateToTeams(page, baseURL!);\n   126→    const teams = await getTeams(baseURL!, token);\n   127→\n   128→    await expect(page.getByTestId('teams-grid')).toBeVisible({ timeout: 30000 });\n   129→\n   130→    // Engineering team has active cycle \"Sprint 12\"\n   131→    const engTeam = teams.find((t: { identifier: string }) => t.identifier === 'ENG');\n   132→    expect(engTeam).toBeTruthy();\n   133→    expect(engTeam.active_cycle_name).toBeTruthy();\n   134→\n   135→    const cycleEl = page.getByTestId(`team-card-cycle-${engTeam.id}`);\n   136→    await expect(cycleEl).toBeVisible();\n   137→    await expect(cycleEl).toContainText(engTeam.active_cycle_name);\n   138→  });\n   139→\n   140→  test('Team card displays no cycle indicator when team has no active cycle', async ({ page, baseURL }) => {\n   141→    const { token } = await loginAndNavigateToTeams(page, baseURL!);\n   142→    const teams = await getTeams(baseURL!, token);\n   143→\n   144→    await expect(page.getByTestId('teams-grid')).toBeVisible({ timeout: 30000 });\n   145→\n   146→    // Design team has no active cycle\n   147→    const desTeam = teams.find((t: { identifier: string }) => t.identifier === 'DES');\n   148→    expect(desTeam).toBeTruthy();\n   149→    expect(desTeam.active_cycle_name).toBeNull();\n   150→\n   151→    const cycleEl = page.getByTestId(`team-card-cycle-${desTeam.id}`);\n   152→    await expect(cycleEl).toBeVisible();\n   153→    await expect(cycleEl).toContainText('No active cycle');\n   154→  });\n   155→\n   156→  test('Clicking a team card navigates to team settings', async ({ page, baseURL }) => {\n   157→    const { token } = await loginAndNavigateToTeams(page, baseURL!);\n   158→    const teams = await getTeams(baseURL!, token);\n   159→\n   160→    await expect(page.getByTestId('teams-grid')).toBeVisible({ timeout: 30000 });\n   161→\n   162→    // Click the first team card\n   163→    const firstTeam = teams[0];\n   164→    await page.getByTestId(`team-card-${firstTeam.id}`).click();\n   165→\n   166→    // Verify team settings is displayed\n   167→    await expect(page.getByTestId('team-settings')).toBeVisible({ timeout: 30000 });\n   168→\n   169→    // Verify the team name is shown in settings\n   170→    await expect(page.getByTestId('team-settings-name-value')).toHaveText(firstTeam.name);\n   171→  });\n   172→\n   173→  test('Teams page shows empty state when no teams exist', async ({ page, baseURL }) => {\n   174→    // Delete all teams first\n   175→    const data = await loginViaApi(baseURL!, 'alice@acme.com', 'password123');\n   176→    await deleteAllTeams(baseURL!, data.token);\n   177→\n   178→    await page.goto('/login');\n   179→    await page.evaluate((t) => localStorage.setItem('session_token', t), data.token);\n   180→    await page.goto('/settings/teams');\n   181→    await expect(page.getByTestId('teams-page')).toBeVisible({ timeout: 30000 });\n   182→\n   183→    // Verify empty state is shown\n   184→    await expect(page.getByTestId('teams-empty')).toBeVisible({ timeout: 30000 });\n   185→\n   186→    // Verify teams grid is not shown\n   187→    await expect(page.getByTestId('teams-grid')).toHaveCount(0);\n   188→\n   189→    // Create Team button should still be visible\n   190→    await expect(page.getByTestId('create-team-btn')).toBeVisible();\n   191→  });\n   192→\n   193→  test('Teams page updates after creating a new team', async ({ page, baseURL }) => {\n   194→    const { token } = await loginAndNavigateToTeams(page, baseURL!);\n   195→\n   196→    await expect(page.getByTestId('teams-grid')).toBeVisible({ timeout: 30000 });\n   197→\n   198→    // Count initial teams\n   199→    const initialCards = page.locator('[data-testid^=\"team-card-\"]:not([data-testid*=\"-prefix-\"]):not([data-testid*=\"-name-\"]):not([data-testid*=\"-members-\"]):not([data-testid*=\"-cycle-\"])');\n   200→    const initialCount = await initialCards.count();\n   201→\n   202→    // Create a new team via the modal\n   203→    const uniqueName = `New Team ${Date.now()}`;\n   204→    const uniquePrefix = `NT${Date.now()}`.slice(0, 4).toUpperCase();\n   205→\n   206→    await page.getByTestId('create-team-btn').click();\n   207→    await expect(page.getByTestId('create-team-modal')).toBeVisible({ timeout: 10000 });\n   208→\n   209→    await page.getByTestId('create-team-name-input').fill(uniqueName);\n   210→    await page.getByTestId('create-team-identifier-input').fill(uniquePrefix);\n   211→    await page.getByTestId('create-team-submit-btn').click();\n   212→\n   213→    // Wait for modal to close\n   214→    await expect(page.getByTestId('create-team-modal')).toHaveCount(0, { timeout: 15000 });\n   215→\n   216→    // Verify the new team card appears\n   217→    await expect(initialCards).toHaveCount(initialCount + 1, { timeout: 15000 });\n   218→  });\n   219→\n   220→  test('Teams page updates after deleting a team from team settings', async ({ page, baseURL }) => {\n   221→    test.slow();\n   222→    const { token } = await loginAndNavigateToTeams(page, baseURL!);\n   223→\n   224→    await expect(page.getByTestId('teams-grid')).toBeVisible({ timeout: 30000 });\n   225→\n   226→    // Create a team to delete so we don't affect seed data\n   227→    const uniqueName = `Delete Me ${Date.now()}`;\n   228→    const uniquePrefix = `DM${Date.now()}`.slice(0, 3).toUpperCase();\n   229→    await createTeamViaApi(baseURL!, token, { name: uniqueName, identifier: uniquePrefix });\n   230→\n   231→    // Reload to see the new team\n   232→    await page.goto('/settings/teams');\n   233→    await expect(page.getByTestId('teams-grid')).toBeVisible({ timeout: 30000 });\n   234→\n   235→    // Count teams before deletion\n   236→    const cardsLocator = page.locator('[data-testid^=\"team-card-\"]:not([data-testid*=\"-prefix-\"]):not([data-testid*=\"-name-\"]):not([data-testid*=\"-members-\"]):not([data-testid*=\"-cycle-\"])');\n   237→    const countBefore = await cardsLocator.count();\n   238→\n   239→    // Find and click the team we created\n   240→    const newTeamCard = cardsLocator.filter({ has: page.locator(`[data-testid^=\"team-card-name-\"]`, { hasText: uniqueName }) });\n   241→    await expect(newTeamCard).toHaveCount(1, { timeout: 15000 });\n   242→    await newTeamCard.click();\n   243→\n   244→    // Verify we're in team settings\n   245→    await expect(page.getByTestId('team-settings')).toBeVisible({ timeout: 30000 });\n   246→\n   247→    // Delete the team\n   248→    await page.getByTestId('team-settings-delete-btn').click();\n   249→    await expect(page.getByTestId('team-settings-delete-confirm')).toBeVisible({ timeout: 10000 });\n   250→    await page.getByTestId('team-settings-confirm-delete-btn').click();\n   251→\n   252→    // Should navigate back to teams list\n   253→    await expect(page.getByTestId('teams-grid')).toBeVisible({ timeout: 30000 });\n   254→\n   255→    // Verify team count decreased\n   256→    await expect(cardsLocator).toHaveCount(countBefore - 1, { timeout: 15000 });\n   257→\n   258→    // Verify the deleted team is no longer present\n   259→    await expect(\n   260→      page.locator('[data-testid^=\"team-card-name-\"]').filter({ hasText: uniqueName })\n   261→    ).toHaveCount(0, { timeout: 15000 });\n   262→  });\n   263→});\n   264→"}]},"parent_tool_use_id":null,"session_id":"e08fcd51-8932-4cb2-94f1-10b89baa0f1a","uuid":"c549766e-c931-4721-8aba-ac2f73466eea","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/LinearClone/tests/teams-page.spec.ts","content":"import { test, expect } from '@playwright/test';\n\n// Helper to login via API and get token\nasync function loginViaApi(baseURL: string, email: string, password: string) {\n  const response = await fetch(`${baseURL}/api/login`, {\n    method: 'POST',\n    headers: { 'Content-Type': 'application/json' },\n    body: JSON.stringify({ email, password }),\n  });\n  return response.json();\n}\n\n// Helper to get teams via API\nasync function getTeams(baseURL: string, token: string) {\n  const response = await fetch(`${baseURL}/api/teams`, {\n    headers: { Authorization: `Bearer ${token}` },\n  });\n  const data = await response.json();\n  return data.teams;\n}\n\n// Helper to delete all teams via API\nasync function deleteAllTeams(baseURL: string, token: string) {\n  const teams = await getTeams(baseURL, token);\n  for (const team of teams) {\n    await fetch(`${baseURL}/api/teams/${team.id}`, {\n      method: 'DELETE',\n      headers: { Authorization: `Bearer ${token}` },\n    });\n  }\n}\n\n// Helper to create a team via API\nasync function createTeamViaApi(\n  baseURL: string,\n  token: string,\n  data: { name: string; identifier: string; description?: string }\n) {\n  const response = await fetch(`${baseURL}/api/teams`, {\n    method: 'POST',\n    headers: {\n      'Content-Type': 'application/json',\n      Authorization: `Bearer ${token}`,\n    },\n    body: JSON.stringify(data),\n  });\n  return response.json();\n}\n\n// Helper to login and navigate to teams page\nasync function loginAndNavigateToTeams(\n  page: import('@playwright/test').Page,\n  baseURL: string,\n  email = 'alice@acme.com',\n  password = 'password123'\n) {\n  const data = await loginViaApi(baseURL, email, password);\n  await page.goto('/login');\n  await page.evaluate((t) => localStorage.setItem('session_token', t), data.token);\n  await page.goto('/settings/teams');\n  await expect(page.getByTestId('teams-page')).toBeVisible({ timeout: 30000 });\n  return { token: data.token, user: data.user };\n}\n\ntest.describe.serial('Teams Page', () => {\n  test('Teams page renders with list of all teams as cards', async ({ page, baseURL }) => {\n    await loginAndNavigateToTeams(page, baseURL!);\n\n    // Verify the page title\n    await expect(page.getByTestId('teams-title')).toBeVisible();\n    await expect(page.getByTestId('teams-title')).toHaveText('Teams');\n\n    // Verify the teams grid is visible\n    await expect(page.getByTestId('teams-grid')).toBeVisible({ timeout: 30000 });\n\n    // Verify team cards are rendered (seed has 2 teams: Engineering, Design)\n    const teamCards = page.locator('[data-testid^=\"team-card-\"]:not([data-testid*=\"-prefix-\"]):not([data-testid*=\"-name-\"]):not([data-testid*=\"-members-\"]):not([data-testid*=\"-cycle-\"])');\n    await expect(teamCards).toHaveCount(2, { timeout: 30000 });\n  });\n\n  test('Team card displays team name prominently', async ({ page, baseURL }) => {\n    const { token } = await loginAndNavigateToTeams(page, baseURL!);\n    const teams = await getTeams(baseURL!, token);\n\n    await expect(page.getByTestId('teams-grid')).toBeVisible({ timeout: 30000 });\n\n    // Verify each team card displays its name\n    for (const team of teams) {\n      const nameEl = page.getByTestId(`team-card-name-${team.id}`);\n      await expect(nameEl).toBeVisible();\n      await expect(nameEl).toHaveText(team.name);\n    }\n  });\n\n  test('Team card displays identifier prefix', async ({ page, baseURL }) => {\n    const { token } = await loginAndNavigateToTeams(page, baseURL!);\n    const teams = await getTeams(baseURL!, token);\n\n    await expect(page.getByTestId('teams-grid')).toBeVisible({ timeout: 30000 });\n\n    // Verify each team card displays its identifier prefix\n    for (const team of teams) {\n      const prefixEl = page.getByTestId(`team-card-prefix-${team.id}`);\n      await expect(prefixEl).toBeVisible();\n      await expect(prefixEl).toHaveText(team.identifier);\n    }\n  });\n\n  test('Team card displays member count', async ({ page, baseURL }) => {\n    const { token } = await loginAndNavigateToTeams(page, baseURL!);\n    const teams = await getTeams(baseURL!, token);\n\n    await expect(page.getByTestId('teams-grid')).toBeVisible({ timeout: 30000 });\n\n    // Verify each team card displays member count\n    for (const team of teams) {\n      const membersEl = page.getByTestId(`team-card-members-${team.id}`);\n      await expect(membersEl).toBeVisible();\n      const memberText = team.member_count === 1 ? '1 member' : `${team.member_count} members`;\n      await expect(membersEl).toContainText(memberText);\n    }\n  });\n\n  test('Team card displays active cycle name when team has an active cycle', async ({ page, baseURL }) => {\n    const { token } = await loginAndNavigateToTeams(page, baseURL!);\n    const teams = await getTeams(baseURL!, token);\n\n    await expect(page.getByTestId('teams-grid')).toBeVisible({ timeout: 30000 });\n\n    // Engineering team has active cycle \"Sprint 12\"\n    const engTeam = teams.find((t: { identifier: string }) => t.identifier === 'ENG');\n    expect(engTeam).toBeTruthy();\n    expect(engTeam.active_cycle_name).toBeTruthy();\n\n    const cycleEl = page.getByTestId(`team-card-cycle-${engTeam.id}`);\n    await expect(cycleEl).toBeVisible();\n    await expect(cycleEl).toContainText(engTeam.active_cycle_name);\n  });\n\n  test('Team card displays no cycle indicator when team has no active cycle', async ({ page, baseURL }) => {\n    const { token } = await loginAndNavigateToTeams(page, baseURL!);\n    const teams = await getTeams(baseURL!, token);\n\n    await expect(page.getByTestId('teams-grid')).toBeVisible({ timeout: 30000 });\n\n    // Design team has no active cycle\n    const desTeam = teams.find((t: { identifier: string }) => t.identifier === 'DES');\n    expect(desTeam).toBeTruthy();\n    expect(desTeam.active_cycle_name).toBeNull();\n\n    const cycleEl = page.getByTestId(`team-card-cycle-${desTeam.id}`);\n    await expect(cycleEl).toBeVisible();\n    await expect(cycleEl).toContainText('No active cycle');\n  });\n\n  test('Clicking a team card navigates to team settings', async ({ page, baseURL }) => {\n    const { token } = await loginAndNavigateToTeams(page, baseURL!);\n    const teams = await getTeams(baseURL!, token);\n\n    await expect(page.getByTestId('teams-grid')).toBeVisible({ timeout: 30000 });\n\n    // Click the first team card\n    const firstTeam = teams[0];\n    await page.getByTestId(`team-card-${firstTeam.id}`).click();\n\n    // Verify team settings is displayed\n    await expect(page.getByTestId('team-settings')).toBeVisible({ timeout: 30000 });\n\n    // Verify the team name is shown in settings\n    await expect(page.getByTestId('team-settings-name-value')).toHaveText(firstTeam.name);\n  });\n\n  test('Teams page shows empty state when no teams exist', async ({ page, baseURL }) => {\n    // Delete all teams first\n    const data = await loginViaApi(baseURL!, 'alice@acme.com', 'password123');\n    await deleteAllTeams(baseURL!, data.token);\n\n    await page.goto('/login');\n    await page.evaluate((t) => localStorage.setItem('session_token', t), data.token);\n    await page.goto('/settings/teams');\n    await expect(page.getByTestId('teams-page')).toBeVisible({ timeout: 30000 });\n\n    // Verify empty state is shown\n    await expect(page.getByTestId('teams-empty')).toBeVisible({ timeout: 30000 });\n\n    // Verify teams grid is not shown\n    await expect(page.getByTestId('teams-grid')).toHaveCount(0);\n\n    // Create Team button should still be visible\n    await expect(page.getByTestId('create-team-btn')).toBeVisible();\n  });\n\n  test('Teams page updates after creating a new team', async ({ page, baseURL }) => {\n    const { token } = await loginAndNavigateToTeams(page, baseURL!);\n\n    await expect(page.getByTestId('teams-grid')).toBeVisible({ timeout: 30000 });\n\n    // Count initial teams\n    const initialCards = page.locator('[data-testid^=\"team-card-\"]:not([data-testid*=\"-prefix-\"]):not([data-testid*=\"-name-\"]):not([data-testid*=\"-members-\"]):not([data-testid*=\"-cycle-\"])');\n    const initialCount = await initialCards.count();\n\n    // Create a new team via the modal\n    const uniqueName = `New Team ${Date.now()}`;\n    const uniquePrefix = `NT${Date.now()}`.slice(0, 4).toUpperCase();\n\n    await page.getByTestId('create-team-btn').click();\n    await expect(page.getByTestId('create-team-modal')).toBeVisible({ timeout: 10000 });\n\n    await page.getByTestId('create-team-name-input').fill(uniqueName);\n    await page.getByTestId('create-team-identifier-input').fill(uniquePrefix);\n    await page.getByTestId('create-team-submit-btn').click();\n\n    // Wait for modal to close\n    await expect(page.getByTestId('create-team-modal')).toHaveCount(0, { timeout: 15000 });\n\n    // Verify the new team card appears\n    await expect(initialCards).toHaveCount(initialCount + 1, { timeout: 15000 });\n  });\n\n  test('Teams page updates after deleting a team from team settings', async ({ page, baseURL }) => {\n    test.slow();\n    const { token } = await loginAndNavigateToTeams(page, baseURL!);\n\n    await expect(page.getByTestId('teams-grid')).toBeVisible({ timeout: 30000 });\n\n    // Create a team to delete so we don't affect seed data\n    const uniqueName = `Delete Me ${Date.now()}`;\n    const uniquePrefix = `DM${Date.now()}`.slice(0, 3).toUpperCase();\n    await createTeamViaApi(baseURL!, token, { name: uniqueName, identifier: uniquePrefix });\n\n    // Reload to see the new team\n    await page.goto('/settings/teams');\n    await expect(page.getByTestId('teams-grid')).toBeVisible({ timeout: 30000 });\n\n    // Count teams before deletion\n    const cardsLocator = page.locator('[data-testid^=\"team-card-\"]:not([data-testid*=\"-prefix-\"]):not([data-testid*=\"-name-\"]):not([data-testid*=\"-members-\"]):not([data-testid*=\"-cycle-\"])');\n    const countBefore = await cardsLocator.count();\n\n    // Find and click the team we created\n    const newTeamCard = cardsLocator.filter({ has: page.locator(`[data-testid^=\"team-card-name-\"]`, { hasText: uniqueName }) });\n    await expect(newTeamCard).toHaveCount(1, { timeout: 15000 });\n    await newTeamCard.click();\n\n    // Verify we're in team settings\n    await expect(page.getByTestId('team-settings')).toBeVisible({ timeout: 30000 });\n\n    // Delete the team\n    await page.getByTestId('team-settings-delete-btn').click();\n    await expect(page.getByTestId('team-settings-delete-confirm')).toBeVisible({ timeout: 10000 });\n    await page.getByTestId('team-settings-confirm-delete-btn').click();\n\n    // Should navigate back to teams list\n    await expect(page.getByTestId('teams-grid')).toBeVisible({ timeout: 30000 });\n\n    // Verify team count decreased\n    await expect(cardsLocator).toHaveCount(countBefore - 1, { timeout: 15000 });\n\n    // Verify the deleted team is no longer present\n    await expect(\n      page.locator('[data-testid^=\"team-card-name-\"]').filter({ hasText: uniqueName })\n    ).toHaveCount(0, { timeout: 15000 });\n  });\n});\n","numLines":264,"startLine":1,"totalLines":264}}}
