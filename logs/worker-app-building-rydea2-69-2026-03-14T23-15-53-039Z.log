amCard\n              key={team.id}\n              team={team}\n              onClick={(id) => setSelectedTeamId(id)}\n            />\n          ))}\n        </div>\n      )}\n\n      <CreateTeamModal\n        open={createModalOpen}\n        onClose={() => setCreateModalOpen(false)}\n        onSubmit={handleCreateTeam}\n      />\n    </div>\n  );\n}\n","numLines":102,"startLine":1,"totalLines":102}}}
