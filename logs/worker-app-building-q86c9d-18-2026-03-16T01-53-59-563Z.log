000 })\n\n      // Switch to Cancelled tab\n      await page.getByTestId('tab-cancelled').click()\n\n      // Booking should appear in Cancelled tab with red cancelled badge\n      await expect(page.getByTestId('trip-card-e7777777-7777-7777-7777-777777777777')).toBeVisible({ timeout: 30000 })\n      const badge = page.getByTestId('status-badge-e7777777-7777-7777-7777-777777777777')\n      await expect(badge).toHaveText('Cancelled')\n      await expect(badge).toHaveClass(/text-status-cancelled/)\n    })\n  })\n})\n","structuredPatch":[{"oldStart":104,"oldLines":90,"newStart":104,"newLines":96,"lines":["     await expect(dialog).toContainText('May 13, 2026')","   })"," ","-  // --- Destructive tests below (each uses a unique booking) ---","+  // --- Destructive tests below: each cancels a distinct booking, run serially with cleanup ---","+  test.describe.serial('Destructive cancellation tests', () => {","+    test.beforeEach(async ({ request }) => {","+      // Reset all seed booking statuses before each destructive test","+      await request.delete('http://localhost:8888/api/bookings')","+    })"," ","-  test('Cancel dialog is functional on repeated use', async ({ page }) => {","-    test.slow()","-    await loginAs(page, 'emma@example.com')","-    await page.goto('/trips')","-    await expect(page.getByTestId('my-trips-page')).toBeVisible({ timeout: 30000 })","+    test('Confirming cancellation updates booking status to cancelled', async ({ page }) => {","+      await loginAs(page, 'emma@example.com')","+      await page.goto('/trips')","+      await expect(page.getByTestId('my-trips-page')).toBeVisible({ timeout: 30000 })"," ","-    // First: open cancel dialog for e3333333 (pending) and dismiss it","-    await page.getByTestId('cancel-button-e3333333-3333-3333-3333-333333333333').click()","-    await expect(page.getByTestId('cancel-dialog')).toBeVisible({ timeout: 30000 })","-    await page.getByTestId('cancel-dialog-dismiss').click()","-    await expect(page.get