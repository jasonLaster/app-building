 '2026-04-10', 2, 'business', 'round_trip')`\n   289→\n   290→  // Sample bookings\n   291→  const flightForBooking = await sql`SELECT id FROM flights WHERE flight_number = 'AA100' LIMIT 1`\n   292→  const bookingFlight = flightForBooking[0]\n   293→  if (bookingFlight) {\n   294→    await sql`INSERT INTO bookings (session_id, flight_id, booking_reference, cabin_class, total_price_cents, status)\n   295→      VALUES (${sessionId}, ${bookingFlight.id}, 'GF-ABC123', 'economy', 34385, 'confirmed')`\n   296→    const bookingRows = await sql`SELECT id FROM bookings WHERE booking_reference = 'GF-ABC123'`\n   297→    const booking = bookingRows[0]\n   298→    if (booking) {\n   299→      await sql`INSERT INTO booking_passengers (booking_id, first_name, last_name, date_of_birth, gender, email, phone, passenger_type)\n   300→        VALUES (${booking.id}, 'John', 'Doe', '1990-05-15', 'male', 'john@example.com', '+1234567890', 'adult')`\n   301→    }\n   302→  }\n   303→\n   304→  // Tracked routes\n   305→  await sql`INSERT INTO tracked_routes (session_id, origin_airport_id, destination_airport_id, departure_date_start, departure_date_end, cabin_class)\n   306→    VALUES (${sessionId}, ${laxId}, ${lhrId}, '2026-04-15', '2026-04-30', 'economy')`\n   307→}\n   308→\n   309→// CLI entry point\n   310→const isMain = process.argv[1] && import.meta.url.endsWith(process.argv[1].replace(/\\\\/g, '/'))\n   311→if (isMain) {\n   312→  const dbUrl = process.argv[2]\n   313→  if (!dbUrl) {\n   314→    console.error('Usage: tsx scripts/seed-db.ts <DATABASE_URL>')\n   315→    process.exit(1)\n   316→  }\n   317→  truncateAndSeed(dbUrl).then(() => console.log('Seed complete')).catch(e => { console.error(e); process.exit(1) })\n   318→}\n   319→"}]},"parent_tool_use_id":null,"session_id":"c57d308f-3e24-4929-8214-3f3c5358ad0b","uuid":"8200092e-f851-41be-97af-fe2730874edd","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/GoogleFlights/scripts/seed-db.ts","content":"import { neo