       value={origin}\n    45→              onChange={(airport) => dispatch(setOrigin(airport))}\n    46→              placeholder=\"Where from?\"\n    47→              error={validationErrors['origin']}\n    48→              testIdPrefix=\"origin\"\n    49→            />\n    50→            <button\n    51→              className=\"search-page__swap-btn\"\n    52→              onClick={() => dispatch(swapAirports())}\n    53→              data-testid=\"swap-airports-button\"\n    54→              title=\"Swap origin and destination\"\n    55→            >\n    56→              ⇄\n    57→            </button>\n    58→            <AirportAutocomplete\n    59→              value={destination}\n    60→              onChange={(airport) => dispatch(setDestination(airport))}\n    61→              placeholder=\"Where to?\"\n    62→              error={validationErrors['destination']}\n    63→              testIdPrefix=\"destination\"\n    64→            />\n    65→          </div>\n    66→\n    67→          <div className=\"search-page__dates\">\n    68→            <DatePicker\n    69→              value={departureDate}\n    70→              onChange={(date) => dispatch(setDepartureDate(date))}\n    71→              placeholder=\"Departure\"\n    72→              error={validationErrors['departureDate']}\n    73→              testIdPrefix=\"departure-date\"\n    74→            />\n    75→            {tripType === 'round_trip' && (\n    76→              <DatePicker\n    77→                value={returnDate}\n    78→                onChange={(date) => dispatch(setReturnDate(date))}\n    79→                placeholder=\"Return\"\n    80→                minDate={departureDate}\n    81→                error={validationErrors['returnDate']}\n    82→                testIdPrefix=\"return-date\"\n    83→              />\n    84→            )}\n    85→          </div>\n    86→\n    87→          <div className=\"search-page__search-action\">\n    88→            <SearchButton />\n    89→          </div>\n    90→        </div>\n    91→      </div>\n    92→\n    93→      <div className=\"search-page__content\">\n    94→        <RecentSearches />\n    95→        <PopularDestinations />\n    96→      </div>\n    97→    </div>\n    98→  )\n    99→}\n   100→\n   101→export default SearchPage\n   102→"}]},"parent_tool_use_id":null,"session_id":"c57d308f-3e24-4929-8214-3f3c5358ad0b","uuid":"3238e141-4633-4ecc-8d15-c2addab78366","tool_use_result":{"type":"text","file":{"filePath":"/repo/apps/GoogleFlights/src/pages/SearchPage.tsx","content":"import { useDispatch, useSelector } from 'react-redux'\nimport {\n  setOrigin,\n  setDestination,\n  swapAirports,\n  setDepartureDate,\n  setReturnDate,\n} from '../slices/searchSlice'\nimport type { RootState } from '../store'\nimport TripTypeSelector from '../components/TripTypeSelector'\nimport PassengerCountSelector from '../components/PassengerCountSelector'\nimport CabinClassSelector from '../components/CabinClassSelector'\nimport AirportAutocomplete from '../components/AirportAutocomplete'\nimport DatePicker from '../components/DatePicker'\nimport SearchButton from '../components/SearchButton'\nimport RecentSearches from '../components/RecentSearches'\nimport PopularDestinations from '../components/PopularDestinations'\nimport './SearchPage.css'\n\nfunction SearchPage() {\n  const dispatch = useDispatch()\n  const {\n    tripType,\n    origin,\n    destination,\n    departureDate,\n    returnDate,\n    validationErrors,\n  } = useSelector((state: RootState) => state.search)\n\n  return (\n    <div className=\"search-page\" data-testid=\"search-page\">\n      <div className=\"search-page__hero\">\n        <h1 className=\"search-page__title\">Flights</h1>\n        <div className=\"search-page__form\" data-testid=\"search-form\">\n          <div className=\"search-page__selectors\">\n            <TripTypeSelector />\n            <PassengerCountSelector />\n            <CabinClassSelector />\n          </div>\n\n          <div className=\"search-page__airports\">\n            <AirportAutocomplete\n              value={origin}\n              onChange={(airport) => dispatch(setOrigin(airport))}\n              placeholder=\"Where from?\"\n              error={validationErrors['origin']}\n              testIdPrefix=\"origin\"\n            />\n            <button\n              className=\"search-page__swap-btn\"\n              onClick={() => dispatch(swapAirports())}\n              data-testid=\"swap-airports-button\"\n              title=\"Swap origin and destination\"\n            >\n              ⇄\n            </button>\n            <AirportAutocomplete\n              value={destination}\n              onChange={(airport) => dispatch(setDestination(airport))}\n              placeholder=\"Where to?\"\n              error={validationErrors['destination']}\n              testIdPrefix=\"destination\"\n            />\n          </div>\n\n          <div className=\"search-page__dates\">\n            <DatePicker\n              value={departureDate}\n              onChange={(date) => dispatch(setDepartureDate(date))}\n              placeholder=\"Departure\"\n              error={validationErrors['departureDate']}\n              testIdPrefix=\"departure-date\"\n            />\n            {tripType === 'round_trip' && (\n              <DatePicker\n                value={returnDate}\n                onChange={(date) => dispatch(setReturnDate(date))}\n                placeholder=\"Return\"\n                minDate={departureDate}\n                error={validationErrors['returnDate']}\n                testIdPrefix=\"return-date\"\n              />\n            )}\n          </div>\n\n          <div className=\"search-page__search-action\">\n            <SearchButton />\n          </div>\n        </div>\n      </div>\n\n      <div className=\"search-page__content\">\n        <RecentSearches />\n        <PopularDestinations />\n      </div>\n    </div>\n  )\n}\n\nexport default SearchPage\n","numLines":102,"startLine":1,"totalLines":102}}}
