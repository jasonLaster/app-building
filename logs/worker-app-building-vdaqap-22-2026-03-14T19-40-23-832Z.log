+) {\n   136→        const stop = stops[i]!\n   137→        const legOriginId = airportMap.get(stop.origin)\n   138→        const legDestId = airportMap.get(stop.dest)\n   139→        if (!legOriginId || !legDestId) continue\n   140→        await sql`\n   141→          INSERT INTO flight_legs (flight_id, leg_order, origin_airport_id, destination_airport_id, departure_time, arrival_time, duration_minutes, airline_id, flight_number, aircraft_type, terminal_departure, terminal_arrival)\n   142→          VALUES (${flightId}, ${i + 1}, ${legOriginId}, ${legDestId}, ${stop.dep}, ${stop.arr}, ${stop.dur}, ${airlineId}, ${flightNum}, ${aircraft}, ${stop.terminal_dep || null}, ${stop.terminal_arr || null})\n   143→        `\n   144→      }\n   145→    } else {\n   146→      await sql`\n   147→        INSERT INTO flight_legs (flight_id, leg_order, origin_airport_id, destination_airport_id, departure_time, arrival_time, duration_minutes, airline_id, flight_number, aircraft_type, terminal_departure, terminal_arrival)\n   148→        VALUES (${flightId}, ${1}, ${originId}, ${destId}, ${depTime}, ${arrTime}, ${durationMin}, ${airlineId}, ${flightNum}, ${aircraft}, ${'T1'}, ${'T2'})\n   149→      `\n   150→    }\n   151→\n   152→    // Add prices for all cabin classes\n   153→    const premiumMult = 1.8\n   154→    const businessMult = 3.5\n   155→    const firstMult = 6.0\n   156→    const taxRate = 0.15\n   157→\n   158→    for (const [cabinClass, mult] of [['economy', 1], ['premium_economy', premiumMult], ['business', businessMult], ['first', firstMult]] as [string, number][]) {\n   159→      const basePrice = Math.round(economyPrice * mult * 100)\n   160→      const taxes = Math.round(basePrice * taxRate)\n   161→      const total = basePrice + taxes\n   162→      const seats = Math.floor(Math.random() * 30) + 5\n   163→      await sql`\n   164→        INSERT INTO prices (flight_id, cabin_class, base_price_cents, taxes_cents, total_price_cents, available_seats)\n   165→        VALUES (${flightId}, ${cabinClass}, ${basePrice}, ${taxes}, ${total}, ${seats})\n   166→      `\n   167→    }\n   168→  }\n   169→\n   170→  // Create ~200 flights with realistic routes\n   171→  // LAX routes\n   172→  await createFlight('AA', 'AA100', 'LAX', 'JFK', '2026-04-01 08:00', '2026-04-01 16:30', 330, 'Boeing 777-300ER', true, true, true, 180, 299)\n   173→  await createFlight('DL', 'DL200', 'LAX', 'JFK', '2026-04-01 10:15', '2026-04-01 18:45', 330, 'Airbus A321neo', true, true, true, 165, 279)\n   174→  await createFlight('UA', 'UA300', 'LAX', 'JFK', '2026-04-01 14:00', '2026-04-01 22:30', 330, 'Boeing 787-9', true, true, true, 150, 319)\n   175→  await createFlight('B6', 'B6400', 'LAX', 'JFK', '2026-04-01 06:00', '2026-04-01 14:30', 330, 'Airbus A321', true, true, false, 170, 199)\n   176→  await createFlight('AA', 'AA101', 'LAX', 'JFK', '2026-04-01 12:00', '2026-04-01 23:00', 420, 'Boeing 737 MAX', true, true, true, 210,\n   177→    199, [\n   178→      { origin: 'LAX', dest: 'DFW', dep: '2026-04-01 12:00', arr: '2026-04-01 17:00', dur: 180, terminal_dep: 'T4', terminal_arr: 'TC' },\n   179→      { origin: 'DFW', dest: 'JFK', dep: '2026-04-01 18:30', arr: '2026-04-01 23:00', dur: 210, terminal_dep: 'TC', terminal_arr: 'T8' }\n   180→    ])\n   181→\n   182→  await createFlight('DL', 'DL201', 'LAX', 'ATL', '2026-04-01 07:00', '2026-04-01 14:30', 270, 'Boeing 757-200', true, true, true, 155, 249)\n   183→  await createFlight('UA', 'UA301', 'LAX', 'SFO', '2026-04-01 09:00', '2026-04-01 10:30', 90, 'Airbus A320', false, true, false, 60, 99)\n   184→  await createFlight('WN', 'WN100', 'LAX', 'LAS', '2026-04-01 11:00', '2026-04-01 12:15', 75, 'Boeing 737-800', false, false, false, 45, 69)\n   185→  await createFlight('AS', 'AS100', 'LAX', 'SEA', '2026-04-01 08:30', '2026-04-01 11:15', 165, 'Boeing 737-900ER', true, true, false, 95, 129)\n   186→  await createFlight('AA', 'AA102', 'LAX', 'MIA', '2026-04-01 09:00', '2026-04-01 17:00', 300, 'Boeing 787-8', true