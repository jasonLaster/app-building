[2026-03-14T22:31:02.506Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XmSwSKaaoNiJcC8bh3Ceim","type":"tool_result","content":"     1→import type { Context } from '@netlify/functions';\n     2→import { getSql } from './db';\n     3→\n     4→export default async function handler(req: Request, _context: Context) {\n     5→  try {\n     6→    const authHeader = req.headers.get('Authorization');\n     7→    if (!authHeader?.startsWith('Bearer ')) {\n     8→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n     9→        status: 401,\n    10→        headers: { 'Content-Type': 'application/json' },\n    11→      });\n    12→    }\n    13→\n    14→    const token = authHeader.slice(7);\n    15→    const sql = getSql();\n    16→\n    17→    const sessions = await sql`\n    18→      SELECT s.member_id FROM sessions s\n    19→      WHERE s.token = ${token} AND s.expires_at > NOW()\n    20→    `;\n    21→    const session = sessions[0];\n    22→    if (!session) {\n    23→      return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    24→        status: 401,\n    25→        headers: { 'Content-Type': 'application/json' },\n    26→      });\n    27→    }\n    28→\n    29→    if (req.method === 'GET') {\n    30→      // Fetch all projects with lead info, issue counts, and team info\n    31→      const projects = await sql`\n    32→        SELECT\n    33→          p.id,\n    34→          p.name,\n    35→          p.description,\n    36→          p.status,\n    37→          p.target_date,\n    38→          p.lead_id,\n    39→          m.name AS lead_name,\n    40→          m.email AS lead_email,\n    41→          COUNT(i.id)::int AS total_issues,\n    42→          COUNT(CASE WHEN i.status = 'done' THEN 1 END)::int AS completed_issues\n    43→        FROM projects p\n    44→        LEFT JOIN members m ON m.id = p.lead_id\n    45→        LEFT JOIN issues i ON i.project_id = p.id\n    46→        GROUP BY p.id, p.name, p.description, p.status, p.target_date, p.lead_id, m.name, m.email\n    47→        ORDER BY p.created_at DESC\n    48→      `;\n    49→\n    50→      // Fetch teams for each project (via issues)\n    51→      const projectTeams = await sql`\n    52→        SELECT DISTINCT i.project_id, t.id AS team_id, t.name AS team_name, t.identifier AS team_identifier\n    53→        FROM issues i\n    54→        JOIN teams t ON t.id = i.team_id\n    55→        WHERE i.project_id IS NOT NULL\n    56→        ORDER BY t.name ASC\n    57→      `;\n    58→\n    59→      // Build team map by project\n    60→      const teamsByProject = new Map<string, Array<{ id: string; name: string; identifier: string }>>();\n    61→      for (const row of projectTeams) {\n    62→        const pid = String(row.project_id);\n    63→        if (!teamsByProject.has(pid)) {\n    64→          teamsByProject.set(pid, []);\n    65→        }\n    66→        teamsByProject.get(pid)!.push({\n    67→          id: String(row.team_id),\n    68→          name: String(row.team_name),\n    69→          identifier: String(row.team_identifier),\n    70→        });\n    71→      }\n    72→\n    73→      // Fetch all members for lead filter\n    74→      const allMembers = await sql`\n    75→        SELECT id, name, email FROM members ORDER BY name ASC\n    76→      `;\n    77→\n    78→      // Fetch all teams for team filter\n    79→      const allTeams = await sql`\n    80→        SELECT id, name, identifier FROM teams ORDER BY name ASC\n    81→      `;\n    82→\n    83→      const enrichedProjects = projects.map((p) => ({\n    84→        id: String(p.id),\n    85→        name: String(p.name),\n    86→        description: p.description ? String(p.description) : null,\n    87→        status: String(p.status),\n    88→        targetDate: p.target_date ? String(p.target_date).split('T')[0] : null,\n    89→        leadId: p.lead_id ? String(p.lead_id) : null,\n    90→        leadName: p.lead_name ? String(p.lead_name) : null,\n    91→        leadEmail: p.lead_email ? String(p.lead_email) : null,\n    92→        totalIssues: p.total_issues,\n    93→        completedIssues: p.completed_issues,\n    94→        teams: teamsByProject.get(String(p.id)) || [],\n    95→      }));\n    96→\n    97→      return new Response(JSON.stringify({\n    98→        projects: enrichedProjects,\n    99→        members: allMembers.map((m) => ({\n   100→          id: String(m.id),\n   101→          name: String(m.name),\n   102→          email: String(m.email),\n   103→        })),\n   104→        teams: allTeams.map((t) => ({\n   105→          id: String(t.id),\n   106→          name: String(t.name),\n   107→          identifier: String(t.identifier),\n   108→        })),\n   109→      }), {\n   110→        status: 200,\n   111→        headers: { 'Content-Type': 'application/json' },\n   112→      });\n   113→    }\n   114→\n   115→    if (req.method === 'POST') {\n   116→      const body = await req.json() as {\n   117→        name: string;\n   118→        description?: string;\n   119→        status?: string;\n   120→        leadId?: string;\n   121→        targetDate?: string;\n   122→        teamIds?: string[];\n   123→      };\n   124→\n   125→      if (!body.name?.trim()) {\n   126→        return new Response(JSON.stringify({ error: 'Name is required' }), {\n   127→          status: 400,\n   128→          headers: { 'Content-Type': 'application/json' },\n   129→        });\n   130→      }\n   131→\n   132→      const status = body.status || 'planned';\n   133→      const leadId = body.leadId || null;\n   134→      const targetDate = body.targetDate || null;\n   135→      const description = body.description || null;\n   136→\n   137→      const result = await sql`\n   138→        INSERT INTO projects (name, description, status, lead_id, target_date)\n   139→        VALUES (${body.name.trim()}, ${description}, ${status}, ${leadId}, ${targetDate})\n   140→        RETURNING id, name, description, status, lead_id, target_date, created_at\n   141→      `;\n   142→\n   143→      const project = result[0];\n   144→      if (!project) {\n   145→        return new Response(JSON.stringify({ error: 'Failed to create project' }), {\n   146→          status: 500,\n   147→          headers: { 'Content-Type': 'application/json' },\n   148→        });\n   149→      }\n   150→\n   151→      // Fetch lead info if set\n   152→      let leadName: string | null = null;\n   153→      let leadEmail: string | null = null;\n   154→      if (project.lead_id) {\n   155→        const leadRows = await sql`SELECT name, email FROM members WHERE id = ${project.lead_id}`;\n   156→        const lead = leadRows[0];\n   157→        if (lead) {\n   158→          leadName = String(lead.name);\n   159→          leadEmail = String(lead.email);\n   160→        }\n   161→      }\n   162→\n   163→      return new Response(JSON.stringify({\n   164→        id: String(project.id),\n   165→        name: String(project.name),\n   166→        description: project.description ? String(project.description) : null,\n   167→        status: String(project.status),\n   168→        targetDate: project.target_date ? String(project.target_date).split('T')[0] : null,\n   169→        leadId: project.lead_id ? String(project.lead_id) : null,\n   170→        leadName,\n   171→        leadEmail,\n   172→        totalIssues: 0,\n   173→        completedIssues: 0,\n   174→        teams: [],\n   175→      }), {\n   176→        status: 201,\n   177→        headers: { 'Content-Type': 'application/json' },\n   178→      });\n   179→    }\n   180→\n   181→    return new Response(JSON.stringify({ error: 'Method not allowed' }), {\n   182→      status: 405,\n   183→      headers: { 'Content-Type': 'application/json' },\n   184→    });\n   185→  } catch (err) {\n   186→    console.error('Projects error:', err);\n   187→    return new Response(JSON.stringify({ error: 'Internal server error' }), {\n   188→      status: 500,\n   189→      headers: { 'Content-Type': 'application/json' },\n   190→    });\n   191→  }\n   192→}\n   193→"}]},"parent_tool_use_id":"toolu_01FPtqE3eZrMWQVAB7Mtxno5","session_id":"d772a1a5-4c71-4d7b-8003-712c0f2c5f45","uuid":"301ca611-e69d-48ea-ac8d-f040121a1878"}
