[2026-03-14T22:31:05.395Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NMjMMgaXDFQB7yxQh1MjxW","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test';\n     2→\n     3→// Helper to login via API and get token\n     4→async function loginViaApi(baseURL: string, email: string, password: string) {\n     5→  const response = await fetch(`${baseURL}/api/login`, {\n     6→    method: 'POST',\n     7→    headers: { 'Content-Type': 'application/json' },\n     8→    body: JSON.stringify({ email, password }),\n     9→  });\n    10→  return response.json();\n    11→}\n    12→\n    13→// Helper to get teams via API\n    14→async function getTeams(baseURL: string, token: string) {\n    15→  const response = await fetch(`${baseURL}/api/teams`, {\n    16→    headers: { Authorization: `Bearer ${token}` },\n    17→  });\n    18→  const data = await response.json();\n    19→  return data.teams;\n    20→}\n    21→\n    22→// Helper to get cycles via API\n    23→async function getCycles(baseURL: string, token: string, teamId: string) {\n    24→  const response = await fetch(`${baseURL}/api/cycles?teamId=${teamId}`, {\n    25→    headers: { Authorization: `Bearer ${token}` },\n    26→  });\n    27→  const data = await response.json();\n    28→  return data.cycles;\n    29→}\n    30→\n    31→// Helper to delete all cycles for a team via direct API\n    32→async function deleteAllCycles(baseURL: string, token: string, teamId: string) {\n    33→  const cycles = await getCycles(baseURL, token, teamId);\n    34→  for (const cycle of cycles) {\n    35→    // No delete endpoint exists, so we rely on DB reset between tests\n    36→  }\n    37→}\n    38→\n    39→// Helper to login and navigate to cycles page\n    40→async function loginAndGoToCycles(\n    41→  page: import('@playwright/test').Page,\n    42→  baseURL: string,\n    43→  teamIdentifier = 'ENG',\n    44→  email = 'alice@acme.com',\n    45→  password = 'password123'\n    46→) {\n    47→  const data = await loginViaApi(baseURL, email, password);\n    48→  const teams = await getTeams(baseURL, data.token);\n    49→  const team = teams.find((t: { identifier: string }) => t.identifier === teamIdentifier);\n    50→\n    51→  await page.goto('/login');\n    52→  await page.evaluate((t) => localStorage.setItem('session_token', t), data.token);\n    53→  await page.goto(`/team/${team.id}/cycles`);\n    54→  await expect(page.getByTestId('active-cycle-page')).toBeVisible({ timeout: 30000 });\n    55→\n    56→  return { token: data.token, user: data.user, team, teams };\n    57→}\n    58→\n    59→test.describe('CycleList', () => {\n    60→  test('Cycle list renders all team cycles with name, date range, progress bar, and issue count', async ({ page, baseURL }) => {\n    61→    const { token, team } = await loginAndGoToCycles(page, baseURL!);\n    62→\n    63→    // Wait for the cycle list to load\n    64→    await expect(page.getByTestId('cycle-list')).toBeVisible({ timeout: 30000 });\n    65→\n    66→    // Seed data has 1 cycle: Sprint 12 for ENG team\n    67→    const cycles = await getCycles(baseURL!, token, team.id);\n    68→    expect(cycles.length).toBeGreaterThan(0);\n    69→\n    70→    // Verify each cycle row shows name, date range, progress bar, and issue count\n    71→    for (const cycle of cycles) {\n    72→      const row = page.getByTestId(`cycle-row-${cycle.id}`);\n    73→      await expect(row).toBeVisible({ timeout: 10000 });\n    74→\n    75→      // Check name\n    76→      await expect(page.getByTestId(`cycle-name-${cycle.id}`)).toContainText(cycle.name);\n    77→\n    78→      // Check date range is present\n    79→      await expect(page.getByTestId(`cycle-dates-${cycle.id}`)).toBeVisible();\n    80→\n    81→      // Check progress bar exists\n    82→      await expect(page.getByTestId(`cycle-progress-${cycle.id}`)).toBeVisible();\n    83→\n    84→      // Check issue count\n    85→      await expect(page.getByTestId(`cycle-issue-count-${cycle.id}`)).toContainText('issues');\n    86→    }\n    87→  });\n    88→\n    89→  test('Active cycle is visually highlighted in the list', async ({ page, baseURL }) => {\n    90→    const { token, team } = await loginAndGoToCycles(page, baseURL!);\n    91→\n    92→    await expect(page.getByTestId('cycle-list')).toBeVisible({ timeout: 30000 });\n    93→\n    94→    const cycles = await getCycles(baseURL!, token, team.id);\n    95→    const activeCycle = cycles.find((c: { isActive: boolean }) => c.isActive);\n    96→\n    97→    if (activeCycle) {\n    98→      // Active cycle should have the \"Active\" badge\n    99→      await expect(page.getByTestId(`cycle-active-badge-${activeCycle.id}`)).toBeVisible();\n   100→      await expect(page.getByTestId(`cycle-active-badge-${activeCycle.id}`)).toContainText('Active');\n   101→\n   102→      // Active cycle row should have the active class\n   103→      const row = page.getByTestId(`cycle-row-${activeCycle.id}`);\n   104→      await expect(row).toHaveClass(/cycle-list-row-active/);\n   105→    }\n   106→\n   107→    // Non-active cycles should NOT have the badge\n   108→    const inactiveCycles = cycles.filter((c: { isActive: boolean }) => !c.isActive);\n   109→    for (const cycle of inactiveCycles) {\n   110→      await expect(page.getByTestId(`cycle-active-badge-${cycle.id}`)).toHaveCount(0);\n   111→    }\n   112→  });\n   113→\n   114→  test('Clicking a cycle navigates to cycle detail view', async ({ page, baseURL }) => {\n   115→    const { token, team } = await loginAndGoToCycles(page, baseURL!);\n   116→\n   117→    await expect(page.getByTestId('cycle-list')).toBeVisible({ timeout: 30000 });\n   118→\n   119→    const cycles = await getCycles(baseURL!, token, team.id);\n   120→    expect(cycles.length).toBeGreaterThan(0);\n   121→\n   122→    const targetCycle = cycles[0];\n   123→\n   124→    // Click the cycle row\n   125→    await page.getByTestId(`cycle-row-${targetCycle.id}`).click();\n   126→\n   127→    // Verify cycle detail view is shown\n   128→    await expect(page.getByTestId('cycle-detail')).toBeVisible({ timeout: 30000 });\n   129→\n   130→    // Verify cycle name in detail view\n   131→    await expect(page.getByTestId('cycle-detail-name')).toContainText(targetCycle.name);\n   132→  });\n   133→\n   134→  test('Cycle list shows empty state when team has no cycles', async ({ page, baseURL }) => {\n   135→    // Navigate to Design team cycles - Design team has no cycles in seed data\n   136→    await loginAndGoToCycles(page, baseURL!, 'DES');\n   137→\n   138→    // Verify empty state is shown\n   139→    await expect(page.getByTestId('cycle-list-empty')).toBeVisible({ timeout: 30000 });\n   140→    await expect(page.getByTestId('cycle-list-empty')).toContainText('No cycles yet');\n   141→\n   142→    // \"New Cycle\" button should still be visible\n   143→    await expect(page.getByTestId('new-cycle-btn')).toBeVisible();\n   144→  });\n   145→\n   146→  test('Cycle list progress bar accurately reflects issue completion percentage', async ({ page, baseURL }) => {\n   147→    const { token, team } = await loginAndGoToCycles(page, baseURL!);\n   148→\n   149→    await expect(page.getByTestId('cycle-list')).toBeVisible({ timeout: 30000 });\n   150→\n   151→    const cycles = await getCycles(baseURL!, token, team.id);\n   152→\n   153→    for (const cycle of cycles) {\n   154→      const expectedPct = cycle.issueCount > 0\n   155→        ? Math.round((cycle.doneCount / cycle.issueCount) * 100)\n   156→        : 0;\n   157→\n   158→      // Verify the progress text shows the correct percentage\n   159→      const row = page.getByTestId(`cycle-row-${cycle.id}`);\n   160→      await expect(row).toContainText(`${expectedPct}%`);\n   161→    }\n   162→  });\n   163→\n   164→  test('Cycle list updates when a new cycle is created', async ({ page, baseURL }) => {\n   165→    const { token, team } = await loginAndGoToCycles(page, baseURL!);\n   166→\n   167→    // Wait for cycle list or empty state\n   168→    const cycleListOrEmpty = page.getByTestId('cycle-list').or(page.getByTestId('cycle-list-empty'));\n   169→    await expect(cycleListOrEmpty).toBeVisible({ timeout: 30000 });\n   170→\n   171→    // Get initial cycle count from API\n   172→    const initialCycles = await getCycles(baseURL!, token, team.id);\n   173→    const initialCount = initialCycles.length;\n   174→\n   175→    // Click \"New Cycle\" button\n   176→    await page.getByTestId('new-cycle-btn').click();\n   177→    await expect(page.getByTestId('create-cycle-modal')).toBeVisible({ timeout: 10000 });\n   178→\n   179→    // Fill in cycle details\n   180→    const cycleName = `Sprint Test ${Date.now()}`;\n   181→    await page.getByTestId('create-cycle-name-input').fill(cycleName);\n   182→    await page.getByTestId('create-cycle-start-date-input').fill('2026-04-01');\n   183→    await page.getByTestId('create-cycle-end-date-input').fill('2026-04-14');\n   184→\n   185→    // Submit\n   186→    await page.getByTestId('create-cycle-submit-btn').click();\n   187→\n   188→    // Wait for modal to close\n   189→    await expect(page.getByTestId('create-cycle-modal')).toHaveCount(0, { timeout: 30000 });\n   190→\n   191→    // Verify cycle list now shows the new cycle\n   192→    await expect(page.getByTestId('cycle-list')).toBeVisible({ timeout: 30000 });\n   193→\n   194→    // The new cycle should appear in the list\n   195→    const cycleList = page.getByTestId('cycle-list');\n   196→    await expect(cycleList).toContainText(cycleName, { timeout: 15000 });\n   197→  });\n   198→\n   199→  test('Clicking a different cycle after viewing one switches the detail view', async ({ page, baseURL }) => {\n   200→    const { token, team } = await loginAndGoToCycles(page, baseURL!);\n   201→\n   202→    // First create a second cycle so we have two to switch between\n   203→    const response = await fetch(`${baseURL}/api/cycles`, {\n   204→      method: 'POST',\n   205→      headers: {\n   206→        'Content-Type': 'application/json',\n   207→        Authorization: `Bearer ${token}`,\n   208→      },\n   209→      body: JSON.stringify({\n   210→        teamId: team.id,\n   211→        name: `Second Cycle ${Date.now()}`,\n   212→        startDate: '2026-04-01',\n   213→        endDate: '2026-04-14',\n   214→      }),\n   215→    });\n   216→    const secondCycle = await response.json();\n   217→\n   218→    // Reload the page to see both cycles\n   219→    await page.goto(`/team/${team.id}/cycles`);\n   220→    await expect(page.getByTestId('cycle-list')).toBeVisible({ timeout: 30000 });\n   221→\n   222→    // Get cycles from API\n   223→    const cycles = await getCycles(baseURL!, token, team.id);\n   224→    expect(cycles.length).toBeGreaterThanOrEqual(2);\n   225→\n   226→    // Click first cycle\n   227→    await page.getByTestId(`cycle-row-${cycles[0].id}`).click();\n   228→    await expect(page.getByTestId('cycle-detail')).toBeVisible({ timeout: 30000 });\n   229→    await expect(page.getByTestId('cycle-detail-name')).toContainText(cycles[0].name);\n   230→\n   231→    // Go back to list\n   232→    await page.getByTestId('cycle-back-btn').click();\n   233→    await expect(page.getByTestId('cycle-list')).toBeVisible({ timeout: 30000 });\n   234→\n   235→    // Click second cycle\n   236→    await page.getByTestId(`cycle-row-${cycles[1].id}`).click();\n   237→    await expect(page.getByTestId('cycle-detail')).toBeVisible({ timeout: 30000 });\n   238→\n   239→    // Verify detail shows the second cycle's name, not the first\n   240→    await expect(page.getByTestId('cycle-detail-name')).toContainText(cycles[1].name);\n   241→  });\n   242→});\n   243→"}]},"parent_tool_use_id":"toolu_01FPtqE3eZrMWQVAB7Mtxno5","session_id":"d772a1a5-4c71-4d7b-8003-712c0f2c5f45","uuid":"ee7bef00-07c1-40f4-8c1a-afa153c4b98e"}
