stId('reviews-section')\n   129→    await expect(section).toBeVisible({ timeout: 30000 })\n   130→\n   131→    const reviewCards = section.locator('[data-testid^=\"review-card-\"]')\n   132→    await expect(reviewCards).toHaveCount(2, { timeout: 10000 })\n   133→\n   134→    // Emma's card should have an img avatar\n   135→    const emmaCard = reviewCards.filter({ hasText: 'Emma Wilson' })\n   136→    await expect(emmaCard.locator('img')).toBeVisible()\n   137→\n   138→    // Alex's card should have initial (no img, shows 'A' initial)\n   139→    const alexCard = reviewCards.filter({ hasText: 'Alex Rivera' })\n   140→    await expect(alexCard.locator('img')).not.toBeVisible()\n   141→    // The initial should be displayed (first letter of name)\n   142→    await expect(alexCard).toContainText('A')\n   143→  })\n   144→\n   145→  test('Reviews section shows message when property has no reviews', async ({ page }) => {\n   146→    // b2222222 has 0 seed reviews\n   147→    await page.goto(`/properties/${PROPERTY_NO_REVIEWS}`)\n   148→\n   149→    const section = page.getByTestId('reviews-section')\n   150→    await expect(section).toBeVisible({ timeout: 30000 })\n   151→\n   152→    await expect(section).toContainText('No reviews yet')\n   153→\n   154→    // Category ratings should not be displayed\n   155→    await expect(page.getByTestId('rating-category-cleanliness')).not.toBeVisible()\n   156→  })\n   157→\n   158→  test('Reviews section handles pagination or Show more for many reviews', async ({ page }) => {\n   159→    test.slow()\n   160→\n   161→    // Navigate first to get request context\n   162→    await page.goto(`/properties/${PROPERTY_NO_REVIEWS}`)\n   163→    await expect(page.getByTestId('reviews-section')).toBeVisible({ timeout: 30000 })\n   164→\n   165→    // Clean up any reviews\n   166→    await deleteAllReviewsForProperty(page, PROPERTY_NO_REVIEWS)\n   167→\n   168→    // Create 8 bookings + reviews (non-overlapping dates)\n   169→    for (let i 