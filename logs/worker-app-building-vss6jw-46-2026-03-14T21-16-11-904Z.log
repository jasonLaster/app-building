ct(page.getByTestId('user-reviews-list')).toBeVisible({ timeout: 30000 })\n   122→    await expect(page.getByTestId('reviews-empty-state')).toBeVisible()\n   123→    await expect(page.getByTestId('reviews-empty-state')).toContainText(\"You haven't written any reviews yet\")\n   124→  })\n   125→\n   126→  test('Review card shows rating with star display', async ({ page }) => {\n   127→    test.slow()\n   128→    // Emma's review has rating 5\n   129→    await login(page, 'emma@example.com')\n   130→    await page.goto('/profile')\n   131→\n   132→    await expect(page.getByTestId('user-reviews-list')).toBeVisible({ timeout: 30000 })\n   133→    const reviewCards = page.locator('[data-testid^=\"review-card-\"]')\n   134→    await expect(reviewCards).toHaveCount(1, { timeout: 30000 })\n   135→\n   136→    const starRating = reviewCards.first().getByTestId('star-rating')\n   137→    await expect(starRating).toBeVisible()\n   138→\n   139→    // Rating 5: all 5 stars should be filled (have fill=\"currentColor\")\n   140→    const filledStars = starRating.locator('svg[fill=\"currentColor\"]')\n   141→    await expect(filledStars).toHaveCount(5)\n   142→  })\n   143→\n   144→  test('Review card links to the reviewed property', async ({ page }) => {\n   145→    test.slow()\n   146→    // Emma's review is for property b1111111-1111-1111-1111-111111111111\n   147→    await login(page, 'emma@example.com')\n   148→    await page.goto('/profile')\n   149→\n   150→    await expect(page.getByTestId('user-reviews-list')).toBeVisible({ timeout: 30000 })\n   151→    const reviewCards = page.locator('[data-testid^=\"review-card-\"]')\n   152→    await expect(reviewCards).toHaveCount(1, { timeout: 30000 })\n   153→\n   154→    // Click the property link in the review card\n   155→    const propertyLink = reviewCards.first().locator('[data-testid^=\"review-property-link-\"]')\n   156→    await expect(propertyLink).toContainText('Cozy Downtown Loft with City Views')\n   157→    await pr