[2026-03-15T00:56:34.178Z] {"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011tFtfdki6Cyi2bejwXZFrG","type":"tool_result","content":"     1→import { test, expect } from '@playwright/test'\n     2→\n     3→// b1111111: Loft, 4 guests, 1 bedroom, 2 beds, 1 bath, New York, US, host Sarah Chen, 1 review (5.0)\n     4→const PROPERTY_WITH_REVIEWS = 'b1111111-1111-1111-1111-111111111111'\n     5→// b2222222: Villa, 8 guests, 4 bedrooms, 5 beds, 3 bath, Miami, US, host Sarah Chen, 0 reviews\n     6→const PROPERTY_NO_REVIEWS = 'b2222222-2222-2222-2222-222222222222'\n     7→// b4444444: Apartment, 2 guests, 1 bedroom, 1 bed, 1 bath, Austin, TX, host Mike Johnson, 1 review (4.0)\n     8→const PROPERTY_SINGULAR = 'b4444444-4444-4444-4444-444444444444'\n     9→\n    10→test.describe('Property Detail - PropertyHeader', () => {\n    11→  test('Property header displays title, location, rating summary, and host info', async ({ page }) => {\n    12→    await page.goto(`/properties/${PROPERTY_WITH_REVIEWS}`)\n    13→\n    14→    const header = page.getByTestId('property-header')\n    15→    await expect(header).toBeVisible({ timeout: 30000 })\n    16→\n    17→    // Title\n    18→    await expect(header.locator('h1')).toHaveText('Cozy Downtown Loft with City Views')\n    19→\n    20→    // Location\n    21→    await expect(header).toContainText('New York, United States')\n    22→\n    23→    // Rating summary - property has 1 review with rating 5\n    24→    const reviewLink = page.getByTestId('review-count-link')\n    25→    await expect(reviewLink).toBeVisible()\n    26→    await expect(reviewLink).toContainText('5.0')\n    27→    await expect(reviewLink).toContainText('(1 review)')\n    28→\n    29→    // Host info\n    30→    await expect(header).toContainText('Hosted by')\n    31→    await expect(header).toContainText('Sarah Chen')\n    32→\n    33→    // Host avatar\n    34→    const avatar = page.getByTestId('host-avatar')\n    35→    await expect(avatar).toBeVisible()\n    36→  })\n    37→\n    38→  test('Property header shows \"New\" when property has no reviews', async ({ page }) => {\n    39→    await page.goto(`/properties/${PROPERTY_NO_REVIEWS}`)\n    40→\n    41→    const header = page.getByTestId('property-header')\n    42→    await expect(header).toBeVisible({ timeout: 30000 })\n    43→\n    44→    // Should show \"New\" instead of rating\n    45→    await expect(header).toContainText('New')\n    46→\n    47→    // No review count link\n    48→    await expect(page.getByTestId('review-count-link')).not.toBeVisible()\n    49→  })\n    50→\n    51→  test('Clicking review count scrolls to or navigates to reviews section', async ({ page }) => {\n    52→    await page.goto(`/properties/${PROPERTY_WITH_REVIEWS}`)\n    53→\n    54→    const reviewLink = page.getByTestId('review-count-link')\n    55→    await expect(reviewLink).toBeVisible({ timeout: 30000 })\n    56→\n    57→    // Click the review count\n    58→    await reviewLink.click()\n    59→\n    60→    // Reviews section should be visible (scrolled into view)\n    61→    const reviewsSection = page.getByTestId('reviews-section')\n    62→    await expect(reviewsSection).toBeVisible()\n    63→    await expect(reviewsSection).toBeInViewport({ timeout: 5000 })\n    64→  })\n    65→\n    66→  test('Property header displays host avatar as clickable element', async ({ page }) => {\n    67→    await page.goto(`/properties/${PROPERTY_WITH_REVIEWS}`)\n    68→\n    69→    const header = page.getByTestId('property-header')\n    70→    await expect(header).toBeVisible({ timeout: 30000 })\n    71→\n    72→    // Host avatar should be visible and circular (img element)\n    73→    const avatar = page.getByTestId('host-avatar')\n    74→    await expect(avatar).toBeVisible()\n    75→    await expect(avatar).toHaveAttribute('alt', 'Sarah Chen')\n    76→\n    77→    // Avatar should be inside a clickable element\n    78→    const hostInfo = page.getByTestId('host-info')\n    79→    await expect(hostInfo).toBeVisible()\n    80→\n    81→    // Host name displayed next to avatar\n    82→    await expect(hostInfo).toContainText('Sarah Chen')\n    83→  })\n    84→})\n    85→\n    86→test.describe('Property Detail - PropertyInfo', () => {\n    87→  test('Property info section displays all property details', async ({ page }) => {\n    88→    // b2222222: Villa, 8 guests, 4 bedrooms, 5 beds, 3 bathrooms\n    89→    await page.goto(`/properties/${PROPERTY_NO_REVIEWS}`)\n    90→\n    91→    const info = page.getByTestId('property-info')\n    92→    await expect(info).toBeVisible({ timeout: 30000 })\n    93→\n    94→    await expect(info).toContainText('Villa')\n    95→    await expect(info).toContainText('8 guests')\n    96→    await expect(info).toContainText('4 bedrooms')\n    97→    await expect(info).toContainText('5 beds')\n    98→    await expect(info).toContainText('3 bathrooms')\n    99→  })\n   100→\n   101→  test('Property info section displays check-in and check-out times', async ({ page }) => {\n   102→    // Default check_in_time is '15:00', check_out_time is '11:00'\n   103→    await page.goto(`/properties/${PROPERTY_WITH_REVIEWS}`)\n   104→\n   105→    const info = page.getByTestId('property-info')\n   106→    await expect(info).toBeVisible({ timeout: 30000 })\n   107→\n   108→    // 15:00 → 3:00 PM\n   109→    await expect(info).toContainText('Check-in: 3:00 PM')\n   110→    // 11:00 → 11:00 AM\n   111→    await expect(info).toContainText('Check-out: 11:00 AM')\n   112→  })\n   113→\n   114→  test('Property info section handles singular and plural labels correctly', async ({ page }) => {\n   115→    // b4444444: 2 guests, 1 bedroom, 1 bed, 1 bathroom\n   116→    await page.goto(`/properties/${PROPERTY_SINGULAR}`)\n   117→\n   118→    const info = page.getByTestId('property-info')\n   119→    await expect(info).toBeVisible({ timeout: 30000 })\n   120→\n   121→    await expect(info).toContainText('1 bedroom')\n   122→    await expect(info).toContainText('1 bed')\n   123→    await expect(info).toContainText('1 bathroom')\n   124→    // 2 guests should be plural\n   125→    await expect(info).toContainText('2 guests')\n   126→  })\n   127→})\n   128→\n   129→test.describe('Property Detail - PropertyDescription', () => {\n   130→  test('Property description displays full description text', async ({ page }) => {\n   131→    // b4444444 has a short description (under 300 chars)\n   132→    await page.goto(`/properties/${PROPERTY_SINGULAR}`)\n   133→\n   134→    const desc = page.getByTestId('property-description')\n   135→    await expect(desc).toBeVisible({ timeout: 30000 })\n   136→\n   137→    await expect(desc).toContainText('Stylish apartment in the vibrant South Congress neighborhood')\n   138→    await expect(desc).toContainText('Features a rooftop pool and gym access')\n   139→\n   140→    // No Show more button for short description\n   141→    await expect(page.getByTestId('description-toggle')).not.toBeVisible()\n   142→  })\n   143→\n   144→  test('Long description shows a \"Show more\" toggle', async ({ page }) => {\n   145→    // b2222222 has a long description (over 300 chars)\n   146→    await page.goto(`/properties/${PROPERTY_NO_REVIEWS}`)\n   147→\n   148→    const desc = page.getByTestId('property-description')\n   149→    await expect(desc).toBeVisible({ timeout: 30000 })\n   150→\n   151→    // Description should be truncated\n   152→    const descText = desc.locator('p')\n   153→    await expect(descText).toContainText('...')\n   154→\n   155→    // Show more button should be visible\n   156→    const toggle = page.getByTestId('description-toggle')\n   157→    await expect(toggle).toBeVisible()\n   158→    await expect(toggle).toHaveText('Show more')\n   159→  })\n   160→\n   161→  test('Clicking \"Show more\" expands the full description', async ({ page }) => {\n   162→    await page.goto(`/properties/${PROPERTY_NO_REVIEWS}`)\n   163→\n   164→    const desc = page.getByTestId('property-description')\n   165→    await expect(desc).toBeVisible({ timeout: 30000 })\n   166→\n   167→    const toggle = page.getByTestId('description-toggle')\n   168→    await expect(toggle).toHaveText('Show more')\n   169→\n   170→    // Click Show more\n   171→    await toggle.click()\n   172→\n   173→    // Full description should be visible (no ellipsis truncation)\n   174→    const descText = desc.locator('p')\n   175→    await expect(descText).toContainText('sipping your favorite drinks')\n   176→\n   177→    // Toggle should now say Show less\n   178→    await expect(toggle).toHaveText('Show less')\n   179→  })\n   180→\n   181→  test('Clicking \"Show less\" collapses the description back', async ({ page }) => {\n   182→    await page.goto(`/properties/${PROPERTY_NO_REVIEWS}`)\n   183→\n   184→    const desc = page.getByTestId('property-description')\n   185→    await expect(desc).toBeVisible({ timeout: 30000 })\n   186→\n   187→    // Expand first\n   188→    const toggle = page.getByTestId('description-toggle')\n   189→    await toggle.click()\n   190→    await expect(toggle).toHaveText('Show less')\n   191→\n   192→    // Click Show less\n   193→    await toggle.click()\n   194→\n   195→    // Should be truncated again\n   196→    const descText = desc.locator('p')\n   197→    await expect(descText).toContainText('...')\n   198→    await expect(toggle).toHaveText('Show more')\n   199→  })\n   200→\n   201→  test('Show more/less toggle is functional on repeated use', async ({ page }) => {\n   202→    await page.goto(`/properties/${PROPERTY_NO_REVIEWS}`)\n   203→\n   204→    const desc = page.getByTestId('property-description')\n   205→    await expect(desc).toBeVisible({ timeout: 30000 })\n   206→\n   207→    const toggle = page.getByTestId('description-toggle')\n   208→    const descText = desc.locator('p')\n   209→\n   210→    // Click Show more\n   211→    await toggle.click()\n   212→    await expect(toggle).toHaveText('Show less')\n   213→    await expect(descText).not.toContainText('...')\n   214→\n   215→    // Click Show less\n   216→    await toggle.click()\n   217→    await expect(toggle).toHaveText('Show more')\n   218→    await expect(descText).toContainText('...')\n   219→\n   220→    // Click Show more again\n   221→    await toggle.click()\n   222→    await expect(toggle).toHaveText('Show less')\n   223→    await expect(descText).toContainText('sipping your favorite drinks')\n   224→  })\n   225→})\n   226→"}]},"parent_tool_use_id":"toolu_01YPJEdx1NxagGeR7SjfeaSD","session_id":"30bc8576-b4c8-496e-a563-b403a6d12d18","uuid":"61812493-e678-44a1-a886-153c9fd1c617"}
