ame=\"text-text-secondary\">New</span>\n    40→        )}\n    41→        <span className=\"text-text-secondary\">·</span>\n    42→        <button data-testid=\"host-info\" className=\"flex items-center gap-2 cursor-pointer\" onClick={() => {\n    43→          const el = document.getElementById('host-info-card')\n    44→          if (el) el.scrollIntoView({ behavior: 'smooth' })\n    45→        }}>\n    46→          {property.host_avatar ? (\n    47→            <img\n    48→              data-testid=\"host-avatar\"\n    49→              src={property.host_avatar}\n    50→              alt={property.host_name || 'Host'}\n    51→              className=\"w-6 h-6 rounded-full object-cover\"\n    52→            />\n    53→          ) : (\n    54→            <div data-testid=\"host-avatar\" className=\"w-6 h-6 rounded-full bg-bg-secondary flex items-center justify-center text-xs font-semibold text-text-secondary\">\n    55→              {property.host_name?.charAt(0) || 'H'}\n    56→            </div>\n    57→          )}\n    58→          <span className=\"text-text-secondary\">Hosted by <span className=\"font-medium text-text\">{property.host_name}</span></span>\n    59→        </button>\n    60→      </div>\n    61→    </div>\n    62→  )\n    63→}\n    64→"}]},"parent_tool_use_id":"toolu_01YPJEdx1NxagGeR7SjfeaSD","session_id":"30bc8576-b4c8-496e-a563-b403a6d12d18","uuid":"d8430186-adc0-402b-9be2-76f609316e31"}
