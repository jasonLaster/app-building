#!/usr/bin/env node

// list-secrets: Print the names of all available secrets.

import http from "node:http";

const SECRETS_SERVER_PORT = 9119;

const req = http.get(
  { hostname: "127.0.0.1", port: SECRETS_SERVER_PORT, path: "/list" },
  (res) => {
    let body = "";
    res.setEncoding("utf-8");
    res.on("data", (chunk) => (body += chunk));
    res.on("end", () => {
      try {
        const names = JSON.parse(body);
        for (const name of names) console.log(name);
      } catch {
        console.error("list-secrets: invalid response from secrets server");
        process.exit(1);
      }
    });
  },
);

req.on("error", (err) => {
  console.error(`list-secrets: failed to connect to secrets server: ${err.message}`);
  process.exit(1);
});
