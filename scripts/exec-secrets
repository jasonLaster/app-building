#!/usr/bin/env node

// exec-secrets: Run a command with secrets resolved by the container's secrets server.
// Usage: exec-secrets <secret1> [secret2 ...] -- <cmd> [args...]
//
// The secrets server (127.0.0.1:9119) looks up secret values from Infisical,
// spawns the command with those secrets in its environment, and streams
// redacted output back.

import http from "node:http";

const SECRETS_SERVER_PORT = 9119;

const args = process.argv.slice(2);
const dashDash = args.indexOf("--");

if (dashDash === -1 || dashDash === args.length - 1) {
  console.error("Usage: exec-secrets <secret1> [secret2 ...] -- <cmd> [args...]");
  process.exit(1);
}

const secrets = args.slice(0, dashDash);
const cmd = args.slice(dashDash + 1);

const body = JSON.stringify({ secrets, cmd, cwd: process.cwd() });

const req = http.request(
  {
    hostname: "127.0.0.1",
    port: SECRETS_SERVER_PORT,
    path: "/exec",
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "Content-Length": Buffer.byteLength(body),
    },
  },
  (res) => {
    let buffer = "";

    const processLine = (line) => {
      if (!line) return;
      try {
        const msg = JSON.parse(line);
        if (msg.s === "o") process.stdout.write(msg.d);
        else if (msg.s === "e") process.stderr.write(msg.d);
        else if (msg.s === "x") process.exitCode = msg.c ?? 1;
      } catch {
        // Ignore malformed lines
      }
    };

    res.setEncoding("utf-8");
    res.on("data", (chunk) => {
      buffer += chunk;
      const lines = buffer.split("\n");
      buffer = lines.pop() ?? "";
      for (const line of lines) processLine(line);
    });

    res.on("end", () => {
      processLine(buffer);
    });
  },
);

req.on("error", (err) => {
  console.error(`exec-secrets: failed to connect to secrets server: ${err.message}`);
  process.exit(1);
});

req.end(body);
