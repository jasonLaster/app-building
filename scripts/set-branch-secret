#!/usr/bin/env node

// set-branch-secret: Store a branch-level secret in Infisical.
// Usage: set-branch-secret SECRET_NAME   (value is read from stdin)
//
// Reads the secret value from stdin (not args — args are visible in process lists).
// Errors if the value was previously logged (leak detection).

import http from "node:http";

const SECRETS_SERVER_PORT = 9119;

const name = process.argv[2];

if (!name) {
  console.error("Usage: set-branch-secret SECRET_NAME  (value read from stdin)");
  process.exit(1);
}

// Read value from stdin
const chunks = [];
for await (const chunk of process.stdin) {
  chunks.push(chunk);
}
const value = Buffer.concat(chunks).toString().trim();

if (!value) {
  console.error("set-branch-secret: no value provided on stdin");
  process.exit(1);
}

const body = JSON.stringify({ name, value });

const req = http.request(
  {
    hostname: "127.0.0.1",
    port: SECRETS_SERVER_PORT,
    path: "/set",
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "Content-Length": Buffer.byteLength(body),
    },
  },
  (res) => {
    let data = "";
    res.setEncoding("utf-8");
    res.on("data", (chunk) => (data += chunk));
    res.on("end", () => {
      try {
        const result = JSON.parse(data);
        if (result.ok) {
          console.log(`Secret '${name}' stored successfully.`);
        } else {
          console.error(`set-branch-secret: ${result.error}`);
          process.exitCode = 1;
        }
      } catch {
        console.error(`set-branch-secret: unexpected response: ${data}`);
        process.exitCode = 1;
      }
    });
  },
);

req.on("error", (err) => {
  console.error(`set-branch-secret: failed to connect to secrets server: ${err.message}`);
  process.exit(1);
});

req.end(body);
